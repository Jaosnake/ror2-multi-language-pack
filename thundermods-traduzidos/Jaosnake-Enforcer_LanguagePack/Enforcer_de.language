        "ACHIEVEMENT_ENFORCER_CHARACTERUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Riot",
        "ACHIEVEMENT_ENFORCER_CHARACTERUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Töte einen Magmawurm, einen umherziehenden Landstreicher und einen Steintitan in einem einzigen Durchgang.",
        "ACHIEVEMENT_ENFORCER_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Mastery",
        "ACHIEVEMENT_ENFORCER_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Schlagen Sie als Vollstrecker das Spiel oder vernichten Sie Monsun.",
        "ACHIEVEMENT_ENFORCER_GRANDMASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Grand Mastery",
        "ACHIEVEMENT_ENFORCER_GRANDMASTERYUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Schlage als Vollstrecker das Spiel oder vernichte Taifun oder Eclipse.\n<color=#8888>(Zählt alle Schwierigkeitsgrade Typhoon oder höher)</color>",
        "ACHIEVEMENT_ENFORCER_DOOMUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Rip and Tear...",
        "ACHIEVEMENT_ENFORCER_DOOMUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Töte als Enforcer 20 Kobolde in einem einzigen Durchgang.",
        "ACHIEVEMENT_ENFORCER_RIFLEUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Rapidfire",
        "ACHIEVEMENT_ENFORCER_RIFLEUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Erreiche als Vollstrecker +400 % Angriffsgeschwindigkeit.",
        "ACHIEVEMENT_ENFORCER_STUNGRENADEUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Crowd Control",
        "ACHIEVEMENT_ENFORCER_STUNGRENADEUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Setzen Sie als Vollstrecker 20 Feinde gleichzeitig unter die Wirkung von Tränengas.",
        "ACHIEVEMENT_ENFORCER_ROBITUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: We Have the Technology",
        "ACHIEVEMENT_ENFORCER_ROBITUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Fallen Sie als Vollstrecker und werden Sie wieder zum Leben erweckt.",
        "ACHIEVEMENT_ENFORCER_NEMESISSKINUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Clearance",
        "ACHIEVEMENT_ENFORCER_NEMESISSKINUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Stabilisieren Sie als Vollstrecker die Zelle in den Leerenfeldern.",
        "ACHIEVEMENT_ENFORCER_DOOMINTERNALUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: ...Until it is done",
        "ACHIEVEMENT_ENFORCER_DOOMINTERNALUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Töte als Vollstrecker 10 Kobold-Overlords in einem einzigen Durchgang.",
        "ACHIEVEMENT_ENFORCER_CLASSICUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Schmoovin'",
        "ACHIEVEMENT_ENFORCER_CLASSICUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Zeigen Sie als Enforcer Ihre Tanzbewegungen.",
        "ACHIEVEMENT_ENFORCER_DESPERADOUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Rules of Nature",
        "ACHIEVEMENT_ENFORCER_DESPERADOUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Besiege als Vollstrecker den einzigartigen Wächter der Gilded Coast, indem du ihn vom Rand der Karte stößt.",
        "ACHIEVEMENT_ENFORCER_BUNGUSUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Enforcing Perfection",
        "ACHIEVEMENT_ENFORCER_BUNGUSUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Werden Sie als Vollstrecker eins mit dem Bungus.",
        "ACHIEVEMENT_ENFORCER_STORMTROOPERUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Long Live the Empire",
        "ACHIEVEMENT_ENFORCER_STORMTROOPERUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Besiege als Enforcer eine Elite-Solus-Kontrolleinheit.",
        "ACHIEVEMENT_ENFORCER_FROGUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Through Thick and Thin",
        "ACHIEVEMENT_ENFORCER_FROGUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Finde als Vollstrecker einen Freund auf dem Mond.",
        "ACHIEVEMENT_ENFORCER_STEVEUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Blocks",
        "ACHIEVEMENT_ENFORCER_STEVEUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Blocken Sie als Vollstrecker einen Angriff mit Ihrem Schild.",
        "ENFORCER_STEVEUNLOCKABLE_UNLOCKABLE_NAME": "Vollstrecker: Blockiert",
        "ENFORCER_PRIMARY_SHOTGUN_NAME_UPGRADE_DESCRIPTION": "<style=cIsUtility>+5 %</style> Schaden, <style=cIsUtility>+10 %</style> Geschossdicke und <style=cIsUtility>+0,1</style> Geschossausbreitung",
        "ENFORCER_PROC_BULLET": "Kugel",
        "ENFORCER_PROC_HAMMER": "Hammer",
        "ENFORCER_PROC_BASH": "Bash",
        "ENFORCER_PROC_GRENADE": "Granate",
        "ENFORCER_PROC_DAMAGING_GAS": "Schädliches Gas",
        "ENFORCER_PROC_SKATEBOARD": "Skateboard",
        "NEMFORCER_NAME": "Nemesis-Vollstrecker",
        "NEMFORCER_DESCRIPTION": "Nemesis Enforcer ist eine Inkarnation von Tapferkeit und Stärke, eine übernatürliche Art, die niemand auf die leichte Schulter nehmen sollte slam.\n\n< ! > Das Strafen mit der Goldenen Minigun ist der Schlüssel zum Ausschalten mächtiger Bosse.\n\n< ! > Schilde sind was für Muschis.\n\n",
        "NEMFORCER_SUBTITLE": "Unbestechlicher Schatten",
        "NEMFORCER_LORE": "\nheavy tf2\n\n",
        "NEMFORCER_OUTRO_FLAVOR": "..und so ging er, mit neu gewonnener Macht zu Ehren.",
        "NEMFORCER_OUTRO_FAILURE": "..und so kehrte er zurück, die unfehlbare Bastion wahrlich verewigt.",
        "NEMFORCER_BOSS_NAME": "Ultra-Nemesis-Vollstrecker",
        "NEMFORCER_BOSS_SUBTITLE": "Ende der Reihe",
        "DEDEDE_NAME": "König Dedede",
        "DEDEDE_BOSS_SUBTITLE": "König des Traumlandes",
        "ENFORCER_EVENT_NEMFORCERBOSS_START": "Eine unnatürliche Kraft geht von der Leere aus...",
        "ENFORCER_EVENT_NEMFORCERBOSS_END": "Der Einfluss der Leere schwindet...",
        "NEMFORCER_PASSIVE_NAME": "Koloss",
        "NEMFORCER_PASSIVE_DESCRIPTION": "Nemesis Enforcer erhält <style=cIsHealing>bonus-Gesundheitsregeneration</style>, basierend auf seiner aktuellen <style=cIsHealth>fehlenden Gesundheit</style>, bis zu <style=cIsHealth>2,5 % der maximalen Gesundheit</style>.",
        "NEMFORCER_PASSIVE_REWORK_DESCRIPTION": "Nemesis Enforcer regeneriert <style=cIsHealing>2%</style> seiner <style=cIsHealing>maximalen Gesundheit</style> über 3 Sekunden, wenn er Feinde mit <style=cIsDamage>Nahkampfangriffen</style> trifft.",
        "NEMFORCER_PRIMARY_HAMMER_NAME": "Goldener Hammer",
        "NEMFORCER_PRIMARY_HAMMER_DESCRIPTION": "Schwinge deinen Hammer und verursache <style=cIsDamage>500%</style> Schaden.",
        "NEMFORCER_PRIMARY_THROWHAMMER_NAME": "Wurfhammer",
        "NEMFORCER_PRIMARY_THROWHAMMER_DESCRIPTION": "Wirf einen Hammer und verursache <style=cIsDamage>620%</style> Schaden.",
        "NEMFORCER_PRIMARY_MINIGUN_NAME": "Goldene Minigun",
        "NEMFORCER_PRIMARY_MINIGUN_DESCRIPTION": "Erhöhe die Geschwindigkeit und feuere einen Kugelhagel ab, der pro Kugel <style=cIsDamage>65 % Schaden</style> verursacht. <style=cIsUtility>Verlangsamt Ihre Bewegung beim Schießen.</style>",
        "KEYWORD_SLAM": "<style=cKeywordName>Downward Slam</style><style=cSub><style=cIsDamage>Betäubend.</style> Schlage mit deinem Hammer heftig <style=cIsHealth>nieder</style>, was <style=cIsDamage>300 %–2500 % Schaden</style> und zusätzliche <style=cIsDamage>30 %</style> davon beim Aufprall verursacht. <style=cIsUtility>Aufprallradius skaliert mit Geschwindigkeit.</style></style>",
        "NEMFORCER_SECONDARY_BASH_NAME": "Dominanz",
        "NEMFORCER_SECONDARY_BASH_DESCRIPTION": "<style=cIsUtility>Laden Sie auf</style>, machen Sie dann einen Ausfallschritt nach vorne und entfesseln Sie einen <style=cIsDamage>steigenden Aufwärtshaken</style> für <style=cIsDamage>450 %–2500 % Schaden</style>. Verwenden Sie <style=cIsUtility>, während Sie fallen und nach unten schauen</style>, um stattdessen einen <style=cIsUtility>Downward Slam</style> auszuführen.",
        "NEMFORCER_SECONDARY_SLAM_NAME": "Dominanz (Minigun)",
        "NEMFORCER_SECONDARY_SLAM_DESCRIPTION": "<style=cIsDamage>Betäubend.</style> Während der Minigun-Haltung schlage heftig mit deinem Hammer <style=cIsHealth>nieder</style>, was <style=cIsDamage>600 % Schaden</style> verursacht und getroffene Gegner <style=cIsDamage>zurückstößt</style>. <style=cIsUtility>Explodiert Projektile.</style>",
        "NEMFORCER_UTILITY_GAS_NAME": "XM47-Granate",
        "NEMFORCER_UTILITY_GAS_DESCRIPTION": "Wirf eine Granate, die in eine Wolke aus <style=cIsUtility>ätzendem Gas</style> explodiert, die <style=cIsUtility>verlangsamt</style> und <style=cIsDamage>200 % Schaden pro Sekunde</style> verursacht und <style=cIsDamage>16 Sekunden</style> anhält.",
        "NEMFORCER_UTILITY_JUMP_NAME": "Super Dedede-Sprung",
        "NEMFORCER_UTILITY_JUMP_DESCRIPTION": "Springe in die Luft und schlage dann zu, um <style=cIsDamage>3200 % Schaden</style> zu verursachen. <style=cIsUtility>Verursacht verringerten Schaden außerhalb des Aufprallzentrums.</style>",
        "KEYWORD_GRAPPLE": "<style=cKeywordName>Grappling</style><style=cSub>Wendet <style=cIsDamage>stun</style> an und versucht, einen nahen Gegner zu ergreifen.</style>",
        "NEMFORCER_UTILITY_CRASH_NAME": "Hitzecrash",
        "NEMFORCER_UTILITY_CRASH_DESCRIPTION": "<style=cIsUtility>Grappling.</style> Springe in die Luft und schlage dann zu, um <style=cIsDamage>2400 % Schaden</style> zu verursachen. <style=cIsUtility>Verursacht verringerten Schaden außerhalb des Aufprallzentrums.</style>",
        "NEMFORCER_SPECIAL_MINIGUNUP_NAME": "Unterdrückungshaltung",
        "NEMFORCER_SPECIAL_MINIGUNUP_DESCRIPTION": "Nehmen Sie eine offensive Haltung ein und <style=cIsDamage>machen Sie Ihre Minigun bereit</style>. <style=cIsHealth>Verhindert Sprinten</style>.",
        "NEMFORCERBODY_DEFAULT_SKIN_NAME": "Nemesis",
        "NEMFORCERBODY_ENFORCER_SKIN_NAME": "Vollstrecker",
        "NEMFORCERBODY_CLASSIC_SKIN_NAME": "Klassiker",
        "NEMFORCERBODY_TYPHOON_SKIN_NAME": "Champion",
        "NEMFORCERBODY_DRIP_SKIN_NAME": "Dripforcer",
        "NEMFORCERBODY_DEDEDE_SKIN_NAME": "König Dedede",
        "NEMFORCERBODY_MINECRAFT_SKIN_NAME": "Minecraft",
        "NEMFORCERBODY_FEM_SKIN_NAME": "Mit Stacheln versehen",
        "ACHIEVEMENT_ENFORCER_NEMESIS2UNLOCKABLE_ACHIEVEMENT_ID_NAME": "???",
        "ACHIEVEMENT_ENFORCER_NEMESIS2UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Stabilisieren Sie als Vollstrecker im Monsun oder höher die Leerenfelder und besiegen Sie die Überreste des Vollstreckers.",
        "ACHIEVEMENT_NEMFORCER_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Nemesis Enforcer: Mastery",
        "ACHIEVEMENT_NEMFORCER_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Schlagen Sie als Nemesis Enforcer das Spiel oder vernichten Sie Monsoon.",
        "ACHIEVEMENT_NEMFORCER_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Nemesis Enforcer: Grand Mastery",
        "ACHIEVEMENT_NEMFORCER_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Besiege als Nemesis Enforcer das Spiel oder vernichte Taifun oder Eclipse.\n<color=#8888>(Zählt jeden Schwierigkeitsgrad Typhoon oder höher)</color>",
        "ACHIEVEMENT_NEMFORCER_DOMINANCEUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Nemesis Enforcer: Demolition",
