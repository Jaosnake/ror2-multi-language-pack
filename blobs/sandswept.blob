			body.AddItemBehavior<GalvanicCellShieldController>(((Object)(object)body.inventory.GetEquipment((uint)body.inventory.activeEquipmentSlot).equipmentDef == (Object)(object)EquipmentDef) ? 1 : 0);
		}

		private void HealthComponent_TakeDamage(orig_TakeDamage orig, HealthComponent self, DamageInfo damageInfo)
		{
			if (NetworkServer.active && self.body.HasBuff(BuffBase<ParryBuff>.instance.BuffDef) && damageInfo.damage > 0f && damageInfo.procCoefficient > 0f)
			{
				HandleParryBuffsServer(self.body, damageInfo);
			}
			else
			{
				orig.Invoke(self, damageInfo);
			}
		}

		protected override bool ActivateEquipment(EquipmentSlot slot)
		{
			//IL_0046: Unknown result type (might be due to invalid IL or missing references)
			//IL_004b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0052: Unknown result type (might be due to invalid IL or missing references)
			//IL_005d: Unknown result type (might be due to invalid IL or missing references)
			//IL_007a: Expected O, but got Unknown
			if ((Object)(object)slot.characterBody == (Object)null)
			{
				return false;
			}
			GalvanicCellShieldController component = ((Component)slot.characterBody).GetComponent<GalvanicCellShieldController>();
			PulseShieldForBody(slot.characterBody);
			if (Object.op_Implicit((Object)(object)component))
			{
				component.activated = true;
			}
			EffectManager.SpawnEffect(GameObject.LoaderGroundSlam, new EffectData
			{
				origin = slot.characterBody.corePosition,
				scale = slot.characterBody.bestFitRadius * 2f
			}, true);
			return true;
		}

		public static void HandleParryBuffsServer(CharacterBody body, DamageInfo damageInfo)
		{
			if (body.HasBuff(BuffBase<ParryBuff>.instance.BuffDef))
			{
				body.RemoveBuff(BuffBase<ParryBuff>.instance.BuffDef);
			}
			if (!body.HasBuff(BuffBase<ParryActivatedBuff>.instance.BuffDef))
			{
				body.AddBuff(BuffBase<ParryActivatedBuff>.instance.BuffDef);
			}
			body.AddTimedBuff(BuffDef.bdImmune, 0.5f);
			((Component)body).GetComponent<GalvanicCellShieldController>().damageInfo = damageInfo;
		}
	}
	public class GalvanicCellShieldController : ItemBehavior
