        "KEYWORD_DANCER_JAB": "<style=cKeywordName>Jab</style><style=cSub>A terra, mira in avanti. Scatta e infliggi <style=cIsDamage>180% di danno</style>.</style>",
        "KEYWORD_DANCER_DOWNTILT": "<style=cKeywordName>Inclinazione verso il basso</style><style=cSub>A terra, mira verso il basso. Scaglia i nemici in aria e infliggi <style=cIsDamage>200% di danno</style>.</style>",
        "KEYWORD_DANCER_FORWARDAIR": "<style=cKeywordName>Attacco aereo in avanti</style><style=cSub>In aria, mira in avanti. Un colpo pesante infligge <style=cIsDamage>180% di danno</style>, schiaccia a terra i nemici, li stordisce e infligge fino a <style=cIsDamage>300% di danno</style>.</style>",
        "NDP_DANCER_BODY_SECONDARY_SLASH_NAME": "Secondaria",
        "NDP_DANCER_BODY_SECONDARY_SLASH_DESCRIPTION": "Scatta nella direzione scelta e colpisci <style=cIsDamage>3</style> volte, infliggendo <style=cIsDamage>250% di danni</style> per colpo.",
        "NDP_DANCER_BODY_UTILITY_DRILL_NAME": "Utilità (trivella)",
        "NDP_DANCER_BODY_UTILITY_DRILL_DESCRIPTION": "Scatta orizzontalmente infliggendo <style=cIsDamage>3x180% di danni</style>, poi esegui un <style=cIsDamage>Inclinazione verso il basso</style>. Accumula fino a <style=cIsUtility>2</style> cariche.",
        "NDP_DANCER_BODY_SPECIAL_RIBBON_NAME": "Speciale",
        "NDP_DANCER_BODY_SPECIAL_RIBBON_DESCRIPTION": "<style=cIsDamage>Stordente.</style> Lancia un proiettile che lega i nemici con un <color=#b50727>nastro</color> per <style=cIsDamage>8</style> secondi. Colpire i nemici legati conferisce una <style=cIsHealing>barriera temporanea</style> e <style=cIsDamage>prolunga</style> il nastro.",
        "KEYWORD_DANCER_CANCELS": "Scattare <style=cIsUtility>annulla</style> i colpi rapidi in un attacco in corsa. Saltare <style=cIsUtility>annulla</style> gli attacchi a terra in attacchi aerei.",
        "KEYWORD_DANCER_DASH": "<style=cKeywordName>Attacco in corsa</style><style=cSub>Comando: a terra, correndo. Scatta in avanti, interrompi i nemici e infliggi <style=cIsDamage>250%</style> di danni.</style>",
        "KEYWORD_DANCER_UPAIR": "<style=cKeywordName>Attacco aereo verso l’alto</style><style=cSub>Comando: mira in alto. Due attacchi infliggono <style=cIsDamage>150%</style> e <style=cIsDamage>200%</style> di danni. Il secondo è stretto e infligge fino a <style=cIsDamage>3x</style> danni ai nemici con poca salute.</style>",
        "KEYWORD_DANCER_DOWNAIR": "<style=cKeywordName>Attacco aereo verso il basso</style><style=cSub>Comando: in aria, mira in basso. Tuffati infliggendo ripetutamente <style=cIsDamage>125%</style> di danni. Atterrando, esegui un <style=cIsDamage>Inclinazione verso il basso</style>.</style>",
        "KEYWORD_DANCER_INPUTS": "<style=cKeywordName>Comandi</style><style=cSub>Direzione di movimento, corsa e salto producono attacchi. Alcuni comandi ripetuti producono attacchi diversi. Una spiegazione migliore arriverà presto, scusa.</style>",
