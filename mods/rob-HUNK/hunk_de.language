    "ROB_NEMESIS_ITEM_EFFECT_TITLE": "Bonuseffekt",
    "ROB_NEMESIS_ITEM_EFFECT_BANDOLIER": "Munitionspakete stellen <style=cIsHealth>10% Biomasse</style> wieder her.",
