    "CI_DIFFICULTY_HURTMEPLENTY_NAME": "Hurt Me Plenty",
    "CI_DIFFICULTY_HURTMEPLENTY_DESC": "Hic est modus quo ludus ut Doomguy ludendus est! Vince Dominum Ultimum Principalem ut Doomguy ad reserandam hanc difficultatem omnibus superstitibus et ceteras difficultates pro Doomguy (nunc haec facultas nondum perfecta est).<style=cStack>\n\nCeleritas Telorum Monstrorum: <style=cIsHealing>-35%</style>\nAltitudo Volatus Monstrorum: <style=cIsHealing>8m</style>\nElecti: <style=cIsHealing>Sublati</style>\nRepulsio: <style=cIsDamage>Sublata</style>\nFuchi, Res et Instrumenta: <style=cIsDamage>Recomposita</style>. <style=cIsHealth>-75% damnum. Non possunt stupefacere, fulminare, retinere nec congelare</style>\nMonstra: <style=cIsHealth>Non petunt ministros</style>\nSalus Monstrorum Gravium: <style=cIsHealth>+60%</style>\nSalus Dominorum Monstrorum: <style=cIsHealth>+120%</style>\nTypographi et Detritores: <style=cIsHealth>Sublati</style>\nRes Inanis et Lunares: <style=cIsHealth>Sublatae</style>\nMonstra Infirma: <style=cIsHealth>Sublata</style>\nStupores Ictus: <style=cIsHealth>Sublati</style></style>",
    "CI_DOOMGUY_BODY_NAME": "Doomguy",
    "CI_DOOMGUY_BODY_SUBTITLE": "Vir damnatus vel vir fati vel aliquid tale nescio",
    "CI_DOOMGUY_NAME": "Doomguy",
    "CI_DOOMGUY_DESC": "Ipse est Doomguy!",
    "CI_DOOMGUY_SHOTGUN_NAME": "Sclopetum Pugnae",
    "CI_DOOMGUY_SHOTGUN_DESC": "Eiaculare glandes pro <style=cIsDamage>5x120% damno</style>",
    "CI_DOOMGUY_SPEAR_NAME": "Ictus Hastae",
    "CI_DOOMGUY_SPEAR_DESC": "Vibra hastam pro <style=cIsDamage>200% damno</style>. <style=cIsUtility>Propulsa</style> impetus et tela advenientia <style=cIsHealing>propulsabilia</style>. Accipe <style=cDeath>roborationem</style> et <style=cIsUtility>minue tempus refectionis</style> facultatis Utilitatis tuae in <style=cIsHealing>propulsatione felici</style>",
    "CI_DOOMGUY_ACCELERATOR_NAME": "Accelerator Plasmatis",
    "CI_DOOMGUY_ACCELERATOR_DESC": "Eiaculare telum plasmatis pro <style=cIsDamage>50% damno</style>. Ignis continuus acceleratorem superonerabit et damnum teli plasmatis ad <style=cIsDamage>125% damnum</style> augebit. Emitte superonus dimisso axe et infer <style=cIsDamage>500% damnum</style>",
    "CI_DOOMGUY_DASH_NAME": "Impetus",
    "CI_DOOMGUY_DASH_DESC": "<style=cIsUtility>Prorue</style> in directionem motus",
    "CI_DOOMGUY_SPEARSPECIAL_NAME": "Roboratio Hastae",
    "CI_DOOMGUY_SPEARSPECIAL_DESC": "Para hastam ad <style=cDeath>roborationem</style>. Consume 5 <style=cDeath>roborationes</style> in usu.\n\nPrimaria: Iace hastam pro <style=cIsDamage>2000% damno</style>. Infer <style=cIsDamage>ictum criticum</style> et <style=cIsDamage>maximum stuporem</style> ictu in caput.\n\nSecundaria: WIP\n\nUtilitas: Desili deorsum inferens <style=cIsDamage>700% damnum</style> intra <style=cIsUtility>radium 24 metrorum</style>",
    "CI_DOOMGUY_PUNCH_NAME": "Pugnus",
    "CI_DOOMGUY_PUNCH_DESC": "Percute scopum pugno pro <style=cIsDamage>800% damno</style>. Si scopus <style=cDeath>titubat</style>, onus non consumitur et sana pro <style=cIsHealing>3.125%/12.5%/25%</style> salutis maximae et <style=cIsHealing>10%/25%/50%</style> curationis subsidiariae secundum classem scopi atque accipe <style=cDeath>roborationem</style>"
  }
