    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>Salud: </color>20\n<color=#FF0000>Armadura: </color>7\n\nRotation Velocidad: 50\n\nPeso: 27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% de Velocidad de ataque</color>\n <color=#fc8080>-15% de Regeneración de salud</color>\n <color=#fc8080>+5% de Enfriamiento total</color>\n\n<color=#00FF00>Salud: </color>20\n<color=#FF0000>Armadura: </color>2\n\nRotation Velocidad: 40\n\nPeso: 20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Salud: </color>10\n<color=#FF0000>Armadura: </color>0\n\nRotation Velocidad: 55\n\nPeso: 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Salud: </color>100\n<color=#FF0000>Armadura: </color>20\n\nRotation Velocidad: 33\n\nPeso: 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% de Enfriamiento especial</color>\n <color=#fc8080>+15% de Enfriamiento secundario</color>\n <color=#fc8080>-10% de Velocidad de ataque</color>\n\n<color=#00FF00>Salud: </color>120\n<color=#FF0000>Armadura: </color>23\n\nRotation Velocidad: 29\n\nPeso: 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% de Daño</color>\n <color=#fc8080>+10% de Enfriamiento total</color>\n\n<color=#00FF00>Salud: </color>160\n<color=#FF0000>Armadura: </color>0\n\nRotation Velocidad: 25\nLímite de Ángulo: 90\n\nPeso: 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Salud: </color>45\n<color=#FF0000>Armadura: </color>4\n\nRotation Velocidad: 25\n\nPeso: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Salud: </color>35\n<color=#FF0000>Armadura: </color>15\n\nRotation Velocidad: 35\n\nPeso: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% de Enfriamiento primario</color>\n <color=#fc8080>+8% de Enfriamiento secundario</color>\n <color=#fc8080>+8% de Enfriamiento de utilidad</color>\n <color=#fc8080>+8% de Enfriamiento especial</color>\n <color=#fc8080>-15% de Velocidad de ataque</color>\n\n<color=#00FF00>Salud: </color>35\n<color=#FF0000>Armadura: </color>3\n\nRotation Velocidad: 30\n\nPeso: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% de Daño</color>\n\n<color=#00FF00>Salud: </color>5\n<color=#FF0000>Armadura: </color>1\n\nRotation Velocidad: 40\nLímite de Ángulo: 30\n\nPeso: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ORIGINAL",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "ROJO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "ROJO CLARO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "VERDE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "VERDE OSCURO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "AZUL",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "CIAN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "ROSA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "ROSA INTENSO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "MAGENTA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "AMARILLO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "AMARILLO NEÓN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "MORADO NEÓN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "NARANJA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "BLANCO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "NEGRO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Esto cambia la parte 'brillante' del vehículo a un color diferente.  No afecta la jugabilidad.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Sucio",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Limpio",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Camuflaje_Dentado",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Camuflaje_Pixelado",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Camuflaje_Papel",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Placa_Diamante",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Placa_Atornillada",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Conjunto_Procedural",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Mezcla_Colorida",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Degradado_Arcoíris",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Monocromático",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Galaxia_Fluida",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Espacio",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Sistemas de Motor",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Las utilidades y el empuje consumen combustible. La reposición de combustible se ve afectada por la <style=cIsUtility>velocidad de ataque</style>; la capacidad de combustible se ve afectada por los <style=cIsUtility>posquemadores</style> y los <style=cIsUtility>objetos de salto</style>. El tanque puede <style=cIsUtility>correr en cualquier dirección</style>. El empuje permite un control versátil en el aire. Sin embargo, <color=#fc8080>el tanque no puede saltar normalmente</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Súper Arsenal",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "Las selecciones de casco y torreta afectan la salud, armadura, velocidad, empuje y masa. <style=cIsUtility>Una mayor masa puede ayudar a empujar a enemigos más pesados</style>; de lo contrario, serás más propenso al <color=#ffff80>retroceso</color>.\n\nLa armadura o la velocidad pueden ayudar a mitigar la <color=#fc8080>pésima regeneración de salud</color> del tanque.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Inestabilidad Celestial",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "El tanque no puede reequilibrarse en el aire, <color=#ffff80>siendo propenso a perder el control</color>. Aterrizar de cabeza te deja <color=#fc8080>inmovilizado y vulnerable por un corto tiempo</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Propulsores de Vuelo",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Mantén presionado <style=cIsUtility>Saltar</style> para iniciar el vuelo. La dirección del vuelo depende del ángulo de tu tanque. <style=cIsUtility>El vuelo más versátil</style>, pero puede ser difícil de usar.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Propulsores de Pulso",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Permite que el tanque <style=cIsUtility>salte</style> normalmente como otros sobrevivientes. La inclinación del tanque se puede activar en el 2.º salto. Cada salto consume <color=#ffc080>25</color> de combustible.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Propulsores de Levitación",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Permite que el tanque flote sobre el suelo. Mantén presionado <style=cIsUtility>Saltar</style> para ascender; mantén presionado <style=cIsUtility>LeftAlt</style> para descender. Ascender consume más combustible.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Ametralladoras",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Dispara constantemente por un <style=cIsDamage>2x40% de daño</style>.\n<style=cSub>[Peso: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Escopeta",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Dispara por un <style=cIsDamage>12x75% de daño</style>.  <color=#ffc080>Quema combustible</color> para <style=cIsUtility>ganar cargas adicionales</style>; <color=#80fc80>logra una acrobacia</color> para obtener temporalmente un disparo potente por un <style=cIsDamage>18x150% de daño</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 1s</style> | Peso: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Lanzagranadas",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Dispara proyectiles imprecisos por un <style=cIsDamage>4x250% de daño</style>.  Los proyectiles son explosivos y pesados.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 4s</style> | <style=cIsDamage>Radio: 5m</style> | Peso: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Lanzamisiles",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Dispara misiles precisos por un <style=cIsDamage>1000% de daño</style>. <style=cIsDamage>El daño aumenta a medida que viaja</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 3s</style> | <style=cIsDamage>Radio: 8m</style> | Peso: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Lanzallamas",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Escupe fuego por un <color=#E85E31>25% de daño por quemadura</color> cada <color=#ffc080>15 de combustible por segundo</color>.  El daño aumenta con las acumulaciones; <style=cIsUtility>la velocidad de ataque aumenta el alcance</style>.\n<style=cSub>[<color=#ffc080>Impulsado por Combustible</color> | Peso: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ultrantena",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Electrocútate a ti mismo</color> y <style=cIsUtility>activa objetos al matar</style>.  <style=cIsUtility>Tocar a los enemigos también los electrocuta</style>, y reciben un <style=cIsDamage>250% de daño</style> por objeto <style=cIsUtility>al matar</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 7s</style> | <style=cIsDamage>Radio: 5m</style> | Peso: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Cañón Crítico",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Dispara por un <color=#ff4d76>1200% de daño crítico</color>. La probabilidad de crítico aumenta el daño del cañón.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 7s</style> | <style=cIsDamage>Radio: 10m</style> | Peso: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Cañón Obús",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Carga para disparar por un explosivo <style=cIsDamage>7000% de daño</style>. <style=cIsUtility>Puede impulsar al tanque si está en el aire.</style>\n<style=cSub>[<style=cIsUtility>Enfriamiento: 16s</style> | <style=cIsDamage>Radio: 15m</style> | Peso: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Cañón Golpeador",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Dispara de forma imprecisa por un <style=cIsDamage>1700% de daño</style>. <style=cIsDamage>El daño disminuye a medida que viaja</style>; <style=cIsDamage>Los objetos de activación aumentan el daño en su lugar</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 3s</style> | <style=cIsDamage>Radio: 5m</style> | Peso: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Cañón Perforante",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Dispara por un <style=cIsDamage>2500% de daño</style>.  Mantén presionado para calibrar e infligir un <style=cIsDamage>3500% de daño</style>, capaz de <style=cIsUtility>golpear puntos débiles</style>.  Cuando está calibrado, <color=#fc8080>moverse empeora la precisión</color>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 5s</style> | <style=cIsDamage>Radio: 2m</style> | Peso: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Cañón Francés",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Dispara por un mísero <style=cIsDamage>550% de daño</style>. Por alguna razón, <style=cIsUtility>tiene demasiada activación</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 1s</style> | Peso: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Minigun",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Dispara ráfagas por un <style=cIsDamage>50% de daño</style>. Al 75% de sobrecalentamiento aplica <color=#E85E31>fuego</color>; <color=#fc8080>el sobrecalentamiento bloquea el arma</color>. <style=cIsUtility>Los objetos de enfriamiento aumentan la tasa de enfriamiento</style>; <style=cIsUtility>los cargadores de respaldo evitan el sobrecalentamiento</style>.\n<style=cSub>[Peso: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Cañón Básico",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Dispara un proyectil veloz por un <style=cIsDamage>5400% de daño</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 12s</style> | <style=cIsDamage>Radio: 7m</style> | Peso: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Cañón AA",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Dispara por un <style=cIsDamage>300% de daño</style>.  El proyectil detona cerca de objetivos aéreos, infligiendo <style=cIsDamage>2.5x de daño</style>.  <color=#fc8080>El tanque se ralentiza para disparar</color>.\n<style=cSub>[<style=cIsDamage>Radio: 5.5m</style> | Peso: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Cañón de Dispersión",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Dispara por un <style=cIsDamage>2200% de daño</style> en un <style=cIsUtility>gran arco</style>, salpicando por un <style=cIsDamage>10x5% del daño total</style>.  El daño aumenta cuanto más lejos viaja, hasta un <style=cIsDamage>5500% de daño</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 10s</style> | <style=cIsDamage>Radio: 16m</style> | Peso: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Cañón Celestial",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Consume <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> de combustible por <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>de daño</color>.  Los láseres cargados perforan; <color=#fc8080>la falta de combustible desactiva el arma.</color>\n<style=cSub>[<color=#ffc080>Impulsado por Combustible</color> | Peso: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Cañón Obliterador",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Carga para disparar automáticamente un <color=#E85E31>proyectil que activa efectos al matar</color> por un <style=cIsDamage>12000% de daño</style>.  Después, <color=#fc8080>las habilidades se desactivan durante 4 segundos.  El proyectil puede dañar a los aliados</color>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 21s</style> | <style=cIsDamage>Radio: 5m</style> | Peso: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Cañón Automático",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Dispara hasta 4 proyectiles que infligen un <style=cIsDamage>2000% de daño</style> cada uno. El último proyectil inflige <style=cIsDamage>2x de daño</style> en un punto fijo.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 14s</style> | <style=cIsDamage>Radio: 7m</style> | Peso: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Pala",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Embiste una corta distancia</style> por <color=#ffc080>50</color> de combustible. Puede empujar a <style=cIsUtility>cualquier enemigo</style> por un <style=cIsDamage>1000% de daño</style> y reponer <color=#ffc080>40</color> de combustible.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 2s</style> | Peso: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Púas",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Embiste una gran distancia</style> por <color=#ffc080>50</color> de combustible. Embiste enemigos por un <color=#AA2B2A>550% de daño por sangrado</color>.  <style=cIsUtility>No tiene enfriamiento</style>.\n<style=cSub>[Peso: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Turbo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Acelera a fondo</style> y consume <color=#ffc080>30</color> de combustible por segundo.  Puede embestir por un <style=cIsDamage>250% de daño</style>. Embestir añade <color=#ffc080>20</color> de combustible.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 1s</style> | Peso: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Súper Salto",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Lánzate hacia arriba por <color=#ffc080>50</color> de combustible.  Al correr, lánzate hacia adelante por <color=#ffc080>75</color> de combustible y sacude tu tanque por un <style=cIsDamage>2500% de daño</style>.  El peso del tanque aumenta el daño.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Topadora",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Impúlsate</style> y consume <color=#ffc080>20</color> de combustible por segundo.  Puede arrollar a <style=cIsUtility>cualquier enemigo</style> por un <style=cIsDamage>200% de daño</style> constante.  Inflige un <style=cIsDamage>350% de daño</style> al impactar.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 1s</style> | Peso: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Carga para <style=cIsUtility>embestir la mayor distancia</style> por <color=#ffc080>100</color> de combustible.  <style=cIsUtility>Atraviesa multitudes</style> por un <color=#AA2B2A>4000% de daño por sangrado</color> y <style=cIsUtility>prolonga la embestida</style>; gira para terminar la embestida; <color=#80fc80>logra una acrobacia</color> para <style=cIsUtility>omitir la carga</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 7s</style> | Peso: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Excavadora",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Mantén presionado para excavar</style>, consumiendo <color=#ffc080>20</color> de combustible por segundo, <style=cIsUtility>protegiendo tu tanque mientras estás bajo tierra</style>.  Suelta para emerger e infligir un <style=cIsDamage>900% de daño</style> a los enemigos cercanos.  No puedes atacar mientras estás bajo tierra.\n<style=cSub>[<style=cIsDamage>Radio: 10m</style> | Peso: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Mina Real",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Suelta una mina terrestre que inflige un <style=cIsDamage>3000% de daño</style>.  <style=cIsDamage>Los objetos de activación aumentan el daño en su lugar</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 10s</style> | <style=cIsDamage>Radio: 10m</style> | Peso: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Minas en Miniatura",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Apunta y lanza todas las minas terrestres en miniatura que infligen un <style=cIsDamage>750% de daño</style> cada una.  Los objetos de cargas y de interactuables aumentan el máximo de minas.  <color=#ffc080>Quema combustible</color> para <style=cIsUtility>ganar cargas adicionales</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 3s</style> | <style=cIsDamage>Radio: 10m</style> | Peso: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Barril Explosivo",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Lanza un barril por <color=#ffc080>25</color> de combustible que se enciende al colisionar por un <style=cIsDamage>6500% de daño</style>, y deja un <color=#E85E31>charco ardiente</color>.  <color=#80fc80>Lograr una acrobacia</color> hace que esta habilidad sea temporalmente <color=#fc8080>inestable</color>, lo que <style=cIsUtility>lanza tu tanque girando sin control</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 14s</style> | <style=cIsDamage>Radio: 18m</style> | <style=cIsDamage>Radio de Zona: 8</style> | Peso: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Autodestrucción",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Aniquila a <color=#d40000>TODOS</color> en 35m por un <style=cIsDamage>100000% de daño</style>.  Comienza con un <color=#80fc80>Dio's Best Friend</color> en una nueva partida.\n<style=cSub>[<style=cIsDamage>Radio: 35m</style> | Peso: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "REINADO",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Desacelera y carga para disparar una descarga de misiles.  El daño aumenta cuanto más lejos viaja, hasta un <style=cIsDamage>12x3000% de daño.</style>\n<style=cSub>[<style=cIsUtility>Enfriamiento: 30s</style> | <style=cIsDamage>Radio: 10m</style> | Peso: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Evadir",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Emite humo, aturdiendo a los enemigos cercanos por un <style=cIsDamage>150% de daño</style> y ocúltate.  <style=cIsUtility>Vuélvete inmune</style> al daño durante 1 segundo.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 12s</style> | <style=cIsDamage>Radio: 10m</style> | Peso: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Pasiva: Frenesí",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Elimina esta habilidad. Aumenta la <style=cIsDamage>velocidad de ataque base en 0.5</style> y reduce el <style=cIsUtility>enfriamiento en un 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Pasiva: Motores",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Elimina esta habilidad. Aumenta la <style=cIsUtility>velocidad base en 1m/s</style> y la <style=cIsUtility>potencia de empuje en un 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Pasiva: Armadura",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Elimina esta habilidad. Aumenta la <style=cIsUtility>armadura base en 30</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Maestría",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Como Celestial War Tank, gana la partida o oblitérate en Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Maestría",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Cañón Celestial",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Como Celestial War Tank, ve a casa",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Cañón Celestial",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Obliterador",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Como Celestial War Tank, inflige más de 1,000,000 de daño en un solo disparo.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Obliterador",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Como Celestial War Tank, gana la partida o oblitérate en Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Blindado",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Como Celestial War Tank, obtén 10000 de Salud.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Blindado",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "El tanque definitivo de la destrucción. ¡Resiste a todo tipo de enemigos, atropellándolos y aplastándolos con su poderoso peso y armamento!\n\n<style=cSub>< ! > El tanque es enorme y sumamente lento, lo que te hace susceptible a cualquier forma de daño. Jugar de manera extremadamente defensiva o agresiva ayudará a mitigar la cantidad de daño que recibirás. Ten en cuenta que el tanque no tiene curación.\n\n< ! > El chasis del tanque se puede usar para hacer daño: ¡atropella a tus enemigos o usa tu peso para aplastarlos a todos!\n\n< ! > Cuando el tanque se estrella, es más pesado y tarda un rato en volver a levantarse, siendo susceptible a más daño por caída. El tanque no puede hacer acrobacias.\n\n< ! > Los factores de curación están mitigados: ¡el tanque tiene demasiada salud!\n\n< ! > Presiona 'T' para tocar la bocina.  Configurable en los ajustes del mod.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Entidad Extranjera",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Tras investigar más a fondo, hemos descubierto cierto origen de estos tanques: las manos de los carroñeros. Construidos con piezas de chatarra de calidad y objetos de la UES, habían creado con éxito estos tanques de guerra.\n\nSin embargo, esto lleva a conclusiones peligrosas. Después de obtener una de las antenas enemigas, hemos alertado a este coloso del tamaño de un tanque. ¡Es del tamaño de los guardias escarabajo!\n\nPor supuesto, tras una larga batalla, finalmente lo derribamos. Esperamos investigar más y alterar su mente, con la esperanza de obtener mejores respuestas. Será una tarea difícil, ya que ES tecnología alienígena.\n\nUn detalle enorme a tener en cuenta es que, al ser derrotado, invocó un portal de emergencia. El portal más grande y violento que jamás hayamos visto. Por mucho que pueda llevarnos directo a las respuestas, no creo que vaya a ser un paseo por el parque. Un tanque promedio ya es demasiado letal, y no estoy seguro de qué otros inventos hechos por los carroñeros existen ahí afuera.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ORIGINAL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "BLANCO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "NEGRO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "ROJO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "ROJO OSCURO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "VERDE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "AZUL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "CIAN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "AMARILLO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "AMARILLO NEÓN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "MAGENTA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "MORADO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "NARANJA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "MARRÓN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "ESTADOS UNIDOS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "ALEMANIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "REINO UNIDO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "RUSIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "FRANCIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "Esto cambia el color del chasis.  No afecta la jugabilidad.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "PRINCIPAL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "AMARILLO SUCIO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "VERDE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "VERDE SUCIO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "AZUL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "AZUL SUCIO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "ROJO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "ROJO SUCIO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "MAESTRÍA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Casco Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Potencia del Motor: </color>3000\n<color=#00FFFF>Velocidad: </color>10\nTraverse Velocidad: 0.8\n\n<color=#00FF00>Salud: </color>1000\n<color=#FF0000>Armadura: </color>75\n\n<color=#AA00FF>Potencia de Empuje: </color>35\n<color=#ffc080>Cantidad de Combustible: </color>500\nPeso: 1000\n\nTipo de Casco: Tanque",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Casco Griffon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Compatible con torreta</color>.\n\n<color=#FFFF00>Potencia del Motor: </color>2300\n<color=#00FFFF>Velocidad: </color>11\nTraverse Velocidad: 1\n\n<color=#00FF00>Salud: </color>800\n<color=#FF0000>Armadura: </color>25\n\n<color=#AA00FF>Potencia de Empuje: </color>40\n<color=#ffc080>Cantidad de Combustible: </color>500\nPeso: 800\n\nTipo de Casco: Auto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "Casco TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Potencia del Motor: </color>1200\n<color=#00FFFF>Velocidad: </color>12\nTraverse Velocidad: 2\n\n<color=#00FF00>Salud: </color>500\n<color=#FF0000>Armadura: </color>25\n\n<color=#AA00FF>Potencia de Empuje: </color>40\n<color=#ffc080>Cantidad de Combustible: </color>300\nPeso: 450\n\nTipo de Casco: Tanque",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Casco Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Potencia del Motor: </color>3500\n<color=#00FFFF>Velocidad: </color>8\nTraverse Velocidad: 0.6\n\n<color=#00FF00>Salud: </color>1400\n<color=#FF0000>Armadura: </color>100\n\n<color=#AA00FF>Potencia de Empuje: </color>34\n<color=#ffc080>Cantidad de Combustible: </color>750\nPeso: 1250\n\nTipo de Casco: Tanque",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Casco Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Proporciona más <style=cIsUtility>control en el aire</style>.\n\n\n<color=#FFFF00>Potencia del Motor: </color>2000\n<color=#00FFFF>Velocidad: </color>13\nTraverse Velocidad: 1.4\n\n<color=#00FF00>Salud: </color>600\n<color=#FF0000>Armadura: </color>20\n\n<color=#AA00FF>Potencia de Empuje: </color>40\n<color=#ffc080>Cantidad de Combustible: </color>450\nPeso: 750\n\nTipo de Casco: Auto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "Casco AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>La velocidad no se ve afectada por el peso</style>.\n\n<color=#FFFF00>Potencia del Motor: </color>700\n<color=#00FFFF>Velocidad: </color>9\nTraverse Velocidad: 0.7\n\n<color=#00FF00>Salud: </color>900\n<color=#FF0000>Armadura: </color>50\n\n<color=#AA00FF>Potencia de Empuje: </color>35\n<color=#ffc080>Cantidad de Combustible: </color>370\nPeso: 1100\n\nTipo de Casco: Tanque",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "Casco TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Potencia del Motor: </color>3700\n<color=#00FFFF>Velocidad: </color>8\nTraverse Velocidad: 0.5\n\n<color=#00FF00>Salud: </color>1150\n<color=#FF0000>Armadura: </color>60\n\n<color=#AA00FF>Potencia de Empuje: </color>34\n<color=#ffc080>Cantidad de Combustible: </color>1000\nPeso: 1200\n\nTipo de Casco: Tanque",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Casco Pigeon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Compatible con torreta</color>.\n\n<color=#FFFF00>Potencia del Motor: </color>1500\n<color=#00FFFF>Velocidad: </color>7\nTraverse Velocidad: 1.4\n\n<color=#00FF00>Salud: </color>150\n<color=#FF0000>Armadura: </color>5\n\n<color=#AA00FF>Potencia de Empuje: </color>40\n<color=#ffc080>Cantidad de Combustible: </color>300\nPeso: 100\n\nTipo de Casco: Auto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Casco Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Puede escalar paredes</style>. El salto se retrasa un segundo y el <color=#fc8080>daño de embestida se reduce en un 50%</color>.\n\n\n<color=#FFFF00>Potencia del Motor: </color>2750\n<color=#00FFFF>Velocidad: </color>9\nTraverse Velocidad: 0.8\n\n<color=#00FF00>Salud: </color>1300\n<color=#FF0000>Armadura: </color>90\n\n<color=#AA00FF>Potencia de Empuje: </color>31\n<color=#ffc080>Cantidad de Combustible: </color>550\nPeso: 1300\n\nTipo de Casco: Meca",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "Casco TANKDOZER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "La pala <style=cIsUtility>bloquea</style> todo el <style=cIsDamage>daño recibido</style>.\n\nModo Cazatanques: <color=#fc8080>No puede montar torreta</color>.\n\n<color=#FFFF00>Potencia del Motor: </color>2500\n<color=#00FFFF>Velocidad: </color>8.5\nTraverse Velocidad: 0.9\n\n<color=#00FF00>Salud: </color>1250\n<color=#FF0000>Armadura: </color>80\n\n<color=#AA00FF>Potencia de Empuje: </color>34\n<color=#ffc080>Cantidad de Combustible: </color>500\nPeso: 1200\n\nTipo de Casco: Tanque",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Casco Truck Kan",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "El daño de embestida aumenta en un <color=#80fc80>100.0%</color>\n\n<color=#80fc80>Compatible con torreta</color>.\n<style=cIsUtility>La velocidad no se ve afectada por el peso</style>.\n\n<color=#FFFF00>Potencia del Motor: </color>1000\n<color=#00FFFF>Velocidad: </color>12\nTraverse Velocidad: 0.9\n\n<color=#00FF00>Salud: </color>450\n<color=#FF0000>Armadura: </color>15\n\n<color=#AA00FF>Potencia de Empuje: </color>40\n<color=#ffc080>Cantidad de Combustible: </color>600\nPeso: 600\n\nTipo de Casco: Auto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Salud: </color>250\n<color=#FF0000>Armadura: </color>25\n\nRotation Velocidad: 7.5\n\nPeso: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Torreta",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Salud: </color>100\n<color=#FF0000>Armadura: </color>10\n\nRotation Velocidad: 20\n\nPeso: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Salud: </color>100\n<color=#FF0000>Armadura: </color>15\n\nRotation Velocidad: 15\n\nPeso: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Salud: </color>400\n<color=#FF0000>Armadura: </color>50\n\nRotation Velocidad: 5\n\nPeso: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "¿<style=cIsDamage>200% de daño</style>?  No pude encontrar el código donde aumenta el daño para esta torreta en específico.\n- Desarrollador\n\n\n<color=#00FF00>Salud: </color>150\n<color=#FF0000>Armadura: </color>25\n\nRotation Velocidad: 13\nLímite de Ángulo: 60\n\nPeso: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Añade <style=cIsDamage>5 cargas</style> a la habilidad <style=cIsUtility>secundaria</style>.\n<style=cIsUtility>Restaura todas las cargas</style> tras el enfriamiento.\nEl daño del cañón disminuye en un 80%\n\n<color=#00FF00>Salud: </color>300\n<color=#FF0000>Armadura: </color>20\n\nRotation Velocidad: 7\n\nPeso: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Salud: </color>200\n<color=#FF0000>Armadura: </color>30\n\nRotation Velocidad: 9\n\nPeso: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Salud: </color>300\n<color=#FF0000>Armadura: </color>35\n\nRotation Velocidad: 7\n\nPeso: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Peso Pesado",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "El tanque puede <style=cIsUtility>atropellar enemigos</style>, con <style=cIsDamage>daño dependiente de la velocidad</style>.  Caer con una configuración pesada hace que tu peso cree una <style=cIsUtility>onda de choque</style>, dañando a los enemigos cercanos.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Ninguno",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Elimina esta habilidad.  Aumenta las siguientes estadísticas:\n\nVelocidad de Ataque: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Ninguno",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Ninguno",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Elimina esta habilidad.  Aumenta las siguientes estadísticas:\n\nVelocidad: <color=#80fc80>+1</color> m/s\nPotencia de Propulsores: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Ninguno",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Elimina esta habilidad.  Aumenta la armadura en <color=#80fc80>30</color> y aumenta la capacidad de combustible en <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Mini Cañón",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Dispara de forma imprecisa por un <style=cIsDamage>200% de daño.</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "PEM",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "¡Enciende tu escudo y crea un PEM por un <style=cIsDamage>2000% de daño</style>, que electrocuta a los enemigos!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "¡Almacena una reserva masiva de hasta 22 misiles! Cada uno inflige desde un <style=cIsDamage>1100% de daño</style> hasta un <style=cIsDamage>1800% de daño</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Cañón Automático Rápido",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Dispara proyectiles explosivos a los enemigos por un <style=cIsDamage>500% de daño</style>. Debe recargar cada 4 segundos.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Cañón Poderoso",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Dispara por un <style=cIsDamage>7500% de daño</style>, empujando a los enemigos.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 16s</style> | <style=cIsDamage>Radio: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Cañón de Artillería",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Mantén presionado para apuntar</style> y suelta para disparar un proyectil poderoso por un <style=cIsDamage>7000% de daño</style>.  El daño aumenta cuanto más lejos viaja, hasta un <style=cIsDamage>14000% de daño</style>.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 16s</style> | <style=cIsDamage>Radio: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Cañón Criogénico",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Dispara una bola de nieve gigante por un <color=#75EAFF>1500% de daño</color> y congela a los enemigos.\n<style=cSub>[<style=cIsUtility>Enfriamiento: 5s</style> | <style=cIsDamage>Radio: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Cañón Dúo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Dispara por un <style=cIsDamage>5400% de daño</style>. Mantén presionado para disparar 2 proyectiles, lo que <color=#fc8080>aumenta el enfriamiento de la habilidad</color> después. Disparar un doble <color=#80fc80>reduce enormemente</color> el siguiente tiempo de carga durante 2 segundos.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "Cañón Británico",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Dispara por un <style=cIsDamage>2400% de daño</style>.  <color=#fc8080>No puede activar objetos</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Gran Cañón Malvado",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Dispara por un <style=cIsDamage>2000% de daño</style>.  <style=cIsUtility>Mantén presionado para cargar</style> e infligir hasta un <style=cIsDamage>11000% de daño</style>.  La carga máxima dispara el cañón automáticamente por un <style=cIsDamage>5500% de daño láser</style> adicional con <style=cIsUtility>retroceso adicional</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Experimental de Oppenheimer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "¡Deja que tu proyectil destruya tu escudo y aniquila por un <color=#ff4d76>9000% de daño crítico</color>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Propulsores a Reacción",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Enciende y consume <color=#ffc080>70 de combustible</color> por segundo, permitiendo que el tanque gane más y más velocidad con el tiempo.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Ciclo de Energía",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Activa para alternar entre 3 modos: Evadir, Ataque o Defensa: \n\n<style=cIsUtility>Evadir</style>: ¡Reduce la velocidad de ataque en un 50% y aumenta el enfriamiento en un 50% para obtener un 50% extra de velocidad, 10% de potencia de empuje y 50% de potencia del motor!\n\n<color=#80fc80>Defensa</color>: Sacrifica un 70% de velocidad y un 100% de potencia de empuje por 500 de armadura.\n\n<style=cIsDamage>Ataque</style>: Todas las armas infligen el doble de daño. Reduce los enfriamientos en un 33% y aumenta la velocidad de ataque en un 33%, pero pierdes TODA la armadura y curación. Activar este modo electrocuta tu tanque durante 2 segundos.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Overclock",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "¡Deja que tu velocidad destruya tu escudo y haz estallar violentamente tus propulsores por un <style=cIsDamage>6000% de daño</style> lanzándote al aire y <style=cIsUtility>evitando el daño por caída</style>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Escudos",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "Activa para volverte <style=cIsUtility>inmune al daño externo</style> durante 4 segundos.  Se puede sacrificar por una <color=#03fcc2>Habilidad de Poder</color> de un solo uso.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Explosicular",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Dispara 4 cañones, cada uno infligiendo un <style=cIsDamage>1400% de daño</style> en un radio enorme. Las armas se <color=#fc8080>sobrecalientan</color> en lugar de recargar.\n<style=cSub>[<style=cIsDamage>Radio: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Estándar",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Experiencia estándar.\n\nEl tanque se mueve y gira según la dirección de movimiento elegida.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Alternativo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Cambia la forma en que se juega con este tanque.\n\nEl tanque se mueve según la dirección del casco, pero <color=#fc8080>no girará en la dirección de movimiento</color>.  Esto se controla <style=cIsUtility>girando manualmente</style>.\n\nMientras vuela, los controles vuelven a Estándar.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Modo de Energía: <style=cIsUtility>Evadir</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Reduce la velocidad de ataque en un 50% y aumenta el enfriamiento en un 50% para obtener un 50% extra de velocidad, 10% de potencia de empuje y 50% de potencia del motor.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Modo de Energía: <color=#80fc80>Defensa</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "Sacrifica un 70% de velocidad y un 100% de potencia de empuje por 500 de armadura.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Modo de Energía: <style=cIsDamage>Ataque</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "Todas las armas infligen el doble de daño. Reduce los enfriamientos en un 33% y aumenta la velocidad de ataque en un 33%, pero pierdes TODA la armadura y curación. Activar este modo electrocuta tu tanque durante 2 segundos.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "Y pensar que Dedee finalmente había sido liberado, \r\nfue capturado una vez más por la UES.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "Sin Torreta",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "Elimina la torreta.  <style=cIsDamage>Aumenta todo el daño en un 30%</style>"
  }
}