        "ACHIEVEMENT_ROB_HUNK_FLAMER_ACHIEVEMENT_ID_DESCRIPTION": "Como HUNK, mejora completamente el lanzallamas químico.",
        "ACHIEVEMENT_ROB_HUNK_SURVIVALKIT_ACHIEVEMENT_ID_NAME": "HUNK: No Luck At All",
        "ACHIEVEMENT_ROB_HUNK_SURVIVALKIT_ACHIEVEMENT_ID_DESCRIPTION": "Como HUNK, te quedas sin munición al comienzo.",
        "ACHIEVEMENT_ROB_HUNK_JUMPPACK_ACHIEVEMENT_ID_NAME": "HUNK: Nowhere to Go But Up",
        "ACHIEVEMENT_ROB_HUNK_JUMPPACK_ACHIEVEMENT_ID_DESCRIPTION": "Como HUNK, conviértete en víctima de un accidente de paracaidismo.",
        "ROB_NEMESIS_BODY_NAME": "Nemesis T-Type",
        "ROB_NEMESIS_BODY_DESCRIPTION": "El Nemesis T-Type es un arma biológica imparable construida para resistir cualquier cantidad de castigo y neutralizar a sus objetivos con facilidad.<color=#CCD3E0>\n\n< ! > Puedes cargar los saltos para alcanzar una mayor distancia.\n\n< ! > Consumir enemigos te deja vulnerable; busca un lugar seguro antes de hacerlo.\n\n< ! > La biomasa aumenta tu daño cuando está llena.</color>",
        "ROB_NEMESIS_BODY_SUBTITLE": "Arma Biológica Imparable",
        "ROB_NEMESIS_BODY_OUTRO_FLAVOR": "..y así partió, todo bien.",
        "ROB_NEMESIS_BODY_OUTRO_FAILURE": "..y así desapareció, unidad humana ahora neutralizada.",
        "ROB_NEMESIS_BODY_DEFAULT_SKIN_NAME": "Predeterminado",
        "ROB_NEMESIS_BODY_CLASSIC_SKIN_NAME": "Clásico",
        "ROB_NEMESIS_BODY_VENOM_SKIN_NAME": "Simbiote",
        "ROB_NEMESIS_BODY_SUPER_SKIN_NAME": "<color=#FFFF00> Partidario temprano</color>",
        "ROB_NEMESIS_BODY_MAHORAGA_SKIN_NAME": "Big Raga El Opp Stoppa",
        "ROB_NEMESIS_BODY_MINOS_SKIN_NAME": "rey de los hombres",
        "ROB_NEMESIS_BODY_PASSIVE_NAME": "Forma de vida definitiva",
        "ROB_NEMESIS_BODY_PASSIVE_DESCRIPTION": "<style=cIsDamage>Infligir daño</style> acumula <style=cIsHealth>Biomasa</style>, lo que aumenta tu <style=cIsDamage>daño</style> cuando está llena. Puedes <style=cIsDamage>cargar</style> los saltos para dar <style=cIsUtility>saltos poderosos</style>.",
        "ROB_NEMESIS_BODY_PASSIVE2_NAME": "Armamento Biológico",
        "ROB_NEMESIS_BODY_PASSIVE2_DESCRIPTION": "El Nemesis T-Type puede <style=cIsHealth>mutar</style> consumiendo <style=cIsDamage>personas de interés</style>, ganando <style=cIsDamage>habilidades nuevas y mejoradas</style>.",
        "ROB_NEMESIS_BODY_PASSIVE22_NAME": "Aumento de Masa Muscular",
        "ROB_NEMESIS_BODY_PASSIVE22_DESCRIPTION": "<style=cIsUtility>Ataques cuerpo a cuerpo</style> causan <style=cIsDamage>20%</style> más daño, <style=cIsHealth>PERO los aliados pueden sufrir daño</style>.",
        "ROB_NEMESIS_BODY_MELEE_NAME": "Agressión Brutal",
        "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Puñetazo para <style=cIsDamage>350% de daño</style>. Usa mientras <style=cIsUtility>quieto</style> para pisotear para <style=cIsDamage>800% de daño</style>. Usa mientras <style=cIsUtility>corriendo</style> para dar una embestida de hombro para <style=cIsDamage>600% de daño</style>.",
        "ROB_NEMESIS_BODY_GRAB_NAME": "Alcance Mortal",
        "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Agarra un enemigo. Usa Primario para consumirlo y curar 10% de la salud máxima, o Secundario para cargar un lanzamiento de hasta 2.400% de daño.",
        "ROB_NEMESIS_BODY_DASH_NAME": "Embestida de Riesgo Biológico",
        "ROB_NEMESIS_BODY_DASH_DESCRIPTION": "Usa mientras <style=cIsUtility>en el aire</style> para avanzar en el aire <style=cIsDamage>una vez</style>.",
        "ROB_NEMESIS_BODY_ULTIMATE_NAME": "Masa Crítica",
        "ROB_NEMESIS_BODY_ULTIMATE_DESCRIPTION": "Mantén presionado para consumir lentamente <style=cIsHealth>Biomasa</style>, restaurando hasta <style=cIsHealing>100% de la salud máxima</style>.",
        "ROB_NEMESIS_ITEM_EFFECT_TITLE": "Efecto Adicional",
        "ROB_NEMESIS_ITEM_EFFECT_BANDOLIER": "Los paquetes de municiones restauran <style=cIsHealth>10% de Biomasa</style>.",
        "ROB_NEMESIS_ITEM_EFFECT_ALIENHEAD": "Aumenta la <style=cIsHealth>Biomasa</style> ganada al <style=cIsDamage>consumir</style> enemigos.",
        "ROB_NEMESIS_ITEM_EFFECT_BRAINSTALKS": "Mientras está activo, la <style=cIsHealth>Biomasa</style> es <style=cIsUtility>ilimitada</style>.",
        "ROB_NEMESIS_ITEM_EFFECT_PURITY": "Aumenta la <style=cIsHealth>Biomasa</style> ganada <style=cIsDamage>al acertar</style>.",
        "ROB_ARTIFACT_PURSUER_NAME": "Artefacto del Perseguidor",
        "ROB_ARTIFACT_PURSUER_DESC": "Los jugadores comienzan la partida con un Distintivo S.T.A.R.S.",
        "ROB_ARTIFACT_CONTAMINATION_NAME": "Artefacto de la Contaminación",
        "ROB_ARTIFACT_CONTAMINATION_DESC": "Cada jugador recibe un evento de Virus aleatorio cada Etapa.",
        "ROB_ARTIFACT_STRIKETEAM_NAME": "Artefacto de Poopfart",
        "ROB_ARTIFACT_STRIKETEAM_DESC": "Los jugadores ocasionalmente tendrán Escuadrones de Ataque enviados para neutralizarlos.",
        "ROB_HUNK_GHOST_UNLOCKABLE_NAME": "",
        "ROB_HUNK_GHOST_ACHIEVEMENT_NAME": "HUNK: The Forgotten Soldier",
        "ROB_HUNK_GHOST_ACHIEVEMENT_DESC": "",
        "ROB_HUNK_CONTAMINATION_UNLOCKABLE_NAME": "Zona Cero",
        "ROB_HUNK_CONTAMINATION_ACHIEVEMENT_NAME": "Zero Zone",
        "ROB_HUNK_CONTAMINATION_ACHIEVEMENT_DESC": "Entrega una muestra de virus a Umbrella Corporation.",
        "ROB_HUNK_PURSUER_UNLOCKABLE_NAME": "Némesis derribada",
        "ROB_HUNK_PURSUER_ACHIEVEMENT_NAME": "Nemesis Felled",
        "ROB_HUNK_PURSUER_ACHIEVEMENT_DESC": "Derrota al Némesis T-Type.",
        "ROB_HUNK_NEMESIS_UNLOCKABLE_NAME": "Un sueño de Armagedón",
        "ROB_HUNK_NEMESIS_ACHIEVEMENT_NAME": "A Dream of Armageddon",
        "ROB_HUNK_NEMESIS_ACHIEVEMENT_DESC": "Mata al Nemesis T-Type.",
        "ROB_HUNK_PARASITE_BODY_NAME": "G-Joven",
        "ROB_HUNK_HELICOPTER_BODY_NAME": "Helicóptero de Ataque",
        "ROB_HUNK_BODY_LORE": "**INT. INSTALACIÓN ABANDONADA DE UMBRELLA - NOCHE**\n\n(HUNK, el agente silencioso y mortal, está enfrascado en una feroz batalla con un imponente B.O.W. (arma bioorgánica). Esquiva hábilmente un golpe de la enorme garra de la criatura, se pone de pie y apunta con su metralleta. El B.O.W. ruge, lanzándose contra HUNK sin precaución.)\n\nHUNK: (gruñidos) Otro día más en la oficina.\n\n(HUNK saca una granada flash y la lanza con destreza a la cara del B.O.W. La criatura retrocede, cegada por la intensa luz. Aprovechando el momento, HUNK se apresura y trepa por la pierna del B.O.W. con sorprendente agilidad. Cuando llega a la sección media de la criatura, saca su cuchillo de combate.)\n\n(La cámara muestra un primer plano del rostro horrorizado de B.O.W. mientras se escucha un fuerte '¡corte!').\n\nB.O.W.: ¡¡RAAAAGHHHHH!!\n\n(Se escucha un silbido cómico mientras el B.O.W. cae al suelo, agarrándose la entrepierna. La pantalla tiembla con el impacto y escuchamos una serie de efectos de sonido exagerados: una bocina de auto, un gato aullando y vidrios rompiéndose).\n\nSPECTRE (Voz por comunicación): (Haciendo una mueca) Creo que sentí eso.\n\n(La cámara muestra a HUNK, quien mira directamente a la cámara con su característica mirada fría).\n\nHUNK: (inexpresivo) Y dijeron que nunca daría la talla.\n\n(El B.O.W. gime, rodando por el suelo en agonía. Se escucha un efecto de sonido clásico de 'boing'.)\n\nB.O.W.: MIS... ¡¡¡MIS MÓDULOS REGENERADORES!!!\n\n(Corte a COMMANDER mirando desde el centro de comando, con una expresión que mezcla de diversión y exasperación).\n\nCOMMANDER: (suspirando) No importa la misión, HUNK siempre sabe cómo golpear donde más duele.",
        "ROB_HUNK_KEYWORD_LOOTING": "<style=cKeywordName>Saqueo</style><style=cSub>Los enemigos eliminados con esta habilidad tienen una pequeña probabilidad de soltar munición.</style>",
        "ROB_HUNK_KEYWORD_MANGLED": "<style=cKeywordName>Mutilar</style><style=cSub>Al acumular 6 cargas de este efecto, los enemigos reciben instantáneamente <style=cIsDamage>2200%</style> de daño.</style>",
        "ROB_HUNK_KEYWORD_PERFECTDODGE": "<style=cKeywordName>Esquiva Perfecta</style><style=cSub>Recupera el tiempo de recarga y concede breve invulnerabilidad. Permite realizar un contraataque.</style>",
        "ROB_HUNK_KEYWORD_PERFECTPARRY": "<style=cKeywordName>Aparición Perfecta</style><style=cSub>Inflige <style=cIsDamage>800%</style> de daño y concede breve invulnerabilidad. Permite realizar un contraataque.</style>",
        "ROB_HUNK_KEYWORD_PERFECTBASH": "<style=cKeywordName>Deflexión Perfecta</style><style=cSub>Recupera el tiempo de recarga y concede breve invulnerabilidad. Permite realizar un contraataque.</style>",
        "ROB_HUNK_KEYWORD_COUNTER": "<style=cKeywordName>Contraataque</style><style=cSub>Pulsa la habilidad primaria para avanzar y ejecutar un contraataque letal contra un enemigo cercano.</style>",
        "ROB_HUNK_KEYWORD_GVIRUS": "<style=cKeywordName>Virus G</style><style=cSub>Una vez por fase, un monstruo aleatorio se infecta, muta y se fortalece con el tiempo. Al morir deja una muestra de G-Virus.</style>",
        "ROB_HUNK_KEYWORD_TVIRUS": "<style=cKeywordName>Virus T</style><style=cSub>Una vez por fase, varios monstruos se infectan y reviven dos veces. Eliminar a todos concede una muestra de T-Virus.</style>",
        "ROB_HUNK_KEYWORD_CVIRUS": "<style=cKeywordName>Virus C</style><style=cSub>Una vez por fase, varios monstruos se infectan. Al morir entran en frenesí durante <style=cIsUtility>5</style> segundos y explotan. Eliminar a todos concede una muestra de C-Virus.</style>"
    }
}
