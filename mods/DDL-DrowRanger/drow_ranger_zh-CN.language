{
    "zh-CN": {
        "DROWRANGER_NAME": "卓尔游侠",
        "DROWRANGER_SUBTITLE": "霜之射手",
        "DROWRANGER_SKIN_DEFAULT_NAME": "卓尔游侠",
        "DROWRANGER_SKIN_ARCANA_NAME": "仇尽寂灭",
        "DROWRANGER_DESCRIPTION": "卓尔游侠是一位擅长控制距离、以致命箭矢击破敌人防御的射手。<style=cSub>\n\n< ! >与敌人保持距离，才能充分发挥射手天赋的威力。但发射的弩箭飞行速度较慢，需要瞄准才能击中远处的目标。\n\n< ! >霜冻之箭能拖慢危险的敌人，低温症则能让成群敌人陷入连环冰爆。\n\n< ! >狂风可以为撤退创造空间，冰川提供临时的制高点。\n\n< ! >选择适合自己的专属装备，强化射程、生存或暴击。</style>",
        "DROWRANGER_OUTRO_FLAVOR": "崔希丝把冰封荒原留在了身后。",
        "DROWRANGER_OUTRO_FAILURE": "霜冻又吞没了一名猎人。",
        "DROWRANGER_RELIC_TITLE": "专属装备",
        "DROWRANGER_PIKE_NAME": "飓风长戟",
        "DROWRANGER_PIKE_DESC": "普通攻击在<style=cIsUtility>50米</style>内造成全额伤害，<style=cIsUtility>100米</style>外仍保留<style=cIsDamage>75%的伤害</style>。命中<style=cIsUtility>12米</style>内的非首领敌人时，将其<style=cIsUtility>击退</style>。所有箭矢的飞行速度提高<style=cIsUtility>50%</style>。",
        "DROWRANGER_BUTTERFLY_NAME": "蝴蝶",
        "DROWRANGER_BUTTERFLY_DESC": "攻击速度提高<style=cIsDamage>20%</style>。获得<style=cIsHealing>30%的概率格挡受到的伤害</style>，可与艰难时光叠加，但收益递减。",
        "DROWRANGER_DAEDALUS_NAME": "代达罗斯之殇",
        "DROWRANGER_DAEDALUS_DESC": "暴击率提高<style=cIsDamage>30%</style>。暴击造成<style=cIsDamage>225%的伤害</style>，可叠加其他暴击伤害加成。",
        "DROWRANGER_PRIMARY_NAME": "霜冻之箭",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>霜冻</style>。射出一支箭矢，造成<style=cIsDamage>260%的伤害</style>。",
        "DROWRANGER_HYPOTHERMIA_NAME": "低温症",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>低温症</style>。射出一支箭矢，造成<style=cIsDamage>260%的伤害</style>。受影响的敌人死亡时会爆炸。",
        "DROWRANGER_SECONDARY_NAME": "数箭齐发",
        "DROWRANGER_SECONDARY_DESC": "连续射出<style=cIsDamage>3波</style>贯穿箭矢，合计造成<style=cIsDamage>3x360%的伤害</style>。每波施加所选箭矢的效果。攻击速度对引导速度的提升效果减半。",
        "DROWRANGER_UTILITY_NAME": "狂风",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>眩晕</style>。释放狂风，<style=cIsUtility>击退</style>前方敌人并施加<style=cIsUtility>3层</style>所选箭矢的效果。移动速度提高<style=cIsUtility>50%</style>，持续<style=cIsUtility>4秒</style>；非疾跑状态下施放时，自身向后跃起。",
        "DROWRANGER_GLACIER_NAME": "冰川",
        "DROWRANGER_GLACIER_DESC": "在脚下升起一座高耸的<style=cIsUtility>冰川</style>，将自身抬至顶部并<style=cIsUtility>击退</style>附近敌人。冰川持续<style=cIsUtility>8秒</style>。",
        "DROWRANGER_SPECIAL_NAME": "射手天赋",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>被动</style>：周围<style=cIsUtility>15米</style>内没有敌人时，普通攻击有<style=cIsDamage>30%</style>的概率射出<style=cIsDamage>破甲箭</style>，造成<style=cIsDamage>390%的伤害</style>。\n<style=cIsUtility>主动</style>：触发概率提高至<style=cIsDamage>100%</style>，持续<style=cIsUtility>5秒</style>；附近有敌人时为<style=cIsDamage>50%</style>。",
        "DROWRANGER_WINTER_NAME": "凛冬一击",
        "DROWRANGER_WINTER_DESC": "短暂蓄力后射出一支<style=cIsDamage>破甲箭</style>，造成<style=cIsDamage>1600%的伤害</style>，最多贯穿<style=cIsDamage>5名敌人</style>并施加<style=cIsUtility>10层</style>所选箭矢的效果。蓄力无法主动取消。",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>霜冻</style><style=cSub>每层使剩余移动速度降低15%，持续3秒。最多叠加10层，再次命中刷新持续时间。不会使敌人完全冻结。</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>低温症</style><style=cSub>持续7秒，最多叠加10层。死亡时依层数在2至12米内爆炸，造成150%至600%的伤害。爆炸会传播低温症并引发连爆。不会使敌人减速。</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>箭矢射程</style><style=cSub>普通攻击伤害在40米后逐渐衰减，80米外保留60%。飓风长戟可延长有效射程。</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>破甲箭</style><style=cSub>无视敌人的护甲加成。可以暴击，并保留所选箭矢的效果。</style>"
    }
}