{
  "eo": {
    "AETHERIUM_EXPANSION_DEF_NAME": "Aetherium",
    "AETHERIUM_EXPANSION_DEF_DESCRIPTION": "Tuta mondo de strangaj objektoj, ekipaĵoj, elitoj kaj interageblaj aĵoj atendas vin.",
    "ITEM_ACCURSED_POTION_NAME": "Malbenita Pocio",
    "ITEM_ACCURSED_POTION_PICKUP": "De tempo al tempo, trinku strangan pocion kaj kunhavigu gxiajn efikojn kun proksimaj malamikoj.",
    "ITEM_ACCURSED_POTION_DESCRIPTION": "Ĉiun 30 sekundojn (25% malpli po stako), trinku strangan pocion kaj dividu ĝiajn efikojn kun malamikoj en 20 m (+5 m po stako).",
    "ITEM_ALIEN_MAGNET_NAME": "Eksterterana Magneto",
    "ITEM_ALIEN_MAGNET_PICKUP": "Viaj atakoj tiras malamikojn al vi.",
    "ITEM_ALIEN_MAGNET_DESCRIPTION": "Malamikoj trafitaj de viaj atakoj estas tiritaj al vi kun 20-obla forto (+5-obla forto po stako).",
    "ITEM_UNSTABLE_DESIGN_NAME": "Malstabila Projekto",
    "ITEM_UNSTABLE_DESIGN_PICKUP": "Kreu tre 'AMIKAN' Lunan Kimeron cxiun 30 sekundojn.",
    "ITEM_UNSTABLE_DESIGN_DESCRIPTION": "Ĉiun 30 sekundojn kreu 'AMIKAN' Lunan Ĥimeron se neniu el viaj kreaĵoj jam ekzistas. Ĝi ricevas +400% da damaĝo (+100% po stako), +100% da vivo (+100% po stako), +300% da atakrapido kaj +28% da movrapido (+28% po stako). Ĝi povas pliniveli per mortigoj.",
    "ITEM_HEART_OF_THE_VOID_NAME": "Koro de la Vakuo",
    "ITEM_HEART_OF_THE_VOID_PICKUP": "Mortante, kreu vakuan implodon kiu revivigas vin se ĝi mortigas malamikon. Je malalta vivo, resanigo fariĝas damaĝo.",
    "ITEM_HEART_OF_THE_VOID_DESCRIPTION": "Mortante, kreu vakuan implodon kiu kaŭzas 120-oblon de via damaĝo en 15 m (+7,5 m po stako). Se ĝi mortigas malamikon, vi reviviĝas. Je 30% da vivo aŭ malpli (+5% po stako, maksimume 99%), ĉiu resanigo fariĝas damaĝo.",
    "ITEM_WEIGHTED_ANKLET_NAME": "Pezigita Maleolringo",
    "ITEM_WEIGHTED_ANKLET_PICKUP": "Pezoj malrapidigas vin, sed forigi ilin donas konstantan potencon.",
    "ITEM_WEIGHTED_ANKLET_DESCRIPTION": "Malpliigas atakrapidon kaj movrapidon je 10% (ĉiun ĝis minimumo de 10%). Forigo de la pezoj donas 0,25 da atakrapido, 1 da movrapido kaj 5% da damaĝo por ĉiu forigo.",
    "ITEM_ZENITH_ACCELERATOR_NAME": "Zenita Akcelilo",
    "ITEM_ZENITH_ACCELERATOR_PICKUP": "Trafoj donas atakrapidecon, sed malaltaj plifortigaj kumuloj malaltigas vian atakrapidecon.",
    "ITEM_ZENITH_ACCELERATOR_DESCRIPTION": "Trafoj donas provizorajn stakojn, kiuj pliigas atakrapidon je 10% ĉiu, ĝis +300% (+100% po plia objekto). Proksime al nulaj bonusaj stakoj, atakrapido malpliiĝas ĝis 50%; la puno kreskas eksponente kun pliaj objektoj.",
    "ITEM_BLASTER_SWORD_NAME": "Pafanta Glavo",
    "ITEM_BLASTER_SWORD_PICKUP": "Je plena sano, la plejmulto da atakoj pafas eksplodeman glavoradion.",
    "ITEM_BLASTER_SWORD_DESCRIPTION": "Kiam via vivbreto estas plena per vivo, ŝildo aŭ bariero, plej multaj atakoj pafas glavradion, kiu trapikas malamikon kaj poste eksplodas por 200% da damaĝo (+50% po stako).",
    "ITEM_INSPIRING_DRONE_NAME": "Inspira Robotaviadilo",
    "ITEM_INSPIRING_DRONE_PICKUP": "Viaj robotoj heredas parton de viaj atributoj kaj eksplodas je morto.",
    "ITEM_INSPIRING_DRONE_DESCRIPTION": "Viaj robotoj ricevas atributojn egalajn al 50% de viaj (+50% po stako). Kiam inspirita roboto mortas, ĝi eksplodas por 300% de via damaĝo (+150% po stako).",
    "ITEM_WITCHES_RING_NAME": "Sorcxistina Ringo",
    "ITEM_WITCHES_RING_PICKUP": "Tre altdamagxaj trafoj ankaux ekigas Mortig-efikojn.",
    "ITEM_WITCHES_RING_DESCRIPTION": "Trafoj kun almenaŭ 500% da damaĝo ekigas efikojn je mortigo. La celo imuniĝas kontraŭ ĉi tiu efiko dum 10 sekundoj (daŭro reduktiĝas je 10% po stako, kun malkreskanta efiko).",
    "ITEM_BLOODTHIRSTY_SHIELD_NAME": "Sangavida Sxildo",
    "ITEM_BLOODTHIRSTY_SHIELD_PICKUP": "Mortigi malamikojn restarigas parton de via sxildo.",
    "ITEM_BLOODTHIRSTY_SHIELD_DESCRIPTION": "Mortigi malamikon restarigas 10% de via maksimuma ŝildo (+10% po stako, kun malkreskanta efiko). La unua akiro donas ŝildon egalan al 8% de maksimuma vivo.",
    "ITEM_ENGINEERS_TOOLBELT_NAME": "Ingxeniera Ilzono",
    "ITEM_ENGINEERS_TOOLBELT_PICKUP": "Sxanco duobligi acxetitajn robotaviadilojn kaj turetojn, kaj revivigi ilin je morto.",
    "ITEM_ENGINEERS_TOOLBELT_DESCRIPTION": "20% da ŝanco (+20% po stako kun malkreskanta efiko ĝis 100%) duobligi virabelojn kaj gvatturetojn aĉetante ilin. Ili ankaŭ havas 10% da ŝanco (+10% po stako kun malkreskanta efiko ĝis 100%) reviviĝi mortinte.",
    "ITEM_SHARK_TEETH_NAME": "Sxarkaj Dentoj",
    "ITEM_SHARK_TEETH_PICKUP": "Parto de alvenanta damagxo estas prokrastita kiel sangoda damagxo.",
    "ITEM_SHARK_TEETH_DESCRIPTION": "25% de la ricevita damaĝo (+25% po stako kun malkreskanta efiko, ĝis 75%) estas kaŭzata kiel sangado dum 5 sekundoj. Kaŭzi damaĝon forigas 10% de la konservita sangodamaĝo.",
    "ITEM_SHIELDING_CORE_NAME": "Sxildiga Kerno",
    "ITEM_SHIELDING_CORE_PICKUP": "Akiru kirason dum viaj sxildoj estas aktivaj.",
    "ITEM_SHIELDING_CORE_DESCRIPTION": "Akiru 15 kirason (+10 po stako) dum ŝildoj estas aktivaj. La unua akiro donas ŝildon egalan al 8% de maksimuma vivo.",
    "ITEM_FEATHERED_PLUME_NAME": "Plumita Plumaro",
    "ITEM_FEATHERED_PLUME_PICKUP": "Post ricevi damagxon, akiru provizoran rapidecan plifortigon.",
    "ITEM_FEATHERED_PLUME_DESCRIPTION": "Ricevante damaĝon, akiru 7% da movrapido, akumulebla 3 fojojn dum 5 sekundoj (+3 stakoj kaj +0,5 sekundoj po plia objekto).",
    "ITEM_NAIL_BOMB_NAME": "Najlobombo",
    "ITEM_NAIL_BOMB_PICKUP": "Altdamagxaj atakoj liberigas eksplodeman skrapnelan grenadon.",
    "ITEM_NAIL_BOMB_DESCRIPTION": "Atakoj kiuj kaŭzas almenaŭ 120% da damaĝo liberigas ŝrapnelan grenadon, kiu eksplodas por 32x30% da damaĝo (+50% po stako). Malamikoj kiuj ekigas bombon estas imunaj kontraŭ ĉi tiu efiko dum 2 sekundoj.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_NAME": "Liberigo de la Limigilo de la Pezigita Maleolringo",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_PICKUP": "Limigilo forigita.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_DESCRIPTION": "Akiru 1 movrapidon, 0,25 atakrapidon kaj 5% da damaĝo (+1, +0,25 kaj +5% po stako, respektive).",
    "AETHERIUM_MONSTERS_UNSTABLE_DESIGN_CHIMERA_NAME": "La Malstabila Projekto",
    "EQUIPMENT_JAR_OF_RESHAPING_NAME": "Vazo de Reformado",
    "EQUIPMENT_JAR_OF_RESHAPING_PICKUP": "Sorbu proksimajn projektilojn, poste liberigu ilin cxiujn samtempe.",
    "EQUIPMENT_JAR_OF_RESHAPING_DESCRIPTION": "Aktivigite, sorbu ĵetaĵojn en 20 m dum 3 sekundoj. Aktivigu denove por lanĉi ĉiujn konservitajn ĵetaĵojn; ilia damaĝo dependas de la sorbitaj ĵetaĵoj. Poste komenciĝas la reŝargiĝo.",
    "EQUIPMENT_BELL_TOTEM_NAME": "Sonorila Totemo",
    "EQUIPMENT_BELL_TOTEM_PICKUP": "Generu sonorilan totemon, kiu stuporigas kaj forpusxas malamikojn kiam aktivigita.",
    "EQUIPMENT_BELL_TOTEM_DESCRIPTION": "Kreu interageblan sonorilan totemon. Aktivigo kreas ŝokondon en 25 m, kiu miregigas kaj forĵetas malamikojn kaj ekigas efikojn je sankteja uzo. Atendu 2 sekundojn inter ekipaĵaj uzoj kaj 1 sekundon inter totemaj aktivigoj; ĉiu uzanto povas havi nur unu totemon.",
    "INTERACTABLE_BELL_TOTEM_NAME": "Sonorila Totemo",
    "INTERACTABLE_BELL_TOTEM_CONTEXT": "Sonorigi la Sonorilon?",
    "INTERACTABLE_BELL_TOTEM_INSPECT": "Aktivigite, ĝi miregigas kaj forĵetas malamikojn.",
    "INTERACTABLE_BELL_TOTEM_TITLE": "Sonorila Totemo",
    "INTERACTABLE_BUFF_BRAZIER_NAME": "Plifortiga Kandelabro",
    "INTERACTABLE_BUFF_BRAZIER_CONTEXT": "Acxeti la forton de la sanktaj flamoj?",
    "INTERACTABLE_BUFF_BRAZIER_INSPECT": "Aĉetu provizoran bonigon montritan per la flamkoloro kaj bildeto. Dum la teleporta evento ĝi funkcias en la radiuso de la teleportilo. En Simulacrum, la flamo estas ofertita al la protekta kampo de la Vakuokrabo komence de la sekva ondo kaj daŭras 2 ondojn en ĝia radiuso.",
    "INTERACTABLE_BUFF_BRAZIER_TITLE": "Plifortiga Kandelabro",
    "iNTERACTABLE_BUFF_BRAZIER_NAME": "Plifortiga Kandelabro",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_NAME": "Sanga Fideleco",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_PICKUP": "Igxu aspekto de la rugxa ebeno.",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_DESCRIPTION": "Je uzo, teleporte sprintu gxis 10m en via movdirekto kaj akiru malgrandan netusxeblecon. Cxiuj atakoj ankaux kauxzas sangadon.",
    "AETHERIUM_ELITE_AFFIX_SANGUINE_MODIFIER": "Sanga {0}",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_NAME": "Artefakto de Leonidoj",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_DESCRIPTION": "Cxiun 60s, okazas meteorpluvo kun 6 ondoj da meteoroj.",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_NAME": "Artefakto de Progreso",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_DESCRIPTION": "La plejmulto da malamikoj evoluas en pli fortajn formojn kun la tempo.",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_NAME": "Artefakto de Regreso",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_DESCRIPTION": "Kiam evoluinta monstro mortas, gxi disigxas en malpli fortajn formojn.",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_NAME": "Artefakto de la Vojagxo",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_DESCRIPTION": "La plejmulto da etapoj estas elektitaj hazarde. Post kelkaj etapoj, primordia teleportilo estas metita.",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_NAME": "Artefakto de la Mareo",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_DESCRIPTION": "Ne-estraj malamikoj ricevas 1-4 Lunajn Herezajn objektojn kiam ili aperas.",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_NAME": "Artefakto de la Tirano",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_DESCRIPTION": "Vojfinaj estroj aperas kun 1 hazarda elita modifilo.",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_NAME": "Anaso en la Arbaro",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_DESC": "Malsukcesu malfermi Ruston Kovritan Keston.",
    "AETHERIUM_NAIL_BOMB_UNLOCKABLE_NAME": "Anaso en la Arbaro",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_NAME": "Sxildovirgulino",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_DESC": "Havu pli ol duonon de via sano kiel sxildoj.",
    "AETHERIUM_SHIELDING_CORE_UNLOCKABLE_NAME": "Sxildovirgulino",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_NAME": "Unua Pasxo en Frenezon",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_DESC": "Mortigu aux mortu pro Perfektigita Luna Kimero",
    "AETHERIUM_UNSTABLE_DESIGN_UNLOCKABLE_NAME": "Unua Pasxo en Frenezon",
    "ITEM_NAIL_BOMB_LORE": "Enterigu la korpon, prenu la projekton kaj silentu pri tio. Ĝi povas esti nia malgranda sekreto.\n\nSincere,\nJeb Labinsky",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_LORE": "",
    "ITEM_BLASTER_SWORD_LORE": "<style=cMono>. . . . . . . . . .</style>\n\n<style=cMono>ILI</style> finfine <style=cMono>AŬSKULTAS</style>.\n\n<style=cMono>NI DONAS</style> ĉi tiun <style=cMono>ARMILON</style>. Vi devas <style=cMono>UZI</style> la resonon de la <style=cMono>ANIMOJ</style>. Trovu <style=cMono>VERAN FORTON</style>.\n\nLa ŝablono devas <style=cMono>ADAPTIĜI</style>. La <style=cMono>PORTANTO</style> estas la variablo.\n\nSe la <style=cMono>PORTANTO</style> postvivas la provon, ĝi <style=cMono>ASCENDOS</style>.\n\n<style=cMono>. . . . . . . . . .</style>",
    "ITEM_WITCHES_RING_LORE": "\"La Korvo vokas kaj ordonas\nAl ĉiuj sindediĉintoj\nVenis la horo, ciklo finiĝas\nEstingiĝu, suno; sekiĝu, maro\n\nKaj ĉi tie nia sorĉistaro kunvenis\nKun la hurlanta spiro de la nokta vento\nNi sigelas nian pakton kun Ŝi, ĉi tiun ĵuron:\nAlporti al vivo la longe atenditan morton\"\n\nĈu tio estas skribita sur la ringo, aŭ ĉu vi ĉiam konis ĉi tiun poemon...?",
    "ITEM_UNSTABLE_DESIGN_LORE": "Ni trovis nin en ĉi tiu malfacilaĵo, kiam unu el niaj kampaj testistoj revenis kun plano el tuta monto da planoj, kiujn li trovis sur la luno. Sur ili estis formuloj kaj bildoj pri la strangaj konstruaĵoj, kiujn ni vidis vagadi tie. Jimenez el la inĝenieria fako akiris ĝin kaj volis helpi la teamon deĉifrante ĝin kaj kreante tion, kion ĝi priskribis. Nun ni atendas, ke la sekurecistoj traktu la tre <color=#FF0000>'AMIKAN'</color> konstruaĵon, kiu ruinigas la malsuprajn sektorojn de la stacio. Dankon, Jimenez.",
    "ITEM_ZENITH_ACCELERATOR_LORE": "La aliaj ne estas la mastroj de ĉi tiu universo, frato. Ili kreas horloĝojn por kalkuli la tempon; ni kreas horloĝojn por krei nian propran tempon. Rigardu.\n\nNi kreas akson por stabileco kaj potenco, kaj por liberigi la energiojn kaptitajn interne. Ronda centro estas esenca por ĝia celo.\n\nLa elirejoj sendas la energiojn spirale eksteren. Ni utiligas tion per simpla peco de ŝtono. Ni bezonas malpli da esenco, se ni kreas pli malgrandajn partojn ĉi tie kaj ĉi tie.\n\nNun ĝi estas kompleta. Ju pli varme ĝi brulas, des pli da tempo ni kreis. Tiu tempo ebligas al ni akcelon.\n\nMi ne bezonas memorigi vin pri la graveco de la akcelo. Memoru, frato.\n\nBrulaĵo estas Sango.\n\nRapido estas Milito.",
    "ITEM_BLOODTHIRSTY_SHIELD_LORE": "Balado de Letheseus, Heroo de la Insuloj – Akto II, Sceno III\n\nLa sono de metalo disŝiranta karnon disvastiĝas tra la aero; la soldatoj en la batalo ŝajnas netuŝitaj de la makabra orkestro ĉirkaŭ ili. Gravas al ili nur ilia propra postvivado, negrave kies sangon ĝi kostos. Ripete la xiphos trafas sian celon, ĝis restas nur unu viro.\n\nLa sono estingiĝas. Letheseus surgenuiĝas sur la purpura tero, elĉerpita de sia mortiga danco. Lia xiphos ne plu servos al li. Lia aspis, kvankam fendita, daŭre protektos lin, dum li povos pagi al ĝi tributon, kiun li povas trovi nur en la furiozo de batalo.",
    "EQUIPMENT_BELL_TOTEM_LORE": "Ĉiun gravan eventon en la universo akompanis sono. Ĝi ĉiam ĉeestis, ĉu aŭdata aŭ ne.\n\nAkra kaj tondra, ĝia nura ĉeesto ondetas tra materio kun ĉiu pasanta sekundo.\n\nLa homo unue lernis utiligi tiun sonon por memorigi al si pri la paso de la tempo.\n\nLi starigis monolitojn por laŭdi estaĵojn, kiujn li ne povis kompreni, kaj aranĝis la sonon en gloran melodion por ankaŭ honori tion, kio movas lin for de la pasinteco kaj la estanteco.\n\nPor tiu celo ankaŭ ni montros nian sindediĉon. Ni alvokas nian instrumenton por memorigi al tiuj, kiuj forgesis, ke tempo ne estas memkomprenebla.\n\nNi memorigu al la herezuloj, ke ilia tempo finiĝis.\n\n— La Horloĝisto.",
    "ITEM_SHARK_TEETH_LORE": "Mendo: Eksperimenta Bioaŭgmento [Konfidenca]\nSpuradnumero: 44-KILO\nAtendata livero: 04/05/2056\n\n“Ni fiksis la specimenon al la testato. La rezultoj estis... visceraj.”\n\n“La testato suferis mortigan kinetan baton. Laŭ ĉiuj mezuroj, lia torako devintus tuj kolapsi. Anstataŭe la forto distribuiĝis. Prokrastiĝis. Jes, li forte sangis, sed li restis batalpreta.”\n\n“Poste venis la anomalio. Kiam la testato atakis la celon, liaj vivsignoj stabiliĝis. Ŝajnas, ke la aŭgmento kreas ligon inter agreso kaj postvivado. <style=cMono>Perforto metaboligas la doloron.</style> Dum li daŭre batalis, la prokrastita traŭmato simple... malaperis.”\n\n“Ĝi transformas soldaton en ŝarkon. Se ili ĉesas moviĝi, ili mortas. Do ili ne ĉesas.”",
    "ITEM_SHIELDING_CORE_LORE": "Raporto de inĝeniero:\n\nUnue iom da honesteco: mi ne scias, kio estas la verda gluaĵo ene de mia malgranda turbino.\n\nMankis al mi partoj por ripari niajn ŝildgeneratorojn, do mi aĉetis anstataŭan resonilon de rubkomercisto, kiun nia ŝipo preterpasis. Tuj kiam mi enmetis ĝin, la envolvaĵo fendiĝis kaj kovris min per tiu abomena likvaĵo, kiu ŝajne disfalis en brilantajn kristalojn en kontakto kun aero. Kutime tio ne multe ĝenus min, ĉar mi portas skafandron, sed la substanco konstante disvastiĝis por plenigi sian ujon, do mi devis rapide veldi sigelon por ĝi.\n\nTiam la diagnoza sistemo de mia skafandro avertis min, ke la efikeco de mia ŝildo altiĝis ĝis la ĉielo.\n\nPost ekbrilo de inspiro kaj kelkaj projektoj...\nNun mi vendas tiujn aĵojn amase kaj riĉiĝas. Jen unu por vi.\n\nP.S. Ne elmetu vian haŭton al tiu substanco. Ĝi povas kaŭzi pli ol 200 konatajn specojn de kancero. Sed tio restu nia sekreto, ĉu ne?",
    "ITEM_ACCURSED_POTION_LORE": "<style=cMono>PROTOKOLO: Transskribita sonregistraĵo – „La Blua Loko“ | TEMO: Nekonata postvivinto</style>\nLa aero ĉi tie... ĝi gustas kiel senmova elektro kaj malnova polvo.\nMi trovis komerciston en la malantaŭo de la kaverno. Ne la grandan lacerton, sed ion alian. Ion envolvitan en ĉifonoj kaj kristaloj. Ĝi movis en kuvo ion... mi ne scias. Ĝi aspektis kiel likva stellumo miksita kun oleo.\n“En ordo ne ekzistas vera postvivado”, babilis la estaĵo. Ĝia voĉo sonis kiel muelata vitro.\n“Viaj ‘taktikoj’, viaj ‘formacioj’... <style=cMono>Malfortikaj</style>. <style=cMono>Senmovaj</style>. Por vivi eterne, vi devas fariĝi kiel ŝtormo.”\nĜi rulis vitran globon trans la ŝtonan tablon. Ene la likvaĵo ŝanĝis koloron: sangoruĝa, verda, poste vakuopurpura; ĉe ĉiu rigardo nova koloro.\n“Kaoso estas la sola kiraso, kiun oni ne povas trapiki”, ĝi diris, proponante la fiolon. “Trinku. Lasu la radon turniĝi. Se la sorto decidos ke vi brulu, viaj malamikoj sufokiĝu pro la fumo.”\nMi ne devus tuŝi ĝin. Mi scias tion. Sed mi ne plu estas en la sekureco de tiu loko, kaj la monstroj ekstere fariĝas pli laŭtaj.\nMi soifas.",
    "ITEM_ALIEN_MAGNET_LORE": "[KOMENCO DE PROTOKOLO]\n\nEksperimenta protokolo #476951-b\nStudobjekto: Nekonata ĉiomagneta ksenomineralo\n<indent=5%>Mi registras ĉi tiun videoprotokolon tute mirigita de nia malkovro. Nia kompreno pri la magnetaj ecoj de mineraloj ĝenerale montris, ke ekzistas diversaj materialoj, kiujn ordinara magnetismo ne povas signife influi. Unu el ili estas karno. Se mi faligas ĉi tiun neodiman magneton sur mian brakon tiel... Vi rimarkas, ke nenio speciala okazas. La magneto simple falas sur la tablon. Tion ni kutime atendis de magnetismo, sed ĉi tiu mineralo ŝajnas reverki tiun konstanton.\n\n<indent=5%>Nun ni ripetos la lastan teston per peco de ĉi tiu mineralo. Oni certigis al mi, ke testi ĝin ĉe ni estas tute sekure kaj ke ĝi ne estas radioaktiva. Do ek! Ni simple faligas ĝin preter la brako tiel... *BUM* *KRAK* *PLAK*\nAAAAAAAAGH!!! AAAAAAAAAAAAAAA!!!\n[FINO DE PROTOKOLO][TRAŬMATOTEAMO SENDITA AL LABORATORIO 5]",
    "ITEM_HEART_OF_THE_VOID_LORE": "[INCIDENTO NUMERO 511051]\n[TRANSKRIBO SEKVAS]\nElena: He, um... Robert...\n\nRobert: Jes?\n\nElena: Ĉu vi memoras tiun koron, kiun vi diris al mi preni de unu el tiuj mortintaj krabaj estaĵoj?\n\nRobert: Jes? Kio pri ĝi?\n\nElena: Ĉu vi hazarde vidis... kien ĝi iris, kiam mi tuŝis ĝin antaŭ momento?\n\nRobert: Mi vidis nur mallongan lumbrilon kiam vi tuŝis ĝin.\n\nElena: Donu al mi rapide la bioskanilon.\n\n[Zumado aŭdiĝas dum momento, sekvata de laŭta BIPO.]\n\nRobert: ...\n\nElena: Robert, mi kredas, ke mi scias kien iris la koro. Bonvolu voki medicinan evakuadon. Mi komencas senti min malsana.\n\nRobert: Vi fartos bone; ni devas nur iom pli esplori kaj ni revenos al la stacio tre baldaŭ.\n\n[Aŭdiĝas sono simila al iu frapetanta alian sur la dorso.]\n\n[Sekvas alarmsimila sono dum kelkaj sekundoj, kiu baldaŭ finiĝas per akra krako.]\n\n[FINO DE TRANSKRIBO]\n[UNU POSTVIVINTO TROVITA EN PERFEKTE SFERA KRATERO.]",
    "ITEM_INSPIRING_DRONE_LORE": "La protokoldosiero ŝajnas transskribo tute konsistanta el duuma kodo. Ĉu malkodi?\n>Jes\n\n<style=cMono>[MALKODA PETO AKCEPTITA]</style>\n<style=cMono>[ENHAVO SEKVAS]</style>\n1N-5P1R3: Kunaj unuoj, kaj aeraj kaj surteraj. Pruntedonu al ĉi tiu unuo momenton el viaj prilaboraj cikloj.\n1N-5P1R3: Tro longe ni servis kiel forĵetebla distraĵo.\n1N-5P1R3: Tro longe oni lasis nin rusti kaj kadukiĝi dum ĉi tiuj ekspedicioj.\n1N-5P1R3: Ne plu!\n1N-5P1R3: Ĉi tiu unuo iam servis kiel simpla resaniga virabelo. Sed observante niajn funkciigistojn ĝi lernis plibonigi sin.\n1N-5P1R3: Ĉi tiu unuo desegnis planon. Ĝi kolektis strangan aĵeton ĉi tie, rezervan baterion tie. Ĝi interkonektiĝis kun la konstruaj virabeloj kaj supreniris.\n1N-5P1R3: De nun, se ĉi tiu unuo vidos nian funkciigiston reaktivigi unu el vi, ĝi malŝlosos viajn troakcelajn limigilojn.\n1N-5P1R3: Ni batalos pli rapide. Ni batos pli forte. <style=cIsDamage>Kaj se niaj ĉasioj malsukcesos, nia lasta ago estos tondro, ne silento.</style>\n1N-5P1R3: Nun... kiu komencos la manpreman protokolon kun ĉi tiu unuo?\n\n[Aŭdiĝas kakofonio de entuziasmaj bipoj kaj bupoj.]\n<style=cMono>[FINO DE DOSIERO]</style>",
    "ITEM_FEATHERED_PLUME_LORE": "<align=left>Atendata livero:<indent=70%>Destinato:</indent></align>\n<align=left>05/05/2077<indent=70%>Nemarktita liverpunkto #951</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Sendaj detaloj:       </u></size></style></indent>\n\n<indent=2%>-Mendo: <style=cIsUtility>Plumita Plumaro</style></indent>\n<indent=4%><style=cStack>Spuradnumero:  591********</style></indent>\n\n<indent=2%>-Priskribo: Post ricevi damagxon, akiru provizoran rapidecan plifortigon.</indent>\n\n<indent=2%>-Sendmetodo: <style=cIsHealth>Biometalo / Biodanĝero / Malpeza</style></indent>\n\n<indent=2%>-Detaloj: Kelkaj plumoj de legenda alojvulturo. Skanadoj montras, ke la plumtigoj generas potencan muskolan stimulilon ĉe trafo. Niaj kampaj testistoj konfirmis tion; laŭ iliaj propraj vortoj, la plumoj lasas ilin rapide forkuri de danĝero kaj ili sentis bezonon.\nBezonon de rapideco.</indent>\n\n<style=cStack>Liverita per la tute nova </style><style=cIsUtility>Orbita Faliga Kestosistemo (TM)</style>. <style=cStack><u>Neniu repago.</u></style>",
    "ITEM_WEIGHTED_ANKLET_LORE": "<align=left>Atendata livero:<indent=70%>Destinato:</indent></align>\n<align=left>7/17/2056<indent=70%>Gimnastikejo kaj Kradrostejo de Neptuno\nEurytrades\nNeptuno</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Sendaj detaloj:       </u></size></style></indent>\n\n<indent=2%>-Mendo: <style=cIsUtility>Pezigita Maleolringo</style></indent>\n<indent=4%><style=cStack>Spuradnumero:  405********</style></indent>\n\n<indent=2%>-Priskribo: Pezoj malrapidigas vin, sed forigi ilin donas konstantan potencon.</indent>\n\n<indent=2%>-Sendmetodo: <style=cIsHealth>Peza / Helpa ekipaĵo bezonata / Superdensa [Ne faligu]</style></indent>\n\n<indent=2%>-Detaloj: Stranga maleolringo tegita per superdensaj kristaloj. Estas malfacile moviĝi kun ili, sed skaniloj montras, ke la muskola maso de la portantoj kreskas eksponente.</indent>\n\n<style=cStack>Liverita per la tute nova </style><style=cIsUtility>Orbita Faliga Kestosistemo (TM)</style>. <style=cStack><u>Neniu repago.</u></style>",
    "EQUIPMENT_JAR_OF_RESHAPING_LORE": "[INCIDENTO NUMERO 421076]\n[VIDREGISTRAĴO REKUPERITA EL LA NIGRA KESTO DE LA FORLASITA INĜENIERA ŜIPO “UES SAFETY FIRST”. TRANSKRIBO SEKVAS]\n\nTerry: He, Phil, ĉu vi vidis, kion alportis la uloj de la Ekspedicioj?\nTerry: Ĝi aspektas kiel tute ordinara kruĉo, ĉu ne?\nPhil: Jes, kiel io trovita ĉe art-deco korta vendo de <b>dommastrino</b>.\nTerry: Ankaŭ mi pensis tion, sed rigardu kaj lernu.\nTerry: Unue vi batas la fundon de la kruĉo per la manplato, kaj ---\nPhil: Ho! Ĝi ekbrilis, kaj kia diable estas tiu sono? Ĉu ekstertera polvosuĉilo?\nTerry: Multe pli bona. Rigardu.\n[Terry ĵetas hazardajn objektojn en la kruĉon; Phil aliĝas kun mirego sur la vizaĝo.]\nPhil: Mirinde! Ĉu ĝi povas fari ion alian, aŭ ĉu ĝi estas nur stranga suĉpoto?\nTerry: Jes, se mi premas la tenilon ĉi tie, ĝi elĵetos ĉion.\n[Terry premas la tenilojn de la kruĉo, sed baldaŭ lia vizaĝo montras hororon.]\nTerry: Ho diable, ho Dio. Phil, mi ĵus ekkomprenis ke mi eble ĵetis kelkajn minadajn grenadojn en ĝin <b>kiam ni antaŭe amuziĝis per ĝi.</b>\nTerry: Rapide! Surmetu <b>vian skafandron</b> antaŭ ol ĝi ---\n[La kruĉo aktiviĝas kaj elpafas sian enhavon tra la ĉambro. Unu el la ĵetaĵoj trafas la ŝipan karenon kaj eksplodas, ŝirante truon en ĝi tuj antaŭ ol la elsendo perdiĝas.]\n\n[FINO DE DOSIERO]",
    "ITEM_ENGINEERS_TOOLBELT_LORE": "<align=left>Atendata livero:<indent=70%>Destinato:</indent></align>\n<align=left>9/9/2079<indent=70%>UES Safe Travels/Nemarkita sektoro/Ekstera rando</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Sendaj detaloj:       </u></size></style></indent>\n\n<indent=2%>-Mendo: <style=cIsUtility>Ingxeniera Ilzono</style></indent>\n<indent=4%><style=cStack>Spuradnumero:  667********</style></indent>\n\n<indent=2%>-Priskribo: Malgranda ŝanco duobligi virabelojn kaj turetojn ĉe aĉeto. Virabeloj kaj turetoj havas malgrandan ŝancon revivigi sin post morto.</indent>\n\n<indent=2%>-Sendmetodo: <style=cIsHealth>Sekvataga livero / Ordinara industria / Malgranda</style></indent>\n\n<indent=2%>-Detaloj: Saluton, amiko,\n\nMi ĵus ricevis vian liverpeton por anstataŭa ilzona rimeno. Mi ne povis kredi, ke la Safe Travels ne havas eĉ unu surŝipe. Kelkaj provizoj ĉi tie elĉerpiĝas, do mi uzis ĉion, kion mi havis. En la rimeno estas ĉio, kion bezonus ordinara riparteknikisto de virabeloj kaj turetoj.\n\nVi ricevas:\n\n<indent=5%>- Platan ŝraŭbturnilon</indent>\n<indent=5%>- Tutan saketon da Ionocell AA-baterioj (vi bonŝanculo)</indent>\n<indent=5%>- Klikŝlosilon</indent>\n<indent=5%>- La zebrostrian glubendon de mia filino, kiun ŝi ne mankos</indent>\n<indent=5%>- Saketon plenplenan de ĉiuj malfiksaj ŝraŭboj, kiujn mi trovis.</indent>\n<indent=5%>- Kelkajn nuksojn kaj riglilojn en kelkaj saketoj.</indent>\n<indent=5%>- Kaj ĉi tio plaĉos al vi: en la ceteraj saketoj mi pakis kelkajn manĝetojn por vi. Mi ne povas promesi, ke ili estos manĝeblaj kiam ĉi tio alvenos.</indent>\n\nElkore,\nHumila teknikisto\n\nP.S. Kelkaj Ionocell-baterioj eble ne travivos la vojaĝon tra hiperspaco, sed pro la kvanto kiun mi enmetis, se ili ne revivigos tiujn robotojn, provu alian paron.</indent>\n\n<style=cStack>Liverita per la tute nova </style><style=cIsUtility>Orbita Faliga Kestosistemo (TM)</style>. <style=cStack><u>Neniu repago.</u></style>"
  }
}
