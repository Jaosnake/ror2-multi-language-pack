    "DIFFICULTY_BAR_7": "मैं तुम्हें देख रहा हूँ",
    "DIFFICULTY_BAR_8": "मैं तुम्हारी ओर आ रहा हूँ",
    "DIFFICULTY_BAR_9": "हा हा हा हा हा हा",
    "STAGE_COUNT_FORMAT": "<style=cSub>चरण</style> {0}",
    "AMBIENT_LEVEL_DISPLAY_FORMAT": "<style=cSub>स्तर</style> {0}",
    "KEYWORD_POISON": "<style=cKeywordName>विषैला</style><style=cSub>10 सेकंड में दुश्मन के अधिकतम स्वास्थ्य के <style=cIsDamage>10%</style> के बराबर क्षति पहुँचाएँ। <i>ज़हर दुश्मनों को मार नहीं सकता।</i></style>",
    "KEYWORD_RAPID_REGEN": "<style=cKeywordName>पुनर्जीवी</style><style=cSub>0.5 सेकंड में अपने अधिकतम स्वास्थ्य का <style=cIsHealing>5%</style> वापस पाएँ।</style>",
    "KEYWORD_PERCENT_HP": "<style=cKeywordName>X% स्वास्थ्य</style><style=cSub>इस कौशल की लागत <style=cIsHealth>आपके मौजूदा स्वास्थ्य का X%</style> है।</style>",
    "KEYWORD_SONIC_BOOM": "<style=cKeywordName>ध्वनि धमाका</style><style=cSub>जिन दुश्मनों को यह लगता है, उन्हें दूर <style=cIsUtility>धकेलता</style> है। हवा में होने पर <style=cIsUtility>आपको पीछे धकेलता है</style>।</style>",
    "KEYWORD_WEAK": "<style=cKeywordName>कमज़ोर करें</style><style=cSub>चलने की गति और क्षति <style=cIsDamage>40%</style> घटाएँ। कवच <style=cIsDamage>20</style> घटाएँ।</style>",
    "KEYWORD_HEAVY": "<style=cKeywordName>भारी</style><style=cSub>आप जितनी तेज़ी से चलेंगे, कौशल उतनी अधिक क्षति पहुँचाएगा।</style>",
    "KEYWORD_FREEZING": "<style=cKeywordName>जमा देने वाला</style><style=cSub>दुश्मनों को वहीं जमा दें। जमे हुए दुश्मनों का <style=cIsHealth>तुरंत अंत हो जाता है</style> अगर उनका स्वास्थ्य <style=cIsHealth>30%</style> से कम हो।</style>",
    "KEYWORD_EXPOSE": "<style=cKeywordName>अरक्षित करें</style><style=cSub>अरक्षित दुश्मन पर वार करने से सभी कौशलों की पुनर्प्रयोग अवधि <style=cIsUtility>1.0 सेकंड</style> घटती है और <style=cIsDamage>+350% अतिरिक्त क्षति</style> होती है।</style>",
    "KEYWORD_SHOCKING": "<style=cKeywordName>विद्युत झटका</style><style=cSub>दुश्मनों की कार्रवाई रोककर उन्हें स्तब्ध कर देता है। लक्ष्य को उसके अधिकतम स्वास्थ्य के <style=cIsHealth>10%</style> से अधिक क्षति पहुँचने पर स्तब्धता खत्म हो जाती है।</style>",
    "KEYWORD_SLAYER": "<style=cKeywordName>संहारक</style><style=cSub>कम स्वास्थ्य वाले दुश्मनों को <style=cIsDamage>3x</style> तक क्षति पहुँचाता है।</style>",
    "KEYWORD_SUPERBLEED": "<style=cKeywordName>भीषण रक्तस्राव</style><style=cSub>15 सेकंड में <style=cIsDamage>2000%</style> मूल क्षति पहुँचाएँ। <i>भीषण रक्तस्राव जमा हो सकता है।</i></style>",
    "KEYWORD_IGNITE": "<style=cKeywordName>आग लगाएँ</style><style=cSub>समय के साथ <style=cIsDamage>+50%</style> अतिरिक्त कुल क्षति पहुँचाएँ।</style>",
    "KEYWORD_WEAKPOINT": "<style=cKeywordName>कमज़ोर बिंदु</style><style=cSub>दुश्मनों के शरीर पर <style=cIsDamage>कमज़ोर बिंदु</style> चिह्नित होते हैं। किसी <style=cIsDamage>कमज़ोर बिंदु</style> पर वार करने से <style=cIsDamage>क्रिटिकल वार</style> पक्का होता है।</style>",
    "KEYWORD_ACTIVERELOAD": "<style=cKeywordName>सक्रिय पुनर्भरण</style><style=cSub>गोली चलाने के बाद रेलगन फिर भरें। <style=cIsDamage>बिल्कुल सही समय पर पुनर्भरण</style> अगले शॉट में <style=cIsDamage>+500% अतिरिक्त मूल क्षति</style> देता है।</style>",
    "KEYWORD_VOIDCORRUPTION": "<style=cKeywordName>भ्रष्टता</style><style=cSub>क्षति झेलने, क्रिटिकल वार करने या शून्य की वस्तुएँ रखने से भ्रष्टता बढ़ती है। स्वास्थ्य वापस पाने से भ्रष्टता घटती है।</style>",
    "OBJECTIVE_TITLE": "उद्देश्य:",
