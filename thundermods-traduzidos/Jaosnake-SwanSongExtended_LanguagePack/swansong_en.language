    "PLAYER_DEATH_QUOTE_SWANSONG_4": "{0} was spontaneously lobotomized.",
    "PLAYER_DEATH_QUOTE_SWANSONG_4_2P": "Congratulations on the spontaneous lobotomy!",
    "PLAYER_DEATH_QUOTE_SWANSONG_5": "{0}'s innards became outards.",
