        "KEYWORD_DANCER_JAB": "<style=cKeywordName>Ictus</style><style=cSub>Input terrestre, dirige antrorsum. Antrorsum prorue et <style=cIsDamage>180% damnum</style> fac.</style>",
        "KEYWORD_DANCER_DOWNTILT": "<style=cKeywordName>Ictus Inferus</style><style=cSub>Input terrestre, dirige deorsum. Hostes sursum eice et <style=cIsDamage>200% damnum</style> fac.</style>",
        "KEYWORD_DANCER_FORWARDAIR": "<style=cKeywordName>Ictus Aerius Anterior</style><style=cSub>Input aerium, dirige antrorsum. Gravis ictus <style=cIsDamage>180% damnum</style> faciens qui hostes ad terram deicit, stupefaciens et usque ad <style=cIsDamage>300% damnum</style> faciens.</style>",
        "NDP_DANCER_BODY_SECONDARY_SLASH_NAME": "Secundaria",
        "NDP_DANCER_BODY_SECONDARY_SLASH_DESCRIPTION": "In directionem electam irruens <style=cIsDamage>3</style> ictus da, quorum quisque <style=cIsDamage>250% damni</style> infert.",
        "NDP_DANCER_BODY_UTILITY_DRILL_NAME": "Utilitas (Terebra)",
        "NDP_DANCER_BODY_UTILITY_DRILL_DESCRIPTION": "Horizontaliter irruens <style=cIsDamage>3x180% damni</style> inflige, deinde <style=cIsDamage>Ictus Inferus</style> incipe. Usque ad <style=cIsUtility>2</style> usus servare potest.",
        "NDP_DANCER_BODY_SPECIAL_RIBBON_NAME": "Specialis",
        "NDP_DANCER_BODY_SPECIAL_RIBBON_DESCRIPTION": "<style=cIsDamage>Stupefacit.</style> Telum mitte quod hostes <color=#b50727>vitta</color> per <style=cIsDamage>8</style> secunda ligat. Hostes ligatos oppugnando <style=cIsHealing>obicem temporarium</style> accipis et vittam <style=cIsDamage>prolongas</style>.",
        "KEYWORD_DANCER_CANCELS": "Currendo ictus celeres in impetum <style=cIsUtility>transire</style> potes; saliendo ictus terrestres in aereos.",
        "KEYWORD_DANCER_DASH": "<style=cKeywordName>Impetus</style><style=cSub>Imperium: in terra currens. Prorue, hostes interrumpe et <style=cIsDamage>250%</style> damni inflige.</style>",
        "KEYWORD_DANCER_UPAIR": "<style=cKeywordName>Ictus aereus sursum</style><style=cSub>Imperium: sursum intende. Duo ictus <style=cIsDamage>150%</style> et <style=cIsDamage>200%</style> damni inferunt. Secundus angustus usque ad <style=cIsDamage>3x</style> damnum hostibus parum valentibus infert.</style>",
        "KEYWORD_DANCER_DOWNAIR": "<style=cKeywordName>Ictus aereus deorsum</style><style=cSub>Imperium: in aere deorsum intende. Descende et saepe <style=cIsDamage>125%</style> damni inflige. Ad terram perveniens <style=cIsDamage>Ictus Inferus</style> incipe.</style>",
