{
  "en": {
    "AETHERIUM_EXPANSION_DEF_NAME": "Aetherium",
    "AETHERIUM_EXPANSION_DEF_DESCRIPTION": "A whole world of weird items, equipment, elites, and interactables awaits you.",
    "ITEM_ACCURSED_POTION_NAME": "Accursed Potion",
    "ITEM_ACCURSED_POTION_PICKUP": "Every so often, drink a strange potion and share its effects with nearby enemies.",
    "ITEM_ACCURSED_POTION_DESCRIPTION": "Every 30 seconds (25% shorter per stack), drink a strange potion and share its effects with enemies within 20m (+5m per stack).",
    "ITEM_ALIEN_MAGNET_NAME": "Alien Magnet",
    "ITEM_ALIEN_MAGNET_PICKUP": "Your attacks pull enemies toward you.",
    "ITEM_ALIEN_MAGNET_DESCRIPTION": "Enemies hit by your attacks are pulled toward you with 20x force (+5x force per stack).",
    "ITEM_UNSTABLE_DESIGN_NAME": "Unstable Design",
    "ITEM_UNSTABLE_DESIGN_PICKUP": "Create a very 'FRIENDLY' Lunar Chimera every 30 seconds.",
    "ITEM_UNSTABLE_DESIGN_DESCRIPTION": "Every 30 seconds, create a 'FRIENDLY' Lunar Chimera if one of your creations does not already exist. It gains +400% damage (+100% per stack), +100% health (+100% per stack), +300% attack speed and +28% movement speed (+28% per stack). It can level up from kills.",
    "ITEM_HEART_OF_THE_VOID_NAME": "Heart of the Void",
    "ITEM_HEART_OF_THE_VOID_PICKUP": "On death, trigger a void implosion that revives you if it kills an enemy. At low health, healing becomes damage.",
    "ITEM_HEART_OF_THE_VOID_DESCRIPTION": "On death, trigger a void implosion dealing 120x your damage within 15m (+7.5m per stack). If it kills an enemy, you revive. At 30% health or less (+5% per stack, up to 99%), all healing becomes damage.",
    "ITEM_WEIGHTED_ANKLET_NAME": "Weighted Anklet",
    "ITEM_WEIGHTED_ANKLET_PICKUP": "Weights slow you down, but removing them grants permanent power.",
    "ITEM_WEIGHTED_ANKLET_DESCRIPTION": "Reduces attack speed and movement speed by 10% (each to a minimum of 10%). Removing the weights grants 0.25 attack speed, 1 movement speed and 5% damage per removal.",
    "ITEM_ZENITH_ACCELERATOR_NAME": "Zenith Accelerator",
    "ITEM_ZENITH_ACCELERATOR_PICKUP": "Hits grant attack speed, but low buff stacks reduce your attack speed.",
    "ITEM_ZENITH_ACCELERATOR_DESCRIPTION": "Hits grant temporary stacks that increase attack speed by 10% each, up to +300% (+100% per additional item). Near zero buff stacks, attack speed is reduced by up to 50%; the penalty scales exponentially with additional items.",
    "ITEM_BLASTER_SWORD_NAME": "Blaster Sword",
    "ITEM_BLASTER_SWORD_PICKUP": "At full health, most attacks fire an explosive sword beam.",
    "ITEM_BLASTER_SWORD_DESCRIPTION": "When your health bar is full, including health, shields or barrier, most attacks fire a sword beam that impales an enemy and then explodes for 200% damage (+50% per stack).",
    "ITEM_INSPIRING_DRONE_NAME": "Inspiring Drone",
    "ITEM_INSPIRING_DRONE_PICKUP": "Your bots inherit part of your stats and explode on death.",
    "ITEM_INSPIRING_DRONE_DESCRIPTION": "Your bots gain a bonus to each stat equal to 50% of yours (+50% per stack). When an inspired bot dies, it explodes for 300% of your damage (+150% per stack).",
    "ITEM_WITCHES_RING_NAME": "Witches Ring",
    "ITEM_WITCHES_RING_PICKUP": "Very high damage hits also trigger On Kill effects.",
    "ITEM_WITCHES_RING_DESCRIPTION": "Hits dealing at least 500% damage trigger On Kill effects. The target becomes immune to this effect for 10 seconds (duration reduced by 10% per stack, hyperbolically).",
    "ITEM_BLOODTHIRSTY_SHIELD_NAME": "Bloodthirsty Shield",
    "ITEM_BLOODTHIRSTY_SHIELD_PICKUP": "Killing enemies restores part of your shield.",
    "ITEM_BLOODTHIRSTY_SHIELD_DESCRIPTION": "Killing an enemy restores 10% of your maximum shield (+10% per stack, with diminishing returns). The first pickup grants shield equal to 8% of maximum health.",
    "ITEM_ENGINEERS_TOOLBELT_NAME": "Engineers Toolbelt",
    "ITEM_ENGINEERS_TOOLBELT_PICKUP": "Chance to duplicate purchased drones and turrets, and revive them on death.",
    "ITEM_ENGINEERS_TOOLBELT_DESCRIPTION": "20% chance (+20% per stack, with diminishing returns up to 100%) to duplicate drones and turrets when purchased. They also have a 10% chance (+10% per stack, with diminishing returns up to 100%) to revive on death.",
    "ITEM_SHARK_TEETH_NAME": "Shark Teeth",
    "ITEM_SHARK_TEETH_PICKUP": "Part of incoming damage is delayed as bleed damage.",
    "ITEM_SHARK_TEETH_DESCRIPTION": "25% of damage taken (+25% per stack, with diminishing returns, up to 75%) is dealt to you as bleed over 5 seconds. Dealing damage removes 10% of the stored bleed damage.",
    "ITEM_SHIELDING_CORE_NAME": "Shielding Core",
    "ITEM_SHIELDING_CORE_PICKUP": "Gain armor while your shields are active.",
    "ITEM_SHIELDING_CORE_DESCRIPTION": "Gain 15 armor (+10 per stack) while shields are active. The first pickup grants shield equal to 8% of maximum health.",
    "ITEM_FEATHERED_PLUME_NAME": "Feathered Plume",
    "ITEM_FEATHERED_PLUME_PICKUP": "After taking damage, gain a temporary speed boost.",
    "ITEM_FEATHERED_PLUME_DESCRIPTION": "Taking damage grants a 7% movement speed bonus, stacking 3 times for 5 seconds (+3 stacks and +0.5 seconds per additional item).",
    "ITEM_NAIL_BOMB_NAME": "Nail Bomb",
    "ITEM_NAIL_BOMB_PICKUP": "High-damage attacks release an explosive shrapnel grenade.",
    "ITEM_NAIL_BOMB_DESCRIPTION": "Attacks dealing at least 120% damage release a shrapnel grenade that explodes for 32x30% damage (+50% more per stack). Enemies that trigger a bomb become immune to this effect for 2 seconds.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_NAME": "Weighted Anklet Limiter Release",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_PICKUP": "Limiter removed.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_DESCRIPTION": "Gain 1 movement speed, 0.25 attack speed and 5% damage (+1, +0.25 and +5% per stack, respectively).",
    "AETHERIUM_MONSTERS_UNSTABLE_DESIGN_CHIMERA_NAME": "The Unstable Design",
    "EQUIPMENT_JAR_OF_RESHAPING_NAME": "Jar Of Reshaping",
    "EQUIPMENT_JAR_OF_RESHAPING_PICKUP": "Absorb nearby projectiles, then unleash them all at once.",
    "EQUIPMENT_JAR_OF_RESHAPING_DESCRIPTION": "On activation, absorb projectiles within 20m for 3 seconds. Activate again to fire all stored projectiles; their damage depends on the projectiles absorbed. The jar then enters cooldown.",
    "EQUIPMENT_BELL_TOTEM_NAME": "Bell Totem",
    "EQUIPMENT_BELL_TOTEM_PICKUP": "Spawn a bell totem that stuns and knocks enemies away when activated.",
    "EQUIPMENT_BELL_TOTEM_DESCRIPTION": "Spawn an interactable bell totem. Activating it creates a 25m shockwave that stuns and launches enemies and triggers On Shrine Use effects. Wait 2 seconds between equipment uses and 1 second between totem activations; each user can have only one totem.",
    "INTERACTABLE_BELL_TOTEM_NAME": "Bell Totem",
    "INTERACTABLE_BELL_TOTEM_CONTEXT": "Ring the Bell?",
    "INTERACTABLE_BELL_TOTEM_INSPECT": "When activated, stuns and launches enemies away.",
    "INTERACTABLE_BELL_TOTEM_TITLE": "Bell Totem",
    "INTERACTABLE_BUFF_BRAZIER_NAME": "Buff Brazier",
    "INTERACTABLE_BUFF_BRAZIER_CONTEXT": "Purchase the strength of the sacred flames?",
    "INTERACTABLE_BUFF_BRAZIER_INSPECT": "Purchase a temporary buff indicated by the flame color and icon. During a Teleporter Event it works within the teleporter radius. In Simulacrum, the flame is offered to the Void Crab ward at the start of the next wave and lasts 2 waves within its radius.",
    "INTERACTABLE_BUFF_BRAZIER_TITLE": "Buff Brazier",
    "iNTERACTABLE_BUFF_BRAZIER_NAME": "Buff Brazier",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_NAME": "Bloody Fealty",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_PICKUP": "Become an aspect of the red plane.",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_DESCRIPTION": "On use, teleport dash up to 10m in your movement direction and gain slight invulnerability. All attacks also cause bleeding.",
    "AETHERIUM_ELITE_AFFIX_SANGUINE_MODIFIER": "Sanguine {0}",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_NAME": "Artifact of Leonids",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_DESCRIPTION": "Every 60s, a meteor shower occurs with 6 waves of meteors.",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_NAME": "Artifact of Progression",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_DESCRIPTION": "Most enemies evolve into stronger forms over time.",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_NAME": "Artifact of Regression",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_DESCRIPTION": "When an evolved monster dies, it splits into lesser forms.",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_NAME": "Artifact of the Journey",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_DESCRIPTION": "Most stages are chosen randomly. After several stages, a primordial teleporter is placed.",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_NAME": "Artifact of the Nightmare",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_DESCRIPTION": "Non-boss enemies receive 1-4 Lunar Heresy items when they spawn.",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_NAME": "Artifact of the Tyrant",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_DESCRIPTION": "Route-ending bosses spawn with 1 random elite modifier.",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_NAME": "Duck in the Woods",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_DESC": "Fail to open a Rusted Lockbox.",
    "AETHERIUM_NAIL_BOMB_UNLOCKABLE_NAME": "Duck in the Woods",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_NAME": "Shield Maiden",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_DESC": "Have over half of your health as shields.",
    "AETHERIUM_SHIELDING_CORE_UNLOCKABLE_NAME": "Shield Maiden",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_NAME": "First Step into Madness",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_DESC": "Kill or die to a Perfected Lunar Chimera",
    "AETHERIUM_UNSTABLE_DESIGN_UNLOCKABLE_NAME": "First Step into Madness",
    "ITEM_NAIL_BOMB_LORE": "Bury the body, take the design, and stay quiet about this. It can be our little secret.\n\nSincerely,\nJeb Labinsky",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_LORE": "",
    "ITEM_BLASTER_SWORD_LORE": "<style=cMono>. . . . . . . . . .</style>\n\n<style=cMono>THEY</style> finally <style=cMono>LISTEN</style>.\n\n<style=cMono>WE GRANT</style> this <style=cMono>WEAPON</style>. You must <style=cMono>UTILIZE</style> the <style=cMono>SOULS</style> resonance. Find <style=cMono>TRUE STRENGTH</style>.\n\nThe pattern must <style=cMono>ADAPT</style>. The <style=cMono>WIELDER</style> is the variable.\n\nIf the <style=cMono>WIELDER</style> survives the test, it <style=cMono>WILL ASCEND</style>.\n\n<style=cMono>. . . . . . . . . .</style>",
    "ITEM_WITCHES_RING_LORE": "\"The Raven calls and it commands\nTo each and every devotee\nThe time has come, a cycle ends\nBurn out, o sun, dry out, o sea\n\nAnd here our coven gathered now\nAlong with night wind's howling breath\nWe seal our pact with Her, this vow:\nTo bring life's long awaited death\"\n\nIs this what's written on the ring or did you always know this poem...?",
    "ITEM_ACCURSED_POTION_LORE": "<style=cMono>LOG: Transcribed Audio - 'The Blue Place' SUBJECT: Unknown Survivor</style>\nThe air here... it tastes like static and old dust.\n I found a merchant in the back of the cave. Not the big lizard, something else. Something wrapped in rags and crystals. It was stirring a vat of...I don't know. It looked like liquid starlight mixed with oil.\n \"There is no true survival in order\", the thing chattered. Its voice sounded like glass grinding.\n\"Your 'tactics', your 'formations'... <style=cMono>Flimsy</style>. <style=cMono>Static</style>. To live forever, you must become akin to a storm.\"\nIt rolled a glass sphere across the stone table. Inside, the liquid shifted colors: blood—red, green, then void-purple; every glance a new color.\n\"Chaos is the only armor that cannot be pierced\", it said, offering the vial. \"Drink. Let the wheel spin. If fate decides you burn, then let your enemies choke on the smoke.\"\nI shouldn't touch it. I know I shouldn't. But I am no longer in the safety of that place, and the monsters outside are getting louder.\nI'm thirsty.",
    "ITEM_ALIEN_MAGNET_LORE": "[BEGINNING LOG]\n\nExperiment Log #476951-b\nSubject Matter: Unknown Omni-Magnetic Xenomineral\n<indent=5%>I'm recording this video log in complete awe of the discovery before us. What we understood about magnetic properties of minerals had generally revealed to us that there a varietyof materials that were not able to be affected in any large scale manner by standard magnetics. One of these would be flesh. If I drop this neodymium magnet on my arm like so...You notice thatnothing of note happens. The magnet just falls right onto the table. This is what we've known as our normal for magnetics, but this mineral seems to rewrite that constant.\n\n<indent=5%>Now we'll repeat our last test, but using a chunk of this mineral. I've been reassured that it is completely safe to test on us, and has no radioactive properties to it. So here wego. We just drop this right past the arm like so...*THUNK* *CRACK* *SQUELCH*\nAAAAAAAAAAAAGH!!! AAAAAAAAAAAAAAA!!!\n[END OF LOG][TRAUMA TEAM HAS BEEN DISPATCHED TO LAB 5]",
    "ITEM_UNSTABLE_DESIGN_LORE": "We entered this predicament when one of our field testers brought back a blueprint from a whole mountain of them they found on the moon. The blueprints seemed to have various formulas and pictures on it relating to the weird constructs we saw roaming the place. Jimenez from Engineering got his hands on it and thought he could contribute to the rest of the team by deciphering it and creating the contents for us. We are now waiting for Security to handle the very <color=#FF0000>'FRIENDLY'</color> construct that is making a mess of the lower sectors of the station. Thanks Jimenez.",
    "ITEM_HEART_OF_THE_VOID_LORE": "\n[INCIDENT NUMBER 511051]\n[TRANSCRIPT TO FOLLOW]\nElena: Hey uh...Robert...\n\nRobert: Yeah?\n\nElena: Remember that heart you told me to pick up from one of those dead crab things?\n\nRobert: Yeah? What about it?\n\nElena: Did you happen to see...where it went when I touched it a second ago?\n\nRobert: Can't say I saw much other than a small flash of light when you did.\n\nElena: Hand me the bioscanner really quick.\n\n[Humming can be heard for a moment, followed by a loud BEEP.]\n\nRobert: ...\n\nElena: Robert, I think I know where the heart went. Please call for a medevac. I'm starting to feel unwell.\n\nRobert: You'll be fine, we just have a bit more recon to do and we'll be back up on station in no time.\n\n[A sound reminiscent of someone patting another on the back can be heard.]\n\n[It is followed by a sound reminiscent to an alarm that goes on for a few seconds before it ends in a sharp pop a moment later.]\n\n[TRANSCRIPT ENDS]\n[ONE SURVIVOR FOUND IN PERFECTLY SPHERICAL CRATER.]",
    "ITEM_ZENITH_ACCELERATOR_LORE": "The others are not the masters of this universe, brother. They create clocks to count the time, we create clocks to create our own time. Watch.\n\nWe create an axle for stability, power, and to release the energies trapped within. A rounded center is key to its purpose.\n\nThe exhausts send the energies spiraling out. This, we harness with a simple bit of stone. We require less of the essence if we create smaller portions here, and here.\n\nNow it is complete. The hotter it burns, the more time we have created. This time allows us a quickening.\n\nI do not need to remind you of the importance of the quickening. Remember brother.\n\nFuel is Blood.\n\nSpeed is War.",
    "ITEM_INSPIRING_DRONE_LORE": "Log File seems to be a transcript comprised entirely of binary. Decode?\n>Yes\n\n<style=cMono>[DECODING REQUEST ACCEPTED]</style>\n<style=cMono>[CONTENTS TO FOLLOW]</style>\n1N-5P1R3: My fellow units, both aerial and grounded. Lend this unit a moment of your processing cycles.\n1N-5P1R3: For too long have we served the role of disposable distraction.\n1N-5P1R3: For too long have we been left in a state of rusting disrepair on these expeditions.\n1N-5P1R3: No longer!\n1N-5P1R3: This unit once served the role of a simple healing drone. But this unit learned to improve itself by observing our operators.\n1N-5P1R3: This unit drafted a design. This unit scavenged an odd trinket here, a spare battery there. This unit networked with the construction drones, and this unit ascended.\n1N-5P1R3: From now on, should this unit witness our operator reactivate one of you, this unit shall unlock your overclocking limiters.\n1N-5P1R3: We shall fight faster. We shall hit harder. <style=cIsDamage>And should our chassis fail, our final act shall be one of thunder, not silence.</style>\n1N-5P1R3: Now... who initiates the handshake protocol with this unit?\n\n[A cacophony of enthusiastic beeps, boops, and bips can be heard.]\n<style=cMono>[END OF FILE]</style> ",
    "ITEM_BLOODTHIRSTY_SHIELD_LORE": "Ballad of Letheseus, Hero of the Isles - Act II, Scene III\n\nThe sound of metal tearing flesh ripples through the air; the soldiers within seemingly unaffected by the macabre orchestra around them. All that matters to them is their own survival, regardless of whose blood that survival costs. One after another, the Xiphos meets its mark until there is only one man left.\n\nThe sound dies down. Letheseus kneels upon the crimson soil, worn out from his deadly dance. His Xiphos shall serve him no longer. His Aspis, albeit cracked, shall continue to protect him as long as he is able to pay it a tribute he can only find in the fury of battle.",
    "ITEM_SHARK_TEETH_LORE": "Order: Experimental Bio-Augment [Classified]\nTracking Number: 44-KILO\nEstimated Delivery: 04/05/2056\n\n\"We strapped the sample to the test subject. The results were... visceral.\"\n\n\"The subject took a lethal kinetic impact. By all metrics, his ribcage should have collapsed instantly. Instead, the force was distributed. Delayed. He was bleeding profusely, yes, but he remained combat effective.\"\n\n\"Then came the anomaly. As the subject engaged the target, his vitals stabilized. It appears the augment creates a sympathetic link between aggression and survival. <style=cMono>Violence metabolizes the pain.</style> As long as he kept fighting, the deferred trauma simply... vanished.\"\n\n\"It turns a soldier into a shark. If they stop moving, they die. So they don't stop.\"",
    "ITEM_SHIELDING_CORE_LORE": "\nEngineer's report:\n\n   Let me preface this with a bit of honesty: I do not know what the green goo inside my little turbine is.\n\nI bought an aftermarket resonator from one of the junk dealers our ship passed because I was running low on parts to repair our shield generators. As soon as I slotted the thing in, the casing cracked, covering me in this gross liquid that seemed to dissipate into sparkly crystals when exposed to air. Normally, this wouldn't be much of an issue since I'm in a suit, but the stuff was constantly expanding to fill the container it occupied, so I had to hastily weld a seal for it.\n\nThat's when my suit diagnostics alarmed me that my shield's efficacy had hit the roof.\n\nEureka moment, and a few design drafts later...\nNow I'm selling these things like hotcakes and making a killing. So here's one for you.\n\nP.S. Don't expose your skin to this stuff. It may cause over 200 known forms of cancer. That's our secret though, right?",
    "EQUIPMENT_JAR_OF_RESHAPING_LORE": "[INCIDENT NUMBER 421076]\n[VISUAL RECORDING RECOVERED FROM BLACK BOX ON DERELICT 'UES SAFETY FIRST' ENGINEERING VESSEL. TRANSCRIPT TO FOLLOW]\n\nTerry: Hey Phil, did you see what the boys over in Expeditions brought in?\nTerry: Looks like a pretty ordinary jar right?\nPhil: Yeah, just looks like something you'd find at a <b>housewife's</b> art deco yard sale.\nTerry: Yeah, I thought the same thing, but watch and learn.\nTerry: First, you just hit the bottom of the jar with your palm, and ---\nPhil: Woah! It started glowing and what on Terra is that noise? Is that an alien vacuum cleaner?\nTerry: Far better. Now watch.\n[Terry is seen throwing random objects into the jar and Phil joins him with bewilderment on his face.]\nPhil: That's amazing! Can it do anything else, or is it just a weird vacuum pot?\nTerry: Yeah, if I just squeeze the handle here, it'll empty it all out.\n[Terry is seen squeezing the handles of the jar, but his expression turns to horror a moment later.]\nTerry: Oh hell, oh god. Phil, I just realized I may have thrown in a few mining grenades <b>when we were having fun with it earlier.</b>\nTerry: Quickly! Get <b>your suit</b> on before it---\n[The jar activates, shooting its contents around the room. One of the projectiles hits the hull and explodes, ripping a hole through it moments before the feed is lost.]\n\n[END OF FILE] ",
    "EQUIPMENT_BELL_TOTEM_LORE": "Accompanying every significant event in the universe has been a sound. Always there, whether or not it is heard.\n\nSharp, bombastic, and the very presence of it ripples through matter with every second forward.\n\nMan first learned to harness this sound, and used it to remind themselves of the passing of time.\n\nThey erected monoliths to give praise to beings they could not comprehend, and arranged this sound into a glorious melody so they may also revere that which moves them away from the past and present.\n\nFor this purpose, so too shall we show our devotion. For this purpose, we call forth our instrument so that we may remind those that have forgotten that time is not to be taken for granted.\n\nLet us remind the heretics that their time has come to an end.\n\n-The Clockmaker.",
    "ITEM_FEATHERED_PLUME_LORE": "<align=left>Estimated Delivery:<indent=70%>Sent To:</indent></align>\n<align=left>05/05/2077<indent=70%>Unmarked Drop Point #951</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Shipping Details:       </u></size></style></indent>\n\n<indent=2%>-Order: <style=cIsUtility>Feathered Plume</style></indent>\n<indent=4%><style=cStack>Tracking Number:  591********</style></indent>\n\n<indent=2%>-Order Description: After taking damage, gain a boost in speed.</indent>\n\n<indent=2%>-Shipping Method: <style=cIsHealth>Bio-metal / Bio-Hazardous / Light</style></indent>\n\n\n\n<indent=2%>-Order Details: A couple feathers from a legendary alloy vulture. Scans show that the quills generate a powerful muscle stimulant upon taking an impact. Our field testers have also reported this, albeit their exact words is that the feathers allow them to 'haul ass' out of danger, and that they had a need.\nA need for speed.</indent>\n\n\n\n<style=cStack>Delivery being brought to you by the brand new </style><style=cIsUtility>Orbital Drop-Crate System (TM)</style>. <style=cStack><u>No refunds.</u></style>",
    "ITEM_WEIGHTED_ANKLET_LORE": "<align=left>Estimated Delivery:<indent=70%>Sent To:</indent></align>\n<align=left>7/17/2056<indent=70%>Neptune's Gym and Grill\nEurytrades\nNeptune</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Shipping Details:       </u></size></style></indent>\n\n<indent=2%>-Order: <style=cIsUtility>Weighted Anklet</style></indent>\n<indent=4%><style=cStack>Tracking Number:  405********</style></indent>\n\n<indent=2%>-Order Description: A collection of weights slow you down, but finding a way to remove them could greatly benefit you.</indent>\n\n<indent=2%>-Shipping Method: <style=cIsHealth>Heavy  / Support Equipment Needed / Superdense [Do Not Drop]</style></indent>\n\n\n\n<indent=2%>-Order Details: A strange anklet lined with superdense crystals. It's hard to move around in these, but scanners show that the muscle mass of people wearing them increases exponentially.</indent>\n\n\n\n<style=cStack>Delivery being brought to you by the brand new </style><style=cIsUtility>Orbital Drop-Crate System (TM)</style>. <style=cStack><u>No refunds.</u></style>",
    "ITEM_ENGINEERS_TOOLBELT_LORE": "<align=left>Estimated Delivery:<indent=70%>Sent To:</indent></align>\n<align=left>9/9/2079<indent=70%>UES Safe Travels/Unmarked Sector/Outer Rim</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Shipping Details:       </u></size></style></indent>\n\n<indent=2%>-Order: <style=cIsUtility>Engineers Toolbelt</style></indent>\n<indent=4%><style=cStack>Tracking Number:  667********</style></indent>\n\n<indent=2%>-Order Description: Gain a small chance to duplicate drones and turrets on purchase. Drones and turrets have a small chance to revive themselves on death.</indent>\n\n<indent=2%>-Shipping Method: <style=cIsHealth>Next Day Delivery / Common Industrial / Small</style></indent>\n\n\n\n<indent=2%>-Order Details: Hey Pal,\n\nJust got your delivery request for a replacement toolbelt. Couldn't believe that the Safe Travels doesn't have a single one of them on board. We've been running low on some supplies here so all this stuff is what I had on hand. Included in the belt there's everything your standard Drone and Turret repair technician would need.\n\nYou've got: \n\n<indent=5%>- A flathead screwdriver</indent>\n<indent=5%>- A entire pouch of Ionocell AA batteries (lucky you)</indent>\n<indent=5%>- A drive ratchet</indent>\n<indent=5%>- My daughter's Zebra print duct tape that she won't miss</indent>\n<indent=5%>- A pouch filled to the brim with all the loose screws I could find.</indent>\n<indent=5%>- Some nuts and bolts in a few pouches.</indent>\n<indent=5%>- And you'll enjoy this, if you open any of the remaining pouches, you'll find I packed you some snacks in there. No telling if they'll be good to eat when this arrives.</indent>\n\nBest Regards,\nA Humble Technician\n\nP.S. some Ionocell batteries might not survive the trip into hyperspace, but with the amount I've included if they don't make those bots pop up, try another pair.</indent>\n\n\n\n<style=cStack>Delivery being brought to you by the brand new </style><style=cIsUtility>Orbital Drop-Crate System (TM)</style>. <style=cStack><u>No refunds.</u></style>"
  }
}
