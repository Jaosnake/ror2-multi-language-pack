    "ROB_HUNK_BODY_SHOOT_SLUGGER_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_DESCRIPTION": "Dispare causando <style=cIsDamage>3000% de dano</style>. <style=cIsUtility>50% de bônus por tiro na cabeça.</style>",
