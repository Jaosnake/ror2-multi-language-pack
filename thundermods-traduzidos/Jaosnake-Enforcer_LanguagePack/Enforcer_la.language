        "ENFORCER_PRIMARY_SHOTGUN_NAME_UPGRADE_DESCRIPTION": "<style=cIsUtility>+5%</style> damnum, <style=cIsUtility>+10%</style> crassitudo glandium, et <style=cIsUtility>+0.1</style> dispersio glandium",
