        "ROB_BELMONT_KEY_NAME": "Skelet-sxlosilo",
        "ROB_BELMONT_KEY_DESC": "Uzata por malfermi <color=#FFFF00>Trezorkeston</color>. Cxi tiuj kestoj enhavas <color=#FF0033>sanktan relikvon</color> kaj cxiu aperas je <style=cIsUtility>kvara</style> sur scenejo en <style=cIsDamage>fiksa loko</style>.",
        "ROB_BELMONT_KEY_PICKUP": "Uzata por malfermi Trezorkeston. Brilas kiam proksime de kesto.",
        "ROB_BELMONT_KEY_LORE": "",
        "ROB_BELMONT_MORNINGSTAR_NAME": "Morning Star",
        "ROB_BELMONT_MORNINGSTAR_DESC": "Cxiu vipfrapo ellasas <style=cIsUtility>sekvan eksplodon</style> por <style=cIsDamage>250% da domagxo</style>. Plie donas <style=cIsUtility>Whip Slam</style>.",
        "ROB_BELMONT_MORNINGSTAR_PICKUP": "La vipo, kiu detruos cxiujn parencajn al la noktospeco.",
        "ROB_BELMONT_MORNINGSTAR_LORE": "",
        "ROB_BELMONT_CRISSAEGRIM_NAME": "Crissaegrim",
        "ROB_BELMONT_CRISSAEGRIM_DESC": "Cxiu glavosvingo frakasas <style=cIsUtility>3 kromajn fojojn</style> por <style=cIsDamage>3x50% da domagxo</style>. Krome <style=cIsDamage>sangigas</style> malamikojn je trafo.",
        "ROB_BELMONT_CRISSAEGRIM_PICKUP": "Sennombraj klingoj trancxas la malamikon.",
        "ROB_BELMONT_CRISSAEGRIM_LORE": "",
        "ROB_BELMONT_WINGEDBOOTS_NAME": "Pegasus Boots",
        "ROB_BELMONT_WINGEDBOOTS_DESC": "Post <style=cIsUtility>1</style> sekundo de sprintado dum <style=cIsUtility>surgrunde</style>, gajnu <style=cIsDamage>12 movigxrapidon</style>. Trafi malamikon per <style=cIsDamage>Rush</style> igas vin bati ilin <style=cIsUtility>en la aeron</style> kaj poste for, por <style=cIsDamage>4x200%</style> kaj <style=cIsDamage>300%</style> da domagxo.",
        "ROB_BELMONT_WINGEDBOOTS_PICKUP": "Botoj kiuj plibonigas vian duarangan kapablon kaj ebligas al vi kuri kiel la vento.",
        "ROB_BELMONT_WINGEDBOOTS_LORE": "",
        "ROB_BELMONT_HOLYCROSS_NAME": "Savior's Scarf",
        "ROB_BELMONT_HOLYCROSS_DESC": "Cxiujn <style=cIsUtility>3</style> minutojn, anstatauxigu vian <style=cIsDamage>specialan lertecon</style> per <color=#FF0033>Sacred Flame</color>.",
        "ROB_BELMONT_HOLYCROSS_PICKUP": "Gajnu aliron al potenca finfina atako.",
        "ROB_BELMONT_HOLYCROSS_LORE": "",
        "ROB_BELMONT_BROTHERSOUL_NAME": "Soul of the King",
        "ROB_BELMONT_BROTHERSOUL_DESC": "Cxiu <style=cIsUtility>vipkrakigo</style> kreas <style=cIsDamage>lunan flamokolonon</style>, cxiu <style=cIsUtility>glavosvingo</style> kreas <style=cIsDamage>lunan brecxon</style>, cxiu <style=cIsUtility>vipfrapigo</style> eligas <style=cIsDamage>terajn sxokondojn</style> kaj cxiu <style=cIsUtility>rapido</style> produktas <style=cIsHealing>20% da barilo</style>.",
        "ROB_BELMONT_BROTHERSOUL_PICKUP": "Uzu la potencon de la King of Nothing kiel vian propran.",
        "ROB_BELMONT_BROTHERSOUL_LORE": "",
        "ROB_GARGOYLE_NAME": "Gargoyle",
        "ROB_GREAT_GARGOYLE_NAME": "Blue Fangs",
        "KEYWORD_WHIP_SLAM": "<style=cKeywordName>Whip Slam</style><style=cSub>Duoble frapetu dum fiksita sur <style=cIsUtility>aera</style> malamiko por <style=cIsDamage>frapigi</style> ilin malsupren por <style=cIsDamage>1800% da domagxo</style>.</style>"
