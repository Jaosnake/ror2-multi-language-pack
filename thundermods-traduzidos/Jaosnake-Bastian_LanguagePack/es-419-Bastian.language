{
  "es-419": {
    "BASTIAN_NAME": "Translator",
    "BASTIAN_SUBTITLE": "Modelo 4.I.N.K.",
    "BASTIAN_DESCRIPTION": "Un traductor rebelde. Este modelo nuevo y mejorado busca superar a sus predecesores por cualquier medio necesario.<style=cSub>\r\n\r\n< ! > Usa Golpe iónico para acumular daño para Explosión del Arquitecto.\n</style><style=cSub>\r\n\r\n< ! > Micro-Bala te permite seguir en combate al aturdir las amenazas inminentes.\n</style><style=cSub>\r\n\r\n< ! > Nano-Resorte te permite escapar de una multitud, aturdiendo a los enemigos para darte unos segundos de respiro.\n</style><style=cSub>\r\n\r\n< ! > ¡SOLO PARA EMERGENCIAS! Todos los modelos Bastian están equipados con una carga iónica de autouso / detonación interna para emergencias llamada «Explosión del Arquitecto», que detonará el modelo y todo lo que lo rodea. Es posible sobrevivir, pero solo si actúas INMEDIATAMENTE después de usarla.</style>",
    "BASTIAN_NAME_EPIC": "Bastian",
    "BASTIAN_ROO_DESCRIPTION": "Bastian el Traductor, Modelo 4.I.N.K.",
    "BASTIAN_OUTRO": "..y así se marchó, mientras menguaba su fe en aquellos por quienes hablaba y florecía su sentido de identidad.",
    "BASTIAN_FAIL": "..y así desapareció, una sola chispa en la corriente del cambio.",
    "BASTIAN_M1": "Golpe iónico",
    "BASTIAN_M1_DESCRIPTION": "Da un puñetazo que inflige <style=cIsDamage>250% de daño</style> y acumula <style=cIsUtility>cargas iónicas</style>. El daño se reduce a la mitad mientras estés <color=#E9AFEA>Evasivo</color>.",
    "BASTIAN_M2": "Micro-Bala",
    "BASTIAN_M2_DESCRIPTION": "Dispara hasta 5 proyectiles de energía que aturden e infligen <style=cIsDamage>250% de daño</style> cada uno. Mientras estés <color=#E9AFEA>Evasivo</color>, no tiene recarga ni aturde.",
    "BASTIAN_UTIL": "Nano-Resorte",
    "BASTIAN_UTIL_DESCRIPTION": "Avanza rápidamente en cualquier dirección y aturde a los enemigos en tu camino.",
    "BASTIAN_SPEC": "Explosión del Arquitecto",
    "BASTIAN_SPEC_DESCRIPTION": "Gasta <style=cIsHealth>33% de vida actual</style> y <style=cIsUtility>todas las Cargas Iónicas</style> para una explosión masiva de <style=cIsDamage>500%-3000% de daño</style>. Tras usarlo, te vuelves <color=#E9AFEA>Evasivo</color> por 10 segundos.",
    "BASTIAN_SPEC_KEYWORD": "<style=cKeywordName>Evasivo</style><style=cSub>Obtienes un 35% de velocidad de movimiento y un 20% de regeneración, y mejoras tus habilidades.</style>",
    "BASTIANBODY_DEFAULT_SKIN_NAME": "Predeterminado",
    "BASTIANBODY_MASTERY_SKIN_NAME": "Creador",
    "ACHIEVEMENT_BASTIANMASTERYACHIEVEMENT_NAME": "Translator: Mastery",
    "ACHIEVEMENT_BASTIANMASTERYACHIEVEMENT_DESCRIPTION": "Como Translator, completa el juego u oblitérate en Monsoon.",
    "BASTIAN_LORE": "Un robot local, construido para ayudar a negociar acuerdos con cuerpos planetarios extranjeros. Su propósito original era funcionar como intermediario, diseñado para sobrevivir en planetas con aire y temperaturas que un humano normal no podría soportar. Fue traído a bordo de la UES Contact Light como parte de un plan de contingencia. Sin embargo, terminó siendo reprogramado para el combate, a pesar de ser una simple misión de recoger y llevar. El plan preveía negociar la supervivencia del resto de la tripulación si fuera necesario."
  }
}
