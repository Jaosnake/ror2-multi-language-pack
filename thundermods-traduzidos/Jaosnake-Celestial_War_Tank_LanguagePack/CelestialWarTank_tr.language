    "CHEESEWITHHOLES_BASICTANK_TURRET_T62_DESCRIPTION": " <color=#80fc80>-%20 İkincil bekleme süresi</color>\n <color=#fc8080>-%12 Saldırı hızı</color>\n <color=#fc8080>+%8 Birincil bekleme süresi</color>\n <color=#fc8080>+%8 Yardımcı bekleme süresi</color>\n <color=#fc8080>+%8 Özel bekleme süresi</color>\n\n<color=#00FF00>Can: </color>80\n<color=#FF0000>Zırh: </color>11\n\nDönme Hızı: 38\n\nAğırlık: 91\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_NAME": "Somua S35",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_DESCRIPTION": " <color=#80fc80>+15 Kritik şansı</color>\n <color=#fc8080>-%5 Hasar</color>\n\n<color=#00FF00>Can: </color>30\n<color=#FF0000>Zırh: </color>8\n\nDönme Hızı: 45\n\nAğırlık: 33\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_NAME": "Churchill",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_DESCRIPTION": "Her <style=cIsUtility>5</style> saniyede bir <color=#fcdf03>+3 altın</color> <color=#7a7a7a>(seviye başına +2)</color>\n\n<color=#00FF00>Can: </color>85\n<color=#FF0000>Zırh: </color>12\n\nDönme Hızı: 34\n\nAğırlık: 97\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_NAME": "Maus",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_DESCRIPTION": "\n<color=#00FF00>Can: </color>150\n<color=#FF0000>Zırh: </color>30\n\nDönme Hızı: 30\n\nAğırlık: 180\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_NAME": "Tetrarch",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>Can: </color>20\n<color=#FF0000>Zırh: </color>7\n\nDönme Hızı: 50\n\nAğırlık: 27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+%10 Saldırı hızı</color>\n <color=#fc8080>-%15 Can yenilenmesi</color>\n <color=#fc8080>+%5 Toplam bekleme süresi</color>\n\n<color=#00FF00>Can: </color>20\n<color=#FF0000>Zırh: </color>2\n\nDönme Hızı: 40\n\nAğırlık: 20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Can: </color>10\n<color=#FF0000>Zırh: </color>0\n\nDönme Hızı: 55\n\nAğırlık: 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Can: </color>100\n<color=#FF0000>Zırh: </color>20\n\nDönme Hızı: 33\n\nAğırlık: 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-%20 Özel bekleme süresi</color>\n <color=#fc8080>+%15 İkincil bekleme süresi</color>\n <color=#fc8080>-%10 Saldırı hızı</color>\n\n<color=#00FF00>Can: </color>120\n<color=#FF0000>Zırh: </color>23\n\nDönme Hızı: 29\n\nAğırlık: 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+%20 Hasar</color>\n <color=#fc8080>+%10 Toplam bekleme süresi</color>\n\n<color=#00FF00>Can: </color>160\n<color=#FF0000>Zırh: </color>0\n\nDönme Hızı: 25\nAçı Sınırı: 90\n\nAğırlık: 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Can: </color>45\n<color=#FF0000>Zırh: </color>4\n\nDönme Hızı: 25\n\nAğırlık: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Can: </color>35\n<color=#FF0000>Zırh: </color>15\n\nDönme Hızı: 35\n\nAğırlık: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-%25 Birincil bekleme süresi</color>\n <color=#fc8080>+%8 İkincil bekleme süresi</color>\n <color=#fc8080>+%8 Yardımcı bekleme süresi</color>\n <color=#fc8080>+%8 Özel bekleme süresi</color>\n <color=#fc8080>-%15 Saldırı hızı</color>\n\n<color=#00FF00>Can: </color>35\n<color=#FF0000>Zırh: </color>3\n\nDönme Hızı: 30\n\nAğırlık: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+%25 Hasar</color>\n\n<color=#00FF00>Can: </color>5\n<color=#FF0000>Zırh: </color>1\n\nDönme Hızı: 40\nAçı Sınırı: 30\n\nAğırlık: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ORİJİNAL",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "KIRMIZI",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "AÇIK KIRMIZI",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "YEŞİL",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "KOYU YEŞİL",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "MAVİ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "CAMGÖBEĞİ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "PEMBE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "CANLI PEMBE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "MACENTA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "SARI",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "NEON SARI",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "NEON MOR",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "TURUNCU",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "BEYAZ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "SİYAH",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Aracın 'parlayan' kısmını farklı bir renge değiştirir.  Oynanışı etkilemez.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Kirli",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Temiz",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Keskin_Kamuflaj",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Piksel_Kamuflaj",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Kağıt_Kamuflaj",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Baklavalı_Sac",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Cıvatalı_Plaka",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Prosedürel_Set",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Renkli_Karışım",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Gökkuşağı_Gradyanı",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Monokrom",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Akışkan_Galaksi",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Uzay",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Motor Sistemleri",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Yardımcı yetenekler ve itiş yakıt tüketir. Yakıt yenilenmesi <style=cIsUtility>saldırı hızından</style> etkilenir; yakıt kapasitesi <style=cIsUtility>ardyakıcılardan</style> ve <style=cIsUtility>zıplama eşyalarından</style> etkilenir. Tank <style=cIsUtility>her yöne depar atabilir</style>. İtiş, havada çok yönlü kontrol sağlar. Ancak <color=#fc8080>tank normal şekilde zıplayamaz</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Süper Cephanelik",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "Gövde ve taret seçimleri can, zırh, hız, itiş ve kütleyi etkiler. <style=cIsUtility>Daha ağır kütle daha ağır düşmanları itmeye yardımcı olur</style>; aksi takdirde <color=#ffff80>geri tepmeye</color> daha açık olursun.\n\nZırh veya hız, tankın <color=#fc8080>berbat can yenilenmesini</color> telafi etmeye yardımcı olabilir.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Göksel Kararsızlık",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "Tank havada kendini dengeleyemez, <color=#ffff80>kontrolü kaybetmeye yatkındır</color>. Tepenin üstüne inmek seni <color=#fc8080>kısa bir süreliğine hareketsiz ve savunmasız</color> bırakır.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Uçuş İticileri",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Uçuşa başlamak için <style=cIsUtility>Zıplama</style> tuşunu basılı tut. Uçuş yönü tankının açısına bağlıdır. <style=cIsUtility>En çok yönlü uçuş</style>, ancak kullanımı zor olabilir.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Darbe İticileri",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Tankın diğer kazazedeler gibi normal şekilde <style=cIsUtility>zıplamasını</style> sağlar. Tank eğimi 2. zıplamada etkinleştirilebilir. Her zıplama <color=#ffc080>25</color> yakıt tüketir.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Süzülme İticileri",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Tankın yerden yüksekte süzülmesini sağlar. Yükselmek için <style=cIsUtility>Zıplama</style> tuşunu, alçalmak için <style=cIsUtility>Sol Alt</style> tuşunu basılı tut. Yükselmek daha fazla yakıt tüketir.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Makineli Tüfekler",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "<style=cIsDamage>2x%40 hasar</style> için sürekli ateş et.\n<style=cSub>[Ağırlık: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Pompalı Tüfek",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "<style=cIsDamage>12x%75 hasar</style> için ateş et.  <style=cIsUtility>Ekstra yük kazanmak</style> için <color=#ffc080>yakıt yak</color>; geçici olarak <style=cIsDamage>18x%150 hasarlık</style> güçlü bir atış kazanmak için <color=#80fc80>akrobasi hareketi yap</color>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 1sn</style> | Ağırlık: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Bomba Atar",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "<style=cIsDamage>4x%250 hasar</style> için isabetsiz mermiler ateşle.  Mermiler patlayıcı ve ağırdır.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 4sn</style> | <style=cIsDamage>Patlama Yarıçapı: 5m</style> | Ağırlık: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Füze Atar",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "<style=cIsDamage>%1000 hasar</style> için isabetli füzeler ateşle. <style=cIsDamage>Mesafe katettikçe hasar artar</style>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 3sn</style> | <style=cIsDamage>Patlama Yarıçapı: 8m</style> | Ağırlık: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Alev Silahı",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "<color=#ffc080>Saniyede 15 yakıt</color> karşılığında <color=#E85E31>%25 yanma hasarı</color> veren ateş püskürt.  Hasar birikimle artar; <style=cIsUtility>Saldırı hızı menzili artırır</style>.\n<style=cSub>[<color=#ffc080>Yakıtla Çalışır</color> | Ağırlık: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ultra Anten",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Kendini elektrikle çarp</color> ve <style=cIsUtility>öldürmeye bağlı eşyaları etkinleştir</style>.  <style=cIsUtility>Düşmanlara dokunmak onları da elektrikle çarpar</style> ve <style=cIsUtility>öldürmeye bağlı</style> eşya başına <style=cIsDamage>%250 hasar</style> alırlar.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 7sn</style> | <style=cIsDamage>Patlama Yarıçapı: 5m</style> | Ağırlık: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Kritik Top",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "<color=#ff4d76>%1200 kritik hasar</color> için ateş et. Kritik şansı topun hasarını artırır.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 7sn</style> | <style=cIsDamage>Patlama Yarıçapı: 10m</style> | Ağırlık: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Obüs Topu",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Alan etkili <style=cIsDamage>%7000 hasar</style> için şarj edip ateşle. <style=cIsUtility>Havadeyken tankı fırlatabilir.</style>\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 16sn</style> | <style=cIsDamage>Patlama Yarıçapı: 15m</style> | Ağırlık: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Tokmak Topu",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "<style=cIsDamage>%1700 hasar</style> için isabetsiz ateş et. <style=cIsDamage>Mesafe katettikçe hasar azalır</style>; <style=cIsDamage>Tetikleme eşyaları bunun yerine hasarı artırır</style>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 3sn</style> | <style=cIsDamage>Patlama Yarıçapı: 5m</style> | Ağırlık: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Delici Top",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "<style=cIsDamage>%2500 hasar</style> için ateş et.  Kalibre edip <style=cIsUtility>zayıf noktaları vurabilen</style> <style=cIsDamage>%3500 hasar</style> vermek için basılı tut.  Kalibre edildiğinde, <color=#fc8080>hareket etmek isabeti düşürür</color>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 5sn</style> | <style=cIsDamage>Patlama Yarıçapı: 2m</style> | Ağırlık: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Fransız Silahı",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Sefil bir <style=cIsDamage>%550 hasar</style> için ateş et. Nedense <style=cIsUtility>aşırı fazla tetikleme katsayısına sahiptir</style>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 1sn</style> | Ağırlık: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Minigun",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "<style=cIsDamage>%50 hasar</style> için mermi yağdır. %75 aşırı ısınmada <color=#E85E31>ateş</color> uygular; <color=#fc8080>aşırı ısınma silahı kilitler</color>. <style=cIsUtility>Bekleme süresi eşyaları soğuma hızını artırır</style>; <style=cIsUtility>Yedek şarjörler aşırı ısınmayı önler</style>.\n<style=cSub>[Ağırlık: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Temel Top",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "<style=cIsDamage>%5400 hasar</style> için hızlı bir mermi ateşle.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 12sn</style> | <style=cIsDamage>Patlama Yarıçapı: 7m</style> | Ağırlık: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Uçaksavar Topu",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "<style=cIsDamage>%300 hasar</style> için ateş et.  Mermi hava hedeflerinin yakınında patlayarak <style=cIsDamage>2.5x hasar</style> verir.  <color=#fc8080>Tank ateş etmek için yavaşlar</color>.\n<style=cSub>[<style=cIsDamage>Patlama Yarıçapı: 5.5m</style> | Ağırlık: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Sıçrama Topu",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "<style=cIsUtility>Büyük bir kavisle</style> <style=cIsDamage>%2200 hasar</style> için ateş et ve etrafa <style=cIsDamage>10x%5 toplam hasar</style> sıçrat.  Mesafe katettikçe hasar <style=cIsDamage>%5500 hasara</style> kadar artar.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 10sn</style> | <style=cIsDamage>Patlama Yarıçapı: 16m</style> | Ağırlık: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Göksel Top",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "<color=#E85E31>%1800</color>/<color=#E85E31>%4500</color>/<color=#E85E31>%9000</color> <color=#E85E31>hasar</color> için <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> yakıt tüket.  Şarjlı lazerler deler; <color=#fc8080>Yetersiz yakıt silahı devre dışı bırakır.</color>\n<style=cSub>[<color=#ffc080>Yakıtla Çalışır</color> | Ağırlık: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Yok Edici Top",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "<style=cIsDamage>%12000 hasar</style> veren <color=#E85E31>öldürme etkisi tetikleyen bir mermiyi</color> otomatik ateşlemek için şarj et.  Sonrasında <color=#fc8080>yetenekler 4 saniyeliğine devre dışı kalır.  Mermi dostlara zarar verebilir</color>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 21sn</style> | <style=cIsDamage>Patlama Yarıçapı: 5m</style> | Ağırlık: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Otomatik Top",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Her biri <style=cIsDamage>%2000 hasar</style> veren en fazla 4 mermi ateşle. Son mermi sabit bir noktada <style=cIsDamage>2x hasar</style> verir.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 14sn</style> | <style=cIsDamage>Patlama Yarıçapı: 7m</style> | Ağırlık: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Kürek",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<color=#ffc080>50</color> yakıt karşılığında <style=cIsUtility>kısa bir mesafe atıl</style>. <style=cIsUtility>Herhangi bir düşmanı</style> <style=cIsDamage>%1000 hasar</style> ile geri savurabilir ve <color=#ffc080>40</color> yakıt yenileyebilir.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 2sn</style> | Ağırlık: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Dikenler",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<color=#ffc080>50</color> yakıt karşılığında <style=cIsUtility>büyük bir mesafe atıl</style>. Düşmanlara çarparak <color=#AA2B2A>%550 kanama hasarı</color> ver.  <style=cIsUtility>Bekleme süresi yoktur</style>.\n<style=cSub>[Ağırlık: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Turbo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Hızla fırlayarak</style> saniyede <color=#ffc080>30</color> yakıt tüket.  <style=cIsDamage>%250 hasar</style> için çarpabilir. Çarpmak <color=#ffc080>20</color> yakıt ekler.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 1sn</style> | Ağırlık: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Süper Zıplama",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "<color=#ffc080>50</color> yakıt karşılığında yukarı fırlat.  Depar atarken bunun yerine <color=#ffc080>75</color> yakıt karşılığında ileri fırlat ve tankını savurarak <style=cIsDamage>%2500 hasar</style> ver.  Tank ağırlığı hasarı artırır.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Buldozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Takviye</style> yap ve saniyede <color=#ffc080>20</color> yakıt tüket.  <style=cIsUtility>Herhangi bir düşmanı</style> sürekli <style=cIsDamage>%200 hasar</style> için ezebilir.  Çarpışma anında <style=cIsDamage>%350 hasar</style> verir.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 1sn</style> | Ağırlık: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Parçalayıcı Dozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "<color=#ffc080>100</color> yakıt karşılığında <style=cIsUtility>en uzak mesafeye atılmak</style> için şarj et.  <color=#AA2B2A>%4000 kanama hasarı</color> için <style=cIsUtility>kalabalıkları delip geç</style> ve <style=cIsUtility>atılmayı uzat</style>; Atılmayı bitirmek için dön; <style=cIsUtility>şarj süresini atlamak</style> için <color=#80fc80>akrobasi hareketi yap</color>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 7sn</style> | Ağırlık: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Hendek Kazıcı",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "Saniyede <color=#ffc080>20</color> yakıt tüketerek <style=cIsUtility>toprağın altına girmek için basılı tut</style> ve <style=cIsUtility>altındayken tankını koru</style>.  Dışarı fırlayıp yakındaki düşmanlara <style=cIsDamage>%900 hasar</style> vermek için bırak.  Yer altındayken çatışmaya girilemez.\n<style=cSub>[<style=cIsDamage>Patlama Yarıçapı: 10m</style> | Ağırlık: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Kral Mayın",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "<style=cIsDamage>%3000 hasar</style> veren bir kara mayını bırak.  <style=cIsDamage>Tetikleme eşyaları bunun yerine hasarı artırır</style>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 10sn</style> | <style=cIsDamage>Patlama Yarıçapı: 10m</style> | Ağırlık: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Mini Mayınlar",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Nişan al ve her biri <style=cIsDamage>%750 hasar</style> veren tüm minyatür kara mayınlarını harca.  Yük ve etkileşim eşyaları maksimum mayın sayısını artırır.  <style=cIsUtility>Ekstra yük kazanmak</style> için <color=#ffc080>yakıt yak</color>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 3sn</style> | <style=cIsDamage>Patlama Yarıçapı: 10m</style> | Ağırlık: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Varil Fırlatma",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "<color=#ffc080>25</color> yakıt karşılığında çarpışmada alev alarak <style=cIsDamage>%6500 hasar</style> veren ve <color=#E85E31>yanan bir birikinti</color> bırakan bir varil fırlat.  <color=#80fc80>Akrobasi hareketi yapmak</color> bu yeteneği geçici olarak <color=#fc8080>kararsız</color> hale getirir ve <style=cIsUtility>tankının savrulmasına neden olur</style>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 14sn</style> | <style=cIsDamage>Patlama Yarıçapı: 18m</style> | <style=cIsDamage>Alan Yarıçapı: 8</style> | Ağırlık: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Kendini İmha Et",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "35m içindeki <color=#d40000>HER ŞEYİ</color> <style=cIsDamage>%100000 hasar</style> için yok et.  Yeni oyuna <color=#80fc80>Dio's Best Friend</color> ile başla.\n<style=cSub>[<style=cIsDamage>Patlama Yarıçapı: 35m</style> | Ağırlık: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "HÜKÜMDARLIK",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Yavaşla ve bir füze yaylım ateşi açmak için şarj et.  Mesafe katettikçe hasar <style=cIsDamage>12x%3000 hasara</style> kadar artar.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 30sn</style> | <style=cIsDamage>Patlama Yarıçapı: 10m</style> | Ağırlık: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Kaçınma",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Duman yayarak yakındaki düşmanları <style=cIsDamage>%150 hasar</style> ile sersemlet ve gizlen.  1 saniyeliğine hasara karşı <style=cIsUtility>bağışıklık kazan</style>.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 12sn</style> | <style=cIsDamage>Patlama Yarıçapı: 10m</style> | Ağırlık: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Pasif: Vahşi",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Bu yeteneği kaldırır. <style=cIsDamage>Temel saldırı hızını 0.5</style> artırır ve <style=cIsUtility>bekleme süresini %10</style> azaltır.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Pasif: Motorlar",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Bu yeteneği kaldırır. <style=cIsUtility>Temel hızı 1m/sn</style> ve <style=cIsUtility>itme gücünü %10</style> artırır.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Pasif: Zırh",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Bu yeteneği kaldırır. <style=cIsUtility>Temel zırhı 30</style> artırır.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Ustalık",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Celestial War Tank olarak oyunu bitir veya Monsoon zorluğunda kendini yok et.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Ustalık",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Göksel Top",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Celestial War Tank olarak eve dön",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Göksel Top",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Yok Edici",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Celestial War Tank olarak tek atışta 1.000.000'dan fazla hasar ver.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Yok Edici",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Parçalayıcı Dozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Celestial War Tank olarak oyunu bitir veya Monsoon zorluğunda kendini yok et.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Parçalayıcı Dozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Tank Gibi",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Celestial War Tank olarak 10000 Can elde et.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Tank Gibi",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "Yıkımın nihai tankı. Her türlü düşmana diren, devasa ağırlığın ve silahlarınla onları ezip geç!\n\n<style=cSub>< ! > Tank devasadır ve aşırı yavaştır, bu da seni her türlü hasara açık hale getirir. Aşırı savunmacı veya aşırı saldırgan oynamak alacağın hasarı azaltmaya yardımcı olur. Tankın iyileşmesi olmadığını unutma.\n\n< ! > Tankın gövdesi hasar vermek için kullanılabilir; düşmanlarını ez veya ağırlığını kullanarak hepsini dümdüz et!\n\n< ! > Tank kaza yaptığında daha ağırdır, tekrar doğrulması zaman alır ve daha fazla düşme hasarına maruz kalır. Tank akrobasi hareketi yapamaz.\n\n< ! > İyileştirme faktörleri azaltılmıştır; tankın çok fazla canı vardır!\n\n< ! > Korna çalmak için 'T' tuşuna bas.  Mod ayarlarından yapılandırılabilir.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Yabancı Varlık",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Daha fazla araştırmanın ardından bu tankların kökenini bulduk: hurdacıların elleri. UES'ten alınan kaliteli hurda parçalar ve eşyalarla bu savaş tanklarını başarıyla üretmişler.\n\nAncak bu durum tehlikeli sonuçlara yol açıyor. Düşman antenlerinden birini ele geçirdikten sonra bu devasa boyuttaki tankı alarma geçirdik. Böcek muhafızları boyutunda!\n\nElbette uzun süren bir savaşın ardından sonunda onu devirdik. Daha iyi yanıtlar bulmak umuduyla araştırmayı derinleştirmeyi ve zihnini yeniden değiştirmeyi umuyoruz. Bu zor bir görev olacak, çünkü bu bir UZAYLI teknolojisi.\n\nDikkat edilmesi gereken devasa bir nokta ise, yenildiğinde bir acil durum portalı çağırmış olması. Şimdiye kadar gördüğümüz en büyük, en şiddetli portal. Bizi doğrudan yanıtlara götürecek olsa da, bunun çocuk oyuncağı olacağını sanmıyorum. Ortalama bir tank bile fazlasıyla ölümcül ve hurdacıların dışarıda başka ne gibi icatları olduğundan emin değilim.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ORİJİNAL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "BEYAZ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "SİYAH",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "KIRMIZI",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "KOYU KIRMIZI",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "YEŞİL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "MAVİ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "CAMGÖBEĞİ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "SARI",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "NEON SARI",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "MACENTA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "MOR",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "TURUNCU",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "KAHVERENGİ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "AMERİKA BİRLEŞİK DEVLETLERİ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "ALMANYA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "BİRLEŞİK KRALLIK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "RUSYA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "FRANSA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "Gövde rengini değiştirir.  Oynanışı etkilemez.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "ANA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "KİRLİ SARI",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "YEŞİL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "KİRLİ YEŞİL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "MAVİ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "KİRLİ MAVİ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "KIRMIZI",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "KİRLİ KIRMIZI",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "USTALIK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Rogue Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Motor Gücü: </color>3000\n<color=#00FFFF>Hız: </color>10\nDönüş Hızı: 0.8\n\n<color=#00FF00>Can: </color>1000\n<color=#FF0000>Zırh: </color>75\n\n<color=#AA00FF>İtme Gücü: </color>35\n<color=#ffc080>Yakıt Miktarı: </color>500\nAğırlık: 1000\n\nGövde Tipi: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Griffon Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Taret uyumlu</color>.\n\n<color=#FFFF00>Motor Gücü: </color>2300\n<color=#00FFFF>Hız: </color>11\nDönüş Hızı: 1\n\n<color=#00FF00>Can: </color>800\n<color=#FF0000>Zırh: </color>25\n\n<color=#AA00FF>İtme Gücü: </color>40\n<color=#ffc080>Yakıt Miktarı: </color>500\nAğırlık: 800\n\nGövde Tipi: Araba",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "TONK Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Motor Gücü: </color>1200\n<color=#00FFFF>Hız: </color>12\nDönüş Hızı: 2\n\n<color=#00FF00>Can: </color>500\n<color=#FF0000>Zırh: </color>25\n\n<color=#AA00FF>İtme Gücü: </color>40\n<color=#ffc080>Yakıt Miktarı: </color>300\nAğırlık: 450\n\nGövde Tipi: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Type 5 Heavy Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Motor Gücü: </color>3500\n<color=#00FFFF>Hız: </color>8\nDönüş Hızı: 0.6\n\n<color=#00FF00>Can: </color>1400\n<color=#FF0000>Zırh: </color>100\n\n<color=#AA00FF>İtme Gücü: </color>34\n<color=#ffc080>Yakıt Miktarı: </color>750\nAğırlık: 1250\n\nGövde Tipi: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Bigfoot Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Daha fazla <style=cIsUtility>hava kontrolü</style> sağlar.\n\n\n<color=#FFFF00>Motor Gücü: </color>2000\n<color=#00FFFF>Hız: </color>13\nDönüş Hızı: 1.4\n\n<color=#00FF00>Can: </color>600\n<color=#FF0000>Zırh: </color>20\n\n<color=#AA00FF>İtme Gücü: </color>40\n<color=#ffc080>Yakıt Miktarı: </color>450\nAğırlık: 750\n\nGövde Tipi: Araba",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "AMX50B Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>Hız ağırlıktan etkilenmez</style>.\n\n<color=#FFFF00>Motor Gücü: </color>700\n<color=#00FFFF>Hız: </color>9\nDönüş Hızı: 0.7\n\n<color=#00FF00>Can: </color>900\n<color=#FF0000>Zırh: </color>50\n\n<color=#AA00FF>İtme Gücü: </color>35\n<color=#ffc080>Yakıt Miktarı: </color>370\nAğırlık: 1100\n\nGövde Tipi: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "TOG II Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Motor Gücü: </color>3700\n<color=#00FFFF>Hız: </color>8\nDönüş Hızı: 0.5\n\n<color=#00FF00>Can: </color>1150\n<color=#FF0000>Zırh: </color>60\n\n<color=#AA00FF>İtme Gücü: </color>34\n<color=#ffc080>Yakıt Miktarı: </color>1000\nAğırlık: 1200\n\nGövde Tipi: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Pigeon Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Taret uyumlu</color>.\n\n<color=#FFFF00>Motor Gücü: </color>1500\n<color=#00FFFF>Hız: </color>7\nDönüş Hızı: 1.4\n\n<color=#00FF00>Can: </color>150\n<color=#FF0000>Zırh: </color>5\n\n<color=#AA00FF>İtme Gücü: </color>40\n<color=#ffc080>Yakıt Miktarı: </color>300\nAğırlık: 100\n\nGövde Tipi: Araba",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Pontera AC Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Duvarlara tırmanabilir</style>. Zıplama bir saniye gecikir ve <color=#fc8080>çarpma hasarı %50 azalır</color>.\n\n\n<color=#FFFF00>Motor Gücü: </color>2750\n<color=#00FFFF>Hız: </color>9\nDönüş Hızı: 0.8\n\n<color=#00FF00>Can: </color>1300\n<color=#FF0000>Zırh: </color>90\n\n<color=#AA00FF>İtme Gücü: </color>31\n<color=#ffc080>Yakıt Miktarı: </color>550\nAğırlık: 1300\n\nGövde Tipi: Meka",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "TANKDOZER Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "Kürek tüm <style=cIsDamage>gelen hasarı</style> <style=cIsUtility>engeller</style>.\n\nTank Avcısı Modu: <color=#fc8080>Taret monte edilemez</color>.\n\n<color=#FFFF00>Motor Gücü: </color>2500\n<color=#00FFFF>Hız: </color>8.5\nDönüş Hızı: 0.9\n\n<color=#00FF00>Can: </color>1250\n<color=#FF0000>Zırh: </color>80\n\n<color=#AA00FF>İtme Gücü: </color>34\n<color=#ffc080>Yakıt Miktarı: </color>500\nAğırlık: 1200\n\nGövde Tipi: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Truck Kan Gövdesi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "Çarpma hasarı <color=#80fc80>%100.0</color> artar\n\n<color=#80fc80>Taret uyumlu</color>.\n<style=cIsUtility>Hız ağırlıktan etkilenmez</style>.\n\n<color=#FFFF00>Motor Gücü: </color>1000\n<color=#00FFFF>Hız: </color>12\nDönüş Hızı: 0.9\n\n<color=#00FF00>Can: </color>450\n<color=#FF0000>Zırh: </color>15\n\n<color=#AA00FF>İtme Gücü: </color>40\n<color=#ffc080>Yakıt Miktarı: </color>600\nAğırlık: 600\n\nGövde Tipi: Araba",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Can: </color>250\n<color=#FF0000>Zırh: </color>25\n\nDönme Hızı: 7.5\n\nAğırlık: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Taret",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Can: </color>100\n<color=#FF0000>Zırh: </color>10\n\nDönme Hızı: 20\n\nAğırlık: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Can: </color>100\n<color=#FF0000>Zırh: </color>15\n\nDönme Hızı: 15\n\nAğırlık: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Can: </color>400\n<color=#FF0000>Zırh: </color>50\n\nDönme Hızı: 5\n\nAğırlık: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>%200 hasar</style> mı?  Bu taret için hasarı artıran kodu bulamadım.\n- Geliştirici\n\n\n<color=#00FF00>Can: </color>150\n<color=#FF0000>Zırh: </color>25\n\nDönme Hızı: 13\nAçı Sınırı: 60\n\nAğırlık: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "<style=cIsUtility>İkincil</style> yeteneğe <style=cIsDamage>5 yük</style> ekler.\nBekleme süresinden sonra <style=cIsUtility>tüm yükleri yeniler</style>.\nTop hasarı %80 azalır\n\n<color=#00FF00>Can: </color>300\n<color=#FF0000>Zırh: </color>20\n\nDönme Hızı: 7\n\nAğırlık: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Can: </color>200\n<color=#FF0000>Zırh: </color>30\n\nDönme Hızı: 9\n\nAğırlık: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Can: </color>300\n<color=#FF0000>Zırh: </color>35\n\nDönme Hızı: 7\n\nAğırlık: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Ağır Sıklet",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "Tank, <style=cIsDamage>hıza bağlı hasarla</style> <style=cIsUtility>düşmanları ezebilir</style>.  Ağır bir yapılandırmayla düşmek, ağırlığının yakındaki düşmanlara zarar veren bir <style=cIsUtility>şok dalgası</style> oluşturmasına neden olur.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Yok",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Bu yeteneği kaldırır.  Aşağıdaki istatistikleri artırır:\n\nSaldırı Hızı: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Yok",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Yok",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Bu yeteneği kaldırır.  Aşağıdaki istatistikleri artırır:\n\nHız: <color=#80fc80>+1</color> m/sn\nİtici Gücü: <color=#80fc80>+%10</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Yok",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Bu yeteneği kaldırır.  Zırhı <color=#80fc80>30</color> artırır ve yakıt kapasitesini <color=#80fc80>200</color> artırır",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Mini Top",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "<style=cIsDamage>%200 hasar</style> için isabetsiz ateş et.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "EMP",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Kalkanını ateşle ve düşmanları elektrikle çarpan <style=cIsDamage>%2000 hasarlık</style> bir EMP oluştur!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "22 füzeye kadar devasa bir cephane tut! Her biri <style=cIsDamage>%1100 hasardan</style> <style=cIsDamage>%1800 hasara</style> kadar vurur.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Seri Otomatik Top",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Düşmanlara <style=cIsDamage>%500 hasar</style> veren patlayıcı mermiler ateşle. Her 4 saniyede bir yeniden doldurulmalıdır.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Kudretli Top",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Düşmanları savurarak <style=cIsDamage>%7500 hasar</style> için ateş et.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 16sn</style> | <style=cIsDamage>Patlama Yarıçapı: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Topçu Silahı",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Nişan almak için basılı tut</style> ve <style=cIsDamage>%7000 hasarlık</style> güçlü bir mermi ateşlemek için bırak.  Mesafe katettikçe hasar <style=cIsDamage>%14000 hasara</style> kadar artar.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 16sn</style> | <style=cIsDamage>Patlama Yarıçapı: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Kriyo Top",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "<color=#75EAFF>%1500 hasar</color> için dev bir kartopu ateşle ve düşmanları dondur.\n<style=cSub>[<style=cIsUtility>Bekleme Süresi: 5sn</style> | <style=cIsDamage>Patlama Yarıçapı: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "İkili Top",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "<style=cIsDamage>%5400 hasar</style> için ateş et. 2 mermi ateşlemek için basılı tut, bu işlem sonrasında <color=#fc8080>yetenek bekleme süresini artırır</color>. Çifte atış yapmak 2 saniyeliğine bir sonraki şarj süresini <color=#80fc80>büyük ölçüde azaltır</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "İngiliz Topu",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "<style=cIsDamage>%2400 hasar</style> için ateş et.  <color=#fc8080>Eşyaları tetikleyemez</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Koca Kötü Top",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "<style=cIsDamage>%2000 hasar</style> için ateş et.  <style=cIsDamage>%11000 hasara</style> kadar vurmak için <style=cIsUtility>basılı tutarak şarj et</style>.  Maksimum şarj, <style=cIsUtility>ek geri tepmeyle</style> birlikte ek <style=cIsDamage>%5500 lazer hasarı</style> için topu otomatik ateşler.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Oppenheimer'ın Deneyi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Merminin kalkanını yok etmesine izin ver ve <color=#ff4d76>%9000 kritik hasar</color> ile her şeyi yok et!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Jetler",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Ateşle ve saniyede <color=#ffc080>70 yakıt</color> tüketerek tankın zamanla daha fazla hız kazanmasını sağla.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Güç Döngüsü",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "3 mod arasında geçiş yapmak için etkinleştir: Kaçınma, Saldırı veya Savunma: \n\n<style=cIsUtility>Kaçınma</style>: Ekstra %50 hız, %10 itme gücü ve %50 motor gücü için saldırı hızını %50 azaltır ve bekleme süresini %50 artırır!\n\n<color=#80fc80>Savunma</color>: 500 zırh için %70 hız ve %100 itme gücünden feragat et.\n\n<style=cIsDamage>Saldırı</style>: Tüm silahlar iki kat hasar verir. Bekleme sürelerini %33 azaltır ve saldırı hızını %33 artırır, ancak TÜM zırh ve iyileşmeyi kaybedersin. Bu modu etkinleştirmek tankını 2 saniyeliğine elektrikle çarpar.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Hız Aşırtma",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Hızının kalkanını yok etmesine izin ver ve iticilerini şiddetle patlatarak <style=cIsDamage>%6000 hasar</style> ver, kendini havaya fırlat ve <style=cIsUtility>düşme hasarını önle</style>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Kalkanlar",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "4 saniyeliğine <style=cIsUtility>dış hasara karşı bağışıklık</style> kazanmak için etkinleştir.  Tek seferlik bir <color=#03fcc2>Güç Yeteneği</color> için feda edilebilir.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Patlayıcı Salvo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Her biri devasa bir yarıçapta <style=cIsDamage>%1400 hasar</style> veren 4 top ateşle. Silahlar yeniden doldurulmak yerine <color=#fc8080>aşırı ısınır</color>.\n<style=cSub>[<style=cIsDamage>Patlama Yarıçapı: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Standart",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Standart deneyim.\n\nTank seçtiğin hareket yönüne göre ilerler ve döner.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Alternatif",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Bu tankın oynanış şeklini değiştirir.\n\nTank gövde yönüne göre hareket eder, ancak <color=#fc8080>hareket yönüne doğru otomatik dönmez</color>.  Bu işlem <style=cIsUtility>manuel dönüşle</style> yapılır.\n\nUçarken kontroller Standart moda döner.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Güç Modu: <style=cIsUtility>Kaçınma</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Ekstra %50 hız, %10 itme gücü ve %50 motor gücü için saldırı hızını %50 azaltır ve bekleme süresini %50 artırır.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Güç Modu: <color=#80fc80>Savunma</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "500 zırh için %70 hız ve %100 itme gücünden feragat et.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Güç Modu: <style=cIsDamage>Saldırı</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "Tüm silahlar iki kat hasar verir. Bekleme sürelerini %33 azaltır ve saldırı hızını %33 artırır, ancak TÜM zırh ve iyileşmeyi kaybedersin. Bu modu etkinleştirmek tankını 2 saniyeliğine elektrikle çarpar.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "Tam da Dedee sonunda özgür kaldı derken, \r\nyine UES tarafından ele geçirildi.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "Taretsiz",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "Tareti kaldırır.  <style=cIsDamage>Tüm hasarı %30 artırır</style>"
  }
}