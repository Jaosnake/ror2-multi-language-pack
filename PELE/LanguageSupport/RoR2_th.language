    "KEYWORD_RAPID_REGEN": "<style=cKeywordName>ฟื้นฟู</style><style=cSub>ฟื้นพลังชีวิต <style=cIsHealing>5%</style> ของพลังชีวิตสูงสุดในเวลา 0.5 วินาที</style>",
    "KEYWORD_PERCENT_HP": "<style=cKeywordName>พลังชีวิต X%</style><style=cSub>การใช้ทักษะนี้สิ้นเปลือง<style=cIsHealth>พลังชีวิตปัจจุบัน X%</style></style>",
    "KEYWORD_SONIC_BOOM": "<style=cKeywordName>คลื่นกระแทกเสียง</style><style=cSub><style=cIsUtility>ผลัก</style>ศัตรูทั้งหมดที่โดนออกไป <style=cIsUtility>ผลักตัวคุณถอยหลัง</style>หากอยู่กลางอากาศ</style>",
    "KEYWORD_WEAK": "<style=cKeywordName>ทำให้อ่อนแอ</style><style=cSub>ลดความเร็วเคลื่อนที่และความเสียหายลง <style=cIsDamage>40%</style> และลดเกราะลง <style=cIsDamage>20</style></style>",
    "KEYWORD_HEAVY": "<style=cKeywordName>หนัก</style><style=cSub>ยิ่งเคลื่อนที่เร็ว ทักษะนี้ก็ยิ่งสร้างความเสียหายมากขึ้น</style>",
    "KEYWORD_FREEZING": "<style=cKeywordName>แช่แข็ง</style><style=cSub>แช่แข็งศัตรูให้อยู่กับที่ ศัตรูที่ถูกแช่แข็งจะ<style=cIsHealth>ตายทันที</style>หากพลังชีวิตต่ำกว่า <style=cIsHealth>30%</style></style>",
    "KEYWORD_EXPOSE": "<style=cKeywordName>เปิดช่องโหว่</style><style=cSub>การโจมตีศัตรูที่ถูกเปิดช่องโหว่จะลดเวลาคูลดาวน์ของทุกทักษะลง <style=cIsUtility>1.0 วินาที</style> และเพิ่ม<style=cIsDamage>ความเสียหาย +350%</style></style>",
    "KEYWORD_SHOCKING": "<style=cKeywordName>ช็อตไฟฟ้า</style><style=cSub>ขัดจังหวะศัตรูและทำให้มึนงง อาการมึนงงจะหายไปหากเป้าหมายได้รับความเสียหายมากกว่า <style=cIsHealth>10%</style> ของพลังชีวิตสูงสุด</style>",
    "KEYWORD_SLAYER": "<style=cKeywordName>สังหาร</style><style=cSub>สร้างความเสียหายสูงสุด <style=cIsDamage>3x</style> ต่อศัตรูที่มีพลังชีวิตต่ำ</style>",
    "KEYWORD_SUPERBLEED": "<style=cKeywordName>ตกเลือด</style><style=cSub>สร้างความเสียหายพื้นฐาน <style=cIsDamage>2000%</style> ในเวลา 15 วินาที <i>อาการตกเลือดสะสมได้</i></style>",
    "KEYWORD_IGNITE": "<style=cKeywordName>จุดไฟ</style><style=cSub>สร้างความเสียหายรวมเพิ่มอีก <style=cIsDamage>+50%</style> แบบต่อเนื่อง</style>",
    "KEYWORD_WEAKPOINT": "<style=cKeywordName>จุดอ่อน</style><style=cSub>ทำเครื่องหมาย<style=cIsDamage>จุดอ่อน</style>บนตัวศัตรู การโจมตีโดน<style=cIsDamage>จุดอ่อน</style>จะเป็น<style=cIsDamage>การโจมตีคริติคอล</style>เสมอ</style>",
    "KEYWORD_ACTIVERELOAD": "<style=cKeywordName>บรรจุกระสุนเชิงรุก</style><style=cSub>บรรจุกระสุนปืนรางหลังยิง หาก<style=cIsDamage>บรรจุกระสุนได้พอดีจังหวะ</style> นัดถัดไปจะสร้าง<style=cIsDamage>ความเสียหายพื้นฐานเพิ่ม +500%</style></style>",
    "KEYWORD_VOIDCORRUPTION": "<style=cKeywordName>การกลืนกิน</style><style=cSub>สะสมการกลืนกินเมื่อได้รับความเสียหาย โจมตีคริติคอล หรือถือไอเทมวอยด์ ลดการกลืนกินด้วยการฟื้นพลังชีวิต</style>",
    "OBJECTIVE_TITLE": "เป้าหมาย:",
    "OBJECTIVE_FIND_TELEPORTER": "ค้นหาและเปิดใช้<style=cDeath>เครื่องเคลื่อนย้าย <sprite name=\"TP\" tint=1></style>",
    "OBJECTIVE_CHARGE_TELEPORTER": "ชาร์จ<style=cDeath>เครื่องเคลื่อนย้าย <sprite name=\"TP\" tint=1></style> ({0}%)",
