        "JAVANGLE_HOUSE_7QUEEN_NAME": "Reina de corazones",
        "JAVANGLE_HOUSE_7QUEEN_DESCRIPTION": "Temporalmente <style=cIsUtility> fortalece 2 atributos aleatorios </style>, pero <style=cArtifact> debilita otros 2 atributos aleatorios </style>.",
        "JAVANGLE_HOUSE_7KING_NAME": "rey de bastos",
