    "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK kann <color=#FFFF00>U.C.-Schlüsselkarten</color> einsammeln, um <style=cIsDamage>Waffenkoffer</style> zu öffnen und sein Arsenal zu erweitern.",
    "ROB_HUNK_BODY_PPASSIVE2_NAME": "Vergessener Soldat",
    "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "Der erste <style=cIsHealth>Boss</style>, der auf jeder Stufe stirbt, lässt ein <style=cIsDamage>Versorgungspaket</style> mit einer Waffe oder einem Aufsatz fallen.",
    "ROB_HUNK_BODY_PASSIVE_NAME": "Düsterer Kampf",
    "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Starte mit einer <style=cIsDamage>LE 5</style> und einer <style=cIsDamage>Seitenwaffe</style>. Du kannst <style=cIsUtility>Truhen</style> nach Munition <style=cIsDamage>durchsuchen</style>.",
    "ROB_HUNK_BODY_PASSIVE2_NAME": "Drohendes Grauen",
    "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "Starte mit einem <style=cIsDamage>vollständigen Arsenal</style>, <style=cIsHealth>ABER</style> du kannst nun <style=cIsHealth>keine weitere Munition erhalten</style>.",
    "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "Neues Spiel+",
    "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Starte mit einer <style=cIsDamage>LE 5</style> und einer <style=cIsDamage>Seitenwaffe</style>. Du kannst <style=cIsUtility>Truhen</style> nach Munition <style=cIsDamage>durchsuchen</style>. <style=cIsHealth>Der Inhalt aller Waffenkoffer ist zufällig.</style>",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Höchste Autorität",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "Starte <style=cIsHealth>NUR</style> mit einer <style=cIsDamage>W-870</style>. Du kannst <style=cIsUtility>Truhen</style> nach Munition <style=cIsDamage>durchsuchen</style>.",
    "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Ultimativer Söldner",
    "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Starte <style=cIsHealth>NUR</style> mit einer <style=cIsDamage>voll aufgerüsteten LE 5</style>. Du kannst <style=cIsUtility>Truhen</style> nach Munition <style=cIsDamage>durchsuchen</style>. <style=cIsDamage>Spezial</style> wird durch den <color=#C80202>Verwüstungsmodus</color> ersetzt.",
    "ROB_HUNK_BODY_WPASSIVE_NAME": "Vollständige Globale Sättigung",
    "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "Starte <style=cIsHealth>NUR</style> mit einer <style=cIsDamage>Seitenwaffe</style>. Du kannst <style=cIsUtility>Truhen</style> nach Munition <style=cIsDamage>durchsuchen</style>. <style=cIsDamage>Nützlichkeit</style> wird durch <color=#C80202>Uroboros</color> ersetzt.",
    "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Pyromanie",
    "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "Starte <style=cIsHealth>NUR</style> mit einem <style=cIsDamage>Chemischen Flammenwerfer</style>. Du kannst <style=cIsUtility>Truhen</style> nach Munition <style=cIsDamage>durchsuchen</style>. <style=cIsHealth>Pro Stufe erscheint nur EIN Waffenkoffer.</style>",
    "ROB_HUNK_BODY_CONFIRM_NAME": "Bestätigen",
    "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "Mit der aktuellen Fertigkeit fortfahren.",
    "ROB_HUNK_BODY_CANCEL_NAME": "Abbrechen",
    "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "Die aktuelle Fertigkeit abbrechen.",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Kampfmesser",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Plündernd.</style> <style=cIsDamage>Schlitze</style> Gegner im Nahkampf für <style=cIsDamage>200% Schaden</style> auf und füge <style=cIsHealth>Zerfetzt</style> zu.",
    "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Nahkampf)",
    "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Plündernd.</style> <style=cIsDamage>Tritt zweimal zu</style> für <style=cIsDamage>200% und 250% Schaden</style>. Trifft der <style=cIsUtility>zweite Tritt</style>, folge mit einem <style=cIsDamage>Gegenangriff</style>.",
    "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Scannen",
    "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Scanne nach <style=cIsUtility>ungeöffneten Waffenkoffern</style>.",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Enterhaken",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Feuere einen Haken auf einen <style=cIsUtility>entfernten Punkt</style> und <style=cIsUtility>ziehe dich heran</style>. <style=cIsDamage>Nach der Landung kannst du einen Gegenangriff ausführen.</style>",
