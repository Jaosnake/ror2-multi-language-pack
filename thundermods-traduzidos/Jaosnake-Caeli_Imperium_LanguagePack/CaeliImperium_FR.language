    "CI_MONSTERCHEST_POPUP_TEXT": "<b>Coffre monstre</b>\n<i>Nourris-moi</i>",
    "CI_MONSTERCHEST_SPEW": "Cracher un objet de boss",
    "CI_MONSTERCHEST_TITLE": "Coffre monstre",
    "CI_MONSTERCHEST_CONTEXT": "Le nourrir",
    "CI_MONSTERCHEST_DESC": "Permet aux survivants de sacrifier des objets en échange d'un objet de boss.",
    "CI_MONSTERCHEST_CANSPEW": "L'objet de boss peut être craché",
    "CI_GAMBIT_NAME": "Gambit",
    "CI_GAMBIT_MESSAGE_FIRSTEXTRACTORCALL1": "Les scanners ont localisé plusieurs énormes gisements de matériaux riches en liquides. Pour les extraire, utilisez une raffinerie à installer vous-même. Pour construire des pipelines, appuyez sur le bouton d'Interaction près de l'extrémité du pipeline pour créer un hologramme de placement. Appuyez à nouveau sur le bouton d'Interaction pour construire le pipeline si l'hologramme est vert, ou annuler le placement si l'hologramme est rouge. Localisez les puits, installez les pipelines et pompez le tout vers la raffinerie. Plus vous installerez de pipelines, plus votre paie sera élevée",
    "CI_GAMBIT_MESSAGE_FIRSTEXTRACTORCALL2": "Vous avez défini des cibles sur plusieurs puits profonds de matériaux riches. J'envoie une raffinerie mobile que vous devrez remplir. Pour les extraire, utilisez une raffinerie à installer vous-même. Pour construire des pipelines, appuyez sur le bouton d'Interaction près de l'extrémité du pipeline pour créer un hologramme de placement. Appuyez à nouveau sur le bouton d'Interaction pour construire le pipeline si l'hologramme est vert, ou annuler le placement si l'hologramme est rouge. Installez tout ça, mettez la machine en route et pompons ces gisements jusqu'à la dernière goutte. Il est temps de construire des pipelines, survivants",
    "CI_REFINERY_OBJECTIVE_COMPLETED": "La <style=cHumanObjective>Raffinerie sur site</style> est terminée. Réclamez votre récompense sur place",
    "CI_REFINERY_OBJECTIVE_SABOTAGE": "{0} tuyaux doivent être réparés !",
    "CI_REFINERY_OBJECTIVE_RUNNING": "Attendez que la <style=cHumanObjective>Raffinerie sur site</style> se termine ({0}%)",
    "CI_REFINERY_OBJECTIVE_BUILDING_FIRST": "Construisez des pipelines. Au moins {2} pipelines doivent être construits pour démarrer la <style=cHumanObjective>Raffinerie sur site</style> ({0}/{1})",
    "CI_REFINERY_OBJECTIVE_BUILDING": "Construisez des pipelines. La <style=cHumanObjective>Raffinerie sur site</style> peut être démarrée ({0}/{1})",
    "CI_REFINERY_OBJECTIVE_READY": "La <style=cHumanObjective>Raffinerie sur site</style> est prête à démarrer",
    "CI_REFINERY_TITLE": "Raffinerie sur site",
    "CI_REFINERY_DESC": "Équipement de Gambit permettant d'extraire les matériaux précieux de la planète. Appelez des extracteurs sur les puits de ressources, construisez et reliez des pipelines aux extracteurs, démarrez la raffinerie, réparez les tuyaux et réclamez votre objet en récompense.",
    "CI_REFINERY_CONTEXT": "Démarrer la Raffinerie sur site",
    "CI_PIPELINE_BUILD_CONTEXT": "Construire",
    "CI_PIPELINE_REPAIR_CONTEXT": "Réparer",
    "CI_PIPELINE_CANCEL_CONTEXT": "Annuler la construction",
    "CI_RESOURCEWELL_CONTEXT": "Appeler un extracteur",
    "CI_PIPELINEVEHICLE_EXIT": "Glisser pour sortir",
    "CI_BUILDER_ANGLE": "Angle :",
    "CI_BUILDER_DISTANCE": "Distance :",
    "CI_BUILDER_ERROR": "ERREUR",
    "CI_BUILDER_COLLISION": "Collision",
    "CI_BUILDER_COLLIDES_VALID": "Non",
    "CI_BUILDER_COLLIDES_INVALID": "Oui",
    "CI_BISHOP_SPEAR_THROW": "Lancer",
    "CI_BISHOP_SPEAR_SLAM": "Frappe lourde",
    "CI_BISHOP_SPEAR_CHAIN": "WIP",
    "CI_DIFFICULTY_HURTMEPLENTY_NAME": "Hurt Me Plenty",
    "CI_DIFFICULTY_HURTMEPLENTY_DESC": "C'est ainsi que le jeu est censé être joué en tant que Doomguy ! Battez le Boss Final Principal avec Doomguy pour débloquer cette difficulté pour tous les survivants et débloquer le reste des difficultés pour Doomguy (pour l'instant, cette fonctionnalité n'est pas encore implémentée).<style=cStack>\n\nVitesse des projectiles des monstres : <style=cIsHealing>-35%</style>\nHauteur de vol des monstres : <style=cIsHealing>8m</style>\nÉlites : <style=cIsHealing>Supprimés</style>\nRecul : <style=cIsDamage>Supprimé</style>\nDrones, objets et équipements : <style=cIsDamage>Réorganisés</style>. <style=cIsHealth>-75% de dégâts. Ne peuvent plus étourdir, électrocuter, immobiliser ni geler</style>\nMonstres : <style=cIsHealth>Ne ciblent pas les serviteurs</style>\nSanté des monstres lourds : <style=cIsHealth>+60%</style>\nSanté des boss : <style=cIsHealth>+120%</style>\nImprimantes et recycleurs : <style=cIsHealth>Supprimés</style>\nObjets du Vide et Lunaires : <style=cIsHealth>Supprimés</style>\nMonstres faibles : <style=cIsHealth>Supprimés</style>\nÉtourdissements à l'impact : <style=cIsHealth>Supprimés</style></style>",
    "CI_DOOMGUY_BODY_NAME": "Doomguy",
    "CI_DOOMGUY_BODY_SUBTITLE": "Gars maudit ou gars du destin ou un truc du genre jsp",
    "CI_DOOMGUY_NAME": "Doomguy",
    "CI_DOOMGUY_DESC": "C'est le Doomguy !",
    "CI_DOOMGUY_SHOTGUN_NAME": "Fusil à pompe de combat",
    "CI_DOOMGUY_SHOTGUN_DESC": "Tire des plombs infligeant <style=cIsDamage>5x120% de dégâts</style>",
    "CI_DOOMGUY_SPEAR_NAME": "Coup de lance",
    "CI_DOOMGUY_SPEAR_DESC": "Donne un coup de lance infligeant <style=cIsDamage>200% de dégâts</style>. <style=cIsUtility>Pare</style> les attaques et projectiles entrants <style=cIsHealing>parables</style>. Confère du <style=cDeath>renforcement</style> et <style=cIsUtility>réduit le temps de recharge</style> de votre compétence Utilitaire lors d'une <style=cIsHealing>parade réussie</style>",
    "CI_DOOMGUY_ACCELERATOR_NAME": "Accélérateur à plasma",
    "CI_DOOMGUY_ACCELERATOR_DESC": "Tire un projectile de plasma infligeant <style=cIsDamage>50% de dégâts</style>. Un tir continu surchargera l'accélérateur et augmentera les dégâts des projectiles de plasma à <style=cIsDamage>125% de dégâts</style>. Libère la surcharge en relâchant la détente et inflige <style=cIsDamage>500% de dégâts</style>",
    "CI_DOOMGUY_DASH_NAME": "Ruée",
    "CI_DOOMGUY_DASH_DESC": "<style=cIsUtility>Fonce</style> dans la direction du déplacement",
    "CI_DOOMGUY_SPEARSPECIAL_NAME": "Renforcement de lance",
    "CI_DOOMGUY_SPEARSPECIAL_DESC": "Prépare la lance pour le <style=cDeath>renforcement</style>. Consomme 5 cumuls de <style=cDeath>renforcement</style> à l'utilisation.\n\nPrimaire : Lance la lance pour infliger <style=cIsDamage>2000% de dégâts</style>. Inflige un <style=cIsDamage>coup critique</style> et un <style=cIsDamage>super-étourdissement</style> en cas de tir dans la tête.\n\nSecondaire : WIP\n\nUtilitaire : Bondit vers le bas en infligeant <style=cIsDamage>700% de dégâts</style> dans un <style=cIsUtility>rayon de 24 mètres</style>",
    "CI_DOOMGUY_PUNCH_NAME": "Coup de poing",
    "CI_DOOMGUY_PUNCH_DESC": "Frappe la cible pour infliger <style=cIsDamage>800% de dégâts</style>. Si la cible <style=cDeath>chancelle</style>, la charge n'est pas consommée, vous soigne de <style=cIsHealing>3.125%/12.5%/25%</style> de la santé maximale et de <style=cIsHealing>10%/25%/50%</style> de soin de réserve selon la classe de la cible, et confère du <style=cDeath>renforcement</style>"
  }
}
