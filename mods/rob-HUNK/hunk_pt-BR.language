    "ROB_HUNK_BODY_PPASSIVE_NAME": "OSP (Aquisição em Campo)",
    "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK pode coletar <color=#FFFF00>Cartões de Acesso da U.C.</color> para abrir <style=cIsDamage>maletas de armas</style> e expandir seu arsenal.",
    "ROB_HUNK_BODY_PPASSIVE2_NAME": "Soldado Esquecido",
    "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "O primeiro <style=cIsHealth>chefe</style> a morrer em cada fase derruba uma <style=cIsDamage>mochila de suprimentos</style> contendo uma arma ou acessório.",
    "ROB_HUNK_BODY_PASSIVE_NAME": "Luta Sombria",
    "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Comece com uma <style=cIsDamage>LE 5</style> e uma <style=cIsDamage>arma secundária</style>. Você pode <style=cIsDamage>vasculhar</style> <style=cIsUtility>baús</style> em busca de munição.",
    "ROB_HUNK_BODY_PASSIVE2_NAME": "Terror Iminente",
    "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "Comece com um <style=cIsDamage>arsenal completo</style>, <style=cIsHealth>MAS</style> você fica <style=cIsHealth>impedido de ganhar mais munição</style>.",
    "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "Novo Jogo+",
    "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Comece com uma <style=cIsDamage>LE 5</style> e uma <style=cIsDamage>arma secundária</style>. Você pode <style=cIsDamage>vasculhar</style> <style=cIsUtility>baús</style> em busca de munição. <style=cIsHealth>Todo o conteúdo das maletas de armas é aleatório.</style>",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Autoridade Suprema",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "Comece <style=cIsHealth>APENAS</style> com uma <style=cIsDamage>W-870</style>. Você pode <style=cIsDamage>vasculhar</style> <style=cIsUtility>baús</style> em busca de munição.",
    "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Mercenário Supremo",
    "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Comece <style=cIsHealth>APENAS</style> com uma <style=cIsDamage>LE 5 totalmente aprimorada</style>. Você pode <style=cIsDamage>vasculhar</style> <style=cIsUtility>baús</style> em busca de munição. A <style=cIsDamage>Especial</style> é substituída pelo <color=#C80202>Modo Fúria</color>.",
    "ROB_HUNK_BODY_WPASSIVE_NAME": "Saturação Global Completa",
    "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "Comece <style=cIsHealth>APENAS</style> com uma <style=cIsDamage>arma secundária</style>. Você pode <style=cIsDamage>vasculhar</style> <style=cIsUtility>baús</style> em busca de munição. A <style=cIsDamage>Utilidade</style> é substituída por <color=#C80202>Uroboros</color>.",
    "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Piromania",
    "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "Comece <style=cIsHealth>APENAS</style> com um <style=cIsDamage>Lança-Chamas Químico</style>. Você pode <style=cIsDamage>vasculhar</style> <style=cIsUtility>baús</style> em busca de munição. <style=cIsHealth>Apenas UMA maleta de arma aparece por fase.</style>",
    "ROB_HUNK_BODY_CONFIRM_NAME": "Confirmar",
    "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "Prosseguir com a habilidade atual.",
    "ROB_HUNK_BODY_CANCEL_NAME": "Cancelar",
    "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "Cancelar a habilidade atual.",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Faca de Combate",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Saque.</style> <style=cIsDamage>Corte</style> combatentes próximos causando <style=cIsDamage>200% de dano</style> e infligindo <style=cIsHealth>Mutilado</style>.",
    "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Combate Corpo a Corpo)",
    "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Saque.</style> <style=cIsDamage>Chute duas vezes</style> causando <style=cIsDamage>200% e 250% de dano</style>. Se o <style=cIsUtility>segundo chute</style> acertar, finalize com um <style=cIsDamage>Contra-ataque</style>.",
    "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Escanear",
    "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Escaneie em busca de <style=cIsUtility>maletas de armas fechadas</style>.",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Gancho",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Dispare um gancho em um <style=cIsUtility>ponto distante</style> e <style=cIsUtility>puxe-se até lá</style>. <style=cIsDamage>Você pode contra-atacar ao aterrissar.</style>",
    "ROB_HUNK_BODY_SHOOT_ATM_NAME": "Disparar",
