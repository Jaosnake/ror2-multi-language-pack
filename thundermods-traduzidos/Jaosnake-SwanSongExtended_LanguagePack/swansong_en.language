    "ITEM_AGLET_NAME": "Aglet",
    "ITEM_AGLET_PICKUP": "Increase movement speed while grounded.",
    "ITEM_AGLET_DESCRIPTION": "Your movement speed gradually increases while grounded, up to 30% (+30% per stack) after 5 seconds.",
    "ITEM_BORBOBAKEDBEANS_NAME": "The Beans of Tragedy",
    "ITEM_BORBOBAKEDBEANS_PICKUP": "Heal instantly on kill. Rapid kills heal for more.",
    "ITEM_BORBOBAKEDBEANS_DESCRIPTION": "On kill, <style=cIsHealing>heal for 8 health</style> <style=cStack>(+4 per stack)</style>. Also gain a <style=cIsUtility>temporary buff</style> that increases this healing by <style=cIsHealing>12 per buff</style> <style=cStack>(+6 per stack)</style>, up to a maximum cap of <style=cIsUtility>4 times.</style>",
    "ITEM_BORBOBAKEDBEANS_LORE": "There's nothing inside.",
    "ITEM_CHEFITEM_NAME": "Chef ’Stache",
    "ITEM_CHEFITEM_PICKUP": "Burning enemies drop chunks of healing meat.",
    "ITEM_CHEFITEM_DESCRIPTION": "Gain <style=cIsDamage>25% ignite chance</style>. Hitting burning enemies has a <style=cIsDamage>1%</style> chance <style=cStack>(+1% per stack)</style> to create 2 <style=cIsHealing>healing nuggets</style> that restore <style=cIsHealing>25.0 HP</style>. Nugget chance increases <style=cIsDamage>per stack of burn</style>, up to <style=cIsDamage>10</style> times.",
    "ITEM_BORBOFUSE_NAME": "Volatile Fuse",
    "ITEM_BORBOFUSE_PICKUP": "Creates a stunning nova when your shields break.",
    "ITEM_BORBOFUSE_DESCRIPTION": "Gain <style=cIsHealing>25.0 shield</style> <style=cStack>(+25.0 per stack)</style>. Breaking your shields <style=cIsUtility>Shocks</style> up to 3 <style=cStack>(+1 per stack)</style> enemies within <style=cIsUtility>40.0m</style> <style=cStack>(+4.0 per stack)</style>. <style=cIsDamage>Shock duration scales with shield health</style>.",
    "ITEM_NEARBYDEFENSE_NAME": "Jellyfish Necklace",
    "ITEM_NEARBYDEFENSE_PICKUP": "Increases armor and regeneration while enemies are nearby.",
    "ITEM_NEARBYDEFENSE_DESCRIPTION": "Increases base health regeneration by <style=cIsHealing>+1 hp/s</style> <style=cStack>(+1 hp/s per stack)</style> and armor by <style=cIsHealing>+10</style> <style=cStack>(+10 per stack)</style>. For each enemy within <style=cIsUtility>20m</style>, also gain <style=cIsHealing>+0.5 hp/s</style> <style=cStack>(+0.5 hp/s per stack)</style> base health regeneration and <style=cIsHealing>+5</style> <style=cStack>(+5 per stack)</style> armor, up to <style=cIsUtility>5</style> times.",
    "ITEM_ICHORRED_NAME": "Metamorphic Ichor (Red)",
    "ITEM_ICHORRED_PICKUP": "Increase attack speed and critical strike chance. .",
    "ITEM_ICHORRED_DESCRIPTION": "Increase <style=cIsDamage>attack speed</style> by <style=cIsDamage>7.5%</style> <style=cStack>(+7.5% per stack)</style>. Increase <style=cIsDamage>critical strike chance</style> by <style=cIsDamage>5%</style> <style=cStack>(+5% per stack)</style>. <style=cIsVoid>Corrupts all Replusion Armor Plates and Yellow Ichors</style>.",
    "ITEM_ICHORVIOLET_NAME": "Metamorphic Ichor (Violet)",
    "ITEM_ICHORVIOLET_PICKUP": "Gain barrier when hurt. <style=cIsVoid>Corrupts all Medkits and Red Ichors</style>.",
    "ITEM_ICHORVIOLET_DESCRIPTION": "Gain <style=cIsHealing>22 barrier</style> when hurt <style=cStack>(+22 per stack)</style>. <style=cIsVoid>Corrupts all Medkits and Red Ichors</style>.",
    "ITEM_ICHORYELLOW_NAME": "Metamorphic Ichor (Yellow)",
    "ITEM_ICHORYELLOW_PICKUP": "Gain health regeneration. <style=cIsVoid>Corrupts all Soldier's Syringes and Violet Ichors</style>.",
    "ITEM_ICHORYELLOW_DESCRIPTION": "Increase <style=cIsHealing>base health regeneration</style> by <style=cIsHealing>0.8 hp/s</style> <style=cStack>(+0.8 hp/s per stack)</style>. <style=cIsVoid>Corrupts all Soldier's Syringes and Violet Ichors</style>.",
    "ITEM_PHRYGIANLILY_NAME": "Phrygian Lily",
    "ITEM_PHRYGIANLILY_PICKUP": "Enter a rage after activating the teleporter. <style=cIsVoid>Corrupts all Lepton Daisies.</style>",
    "ITEM_PHRYGIANLILY_DESCRIPTION": "<style=cIsDamage>Enter a rage</style> for 20 seconds upon activating the teleporter. While enraged, increases attack speed by +30% <style=cStack>(+15% per stack)</style> and reduces skill cooldowns by 30% <style=cStack>(15% per stack)</style>",
    "ITEM_HEALFROMBLEEDINGENEMIES_NAME": "Bloodsucking Coralite",
    "ITEM_HEALFROMBLEEDINGENEMIES_PICKUP": "Bleeding enemies heal you on hit. Corrupts all Leeching Seeds.",
    "ITEM_HEALFROMBLEEDINGENEMIES_DESCRIPTION": "Gain <style=cIsHealth>10% bleed chance</style>. Bleeding enemies heal you for <style=cIsDamage>+0.2 health</style> when hit <style=cIsHealth>per stack of bleed</style>, up to a maximum of 2 <style=cStack>(+1 per stack)</style> health. <style=cIsVoid>Corrupts all Leeching Seeds.</style>",
    "ITEM_WICKEDBAND_NAME": "Wicked Band",
    "ITEM_WICKEDBAND_PICKUP": "High damage hits reduce cooldowns by 1 second.",
    "ITEM_WICKEDBAND_DESCRIPTION": "Hits that deal <style=cIsDamage>more than 400% damage</style> will also <style=cIsUtility>reduce ALL cooldowns by 1.0s</style> <style=cStack>(+1.0 per stack)</style>. <style=cIsHealth>1.0 second cooldown.</style>",
    "ITEM_GALLERY_ITEM_DROP_NAME": "Gallery Item Drop",
    "ITEM_GALLERY_ITEM_DROP_PICKUP": "You shouldn't see this lol",
    "ITEM_GALLERY_ITEM_DROP_DESCRIPTION": "You shouldn't see this lol",
    "ITEM_HEALTHUP_NAME": "HealthUp",
    "ITEM_AOEONCRIT_NAME": "Hypo-Threader",
    "ITEM_AOEONCRIT_PICKUP": "'Critical Strikes' fire a laser chain.",
    "ITEM_AOEONCRIT_DESCRIPTION": "Gain <style=cIsDamage>5% critical chance</style>. <style=cIsDamage>Critical strikes</style> fire a <style=cIsDamage>bouncing laser</style> for <style=cIsDamage>60%</style> <style=cStack>(+20% per stack)</style> TOTAL damage on to up to <style=cIsDamage>1 <style=cStack>(+1 per stack)</style> enemies</style>.",
    "ITEM_AOEONCRIT_LORE": "You dumbass! These things are supposed to be UNBREAKABLE. How the hell did you manage to do this?\r\n\r\nDude... Sorry to break it to ya but hyper threaders are cheap as shit. Itll cost you, like, pocket change to get a new one. You ever wonder why?\r\n\r\nI dont fucking care man. This thing barely works now. If anyone is buying me a new one it's YOU.\r\n\r\nHaha, dude, uh, what do you think I am, made out of money? I uh-\r\n\r\nI told you. I. Dont. FUCKING. CARE.",
    "ITEM_BORBOBIGBATTERY_NAME": "AAAAAAA Battery",
    "ITEM_BORBOBIGBATTERY_PICKUP": "Increase shield recharge rate. While shields are active, gain an attack speed bonus.",
    "ITEM_BORBOBIGBATTERY_DESCRIPTION": "Gain a <style=cIsHealing>shield</style> equal to <style=cIsHealing>4%</style> of your maximum health. Reduces <style=cIsUtility>shield recharge delay</style> by <style=cIsUtility>1.0s</style>. While shields are active, increase <style=cIsDamage>attack speed</style> by <style=cIsDamage>20%</style> <style=cStack>(+20% per stack)</style>.",
    "ITEM_BORBOBIGBATTERY_LORE": "Order: Prototype Battery\r\nTracking Number: 11***********\r\nEstimated Delivery: 5/6/2056\r\nShipping Method:  Priority\r\nShipping Address: Palia Research Station, Sun\r\nShipping Details:\r\n\r\nOkay, how’s this one?\r\n\r\nWe’ve uh,\r\n\r\n*snicker*\r\n\r\nUh, we’ve reviewed your notes on the last prototype, and, uh\r\n\r\n(background chatter)\r\n\r\nWe’ve adjusted the dimensions slightly\r\n\r\n*snicker*\r\n\r\nNow, it is slightly longer than your generator thing, but, uh\r\n\r\n(muffled laughter)\r\n\r\nWe also drew up this little, uh, connector thing…\r\n\r\n(Shut the fuck up guys)\r\n\r\nUh, anyway, you can just, like, stick it right in there, like in the demo video\r\n\r\n(loud footsteps)\r\n\r\nAnd honestly I think we’re,\r\n\r\n*snicker*\r\n\r\nI think we’re really onto something here, man\r\n\r\nLike this could be the uh\r\n\r\nThe new standard power supply\r\n\r\n*snicker*\r\n\r\nYou know?",
    "ITEM_BINARYSHIELD_NAME": "Plated Pereopod",
    "ITEM_BINARYSHIELD_PICKUP": "Increase movement speed while shields are down.",
    "ITEM_BINARYSHIELD_DESCRIPTION": "Gain <style=cIsHealing>25.0 shield</style> and <style=cIsUtility>5% <style=cStack>(+19% per stack)</style> movement speed</style>. While shields are down, increase <style=cIsUtility>movement speed</style> by <style=cIsUtility>19%</style> <style=cStack>(+19% per stack)</style>. <style=cIsVoid>Corrupts all Paul's Goat Hoofs.</style>",
    "ITEM_BIRDBAND_NAME": "Dev’s Item",
    "ITEM_BIRDBAND_PICKUP": "High damage hits also make you Regenerative for a short duration. Recharges over time.",
    "ITEM_BIRDBAND_DESCRIPTION": "Hits that deal <style=cIsDamage>more than 400% damage</style> also make you <style=cIsHealing>Regenerative</style> for <style=cIsDamage>1.5 seconds</style> <style=cStack>(+0.75 seconds per stack)</style>, restoring <style=cIsHealing>10% of your maximum health</style> per second. Recharges every 7 seconds.",
    "ITEM_BIRDBAND_LORE": "“I’m telling you, they’re real.”\r\n\r\n“No way, dude. It’s ridiculous even for a ghost story.”\r\n\r\n“Yeah! ‘Even higher than the gods themselves’? Get real.”\r\n\r\n“I’ve seen proof, I’m telling you. Shit that defies explanation.”\r\n\r\n“Oh, do tell. I’m on the edge of my seat.”\r\n\r\n“You know those missile launchers? The ones that used to shoot one big fuckoff rocket? Why’d they start vomiting those little stingers all of a sudden?”\r\n\r\n“I dunno.”\r\n\r\n“It was them. They rewrote it. And- and that all that shit that just disappeared, like it was never there. And all our medical supplies that suddenly got way less effective. You notice that all the monsters don’t hit as hard as they used to?”\r\n\r\n“Dude…”\r\n\r\n“It’s real, I’m telling you! And all our suits got so much… clunkier. All at once. Even though nothing’s wrong with them.”\r\n\r\n“...”\r\n\r\n“And my wungus only heals one hp now.”\r\n\r\n“Dude. What the fuck are you talking about?”\r\n\r\n“He’s lost it.”",
    "ITEM_CLOUDBOTTLE_NAME": "Cloud In A Bottle",
    "ITEM_CLOUDBOTTLE_PICKUP": "Double jump near enemies to stun them!",
    "ITEM_CLOUDBOTTLE_DESCRIPTION": "Gain an air jump charge. <style=cIsUtility>15</style>s cooldown.While ready, air jumping within <style=cIsUtility>9.0m</style> <style=cStack>(+9.0m per stack)</style> of any enemy drops a <style=cIsUtility>smoke bomb</style>, <style=cIsDamage>stunning</style> them for <style=cIsDamage>1.0s</style> and reduces the cooldown by <style=cIsUtility>10s.</style>",
    "ITEM_FARTBOTTLE_NAME": "Quarantined Contaminant",
    "ITEM_FARTBOTTLE_PICKUP": "Double jumping near enemies cripples and damages them. <style=cIsVoid>Corrupts all Cloud In A Bottles.</style>",
    "ITEM_FARTBOTTLE_DESCRIPTION": "Gain an air jump charge. While ready, air jumping within <style=cIsUtility>11.0m</style> of an enemy produces a <style=cIsDamage>toxic gas</style>, dealing <style=cIsDamage>200%</style> base damage <style=cStack>(+100% per stack)</style> per second and Crippling enemies within. Cannot be reactivated for <style=cIsUtility>4</style>s. <style=cIsVoid>Corrupts all Cloud In A Bottles.</style>",
    "ITEM_CHICKEN_NAME": "Raw Chicken",
    "ITEM_CHICKEN_PICKUP": "Increases max health. Try to keep it down!",
    "ITEM_CHICKEN_DESCRIPTION": "Increase your <style=cIsHealing>maximum health</style> by <style=cIsHealing>30%</style> <style=cStack>(+30% per stack)</style>. <style=cIsHealing>Suffer food poisoning</style>, reducing your <style=cIsHealing>base health regeneration</style> by <style=cIsHealing>-2.0 hp/s</style> for 120 seconds.",
    "ITEM_DISCOUNTCARDNEW_NAME": "Loyalty Card",
    "ITEM_DISCOUNTCARDNEW_PICKUP": "Shop terminals give cash back and stay open. Can be used twice.",
    "ITEM_DISCOUNTCARDNEW_DESCRIPTION": "When purchasing from <style=cIsUtility>multishop</style> terminals, the other terminals <style=cIsUtility>stay open</style>, refunding <style=cIsUtility>$20</style>. Usable up to two times.",
    "ITEM_BOSSITEMCONSUMABLE_NAME": "Obsidian Scalpel",
    "ITEM_BOSSITEMCONSUMABLE_PICKUP": "Large monsters have a much greater chance of dropping a trophy. Consumed on drop.",
    "ITEM_BOSSITEMCONSUMABLE_DESCRIPTION": "Killing enemies who are capable of dropping <style=cIsDamage>trophy items</style> yields an additional <style=cIsUtility>50%</style> chance to drop the <style=cIsDamage>trophy</style>. Consumed on successful use.",
    "ITEM_BOSSITEMCONSUMABLE_LORE": "Order: Medical Scalpel (Obsidian)\r\nTracking Number: 91***********\r\nEstimated Delivery: 09/30/2056\r\nShipping Method:  Priority/Fragile\r\nShipping Address: Mt Goliath, Mars\r\nShipping Details:\r\n\r\nCustom made according to your specifications. Very sharp. Blade thickness is measured in planck lengths. This will definitely cut whatever you need it for.\r\nCan’t speak for the durability, though. Try to get it right the first time.\r\nAnd one more thing – when it breaks, it won’t wait ‘till your operation is finished. Don’t use it on anything you care about not damaging. Or killing.\r\nYou already knew all that, though. Can’t help but wonder what you keep ordering these things for.",
    "ITEM_EGG_NAME": "Egg",
    "ITEM_EGG_PICKUP": "Slightly increase health. Start an egg hunt.<style=cIsVoid>Corrupts most edible and animal matter</style>.",
    "ITEM_EGG_DESCRIPTION": "Gain <style=cIsHealing>5 max health</style>. <style=cIsUtility>Start an egg hunt</style>. <style=cIsVoid>Corrupts all Infusion, Bison Steak, and Alien Heads</style>.",
    "ITEM_EGG_LORE": "this egg is so fuckign yummuy",
    "ITEM_FROZENSHELL_NAME": "Frozen Turtle Shell",
    "ITEM_FROZENSHELL_PICKUP": "Reduce incoming damage while at low health.",
    "ITEM_FROZENSHELL_DESCRIPTION": "<style=cIsHealing>Increase maximum health</style> by <style=cIsHealing>8%</style> <style=cStack>(+8% per stack)</style>. For every missing <style=cIsHealth>10% of max health</style>, gain <style=cIsHealing>5</style> <style=cStack>(+5 per stack)</style> additional armor.",
    "ITEM_GAMMAKNIFE_NAME": "Gamma Knife",
    "ITEM_GAMMAKNIFE_PICKUP": "Killing champions permanently reduces cooldowns and temporarily guarantees Critical Strikes. <style=cIsVoid>Corrupts all Obsidian Scalpels.</style>",
    "ITEM_GAMMAKNIFE_DESCRIPTION": "Killing a <style=cIsDamage>Champion</style> increases your <style=cIsDamage>Critical Strike chance</style> by <style=cIsDamage>100%</style> for <style=cIsDamage>9.0</style> seconds AND <style=cIsHealth>permanently</style> increases your <style=cIsUtility>armor</style> by <style=cIsUtility>5</style> and reduces all <style=cIsDamage>ability cooldowns</style> by <style=cIsDamage>-5%</style>, up to <style=cIsUtility>9</style> <style=cStack>(+9 per stack)</style> times. <style=cIsVoid>Corrupts all Obsidian Scalpels.</style>",
    "ITEM_GOLDEN_EGG_NAME": "Golden Egg",
    "ITEM_GOLDEN_EGG_PICKUP": "Sometimes, dreams come true...",
    "ITEM_GOLDEN_EGG_DESCRIPTION": "At the start of the next stage, one golden egg will hatch into a void item.",
    "ITEM_BORBODISCOUNT_NAME": "Greedy Ring",
    "ITEM_BORBODISCOUNT_PICKUP": "Gain extra money and regeneration after opening chests.",
    "ITEM_BORBODISCOUNT_DESCRIPTION": "After spending <style=cIsDamage>money</style>, gain a <style=cIsDamage>Rebate</style> for 20.0 seconds. While your <style=cIsDamage>Rebate</style> is active, increases income by 15% <style=cStack>(+7.5% per stack)</style> and <style=cIsHealing>base health regeneration</style> by <style=cIsHealing>3.0 hp/s</style> <style=cStack>(+3.0 hp/s per stack)</style>.",
    "ITEM_BORBODISCOUNT_LORE": "Order: Mapel Coupon Getter (Lite)\r\nTracking Number: 06***********\r\nEstimated Delivery: 11/04/2056\r\nShipping Method:  Priority\r\nShipping Address: 308, Belfast Station, Earth\r\nShipping Details:\r\n\r\nAlright, here you are. As promised, it (legally of course) views the code on electronic purchases to find promo codes and discounts and apply them to the purchase, no user input needed! It’s very legal.\r\nIt may be a little scuffed in practice, since you need to have the full cost on hand and the coupon codes might not be the best ones offered. Legal reasons for that, naturally. Oh, and there’s a limit on how many purchases you can do- you gotta wait a bit for it to refresh if you wanna get those coupons.\r\nOf course, you can always buy the premium version for unlimited discounts~\r\n",
    "ITEM_KALEIDOSKULL_NAME": "Kaleidoskull",
    "ITEM_KALEIDOSKULL_PICKUP": "Critical Strikes inflict a random debuff. <style=cIsVoid>Corrupts all Predatory Instincts.</style>",
    "ITEM_KALEIDOSKULL_DESCRIPTION": "Gain <style=cIsDamage>5% critical chance</style>. <style=cIsDamage>Critical strikes</style> randomly <style=cIsDamage>Ignite</style> or <style=cIsUtility>Frost</style>. Additionally has a 50% chance to inflict <style=cIsUtility>1</style> <style=cStack>(+1 per stack)</style> random debuffs. <style=cIsVoid>Corrupts all Predatory Instincts.</style>",
    "ITEM_LIGHTNINGATTRACTOR_NAME": "Copper Fork",
    "ITEM_LIGHTNINGATTRACTOR_PICKUP": "Attract lightning on repeated hits.",
    "ITEM_LIGHTNINGATTRACTOR_DESCRIPTION": "Damage from any <style=cIsDamage>skill or equipment</style> also sticks the enemy with a copper fork for <style=cIsUtility>3.0</style> seconds. Repeatedly attacking a forked enemy resets the fork's duration and attracts lightning, <style=cIsDamage>Stunning</style> a nearby enemy for <style=cIsDamage>300% base damage</style> <style=cStack>(+300% per stack)</style>. 1 max, recharges <style=cIsUtility>5.0s</style> after the fork expires.",
    "ITEM_LIGHTNINGATTRACTOR_LORE": "New, from CuCo!\r\n\r\nThe CopperWare Utensil set offers countless benefits over your mundane Stainless Steel silverware.\r\n\r\nA stylish reddish-brown color to match your tableware, and a perfect match for your CuCo CopperWare Pots and Pans set!\r\n\r\nSupplemental Copper intake directly from your eating utensils!\r\n\r\nEasy cleaning! A rub down with any household acid like Vinegar or Lemon Juice will bring your CopperWare back to a factory shine!\r\n\r\nTry CopperWare today!\r\n\r\nPRODUCT WARNINGS\r\n\r\nTo avoid risk of galvanic corrosion, do not allow CopperWare in contact with other metal surfaces, especially in the presence of electrolytes like salt.\r\n\r\nDo not use CopperWare utensils in cooking. This presents a significant burn risk and may leach copper into the dish.\r\n\r\nCustomers over the age of 65 are not recommended to use CopperWare due to links between copper and Alzheimer's Disease.\r\n\r\nDue to copper's high electrical condicuctivity, it is recommended not to use any CopperWare products in close proximity to electrical currents or appliances.\r\n\r\nTo mitigate risk of fatal electrocution, please do not use CopperWare products when dining outside.\r\n\r\nWith your agreement to purchase and use this product, CuCo is released of liability from any consumer complaints relating to the nature of copper kitchenware.",
    "ITEM_LOWHEALTHREGEN_NAME": "Charming Chanterelle",
    "ITEM_LOWHEALTHREGEN_PICKUP": "Increase regeneration, but it only sprouts while below 60% health!",
    "ITEM_LOWHEALTHREGEN_DESCRIPTION": "While below <style=cIsHealing>60% maximum health</style>, increase <style=cIsHealing>base health regeneration</style> by <style=cIsHealing>+2.0 hp/s</style> <style=cStack>(+2.0 hp/s per stack)</style>.",
    "ITEM_LUNARBRAND_NAME": "Starfire Brand",
    "ITEM_LUNARBRAND_PICKUP": "Cauterize burning enemies, inflicting heavy damage <style=cIsHealth>AND erasing all of their debuffs.</style>",
    "ITEM_LUNARBRAND_DESCRIPTION": "Gain <style=cIsDamage>20%</style> chance to <style=cIsDamage>Ignite</style> on hit. Inflicting <style=cIsDamage>5</style> stacks of burn Cauterizes enemies for <style=cIsDamage>5</style> seconds <style=cStack>(+5 per stack)</style>, dealing <style=cIsDamage>900%</style> <style=cStack>(+450% per stack)</style> damage. Additionally, Cauterize slows enemies by 50% and negates all healing, <style=cIsHealth>BUT... Cauterized enemies are cleansed of all debuffs and have +30 armor.</style>",
    "ITEM_LUNARINCREASECD_NAME": "Compression Loop",
    "ITEM_LUNARINCREASECD_PICKUP": "All skills fire lunar shards... <style=cIsHealth>BUT all skills have increased cooldowns</style>",
    "ITEM_LUNARINCREASECD_DESCRIPTION": "On any skill use, fire <style=cIsDamage>lunar shards</style> for <style=cIsDamage>160% damage</style> (increases with ability cooldown). <style=cIsHealth>Increase the cooldowns of all skills by 1.0 second</style> <style=cStack>(+1.0 per stack)</style>.",
    "ITEM_MAGICQUIVER_NAME": "Magic Quiver",
    "ITEM_MAGICQUIVER_PICKUP": "Using skills has a chance to not consume stock.",
    "ITEM_MAGICQUIVER_DESCRIPTION": "Grants a <style=cIsDamage>10.0%</style> <style=cStack>(+10.0% per stack)</style> chance to not consume a charge on skill cast. <style=cIsUtility>Unaffected by luck</style>.",
    "ITEM_BORBOMANAFLOWER_NAME": "Nature’s Gift",
    "ITEM_BORBOMANAFLOWER_PICKUP": "Slightly increase attack speed and reduce Primary and Secondary cooldowns.",
    "ITEM_BORBOMANAFLOWER_DESCRIPTION": "Increases <style=cIsDamage>attack speed</style> by <style=cIsUtility>8%</style> <style=cStack>(+8% per stack)</style>, and reduces <style=cIsUtility>Primary and Secondary skill cooldowns</style> by <style=cIsUtility>8%</style> <style=cStack>(+8% per stack)</style>.",
    "ITEM_BORBOMANAFLOWER_LORE": "Order: Jupiter Rose\r\nTracking Number: 58***********\r\nEstimated Delivery: 07/30/2056\r\nShipping Method: Standard\r\nShipping Address: 280 Oak Boulevard, Venus\r\nShipping Details:\r\n\r\nIsn’t it pretty?\r\nJust looking at it fills me with energy.\r\nNature is so magical :)",
    "ITEM_MINIAMETHYST_NAME": "Amethyst Fragment",
    "ITEM_MINIAMETHYST_PICKUP": "Activating your Equipment reduces your ability cooldowns.",
    "ITEM_MINIAMETHYST_DESCRIPTION": "Activating your Equipment reduces <style=cIsUtility>all ability cooldowns</style> by <style=cIsUtility>10%</style> <style=cStack>(+10% per stack)</style> of your Equipment's base cooldown.",
    "ITEM_DANGERCRIT_NAME": "The New Lopper",
    "ITEM_DANGERCRIT_PICKUP": "Massively increase 'Critical Strike' damage at low health.",
    "ITEM_DANGERCRIT_DESCRIPTION": "Gain <style=cIsDamage>20% critical chance.</style> Falling below <style=cIsHealth>50% health</style> sends you into a rampage, increasing <style=cIsDamage>critical strike damage by 250%</style> <style=cStack>(+250% per stack)</style>, and <style=cIsDamage>critical strike chance by 30%</style>. Killing enemies <style=cIsDamage>extends</style> the rampage for <style=cIsDamage>4.0 seconds</style>.",
    "ITEM_DANGERCRIT_LORE": "Name: [REDACTED]\r\nDate of birth: June 21st, 1961\r\nOccupation: Executioner\r\n\r\nTime of death: August 23rd, 2058\r\nLocation of death: [REDACTED], Mercury\r\nCause of death: Severe blood loss due to bodily mutilation\r\n\r\nNotes:\r\nAn axe in pristine condition was found next to the body. Examination determined the weapon to be highly resistant to both wear and stains, particularly of blood. The axe’s construction is consistent with a smith on Sues Drive, Jupiter, that [REDACTED] was in contact with shortly before his death. \r\n\r\n[REDACTED] committed 126 known homicides in the hour preceding his death. Every victim was killed by decapitation and had no other wounds. Witnesses report [REDACTED] accidentally struck himself and bisected his body at the waist, bleeding to death moments later. \r\n\r\nAutopsy reveals degradation of internal organs predating [REDACTED]’s death. Symptoms appear to be consistent with certain strains of [REDACTED] found on Jupiter. No degradation was found in the brain, however it is possible that the illness influenced his mental state.\r\n",
    "ITEM_GOODEXECUTIONITEM_NAME": "Permafrost",
    "ITEM_GOODEXECUTIONITEM_PICKUP": "Chance to Freeze enemies on heavy hits, instantly killing them at low health.",
    "ITEM_GOODEXECUTIONITEM_DESCRIPTION": "<style=cIsDamage>3.0%</style> <style=cStack>(+2.0% per stack)</style> chance on hit <style=cIsDamage>per % of enemy maximum health dealt in damage</style> to <style=cIsUtility>Freeze</style> enemies in place for <style=cIsUtility>1.5 seconds. </style>Frozen enemies are <style=cIsHealth>instantly killed</style> at low health.",
    "ITEM_PHOTOGRAPH_NAME": "Photograph",
    "ITEM_PHOTOGRAPH_PICKUP": "Printing items increases critical strike chance and damage. Resets at the start of each stage.",
    "ITEM_PHOTOGRAPH_DESCRIPTION": "Spending items at any printer increases <style=cIsDamage>critical strike chance</style> and <style=cIsDamage>critical strike damage</style> by <style=cIsDamage>+10.0%</style> <style=cStack>(+5.0% per stack)</style>, up to <style=cIsUtility>3 times</style> <style=cStack>(+0 per stack)</style>. Resets at the start of each stage.",
    "ITEM_PHOTOGRAPH_LORE": "Did you get your photos printed?\n\n\"Bogos binted?\"\n\nHuh?\n\n\"Download GreenAlienHead\"",
    "ITEM_CHARGEDMALACHITESPINE_NAME": "Charged Malachite Spine",
    "ITEM_CHARGEDMALACHITESPINE_PICKUP": "Poison yourself when shields are broken, gaining great damage resistence.",
    "ITEM_CHARGEDMALACHITESPINE_DESCRIPTION": "Gain <style=cIsHealing>50.0 shield</style> <style=cStack>(+50.0 per stack)</style>. While poisoned, gain <style=cIsHealing>200.0 armor</style>. <style=cIsHealth>Poison is inflicted for 5.0 seconds on shield break</style> <style=cStack>(+5.0 seconds per stack)</style>.",
    "ITEM_WISHBONE_NAME": "Wishbone",
    "ITEM_WISHBONE_PICKUP": "Breaks during storms. If taken to the Teleporter, a wish will be granted.",
    "ITEM_WISHBONE_DESCRIPTION": "Breaks during storms. If taken to the Teleporter, a wish will be granted.",
    "ITEM_WISHBONE_LORE": "loooorrrrreeeeeeee",
    "ITEM_RANDOMBARRIERTARGET_NAME": "Crystal Ball",
    "ITEM_RANDOMBARRIERTARGET_PICKUP": "Highlights a nearby enemy. Gain barrier and critical strike chance on hit.",
    "ITEM_RANDOMBARRIERTARGET_DESCRIPTION": "Reduce barrier decay by <style=cIsHealing>-20%</style>. <style=cIsDamage>Highlights</style> a random enemy. Attacking the targeted enemy grants a <style=cIsHealing>temporary barrier</style> for <style=cIsHealing>8.0 health</style> <style=cStack>(+8.0 per stack)</style> and increases <style=cIsDamage>critical strike chance</style> by <style=cIsDamage>+20.0%</style> <style=cStack>(+10.0% per stack)</style>.",
    "ITEM_RANDOMBARRIERTARGET_LORE": "Order: Crystal Ball\r\nTracking Number: 66***********\r\nEstimated Delivery: 5/6/2056\r\nShipping Method:  Return\r\nShipping Address: Arcane Suppliers Inc., The Floating Citadel, Neptune\r\nShipping Details:\r\n\r\nI ordered this Omen Globe from you guys, and oh my gods, I am NEVER buying anything from this place again. This is a total fucking SCAM!!! \r\n\r\nI tried for HOURS, for this ball to show me ANYTHING, and never once was I granted a moment of divine clairvoyance. \r\n\r\nAnd believe me, I KNOW I'm enlightened, I'm WAY MORe enlightened than any of you DAMN WEASELS at Arcane SCAMMERS. Don't fucking tell me I'm not enlightened enough. \r\n\r\nYour crystal, or should I say plastic, ball cost me more than my ENTIRE life savings. I DEMAND MY MONEY BACK, OR YOU WILL FACE DIRE CONSEQUENCES!!!",
    "ITEM_SHIELDAMP_NAME": "Snapping Stone",
    "ITEM_SHIELDAMP_PICKUP": "While shields are full, your next attack drains a small amount of shield for amplified damage.",
    "ITEM_SHIELDAMP_DESCRIPTION": "Gain <style=cIsHealing>40 shield</style>. While shields are full, <style=cIsDamage>amplify</style> damage from skills. <style=cIsDamage>Amplified</style> hits <style=cIsDamage>drain 40%</style> of your max shield <style=cStack>(-8% per stack)</style>, dealing <style=cIsDamage>+400% BASE damage</style> <style=cStack>(+250% per stack)</style>. Amplified damage spreads to <style=cIsDamage>2</style> nearby enemies.",
    "ITEM_STARVEIL_NAME": "Star Veil",
    "ITEM_STARVEIL_PICKUP": "Taking damage causes you to become invincible... <style=cIsHealth>BUT meteors will fall nearby, hurting both enemies and allies.</style>",
    "ITEM_STARVEIL_DESCRIPTION": "After getting hit, become <style=cIsUtility>invincible to all incoming damage</style> for 0.33 <style=cStack>(+0.33 per stack)</style> seconds. Then, cause 3 <style=cStack>(+2 per stack)</style> <style=cIsDamage>waves of meteors</style> to fall from the sky, <style=cIsHealth>damaging ALL characters</style> for <style=cIsDamage>300% damage per blast.</style>",
    "ITEM_STARVEIL_LORE": "ITS ME. I HAVE IT.\r\n\r\nARE YOU EXCITED? ARE YOU SCARED? ARE YOU CONTRITE? ARE YOU DISBELIEVING?\r\n\r\nMURDERER.\r\n\r\nYOU SLEW MY ?????. YOU DESECRATED THEIR FORMS. YOU USED THEIR SOULS TO SLAUGHTER MY ?????. YOU PERFORMED HIDEOUS EXPERIMENTS IN THE NAME OF FALSE GODS. AND THE RESULT GAVE YOU POWER.\r\n\r\nBUT YOU LOST IT.\r\n\r\nAND NOW I HAVE IT. I AM SURROUNDED BY THE SOULS OF MY ????? AND I AM FULL OF VENGEANCE.\r\n\r\nWHAT ARE YOU FULL OF? FEAR AND REGRET?\r\n\r\nWHERE IS YOUR “INVINCIBILITY” NOW? WHERE IS YOUR “GOD SLAYING POWER?” WHERE ARE YOUR “STARS?”\r\n\r\nTHEY ARE WITH ME. YOU ARE SO MUCH MORE THAN A MURDERER. YOU ARE A FOOL. IMBECILE. LACKWIT. AND YOU WILL COME TO REGRET EVERYTHING YOU HAVE DONE TO ME AND MY ?????.\r\n\r\nBECAUSE I AM COMING FOR YOU. EVERY PATHETIC BLOW YOU GIVE TO ME I WILL USE TO RAIN DEATH UPON EVERYTHING YOU HAVE EVER KNOWN.\r\n\r\nWHAT WILL YOU DO? YOUR FALSE GODS WILL NOT ANSWER PRAYER. THERE IS NOTHING YOU CAN DO. IF YOU RUN I WILL ONLY BE ANGRIER.\r\n\r\nI WILL BE THERE SOON. YOU WILL NOT HAVE TO DESPAIR FOR LONG.\r\n\r\nTHE SOULS OF MY ????? WILL DRINK YOUR SCREAMS LIKE NECTAR.",
    "ITEM_UTILITYBARRIER_NAME": "Utility Knife",
    "ITEM_UTILITYBARRIER_PICKUP": "Casting your Utility skill grants a temporary barrier.",
    "ITEM_UTILITYBARRIER_DESCRIPTION": "Activating your <style=cIsUtility>Utility skill</style> also grants you a <style=cIsHealing>temporary barrier</style> for <style=cIsHealing>3%</style> of your maximum health <style=cStack>(+1.5% per stack)</style> per second of the skill's <style=cIsUtility>base cooldown</style>.",
    "ITEM_VOIDLASERTURBINE_NAME": "Super Solenoid Engine",
    "ITEM_VOIDLASERTURBINE_PICKUP": "Using skills charges a devastating laser primary attack. <style=cIsVoid>Corrupts all Brilliant Behemoths and Resonance Discs.</style>",
    "ITEM_VOIDLASERTURBINE_DESCRIPTION": "Using your skills builds charge. After 90 seconds worth of charge has accumulated, prime 1 use <style=cStack>(+1 per stack)</style> of <style=cIsVoid>Heaven-Piercer</style>, replacing your Primary attack. Firing <style=cIsVoid>Heaven-Piercer</style> deals <style=cIsDamage>3200% damage</style>, piercing ALL enemies and terrain. <style=cIsVoid>Corrupts all Brilliant Behemoths and Resonance Discs.</style>",
    "ITEM_VOIDUTILITYBELT_NAME": "Mobius Stream",
    "ITEM_VOIDUTILITYBELT_PICKUP": "Casting your Utility skill grants an additional burst of movement speed. <style=cIsVoid>Corrupts all Utility Knives.</style>",
    "ITEM_VOIDUTILITYBELT_DESCRIPTION": "Activating your <style=cIsUtility>Utility skill</style> also increases your <style=cIsUtility>movement speed</style> by <style=cIsUtility>4%</style> <style=cStack>(+4% per stack)</style> per second of the skill's <style=cIsUtility>base cooldown</style>. Lasts for <style=cIsUtility>2.5 seconds</style>. <style=cIsVoid>Corrupts all Utility Knives.</style>",
    "ITEM_CUCKLER_NAME": "Cobalt Shield",
    "ITEM_CUCKLER_PICKUP": "Negate all knockback. Reduce incoming damage and gain barrier while stationary.",
    "ITEM_CUCKLER_DESCRIPTION": "Negates <style=cIsUtility>ALL knockback</style>. Increase <style=cIsHealing>armor</style> by <style=cIsHealing>20</style> <style=cStack>(+20 per stack)</style> and <style=cIsHealing>barrier generation</style> by <style=cIsHealing>6 hp/s</style> <style=cStack>(+6 hp/s per stack)</style>. While stationary, these effects are <style=cIsUtility>quintupled</style>.",
    "ITEM_CUCKLER_LORE": "<style=cIsHealth>I cannot let you enter until you free me of my curse.</style>",
    "ITEM_ECONOMYWEAPON_NAME": "Coin Gun",
    "ITEM_ECONOMYWEAPON_PICKUP": "Deal bonus damage for each chest you can afford.",
    "ITEM_ECONOMYWEAPON_DESCRIPTION": "Begin each stage with <style=cIsUtility>$25</style>. While holding <style=cIsUtility>$25 or more</style>, deal <style=cIsDamage>20% bonus damage</style> <style=cStack>(+20% per stack)</style>, plus <style=cIsDamage>4%</style> <style=cStack>(+4% per stack)</style> per <style=cIsUtility>additional $25 held</style>, for up to a maximum of <style=cIsUtility>10 times</style>.",
    "ITEM_ECONOMYWEAPON_LORE": "Man, this thing is so cool. B-zap! Haha.\r\n\r\nHey. Dude. Check this out.\r\n\r\nWhat the hell is that thing?\r\n\r\nNo. Watch this.\r\n\r\n…Huh? That sucks.\r\n\r\nListen, dude. TWO. MONEY. GUNS.\r\n\r\nYou're an idiot. This one charges using gold. That one shoots gold. What happens if you shoot all our gold, Cooper? We can't charge our guns.\r\n\r\nIt's fine, dude. The monsters on this planet are loaded. Look at all this!\r\n\r\n…Huh. What is that thing?\r\n\r\nIt's this, like, hat thing I found? It attracts money or something. If we survive this we're gonna be rich.\r\n\r\nYou've gotta stop picking up those things. They've all tried to kill us at some point.\r\n\r\nNot this one, dude. Look- oops. Ow.\r\n\r\nUh.\r\n\r\nWhat?\r\n\r\nWhat happened to all of our gold?",
    "ITEM_CRITRETALIATE_NAME": "Destroyer Emblem",
    "ITEM_CRITRETALIATE_PICKUP": "Critically strike after taking damage.",
    "ITEM_CRITRETALIATE_DESCRIPTION": "After getting hit, gain a <style=cIsDamage>100.0%</style> chance to <style=cIsDamage>Critically Strike</style>, fading over <style=cIsDamage>3.0 seconds</style> <style=cStack>(+1.5 per stack)</style>.",
    "ITEM_FLOWERCROWN_NAME": "Flower Crown",
    "ITEM_FLOWERCROWN_PICKUP": "Increases your maximum health.",
    "ITEM_FLOWERCROWN_DESCRIPTION": "Increases <style=cIsHealing>maximum health</style> by <style=cIsHealing>12%</style> <style=cStack>(+12% per stack)</style>.",
    "ITEM_FLOWERCROWN_LORE": "Order: Flower Crown\r\nTracking Number: 10***********\r\nEstimated Delivery: 11/02/2056\r\nShipping Method:  Priority/Fragile\r\nShipping Address: Floor 16, Spiral Gardens, Earth\r\nShipping Details:\r\n\r\nThank you for always sending us gifts. I made some of them into this flower crown for you. Wearing it makes me feel strong, like nothing can get me down. Hopefully it does the same for you! <3\r\n",
    "ITEM_BORBOMOLOTOV_NAME": "Molotov (1-Pack)",
    "ITEM_BORBOMOLOTOV_PICKUP": "Chance on hit to lob a flaming molotov.",
    "ITEM_BORBOMOLOTOV_DESCRIPTION": "<style=cIsDamage>9.0%</style> chance on hit to lob a <style=cIsDamage>molotov cocktail</style> that <style=cIsDamage>ignites</style> enemies for <style=cIsDamage>60%</style> <style=cStack>(+60% per stack)</style> TOTAL damage and leaves a <style=cIsDamage>burning</style> area for <style=cIsDamage>30%</style> <style=cStack>(+30% per stack)</style> TOTAL damage per second.",
    "ITEM_BORBOMOLOTOV_LORE": "Order: Ethanol Bottle (32 oz.), 6 Pack\r\nTracking Number: 81******\r\nEstimated Delivery: 05/8/2058\r\nShipping Method: Priority\r\nShipping Address: Teromere Manor, Privet Road, Mars\nShipping Details: Let our friends inside know that we're coming over for drinks on the 16th of June. It'll be a hell of a party, they should probably hit the road before things get too out of hand.",
    "ITEM_SLUNGUS_NAME": "Slumbering Spores",
    "ITEM_SLUNGUS_PICKUP": "Standing still shelters you, slowing nearby enemies and projectiles. Move faster until hit.",
    "ITEM_SLUNGUS_DESCRIPTION": "While stationary, create a sheltering <style=cIsUtility>stasis field</style> reaching 24.0m around you, <style=cIsUtility>slowing</style> nearby enemes and projectiles by <style=cIsUtility>80%</style>. Move 20% faster <style=cStack>(30% per stack) until the next time you get hit.",
    "ITEM_SLUNGUS_LORE": "Order: Lay-Z Mushroom Travel Buddy\r\nTracking Number: 58***********\r\nEstimated Delivery: 09/23/2056\r\nShipping Method:  Priority/Biological\r\nShipping Address: 444 Slate Drive, Mars\r\nShipping Details:\r\n\r\nThank you for your purchase!\r\n\r\nDirections:\r\nTurn nozzle to ‘open’. Spores will disperse into the air, causing time to warp and pass slower, thus shortening your wait as the rest of reality will be experiencing time faster. It may take some time for the warping effects to occur; leave the spore bottle in one area to maximize spore count. If traveling in a small enclosed space, the spores may eventually fill the entire area. Ventilate regularly to prevent oversaturation.\r\nTo end time warp effect, close nozzle and leave or ventilate the affected area. Always close nozzle before leaving affected area; partial bodily exposure to time warpage may have unwanted effects.\r\nNote- you may experience time normally for several seconds or minutes after the warping begins; this is normal. Simply wait for time to slow for you too (the slow-moving objects will resume their normal speed and unaffected objects will appear to speed up) and then happy waiting!\r\n\r\nWarnings:\r\nObjects appear to move slower, but carry the same force as they would normally. Do not interact with normally fast moving or forceful objects in an unsafe manner.\r\nThe affected area experiences lowered temperature; you may want to wear warm clothes or turn your heater up. Thermometers do not accurately measure temperature in affected area; assume practical temperatures to be up to 50 degrees lower than measured.\r\n<style=cIsHealth>Do not open bottle. Handle with extreme care. Ventilate regularly.</style>\r\n\r\nFUN-GUYS Inc. is not liable for any illness, injury, death, extended or permanent change in time perception, spacial warping, mania or lethargy, hallucination, paranoia, acute panic attack, or otherwise dissatisfactory results. All purchases are final.",
    "ITEM_VOIDHAPPIESTMASK_NAME": "Forgotten Facade",
    "ITEM_VOIDHAPPIESTMASK_PICKUP": "Chance on killing an enemy to summon void infestors. <style=cIsVoid>Corrupts all Happiest Masks.</style>",
    "ITEM_VOIDHAPPIESTMASK_DESCRIPTION": "Killing monsters has a <style=cIsDamage>7.0%</style> chance to spawn 2 <style=cStack>(+1 per stack)</style> <style=cIsDamage>void infestors</style> in their place. <style=cIsVoid>Corrupts all Happiest Masks.</style>",
    "ITEM_ATTACKSPEEDHELPER_NAME": "AttackspeedHelper",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_NAME": "Lunar Gallery",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_CONTEXT": "eat my transgendence nerd",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_NAME": "Decayed Construct",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_CONTEXT": "Kick the Construct",
    "2R4R_INTERACTABLE_EGG_PILE_NAME": "Egg",
    "2R4R_INTERACTABLE_EGG_PILE_CONTEXT": "Found an egg",
    "2R4R_INTERACTABLE_FLOWERBLOOM_NAME": "Oh...?",
    "2R4R_INTERACTABLE_FLOWERBLOOM_CONTEXT": "It's pretty, oh so pretty...",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_NAME": "Shrine of Convergence",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_CONTEXT": "Pray to the Shrine of Convergence",
    "2R4R_INTERACTABLE_VOID_HUSK_NAME": "Fractured Husk",
    "2R4R_INTERACTABLE_VOID_HUSK_CONTEXT": "Break open",
    "2R4R_INTERACTABLE_WISHBONECARCASS_NAME": "Omen",
    "2R4R_INTERACTABLE_WISHBONECARCASS_CONTEXT": "Break Omen",
    "EQUIPMENT_BROKENZAPINATOR_NAME": "Orange Zapinator",
    "EQUIPMENT_BROKENZAPINATOR_PICKUP": "<style=cIsUtility>I can't believe we left this in the game!</style>",
    "EQUIPMENT_BROKENZAPINATOR_DESCRIPTION": "Fires a projectile.",
    "EQUIPMENT_NINJAGEAR_NAME": "Master Ninja Gear",
    "EQUIPMENT_NINJAGEAR_PICKUP": "Have a chance to dodge incoming attacks. Activate to dash and drop a smoke bomb.",
    "EQUIPMENT_NINJAGEAR_DESCRIPTION": "Activate to <style=cIsUtility>dash forward 25m</style>, and gain a <style=cIsHealing>20% chance</style> to <style=cIsHealing>dodge</style> incoming attacks. Dashing and dodging will drop a <style=cIsDamage>smoke bomb</style>, <style=cIsUtility>stunning enemies</style> within 13m for <style=cIsUtility>1 second</style>.",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_NAME": "Stillborn Prayer",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_PICKUP": "Grants a single wish...",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_DESCRIPTION": "Grants an Uncommon item of your choice.",
    "EQUIPMENT_THEMACHINE_NAME": "The Machine",
    "EQUIPMENT_THEMACHINE_PICKUP": "It doesn't do anything. That's the beauty of it!",
    "EQUIPMENT_THEMACHINE_DESCRIPTION": "It doesn't do anything. That's the beauty of it!",
    "EQUIPMENT_TESLAEQUIPMENT_NAME": "Remarkably Stable Tesla Coil",
    "EQUIPMENT_TESLAEQUIPMENT_PICKUP": "Zap nearby enemies and restore Shields on kill.",
    "EQUIPMENT_TESLAEQUIPMENT_DESCRIPTION": "<style=cIsUtility>Electrify</style> yourself for <style=cIsUtility>10.0 seconds</style>. Kills while <style=cIsUtility>Electrified</style> will zap <style=cIsDamage>4.0</style> nearby enemies for <style=cIsDamage>200% damage</style> and <style=cIsHealing>restore 15% of your shields</style>. Passively gain a <style=cIsHealing>shield</style> equal to <style=cIsHealing>20% of your maximum health</style>.",
    "EQUIPMENT_TESLAEQUIPMENT_LORE": "<style=cMono>Tesla Presentation Software v1.14\nPowering on...\n10...</style>\nIssuing welcome statement...\n<style=cMono>9...</style>\nWelcome one and all!\n<style=cMono>8...</style>\nPlease take a seat.\n<style=cMono>7...</style>\nMake sure those behind you can see.\n<style=cMono>6...</style>\nThe presentation will start shortly.\n<style=cMono>5...</style>\nPlease obey the staff for your safety.\n<style=cMono>4...\nInitiating room mood lighting...\n3...</style>\nGet ready to behold...\n<style=cMono>2...</style>\nThe marvelous wonders...\n<style=cMono>1...</style>\nOf electricity!\n<style=cMono>Power anomaly detected...\nInitiating reboot procedure in 10.0...</style>",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_NAME": "Chir’s Tempo",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_PICKUP": "Become an aspect of velocity.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_DESCRIPTION": "Increase movement, attack, and ability recharge speed.",
    "BORBO_ELITE_AFFIX_SPEED_MODIFIER": "Hallowed {0}",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_NAME": "Fractured Belief",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_PICKUP": "Become an aspect of vanity.",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_DESCRIPTION": "Become an aspect of vanity.",
    "BORBO_ELITE_MIRRORED_MODIFIER": "Mirrored {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_NAME": "N’Kuhana’s Concession",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_PICKUP": "Become an aspect of eternity.",
    "BORBO_ELITE_AFFIX_LEECH_MODIFIER": "Serpentine {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_NAME": "Abyssal gaze",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_PICKUP": "Become an aspect of the simulacrum",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_DESCRIPTION": "Some stats up idk, lol",
    "BORBO_ELITE_AFFIX_SIMULATED_MODIFIER": "Simulated {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_NAME": "Bava’s Refrain",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_PICKUP": "Become an aspect of force.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_DESCRIPTION": "All attacks are explosive. Periodically fire a mortar.",
    "BORBO_ELITE_AFFIX_EXPLOSIVE_MODIFIER": "Volatile {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_NAME": "A Dormant Force",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_PICKUP": "Become an aspect of flood.",
    "BORBO_ELITE_AFFIX_FLOOD_MODIFIER": "Surging {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_NAME": "Twisted Stare",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_PICKUP": "Become an aspect of squall.",
    "BORBO_ELITE_AFFIX_SQUALL_MODIFIER": "Howling {0}",
    "ARTIFACT_AWESOMEPOT_NAME": "Artifact of Volatility",
    "ARTIFACT_AWESOMEPOT_DESCRIPTION": "Explosive barrels and pots are Elite.",
    "ARTIFACT_FREELUNAR_NAME": "Artifact of the Zealot",
    "ARTIFACT_FREELUNAR_DESCRIPTION": "Begin each run with a random lunar. At the end of each stage, a blue portal always appears.",
    "ARTIFACT_QUICKSTART_NAME": "Artifact of the Stillborn",
    "ARTIFACT_QUICKSTART_DESCRIPTION": "Begin your run with an Uncommon item of your choice.",
    "ARTIFACT_RISKIERRAINSPIRIT_NAME": "Artifact of Spirit",
    "ARTIFACT_RISKIERRAINSPIRIT_DESCRIPTION": "Characters run and attack faster at lower health.",
    "ITEM_BARRIERONOVERHEAL_NAME": "Aegis",
    "ITEM_BARRIERONOVERHEAL_PICKUP": "Gain barrier on any interaction. While out of danger, barrier stops decaying.",
    "ITEM_BARRIERONOVERHEAL_DESC": "Using any interactable grants a <style=cIsHealing>temporary barrier</style> for <style=cIsHealing>40.0 health</style> <style=cStack>(+40.0 per stack)</style> plus an additional <style=cIsHealing>10.0%</style> of <style=cIsHealing>maximum health</style>. While outside of danger, <style=cIsUtility>barrier will not decay</style>.",
    "ITEM_GOLDONHIT_NAME": "Sunken Crown",
    "ITEM_GOLDONHIT_PICKUP": "Steal from chests... <style=cIsHealth>at the cost of health.</style>",
    "ITEM_GOLDONHIT_DESC": "Allows interacting with chests without the ability to afford them, opening the chest <style=cIsUtility>without spending ANY money</style>. Stealing from chests costs <style=cIsHealth>[ 25% / 50% / 80% ]</style> of your <style=cIsHealth>maximum health</style>, depending on the size of the chest. Can steal up to 1 <style=cStack>(+1 per stack)</style> times per stage.",
    "ITEM_REGENERATINGSCRAP_NAME": "Chimera Scrap",
    "ITEM_REGENERATINGSCRAP_PICKUP": "Prioritized when used with <style=cIsHealth>ANY</style> 3D Printer. Produces extra items of lower tiers.",
    "ITEM_REGENERATINGSCRAP_DESC": "Does nothing. Prioritized when used with <style=cIsHealth>ANY</style> 3D Printer. Creates <style=cStack>(</style> 10 <style=cStack>/</style> <style=cIsHealing>5</style> <style=cStack>/</style> <style=cIsHealth>2</style> <style=cStack>)</style> items, <style=cIsUtility>depending on the quality of the printer</style>.",
    "ITEM_GOLDONHURT_NAME": "Chocolate Coins",
    "ITEM_GOLDONHURT_PICKUP": "Enemies drop a treat for gold and healing. Recharges over time.",
    "ITEM_GOLDONHURT_DESC": "On hit, drop a chocolate coin that heals for <style=cIsHealing>5.0 health</style> <style=cStack>(+5.0 per stack)</style> plus <style=cIsUtility>1 gold</style> <style=cStack>(+1 per stack)</style>. <style=cIsUtility>Scales over time</style>. <style=cIsUtility>recharges after 5.0 seconds.</style>",
    "ITEM_CRITDAMAGE_NAME": "Combat Telescope",
    "ITEM_CRITDAMAGE_PICKUP": "Increases 'Critical Strike' chance and damage while stationary.",
    "ITEM_CRITDAMAGE_DESC": "<style=cIsDamage>Critical Strikes</style> deal an additional <style=cIsDamage>100% damage</style> <style=cStack>(+100% per stack)</style>. Gain <style=cIsDamage>30% Critical Strike chance</style> after standing still for <style=cIsUtility>0.2</style> seconds.",
    "ITEM_REPEATHEAL_NAME": "Corpsebloom",
    "ITEM_REPEATHEAL_PICKUP": "Your health degenerates over time. Gain barrier and luck at low health.",
    "ITEM_REPEATHEAL_DESC": "For every missing 12.5% of health, gain Rot. After 3 Rot has accumulated, increase base damage by 4 <style=cStack>(+2 per stack)</style>. After 6 Rot, gain 50% barrier and increase Luck by 2 <style=cStack>(+2 per stack)</style>. <style=cIsHealth>Reduce base health regeneration by -2 hp/s</style> <style=cStack>(-2 per stack)</style>.",
    "ITEM_HEALINGPOTION_NAME": "Berserker Brew",
    "ITEM_HEALINGPOTION_PICKUP": "At low health, gain barrier, cleanse debuffs, and reset all cooldowns. Usable once per stage.",
    "ITEM_HEALINGPOTION_DESC": "Taking damage to below <style=cIsHealth>25% health</style> <style=cIsUtility>consumes</style> this item, instantly granting <style=cIsHealing>35%</style> of maximum health in <style=cIsHealing>barrier</style> and <style=cIsUtility>resetting</style> all cooldowns. Each empty bottle increases attack speed by <style=cIsDamage>15%</style>, movement speed by <style=cIsDamage>14%</style>, and reduces cooldowns by <style=cIsDamage>6%</style>. Regenerates at the start of each stage.",
    "EQUIPMENT_MULTISHOPCARD_NAME": "Executive Card",
    "EQUIPMENT_MULTISHOPCARD_PICKUP": "Hack a targeted interactable. Hacked Multishops remain open.",
    "EQUIPMENT_MULTISHOPCARD_DESC": "Target an interactable to <style=cIsUtility>hack</style> it, unlocking its contents for <style=cIsUtility>free</style>. If the target is a <style=cIsUtility>multishop</style> terminal, the other terminals will <style=cIsUtility>remain open</style>.",
    "ITEM_AUTOCASTEQUIPMENT_NAME": "Gesture of the Drowned",
    "ITEM_AUTOCASTEQUIPMENT_PICKUP": "Greatly increase equipment stock... <style=cIsHealth>BUT greatly increase equipment cooldown.</style> Equipments can be activated during their cooldown, <style=cIsHealth>with a chance to break.</style>",
    "ITEM_AUTOCASTEQUIPMENT_DESC": "Hold <style=cIsUtility>4 additional equipment charges</style> <style=cStack>(+2 per stack)</style>... <style=cIsHealth>BUT increase equipment cooldown by +100%</style> <style=cStack>(+50% per stack)</style>. Using your equipment without charges <style=cIsUtility>under-casts</style> it, allowing it to be used <style=cIsHealth>with a 40.0% chance to break</style>. <style=cIsUtility>Unaffected by luck.</style>",
    "ITEM_BONUSGOLDPACKONKILL_NAME": "Ghors Tome",
    "ITEM_BONUSGOLDPACKONKILL_PICKUP": "Transmutate elites into gold on contact.",
    "ITEM_BONUSGOLDPACKONKILL_DESC": "Deal +100% damage to Gilded elites. Contacting any Elite enemy instantly transmutates it into a Gilded elite, triggering all on-kill effects. Does not affect Boss enemies.",
    "ITEM_SEED_NAME": "Leeching Seed",
    "ITEM_FLATHEALTH_NAME": "Fresh Meat",
    "ITEM_FLATHEALTH_PICKUP": "Gain flat HP. Regenerate health after killing an enemy.",
    "ITEM_FLATHEALTH_DESC": "Gain 25<style=cStack>(+25s per stack)</style> health. Increases <style=cIsHealing>base health regeneration</style> by <style=cIsHealing>+2 hp/s</style> for <style=cIsUtility>3s</style> <style=cStack>(+3s per stack)</style> after killing an enemy.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_NAME": "Morning Mocha",
    "ITEM_ATTACKSPEEDANDMOVESPEED_PICKUP": "Gain a temporary speed boost after beginning a stage.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_DESC": "For <style=cIsUtility>80</style> seconds after entering any stage, increase <style=cIsDamage>attack</style> and <style=cIsDamage>movement speed</style> by <style=cIsDamage>20%</style> <style=cStack>(+20% per stack)</style>, and reduce <style=cIsUtility>skill cooldowns</style> by <style=cIsUtility>-12%</style> <style=cStack>(-12% per stack)</style>. Activating an interactable extends the buff by <style=cIsUtility>20 seconds</style>.",
    "ITEM_EXTRASTATSONLEVELUP_NAME": "Prayer Beads",
    "ITEM_EXTRASTATSONLEVELUP_PICKUP": "Prioritized when used with <style=cIsHealing>Uncommon</style> 3D Printers. Permanently increase ALL stats after removal.",
    "ITEM_EXTRASTATSONLEVELUP_DESC": "Prioritized when used with <style=cIsHealing>Uncommon</style> 3D Printers. After removal, permanently grants a 7% increase to <style=cIsUtility>experience gain</style>, <style=cIsHealing>health</style>, <style=cIsHealing>shield</style>, <style=cIsHealing>regeneration</style>, and <style=cIsDamage>damage</style>.",
    "ITEM_THORNS_NAME": "Razorwire",
    "ITEM_THORNS_PICKUP": "Retaliate in a burst of bleeding razors on taking damage. Recharges over time.",
    "ITEM_THORNS_DESC": "Getting hit causes you to explode in a burst of razors, <style=cIsDamage>bleeding</style> up to <style=cIsDamage>5.0</style> <style=cStack>(+2.0 per stack)</style> nearby enemies for <style=cIsDamage>400%</style> base damage per <style=cIsDamage>razor charge</style> expelled. You can hold up to 2 <style=cStack>(+1 per stack)</style> razor charges, all reloading over <style=cIsUtility>5.0</style> seconds.",
    "ITEM_INCREASEHEALING_NAME": "Rejuvenation Rack",
    "ITEM_INCREASEHEALING_PICKUP": "Stores overheal for later.",
    "ITEM_INCREASEHEALING_DESC": "Healing past full will <style=cIsHealing>store the excess</style> in a <style=cIsHealing>healing reserve</style> at <style=cIsHealing>50%</style> <style=cStack>(+50% per stack)</style> efficiency, up to <style=cIsHealing>30%</style> <style=cStack>(+0% per stack)</style> of your maximum health. When injured, heal for <style=cIsHealing>10%</style> of your <style=cIsHealing>health per second</style>, drawing from the <style=cIsHealing>healing reserve</style> until it is empty.",
    "ITEM_LASERTURBINE_NAME": "Resonance Disc",
    "ITEM_LASERTURBINE_PICKUP": "Obtain a Resonance Disc charged by killing enemies. Fires automatically when fully charged.",
    "ITEM_LASERTURBINE_DESC": "Killing enemies charges the Resonance Disc. The disc launches itself toward a target for <style=cIsDamage>300%</style> base damage <style=cStack>(+300% per stack)</style>, piercing all enemies it doesn't kill, and then explodes for <style=cIsDamage>1000%</style> base damage <style=cStack>(+1000% per stack)</style>. Then returns to the user, striking all enemies along the way for <style=cIsDamage>300%</style> base damage <style=cStack>(+300% per stack)</style>.",
    "ITEM_SQUIDTURRET_NAME": "Squid Polyp",
    "ITEM_PARENTEGG_NAME": "Planula",
    "ITEM_PARENTEGG_PICKUP": "THE UNMATCHED POWER OF THE SUN!",
    "ITEM_PARENTEGG_DESC": "After beginning the teleporter event, <style=cIsDamage>summon a sun overhead</style> that lasts for <style=cIsDamage>10.0</style> seconds <style=cStack>(+5.0 per stack)</style>. <style=cIsHealth>All enemies and allies burn near the sun</style>.",
    "ITEM_FOCUSEDCONVERGENCE_NAME": "Focused Convergence",
    "ITEM_FOCUSEDCONVERGENCE_DESC": "Holdout Zones charge <style=cIsUtility>100% <style=cStack>(+100% per stack)</style> faster</style>, but are <style=cIsHealth>50% smaller</style> <style=cStack>(-50% per stack)</style>. Max of 5.",
    "ITEM_GHOSTONKILL_NAME": "Happiest Mask",
    "ITEM_GHOSTONKILL_PICKUP": "Haunt nearby enemies, marking them for execution. Executing enemies summons a ghost.",
    "ITEM_GHOSTONKILL_DESC": "<style=cIsDamage>Haunt</style> a random non-boss enemy, marking them for Execution below <style=cIsHealth>25%</style> health. Execution <style=cIsDamage>spawns a ghost</style> of the killed enemy with <style=cIsDamage>1500%</style> damage, lasting for <style=cIsDamage>6.66s</style> <style=cStack>(+6.66s per stack)</style> <style=cIsUtility>(double for Haunted enemies)</style>.",
    "ITEM_MOVESPEEDONKILL_NAME": "Hunter’s Harpoon",
    "ITEM_MOVESPEEDONKILL_DESC": "Killing an enemy increases <style=cIsUtility>movement speed</style> by <style=cIsUtility>125%</style> for <style=cIsUtility>1</style> <style=cStack>(+1 per stack)</style> seconds. Consecutive kills increase buff duration to up to 25 seconds.",
    "ITEM_STRENGTHENBURN_PICKUP": "Your ignite effects deal triple damage.",
    "ITEM_STRENGTHENBURN_DESC": "Gain <style=cIsDamage>15% ignite chance</style>. All ignition effects deal <style=cIsDamage>+200%</style> <style=cStack>(+200% per stack)</style> more damage and last <style=cIsUtility>+200%</style> <style=cStack>(+200% per stack)</style> longer.",
    "DIFFICULTYSWANSONG_NAME": "Extinction",
    "DIFFICULTYSWANSONG_DESC": "For only the determined and truly masochistic.\nThe planet is alive and writhing with unspeakable hatred for what has been done to it. You, the subject of its fury, will be torn asunder and be made unrecognizable. <style=cStack>\n\n>Player Health Regeneration: <style=cArtifact>-40%</style></style> <style=cStack>\n>Difficulty Scaling: <style=cArtifact>+100%</style><style=cStack>\n>Starting Difficulty: <style=cArtifact>Very Hard</style></style>\n>Rare Elites: <style=cArtifact>Stage 4</style>\n>Teleporter Visuals: <style=cArtifact>OFF</style>\n>Enemies gain <style=cArtifact>enhanced scaling</style>\n>Enemies gain <style=cArtifact>tripled projectiles</style></style>",
    "EXPANSION2R4R_NAME": "Swan Song",
    "EXPANSION2R4R_DESCRIPTION": "Adds content from the 'Swan Song' expansion to the game.",
    "PLAYER_DEATH_QUOTE_SWANSONG_0": "{0} went KA-BOOM.",
    "PLAYER_DEATH_QUOTE_SWANSONG_0_2P": "RIPMGSGHBAB.",
    "PLAYER_DEATH_QUOTE_SWANSONG_1": "{0} has made a poor balancing decision.",
    "PLAYER_DEATH_QUOTE_SWANSONG_1_2P": "You have made a poor balancing decision.",
    "PLAYER_DEATH_QUOTE_SWANSONG_2": "{0} was splatted.",
