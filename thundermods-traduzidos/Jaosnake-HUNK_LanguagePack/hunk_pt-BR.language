        "PRIMARY_CQC_NAME": "CQC",
        "PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Saque.</style> <style=cIsDamage>Golpeie</style> combatentes corpo a corpo para <style=cIsDamage>200% e 250% de dano</style>, infligindo <style=cIsHealth>Mutilado</style>.",
        "SECONDARY_AIM_NAME": "Mirar Firme",
        "SECONDARY_AIM_DESCRIPTION": "<style=cIsUtility>Mire</style> para melhorar a precisão da sua arma atual.",
        "UTILITY_PARRY_NAME": "Aparição",
        "UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Apare</style> para desviar de ataques. Se usada preventivamente para <style=cIsUtility>evitar um ataque</style>, realize uma <style=cIsDamage>Esquiva Perfeita</style>.",
        "UTILITY_DODGE_NAME": "Deslize",
        "UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Deslize</style> uma curta distância. Se usado preventivamente para <style=cIsUtility>evitar um ataque</style>, realize uma <style=cIsDamage>Esquiva Perfeita</style>.",
        "UTILITY_BASH_NAME": "Deflexão",
        "UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Deflita</style> inimigos próximos, <style=cIsUtility>atordoando-os</style> para <style=cIsDamage>400% de dano</style>. Se usado preventivamente para <style=cIsUtility>cancelar um ataque</style>, realize uma <style=cIsDamage>Deflexão Perfeita</style>.",
        "SPECIAL_SWAP_NAME": "Legion",
        "SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Troque</style> sua arma atual.",
        "ROB_HUNK_KEYWORD_MANGLED": "<style=cKeywordName>Mutilado</style><style=cSub>Ao atingir 6 acúmulos deste efeito, os inimigos sofrem instantaneamente <style=cIsDamage>2200% de dano</style>.</style>",
        "ROB_HUNK_KEYWORD_COUNTERATTACK": "Contra-ataque",
        "ROB_HUNK_KEYWORD_PERFECTDODGE": "<style=cKeywordName>Esquiva Perfeita</style><style=cSub><style=cIsUtility>Recupera o tempo de recarga</style> e concede invulnerabilidade por um breve período. Permite realizar um <style=cIsDamage>contra-ataque</style>.</style>",
        "ROB_HUNK_KEYWORD_PERFECTBASH": "<style=cKeywordName>Deflexão Perfeita</style><style=cSub><style=cIsUtility>Recupera o tempo de recarga</style> e concede invulnerabilidade por um breve período. Permite realizar um <style=cIsDamage>contra-ataque</style>.</style>",
        "ROB_HUNK_KEYWORD_CVIRUS": "<style=cKeywordName>C-vírus</style><style=cSub>Uma vez por fase, vários monstros ficam <color=#FF0033>infectados</color>. Ao morrer, entram em <style=cIsDamage>frenesi</style> por <style=cIsUtility>5</style> segundos e então <style=cIsHealth>explodem</style>; eliminar todos concede uma <color=#FFFF00>amostra do C-vírus</color>.</style>",
        "ROB_HUNK_KEYWORD_LOOTING": "<style=cKeywordName>Saque</style><style=cSub>Inimigos mortos por esta habilidade têm uma pequena chance de deixar munição.</style>",
