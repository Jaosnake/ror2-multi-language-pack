    "BASTIAN_UTIL": "Nano-Salto",
    "BASTIAN_UTIL_DESCRIPTION": "Rapide impetu en ajna direkto, miregigante malamikojn survoje.",
    "BASTIAN_SPEC": "Eksplodo de la Arkitekto",
    "BASTIAN_SPEC_DESCRIPTION": "Elspenu <style=cIsHealth>33% de nuna sano</style> kaj <style=cIsUtility>cxiujn Jonajn Sxargojn</style> por masiva eksplodo de <style=cIsDamage>500%-3000% damagxo</style>. Post uzo, farigxu <color=#E9AFEA>Evada</color> dum 10 sekundoj.",
    "BASTIAN_SPEC_KEYWORD": "<style=cKeywordName>Evada</style><style=cSub>Ricevas 35% da movrapido kaj 20% da regenerado kaj plifortigas viajn kapablojn.</style>",
