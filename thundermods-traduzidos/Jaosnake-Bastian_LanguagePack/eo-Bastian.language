    "BASTIAN_M1": "Jona Svingo",
    "BASTIAN_M1_DESCRIPTION": "Batu per pugno por <style=cIsDamage>250% da damagxo</style> kaj amasigu <style=cIsUtility>jonajn sxargojn</style>. Dum <color=#E9AFEA>evada</color>, la damagxo duonigxas.",
    "BASTIAN_M2": "Mikro-Kuglo",
