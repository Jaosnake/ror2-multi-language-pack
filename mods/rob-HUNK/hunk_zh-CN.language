        "ROB_HUNK_WEAPON_ADDON3_SG09_DESC": "SG-09 R 的定制配件，加装瞄准器以提升远距离射击与命中弱点时的威力。",
        "ROB_HUNK_WEAPON_BROOMHC_NAME": "Broom HC",
        "ROB_HUNK_WEAPON_BROOMHC_DESC": "紧凑的高性能手枪。",
        "ROB_HUNK_WEAPON_MAGNUM_NAME": "闪电鹰",
        "ROB_HUNK_WEAPON_MAGNUM_DESC": "易于操控的高威力马格南手枪。",
        "ROB_HUNK_WEAPON_ADDON_MAGNUM_NAME": "长枪管（闪电鹰）",
        "ROB_HUNK_WEAPON_ADDON_MAGNUM_DESC": "闪电鹰的定制配件，将其伤害提升至 3000%。",
        "ROB_HUNK_WEAPON_ADDON2_MAGNUM_NAME": "激光瞄准器（闪电鹰）",
        "ROB_HUNK_WEAPON_ADDON2_MAGNUM_DESC": "闪电鹰的定制配件，加装瞄准器以提升命中弱点时的威力。",
        "ROB_HUNK_WEAPON_ADDON3_MAGNUM_NAME": "备用弹药（闪电鹰）",
        "ROB_HUNK_WEAPON_ADDON3_MAGNUM_DESC": "闪电鹰的定制配件，大幅增加拾取马格南子弹的数量。",
        "ROB_HUNK_WEAPON_SHOTGUN_NAME": "W-870",
        "ROB_HUNK_WEAPON_SHOTGUN_DESC": "12号口径泵动式霰弹枪。",
        "ROB_HUNK_WEAPON_ADDON_SHOTGUN_NAME": "龙息弹（霰弹枪）",
        "ROB_HUNK_WEAPON_ADDON_SHOTGUN_DESC": "适用于所有霰弹枪的定制配件，将弹药替换为可造成更高伤害并点燃敌人的燃烧弹。",
        "ROB_HUNK_WEAPON_SLUGGER_NAME": "重弹霰弹枪",
        "ROB_HUNK_WEAPON_SLUGGER_DESC": "4发装弹量的12号口径泵动式霰弹枪，发射重型独头弹。",
        "ROB_HUNK_WEAPON_M3_NAME": "M3",
        "ROB_HUNK_WEAPON_M3_DESC": "半自动霰弹枪。",
        "ROB_HUNK_WEAPON_STREET_SWEEPER_NAME": "清道夫",
        "ROB_HUNK_WEAPON_STREET_SWEEPER_DESC": "全自动霰弹枪。",
        "ROB_HUNK_WEAPON_ROCKETLAUNCHER_NAME": "反坦克火箭筒",
        "ROB_HUNK_WEAPON_ROCKETLAUNCHER_DESC": "威力毁天灭地的火箭发射器。",
        "ROB_HUNK_WEAPON_ATM_NAME": "ATM-4",
        "ROB_HUNK_WEAPON_ATM_DESC": "弹药无限的无后坐力火箭发射器，轻便易操控且威力惊人。",
        "ROB_HUNK_WEAPON_ATM2_NAME": "ATM-4 原型",
        "ROB_HUNK_WEAPON_ATM2_DESC": "发射 84mm 弹头的无后坐力火箭发射器，火箭弹的穿甲威力比爆炸本身更具杀伤力。",
        "ROB_HUNK_WEAPON_RPG_NAME": "RPG",
        "ROB_HUNK_WEAPON_RPG_DESC": "威力毁天灭地的火箭发射器。",
        "ROB_HUNK_WEAPON_REVOLVER_NAME": "速射陆军左轮",
        "ROB_HUNK_WEAPON_REVOLVER_DESC": "使用马格南弹药的老式左轮手枪。",
        "ROB_HUNK_WEAPON_ADDON_REVOLVER_NAME": "快速装弹器（速射陆军左轮）",
        "ROB_HUNK_WEAPON_ADDON_REVOLVER_DESC": "速射陆军左轮的定制配件，让你在弹巢打空时能够更快完成装填。",
        "ROB_HUNK_WEAPON_FLAMETHROWER_NAME": "化学火焰喷射器",
        "ROB_HUNK_WEAPON_FLAMETHROWER_DESC": "Umbrella 制造的武器，利用加压气体喷射炽热烈焰。轻便且可补充燃料，随时准备应对持久战。",
        "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_NAME": "调节阀（化学火焰喷射器）",
        "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_DESC": "火焰喷射器的定制配件，限制液态燃料与压缩气体的消耗，可大幅延长喷射时间。",
        "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_NAME": "高能燃料罐（化学火焰喷射器）",
        "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_DESC": "火焰喷射器的定制配件，增强火焰威力并在地面留下烈火路径。",
        "ROB_HUNK_WEAPON_GRENADELAUNCHER_NAME": "GM-79",
        "ROB_HUNK_WEAPON_GRENADELAUNCHER_DESC": "可发射燃烧弹的单发中折式榴弹发射器。",
        "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_NAME": "肩托（GM-79）",
        "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_DESC": "GM-79 的定制配件，大幅降低后坐力并使每发榴弹的弹道更加稳定。",
        "ROB_HUNK_WEAPON_MGL_NAME": "MGL",
        "ROB_HUNK_WEAPON_MGL_DESC": "可发射爆炸榴弹的半自动榴弹发射器原型。",
        "ROB_HUNK_WEAPON_ADDON_MGL_NAME": "翻新弹巢（MGL）",
        "ROB_HUNK_WEAPON_ADDON_MGL_DESC": "MGL 的定制配件，将损坏的弹巢更换为完好部件，使其能够半自动射击。",
        "ROB_HUNK_WEAPON_GOLDGUN_NAME": "黄金手枪",
        "ROB_HUNK_WEAPON_GOLDGUN_DESC": "装弹量 1 发的手枪，仅需一击即可消灭任何目标。",
        "ROB_HUNK_WEAPON_BLUEROSE_NAME": "湛蓝玫瑰",
        "ROB_HUNK_WEAPON_BLUEROSE_DESC": "一把一次发射两发子弹的六发左轮手枪？究竟是哪个疯子想出这种玩意儿的？",
        "ROB_HUNK_WEAPON_AR_NAME": "CQBR",
        "ROB_HUNK_WEAPON_AR_DESC": "可全自动射击的步枪。",
        "ROB_HUNK_WEAPON_ADDON_AR_NAME": "刺刀（CQBR）",
        "ROB_HUNK_WEAPON_ADDON_AR_DESC": "CQBR 的定制配件，替换你的战斗刀并造成 600% 伤害。",
        "ROB_HUNK_WEAPON_RAILGUN_NAME": "铁磁步兵用次世代电磁炮",
        "ROB_HUNK_WEAPON_RAILGUN_DESC": "由康奈尔·加纳与美军联合开发的便携式电磁轨道炮，用于在生化危机爆发时清除生物兵器。",
        "ROB_HUNK_WEAPON_MINIGUN_NAME": "加特林机枪",
        "ROB_HUNK_WEAPON_MINIGUN_DESC": "发射 7.62mm NATO 弹药的六管电动加特林机枪，射速惊人且伤害极高。",
        "ROB_HUNK_WEAPON_COLT_NAME": "柯尔特单动陆军左轮",
        "ROB_HUNK_WEAPON_COLT_DESC": "史上最伟大的手枪。",
        "ROB_HUNK_WEAPON_ADDON_COLT_NAME": "长枪管（柯尔特）",
        "ROB_HUNK_WEAPON_ADDON_COLT_DESC": "柯尔特的定制配件，将其伤害提升至 4800%。",
        "ROB_HUNK_WEAPON_SPARKSHOT_NAME": "电击枪",
        "ROB_HUNK_WEAPON_SPARKSHOT_DESC": "用于实验动物的高压电击枪。充能较慢且电极丝容易断裂，但威力十足。",
        "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_NAME": "高压电容器（电击枪）",
        "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_DESC": "电击枪的定制配件，可储存大量高压电能，缩短射击间隔。",
        "ROB_HUNK_WEAPON_SSG_NAME": "SSG",
        "ROB_HUNK_WEAPON_SSG_DESC": "扩散范围广的紧凑型中折式霰弹枪。",
        "ROB_HUNK_WEAPON_SHIELD_NAME": "防暴盾牌",
        "ROB_HUNK_WEAPON_SHIELD_DESC": "能挡住那该死的狗屁激光。",
        "ROB_HUNK_WEAPON_SCANNER_NAME": "EMF 扫描仪",
        "ROB_HUNK_WEAPON_SCANNER_DESC": "能够定位特定电子设备的仪器。",
        "ROB_HUNK_WEAPON_GRAPPLEGUN_NAME": "钩爪枪",
        "ROB_HUNK_WEAPON_GRAPPLEGUN_DESC": "发射带滑索的抓钩，可将你牵引至任意目标位置。",
