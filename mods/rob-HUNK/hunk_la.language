    "ROB_HUNK_BODY_SHOOT_MINIGUN_NAME": "Ignis",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Iacula pro <style=cIsDamage>2x250% damni</style>. <style=cIsUtility>Damnum cum velocitate impetus crescit.</style>",
    "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Intentio Stabilis",
    "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Intende, <style=cIsUtility>puncta infirma hostium detegens</style>. <style=cIsDamage>Primaria uti dum intendis sclopetum tentum emittit.</style>",
    "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Gradus Celer",
    "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Impelle</style> per breve spatium. Si praecavendo adhibetur ad <style=cIsUtility>impetum evitandum</style>, fac <style=cIsDamage>Evitationem Perfectam</style>.",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Impelle</style> per breve spatium. Si praecavendo adhibetur ad <style=cIsUtility>impetum evitandum</style>, fac <style=cIsDamage>Evitationem Perfectam</style>.\n<color=#d299ff>SCEPTER: Vis Uroboros per te fluit.</color>",
    "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Defensio",
    "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "Impetum <style=cIsUtility>obstrue</style>, damnum <style=cIsDamage>negans</style> et <style=cIsUtility>moram reddens</style>. Si praecavendo adhibetur, fac <style=cIsDamage>Defensionem Perfectam</style>.",
    "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Ictus Umeri",
    "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "Hostes propinquos <style=cIsUtility>impelle</style>, <style=cIsUtility>eos stupefaciens</style> pro <style=cIsDamage>400% damni</style>. Si praecavendo adhibetur ad <style=cIsUtility>impetum interrumpendum</style>, fac <style=cIsDamage>Ictum Perfectum</style>.",
    "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Legio",
    "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Muta</style> ad aliud <style=cIsDamage>sclopetum</style>. Breviter preme ut ad <style=cIsUtility>ultimum sclopetum tentum</style> redeas.",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Culter Militaris",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "Culter militaris ordinarius. Certe utilis in discrimine.",
    "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "Culter Militaris EX",
    "ROB_HUNK_BODY_KNIFE_INFINITE_DESCRIPTION": "Culter militaris specialiter tractatus et ad incredibilem gradum duratus. Aiunt eum factum esse ut vere permaneat.",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_NAME": "Lamina Occulta",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_DESCRIPTION": "Lamina retractilis humilis in manica celata. Optima pro operationibus furtivis.",
    "ROB_HUNK_BODY_KNIFE_WESKER_NAME": "Culter Proprius",
    "ROB_HUNK_BODY_KNIFE_WESKER_DESCRIPTION": "Lamina saeva cum acie serrata ad adversarios tuos dilacerandos.",
    "ROB_HUNK_BODY_KNIFE_MACHETE_NAME": "Machaera",
    "ROB_HUNK_BODY_KNIFE_MACHETE_DESCRIPTION": "Ingens lamina imprimis ad tacticas belli clandestini destinata.",
    "ROB_HUNK_BODY_KNIFE_RE4_NAME": "Culter Primigenius",
    "ROB_HUNK_BODY_KNIFE_RE4_DESCRIPTION": "Culter infinitis possibilitatibus fabricatus.",
    "ROB_HUNK_BODY_KNIFE_BLOODY_NAME": "Lamina Foedata",
    "ROB_HUNK_BODY_KNIFE_BLOODY_DESCRIPTION": "Lamina cruentata cum acie serrata quae multos adversarios dilaceravit.",
    "ROB_HUNK_BODY_KNIFE_HOTDOGGER_NAME": "HOT DOGGER",
    "ROB_HUNK_BODY_KNIFE_HOTDOGGER_DESCRIPTION": "Ut nomen indicat, hic culter contra arma biologica ab Umbrella elaboratus ab eis adhibetur qui ostentare amant.",
    "ROB_HUNK_BODY_KNIFE_STUNROD_NAME": "Virga Stupefaciens",
