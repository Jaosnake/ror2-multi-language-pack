    "STRUGGLE_SKILL_NAME": "ดิ้นรน",
    "STRUGGLE_SKILL_DESCRIPTION": "ดิ้นรนอยู่ภายใน Mimic เพื่อสร้าง<style=cIsDamage>ความเสียหาย 100%</style> สามารถเปิดใช้งานได้ด้วยการกดปุ่มเคลื่อนที่",
    "LEMURIAN_BITE_NAME": "กัด",
    "LEMURIAN_BITE_DESCRIPTION": "กัดไปข้างหน้าเพื่อสร้าง<style=cIsDamage>ความเสียหาย 200%</style>",
