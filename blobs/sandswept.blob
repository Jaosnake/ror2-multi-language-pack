			component.baseArmor = armor;
			component.baseCrit = crit;
			component.baseRegen = regen;
			component.baseDamage = damage;
			component.baseMoveSpeed = speed;
			component.baseAcceleration = accel;
			component.baseMaxHealth = health;
			component.autoCalculateLevelStats = true;
			component.PerformAutoCalculateLevelStats();
		}

