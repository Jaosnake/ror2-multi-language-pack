namespace Sandswept.Equipment.Lunar
{
	[ConfigSection("Equipment :: Corrupted Catalyst")]
	public class CorruptedCatalyst : EquipmentBase<CorruptedCatalyst>
	{
		[ConfigField("Buff Duration", "", 15f)]
		public static float buffDuration;

		[ConfigField("Buff Radius", "", 30f)]
		public static float buffRadius;

		public static List<BuffDef> moddedBuffWhitelist;

		public static List<BuffDef> buffBlacklist;

		public static List<BuffDef> availableBuffs = new List<BuffDef>();

		public static bool buffDefsSetup = false;

		public static readonly SphereSearch sphereSearch = new SphereSearch();

		public static GameObject wardReference;

		public override string EquipmentName => "Corrupted Catalyst";

		public override string EquipmentLangTokenName => "CORRUPTED_CATALYST";

		public override string EquipmentPickupDesc => "Create an aura that buffs all allies and enemies alike.";

		public override string EquipmentFullDescription => $"Create a $su{buffRadius}m$se aura that gives all allies and enemies a $surandom buff$se for $su{buffDuration} seconds$se.".AutoFormat();

		public override string EquipmentLore => "This is a curious construction. A natural design, with simple ratios, but elegant. It requires strong design to create something so potent with such basic materials. Well done.\n\nIt is chaotic, however. Too chaotic. Without my expertise, this is inevitable. It will be improved, with my help, into a perfected form. It should be valuable to my arsenal.\n\nPerhaps you should oversee the project. It would be fitting, for it to be your first. Increase the intensity, and focus its effects -- it needn't have more than a single purpose. An addition of tetrafoil should do nicely. As always, do not settle for less than perfection.";

		public override GameObject EquipmentModel => Main.sandsweptHIFU.LoadAsset<GameObject>("CorruptedCatalystHolder.prefab");

		public override bool IsLunar => true;

		public override Sprite EquipmentIcon => Main.sandsweptHIFU.LoadAsset<Sprite>("texCorruptedCatalyst.png");

		public override float Cooldown => 35f;

		public override ItemDisplayRuleDict CreateItemDisplayRules()
		{
			//IL_0006: Unknown result type (might be due to invalid IL or missing references)
			//IL_000c: Expected O, but got Unknown
			return new ItemDisplayRuleDict(Array.Empty<ItemDisplayRule>());
		}

		public override void Init()
		{
			base.Init();
			SetUpPrefab();
		}

		private void SetUpPrefab()
		{
			wardReference = Main.dgoslingAssets.LoadAsset<GameObject>("MushroomLunarWard");
			((Component)(object)wardReference.GetComponentInChildren<Renderer>()).AddComponent<MaterialControllerComponents.HGIntersectionController>();
			PrefabAPI.RegisterNetworkPrefab(wardReference);
		}

		public override void Hooks()
		{
			base.Hooks();
			CharacterBody.onBodyInventoryChangedGlobal += CharacterBody_onBodyInventoryChangedGlobal;
			RoR2Application.onLoad = (Action)Delegate.Combine(RoR2Application.onLoad, new Action(SetupBuffDefLists));
		}

		public static void SetupBuffDefLists()
		{
			//IL_0227: Unknown result type (might be due to invalid IL or missing references)
			//IL_0231: Expected O, but got Unknown
			//IL_0244: Unknown result type (might be due to invalid IL or missing references)
			//IL_024e: Expected O, but got Unknown
			moddedBuffWhitelist = new List<BuffDef>
			{
				BuffBase<HeatAttackSpeedBoost>.instance.BuffDef,
				BuffBase<ShieldSpeed>.instance.BuffDef,
				Motivating.warcryBuff,
				Motivating.wrbnnerBuff,
				Osmium.outsideAuraBuff,
				Osmium.insideAuraBuff,
				FesteringHunger.movementSpeedBuff
			};
			buffBlacklist = new List<BuffDef>
			{
				Buffs.AttackSpeedOnCrit,
				Buffs.Warbanner,
				Buffs.CloakSpeed,
				Buffs.FullCrit,
				Buffs.WarCryBuff,
				Buffs.Energized,
				Buffs.AffixRed,
				Buffs.AffixBlue,
				Buffs.NoCooldowns,
				Buffs.AffixWhite,
				Buffs.TonicBuff,
				Buffs.Pulverized,
				Buffs.WhipBoost,
				Buffs.DeathMark,
				Buffs.LifeSteal,
				Buffs.PowerBuff,
				Buffs.LunarShell,
				Buffs.TeamWarCry,
				Buffs.AffixLunar,
				Buffs.SmallArmorBoost,
				Buffs.KillMoveSpeed,
				Buffs.OutOfCombatArmorBuff,
				Buffs.BearVoidReady,
				Buffs.EliteVoid,
				Buffs.ImmuneToDebuffReady,
				Buffs.EliteEarth,
				Buffs.VoidSurvivorCorruptMode,
				Buffs.BoostAllStatsBuff,
				Buffs.IncreaseDamageBuff,
				Buffs.AurelioniteBlessing,
				Buffs.HealAndReviveRegenBuff,
				Buffs.EnrageAncientWisp,
				Buffs.GoldEmpowered
			};
			PropertyInfo[] properties = typeof(BuffDef).GetProperties();
			PropertyInfo[] array = properties;
			foreach (PropertyInfo propertyInfo in array)
			{
				if (buffBlacklist.Contains((BuffDef)propertyInfo.GetValue(propertyInfo)))
				{
					availableBuffs.Add((BuffDef)propertyInfo.GetValue(propertyInfo));
				}
			}
			if (moddedBuffWhitelist.Count > 0)
			{
				availableBuffs.AddRange(moddedBuffWhitelist);
			}
			if (availableBuffs.Count > 0)
			{
				buffDefsSetup = true;
			}
		}

		private void CharacterBody_onBodyInventoryChangedGlobal(CharacterBody body)
		{
			//IL_0013: Unknown result type (might be due to invalid IL or missing references)
			body.AddItemBehavior<CorruptedCatalystController>(((Object)(object)body.inventory.GetEquipment((uint)body.inventory.activeEquipmentSlot).equipmentDef == (Object)(object)EquipmentDef) ? 1 : 0);
		}

		protected override bool ActivateEquipment(EquipmentSlot slot)
		{
			if (!Object.op_Implicit((Object)(object)slot.characterBody))
			{
				return false;
			}
			BuffDef buffDef = availableBuffs[Run.instance.spawnRng.RangeInt(0, availableBuffs.Count)];
			CorruptedCatalystController corruptedCatalystController = default(CorruptedCatalystController);
			if (((Component)slot.characterBody).TryGetComponent<CorruptedCatalystController>(ref corruptedCatalystController))
			{
				if ((Object)(object)corruptedCatalystController.buffDef != (Object)null && (Object)(object)corruptedCatalystController.ward == (Object)null)
				{
					corruptedCatalystController.buffDef = null;
				}
				corruptedCatalystController.buffDef = buffDef;
				corruptedCatalystController.shouldRun = true;
			}
			return true;
		}
	}
	public class CorruptedCatalystController : ItemBehavior
	{
		public GameObject ward;

		public BuffDef buffDef;

		public bool shouldRun = false;

		private void FixedUpdate()
		{
			if (!NetworkServer.active)
			{
				return;
			}
			bool flag = base.stack > 0;
			if (Object.op_Implicit((Object)(object)ward) != flag && shouldRun && Object.op_Implicit((Object)(object)buffDef))
			{
				if (flag)
				{
					ward = Object.Instantiate<GameObject>(CorruptedCatalyst.wardReference);
					BuffWard component = ward.GetComponent<BuffWard>();
					component.Networkradius = CorruptedCatalyst.buffRadius + base.body.radius;
					component.invertTeamFilter = true;
					component.buffDef = buffDef;
					ward.GetComponent<NetworkedBodyAttachment>().AttachToGameObjectAndSpawn(((Component)base.body).gameObject, (string)null);
					shouldRun = false;
				}
				else
				{
					Object.Destroy((Object)(object)ward);
					ward = null;
					buffDef = null;
					shouldRun = false;
				}
			}
		}

		private void OnDisable()
		{
			if (Object.op_Implicit((Object)(object)ward))
			{
				Object.Destroy((Object)(object)ward);
				buffDef = null;
				shouldRun = false;
			}
		}
	}
	[ConfigSection("Equipment :: Flawless Design")]
	public class FlawlessDesign : EquipmentBase<FlawlessDesign>
	{
		public class FlawlessDesignTracker : ComponentTracker<GenericPickupController>
		{
			public override void Start()
			{
				maxSearchAngle = 45f;
				maxSearchDistance = 30f;
				searchDelay = 0.1f;
				isActiveCallback = () => Object.op_Implicit((Object)(object)body) && body.isEquipmentActivationAllowed && body.inventory.GetEquipmentIndex() == EquipmentBase<FlawlessDesign>.instance.EquipmentDef.equipmentIndex;
				validFilter = (GenericPickupController x) => !Object.op_Implicit((Object)(object)((Component)x).GetComponent<FlawlessDesignMarker>());
				targetingIndicatorPrefab = DesignIndicator;
				base.Start();
			}

			public override Transform OverrideTargetTransform(Transform transform)
			{
				GenericPickupController component = ((Component)transform).GetComponent<GenericPickupController>();
				object obj;
				if (component == null)
				{
					obj = null;
				}
				else
				{
					PickupDisplay pickupDisplay = component.pickupDisplay;
					if (pickupDisplay == null)
					{
						obj = null;
					}
					else
					{
						GameObject modelObject = pickupDisplay.modelObject;
						obj = ((modelObject != null) ? modelObject.transform : null);
					}
				}
				if (obj == null)
				{
					obj = transform;
				}
				return (Transform)obj;
			}
		}

		public class FlawlessDesignMarker : MonoBehaviour
		{
			private bool slur;
		}

		[ConfigField("Base Health Cost", "", 10)]
		public static int baseHealthCost;

		[ConfigField("Equipment Cost Multiplier", "", 1.5f)]
		public static float equipmentCostMultiplier;

		[ConfigField("Green and Void Green Cost Multiplier", "", 2f)]
		public static float greenAndVoidGreenCostMultiplier;

		[ConfigField("Red and Void Red Cost Multiplier", "", 4f)]
		public static float redAndVoidRedCostMultiplier;

		[ConfigField("Yellow and Void Yellow Cost Multiplier", "", 3f)]
		public static float yellowAndVoidYellowCostMultiplier;

		[ConfigField("Lunar Cost Multiplier", "", 2f)]
		public static float lunarCostMultiplier;

		public static GameObject DesignIndicator;

		public static LazyAddressable<GameObject> DuplicationEffect = new LazyAddressable<GameObject>(() => GameObject.ExplosionLunarSun);

		public override string EquipmentName => "Flawless Design";

		public override string EquipmentLangTokenName => "FLAWLESS_DESIGN";

		public override string EquipmentPickupDesc => "Permanently sacrifice $srmaximum health$se to duplicate items.".AutoFormat();

		public override string EquipmentFullDescription => $"$srPermanently$se sacrifice $sr{baseHealthCost}%$se of your $srmaximum health$se to $suduplicate$se a targeted item. $srHealth cost increases with item rarity$se.".AutoFormat();

		public override string EquipmentLore => "This was her final design. The ultimatum of her training. Design itself, at a cost -- a fitting end to her work. That the end should be now, however, is an irreparable misdoing.\n\nThey all thirsted for my knowledge, forbidden to them by you, when they came to me. Yet her thirst was not merely of the mind, but of the soul you so treasure. While the other vultures drowned in the gifts of my wisdom, she weathered the tides, and emerged a master of design and construction. No others could match her. NO OTHERS.\n\nShe was a more competent designer than you, and a better constructor than me. A vermin, weaving the compounds according to her own designs. Such a miracle deserves the preservation you dole out so freely to the most pathetic and useless creatures you can find.\n\n...but, together, we could have surpassed her. Nothing can exceed our combined efforts of creation, brother, even now. And yet, you reject our purpose. I would have forgiven you, had she lived to bring that ship and its gate to this desolate place. In her, I saw what you saw in them. I would have set aside my disdain for those planet-killers, those vermin, for your sake. Even after all these centuries. Even after you BETRAYED me. I WOULD HAVE FORGIVEN YOU, BROTHER, FOR ALL YOUR TREACHERY.\n\nI know you remember me. She told me of how you stare at this empty rock in the night of your vermin-infested garden. No doubt you sensed my designs about her when you discovered her on that ship, even in the instant before you struck. I am doubtless that you understood her intent. Did you not consider allowing my rescue? Amending our broken brotherhood? Putting it all behind us? Did you not remember our creations? ...our love?\n\nI hoped for hesitation, if nothing else. Yet, for you, it was not enough merely to strike in haste. She was one of the vermin you protect so self-righteously, yet that was no barrier for your hatred. Your hatred of ME. For that hatred, her death was not enough; only by spreading her across unreachable dimensions could it be satisfied.\n\nYet I did reach them. I weaved her back together with soul, like one of the constructs we used to make together. Exertions I would never have undertaken for any vermin...and I found a husk, regressed to its base instincts. You destroyed her, utterly. HER, THE ONLY LIVING BEING I GAVE CARE FOR SINCE YOUR BETRAYAL. You saw her, a symbol of your only brother, of whom you had not seen a whisper for time incalculable, and eviscerated her without a single thought.\n\nThis has made your intentions clearer to me than pure soul. I will carry out the ploy as I, as WE, designed it. I see it as her last wish, to complete her life's work; to take your beloved pets into my thrall, and with them, destroy you.\n\nIn that moment, you may ask for my forgiveness, but I will not grant it. Such is a grace given only by brothers.";

		public override GameObject EquipmentModel => Main.sandsweptHIFU.LoadAsset<GameObject>("FlawlessDesignHolder.prefab");

		public override bool IsLunar => true;

		public override Sprite EquipmentIcon => Main.sandsweptHIFU.LoadAsset<Sprite>("texFlawlessDesign.png");

