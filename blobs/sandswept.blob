	{
		[ConfigField("Base Chance", "Decimal.", 0.4f)]
		public static float baseChance;

		[ConfigField("Stack Chance", "Decimal.", 0.4f)]
		public static float stackChance;

		[ConfigField("Extra Items", "", 1)]
		public static int extraItems;

