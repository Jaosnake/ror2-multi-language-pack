{
    "la": {
        "ROB_BELMONT_BODY_NAME": "<color=#3060FF>Belmont</color>",
        "ROB_BELMONT_BODY_NAME_ALT": "Venator",
        "ROB_BELMONT_BODY_DESCRIPTION": "<color=#3060FF>Belmont</color> est venator monstrorum primarius, omnibus instrumentis instructus ad quamlibet rem, quamvis asperam.<color=#CCD3E0>\n\n< ! > Flagellum secure damnum eminus infert, sed gladii ictus longe maius damnum generatim afferunt.\n\n< ! > Rush est aptissimum instrumentum ad hostem appropinquandum et gladio laniandum.\n\n< ! > Utere Abscond ad te per monstra volantia iactandum et magna spatia superanda.\n\n< ! > Ancient Flame adhiberi potest ad turbam hostium facile delendam.</color>",
        "ROB_BELMONT_BODY_SUBTITLE": "Venator Monstrorum",
        "ROB_BELMONT_BODY_LORE": "Hic non sum domi.\n\nHic mundus <color=#7F364F>corruptionem</color> olet. Non illam quae in cordibus hominum putrescit, neque labem dominii sanguisugae, sed aliquid altius, antiquius. Aeri adhaeret, solum imbuit, et bestias hanc desertam terram pervagantes distorquet. Luna desuper intuetur, distans sed suffocans. Nefas est, quasi aliquid e loco suo legitimo surreptum.\n\nEt tamen huc adductus sum.\n\nFatumne? Minime, talibus notionibus numquam credidi. Saevus fortasse ludus, manu quadam invisibili gestus. Modo ventus per atria venationis meae ululabat, sanguinis et antiqui saxi odor in pulmonibus meis erat — mox praeceps cadebam. Caelum procella ignis erat, terra sub me celeriter assurgente. <style=cIsHealth>Perisse debueram.</style>\n\nSed sto.\n\nIterum.\n\n<color=#FF0033>Semper.</color>",
        "ROB_BELMONT_BODY_OUTRO_FLAVOR": "..et sic profectus est, sancto itinere consummato.",
        "ROB_BELMONT_BODY_OUTRO_FAILURE": "..et sic evanuit, nobili stirpe ad finem adducta.",
        "ROB_BELMONT_BODY_DEFAULT_SKIN_NAME": "<color=#3060FF>Usitatus</color>",
        "ROB_BELMONT_BODY_MONSOON_SKIN_NAME": "<color=#3060FF>Exsul</color>",
        "ROB_BELMONT_BODY_MONSOON_ALTERNATE_SKIN_NAME": "<color=#3060FF>Exsul EX</color>",
        "ROB_BELMONT_BODY_LEON_SKIN_NAME": "<color=#3060FF>Progenitor</color>",
        "ROB_BELMONT_BODY_SOMA_SKIN_NAME": "<color=#3060FF>Reincarnatio</color>",
        "ROB_BELMONT_BODY_MORRIS_SKIN_NAME": "<color=#3060FF>Explorator</color>",
        "ROB_BELMONT_BODY_JULIUS_SKIN_NAME": "<color=#3060FF>Antecessor</color>",
        "ROB_BELMONT_BODY_ISAAC_SKIN_NAME": "<color=#3060FF>Magister Fabricae</color>",
        "ROB_BELMONT_BODY_MINECRAFT_SKIN_NAME": "<color=#3060FF>Minecraft</color>",
        "ROB_BELMONT_BODY_PASSIVE_NAME": "Stirps Divina",
        "ROB_BELMONT_BODY_PASSIVE_DESCRIPTION": "In singulis stadiis <color=#7F364F>Sanctuarium Noctis</color> oritur, quod perfectum <color=#FFFF00>Fragmenta Clavis</color> praebet. Quae ad <style=cIsDamage>arma potentia</style> pro <color=#3060FF>Belmont.</color> comparanda usurpantur.",
        "ROB_BELMONT_BODY_CONFIRM_NAME": "Confirmare",
        "ROB_BELMONT_BODY_CONFIRM_DESCRIPTION": "Perge cum peritia praesenti.",
        "ROB_BELMONT_BODY_CANCEL_NAME": "Abrogare",
        "ROB_BELMONT_BODY_CANCEL_DESCRIPTION": "Abroga peritiam praesentem.",
        "ROB_BELMONT_BODY_PRIMARY_NAME": "Purificare",
        "ROB_BELMONT_BODY_PRIMARY_DESCRIPTION": "<style=cIsUtility>Agilis.</style> Vapula ad <style=cIsDamage>260% damni</style>. Si hostis procul distat, <style=cIsUtility>flagellum</style> tuum in eum intorque ad <style=cIsDamage>700% damni</style>.",
        "ROB_BELMONT_BODY_PRIMARY2_NAME": "Purgare",
        "ROB_BELMONT_BODY_PRIMARY2_DESCRIPTION": "<style=cIsUtility>Agilis.</style> <style=cIsUtility>Flagellum</style> intorque ad <style=cIsDamage>500% damni</style> omnibus hostibus ante te stantibus.",
        "ROB_BELMONT_BODY_SLIDEKICK_NAME": "Rush",
        "ROB_BELMONT_BODY_SLIDEKICK_DESCRIPTION": "<style=cIsUtility>Obstupescens.</style> Prolabere in anteriorem partem ad <style=cIsDamage>350% damni</style>, te e primo hoste percusso exsiliens.",
        "ROB_BELMONT_BODY_UTILITY_NAME": "Abscond",
        "ROB_BELMONT_BODY_UTILITY_DESCRIPTION": "In unam partem praecipita. <style=cIsUtility>Tene</style> ut postea <style=cIsUtility>flagello</style> e <style=cIsDamage>hoste electo</style> te iactes.",
        "ROB_BELMONT_BODY_UTILITY2_NAME": "Adiudicare",
        "ROB_BELMONT_BODY_UTILITY2_DESCRIPTION": "Ictum ascendentem formidabilem edite ad <style=cIsDamage>1200% damni</style>.",
        "ROB_BELMONT_BODY_SPECIAL_HOLYWATER_NAME": "Ancient Flame",
        "ROB_BELMONT_BODY_SPECIAL_HOLYWATER_DESCRIPTION": "Iace urnam <style=cIsUtility>ignium fatuorum</style>, quae explodens <style=cIsUtility>columnas igneas</style> effundit ad <style=cIsDamage>800% damni</style>.",
        "ROB_BELMONT_BODY_SPECIAL_HOLYWATER_SCEPTER_NAME": "Ignis Infernalis",
        "ROB_BELMONT_BODY_SPECIAL_HOLYWATER_SCEPTER_DESCRIPTION": "Iace urnam <style=cIsUtility>ignium fatuorum</style>, quae explodens <style=cIsUtility>columnas igneas</style> effundit ad <style=cIsDamage>800 damni</style>.\n<color=#d299ff>SCEPTRUM: Flammae maiores sunt, 1200% damni inferunt et tramitem ignis in terra relinquunt.</color>",
        "ROB_BELMONT_BODY_SPECIAL_CROSS_NAME": "Crux Bellica",
        "ROB_BELMONT_BODY_SPECIAL_CROSS_DESCRIPTION": "Iace <style=cIsUtility>crucem perforantem</style> quae hostes pluries ad <style=cIsDamage>250% damni</style> percutit.",
        "ROB_BELMONT_BODY_SPECIAL_CROSS_SCEPTER_NAME": "Crux Triplex",
        "ROB_BELMONT_BODY_SPECIAL_CROSS_SCEPTER_DESCRIPTION": "Iace <style=cIsUtility>crucem perforantem</style> quae hostes pluries ad <style=cIsDamage>250% damni</style> percutit.\n<color=#d299ff>SCEPTRUM: Iace tres simul.</color>",
        "ROB_BELMONT_BODY_SPECIAL_PISTOL_NAME": "Pistolium Sacrum",
        "ROB_BELMONT_BODY_SPECIAL_PISTOL_DESCRIPTION": "Emitte <style=cIsUtility>argenteam glandem</style> ad <style=cIsDamage>800% damni</style>. <style=cIsUtility>Ictus in caput</style> <style=cIsDamage>duplum damnum</style> inferunt. Caedes <style=cIsUtility>omnia tempora refrigerationis restituunt</style>.",
        "ROB_BELMONT_BODY_SPECIAL_PISTOL_SCEPTER_NAME": "Luminare",
        "ROB_BELMONT_BODY_SPECIAL_PISTOL_SCEPTER_DESCRIPTION": "Emitte <style=cIsUtility>argenteam glandem</style> ad <style=cIsDamage>800% damni</style>. <style=cIsUtility>Ictus in caput</style> <style=cIsDamage>duplum damnum</style> inferunt. Caedes <style=cIsUtility>omnia tempora refrigerationis restituunt</style>.\n<color=#d299ff>SCEPTRUM: 99999% damni infert.</color>",
        "ROB_BELMONT_BODY_SPECIAL_HOLYCROSS_NAME": "<color=#FF0033>Flamma Sacra</color>",
        "ROB_BELMONT_BODY_SPECIAL_HOLYCROSS_DESCRIPTION": "Potentiam <color=#FF0033>Providentiae</color> invoca, <style=cIsUtility>ingentem flammam</style> emittens ad <style=cIsDamage>300% damni per pulsationem</style>. Supernova <style=cIsDamage>4000% damni</style> consummatur.",
        "ROB_BELMONT_BODY_UNLOCKABLE_UNLOCKABLE_NAME": "<color=#3060FF>Belmont</color>: Strages Sanguisugarum",
