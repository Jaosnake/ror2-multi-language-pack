    "HABIBI_DESOLATOR_BODY_SPECIAL_SCEPTER_IRRADIATOR_NAME": "Irradiateurs Instables",
    "HABIBI_DESOLATOR_BODY_SPECIAL_SCEPTER_IRRADIATOR_DESCRIPTION": "<style=cIsHealing>Irradiant</style>. Lancez <style=cIsUtility>jusqu'à 2</style> Irradiateurs qui couvrent une grande zone de radiation pendant <style=cIsUtility>11 secondes</style>, infligeant <style=cIsDamage>15% de dégâts par seconde</style>.\n<color=#d299ff>SCEPTRE : Explose à expiration pour <style=cIsDamage>1600% de dégâts</style>.</color>",
    "HABIBI_DESOLATOR_BODY_SPECIAL_IRRADIATOR_NAME_FUN": "Bâtons Lumineux",
