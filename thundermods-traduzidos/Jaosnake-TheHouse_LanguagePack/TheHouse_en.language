{
    "en": {
        "JAVANGLE_HOUSE_BODY_NAME": "House",
        "JAVANGLE_HOUSE_BODY_DESCRIPTION": "",
        "JAVANGLE_HOUSE_BODY_SUBTITLE": "The Mad Gambler",
        "JAVANGLE_HOUSE_BODY_LORE": "Speakin' o' slot machines, a new one just got installed in the ships entertainment lobby, folks've been sayin' the damn things livin' or sumin', crazy b-..They installed what now?!",
        "JAVANGLE_HOUSE_BODY_OUTRO_FLAVOR": "Well, if it weren't for my first prize being these artifacts, I might not have pulled so much from that slot machine, turned the damn thing into a money printer, the host was not so pleased, got myself kicked out, been being chased that same slot machine ever since",
        "JAVANGLE_HOUSE_BODY_OUTRO_FAILURE": "Woah woah Woah! Easy there, slow down now, a casino in the void? a slot machine nearly killed you?... take it thats where you got those artifacts, eh?",
        "JAVANGLE_HOUSE_BODY_DEFAULT_SKIN_NAME": "House",
        "JAVANGLE_HOUSE_BODY_MASTERY_SKIN_NAME": "Mansion",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "House: Mastery",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "As House, beat the game or obliterate on Monsoon.",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "House: Mastery",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "House: Grand Mastery",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "As House, beat the game or obliterate on Typhoon.",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "House: Grand Mastery",
        "JAVANGLE_HOUSE_PASSIVE_NAME": "The Game",
        "JAVANGLE_HOUSE_PASSIVE_DESCRIPTION": "Instead of <style=cIsUtility>Skills</style>, The House uses <style=cIsUtility>Cards</style>, each card has a unique effect. Once a card is used, its slot goes on cooldown, you discard your hand, and draw 3 new cards.",
        "JAVANGLE_HOUSE_STANDARDSPREAD_NAME": "Deck: Standard Spread",
        "JAVANGLE_HOUSE_STANDARDSPREAD_DESCRIPTION": "She runs a casino in the void, god only knows how she gets patrons down there, all I can tell you is that they definitely do NOT like said patrons walking out with more than what they went in with, slot machine nearly killed meA simplified deck, designed to be easy to use.<style=cSub>[Check the Cards tab to see the cards in this deck]</style>",
        "JAVANGLE_HOUSE_FULLHOUSE_NAME": "Deck: Full House",
        "JAVANGLE_HOUSE_FULLHOUSE_DESCRIPTION": "Say what now?The classic House experience.<style=cSub>[Check the Cards tab to see the cards in this deck]</style>",
        "JAVANGLE_HOUSE_DIVINATION_NAME": "Deck: Divination",
        "JAVANGLE_HOUSE_DIVINATION_DESCRIPTION": "Well, I had a run in with herA complex deck that allows you to control the card composition.<style=cSub>[Check the Cards tab to see the cards in this deck]</style>",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_NAME": "BulletArts: Empty",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_DESCRIPTION": "Heh, you speak as if you'd met 'erFire a loaded Shot at random.When you have no shots left: do nothing.",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_NAME": "BulletArts: Quickdraw",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_DESCRIPTION": "<style=cIsUtility>Fire faster</style>, but <style=cArtifact>all shots deal less damage</style>. When you have no shots left: do nothing.",
        "JAVANGLE_HOUSE_RELOADSTANDARD_NAME": "ReloadArts: Standard",
        "JAVANGLE_HOUSE_RELOADSTANDARD_DESCRIPTION": "Playing any card reloads roulette.\n50%/25% chance to gain 1/2 random special ammo based on the type of card used (red = Piercing/Buck/Explosive, purple = Blank/Snake, grey/green = any of the previous).\n<style=cSub>[Check the Cards tab to see the Shots and their effects]</style>",
        "JAVANGLE_HOUSE_RELOADALLIN_NAME": "ReloadArts: All-In",
        "JAVANGLE_HOUSE_RELOADALLIN_DESCRIPTION": "... well I'll be!The cards seem to have immense power, and wield strange effects, and no matter how hard I try, I can never draw more until I use onePlaying any card reloads roulette.Load 0-6 Piercing/Buck/Explosive shots, <style=cArtifact>all remaining shots are Snake</style>.<style=cSub>[Check the Cards tab to see the Shots and their effects]</style>",
        "JAVANGLE_HOUSE_CARDARTSHOP_NAME": "CardArts: Hop",
        "JAVANGLE_HOUSE_CARDARTSHOP_DESCRIPTION": "Playing any card: while in the air: will boost you forwards.",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_NAME": "CardArts: Sweep",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_DESCRIPTION": "Playing any card: swipes the card forward, dealing <style=cIsDamage>{0}% damage</style> to enemies in melee range and <style=cIsUtility>gain barrier equal to {1}% of your max health</style> per enemy hit.",
        "JAVANGLE_HOUSE_SHUFFLEART_NAME": "ShuffleArts: Ouroboros",
        "JAVANGLE_HOUSE_SHUFFLEART_DESCRIPTION": "Whenever you run out of cards: reshuffle the deck back into the draw pile.",
        "JAVANGLE_HOUSE_STANDARDSHOT_NAME": "Standard Shot",
        "JAVANGLE_HOUSE_STANDARDSHOT_DESCRIPTION": "Fire a standard bullet for <style=cIsDamage>{0}% damage</style>.",
        "JAVANGLE_HOUSE_PIERCINGSHOT_NAME": "Piercing Shot",
        "JAVANGLE_HOUSE_PIERCINGSHOT_DESCRIPTION": "Fire a special shot that pierces through targets for <style=cIsDamage>{0}% damage</style> each",
        "JAVANGLE_HOUSE_BUCKSHOT_NAME": "Buck Shot",
        "JAVANGLE_HOUSE_BUCKSHOT_DESCRIPTION": "Fire a shotgun blast for <style=cIsDamage>{0}% x {1} damage</style>.",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_NAME": "Explosive Shot",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_DESCRIPTION": "Fire an explosive projectile that deals <style=cIsDamage>{0}% damage</style> in an AoE.",
        "JAVANGLE_HOUSE_SNAKESHOT_NAME": "Snake Shot",
        "JAVANGLE_HOUSE_SNAKESHOT_DESCRIPTION": "Attempt to fire a shot, <style=cSub>fail</style>, and proceed to take <style=cDeath>{0}% of your max health as damage</style>",
        "JAVANGLE_HOUSE_BLANKSHOT_NAME": "Blank Shot",
        "JAVANGLE_HOUSE_BLANKSHOT_DESCRIPTION": "Attempt to fire a shot, <style=cSub>fail</style>, and proceed to look stupid lel.",
        "JAVANGLE_HOUSE_MYSTERYSHOT_NAME": "Mystery Shot",
        "JAVANGLE_HOUSE_MYSTERYSHOT_DESCRIPTION": "Fire a completely random projectile, it really could be anything.",
        "JAVANGLE_HOUSE_ACESHOT_NAME": "Ace Shot",
        "JAVANGLE_HOUSE_ACESHOT_DESCRIPTION": "Charge a giant shot that deals <style=cIsDamage>{0}% damage</style> to all enemies before you, striking from all ranges, and even through walls",
        "JAVANGLE_HOUSE_7CLUBS_NAME": "7 of Clubs",
        "JAVANGLE_HOUSE_7CLUBS_DESCRIPTION": "Load <style=cIsUtility>3 Mystery Shots</style> into roulette.\nAdditionally, <style=cIsUtility>Guarantees</style> your next bullet will be an Explosive Shot.",
        "JAVANGLE_HOUSE_7SPADES_NAME": "7 of Spades",
        "JAVANGLE_HOUSE_7SPADES_DESCRIPTION": "Gain <style=cIsUtility>Increased Movement Speed</style> as well as <style=cIsUtility>2 completely random buffs</style> for {0} seconds\nAdditionally, <style=cIsUtility>Guarantees</style> your next bullet will be a Piercing Shot.",
        "JAVANGLE_HOUSE_7DIAMONDS_NAME": "7 of Diamonds",
        "JAVANGLE_HOUSE_7DIAMONDS_DESCRIPTION": "<style=cShrine>Gain Gold</style> <style=cSub>(scales with chest costs)</style>.",
        "JAVANGLE_HOUSE_7HEARTS_NAME": "7 of Hearts",
        "JAVANGLE_HOUSE_7HEARTS_DESCRIPTION": "<style=cIsHealing>Heal for 50% of your max HP</style> and <style=cIsUtility>Gain up to 50% Barrier</style> depending on current HP.",
        "JAVANGLE_HOUSE_JACKPOT_NAME": "Jackpot",
        "JAVANGLE_HOUSE_JACKPOT_DESCRIPTION": "Randomly activates the effects of ''7 of Clubs'', ''7 of Diamonds'', ''7 of Hearts'', or ''7 of Spades'' with double the effect, 20% chance to <style=cIsUtility>activate all at once</style>.",
        "JAVANGLE_HOUSE_52_NAME": "Pick-Up 52",
        "JAVANGLE_HOUSE_52_DESCRIPTION": "Throws all remaining cards into the air and shuffles everything back into the draw pile, each card homes in on enemies and <style=cIsDamage>deals varying amounts of Damage</style>.",
        "JAVANGLE_HOUSE_SNAKE_NAME": "Snake Eyes",
        "JAVANGLE_HOUSE_SNAKE_DESCRIPTION": "JAVANGLE_HOUSE_TOWER_DESCRIPTION<style=cArtifact>Crisis</style>, <style=cDeath>Destruction</style>, <style=cArtifact>Catastrophe</style>, <style=cDeath>Losses</style>, <style=cArtifact>Obstacles</style>, <style=cDeath>Volatile</style>.<style=cIsUtility>[Indestructible]</style> ",
        "JAVANGLE_HOUSE_BUST_NAME": "Bust",
        "JAVANGLE_HOUSE_BUST_DESCRIPTION": "Instantly take <style=cDeath>{0}% of your max health as damage</style>, and <style=cIsDamage>deal {1}% of your max health</style> as damage to nearby enemies.",
        "JAVANGLE_HOUSE_SWORDS_NAME": "10 of Swords",
        "JAVANGLE_HOUSE_SWORDS_DESCRIPTION": "Summon powerful enemies around yourself.",
        "JAVANGLE_HOUSE_COINS_NAME": "5 of coins",
        "JAVANGLE_HOUSE_COINS_DESCRIPTION": "<style=cArtifact>Lose {0}% your current gold</style> and <style=cIsDamage>deal {1}% of the gold lost as damage</style> to nearby enemies.",
        "JAVANGLE_HOUSE_TOWER_NAME": "The Tower",
        "JAVANGLE_HOUSE_TOWER_DESCRIPTION": "<style=cArtifact>Crisis</style>, <style=cDeath>Destruction</style>, <style=cArtifact>Catastrophe</style>, <style=cDeath>Losses</style>, <style=cArtifact>Obstacles</style>, <style=cDeath>Volatile</style>.\n<style=cIsUtility>[Indestructible]</style>",
        "JAVANGLE_HOUSE_JOKER_NAME": "Joker",
        "JAVANGLE_HOUSE_JOKER_DESCRIPTION": "Activates a random other <style=cArtifact>Purple Card Effect</style>, 20% chance to activate <style=cArtifact>all of them at once</style>.\n<style=cSub>(Cannot Activate Tower.)</style>",
        "JAVANGLE_HOUSE_7JACK_NAME": "Jack of Diamonds",
        "JAVANGLE_HOUSE_7JACK_DESCRIPTION": "Load 6 standard shots.\nIf grounded: slides forward.",
        "JAVANGLE_HOUSE_7QUEEN_NAME": "Queen of Hearts",
        "JAVANGLE_HOUSE_7QUEEN_DESCRIPTION": "Temporarily <style=cIsUtility>buffs 2 random stats</style>, but <style=cArtifact>debuffs 2 random other stats</style>.",
        "JAVANGLE_HOUSE_7KING_NAME": "King of Clubs",
        "JAVANGLE_HOUSE_7KING_DESCRIPTION": "Loads an Explosive, Piercing, Buck, Snake, Bank, and Mystery Shot.",
        "JAVANGLE_HOUSE_7ACE_NAME": "Ace of Spades",
        "JAVANGLE_HOUSE_7ACE_DESCRIPTION": "Loads nothing but 1 unique shot that deals <style=cIsDamage>{0}% damage</style> after a long delay.",
        "JAVANGLE_HOUSE_WILDCARD_NAME": "Wildcard",
        "JAVANGLE_HOUSE_WILDCARD_DESCRIPTION": "Does something unpredictable. could be good, could be bad, could be neither... maybe both?\n<style=cIsUtility>[Indestructible]</style>",
        "JAVANGLE_HOUSE_RROULETTE_NAME": "Russian Roulette",
        "JAVANGLE_HOUSE_RROULETTE_DESCRIPTION": "JAVANGLE_HOUSE_GSPADES_DESCRIPTIONGain <style=cIsUtility> Increased Movement Speed</style> for {0} secondsAdditionally, <style=cIsUtility>Guarantees</style> your next bullet will be a Piercing Shot.",
        "JAVANGLE_HOUSE_FORTUNE_NAME": "Wheel of Fortune",
        "JAVANGLE_HOUSE_FORTUNE_DESCRIPTION": "50% chance to <style=cShrine>double current gold</style>, 50% chance to <style=cArtifact>lose all gold</style> and <style=cIsUtility>roll for a random item</style> based on gold lost.",
        "JAVANGLE_HOUSE_THREEOFAKIND_NAME": "Three of a Kind",
        "JAVANGLE_HOUSE_THREEOFAKIND_DESCRIPTION": "Draw and <style=cIsUtility>play the entire next hand</style> all at once.",
        "JAVANGLE_HOUSE_GCLUBS_NAME": "Clubs",
        "JAVANGLE_HOUSE_GCLUBS_DESCRIPTION": "Load <style=cIsUtility>3 random Positive Shots</style> into roulette.\nAdditionally, <style=cIsUtility>Guarantees</style> your next bullet will be an Explosive Shot.",
        "JAVANGLE_HOUSE_GSPADES_NAME": "Spades",
        "JAVANGLE_HOUSE_GSPADES_DESCRIPTION": "Gain <style=cIsUtility> Increased Movement Speed</style> for {0} seconds\nAdditionally, <style=cIsUtility>Guarantees</style> your next bullet will be a Piercing Shot.",
        "JAVANGLE_HOUSE_GHEARTS_NAME": "Hearts",
        "JAVANGLE_HOUSE_GHEARTS_DESCRIPTION": "<style=cIsHealing>Heal for 50% of your max HP</style>",
        "JAVANGLE_HOUSE_GJACK_NAME": "Jack",
        "JAVANGLE_HOUSE_GJACK_DESCRIPTION": "Does nothing.",
        "JAVANGLE_HOUSE_CRAZYCARD_NAME": "Crazycard",
        "JAVANGLE_HOUSE_CRAZYCARD_DESCRIPTION": "Activates another Standard Spread card at random.",
        "JAVANGLE_HOUSE_CASHOUT_NAME": "Cashout",
        "JAVANGLE_HOUSE_CASHOUT_DESCRIPTION": "1/3 chance to <style=cArtifact>lose all money</style>, 1/3 chance to do nothing, 1/3 chance to <style=cIsDamage>damage every enemy on the map</style> and <style=cIsUtility>grant a temporary item</style>.\n<style=cSub>(Damage and item rarity scale with money risked)</style>",
        "JAVANGLE_HOUSE_THESUN_NAME": "The Sun",
        "JAVANGLE_HOUSE_THESUN_DESCRIPTION": "<style=cIsUtility>Creates a duplicate of each other card in the hand</style> and draws them into the next hand.\n<style=cSub>(Does not work on 'Indestructible' cards)</style>.\n<style=cSub>(This effect cannot be triggered by other cards)</style>.",
        "JAVANGLE_HOUSE_THEMOON_NAME": "The Moon",
        "JAVANGLE_HOUSE_THEMOON_DESCRIPTION": "<style=cIsUtility>Destroys each other card in the hand</style>, removing them from the deck.\n<style=cSub>(Does not work on 'Indestructible' cards)</style>.\n<style=cSub>(This effect cannot be triggered by other cards)</style>.",
        "JAVANGLE_HOUSE_THESTAR_NAME": "The Star",
        "JAVANGLE_HOUSE_THESTAR_DESCRIPTION": "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION<style=cIsUtility>Destroys all 'The Sun', 'The Moon', 'The Star' and 'The World' cards</style> from the draw pile, hand, and discard pile, removing them from the deck.<style=cSub>(This effect cannot be triggered by other cards)</style>.",
        "JAVANGLE_HOUSE_THEWORLD_NAME": "The World",
        "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION": "<style=cIsUtility>Destroys all 'The Sun', 'The Moon', 'The Star' and 'The World' cards</style> from the draw pile, hand, and discard pile, removing them from the deck.\n<style=cSub>(This effect cannot be triggered by other cards)</style>.",
        "JAVANGLE_HOUSE_JUDGEMENT_NAME": "Judgement",
        "JAVANGLE_HOUSE_JUDGEMENT_DESCRIPTION": "<style=cIsUtility>Completely replaces the deck with the original version</style>, undoing any changes that have been made to it. <style=cSub>(as if you had respawned, or changed stage)</style>\n<style=cSub>(This effect cannot be triggered by other cards)</style>.\n<style=cIsUtility>[Indestructible]</style>",
        "JAVANGLE_HOUSE_KINGOFWANDS_NAME": "King of Wands",
        "JAVANGLE_HOUSE_KINGOFWANDS_DESCRIPTION": "<style=cIsUtility>Consumes up to  stacks of 'Ante'</style>, and <style=cIsHealing>provides up to % healing</style> depending on how much 'Ante' was spent.\n<style=cIsHealing>All controlled allies are healed for half the amount</style>.",
        "JAVANGLE_HOUSE_QUEENOFCUPS_NAME": "Queen of Cups",
        "JAVANGLE_HOUSE_QUEENOFCUPS_DESCRIPTION": "<style=cIsUtility>Consumes up to  stacks of 'Ante'</style>, and provides a buff that allows House to <style=cIsUtility>fire loaded shots without expending them</style>.\nThis buff lasts for up to  seconds, depending on how much 'Ante' is spent.",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_NAME": "Knight of Swords",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_DESCRIPTION": "<style=cIsUtility>Consumes up to  stacks of 'Ante'</style>, and <style=cIsUtility>loads a number of positive rounds</style> equal to the amount of 'Ante' spent.\nAdditionally, <style=cIsUtility>Guarantees</style> your next bullet will be an Explosive Shot.",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_NAME": "Page of Pentacles",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_DESCRIPTION": "<style=cIsUtility>Consumes up to  stacks of 'Ante'</style>, and summons Lunar Chimeras to fight for you, the more 'Ante' you spend, the greater the summoned force will be.\nAt  stacks spent, this card will summon a random survivor instead",
        "JAVANGLE_HOUSE_ANTEUP_NAME": "Up the Ante!",
        "JAVANGLE_HOUSE_ANTEUP_DESCRIPTION": "<style=cIsUtility>Grants  stacks of 'Ante'</style>.\nEach stack of Ante reduces armor, and increases movement and attack speed",
        "JAVANGLE_HOUSE_ANCIENTACE_NAME": "Ancient Ace",
        "JAVANGLE_HOUSE_ANCIENTACE_DESCRIPTION": "Load <style=cIsUtility>6 Mystery Shots</style> into roulette.\nAdditionally, <style=cIsUtility>Grant one of the following effects</style>.\n<style=cIsUtility>Dueces</style>: Every card you play, plays twice\n<style=cIsUtility>Flush</style>: Every time you play a card, play the rest of your hand (skipping negative and random cards)\n<style=cIsUtility>Cups</style>: Firing Roulette no longer costs Ammo\n<style=cIsUtility>[Indestructible]</style>",
        "ARTIFACT_OF_WILDROOM_NAME": "Artifact of Wildroom",
        "ARTIFACT_OF_WILDROOM_DESCRIPTION": "Summon a Wildroom at the start of every stage.\nWildroom can no longer remove itself, and now effects non-House players.",
        "JAVANGLE_HOUSE_NULL_NAME": "Null",
        "JAVANGLE_HOUSE_NULL_DESCRIPTION": "Does nothing, doesn't even reload.\nYou did it, you destroyed it all, you reduced it down to nothing, and now nothing is all that is left... are you happy..?"
    }
}