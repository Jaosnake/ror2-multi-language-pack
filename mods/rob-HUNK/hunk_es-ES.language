    "ROB_HUNK_BODY_SHOOT_ROCKETLAUNCHER_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_ROCKETLAUNCHER_DESCRIPTION": "Dispara causando un <style=cIsDamage>12000% de daño</style>. <style=cIsDamage>Incendiario.</style>",
    "ROB_HUNK_BODY_SHOOT_GRENADELAUNCHER_NAME": "Disparar",
