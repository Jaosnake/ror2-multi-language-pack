    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "MEISTERSCHAFT",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Rogue-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Motorleistung: </color>3000\n<color=#00FFFF>Geschwindigkeit: </color>10\nDrehgeschwindigkeit: 0.8\n\n<color=#00FF00>Gesundheit: </color>1000\n<color=#FF0000>Rüstung: </color>75\n\n<color=#AA00FF>Schubkraft: </color>35\n<color=#ffc080>Treibstoffmenge: </color>500\nGewicht: 1000\n\nWannentyp: Panzer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Griffon-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Turmkompatibel</color>.\n\n<color=#FFFF00>Motorleistung: </color>2300\n<color=#00FFFF>Geschwindigkeit: </color>11\nDrehgeschwindigkeit: 1\n\n<color=#00FF00>Gesundheit: </color>800\n<color=#FF0000>Rüstung: </color>25\n\n<color=#AA00FF>Schubkraft: </color>40\n<color=#ffc080>Treibstoffmenge: </color>500\nGewicht: 800\n\nWannentyp: Fahrzeug",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "TONK-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Motorleistung: </color>1200\n<color=#00FFFF>Geschwindigkeit: </color>12\nDrehgeschwindigkeit: 2\n\n<color=#00FF00>Gesundheit: </color>500\n<color=#FF0000>Rüstung: </color>25\n\n<color=#AA00FF>Schubkraft: </color>40\n<color=#ffc080>Treibstoffmenge: </color>300\nGewicht: 450\n\nWannentyp: Panzer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Type 5 Heavy-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Motorleistung: </color>3500\n<color=#00FFFF>Geschwindigkeit: </color>8\nDrehgeschwindigkeit: 0.6\n\n<color=#00FF00>Gesundheit: </color>1400\n<color=#FF0000>Rüstung: </color>100\n\n<color=#AA00FF>Schubkraft: </color>34\n<color=#ffc080>Treibstoffmenge: </color>750\nGewicht: 1250\n\nWannentyp: Panzer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Bigfoot-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Bietet mehr <style=cIsUtility>Luftkontrolle</style>.\n\n\n<color=#FFFF00>Motorleistung: </color>2000\n<color=#00FFFF>Geschwindigkeit: </color>13\nDrehgeschwindigkeit: 1.4\n\n<color=#00FF00>Gesundheit: </color>600\n<color=#FF0000>Rüstung: </color>20\n\n<color=#AA00FF>Schubkraft: </color>40\n<color=#ffc080>Treibstoffmenge: </color>450\nGewicht: 750\n\nWannentyp: Fahrzeug",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "AMX50B-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>Geschwindigkeit wird nicht vom Gewicht beeinflusst</style>.\n\n<color=#FFFF00>Motorleistung: </color>700\n<color=#00FFFF>Geschwindigkeit: </color>9\nDrehgeschwindigkeit: 0.7\n\n<color=#00FF00>Gesundheit: </color>900\n<color=#FF0000>Rüstung: </color>50\n\n<color=#AA00FF>Schubkraft: </color>35\n<color=#ffc080>Treibstoffmenge: </color>370\nGewicht: 1100\n\nWannentyp: Panzer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "TOG II-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Motorleistung: </color>3700\n<color=#00FFFF>Geschwindigkeit: </color>8\nDrehgeschwindigkeit: 0.5\n\n<color=#00FF00>Gesundheit: </color>1150\n<color=#FF0000>Rüstung: </color>60\n\n<color=#AA00FF>Schubkraft: </color>34\n<color=#ffc080>Treibstoffmenge: </color>1000\nGewicht: 1200\n\nWannentyp: Panzer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Pigeon-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Turmkompatibel</color>.\n\n<color=#FFFF00>Motorleistung: </color>1500\n<color=#00FFFF>Geschwindigkeit: </color>7\nDrehgeschwindigkeit: 1.4\n\n<color=#00FF00>Gesundheit: </color>150\n<color=#FF0000>Rüstung: </color>5\n\n<color=#AA00FF>Schubkraft: </color>40\n<color=#ffc080>Treibstoffmenge: </color>300\nGewicht: 100\n\nWannentyp: Fahrzeug",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Pontera AC-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Kann Wände erklimmen</style>. Sprung ist um eine Sekunde verzögert und <color=#fc8080>Rammschaden ist um 50% reduziert</color>.\n\n\n<color=#FFFF00>Motorleistung: </color>2750\n<color=#00FFFF>Geschwindigkeit: </color>9\nDrehgeschwindigkeit: 0.8\n\n<color=#00FF00>Gesundheit: </color>1300\n<color=#FF0000>Rüstung: </color>90\n\n<color=#AA00FF>Schubkraft: </color>31\n<color=#ffc080>Treibstoffmenge: </color>550\nGewicht: 1300\n\nWannentyp: Mech",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "TANKDOZER-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "Pflug <style=cIsUtility>blockiert</style> jeglichen <style=cIsDamage>eingehenden Schaden</style>.\n\nJagdpanzer-Modus: <color=#fc8080>Kann keinen Geschützturm montieren</color>.\n\n<color=#FFFF00>Motorleistung: </color>2500\n<color=#00FFFF>Geschwindigkeit: </color>8.5\nDrehgeschwindigkeit: 0.9\n\n<color=#00FF00>Gesundheit: </color>1250\n<color=#FF0000>Rüstung: </color>80\n\n<color=#AA00FF>Schubkraft: </color>34\n<color=#ffc080>Treibstoffmenge: </color>500\nGewicht: 1200\n\nWannentyp: Panzer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Truck Kan-Wanne",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "Rammschaden ist um <color=#80fc80>100.0%</color> erhöht\n\n<color=#80fc80>Turmkompatibel</color>.\n<style=cIsUtility>Geschwindigkeit wird nicht vom Gewicht beeinflusst</style>.\n\n<color=#FFFF00>Motorleistung: </color>1000\n<color=#00FFFF>Geschwindigkeit: </color>12\nDrehgeschwindigkeit: 0.9\n\n<color=#00FF00>Gesundheit: </color>450\n<color=#FF0000>Rüstung: </color>15\n\n<color=#AA00FF>Schubkraft: </color>40\n<color=#ffc080>Treibstoffmenge: </color>600\nGewicht: 600\n\nWannentyp: Fahrzeug",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>250\n<color=#FF0000>Rüstung: </color>25\n\nRotationsgeschwindigkeit: 7.5\n\nGewicht: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Geschützturm",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>100\n<color=#FF0000>Rüstung: </color>10\n\nRotationsgeschwindigkeit: 20\n\nGewicht: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>100\n<color=#FF0000>Rüstung: </color>15\n\nRotationsgeschwindigkeit: 15\n\nGewicht: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>400\n<color=#FF0000>Rüstung: </color>50\n\nRotationsgeschwindigkeit: 5\n\nGewicht: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% Schaden</style>?  Ich konnte den Code nicht finden, der den Schaden für diesen speziellen Geschützturm erhöht.\n- Entwickler\n\n\n<color=#00FF00>Gesundheit: </color>150\n<color=#FF0000>Rüstung: </color>25\n\nRotationsgeschwindigkeit: 13\nWinkellimit: 60\n\nGewicht: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Fügt der <style=cIsUtility>Sekundärfertigkeit</style> <style=cIsDamage>5 Ladungen</style> hinzu.\n<style=cIsUtility>Füllt alle Ladungen</style> nach der Abklingzeit wieder auf.\nKanonenschaden verringert sich um 80%\n\n<color=#00FF00>Gesundheit: </color>300\n<color=#FF0000>Rüstung: </color>20\n\nRotationsgeschwindigkeit: 7\n\nGewicht: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>200\n<color=#FF0000>Rüstung: </color>30\n\nRotationsgeschwindigkeit: 9\n\nGewicht: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>300\n<color=#FF0000>Rüstung: </color>35\n\nRotationsgeschwindigkeit: 7\n\nGewicht: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Schwergewicht",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "Der Panzer kann <style=cIsUtility>Gegner überfahren</style>, wobei der <style=cIsDamage>Schaden von der Geschwindigkeit abhängt</style>.  Ein Sturz mit schwerer Konfiguration erzeugt durch dein Gewicht eine <style=cIsUtility>Druckwelle</style>, die nahen Gegnern schadet.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Keine",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Entfernt diese Fertigkeit.  Erhöht die folgenden Werte:\n\nAngriffsgeschwindigkeit: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Keine",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Keine",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Entfernt diese Fertigkeit.  Erhöht die folgenden Werte:\n\nGeschwindigkeit: <color=#80fc80>+1</color> m/s\nTriebwerksleistung: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Keine",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Entfernt diese Fertigkeit.  Erhöht die Rüstung um <color=#80fc80>30</color> und erhöht die Treibstoffkapazität um <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Minikanone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Feuere ungenau für <style=cIsDamage>200% Schaden.</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "EMP",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Entzünde deinen Schild und erzeuge einen EMP für <style=cIsDamage>2000% Schaden</style>, der Gegner unter Strom setzt!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "Fasse einen gewaltigen Vorrat von bis zu 22 Raketen! Jede verursacht zwischen <style=cIsDamage>1100% Schaden</style> und <style=cIsDamage>1800% Schaden</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Schnellfeuer-Maschinenkanone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Schieße Explosivgeschosse auf Gegner für <style=cIsDamage>500% Schaden</style>. Muss alle 4 Sekunden nachladen.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Mächtige Kanone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Feuere für <style=cIsDamage>7500% Schaden</style> und stoße Gegner zurück.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 16s</style> | <style=cIsDamage>Explosionsradius: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Artilleriekanone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Halten zum Zielen</style> und loslassen, um ein mächtiges Geschoss für <style=cIsDamage>7000% Schaden</style> abzufeuern.  Der Schaden steigt mit der Flugdistanz auf bis zu <style=cIsDamage>14000% Schaden</style>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 16s</style> | <style=cIsDamage>Explosionsradius: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Kryokanone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Schieße einen riesigen Schneeball für <color=#75EAFF>1500% Schaden</color> ab und friere Gegner ein.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 5s</style> | <style=cIsDamage>Explosionsradius: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Zwillingskanone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Feuere für <style=cIsDamage>5400% Schaden</style>. Halten, um 2 Geschosse abzufeuern, was danach die <color=#fc8080>Abklingzeit der Fertigkeit erhöht</color>. Ein Doppelschuss <color=#80fc80>verringert stark</color> die nächste Aufladezeit für 2 Sekunden.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "Britische Kanone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Feuere für <style=cIsDamage>2400% Schaden</style>.  <color=#fc8080>Kann keine Gegenstandseffekte auslösen</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Große Böse Kanone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Feuere für <style=cIsDamage>2000% Schaden</style>.  <style=cIsUtility>Halten zum Aufladen</style>, um bis zu <style=cIsDamage>11000% Schaden</style> zu verursachen.  Bei maximaler Ladung feuert die Kanone automatisch für zusätzliche <style=cIsDamage>5500% Laserschaden</style> mit <style=cIsUtility>zusätzlichem Rückstoß</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Oppenheimers Experiment",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Lass dein Geschoss deinen Schild zerstören und vernichte alles für <color=#ff4d76>9000% kritischen Schaden</color>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Düsen",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Zünde die Düsen und verbrauche <color=#ffc080>70 Treibstoff</color> pro Sekunde, wodurch der Panzer mit der Zeit immer schneller wird.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Leistungszyklus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Aktivieren, um zwischen 3 Modi zu wechseln – Ausweichen, Angriff oder Verteidigung: \n\n<style=cIsUtility>Ausweichen</style>: Verringert die Angriffsgeschwindigkeit um 50% und erhöht die Abklingzeit um 50% für zusätzliche 50% Geschwindigkeit, 10% Schubkraft und 50% Motorleistung!\n\n<color=#80fc80>Verteidigung</color>: Opfert 70% Geschwindigkeit und 100% Schubkraft für 500 Rüstung.\n\n<style=cIsDamage>Angriff</style>: Alle Waffen verursachen doppelten Schaden. Verringert Abklingzeiten um 33% und erhöht die Angriffsgeschwindigkeit um 33%, aber du verlierst ALLE Rüstung und Heilung. Das Aktivieren dieses Modus setzt deinen Panzer für 2 Sekunden unter Strom.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Übertakten",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Lass deine Geschwindigkeit deinen Schild zerstören und entfessle eine gewaltige Explosion deiner Triebwerke für <style=cIsDamage>6000% Schaden</style>, die dich in die Luft schleudert und <style=cIsUtility>Fallschaden verhindert</style>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Schilde",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "Aktivieren, um für 4 Sekunden <style=cIsUtility>immun gegen äußeren Schaden</style> zu werden.  Kann für eine einmalige <color=#03fcc2>Kraftfähigkeit</color> geopfert werden.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Sprengsalve",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Feuere 4 Kanonen ab, die jeweils <style=cIsDamage>1400% Schaden</style> in einem riesigen Radius verursachen. Waffen <color=#fc8080>überhitzen</color>, anstatt nachzuladen.\n<style=cSub>[<style=cIsDamage>Explosionsradius: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Standard",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Klassisches Spielerlebnis.\n\nDer Panzer bewegt und dreht sich basierend auf deiner gewählten Bewegungsrichtung.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Alternativ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Ändert die Spielweise dieses Panzers.\n\nDer Panzer bewegt sich basierend auf der Ausrichtung der Wanne, <color=#fc8080>dreht sich aber nicht automatisch in die Bewegungsrichtung</color>.  Dies geschieht durch <style=cIsUtility>manuelles Wenden</style>.\n\nIm Flug kehrt die Steuerung auf Standard zurück.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Leistungsmodus: <style=cIsUtility>Ausweichen</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Verringert die Angriffsgeschwindigkeit um 50% und erhöht die Abklingzeit um 50% für zusätzliche 50% Geschwindigkeit, 10% Schubkraft und 50% Motorleistung.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Leistungsmodus: <color=#80fc80>Verteidigung</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "Opfert 70% Geschwindigkeit und 100% Schubkraft für 500 Rüstung.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Leistungsmodus: <style=cIsDamage>Angriff</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "Alle Waffen verursachen doppelten Schaden. Verringert Abklingzeiten um 33% und erhöht die Angriffsgeschwindigkeit um 33%, aber du verlierst ALLE Rüstung und Heilung. Das Aktivieren dieses Modus setzt deinen Panzer für 2 Sekunden unter Strom.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "Und gerade als man dachte, Dedee wäre endlich frei, \r\nwurde er erneut von der UES eingefangen.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "Turmlos",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "Entfernt den Geschützturm.  <style=cIsDamage>Erhöht jeglichen Schaden um 30%</style>"
  }
}