        "SHOOT_GOLDGUN_DESCRIPTION": "<style=cIsUtility>Agile</style>. Fire a golden gun for <style=cIsDamage>99,999% damage</style>.",
        "SHOOT_ATM_NAME": "ATM Launcher",
        "SHOOT_ATM_DESCRIPTION": "<style=cIsUtility>Agile</style>. Fire a rocket for <style=cIsDamage>8,000% damage</style>.",
        "SHOOT_GRENADELAUNCHER_NAME": "Grenade Launcher",
        "SHOOT_GRENADELAUNCHER_DESCRIPTION": "<style=cIsUtility>Agile</style>. Fire a grenade for <style=cIsDamage>3,200% damage</style>.",
        "PRIMARY_CQC_NAME": "CQC",
        "PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Draw.</style> <style=cIsDamage>Strike</style> melee combatants for <style=cIsDamage>200% and 250% damage</style>, inflicting <style=cIsHealth>Mangled</style>.",
        "SECONDARY_AIM_NAME": "Aim Steadily",
        "SECONDARY_AIM_DESCRIPTION": "<style=cIsUtility>Aim</style> to improve your current weapon's accuracy.",
        "UTILITY_PARRY_NAME": "Parry",
        "UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Parry</style> to deflect attacks. If used preemptively to <style=cIsUtility>avoid an attack</style>, perform a <style=cIsDamage>Perfect Dodge</style>.",
        "UTILITY_DODGE_NAME": "Slide",
        "UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Slide</style> a short distance. If used preemptively to <style=cIsUtility>avoid an attack</style>, perform a <style=cIsDamage>Perfect Dodge</style>.",
        "UTILITY_BASH_NAME": "Deflection",
        "UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Deflect</style> nearby enemies, <style=cIsUtility>stunning them</style> for <style=cIsDamage>400% damage</style>. If used preemptively to <style=cIsUtility>cancel an attack</style>, perform a <style=cIsDamage>Perfect Deflection</style>.",
        "SPECIAL_SWAP_NAME": "Legion",
        "SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Swap</style> your current weapon.",
        "ROB_HUNK_KEYWORD_MANGLED": "<style=cKeywordName>Mangled</style><style=cSub>Upon reaching 6 stacks of this debuff, enemies suffer an instant <style=cIsDamage>2200% damage</style>.</style>",
        "ROB_HUNK_KEYWORD_COUNTERATTACK": "Counterattack",
        "ROB_HUNK_KEYWORD_PERFECTDODGE": "<style=cKeywordName>Perfect Dodge</style><style=cSub><style=cIsUtility>Refund cooldown</style> and become briefly invulnerable. Allows you to perform a <style=cIsDamage>Counterattack</style>.</style>",
        "ROB_HUNK_KEYWORD_PERFECTBASH": "<style=cKeywordName>Perfect Bash</style><style=cSub><style=cIsUtility>Refund cooldown</style> and become briefly invulnerable. Allows you to perform a <style=cIsDamage>Counterattack</style>.</style>",
        "ROB_HUNK_KEYWORD_CVIRUS": "<style=cKeywordName>C-Virus</style><style=cSub>Once every stage, several monsters become <color=#FF0033>Infected</color>. Upon death these monsters go on a <style=cIsDamage>frenzy</style> for <style=cIsUtility>5</style> seconds and then <style=cIsHealth>explode</style>, and killing all of them nets you a <color=#FFFF00>C-Virus Sample</color>.</style>",
        "ROB_HUNK_KEYWORD_LOOTING": "<style=cKeywordName>Looting</style><style=cSub>Enemies slain with this skill have a small chance to drop ammo.</style>",
        "ROB_HUNK_TRANSCEIVER_NAME": "Worn Transceiver",
        "ROB_HUNK_TRANSCEIVER_DESC": "Calls a squadmate to assist in your operation.",
        "ROB_HUNK_TYPEWRITER_NAME": "Typewriter",
        "ROB_HUNK_TYPEWRITER_DESC": "Grants <style=cIsUtility>2</style> additional <color=#C80202>Umbrella weapon cases</color> per Stage.",
        "ROB_HUNK_JETPACK_NAME": "Experimental Jump Pack",
        "ROB_HUNK_JETPACK_DESC": "A tool made by Umbrella that allows you to propel yourself in any direction by pressing jump in the air.",
