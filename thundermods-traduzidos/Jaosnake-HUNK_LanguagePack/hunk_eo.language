    "ROB_HUNK_WEAPON_MAGNUM_NAME": "Lightning Hawk",
    "ROB_HUNK_WEAPON_MAGNUM_DESC": "Facile manipulebla magnumo kun alta potenco.",
    "ROB_HUNK_WEAPON_ADDON_MAGNUM_NAME": "Longa Tubo (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON_MAGNUM_DESC": "Speciala parto por la Lightning Hawk, kiu plifortigas gxian damagxon al 3000%.",
    "ROB_HUNK_WEAPON_ADDON2_MAGNUM_NAME": "Lasera Celilo (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON2_MAGNUM_DESC": "Speciala parto por la Lightning Hawk. Aldonas celilon, kiu plifortigas gxian efikecon trafante malfortajn punktojn.",
    "ROB_HUNK_WEAPON_ADDON3_MAGNUM_NAME": "Rezervaj Kartocxoj (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON3_MAGNUM_DESC": "Speciala parto por la Lightning Hawk, kiu grandege pligrandigas la kvanton de prenitaj MAG-kartocxoj.",
    "ROB_HUNK_WEAPON_SHOTGUN_NAME": "W-870",
    "ROB_HUNK_WEAPON_SHOTGUN_DESC": "Pumpaga kuglpafilo de kalibro 12.",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_NAME": "Kartocxoj Draka Spiro (Kuglpafilo)",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_DESC": "Speciala parto por cxiuj Kuglpafiloj. Anstatauxigas kartocxojn per bruligaj municioj, kiuj kauxzas pli da damagxo kaj ekbruligas.",
    "ROB_HUNK_WEAPON_SLUGGER_NAME": "Slugger",
    "ROB_HUNK_WEAPON_SLUGGER_DESC": "4-kartocxa pumpaga kuglpafilo de kalibro 12, kiu pafas pezajn plenajn kuglojn.",
    "ROB_HUNK_WEAPON_M3_NAME": "M3",
    "ROB_HUNK_WEAPON_M3_DESC": "Duonauxtomata kuglpafilo.",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_NAME": "Street Sweeper",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_DESC": "Plene auxtomata kuglpafilo.",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_NAME": "Kontrauxtanka Raketo",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_DESC": "Raketjxetilo kun detrua potenco.",
    "ROB_HUNK_WEAPON_ATM_NAME": "ATM-4",
    "ROB_HUNK_WEAPON_ATM_DESC": "Senlima senretropusxa raketjxetilo. Malpeza kaj facile manipulebla, cxi tiu armilo havas multan potencon.",
    "ROB_HUNK_WEAPON_ATM2_NAME": "Prototipo ATM-4",
    "ROB_HUNK_WEAPON_ATM2_DESC": "Senretropusxa raketjxetilo, kiu pafas 84mm-projektilojn. La trapika forto de la raketo kauxzas pli da damagxo ol la eksplodo.",
    "ROB_HUNK_WEAPON_RPG_NAME": "RPG",
    "ROB_HUNK_WEAPON_RPG_DESC": "Raketjxetilo kun detrua potenco.",
    "ROB_HUNK_WEAPON_REVOLVER_NAME": "Quickdraw Army",
    "ROB_HUNK_WEAPON_REVOLVER_DESC": "Malnovmoda revolvero, kiu uzas magnumajn kartocxojn.",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_NAME": "Rapidsxargilo (Quickdraw Army)",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_DESC": "Speciala parto por la Quickdraw Army, permesante al vi plenigi vian tamburon pli rapide kiam gxi estas malplena.",
    "ROB_HUNK_WEAPON_FLAMETHROWER_NAME": "Kemia Flamjxetilo",
    "ROB_HUNK_WEAPON_FLAMETHROWER_DESC": "Armilo fabrikita de Umbrella, kiu uzas premitan gason por produkti ardegajn flamojn. Portebla kaj replenigebla, gxi cxiam estas preta por longa batalo.",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_NAME": "Reguligilo (Kemia Flamjxetilo)",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_DESC": "Speciala parto por la flamjxetilo. Limigas la uzon de likva fuelo kaj kunpremita gaso, ebligante pafi multe pli longe.",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_NAME": "Altkvalita Fuelujo (Kemia Flamjxetilo)",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_DESC": "Speciala parto por la flamjxetilo. Plifortigas la potencon de la flamoj, lasante spurojn de fajro sur la grundo.",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_NAME": "GM-79",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_DESC": "Unupafa baskultuba grenadjxetilo kapabla pafi flaman municion.",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_NAME": "Sxultra Kolbo (GM-79)",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_DESC": "Speciala parto por la GM-79, kiu forte reduktas retropusxon kaj donas al cxiu pafo pli stabilan trajektorion.",
    "ROB_HUNK_WEAPON_MGL_NAME": "MGL",
    "ROB_HUNK_WEAPON_MGL_DESC": "Duonauxtomata prototipo de grenadjxetilo kapabla pafi eksplodajn grenadojn.",
    "ROB_HUNK_WEAPON_ADDON_MGL_NAME": "Riparita Tamburo (MGL)",
    "ROB_HUNK_WEAPON_ADDON_MGL_DESC": "Speciala parto por la MGL. Anstatauxigas la rompitan tamburon per funkcianta, ebligante duonauxtomatan pafadon.",
    "ROB_HUNK_WEAPON_GOLDGUN_NAME": "Ora Pafilo",
    "ROB_HUNK_WEAPON_GOLDGUN_DESC": "1-kartocxa pistolo kapabla mortigi ion ajn per nur unu pafo.",
    "ROB_HUNK_WEAPON_BLUEROSE_NAME": "Blue Rose",
    "ROB_HUNK_WEAPON_BLUEROSE_DESC": "Ses-kamera revolvero, kiu pafas du pafojn samtempe? Kia frenezulo elpensas ion tian?",
    "ROB_HUNK_WEAPON_AR_NAME": "CQBR",
    "ROB_HUNK_WEAPON_AR_DESC": "Fusilo kapabla je plene auxtomata pafado.",
    "ROB_HUNK_WEAPON_ADDON_AR_NAME": "Bajoneto (CQBR)",
    "ROB_HUNK_WEAPON_ADDON_AR_DESC": "Speciala parto por la CQBR, kiu anstatauxigas vian Bataltrancxilon kaj kauxzas 600% da damagxo.",
    "ROB_HUNK_WEAPON_RAILGUN_NAME": "Feromagneta Infanteria Venontgeneracia Relpafilo",
    "ROB_HUNK_WEAPON_RAILGUN_DESC": "Portebla relkanono evoluigita de Cornell Garner kaj la usona armeo por elimini bioarmilojn okaze de epidemio.",
    "ROB_HUNK_WEAPON_MINIGUN_NAME": "Minigun",
    "ROB_HUNK_WEAPON_MINIGUN_DESC": "Sestuba motorizita minigun, kiu pafas 7.62mm NATO-kartocxojn. Nekredeble rapida pafado kaj kauxzas amason da damagxo.",
    "ROB_HUNK_WEAPON_COLT_NAME": "Colt Single Action Army",
    "ROB_HUNK_WEAPON_COLT_DESC": "La plej granda pistolo iam ajn fabrikita.",
    "ROB_HUNK_WEAPON_ADDON_COLT_NAME": "Longa Tubo (Colt)",
    "ROB_HUNK_WEAPON_ADDON_COLT_DESC": "Speciala parto por la Colt, kiu plifortigas gxian damagxon al 4800%.",
    "ROB_HUNK_WEAPON_SPARKSHOT_NAME": "Spark Shot",
    "ROB_HUNK_WEAPON_SPARKSHOT_DESC": "Alttensia pafilo por uzo sur eksperimentaj bestoj. Sxargado prenas iom da tempo kaj la dratoj de la nadloj facile rompigxas, sed gxi ankaux vere forte frapas.",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_NAME": "Alttensia Kondensilo (Spark Shot)",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_DESC": "Speciala parto por la Spark Shot. Ebligas konservi grandan kvanton da alttensia elektro, reduktante la tempon inter pafoj.",
    "ROB_HUNK_WEAPON_SSG_NAME": "SSG",
    "ROB_HUNK_WEAPON_SSG_DESC": "Kompakta baskultuba kuglpafilo kun vasta disjxeto.",
    "ROB_HUNK_WEAPON_SHIELD_NAME": "Kontrauxribela Sxildo",
    "ROB_HUNK_WEAPON_SHIELD_DESC": "Blokas tiun fekan acxan laseron.",
    "ROB_HUNK_WEAPON_SCANNER_NAME": "EMF-Skanilo",
    "ROB_HUNK_WEAPON_SCANNER_DESC": "Aparato kapabla lokalizi certajn elektronikajxojn.",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_NAME": "Hokpafilo",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_DESC": "Pafas alkrocxhokon ligitan al glitkablo, kiu permesas al vi propulsi vin al ajna dezirata loko.",
    "ROB_HUNK_WEAPON_FRAG_NAME": "Splitgrenado",
    "ROB_HUNK_WEAPON_FRAG_DESC": "",
    "ROB_HUNK_WEAPON_FLASHBANG_NAME": "Blindiga Grenado",
    "ROB_HUNK_WEAPON_FLASHBANG_DESC": "",
    "ROB_HUNK_WEAPON_STICKYBOMB_NAME": "Glua Bombo",
    "ROB_HUNK_WEAPON_STICKYBOMB_DESC": "",
    "ROB_HUNK_WEAPON_BEHEMOTH_NAME": "Brila Behemoto",
    "ROB_HUNK_WEAPON_BEHEMOTH_DESC": "",
    "ROB_HUNK_WEAPON_ATM4_NAME": "ATM-4",
    "ROB_HUNK_WEAPON_ATM4_DESC": "Senretropusxa raketjxetilo, kiu pafas 84mm-projektilojn. La trapika forto de la raketo kauxzas pli da damagxo ol la eksplodo.",
