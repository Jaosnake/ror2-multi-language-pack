    "ROB_HUNK_WEAPON_ADDON_MAGNUM_NAME": "Cañón Largo (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON_MAGNUM_DESC": "Una pieza personalizada para la Lightning Hawk que aumenta su daño al 3000%.",
    "ROB_HUNK_WEAPON_ADDON2_MAGNUM_NAME": "Mira Láser (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON2_MAGNUM_DESC": "Una pieza personalizada para la Lightning Hawk. Añade una mira que mejora su eficacia al impactar puntos débiles.",
    "ROB_HUNK_WEAPON_ADDON3_MAGNUM_NAME": "Balas de Repuesto (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON3_MAGNUM_DESC": "Una pieza personalizada para la Lightning Hawk que aumenta drásticamente la cantidad de balas MAG recogidas.",
    "ROB_HUNK_WEAPON_SHOTGUN_NAME": "W-870",
    "ROB_HUNK_WEAPON_SHOTGUN_DESC": "Una escopeta de corredera calibre 12.",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_NAME": "Cartuchos Aliento de Dragón (Escopeta)",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_DESC": "Una pieza personalizada para todas las escopetas. Reemplaza los cartuchos por munición incendiaria que inflige más daño e incendia.",
    "ROB_HUNK_WEAPON_SLUGGER_NAME": "Slugger",
    "ROB_HUNK_WEAPON_SLUGGER_DESC": "Escopeta de corredera calibre 12 con capacidad para 4 cartuchos que dispara postas pesadas.",
    "ROB_HUNK_WEAPON_M3_NAME": "M3",
    "ROB_HUNK_WEAPON_M3_DESC": "Una escopeta semiautomática.",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_NAME": "Street Sweeper",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_DESC": "Una escopeta totalmente automática.",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_NAME": "Cohete Antitanque",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_DESC": "Un lanzacohetes de poder devastador.",
    "ROB_HUNK_WEAPON_ATM_NAME": "ATM-4",
    "ROB_HUNK_WEAPON_ATM_DESC": "Un lanzacohetes sin retroceso con munición ilimitada. Ligero y fácil de manejar, esta arma posee un poder enorme.",
    "ROB_HUNK_WEAPON_ATM2_NAME": "Prototipo ATM-4",
    "ROB_HUNK_WEAPON_ATM2_DESC": "Un lanzacohetes sin retroceso que dispara proyectiles de 84mm. El poder de perforación del cohete causa más daño que la explosión.",
    "ROB_HUNK_WEAPON_RPG_NAME": "RPG",
    "ROB_HUNK_WEAPON_RPG_DESC": "Un lanzacohetes de poder devastador.",
    "ROB_HUNK_WEAPON_REVOLVER_NAME": "Quickdraw Army",
    "ROB_HUNK_WEAPON_REVOLVER_DESC": "Un revólver clásico que utiliza munición mágnum.",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_NAME": "Cargador Rápido (Quickdraw Army)",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_DESC": "Una pieza personalizada para el Quickdraw Army que te permite llenar el tambor más rápido cuando está vacío.",
    "ROB_HUNK_WEAPON_FLAMETHROWER_NAME": "Lanzallamas Químico",
    "ROB_HUNK_WEAPON_FLAMETHROWER_DESC": "Un arma fabricada por Umbrella que usa gas a presión para producir llamas al rojo vivo. Portátil y recargable, siempre lista para misiones largas.",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_NAME": "Regulador (Lanzallamas Químico)",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_DESC": "Una pieza personalizada para el lanzallamas. Restringe el consumo de combustible líquido y gas comprimido, permitiendo disparar durante mucho más tiempo.",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_NAME": "Tanque de Combustible de Alto Grado (Lanzallamas Químico)",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_DESC": "Una pieza personalizada para el lanzallamas. Aumenta la potencia de las llamas, dejando rastros de fuego en el suelo.",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_NAME": "GM-79",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_DESC": "Un lanzagranadas monotiro de cañón abatible capaz de disparar proyectiles incendiarios.",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_NAME": "Culata de Hombro (GM-79)",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_DESC": "Una pieza personalizada para el GM-79 que reduce enormemente el retroceso y otorga una trayectoria más estable a cada disparo.",
    "ROB_HUNK_WEAPON_MGL_NAME": "MGL",
    "ROB_HUNK_WEAPON_MGL_DESC": "Un prototipo de lanzagranadas semiautomático capaz de disparar proyectiles explosivos.",
    "ROB_HUNK_WEAPON_ADDON_MGL_NAME": "Tambor Reacondicionado (MGL)",
    "ROB_HUNK_WEAPON_ADDON_MGL_DESC": "Una pieza personalizada para el MGL. Reemplaza el tambor dañado por uno funcional, permitiendo el disparo semiautomático.",
    "ROB_HUNK_WEAPON_GOLDGUN_NAME": "Pistola Dorada",
    "ROB_HUNK_WEAPON_GOLDGUN_DESC": "Pistola con capacidad para 1 bala capaz de matar cualquier cosa de un solo disparo.",
    "ROB_HUNK_WEAPON_BLUEROSE_NAME": "Blue Rose",
    "ROB_HUNK_WEAPON_BLUEROSE_DESC": "¿Un revólver de seis recámaras que dispara dos tiros a la vez? ¿Qué clase de loco inventa algo así?",
    "ROB_HUNK_WEAPON_AR_NAME": "CQBR",
    "ROB_HUNK_WEAPON_AR_DESC": "Un rifle capaz de disparar en modo completamente automático.",
    "ROB_HUNK_WEAPON_ADDON_AR_NAME": "Bayoneta (CQBR)",
    "ROB_HUNK_WEAPON_ADDON_AR_DESC": "Una pieza personalizada para el CQBR que reemplaza tu Cuchillo de Combate e inflige 600% de daño.",
    "ROB_HUNK_WEAPON_RAILGUN_NAME": "Cañón de Riel Ferromagnético de Nueva Generación para Infantería",
    "ROB_HUNK_WEAPON_RAILGUN_DESC": "Un cañón de riel portátil desarrollado por Cornell Garner y el ejército de EE. UU. para eliminar armas biológicas en caso de un brote.",
    "ROB_HUNK_WEAPON_MINIGUN_NAME": "Minigun",
    "ROB_HUNK_WEAPON_MINIGUN_DESC": "Una ametralladora rotativa motorizada de seis cañones que dispara balas 7.62mm OTAN. Cadencia de fuego increíblemente rápida e inflige muchísimo daño.",
    "ROB_HUNK_WEAPON_COLT_NAME": "Colt Single Action Army",
    "ROB_HUNK_WEAPON_COLT_DESC": "La mejor pistola jamás fabricada.",
    "ROB_HUNK_WEAPON_ADDON_COLT_NAME": "Cañón Largo (Colt)",
    "ROB_HUNK_WEAPON_ADDON_COLT_DESC": "Una pieza personalizada para el Colt que aumenta su daño al 4800%.",
    "ROB_HUNK_WEAPON_SPARKSHOT_NAME": "Spark Shot",
    "ROB_HUNK_WEAPON_SPARKSHOT_DESC": "Un arma de alto voltaje para uso en animales de prueba. Tarda un poco en cargar y los cables de las agujas se rompen con facilidad, pero pega durísimo.",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_NAME": "Condensador de Alto Voltaje (Spark Shot)",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_DESC": "Una pieza personalizada para el Spark Shot. Permite almacenar una gran cantidad de electricidad de alto voltaje, reduciendo el tiempo entre disparos.",
    "ROB_HUNK_WEAPON_SSG_NAME": "SSG",
    "ROB_HUNK_WEAPON_SSG_DESC": "Una escopeta compacta de cañón abatible con gran dispersión.",
    "ROB_HUNK_WEAPON_SHIELD_NAME": "Escudo Antidisturbios",
    "ROB_HUNK_WEAPON_SHIELD_DESC": "Bloquea ese maldito láser de porquería.",
    "ROB_HUNK_WEAPON_SCANNER_NAME": "Escáner EMF",
    "ROB_HUNK_WEAPON_SCANNER_DESC": "Un dispositivo capaz de localizar ciertos aparatos electrónicos.",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_NAME": "Lanzagarfios",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_DESC": "Dispara un gancho de agarre unido a una tirolesa que te permite impulsarte a cualquier ubicación deseada.",
    "ROB_HUNK_WEAPON_FRAG_NAME": "Granada de Fragmentación",
    "ROB_HUNK_WEAPON_FRAG_DESC": "",
    "ROB_HUNK_WEAPON_FLASHBANG_NAME": "Granada Aturdidora",
    "ROB_HUNK_WEAPON_FLASHBANG_DESC": "",
