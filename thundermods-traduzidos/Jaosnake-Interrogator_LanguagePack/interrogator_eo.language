{
    "eo": {
        "KENKO_INTERROGATOR_NAME": "Interrogator",
        "KENKO_INTERROGATOR_SUBTITLE": "Freneza turmentanto",
        "KENKO_INTERROGATOR_PASSIVE_NAME": "Turmentado",
        "KENKO_INTERROGATOR_PASSIVE_DESCRIPTION": "Interrogator povas trafi kaj esti trafata de aliancanoj kaj malamikoj. Atakantoj, kiuj trafas Interrogator, estas markitaj kulpaj.",
        "KENKO_INTERROGATOR_PRIMARY_SWING_DESCRIPTION": "Svingu vian bastonon antauxen, kauxzante <style=cIsDamage>320% damagxo</style>. Maltrafi la atakon kauxzas ke vi anstatauxe suferas <style=cIsDamage>damagxon</style>.",
        "KENKO_INTERROGATOR_SECONDARY_AFFRAY_DESCRIPTION": "Jxetu haketilon kiu kauxzas <style=cIsDamage>450% damagxo</style>. <style=cIsDamage>Mortiganto.</style> Se la haketilo mortigas la celon, aplikas Hemoraxion kaj Premon sur cxiujn en la areo.",
        "KENKO_INTERROGATOR_UTILITY_FALSIFY_DESCRIPTION": "Impulsu antauxen kauxzante <style=cIsDamage>390% damagxo</style> kaj aplikante Kulpon al trafitaj celoj.",
        "KENKO_INTERROGATOR_SPECIAL_CONVICT_NAME": "Kondamni",
        "KENKO_INTERROGATOR_SPECIAL_CONVICT_DESCRIPTION": "Dvobatigu Kulpan malamikon dum 10 sekundoj. Via primara ne plu frapas vin kaj donas stako de Kulpo cxe trafo. Dum la dvobato, ekstera damagxo al vi estas neata, sed damagxo al aliaj malamikoj krom la celo ankaux estas neata.",
        "KENKO_INTERROGATOR_SPECIAL_SCEPTER_CONVICT_NAME": "Puni",
        "KENKO_INTERROGATOR_SPECIAL_SCEPTER_CONVICT_DESCRIPTION": "Dvobatigu Kulpan malamikon dum 10 sekundoj. Via primara ne plu frapas vin kaj donas stako de Kulpo cxe trafo. Dum la dvobato, ekstera damagxo al vi estas neata, sed damagxo al aliaj malamikoj krom la celo ankaux estas neata.\n<color=#d299ff>SCEPTRO: Kondamni povas celi malamikojn sen kulpeco. Via damagxo ne plu estas nuligita, sed reduktita je 75%.</color>",
        "<style=cKeywordName>Slayer</style><style=cSub>Deals up to <style=cIsDamage>3x</style> damage against low health enemies.</style>": "<style=cKeywordName>Mortiganto</style><style=cSub>Kauxzas gxis <style=cIsDamage>3-oblan</style> damagxon kontraux malamikoj kun malmulta sano.</style>",
        "KENKO_INTERROGATOR_DESCRIPTION": "La Interrogator revelas en la doloro de aliaj. Ne havu tro da plezuro vundante viajn aliancanojn... aux jes.<color=#CCD3E0>\n\n< ! > Estu trafita de malamikoj, aliancanoj kaj ecx vi mem por akiri kromajn atributojn. Neniu estas sekura.\n\n< ! > Se vi havas objektojn aktivigxantajn kiam vi estas trafita, uzu Affray por kauxzi Hemoragion al vi mem. Sen doloro ne estas gajno.\n\n< ! > Falsify estas bona maniero devigi malamikojn esti markitaj kulpaj. Maletika? Kion vi celas?\n\n< ! > Uzu Convict kontraux kulpa celo por puni gxin. Kulpa gxis pruvo de senkulpeco.</color>",
        "<style=cKeywordName>Guilty</style><style=cSub>Grants <color=#FFBF66>Interrogator</color> <style=cIsDamage>attack speed</style>, <style=cIsHealing>health regen</style>, and <style=cIsDamage>damage</style> for each <color=#FFBF66>Guilty</color> target.</style>": "<style=cKeywordName>Kulpa</style><style=cSub>Cxiu kulpa celo donas al Interrogator atakrapidon, sanregeneradon kaj damagxon.</style>",
        "<style=cKeywordName>Ally Damage</style><style=cSub>Allies take and deal less damage to each other and <color=#FFBF66>Guilty</color> expires from them after 10 seconds.</style>": "<style=cKeywordName>Damagxo inter aliancanoj</style><style=cSub>Aliancanoj kauxzas kaj ricevas malpli da damagxo inter si; kulpeco malaperas de ili post 10 sekundoj.</style>",
        "<style=cKeywordName>Hemorrhage</style><style=cSub>Deal <style=cIsDamage>2000%</style> base damage over 15s. <i>Hemorrhage</i> can stack.</style>": "<style=cKeywordName>Hemoragio</style><style=cSub>Kauxzas 2000% de baza damagxo dum 15 sekundoj. Hemoragio povas stakigxi.</style>",
        "<style=cKeywordName>Pressured</style><style=cSub>Boost <style=cIsDamage>attack speed</style> and <style=cIsUtility>move speed</style> but lowers <style=cIsHealing>armor</style> and <style=cIsDamage>damage</style>.</style>": "<style=cKeywordName>Premita</style><style=cSub>Pliigas atakrapidon kaj movrapidon, sed malpliigas kirason kaj damagxon.</style>",
        "KENKO_INTERROGATOR_LORE": "Negxo mallauxte falis el la cxielo, kiel kutime por la regiono, en kiu Dylan sin trovis. Li kun sia tacxmento staris dejxoranta, atentante cxu dangxeron, cxu iun, kiu bezonis savon.\n\n\"Sinjoro, mi kredas ke mi vidas iun.\" La soldato turnis sin por alfronti sian superulon. La komandanto unue ne turnis sin, nur gruntis. Lia vocxo estis laca. La granda kvanto da homoj perditaj al cxi tiu planedo komencis elcxerpi ecx homojn kiel li, veteranon de la milito de 2019. Cxi tiu savoperacio estis katastrofo gxis nun, sen kalkuli tion, kio okazis al la skipo de la Contact Light.\n\n\"Gxi estas homo, mi certas,\" dauxrigis la soldato, returnante por alfronti la vastan blankan kavon, kun kelkaj arboj dise starantaj. Kaj li pravis: gxi estis persono, pigre promenanta tra negxo. La vetero hieraux nokte estis kosxmara: la elementa atako de la planedo kovris la valon per malvarma negxkovrajxo pli alta ol la genuoj, kaj nur la supra parto de la figuro estis videbla. \n\nDylan levis la kapon de la binokloj por vidi ke lia komandanto finfine frontas en la sama direkto kiel li.\n\n\"Sinjoro, cxu ni sendu iun?\" Dylan demandis.\n\n\"Ne,\" respondis lia komandanto.\n\nLa soldato reiris al la pejzagxo por momento. \"Kial?\"\n\n\"Gxi ne estas homo.\"\n\n\"..Certe aspektas kiel unu,\" diris la soldato dum li denove rigardis tra la binoklo.\n\n\"Almenaux ne vivanta.\"\n\n\"... Vi pensas, ke tiu planedo povus relevi la mortintojn?\"\n\n\"Mi ne surprizus\"\n\nLa soldato dauxre rigardis tra sia binoklo. Ju pli longe li rigardis la fremdulon, des pli sxajnaj farigxis la strangajxoj, kiuj maltrankviligis lian superulon. La sola vaganto portis grandan, nigran jakon, kies kapucxo havis dikan malpuran felon. La viro estis bone preparita por malvarma vetero, krom la fakto, ke la manikoj de la jako estis desxiritaj, elmontrante liajn brakojn. Li iomete turnis sin, permesante al la soldato rigardi lian torson: li portis norman brustkirason, same kiel tiun, kiun la soldato havis sur sia brusto, sed gxi estis pli malnova modelo, versxajne malmoderna je jaro aux pli. La orangxa farbo estis tute cxizita for, lasante la tre gratitan nigran metalan surfacon sensxirma. La kasko aspektis, ke gxi kongruas kun la brustkiraso; norma ekipajxo de Commando, iom malaktuala. La koloro estis iomete blankigita de la suno.\n\nKiu ajn- aux kio ajn gxi estis, gxi sxajnis kiel ruzo. Imitanto, kiu allogis homojn. Kvazaux io klopodus ludi homan, sed ne komprenis kio igis ion homan en la unua loko.\n\n\"...Jes, sinjoro. Vi versxajne pravas.\"\n\nTio, kion ili trovis la sekvan matenon, sxajnigis tiun aferon ecx malpli homa. Tacxmento de soldatoj, al kiu Dylan estis parto, estis sendita al skolta misio, kaj rememorante, kio okazis hieraux, la soldato konvinkis siajn kamaradojn kaj komandanton esplori, kien, aux de kie, la figuro promenas. La spuro de pasxoj kondukis ilin al brutala sceno: detruita tendaro de la Contact Light. Gxi estis malgranda kaj havis ne pli ol kvin homojn. Kvin kompatindaj animoj murditaj en manieroj, kiujn okuloj neniam povis vere kompreni, en maniero kiel neniu homo devus povi. Kaj tamen, estis neniuj mordmarkoj, neniuj ungegmarkoj, neniu skvamo, neniuj pecoj de gudro aux felo, neniuj sangospecimenoj de indigxenaj specioj: nenio estis ekstertera. Cxio estis homa.",
        "ACHIEVEMENT_KENKO_INTERROGATOR_MASTERYACHIEVEMENT_NAME": "Interrogator: Mastery",
        "ACHIEVEMENT_KENKO_INTERROGATOR_MASTERYACHIEVEMENT_DESCRIPTION": "Kiel Interrogator, venku en la ludo aux neniigu vin en Monsoon."
    }
}
