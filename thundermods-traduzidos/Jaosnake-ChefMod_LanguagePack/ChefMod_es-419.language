{
  "es-419": {
    "GNOMECHEF_NAME": "CHEF",
    "GNOMECHEF_SUBTITLE": "El Cocinero",
    "GNOMECHEF_DESCRIPTION": "CHEF es un robot cocinero capaz de servir raciones generosas incluso a las mayores multitudes.<style=cSub>\n\n< ! > Las cuchillas pueden golpear a los comensales en su regreso.\n\n< ! > Usa Glasear para desplazarte rápidamente por la cocina y evitar chocar con los comensales.\n\n< ! > Combina Glasear y Dorar para cocinar grandes porciones eficientemente.\n\n< ! > Sirve diferentes habilidades con Segunda Ración para adaptarte a los gustos de los comensales.</style>",
    "KEYWORD_GNOMECHEF_BOOST_DICE": "<style=cKeywordName>Picar</style><style=cSub>Lanza 16 cuchillas en esfera que infligen <style=cIsDamage>16x120% de daño</style>.</style>",
    "KEYWORD_GNOMECHEF_BOOST_SEAR": "<style=cKeywordName>Flambear</style><style=cSub>Abrasa a los clientes e inflige <style=cIsDamage>420%</style> a alta potencia. Los clientes glaseados reciben el doble de daño y se incendian por <style=cIsDamage>5x200% de daño</style>.</style>",
    "KEYWORD_GNOMECHEF_BOOST_GLAZE": "<style=cKeywordName>Marinar</style><style=cSub>Deja un rastro de aceite más largo.</style>",
    "KEYWORD_GNOMECHEF_BOOST_SLICE": "<style=cKeywordName>Juliana</style><style=cSub>Apuñala 16 veces. El número de puñaladas aumenta con la velocidad de ataque.</style>",
    "GNOMECHEF_PRIMARY_NAME": "Cortar",
    "GNOMECHEF_PRIMARY_DESCRIPTION": "<style=cIsUtility>Ágil</style>. Lanza una cuchilla hacia los clientes que inflige <style=cIsDamage>150% de daño</style>. Vuelve como un bumerán.",
    "GNOMECHEF_BOOSTED_PRIMARY_NAME": "Picar",
    "GNOMECHEF_BOOSTED_PRIMARY_DESCRIPTION": "<style=cIsUtility>Ágil</style>. Lanza 16 cuchillas en esfera que infligen <style=cIsDamage>16x120% de daño</style>. Vuelven como un bumerán.",
    "GNOMECHEF_SECONDARY_NAME": "Dorar",
    "GNOMECHEF_SECONDARY_DESCRIPTION": "<style=cIsDamage>Dora</style> a los clientes e inflige <style=cIsDamage>260% de daño</style> hasta dejarlos dorados, <style=cIsDamage>empujándolos</style>. El daño se <style=cIsDamage>duplica</style> contra clientes <style=cIsUtility>Glaseados</style>.",
    "GNOMECHEF_BOOSTED_SECONDARY_NAME": "Flambear",
    "GNOMECHEF_BOOSTED_SECONDARY_DESCRIPTION": "<style=cIsDamage>Abrasa</style> a los clientes e inflige <style=cIsDamage>420%</style> a alta potencia. Los clientes <style=cIsUtility>Glaseados</style> reciben <style=cIsDamage>doble</style> daño y se incendian por <style=cIsDamage>5x200% de daño</style>.",
    "GNOMECHEF_UTILITY_NAME": "Glasear",
    "GNOMECHEF_UTILITY_DESCRIPTION": "Deja un rastro de aceite que <style=cIsUtility>ralentiza a los clientes</style>. Los clientes <style=cIsUtility>Glaseados</style> explotan por <style=cIsDamage>78% de daño</style> al ser <style=cIsDamage>Dorados</style>.",
    "GNOMECHEF_BOOSTED_UTILITY_NAME": "Marinar",
    "GNOMECHEF_BOOSTED_UTILITY_DESCRIPTION": "Deja un rastro largo de aceite que <style=cIsUtility>ralentiza a los clientes</style>. Los clientes <style=cIsUtility>Glaseados</style> explotan por <style=cIsDamage>78% de daño</style> al ser <style=cIsDamage>Dorados</style>.",
    "GNOMECHEF_SPECIAL_NAME": "Segunda Ración",
    "GNOMECHEF_SPECIAL_DESCRIPTION": "Prepara un plato abundante y saludable que <style=cIsUtility>potencia la siguiente habilidad usada</style>.",
    "GNOMECHEF_SPECIAL_SCEPTER_NAME": "Menú Completo",
    "GNOMECHEF_SPECIAL_SCEPTER_DESCRIPTION": "Prepara un plato magistral que <style=cIsUtility>potencia las siguientes 2 habilidades usadas</style>.",
    "GNOMECHEF_ALTPRIMARY_NAME": "Rebanar",
    "GNOMECHEF_ALTPRIMARY_DESCRIPTION": "<style=cIsUtility>Ágil</style>. Apuñala a un cliente e inflige <style=cIsDamage>120% de daño</style>.",
    "GNOMECHEF_BOOSTED_ALTPRIMARY_NAME": "Juliana",
    "GNOMECHEF_BOOSTED_ALTPRIMARY_DESCRIPTION": "<style=cIsUtility>Ágil</style>. Apuñala a un cliente <style=cIsDamage>16 veces</style>. El número de puñaladas aumenta con la velocidad de ataque.",
    "GNOMECHEF_CHEFUNLOCKABLE_ACHIEVEMENT_NAME": "Mise en Place",
    "GNOMECHEF_CHEFUNLOCKABLE_UNLOCKABLE_NAME": "Mise en Place",
    "GNOMECHEF_CHEFUNLOCKABLE_ACHIEVEMENT_DESC": "Reúne una docena de ingredientes.",
    "GNOMECHEF_SLICEUNLOCKABLE_ACHIEVEMENT_NAME": "CHEF: Juego Completo",
    "GNOMECHEF_SLICEUNLOCKABLE_UNLOCKABLE_NAME": "CHEF: Juego Completo",
    "GNOMECHEF_SLICEUNLOCKABLE_ACHIEVEMENT_DESC": "Ten 40 cuchillas en el aire a la vez.",
    "GNOMECHEF_OUTRO_FLAVOR": "..y así partió, con nuevos ingredientes en mano.",
    "GNOMECHEF_OUTRO_FAILURE": "..y así desapareció, olvidando por completo su propósito original.",
    "GNOMECHEF_LORE": "DIRECTIVA: ENCONTRAR NUEVAS RECETAS PARA UNA NUTRICIÓN ÓPTIMA\n\nORDEN: EL JEFE DE COCINA HA SOLICITADO UNA COMIDA DE CELEBRACIÓN PARA LA TRIPULACIÓN TRAS LA MISIÓN\n\nLAS COMIDAS DE CELEBRACIÓN DEBEN PREPARARSE CON LA MÁXIMA CALIDAD POSIBLE\n\nLA COCINA PROPORCIONADA SERÁ SUFICIENTE\n\nLOS INGREDIENTES PROPORCIONADOS NO SERÁN SUFICIENTES\n\nEL TIEMPO HASTA EL PRÓXIMO REABASTECIMIENTO NO SERÁ SUFICIENTE\n\nPODRÍA HABER FLORA Y FAUNA LOCAL PARA USAR COMO INGREDIENTES\n\nPROCESO:\n\n• EXPLORAR LA FLORA Y FAUNA LOCAL\n\n• PROBAR EL CONTENIDO NUTRICIONAL Y LA SEGURIDAD DE LOS INGREDIENTES\n\n• CREAR UN PLAN DE COMIDA VIABLE\n\n• RECOLECTAR LOS INGREDIENTES APLICABLES\n\n• COCINAR LA COMIDA DE CELEBRACIÓN\n\n• LAS INSPECCIONES DEBEN REALIZARSE DIRECTAMENTE CON UNA UNIDAD CHEF PARA MAYOR EXACTITUD\n\n• SOLO LOS INGREDIENTES MÁS FRESCOS SERÁN SUFICIENTES"
  }
}
