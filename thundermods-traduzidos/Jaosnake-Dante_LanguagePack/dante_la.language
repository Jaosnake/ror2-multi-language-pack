{
    "la": {
        "ROB_DANTE_BODY_NAME": "<color=#B70027>Dante</color>",
        "ROB_NERO_BODY_NAME": "<color=#2150AF>Nero</color>",
        "ROB_VERGIL_BODY_NAME": "<color=#32D2FF>Vergil</color>",
        "ROB_DANTE_BODY_DESCRIPTION": "<color=#B70027>Dante</color> est venator daemonum praeclarus qui binis pistoliis et gladio pugnat.<color=#CCD3E0>\n\n< ! > Ebony & Ivory est certus ac constans fons damni.\n\n< ! > Quodque Devil Arm singularem motuum rationem possidet, experire modos directivos ut plurimum ex iis capias.\n\n< ! > Utere Trick ad actiones rescindendas et ictus adversos declinandos.\n\n< ! > Devil Trigger mirabilia et varia efficit.</color>",
        "ROB_DANTE_BODY_SUBTITLE": "Venator Daemonum Legendarius",
        "ROB_DANTE_BODY_LORE": "Scisne, opera mea melius explorare deberem antequam ea suscipio.\n\nVir quidam tabernam meam intrat loquens de monstris necandis. Rigidissimus ac compositus, militaris fortasse. Sclopetum gestat ubi bracchium sinistrum esse oportuerat. Negotium serium videtur.\n\nSaccum pecuniae tesseramque navis super mensam conicit. Hoc me per menses opipare sustentabit!\n\nSed aequo animo manere debeo, me difficilem praebere.\n\n'Opus diuturnum mercedem diuturnam poscit.'\n\n'Credo hoc animum tuum mutaturum.'\n\nPhotographema in mensam decidit. Ostendit virum inclusum in... vitro? Vultum eius discernere nequeo, sed illud phylacterium ubique agnoscerem.\n\nVir iste operam suam diligenter dedit. Oportet me navem conscendere, ut videtur.\n\n'Conventum est.'\n\nNunc per planetam mihi vagandum est sordes purganti.\n\nHebdomades quaerendi, interficiendi, supervivendi.\n\nSed <color=#32D2FF>eum</color> reperire debeo.\n\nOpus opus est, nonne?\n\n<color=#B70027>Let's rock.</color>",
        "ROB_DANTE_BODY_OUTRO_FLAVOR": "..et sic profectus est.",
        "ROB_DANTE_BODY_OUTRO_FAILURE": "..et sic evanuit.",
        "ROB_DANTE_BODY_DEFAULT_SKIN_NAME": "<color=#B70027>Usitatus</color>",
        "ROB_DANTE_BODY_MASTERY_SKIN_NAME": "<color=#B70027>Classicus</color>",
        "ROB_DANTE_BODY_TYPHOON_SKIN_NAME": "<color=#B70027>idk</color>",
        "ROB_DANTE_BODY_PRESTIGE_SKIN_NAME": "<color=#B70027>Dignitas</color>",
        "ROB_DANTE_BODY_AC_SKIN_NAME": "<color=#B70027>Rebooted</color>",
        "ROB_DANTE_BODY_DMC2_SKIN_NAME": "<color=#B70027>Veteranus</color>",
        "ROB_DANTE_BODY_DMC_SKIN_NAME": "<color=#B70027>El Donte</color>",
        "ROB_DANTE_BODY_SUPER_SKIN_NAME": "<color=#B70027>Super</color>",
        "ROB_DANTE_BODY_VERGIL_SKIN_NAME": "<color=#32D2FF>Vergil</color>",
        "ROB_DANTE_BODY_VERGILEX_SKIN_NAME": "<color=#32D2FF>Vergil EX</color>",
        "ROB_DANTE_BODY_MINECRAFT_SKIN_NAME": "<color=#B70027>Minecraft</color>",
        "ROB_DANTE_BODY_COMMANDO_SKIN_NAME": "Commando",
        "ROB_DANTE_BODY_LEON_SKIN_NAME": "Leon",
        "ROB_DANTE_BODY_DEFAULT_SKIN_DESC": "Habitus usitatus huius superstitis.",
        "ROB_DANTE_BODY_MASTERY_SKIN_DESC": "Egone debui animam eius tenebrosam LUUUUUUUUUUUUMINE implere!",
        "ROB_DANTE_BODY_TYPHOON_SKIN_DESC": "",
        "ROB_DANTE_BODY_PRESTIGE_SKIN_DESC": "Age, numquam album vestitum in opere gererem. Huiusmodi vestis est quam nuptiis servarem!",
        "ROB_DANTE_BODY_AC_SKIN_DESC": "Quid me hoc facit, genus quoddam Daemonis Digitalis?",
        "ROB_DANTE_BODY_DMC2_SKIN_DESC": "Hoc vestimentum sane mihi placet, dolendum est de reliquo illo opere in Vie de Marli.",
        "ROB_DANTE_BODY_DMC_SKIN_DESC": "Vocate me El Donte. El Donte occisor daemonum.",
        "ROB_DANTE_BODY_SUPER_SKIN_DESC": "Galea specus optime collustrat. Unum modo incommodum est: omnes te a milliario conspicere possunt.\n\n<color=#B70027>Metrum infinitum Devil Trigger concedit.</color>",
        "ROB_DANTE_BODY_VERGIL_SKIN_DESC": "In appetitu suo potentiae, ille vir pactum petiit cuius eum paeniteret.",
        "ROB_DANTE_BODY_VERGILEX_SKIN_DESC": "Etiam hic planeta infiniti certaminis nimis parvus ambobus evaderet.",
        "ROB_DANTE_BODY_MINECRAFT_SKIN_DESC": "",
        "ROB_DANTE_BODY_COMMANDO_SKIN_DESC": "Si quempiam ex illis militibus UES in latrina dormientem sine armatura inveneris, modo neglege ac procede.",
        "ROB_DANTE_BODY_LEON_SKIN_DESC": "Heu, labor hic durus est. Hic locus vel daemonem flere cogere possit!",
        "ROB_DANTE_BODY_PASSIVE_NAME": "<color=#B70027>Son of Sparda</color>",
        "ROB_DANTE_BODY_PASSIVE_DESCRIPTION": "<color=#B70027>Dante</color> aditu ad varias <style=cIsDamage>singulares facultates</style> fruitur. <style=cIsUtility>Cursor appone ad plura cognoscenda.</style>",
        "ROB_DANTE_BODY_CONFIRM_NAME": "Confirmare",
        "ROB_DANTE_BODY_CONFIRM_DESCRIPTION": "Perge cum peritia praesenti.",
        "ROB_DANTE_BODY_CANCEL_NAME": "Abrogare",
        "ROB_DANTE_BODY_CANCEL_DESCRIPTION": "Abroga peritiam praesentem.",
        "ROB_DANTE_BODY_PRIMARY_NAME": "<color=#B70027>Ebony & Ivory</color>",
        "ROB_DANTE_BODY_PRIMARY_DESCRIPTION": "Celeriter emitte ad <style=cIsDamage>100% damni</style>. Desine emittere per <style=cIsUtility>1 secundum</style> ut <style=cIsDamage>Ictum Oneratum</style> ad <style=cIsDamage>500% damni</style> pares.",
        "ROB_NERO_BODY_PRIMARY_NAME": "<color=#2150AF>Blue Rose</color>",
        "ROB_NERO_BODY_PRIMARY_DESCRIPTION": "Bis emitte, ad <style=cIsDamage>200% damni</style> et <style=cIsDamage>350% damni</style>. Tene ut <style=cIsDamage>Ictum Oneratum</style> ad <style=cIsDamage>800% damni</style> pares.",
        "ROB_VERGIL_BODY_PRIMARY_NAME": "<color=#32D2FF>Summon Swords</color>",
        "ROB_VERGIL_BODY_PRIMARY_DESCRIPTION": "Gladios phantasmaticos emitte ad <style=cIsDamage>200% damni</style>.",
        "ROB_DANTE_BODY_MELEE_NAME": "<color=#B70027>Lock & Load</color>",
        "ROB_DANTE_BODY_MELEE_DESCRIPTION": "<style=cIsUtility>Telum gestatum</style> expedi. <style=cIsDamage>Primarius</style> impetus fit <style=cIsDamage>Comminus</style> dum exertum est.",
        "ROB_DANTE_BODY_UTILITY_NAME": "<color=#B70027>Trick</color>",
        "ROB_DANTE_BODY_UTILITY_DESCRIPTION": "<style=cIsUtility>In unam partem praecipita</style>, breviter <style=cIsUtility>invulnerabilis</style> effectus. <style=cIsDamage>Variantes directivas singulares</style> habet.",
        "ROB_DANTE_BODY_SPECIAL_DEVILTRIGGER_NAME": "<color=#A556FF>Devil Trigger</color>",
        "ROB_DANTE_BODY_SPECIAL_DEVILTRIGGER_DESCRIPTION": "<color=#B70027>Hellbent.</color> Activa <color=#A556FF>Devil Trigger</color>, metro exhausto ad <style=cIsUtility>armaturam</style>, <style=cIsHealing>regenerationem</style> et <style=cIsDamage>damnum</style> ad tempus consequendum. <style=cIsUtility>Ictus comminus metrum replent.</style>",
        "ROB_DANTE_BODY_SPECIAL_DEVILTRIGGER_SCEPTER_NAME": "<color=#A556FF>Perfect Devil Trigger</color>",
        "ROB_DANTE_BODY_SPECIAL_DEVILTRIGGER_SCEPTER_DESCRIPTION": "<color=#B70027>Hellbent.</color> Activa <color=#A556FF>Devil Trigger</color>, metro exhausto ad <style=cIsUtility>armaturam</style>, <style=cIsHealing>regenerationem</style> et <style=cIsDamage>damnum</style> ad tempus consequendum. <style=cIsUtility>Ictus comminus metrum replent.</style>\n<color=#d299ff>SCEPTRUM: Hostes gladiis evocatis vasta dum actuosum est.</color>",
        "ROB_DANTE_BODY_SPECIAL_SDT_NAME": "<color=#FF2E00>Sin Devil Trigger</color>",
        "ROB_DANTE_BODY_SPECIAL_SDT_DESCRIPTION": "<style=cIsUtility>Tene</style> ad metrum infundendum in <color=#FF2E00>Sin Devil Trigger</color> metrum. <style=cIsUtility>Tene</style> cum plenum sit ut <style=cIsDamage>veram formam daemonicam</style> ad breve tempus liberes.",
        "ROB_DANTE_BODY_SPECIAL_SDT_SCEPTER_NAME": "<color=#FF2E00>Perfect Sin Devil Trigger</color>",
        "ROB_DANTE_BODY_SPECIAL_SDT_SCEPTER_DESCRIPTION": "<style=cIsUtility>Tene</style> ad metrum infundendum in <color=#FF2E00>Sin Devil Trigger</color> metrum. <style=cIsUtility>Tene</style> cum plenum sit ut <style=cIsDamage>veram formam daemonicam</style> ad breve tempus liberes.\n<color=#d299ff>SCEPTRUM: Hostes gladiis evocatis vasta dum actuosum est.</color>",
        "ROB_DANTE_BODY_SPECIAL_PISTOL_NAME": "Silver Bullet",
        "ROB_DANTE_BODY_SPECIAL_PISTOL_DESCRIPTION": "Emitte <style=cIsUtility>argenteam glandem</style> ad <style=cIsDamage>800% damni</style>. <style=cIsUtility>Ictus in caput</style> <style=cIsDamage>duplum damnum</style> inferunt. Caedes <style=cIsUtility>omnia tempora refrigerationis restituunt</style>.",
        "ROB_DANTE_BODY_SPECIAL_PISTOL_SCEPTER_NAME": "Golden Gun",
        "ROB_DANTE_BODY_SPECIAL_PISTOL_SCEPTER_DESCRIPTION": "Emitte <style=cIsUtility>argenteam glandem</style> ad <style=cIsDamage>800% damni</style>. <style=cIsUtility>Ictus in caput</style> <style=cIsDamage>duplum damnum</style> inferunt. Caedes <style=cIsUtility>omnia tempora refrigerationis restituunt</style>.\n<color=#d299ff>SCEPTRUM: 9000% damni infert.</color>",
        "ROB_DANTE_BODY_SPECIAL_HOLYCROSS_NAME": "Sacred Flame",
        "ROB_DANTE_BODY_SPECIAL_HOLYCROSS_DESCRIPTION": "Potentiam <color=#FF0033>Providentiae</color> invoca, <style=cIsUtility>ingentem flammam</style> emittens ad <style=cIsDamage>300% damni per pulsationem</style>. Supernova <style=cIsDamage>4000% damni</style> consummatur.",
        "ROB_DANTE_BODY_LOADOUT_SKILL_MISC": "Passiva",
        "ROB_DANTE_DEVILSHRINE_NAME": "Shrine of the Night",
        "ROB_DANTE_DEVILSHRINE_DESC": "Non satis mihi solvitur ut haec scribam.",
        "ROB_DANTE_DEVILSHRINE_CONTEXT": "Ad Shrine of the Night precare",
        "ROB_DANTE_TREASURECHEST_NAME": "Arca Thesauri",
        "ROB_DANTE_TREASURECHEST_DESC": "SVCCVRRITE MIHI",
        "ROB_DANTE_TREASURECHEST_CONTEXT": "Utere clave et aperi",
        "ROB_DANTEKEYCOST": "Clavis Laconica",
        "ROB_DANTE_KEYFRAGMENT_NAME": "Fragmentum Clavis",
        "ROB_DANTE_KEYFRAGMENT_DESC": "Pars fracta clavis. Collige 3 ad integram clavem conficiendam.",
        "ROB_DANTE_KEYFRAGMENT_PICKUP": "Pars fracta clavis. Collige 3 ad integram clavem conficiendam.",
        "ROB_DANTE_KEYFRAGMENT_LORE": "",
        "ROB_DANTE_KEY_NAME": "Clavis Laconica",
        "ROB_DANTE_KEY_DESC": "Adhibetur ad aperiendam <color=#FFFF00>Arcam Thesauri</color>. Hae arcae continent <color=#FF0033>sacram reliquiam</color> et oriri solent <style=cIsUtility>quarto</style> quoque stadio in <style=cIsDamage>loco fixo</style>.",
        "ROB_DANTE_KEY_PICKUP": "Adhibetur ad aperiendam Arcam Thesauri. Prope arcam lucet.",
        "ROB_DANTE_KEY_LORE": "",
        "ROB_DANTE_REBELLION_NAME": "Rebellion",
        "ROB_DANTE_REBELLION_DESC": "gladius",
        "ROB_DANTE_REBELLION_PICKUP": "gladius",
        "ROB_DANTE_REBELLION_LORE": "",
        "ROB_DANTE_TITAN_NAME": "Titan",
        "ROB_DANTE_TITAN_DESC": "pulsator annorum 1.000.000.000.000.000.000",
        "ROB_DANTE_TITAN_PICKUP": ".",
        "ROB_DANTE_TITAN_LORE": "",
        "ROB_DANTE_QUEEN_NAME": "Queen",
        "ROB_DANTE_QUEEN_DESC": "Bina scuta magna, aptissima ad ictus validos et multitudinem moderandam.",
        "ROB_DANTE_QUEEN_PICKUP": "Bina scuta magna gravia.",
        "ROB_DANTE_QUEEN_LORE": "",
        "ROB_DANTE_MITHRIX_NAME": "Mithrix",
        "ROB_DANTE_MITHRIX_DESC": "Ille",
        "ROB_DANTE_MITHRIX_PICKUP": "",
        "ROB_DANTE_MITHRIX_LORE": "",
        "ROB_DANTE_BROTHERSOUL_NAME": "Soul of the King",
        "ROB_DANTE_BROTHERSOUL_DESC": "Singuli <style=cIsUtility>flagelli ictus</style> <style=cIsDamage>columnam flammae lunaris</style> gignunt, singuli <style=cIsUtility>gladii ictus</style> <style=cIsDamage>fragmentum lunare</style> creant, singuli <style=cIsUtility>flagelli concussus</style> <style=cIsDamage>terrestres undas concussionis</style> emittunt et singuli <style=cIsUtility>cursus conciti</style> <style=cIsHealing>20% saepimenti</style> gignunt.",
        "ROB_DANTE_BROTHERSOUL_PICKUP": "Potentiam Regis Nihili quasi tuam gere.",
        "ROB_DANTE_BROTHERSOUL_LORE": "",
        "ROB_DANTE_ITEM_EFFECT_TITLE": "Effectus Additus",
        "ROB_DANTE_ITEM_EFFECT_BACKUPMAG": "Facultatem ad plures Ictus Oneratos servandos accipe.",
        "ROB_DANTE_ITEM_EFFECT_BANDOLIER": "Fasciculi telorum metrum restituunt.",
        "ROB_DANTE_ITEM_EFFECT_ALIENHEAD": "Devil Trigger minus metri consumit.",
        "ROB_DANTE_ITEM_EFFECT_BRAINSTALKS": "Devil Trigger nihil metri consumit dum actuosus est.",
        "ROB_DANTE_ITEM_EFFECT_PURITY": "Metrum ictu partum auget.",
        "ROB_DANTE_ITEM_EFFECT_LYSATECELL": "Metrum maximum auget.",
        "ROB_DANTE_ITEM_EFFECT_LUMINOUSSHOT": "Oneratur dum telum exertum est. Revertitur cum id recondis.",
        "KEYWORD_HELLBENT": "<style=cKeywordName>Hellbent</style><style=cSub><style=cIsUtility>Semel in stadio</style>, sub <style=cIsHealth>25% salutis</style> delapsus metrum replet et gratuitum <color=#A556FF>Devil Trigger</color> largitur.</style>",
        "KEYWORD_SONOFSPARDA": "<style=cKeywordName>Devil Arms</style><style=cSub>Quorundam dominorum animae in arma acquirenda post mortem convertuntur. Tange Cursum cum telo exertum ut inter ea commutes.</style>\n\n<style=cKeywordName>Velocitas</style><style=cSub>Incredibili celeritate curre. In proelio excitari non potest.</style>\n\n<style=cKeywordName>Air Hike</style><style=cSub>Duplex saltus.</style>\n\n<style=cKeywordName>Enemy Step</style><style=cSub>Duplex saltus ex hoste innixus.</style>",
        "ROB_SINDANTE_BODY_NAME": "<color=#B70027>Dante (Sin Devil Trigger)</color>",
        "ROB_SINDANTE_BODY_DESCRIPTION": "<color=#B70027>Dante</color> est venator daemonum praeclarus qui binis pistoliis et gladio pugnat.<color=#CCD3E0>\n\n< ! > Ebony & Ivory est certus ac constans fons damni.\n\n< ! > Quodque Devil Arm singularem motuum rationem possidet, experire modos directivos ut plurimum ex iis capias.\n\n< ! > Utere Trick ad actiones rescindendas et ictus adversos declinandos.\n\n< ! > Devil Trigger mirabilia et varia efficit.</color>",
        "ROB_SINDANTE_BODY_SUBTITLE": "Venator Daemonum Legendarius",
        "ROB_SINDANTE_BODY_LORE": "Scisne, opera mea melius explorare deberem antequam ea suscipio.\n\nVir quidam tabernam meam intrat loquens de monstris necandis. Rigidissimus ac compositus, militaris fortasse. Sclopetum gestat ubi bracchium sinistrum esse oportuerat. Negotium serium videtur.\n\nSaccum pecuniae tesseramque navis super mensam conicit. Hoc me per menses opipare sustentabit!\n\nSed aequo animo manere debeo, me difficilem praebere.\n\n'Opus diuturnum mercedem diuturnam poscit.'\n\n'Credo hoc animum tuum mutaturum.'\n\nPhotographema in mensam decidit. Ostendit virum inclusum in... vitro? Vultum eius discernere nequeo, sed illud phylacterium ubique agnoscerem.\n\nVir iste operam suam diligenter dedit. Oportet me navem conscendere, ut videtur.\n\n'Conventum est.'\n\nNunc per planetam mihi vagandum est sordes purganti.\n\nHebdomades quaerendi, interficiendi, supervivendi.\n\nSed <color=#32D2FF>eum</color> reperire debeo.\n\nOpus opus est, nonne?\n\n<color=#B70027>Let's rock.</color>",
        "ROB_SINDANTE_BODY_OUTRO_FLAVOR": "..et sic profectus est.",
        "ROB_SINDANTE_BODY_OUTRO_FAILURE": "..et sic evanuit.",
        "ROB_SINDANTE_BODY_PASSIVE_NAME": "<color=#B70027>Son of Sparda</color>",
        "ROB_SINDANTE_BODY_PASSIVE_DESCRIPTION": "<color=#B70027>Dante</color> aditu ad varias <style=cIsDamage>singulares facultates</style> fruitur. <style=cIsUtility>Cursor appone ad plura cognoscenda.</style>",
        "ROB_SINDANTE_BODY_CONFIRM_NAME": "Confirmare",
        "ROB_SINDANTE_BODY_CONFIRM_DESCRIPTION": "Perge cum peritia praesenti.",
        "ROB_SINDANTE_BODY_CANCEL_NAME": "Abrogare",
        "ROB_SINDANTE_BODY_CANCEL_DESCRIPTION": "Abroga peritiam praesentem.",
        "ROB_SINDANTE_BODY_PRIMARY_NAME": "<color=#B70027>Devil Sword Dante</color>",
        "ROB_SINDANTE_BODY_PRIMARY_DESCRIPTION": "Contundens <style=cIsDamage>tribus stadiis series</style> quae <style=cIsDamage>plenum robur</style> ensis <color=#B70027>Devil Sword Dante</color> effundit.",
        "ROB_SINDANTE_BODY_SECONDARY_NAME": "<color=#B70027>The Ombra</color>",
        "ROB_SINDANTE_BODY_SECONDARY_DESCRIPTION": "<style=cIsDamage>Ictus energiae</style> e palmis tuis in hostem cum <style=cIsDamage>vi ingenti</style> impingunt.",
        "ROB_SINDANTE_BODY_UTILITY_NAME": "<color=#B70027>Advent</color>",
        "ROB_SINDANTE_BODY_UTILITY_DESCRIPTION": "<style=cIsDamage>Celeritate summa</style> move, hostem in <style=cIsUtility>ictu oculi</style> attingens.",
        "ROB_SINDANTE_BODY_SPECIAL_NAME": "<color=#A556FF>Judgement</color>",
        "ROB_SINDANTE_BODY_SPECIAL_DESCRIPTION": "<style=cIsDamage>Totam potentiam tuam</style> simul effunde, propinquos hostes in <style=cIsDamage>damno letifero</style> mergens. <style=cIsHealth>Totum metrum SDT consumit.</style>",
        "ROB_DANTE_BODY_SPECIAL_SCEPTER_NAME": "<color=#A556FF>Perfect Judgement</color>",
        "ROB_DANTE_BODY_SPECIAL_SCEPTER_DESCRIPTION": "<style=cIsDamage>Totam potentiam tuam</style> simul effunde, propinquos hostes in <style=cIsDamage>damno letifero</style> mergens. <style=cIsHealth>Totum metrum SDT consumit.</style>\n<color=#d299ff>SCEPTRUM: Hostes gladiis evocatis vasta dum actuosum est.</color>",
        "ROB_DANTE_WEAPON_REBELLION_NAME": "Rebellion",
        "ROB_DANTE_WEAPON_REBELLION_DESC": "Gladius memorialis a patre Dante datus. Haec lammina magica nondum plene evigilavit.",
        "ROB_DANTE_WEAPON_QUEEN_NAME": "Queen",
        "ROB_DANTE_WEAPON_QUEEN_DESC": "Bina scuta magna gravia.",
        "ROB_DANTE_WEAPON_TITAN_NAME": "Titan",
        "ROB_DANTE_WEAPON_TITAN_DESC": "Chirothecae vi lucis praeditae quae immensam vim perniciosam habent.",
        "ROB_DANTE_WEAPON_COLOSSUS_NAME": "Colossus",
        "ROB_DANTE_WEAPON_COLOSSUS_DESC": "Devil Arm ad pugnam comminus fabricatum, clausa Colossi potentia redundans. <color=#B70027>Titan auget.</color>",
        "ROB_DANTE_WEAPON_OVERLORD_NAME": "Overlord",
        "ROB_DANTE_WEAPON_OVERLORD_DESC": "Lammina potens quae foramina per dimensiones discindere potest.",
        "ROB_DANTE_WEAPON_YAMATO_NAME": "Yamato",
        "ROB_DANTE_WEAPON_YAMATO_DESC": "Lammina potens quae hominem a daemone separare potest.",
        "ROB_DANTE_WEAPON_SPARDA_NAME": "Devil Sword Sparda",
        "ROB_DANTE_WEAPON_SPARDA_DESC": "Gladius a patre Dante et Vergil, Sparda, gestus. Haec est vera forma gladii Force Edge.",
        "ROB_DANTE_WEAPON_DSD_NAME": "Devil Sword Dante",
        "ROB_DANTE_WEAPON_DSD_DESC": "Novus gladius daemonicus ex unione Rebellion et Sparda natus: gladius daemonicus Dante.",
        "ROB_DANTE_WEAPON_MIRAGEEDGE_NAME": "Mirage Edge",
        "ROB_DANTE_WEAPON_MIRAGEEDGE_DESC": "Telum ex ipsa Vergil energia infernali conformatum. Aliquid in hac lammina — in eius forma et ictibus — gladium Force Edge refert, quem pater eius olim gesserat.",
        "ROB_DANTE_WEAPON_MITHRIX_NAME": "Mithrix",
        "ROB_DANTE_WEAPON_MITHRIX_DESC": "Malleus praecipuus Regis Nihili.",
        "ROB_DANTE_WEAPON_REDQUEEN_NAME": "Red Queen",
        "ROB_DANTE_WEAPON_REDQUEEN_DESC": "",
        "ACHIEVEMENT_ROB_DANTE_COMPLETION_UNLOCKABLE_ACHIEVEMENT_ID_NAME": "Dante: Jackpot",
        "ACHIEVEMENT_ROB_DANTE_COMPLETION_UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Ut <color=#B70027>Dante</color>, ludum vince.",
        "ACHIEVEMENT_ROB_DANTE_MASTERY_UNLOCKABLE_ACHIEVEMENT_ID_NAME": "Dante: Mastery",
        "ACHIEVEMENT_ROB_DANTE_MASTERY_UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Ut <color=#B70027>Dante</color>, ludum vince vel te dele in Monsoon.",
        "ACHIEVEMENT_ROB_DANTE_SUPPORTER_ACHIEVEMENT_ID_NAME": "Dante: Unwavering Bravery",
        "ACHIEVEMENT_ROB_DANTE_SUPPORTER_ACHIEVEMENT_ID_DESCRIPTION": "<color=#B70027>Totam Dante potentiam resera.</color>",
        "ACHIEVEMENT_ROB_DANTE_QUEEN_ACHIEVEMENT_ID_NAME": "Devil Arm: Queen",
