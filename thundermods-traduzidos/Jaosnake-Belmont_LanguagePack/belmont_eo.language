{
    "eo": {
        "ROB_BELMONT_BODY_NAME": "<color=#3060FF>Belmont</color>",
        "ROB_BELMONT_BODY_NAME_ALT": "Cxasisto",
        "ROB_BELMONT_BODY_DESCRIPTION": "La <color=#3060FF>Belmont</color> estas elita monstrocxasisto kun la gxustaj iloj por cxiu situacio, kiom ajn terura.<color=#CCD3E0>\n\n< ! > Vipo kauxzas sekuran domagxon de malproksime, sed glavosvingoj kauxzas multe pli da domagxo entute.\n\n< ! > Rush estas la perfekta ilo por alproksimigxi kaj dissxiri per via glavo.\n\n< ! > Uzu Abscond por forpusxi flugantajn monstrojn kaj kovri grandajn distancojn.\n\n< ! > Ancient Flame povas esti uzata por facile forigi amason.</color>",
        "ROB_BELMONT_BODY_SUBTITLE": "Monstrocxasisto",
        "ROB_BELMONT_BODY_LORE": "Mi ne apartenas cxi tien.\n\nCxi tiu mondo fetoras je <color=#7F364F>korupto</color>. Ne la speco, kiu ulcerigxas en homaj koroj, nek la makulo de vampira regejo, sed io pli profunda—pli antikva. Gxi alkrocxigxas al la aero, saturas la grundon kaj tordas la bestojn, kiuj vagas tra cxi tiu forlasita lando. La luno supre rigardas, malproksima sed sufoka. Gxi estas malgxusta, kvazaux io sxtelita el gxia gxusta loko.\n\nKaj tamen, mi estis alportita cxi tien.\n\nSorto? Ne, mi neniam fidis tiajn nociojn. Kruela sxerco, eble, ludita de iu nevidebla mano. Unu momenton, la vento hurlis tra la haloj de mia cxaso, la odoro de sango kaj malnova sxtono en miaj pulmoj—la sekvan, mi falis. La cxielo estis fajrosturmo, la grundo rapide levigxis sub mi. <style=cIsHealth>Mi devus esti mortinta.</style>\n\nAnstataux tio, mi staras.\n\nDenove.\n\n<color=#FF0033>Cxiam.</color>",
        "ROB_BELMONT_BODY_OUTRO_FLAVOR": "..kaj tiel li foriris, lia virta vojagxo plenumita.",
        "ROB_BELMONT_BODY_OUTRO_FAILURE": "..kaj tiel li malaperis, la nobla sangolinio atingis finon.",
        "ROB_BELMONT_BODY_DEFAULT_SKIN_NAME": "<color=#3060FF>Defauxlta</color>",
        "ROB_BELMONT_BODY_MONSOON_SKIN_NAME": "<color=#3060FF>Ekzilo</color>",
        "ROB_BELMONT_BODY_MONSOON_ALTERNATE_SKIN_NAME": "<color=#3060FF>Ekzilo EX</color>",
        "ROB_BELMONT_BODY_LEON_SKIN_NAME": "<color=#3060FF>Prapatro</color>",
        "ROB_BELMONT_BODY_SOMA_SKIN_NAME": "<color=#3060FF>Reenkarnigxo</color>",
        "ROB_BELMONT_BODY_MORRIS_SKIN_NAME": "<color=#3060FF>Esploristo</color>",
        "ROB_BELMONT_BODY_JULIUS_SKIN_NAME": "<color=#3060FF>Pioniro</color>",
        "ROB_BELMONT_BODY_ISAAC_SKIN_NAME": "<color=#3060FF>Forgxestro</color>",
        "ROB_BELMONT_BODY_MINECRAFT_SKIN_NAME": "<color=#3060FF>Minecraft</color>",
        "ROB_BELMONT_BODY_PASSIVE_NAME": "Dia Sangolinio",
        "ROB_BELMONT_BODY_PASSIVE_DESCRIPTION": "Cxiu etagxo, <color=#7F364F>Sanktejo de la Nokto</color> aperas, donante <color=#FFFF00>Slosilfragmentojn</color> post plenumo. Cxi tiuj estas uzataj por akiri <style=cIsDamage>potencan ekipajxon</style> por <color=#3060FF>Belmont.</color>",
        "ROB_BELMONT_BODY_CONFIRM_NAME": "Konfirmi",
        "ROB_BELMONT_BODY_CONFIRM_DESCRIPTION": "Dauxrigu per la nuna lerteco.",
        "ROB_BELMONT_BODY_CANCEL_NAME": "Nuligi",
        "ROB_BELMONT_BODY_CANCEL_DESCRIPTION": "Nuligu la nunan lertecon.",
        "ROB_BELMONT_BODY_PRIMARY_NAME": "Purigi",
        "ROB_BELMONT_BODY_PRIMARY_DESCRIPTION": "<style=cIsUtility>Lerta.</style> Trancxu por <style=cIsDamage>260% da domagxo</style>. Se la celo estas malproksima, krakigu vian <style=cIsUtility>vipon</style> anstataux por <style=cIsDamage>700% da domagxo</style> kontraux gxi.",
        "ROB_BELMONT_BODY_PRIMARY2_NAME": "Elpeli",
        "ROB_BELMONT_BODY_PRIMARY2_DESCRIPTION": "<style=cIsUtility>Lerta.</style> Krakigu vian <style=cIsUtility>vipon</style> por <style=cIsDamage>300% da domagxo</style>. Se la celo estas proksima, <style=cIsDamage>trancxu</style> per via glavo por <style=cIsDamage>700% da domagxo</style>.",
        "ROB_BELMONT_BODY_SLIDEKICK_NAME": "Rush",
        "ROB_BELMONT_BODY_SLIDEKICK_DESCRIPTION": "<style=cIsUtility>Mira.</style> Glitu antauxen por <style=cIsDamage>350% da domagxo</style>. Premu salton dum glitado por salti tre alte.",
        "ROB_BELMONT_BODY_UTILITY_NAME": "Abscond",
        "ROB_BELMONT_BODY_UTILITY_DESCRIPTION": "Rapidu en direkton. <style=cIsUtility>Tenu</style> por tiam debalanci de <style=cIsDamage>celita malamiko</style> per via <style=cIsUtility>vipo</style>.",
        "ROB_BELMONT_BODY_UTILITY2_NAME": "Adjudicate",
        "ROB_BELMONT_BODY_UTILITY2_DESCRIPTION": "Faru gigantan suprenbaton por <style=cIsDamage>1200% da domagxo</style>.",
        "ROB_BELMONT_BODY_SPECIAL_HOLYWATER_NAME": "Ancient Flame",
        "ROB_BELMONT_BODY_SPECIAL_HOLYWATER_DESCRIPTION": "Jxetu vazon da <style=cIsUtility>spiretaj fragmentoj</style>, eksplodante kaj eligante <style=cIsDamage>kolonon de flamoj</style> por <style=cIsDamage>12x60% da domagxo</style> kaj <style=cIsDamage>bruligante</style> malamikojn.",
        "ROB_BELMONT_BODY_SPECIAL_HOLYWATER_SCEPTER_NAME": "Hellfire",
        "ROB_BELMONT_BODY_SPECIAL_HOLYWATER_SCEPTER_DESCRIPTION": "Jxetu vazon da <style=cIsUtility>spiretaj fragmentoj</style>, eksplodante kaj eligante <style=cIsDamage>kolonon de flamoj</style> por <style=cIsDamage>12x60% da domagxo</style> kaj <style=cIsDamage>bruligante</style> malamikojn.\n<color=#d299ff>SCEPTER: Eligas 3 flamokolonojn.</color>",
        "ROB_BELMONT_BODY_SPECIAL_CROSS_NAME": "Battle Cross",
        "ROB_BELMONT_BODY_SPECIAL_CROSS_DESCRIPTION": "Jxetu <style=cIsUtility>trapikantan krucon</style>, kiu trafas plurfoje por <style=cIsDamage>6x150% da domagxo</style> antaux ol reveni.",
        "ROB_BELMONT_BODY_SPECIAL_CROSS_SCEPTER_NAME": "Triple Cross",
        "ROB_BELMONT_BODY_SPECIAL_CROSS_SCEPTER_DESCRIPTION": "Jxetu <style=cIsUtility>trapikantan krucon</style>, kiu trafas plurfoje por <style=cIsDamage>6x150% da domagxo</style> antaux ol reveni.\n<color=#d299ff>SCEPTER: Jxetas 3 krucojn en disvastigo.</color>",
        "ROB_BELMONT_BODY_SPECIAL_PISTOL_NAME": "Silver Bullet",
        "ROB_BELMONT_BODY_SPECIAL_PISTOL_DESCRIPTION": "Pafu <style=cIsUtility>argxentan kuglon</style> por <style=cIsDamage>800% da domagxo</style>, kiu trapasas cxiun malamikon sur sia vojo.",
        "ROB_BELMONT_BODY_SPECIAL_PISTOL_SCEPTER_NAME": "Golden Gun",
        "ROB_BELMONT_BODY_SPECIAL_PISTOL_SCEPTER_DESCRIPTION": "Pafu <style=cIsUtility>argxentan kuglon</style> por <style=cIsDamage>800% da domagxo</style>, kiu trapasas cxiun malamikon sur sia vojo.\n<color=#d299ff>SCEPTER: Cxiu trafo kreas orajn elpendajxojn kaj kauxzas kroman eksplodon.</color>",
        "ROB_BELMONT_BODY_SPECIAL_HOLYCROSS_NAME": "Sacred Flame",
        "ROB_BELMONT_BODY_SPECIAL_HOLYCROSS_DESCRIPTION": "Alvoku la potencon de <color=#FF0033>Providence</color>, eligante <style=cIsUtility>grandegan flamon</style> por <style=cIsDamage>300% da domagxo po frapo</style>. Finigxas per <style=cIsDamage>4000% da domagxo</style> supernovao.",
        "ROB_BELMONT_BODY_UNLOCKABLE_UNLOCKABLE_NAME": "Diaj Sangolinioj",
        "ROB_BELMONT_BODY_UNLOCKABLE_ACHIEVEMENT_NAME": "Diaj Sangolinioj",
        "ROB_BELMONT_BODY_UNLOCKABLE_ACHIEVEMENT_DESC": "Malkovru sanktan relikvon sur la luno.",
        "ROB_BELMONT_BODY_MONSOON_UNLOCKABLE_UNLOCKABLE_NAME": "<color=#3060FF>Belmont</color>: Majstreco",
