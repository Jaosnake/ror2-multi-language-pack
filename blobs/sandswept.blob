				{
					attackerBody.SetBuffCount(BuffBase<Charge>.instance.BuffDef.buffIndex, Mathf.Min(Sandswept.Survivors.Ranger.Projectiles.DirectCurrent.maxCharge, buffCount + 6));
				}
