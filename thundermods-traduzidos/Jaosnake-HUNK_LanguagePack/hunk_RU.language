        "ROB_HUNK_WEAPON_ADDON3_MAGNUM_NAME": "Запасные патроны (Lightning Hawk)",
        "ROB_HUNK_WEAPON_ADDON3_MAGNUM_DESC": "Специальный модуль для Lightning Hawk, значительно увеличивающий количество подбираемых патронов MAG.",
        "ROB_HUNK_WEAPON_SHOTGUN_NAME": "W-870",
        "ROB_HUNK_WEAPON_SHOTGUN_DESC": "Помповый дробовик 12-го калибра.",
        "ROB_HUNK_WEAPON_ADDON_SHOTGUN_NAME": "Патроны «Дыхание дракона» (Дробовик)",
        "ROB_HUNK_WEAPON_ADDON_SHOTGUN_DESC": "Специальный модуль для всех дробовиков. Заменяет дробь зажигательными патронами, наносящими больше урона и поджигающими цель.",
        "ROB_HUNK_WEAPON_SLUGGER_NAME": "Slugger",
        "ROB_HUNK_WEAPON_SLUGGER_DESC": "Помповый дробовик 12-го калибра на 4 патрона, стреляющий тяжёлыми пулями.",
        "ROB_HUNK_WEAPON_M3_NAME": "M3",
        "ROB_HUNK_WEAPON_M3_DESC": "Полуавтоматический дробовик.",
        "ROB_HUNK_WEAPON_STREET_SWEEPER_NAME": "Street Sweeper",
        "ROB_HUNK_WEAPON_STREET_SWEEPER_DESC": "Полностью автоматический дробовик.",
        "ROB_HUNK_WEAPON_ROCKETLAUNCHER_NAME": "Противотанковая ракета",
        "ROB_HUNK_WEAPON_ROCKETLAUNCHER_DESC": "Ракетная установка сокрушительной мощи.",
        "ROB_HUNK_WEAPON_ATM_NAME": "ATM-4",
        "ROB_HUNK_WEAPON_ATM_DESC": "Безоткатный гранатомёт с бесконечным боезапасом. Лёгкое и удобное оружие огромной мощи.",
        "ROB_HUNK_WEAPON_ATM2_NAME": "Прототип ATM-4",
        "ROB_HUNK_WEAPON_ATM2_DESC": "Безоткатный гранатомёт, стреляющий 84-мм снарядами. Пробивная сила ракеты наносит больше урона, чем взрыв.",
        "ROB_HUNK_WEAPON_RPG_NAME": "RPG",
        "ROB_HUNK_WEAPON_RPG_DESC": "Ракетная установка сокрушительной мощи.",
        "ROB_HUNK_WEAPON_REVOLVER_NAME": "Quickdraw Army",
        "ROB_HUNK_WEAPON_REVOLVER_DESC": "Старомодный револьвер под патроны магнум.",
        "ROB_HUNK_WEAPON_ADDON_REVOLVER_NAME": "Ускоритель заряжания (Quickdraw Army)",
        "ROB_HUNK_WEAPON_ADDON_REVOLVER_DESC": "Специальный модуль для Quickdraw Army, позволяющий быстрее заряжать пустой барабан.",
        "ROB_HUNK_WEAPON_FLAMETHROWER_NAME": "Химический огнемёт",
        "ROB_HUNK_WEAPON_FLAMETHROWER_DESC": "Оружие разработки Umbrella, использующее сжатый газ для создания раскалённого пламени. Портативный и перезаправляемый, всегда готов к затяжному бою.",
        "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_NAME": "Регулятор (Химический огнемёт)",
        "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_DESC": "Специальный модуль для огнемёта. Ограничивает расход жидкого топлива и сжатого газа, позволяя вести огонь гораздо дольше.",
        "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_NAME": "Топливный бак высшего класса (Химический огнемёт)",
        "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_DESC": "Специальный модуль для огнемёта. Усиливает мощь пламени, оставляя на земле огненные следы.",
        "ROB_HUNK_WEAPON_GRENADELAUNCHER_NAME": "GM-79",
        "ROB_HUNK_WEAPON_GRENADELAUNCHER_DESC": "Однозарядный переломный гранатомёт, способный стрелять зажигательными снарядами.",
        "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_NAME": "Плечевой приклад (GM-79)",
        "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_DESC": "Специальный модуль для GM-79, заметно снижающий отдачу и стабилизирующий траекторию каждого выстрела.",
        "ROB_HUNK_WEAPON_MGL_NAME": "MGL",
        "ROB_HUNK_WEAPON_MGL_DESC": "Прототип полуавтоматического гранатомёта, способный стрелять разрывными гранатами.",
        "ROB_HUNK_WEAPON_ADDON_MGL_NAME": "Восстановленный барабан (MGL)",
        "ROB_HUNK_WEAPON_ADDON_MGL_DESC": "Специальный модуль для MGL. Заменяет сломанный барабан исправным, позволяя вести полуавтоматический огонь.",
        "ROB_HUNK_WEAPON_GOLDGUN_NAME": "Золотой пистолет",
        "ROB_HUNK_WEAPON_GOLDGUN_DESC": "Однозарядный пистолет, способный убить кого угодно с 1 выстрела.",
        "ROB_HUNK_WEAPON_BLUEROSE_NAME": "Blue Rose",
        "ROB_HUNK_WEAPON_BLUEROSE_DESC": "Шестизарядный револьвер, стреляющий по два патрона за раз? Какому психу вообще придёт в голову такое?",
        "ROB_HUNK_WEAPON_AR_NAME": "CQBR",
        "ROB_HUNK_WEAPON_AR_DESC": "Винтовка, способная вести полностью автоматический огонь.",
        "ROB_HUNK_WEAPON_ADDON_AR_NAME": "Штык (CQBR)",
