	public class DriftingPerceptionController : ItemBehavior
	{
		public HealthComponent hc;

		public void Start()
		{
			hc = base.body.healthComponent;
		}

		public void FixedUpdate()
		{
			//IL_00a8: Unknown result type (might be due to invalid IL or missing references)
			//IL_011b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0120: Unknown result type (might be due to invalid IL or missing references)
			//IL_0148: Unknown result type (might be due to invalid IL or missing references)
			//IL_00dd: Unknown result type (might be due to invalid IL or missing references)
			if (base.body.HasBuff(DriftingPerception.cooldown) || base.stack <= 0)
			{
				return;
			}
			if (!base.body.HasBuff(DriftingPerception.ready))
			{
				base.body.AddBuff(DriftingPerception.ready);
			}
			else if (base.body.HasBuff(DriftingPerception.ready) && base.body.outOfCombatStopwatch <= 2f && !base.body.hasCloakBuff)
			{
				base.body.AddTimedBuffAuthority(Buffs.Cloak.buffIndex, DriftingPerception.cloakBuffDuration);
				if (!base.body.HasBuff(Buffs.CloakSpeed))
				{
					base.body.AddTimedBuffAuthority(Buffs.CloakSpeed.buffIndex, DriftingPerception.cloakBuffDuration);
				}
				Util.PlaySound("Play_roboBall_attack2_mini_spawn", ((Component)this).gameObject);
				Util.PlaySound("Play_roboBall_attack2_mini_spawn", ((Component)this).gameObject);
				EffectManager.SimpleEffect(GameObject.SmokescreenEffect, base.body.corePosition, Quaternion.identity, true);
				base.body.RemoveBuff(DriftingPerception.ready);
				base.body.AddTimedBuffAuthority(DriftingPerception.cooldown.buffIndex, DriftingPerception.rechargeTime + DriftingPerception.cloakBuffDuration);
			}
		}

		public void OnDisable()
		{
			if (base.body.HasBuff(DriftingPerception.ready))
			{
				base.body.RemoveBuff(DriftingPerception.ready);
			}
			if (base.body.HasBuff(DriftingPerception.cooldown))
			{
				base.body.RemoveBuff(DriftingPerception.cooldown);
			}
		}
	}
