        "ROB_HUNK_BODY_KNIFE_MACHETE_NAME": "Мачете",
        "ROB_HUNK_BODY_KNIFE_MACHETE_DESCRIPTION": "Огромный клинок, предназначенный прежде всего для партизанской тактики.",
        "ROB_HUNK_BODY_KNIFE_RE4_NAME": "Первородный нож",
        "ROB_HUNK_BODY_KNIFE_RE4_DESCRIPTION": "Нож, выкованный с безграничными возможностями.",
        "ROB_HUNK_BODY_KNIFE_BLOODY_NAME": "Запачканный клинок",
        "ROB_HUNK_BODY_KNIFE_BLOODY_DESCRIPTION": "Окровавленный клинок с зазубренной кромкой, разорвавший немало противников.",
