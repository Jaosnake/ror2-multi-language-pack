			if (DashesRemaining < 2 && !base.body.characterMotor.isGrounded)
			{
				airborneTimer += Time.fixedDeltaTime;
			}
			if (airborneTimer >= 0.5f && base.body.characterMotor.isGrounded)
			{
				DashesRemaining = 2;
				airborneTimer = 0f;
				dashCooldownTimer = 0f;
			}
			if (DashesRemaining < 2)
