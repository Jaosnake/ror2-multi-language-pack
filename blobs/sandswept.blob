		private void OnTakeDamage(orig_TakeDamageProcess orig, HealthComponent self, DamageInfo damageInfo)
		{
			orig.Invoke(self, damageInfo);
			GameObject attacker = damageInfo.attacker;
			if (!Object.op_Implicit((Object)(object)attacker))
			{
				return;
			}
			CharacterBody body = self.body;
			if (!Object.op_Implicit((Object)(object)body) || !body.HasBuff(readyBuff))
			{
				return;
			}
			int count = GetCount(body);
			if (count <= 0)
			{
				return;
			}
			PreservedAtollController component = ((Component)body).GetComponent<PreservedAtollController>();
			if (Object.op_Implicit((Object)(object)component))
			{
				float fullCombinedHealth = self.fullCombinedHealth;
				float damage = damageInfo.damage;
				float num = damage / fullCombinedHealth * 100f;
				float num2 = 100f / (baseHealthDivisor + stackHealthDivisor * (float)(count - 1));
				int num3 = Mathf.RoundToInt(Mathf.Min(num / num2, 100f / num2));
				if (num3 > 0)
				{
					component.ApplyDecay(num3);
				}
			}
		}

		private void CharacterBody_onBodyInventoryChangedGlobal(CharacterBody body)
		{
			body.AddItemBehavior<PreservedAtollController>(GetCount(body));
		}

