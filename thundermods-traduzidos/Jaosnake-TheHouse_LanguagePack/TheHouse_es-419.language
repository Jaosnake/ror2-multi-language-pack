        "JAVANGLE_HOUSE_BUST_NAME": "Explosión",
        "JAVANGLE_HOUSE_BUST_DESCRIPTION": "Recibe instantáneamente <style=cDeath>{0}% de tu salud máxima como daño</style> e <style=cIsDamage>inflige {1}% de tu salud máxima</style> como daño a los enemigos cercanos.",
        "JAVANGLE_HOUSE_SWORDS_NAME": "10 de espadas",
