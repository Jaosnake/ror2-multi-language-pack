    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_NAME": "Tetrarch",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>Santé : </color>20\n<color=#FF0000>Armure : </color>7\n\nRotation Vitesse : 50\n\nPoids : 27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% de Vitesse d'attaque</color>\n <color=#fc8080>-15% de Régénération de santé</color>\n <color=#fc8080>+5% de Temps de recharge total</color>\n\n<color=#00FF00>Santé : </color>20\n<color=#FF0000>Armure : </color>2\n\nRotation Vitesse : 40\n\nPoids : 20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Santé : </color>10\n<color=#FF0000>Armure : </color>0\n\nRotation Vitesse : 55\n\nPoids : 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Santé : </color>100\n<color=#FF0000>Armure : </color>20\n\nRotation Vitesse : 33\n\nPoids : 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% de Temps de recharge spécial</color>\n <color=#fc8080>+15% de Temps de recharge secondaire</color>\n <color=#fc8080>-10% de Vitesse d'attaque</color>\n\n<color=#00FF00>Santé : </color>120\n<color=#FF0000>Armure : </color>23\n\nRotation Vitesse : 29\n\nPoids : 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% de Dégâts</color>\n <color=#fc8080>+10% de Temps de recharge total</color>\n\n<color=#00FF00>Santé : </color>160\n<color=#FF0000>Armure : </color>0\n\nRotation Vitesse : 25\nLimite d'Angle : 90\n\nPoids : 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Santé : </color>45\n<color=#FF0000>Armure : </color>4\n\nRotation Vitesse : 25\n\nPoids : 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Santé : </color>35\n<color=#FF0000>Armure : </color>15\n\nRotation Vitesse : 35\n\nPoids : 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% de Temps de recharge primaire</color>\n <color=#fc8080>+8% de Temps de recharge secondaire</color>\n <color=#fc8080>+8% de Temps de recharge utilitaire</color>\n <color=#fc8080>+8% de Temps de recharge spécial</color>\n <color=#fc8080>-15% de Vitesse d'attaque</color>\n\n<color=#00FF00>Santé : </color>35\n<color=#FF0000>Armure : </color>3\n\nRotation Vitesse : 30\n\nPoids : 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% de Dégâts</color>\n\n<color=#00FF00>Santé : </color>5\n<color=#FF0000>Armure : </color>1\n\nRotation Vitesse : 40\nLimite d'Angle : 30\n\nPoids : 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ORIGINAL",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "ROUGE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "ROUGE CLAIR",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "VERT",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "VERT FONCÉ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "BLEU",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "CYAN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "ROSE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "ROSE VIF",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "MAGENTA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "JAUNE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "JAUNE NÉON",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "VIOLET NÉON",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "ORANGE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "BLANC",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "NOIR",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Change la partie « lumineuse » du véhicule en une autre couleur.  N'affecte pas le gameplay.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Sale",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Propre",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Camouflage_Dentelé",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Camouflage_Pixélisé",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Camouflage_Papier",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Tôle_Larmée",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Plaque_Boulonnée",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Ensemble_Procédural",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Mélange_Coloré",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Dégradé_Arc-en-ciel",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Monochrome",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Galaxie_Fluide",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Espace",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Systèmes Moteur",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Les compétences utilitaires et la poussée consomment du carburant. La régénération du carburant est affectée par la <style=cIsUtility>vitesse d'attaque</style> ; la capacité de carburant est affectée par les <style=cIsUtility>postcombustions</style> et les <style=cIsUtility>objets de saut</style>. Le char peut <style=cIsUtility>sprinter dans n'importe quelle direction</style>. La poussée permet un contrôle polyvalent dans les airs. Cependant, <color=#fc8080>le char ne peut pas sauter normalement</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Super Armurerie",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "Le choix du châssis et de la tourelle affecte la santé, l'armure, la vitesse, la poussée et la masse. <style=cIsUtility>Une masse plus élevée aide à pousser les ennemis plus lourds</style> ; sinon, vous serez plus sensible au <color=#ffff80>recul</color>.\n\nL'armure ou la vitesse peuvent aider à compenser l'<color=#fc8080>abominable régénération de santé</color> du char.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Instabilité Céleste",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "Le char ne peut pas se rééquilibrer en l'air, <color=#ffff80>étant sujet à la perte de contrôle</color>. Atterrir sur le toit vous laisse <color=#fc8080>immobilisé et vulnérable pendant un court instant</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Propulseurs de Vol",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Maintenez <style=cIsUtility>Sauter</style> pour commencer à voler. La direction du vol dépend de l'angle de votre char. <style=cIsUtility>Le vol le plus polyvalent</style>, mais peut être difficile à maîtriser.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Propulseurs à Impulsion",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Permet au char de <style=cIsUtility>sauter</style> normalement comme les autres survivants. L'inclinaison du char peut être activée au 2e saut. Chaque saut consomme <color=#ffc080>25</color> de carburant.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Propulseurs de Lévitation",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Permet au char de planer au-dessus du sol. Maintenez <style=cIsUtility>Sauter</style> pour monter ; maintenez <style=cIsUtility>LeftAlt</style> pour descendre. Monter consomme plus de carburant.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Mitrailleuses",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Tire constamment pour <style=cIsDamage>2x40% de dégâts</style>.\n<style=cSub>[Poids : 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Fusil à Pompe",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Tire pour <style=cIsDamage>12x75% de dégâts</style>.  <color=#ffc080>Brûlez du carburant</color> pour <style=cIsUtility>gagner des charges supplémentaires</style> ; <color=#80fc80>réussissez une figure</color> pour gagner temporairement un tir puissant à <style=cIsDamage>18x150% de dégâts</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 1s</style> | Poids : 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Lance-Grenades",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Tire des obus imprécis pour <style=cIsDamage>4x250% de dégâts</style>.  Les obus sont explosifs et lourds.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 4s</style> | <style=cIsDamage>Rayon d'Explosion : 5m</style> | Poids : 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Lance-Missiles",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Tire des missiles précis pour <style=cIsDamage>1000% de dégâts</style>. <style=cIsDamage>Les dégâts augmentent avec la distance parcourue</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 3s</style> | <style=cIsDamage>Rayon d'Explosion : 8m</style> | Poids : 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Lance-Flammes",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Crache du feu pour <color=#E85E31>25% de dégâts de brûlure</color> tous les <color=#ffc080>15 de carburant par seconde</color>.  Les dégâts augmentent avec les cumuls ; <style=cIsUtility>la vitesse d'attaque augmente la portée</style>.\n<style=cSub>[<color=#ffc080>Alimenté au Carburant</color> | Poids : 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ultrantenne",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Électrocutez-vous</color> et <style=cIsUtility>activez les objets à l'élimination</style>.  <style=cIsUtility>Toucher les ennemis les électrocute également</style>, et ils subissent <style=cIsDamage>250% de dégâts</style> par objet <style=cIsUtility>à l'élimination</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 7s</style> | <style=cIsDamage>Rayon d'Explosion : 5m</style> | Poids : 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Canon Critique",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Tire pour <color=#ff4d76>1200% de dégâts critiques</color>. La chance de critique augmente les dégâts du canon.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 7s</style> | <style=cIsDamage>Rayon d'Explosion : 10m</style> | Poids : 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Canon Obusier",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Chargez pour tirer un obus explosif à <style=cIsDamage>7000% de dégâts</style>. <style=cIsUtility>Peut propulser le char s'il est en l'air.</style>\n<style=cSub>[<style=cIsUtility>Temps de recharge : 16s</style> | <style=cIsDamage>Rayon d'Explosion : 15m</style> | Poids : 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Canon de Choc",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Tire de manière imprécise pour <style=cIsDamage>1700% de dégâts</style>. <style=cIsDamage>Les dégâts diminuent avec la distance</style> ; <style=cIsDamage>les objets à déclenchement augmentent les dégâts à la place</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 3s</style> | <style=cIsDamage>Rayon d'Explosion : 5m</style> | Poids : 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Canon Perforant",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Tire pour <style=cIsDamage>2500% de dégâts</style>.  Maintenez pour calibrer et infliger <style=cIsDamage>3500% de dégâts</style>, capable de <style=cIsUtility>toucher les points faibles</style>.  Une fois calibré, <color=#fc8080>se déplacer réduit la précision</color>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 5s</style> | <style=cIsDamage>Rayon d'Explosion : 2m</style> | Poids : 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Canon Français",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Tire pour un maigre <style=cIsDamage>550% de dégâts</style>. Pour une raison quelconque, <style=cIsUtility>a beaucoup trop de coefficient de déclenchement</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 1s</style> | Poids : 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Minigun",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Mitraille pour <style=cIsDamage>50% de dégâts</style>. À 75% de surchauffe, inflige <color=#E85E31>feu</color> ; <color=#fc8080>la surchauffe bloque l'arme</color>. <style=cIsUtility>Les objets de temps de recharge accélèrent le refroidissement</style> ; <style=cIsUtility>les chargeurs de secours empêchent la surchauffe</style>.\n<style=cSub>[Poids : 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Canon de Base",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Tire un obus rapide pour <style=cIsDamage>5400% de dégâts</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 12s</style> | <style=cIsDamage>Rayon d'Explosion : 7m</style> | Poids : 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Canon AA",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Tire pour <style=cIsDamage>300% de dégâts</style>.  Le projectile détone près des cibles aériennes, infligeant <style=cIsDamage>2.5x de dégâts</style>.  <color=#fc8080>Le char ralentit pour tirer</color>.\n<style=cSub>[<style=cIsDamage>Rayon d'Explosion : 5.5m</style> | Poids : 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Canon à Dispersion",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Tire pour <style=cIsDamage>2200% de dégâts</style> en un <style=cIsUtility>grand arc</style>, éclaboussant pour <style=cIsDamage>10x5% des dégâts totaux</style>.  Les dégâts augmentent avec la distance parcourue, jusqu'à <style=cIsDamage>5500% de dégâts</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 10s</style> | <style=cIsDamage>Rayon d'Explosion : 16m</style> | Poids : 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Canon Céleste",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Consomme <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> de carburant pour <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>de dégâts</color>.  Les lasers chargés transpercent ; <color=#fc8080>le manque de carburant désactive l'arme.</color>\n<style=cSub>[<color=#ffc080>Alimenté au Carburant</color> | Poids : 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Canon Oblitérateur",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Chargez pour tirer automatiquement un <color=#E85E31>obus déclenchant les effets à l'élimination</color> pour <style=cIsDamage>12000% de dégâts</style>.  Ensuite, <color=#fc8080>les compétences sont désactivées pendant 4 secondes.  L'obus peut blesser les alliés</color>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 21s</style> | <style=cIsDamage>Rayon d'Explosion : 5m</style> | Poids : 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Canon Automatique",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Tire jusqu'à 4 obus qui infligent <style=cIsDamage>2000% de dégâts</style> chacun. Le dernier obus inflige <style=cIsDamage>2x de dégâts</style> sur un point fixe.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 14s</style> | <style=cIsDamage>Rayon d'Explosion : 7m</style> | Poids : 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Chasse-pierres",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Foncez sur une courte distance</style> pour <color=#ffc080>50</color> de carburant. Peut repousser <style=cIsUtility>n'importe quel ennemi</style> pour <style=cIsDamage>1000% de dégâts</style> et rendre <color=#ffc080>40</color> de carburant.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 2s</style> | Poids : 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Pointes",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Foncez sur une grande distance</style> pour <color=#ffc080>50</color> de carburant. Percutez les ennemis pour <color=#AA2B2A>550% de dégâts de saignement</color>.  <style=cIsUtility>N'a pas de temps de recharge</style>.\n<style=cSub>[Poids : 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Turbo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Foncez à toute allure</style> et consommez <color=#ffc080>30</color> de carburant par seconde.  Peut percuter pour <style=cIsDamage>250% de dégâts</style>. Percuter ajoute <color=#ffc080>20</color> de carburant.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 1s</style> | Poids : 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Super Saut",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Propulsez-vous vers le haut pour <color=#ffc080>50</color> de carburant.  En sprintant, propulsez-vous plutôt vers l'avant pour <color=#ffc080>75</color> de carburant et faites tournoyer votre char pour <style=cIsDamage>2500% de dégâts</style>.  Le poids du char augmente les dégâts.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Bulldozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Accélérez</style> et consommez <color=#ffc080>20</color> de carburant par seconde.  Peut renverser <style=cIsUtility>n'importe quel ennemi</style> pour <style=cIsDamage>200% de dégâts</style> constants.  Inflige <style=cIsDamage>350% de dégâts</style> à l'impact.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 1s</style> | Poids : 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Chargez pour <style=cIsUtility>foncer sur la plus grande distance</style> pour <color=#ffc080>100</color> de carburant.  <style=cIsUtility>Transpercez les foules</style> pour <color=#AA2B2A>4000% de dégâts de saignement</color> et <style=cIsUtility>prolongez la ruée</style> ; tournez pour arrêter la ruée ; <color=#80fc80>réussissez une figure</color> pour <style=cIsUtility>passer la charge</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 7s</style> | Poids : 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Trancheuse",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Maintenez pour vous enfouir</style>, consommant <color=#ffc080>20</color> de carburant par seconde, <style=cIsUtility>protégeant votre char sous terre</style>.  Relâchez pour surgir et infliger <style=cIsDamage>900% de dégâts</style> aux ennemis proches.  Impossible d'attaquer sous terre.\n<style=cSub>[<style=cIsDamage>Rayon d'Explosion : 10m</style> | Poids : 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Mine Royale",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Pose une mine terrestre qui inflige <style=cIsDamage>3000% de dégâts</style>.  <style=cIsDamage>Les objets à déclenchement augmentent les dégâts à la place</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 10s</style> | <style=cIsDamage>Rayon d'Explosion : 10m</style> | Poids : 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Mini-Mines",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Visez et déployez toutes les mines terrestres miniatures qui infligent <style=cIsDamage>750% de dégâts</style> chacune.  Les objets de charges et d'interaction augmentent le nombre max de mines.  <color=#ffc080>Brûlez du carburant</color> pour <style=cIsUtility>gagner des charges supplémentaires</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 3s</style> | <style=cIsDamage>Rayon d'Explosion : 10m</style> | Poids : 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Lancer de Tonneau",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Lance un tonneau pour <color=#ffc080>25</color> de carburant qui s'enflamme à l'impact pour <style=cIsDamage>6500% de dégâts</style>, et laisse une <color=#E85E31>flaque ardente</color>.  <color=#80fc80>Réussir une figure</color> rend cette compétence temporairement <color=#fc8080>instable</color>, ce qui <style=cIsUtility>projette votre char dans tous les sens</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 14s</style> | <style=cIsDamage>Rayon d'Explosion : 18m</style> | <style=cIsDamage>Rayon de Zone : 8</style> | Poids : 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Autodestruction",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Annihile <color=#d40000>TOUT</color> dans un rayon de 35m pour <style=cIsDamage>100000% de dégâts</style>.  Commencez avec un <color=#80fc80>Dio's Best Friend</color> à chaque nouvelle partie.\n<style=cSub>[<style=cIsDamage>Rayon d'Explosion : 35m</style> | Poids : 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "RÈGNE",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Ralentissez et chargez pour tirer un barrage de missiles.  Les dégâts augmentent avec la distance parcourue, jusqu'à <style=cIsDamage>12x3000% de dégâts.</style>\n<style=cSub>[<style=cIsUtility>Temps de recharge : 30s</style> | <style=cIsDamage>Rayon d'Explosion : 10m</style> | Poids : 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Évasion",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Émettez de la fumée, étourdissant les ennemis proches pour <style=cIsDamage>150% de dégâts</style> et camouflez-vous.  <style=cIsUtility>Devenez insensible</style> aux dégâts pendant 1 seconde.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 12s</style> | <style=cIsDamage>Rayon d'Explosion : 10m</style> | Poids : 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Passif : Berserk",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Retire cette compétence. Augmente la <style=cIsDamage>vitesse d'attaque de base de 0.5</style> et réduit le <style=cIsUtility>temps de recharge de 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Passif : Moteurs",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Retire cette compétence. Augmente la <style=cIsUtility>vitesse de base de 1m/s</style> et la <style=cIsUtility>puissance de poussée de 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Passif : Armure",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Retire cette compétence. Augmente l'<style=cIsUtility>armure de base de 30</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank : Maîtrise",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "En tant que Celestial War Tank, terminez le jeu ou oblitérez-vous en Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank : Maîtrise",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank : Canon Céleste",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "En tant que Celestial War Tank, rentrez chez vous",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank : Canon Céleste",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank : Oblitérateur",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "En tant que Celestial War Tank, infligez plus de 1,000,000 de dégâts en un seul tir.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank : Oblitérateur",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank : Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "En tant que Celestial War Tank, terminez le jeu ou oblitérez-vous en Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank : Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank : Blindé",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "En tant que Celestial War Tank, obtenez 10000 PV.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank : Blindé",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "Le char de destruction ultime. Résistez à tous les types d'ennemis, en les écrasant sous votre poids colossal et vos armes !\n\n<style=cSub>< ! > Le char est énorme et extrêmement lent, ce qui vous rend vulnérable à toute forme de dégâts. Jouer de manière extrêmement défensive ou agressive aidera à atténuer les dégâts subis. Sachez que le char n'a aucune guérison.\n\n< ! > Le châssis du char peut servir d'arme — écrasez vos ennemis ou utilisez votre poids pour tous les aplatir !\n\n< ! > Lorsque le char se retourne, il est plus lourd et met du temps à se redresser, subissant davantage de dégâts de chute. Le char ne peut pas faire de figures.\n\n< ! > Les facteurs de guérison sont réduits — le char a trop de santé !\n\n< ! > Appuyez sur 'T' pour klaxonner.  Configurable dans les paramètres du mod.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Entité Étrangère",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Après des recherches approfondies, nous avons découvert l'origine de ces chars : les mains des pillards. Fabriqués à partir de pièces de ferraille de qualité et d'objets de l'UES, ils avaient réussi à créer ces chars de guerre.\n\nCependant, cela mène à des conclusions dangereuses. Après avoir obtenu l'une des antennes ennemies, nous avons alerté ce mastodonte de char. Il fait la taille des gardes scarabées !\n\nBien sûr, après un long combat acharné, nous l'avons finalement abattu. Nous espérons poursuivre les recherches et reprogrammer son esprit afin d'obtenir de meilleures réponses. Ce sera une tâche ardue, car il s'agit bel et bien de technologie extraterrestre.\n\nUn détail colossal à noter est qu'à sa défaite, il a invoqué un portail d'urgence. Le portail le plus grand et le plus violent que nous ayons jamais vu. Même s'il peut nous mener droit aux réponses, je ne pense pas que ce sera une promenade de santé. Un char normal est déjà bien trop mortel, et je ne sais pas quelles autres inventions des pillards nous attendent là-bas.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ORIGINAL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "BLANC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "NOIR",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "ROUGE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "ROUGE FONCÉ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "VERT",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "BLEU",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "CYAN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "JAUNE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "JAUNE NÉON",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "MAGENTA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "VIOLET",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "ORANGE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "MARRON",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "ÉTATS-UNIS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "ALLEMAGNE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "ROYAUME-UNI",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "RUSSIE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "FRANCE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "Change la couleur du châssis.  N'affecte pas le gameplay.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "PRINCIPAL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "JAUNE SALE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "VERT",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "VERT SALE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "BLEU",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "BLEU SALE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "ROUGE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "ROUGE SALE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "MAÎTRISE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Châssis Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Puissance du Moteur : </color>3000\n<color=#00FFFF>Vitesse : </color>10\nTraverse Vitesse : 0.8\n\n<color=#00FF00>Santé : </color>1000\n<color=#FF0000>Armure : </color>75\n\n<color=#AA00FF>Puissance de Poussée : </color>35\n<color=#ffc080>Quantité de Carburant : </color>500\nPoids : 1000\n\nType de Châssis : Char",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Châssis Griffon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Compatible avec une tourelle</color>.\n\n<color=#FFFF00>Puissance du Moteur : </color>2300\n<color=#00FFFF>Vitesse : </color>11\nTraverse Vitesse : 1\n\n<color=#00FF00>Santé : </color>800\n<color=#FF0000>Armure : </color>25\n\n<color=#AA00FF>Puissance de Poussée : </color>40\n<color=#ffc080>Quantité de Carburant : </color>500\nPoids : 800\n\nType de Châssis : Voiture",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "Châssis TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Puissance du Moteur : </color>1200\n<color=#00FFFF>Vitesse : </color>12\nTraverse Vitesse : 2\n\n<color=#00FF00>Santé : </color>500\n<color=#FF0000>Armure : </color>25\n\n<color=#AA00FF>Puissance de Poussée : </color>40\n<color=#ffc080>Quantité de Carburant : </color>300\nPoids : 450\n\nType de Châssis : Char",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Châssis Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Puissance du Moteur : </color>3500\n<color=#00FFFF>Vitesse : </color>8\nTraverse Vitesse : 0.6\n\n<color=#00FF00>Santé : </color>1400\n<color=#FF0000>Armure : </color>100\n\n<color=#AA00FF>Puissance de Poussée : </color>34\n<color=#ffc080>Quantité de Carburant : </color>750\nPoids : 1250\n\nType de Châssis : Char",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Châssis Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Offre un meilleur <style=cIsUtility>contrôle aérien</style>.\n\n\n<color=#FFFF00>Puissance du Moteur : </color>2000\n<color=#00FFFF>Vitesse : </color>13\nTraverse Vitesse : 1.4\n\n<color=#00FF00>Santé : </color>600\n<color=#FF0000>Armure : </color>20\n\n<color=#AA00FF>Puissance de Poussée : </color>40\n<color=#ffc080>Quantité de Carburant : </color>450\nPoids : 750\n\nType de Châssis : Voiture",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "Châssis AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>La vitesse n'est pas affectée par le poids</style>.\n\n<color=#FFFF00>Puissance du Moteur : </color>700\n<color=#00FFFF>Vitesse : </color>9\nTraverse Vitesse : 0.7\n\n<color=#00FF00>Santé : </color>900\n<color=#FF0000>Armure : </color>50\n\n<color=#AA00FF>Puissance de Poussée : </color>35\n<color=#ffc080>Quantité de Carburant : </color>370\nPoids : 1100\n\nType de Châssis : Char",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "Châssis TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Puissance du Moteur : </color>3700\n<color=#00FFFF>Vitesse : </color>8\nTraverse Vitesse : 0.5\n\n<color=#00FF00>Santé : </color>1150\n<color=#FF0000>Armure : </color>60\n\n<color=#AA00FF>Puissance de Poussée : </color>34\n<color=#ffc080>Quantité de Carburant : </color>1000\nPoids : 1200\n\nType de Châssis : Char",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Châssis Pigeon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Compatible avec une tourelle</color>.\n\n<color=#FFFF00>Puissance du Moteur : </color>1500\n<color=#00FFFF>Vitesse : </color>7\nTraverse Vitesse : 1.4\n\n<color=#00FF00>Santé : </color>150\n<color=#FF0000>Armure : </color>5\n\n<color=#AA00FF>Puissance de Poussée : </color>40\n<color=#ffc080>Quantité de Carburant : </color>300\nPoids : 100\n\nType de Châssis : Voiture",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Châssis Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Peut grimper aux murs</style>. Le saut est retardé d'une seconde et les <color=#fc8080>dégâts de bélier sont réduits de 50%</color>.\n\n\n<color=#FFFF00>Puissance du Moteur : </color>2750\n<color=#00FFFF>Vitesse : </color>9\nTraverse Vitesse : 0.8\n\n<color=#00FF00>Santé : </color>1300\n<color=#FF0000>Armure : </color>90\n\n<color=#AA00FF>Puissance de Poussée : </color>31\n<color=#ffc080>Quantité de Carburant : </color>550\nPoids : 1300\n\nType de Châssis : Mécha",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "Châssis TANKDOZER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "La lame <style=cIsUtility>bloque</style> tous les <style=cIsDamage>dégâts reçus</style>.\n\nMode Chasseur de Chars : <color=#fc8080>Impossible de monter une tourelle</color>.\n\n<color=#FFFF00>Puissance du Moteur : </color>2500\n<color=#00FFFF>Vitesse : </color>8.5\nTraverse Vitesse : 0.9\n\n<color=#00FF00>Santé : </color>1250\n<color=#FF0000>Armure : </color>80\n\n<color=#AA00FF>Puissance de Poussée : </color>34\n<color=#ffc080>Quantité de Carburant : </color>500\nPoids : 1200\n\nType de Châssis : Char",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Châssis Truck Kan",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "Les dégâts de bélier sont augmentés de <color=#80fc80>100.0%</color>\n\n<color=#80fc80>Compatible avec une tourelle</color>.\n<style=cIsUtility>La vitesse n'est pas affectée par le poids</style>.\n\n<color=#FFFF00>Puissance du Moteur : </color>1000\n<color=#00FFFF>Vitesse : </color>12\nTraverse Vitesse : 0.9\n\n<color=#00FF00>Santé : </color>450\n<color=#FF0000>Armure : </color>15\n\n<color=#AA00FF>Puissance de Poussée : </color>40\n<color=#ffc080>Quantité de Carburant : </color>600\nPoids : 600\n\nType de Châssis : Voiture",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Santé : </color>250\n<color=#FF0000>Armure : </color>25\n\nRotation Vitesse : 7.5\n\nPoids : 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Tourelle",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Santé : </color>100\n<color=#FF0000>Armure : </color>10\n\nRotation Vitesse : 20\n\nPoids : 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Santé : </color>100\n<color=#FF0000>Armure : </color>15\n\nRotation Vitesse : 15\n\nPoids : 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Santé : </color>400\n<color=#FF0000>Armure : </color>50\n\nRotation Vitesse : 5\n\nPoids : 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% de dégâts</style> ?  Je n'ai pas trouvé le code où les dégâts augmentent pour cette tourelle spécifique.\n- Développeur\n\n\n<color=#00FF00>Santé : </color>150\n<color=#FF0000>Armure : </color>25\n\nRotation Vitesse : 13\nLimite d'Angle : 60\n\nPoids : 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Ajoute <style=cIsDamage>5 charges</style> à la compétence <style=cIsUtility>secondaire</style>.\n<style=cIsUtility>Restaure toutes les charges</style> après le temps de recharge.\nLes dégâts du canon diminuent de 80%\n\n<color=#00FF00>Santé : </color>300\n<color=#FF0000>Armure : </color>20\n\nRotation Vitesse : 7\n\nPoids : 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Santé : </color>200\n<color=#FF0000>Armure : </color>30\n\nRotation Vitesse : 9\n\nPoids : 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Santé : </color>300\n<color=#FF0000>Armure : </color>35\n\nRotation Vitesse : 7\n\nPoids : 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Poids Lourd",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "Le char peut <style=cIsUtility>écraser les ennemis</style>, avec des <style=cIsDamage>dégâts dépendant de la vitesse</style>.  Tomber avec une configuration lourde permet à votre poids de créer une <style=cIsUtility>onde de choc</style>, blessant les ennemis proches.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Aucun",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Retire cette compétence.  Augmente les statistiques suivantes :\n\nVitesse d'Attaque : <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Aucun",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Aucun",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Retire cette compétence.  Augmente les statistiques suivantes :\n\nVitesse : <color=#80fc80>+1</color> m/s\nPuissance des Propulseurs : <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Aucun",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Retire cette compétence.  Augmente l'armure de <color=#80fc80>30</color> et augmente la capacité de carburant de <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Mini-Canon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Tire de manière imprécise pour <style=cIsDamage>200% de dégâts.</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "IEM",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Enflammez votre bouclier et créez une IEM pour <style=cIsDamage>2000% de dégâts</style>, qui électrocute les ennemis !",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "Stockez une réserve massive allant jusqu'à 22 missiles ! Chacun infligeant de <style=cIsDamage>1100% de dégâts</style> jusqu'à <style=cIsDamage>1800% de dégâts</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Canon Automatique Rapide",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Tire des obus explosifs sur les ennemis pour <style=cIsDamage>500% de dégâts</style>. Doit recharger toutes les 4 secondes.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Canon Puissant",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Tire pour <style=cIsDamage>7500% de dégâts</style>, repoussant les ennemis.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 16s</style> | <style=cIsDamage>Rayon d'Explosion : 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Canon d'Artillerie",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Maintenez pour viser</style>, et relâchez pour tirer un obus puissant pour <style=cIsDamage>7000% de dégâts</style>.  Les dégâts augmentent avec la distance parcourue jusqu'à <style=cIsDamage>14000% de dégâts</style>.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 16s</style> | <style=cIsDamage>Rayon d'Explosion : 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Canon Cryo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Tire une boule de neige géante pour <color=#75EAFF>1500% de dégâts</color> et gèle les ennemis.\n<style=cSub>[<style=cIsUtility>Temps de recharge : 5s</style> | <style=cIsDamage>Rayon d'Explosion : 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Canon Duo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Tire pour <style=cIsDamage>5400% de dégâts</style>. Maintenez pour tirer 2 obus, ce qui <color=#fc8080>augmente le temps de recharge de la compétence</color> ensuite. Tirer un doublé <color=#80fc80>réduit grandement</color> le prochain temps de charge pendant 2 secondes.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "Canon Britannique",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Tire pour <style=cIsDamage>2400% de dégâts</style>.  <color=#fc8080>Ne peut pas déclencher d'objets</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Gros Canon Méchant",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Tire pour <style=cIsDamage>2000% de dégâts</style>.  <style=cIsUtility>Maintenez pour charger</style> et infliger jusqu'à <style=cIsDamage>11000% de dégâts</style>.  La charge maximale déclenche automatiquement le canon pour <style=cIsDamage>5500% de dégâts laser</style> supplémentaires avec un <style=cIsUtility>recul supplémentaire</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Expérimental d'Oppenheimer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Laissez votre obus détruire votre bouclier et annihilez tout pour <color=#ff4d76>9000% de dégâts critiques</color> !",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Réacteurs",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Allumez et consommez <color=#ffc080>70 de carburant</color> par seconde, permettant au char de gagner de plus en plus de vitesse au fil du temps.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Cycle d'Énergie",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Activez pour alterner entre 3 modes — Évasion, Attaque ou Défense : \n\n<style=cIsUtility>Évasion</style> : Réduit la vitesse d'attaque de 50% et augmente le temps de recharge de 50% pour 50% de vitesse supplémentaire, 10% de puissance de poussée et 50% de puissance du moteur !\n\n<color=#80fc80>Défense</color> : Sacrifie 70% de vitesse et 100% de puissance de poussée pour 500 d'armure.\n\n<style=cIsDamage>Attaque</style> : Toutes les armes infligent le double de dégâts. Réduit les temps de recharge de 33% et augmente la vitesse d'attaque de 33%, mais perd TOUTE l'armure et la guérison. Activer ce mode électrocute votre char pendant 2 secondes.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Overclock",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Laissez votre vitesse détruire votre bouclier et faites exploser violemment vos propulseurs pour <style=cIsDamage>6000% de dégâts</style> en vous projetant dans les airs, <style=cIsUtility>empêchant les dégâts de chute</style> !",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Boucliers",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "Activez pour devenir <style=cIsUtility>insensible aux dégâts extérieurs</style> pendant 4 secondes.  Peut être sacrifié pour une <color=#03fcc2>Compétence de Puissance</color> à usage unique.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Blasticulaire",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Tire avec 4 canons, infligeant chacun <style=cIsDamage>1400% de dégâts</style> dans un immense rayon. Les armes <color=#fc8080>surchauffent</color> au lieu de se recharger.\n<style=cSub>[<style=cIsDamage>Rayon d'Explosion : 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Standard",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Expérience classique.\n\nLe char se déplace et tourne selon la direction de déplacement choisie.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Alternatif",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Change la façon dont ce char se joue.\n\nLe char se déplace selon l'orientation du châssis, mais <color=#fc8080>ne tournera pas dans la direction du déplacement</color>.  Cela se gère en <style=cIsUtility>tournant manuellement</style>.\n\nEn vol, les commandes reviennent en mode Standard.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Mode d'Énergie : <style=cIsUtility>Évasion</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Réduit la vitesse d'attaque de 50% et augmente le temps de recharge de 50% pour 50% de vitesse supplémentaire, 10% de puissance de poussée et 50% de puissance du moteur.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Mode d'Énergie : <color=#80fc80>Défense</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "Sacrifie 70% de vitesse et 100% de puissance de poussée pour 500 d'armure.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Mode d'Énergie : <style=cIsDamage>Attaque</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "Toutes les armes infligent le double de dégâts. Réduit les temps de recharge de 33% et augmente la vitesse d'attaque de 33%, mais perd TOUTE l'armure et la guérison. Activer ce mode électrocute votre char pendant 2 secondes.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "Et dire que Dedee était enfin libéré, \r\nil a encore une fois été capturé par l'UES.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "Sans Tourelle",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "Retire la tourelle.  <style=cIsDamage>Augmente tous les dégâts de 30%</style>"
  }
}