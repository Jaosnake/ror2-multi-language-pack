    "GUNSLINGER_GAMBLE_UNLOCKABLE_ACHIEVEMENT_DESC": "Como Gunslinger, obtén éxito en un Shrine of Chance 7 veces consecutivas en una sola partida.",
    "GUNSLINGER_GAUNTLET_ITEM_NAME": "Guantelete del Infinito",
    "GUNSLINGER_GAUNTLET_ITEM_DESC": "<style=cIsDamage>Acaba con el 50%</style> de <style=cIsHealth>todos</style> los seres vivos al azar. Se recarga cada <style=cIsUtility>60s</style>.",
    "GUNSLINGER_GAUNTLET_ITEM_PICKUP": "Elimina la mitad de toda la vida al azar.",
    "GUNSLINGER_GAUNTLET_ITEM_LORE": "\"Sé lo que se siente al perder. Sentir con tanta desesperación que tienes razón, y aun así fracasar. Es aterrador, te tiemblan las piernas.\"",
    "GUNSLINGER_NAME": "Gunslinger",
    "GUNSLINGER_SUBTITLE": "Pacificador",
    "GUNSLINGER_PASSIVE_NAME": "Forma Espectral",
    "GUNSLINGER_PASSIVE_DESCRIPTION": "Gunslinger se vuelve más fuerte cuando se encuentra cerca de entidades hostiles.               <style=cKeywordName>Forma Espectral</style><style=cSub></style>",
    "GUNSLINGER_VENDETTA": "Vendetta",
    "GUNSLINGER_VENDETTA_DESCRIPTION": "Gunslinger dispara Vendetta infligiendo un 280% de daño por bala, porta hasta seis balas y recarga tras disparar la última. Cada sexta bala asesta un golpe crítico con un 25% de daño adicional.",
    "GUNSLINGER_UNLOAD": "Descargar",
    "GUNSLINGER_UNLOAD_DESCRIPTION": "Dispara Vendetta infligiendo un 200% de daño. Por cada disparo acertado en un enemigo, el daño y la probabilidad crítica de Descargar aumentan, hasta un máximo de +150% de daño y 40% de probabilidad crítica. Errar disparos (la bóveda celeste no cuenta) reinicia las acumulaciones de Descargar.",
    "GUNSLINGER_ACCURSEDARM": "Brazo Maldito",
    "GUNSLINGER_ACCURSEDARM_DESCRIPTION": "Gunslinger carga una poderosa maldición que inflige un 400% de daño, atravesando a los enemigos en línea recta. Los enemigos alcanzados quedan debilitados.",
    "GUNSLINGER_ORB": "Orbe Maldito",
    "GUNSLINGER_ORB_DESCRIPTION": "Gunslinger lanza una poderosa esfera de maldición que electrocuta a los enemigos cercanos infligiendo un 10% de daño y detona al impactar en una amplia área infligiendo un 320% de daño. Los enemigos alcanzados por la explosión quedan debilitados.",
    "GUNSLINGER_WRAITHSTEP": "Paso Espectral",
    "GUNSLINGER_WRAITHSTEP_DESCRIPTION": "Gunslinger realiza una carrera corta hacia delante. Almacena hasta cinco cargas.",
    "GUNSLINGER_WRAITHFRENZY": "Frenesí Espectral",
    "GUNSLINGER_WRAITHFRENZY_DESCRIPTION": "Gunslinger entra en estado de frenesí y obtiene un 50% de velocidad de movimiento y un 20% de robo de vida. Dura 3 segundos.",
    "GUNSLINGER_SOULPIERCER": "Perforador de Almas",
    "GUNSLINGER_SOULPIERCER_DESCRIPTION": "Gunslinger dispara una ráfaga de proyectiles espectrales que infligen un 180% de daño por bala. La cantidad de balas aumenta con la velocidad de ataque. Atraviesa a los enemigos. Causa daño adicional en función de la salud perdida del enemigo.",
    "GUNSLINGER_DEADEYE": "Ojo Certero",
    "GUNSLINGER_DEADEYE_DESCRIPTION": "Apunta con precisión hacia un objetivo. Dispara hasta 3 potentes balas que detonan al contacto, infligiendo un 300% de daño en un área reducida. Los enemigos alcanzados quedan ralentizados. <style=cKeywordName>Flotar</style><style=cSub></style>",
    "GUNSLINGER_DEADEYE_KEYWORD": "<style=cKeywordName>Flotar</style><style=cSub> Gunslinger flota en el aire y permanece inmovilizado mientras dura el efecto. Mientras se encuentra en el aire, dispara 3 balas en rápida sucesión, causando un 200% de daño cada una.</style>",
    "GUNSLINGER_DEADEYE_PRIMARY": "Ojo Certero",
    "GUNSLINGER_DEADEYE_PRIMARY_DESCRIPTION": "Gunslinger flota en el aire y apunta con precisión hacia un objetivo. Dispara hasta 3 potentes balas que detonan al contacto, infligiendo un 300% de daño en un área reducida. Los enemigos alcanzados quedan ralentizados.",
    "GUNSLINGER_DESCRIPTION": "El pistolero más rápido del oeste.<color=#CCD3E0></color>",
    "GUNSLINGER_OUTRO": "..y así partió, cantando Take Me Home.",
    "GUNSLINGER_FAIL": "..y así se desvaneció, en las profundidades del espacio.",
    "GUNSLINGER_RING_ITEM_LORE": "Como último Anillo Malvado que queda, espero una suma cuantiosa."
  }
