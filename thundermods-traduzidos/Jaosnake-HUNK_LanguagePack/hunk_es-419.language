    "ROB_HUNK_BODY_SHOOT_FLAMETHROWER_DESCRIPTION": "Dispara un chorro de llamas que causa <style=cIsDamage>toneladas de daño</style>. <style=cIsUtility>Incendia.</style>",
    "ROB_HUNK_BODY_SHOOT_M19_NAME": "Disparar",
