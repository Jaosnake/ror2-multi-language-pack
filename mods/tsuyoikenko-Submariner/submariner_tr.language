    "KENKO_SUBMARINER_MASTERY_SKIN_NAME": "Abisal",
    "KENKO_SUBMARINER_PASSIVE_NAME": "N'kuhana'nın Lütfu",
    "KENKO_SUBMARINER_PASSIVE_DESCRIPTION": "Düşmanlara <style=cIsDamage>yakın dövüş saldırıları</style> ile vurmak <style=cIsHealing>N'kuhana'nın Yenilemesi</style> kazandırır.",
    "KENKO_SUBMARINER_PRIMARY_SWING_NAME": "AL811 Çapa Cihazı",
