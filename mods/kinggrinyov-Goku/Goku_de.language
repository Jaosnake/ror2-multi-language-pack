        "KINGMOD_NO_STAT_BOOSTS": " hat keine Attributsboni...",
        "KINGMOD_ALL_FORMS_UNLOCKED": "Alle Formen freigeschaltet?",
        "KINGMOD_UNTIL_NEXT_UNLOCK": " Meisterschaftsstufen bis zur nächsten Freischaltung",
        "KINGMOD_COSTS_KI_FORMAT": "Kostet <color=#03bcff>{0} Ki</color>",
        "KINGMOD_DAMAGE_FORMAT": "<color=#E5C962>{0}% Schaden</color>",
        "KINGMOD_STAT_NAME_DAMAGE": "Schaden",
        "KINGMOD_STAT_NAME_ARMOR": "Rüstung",
        "KINGMOD_STAT_NAME_ATTACKSPEED": "Angriffsgeschwindigkeit",
        "KINGMOD_STAT_NAME_MOVESPEED": "Bewegungsgeschwindigkeit",
        "KINGMOD_STAT_NAME_REGEN": "Gesundheitsregeneration",
        "KINGMOD_STAT_NAME_MAXHEALTH": "Maximale Gesundheit",
        "KINGMOD_TUTORIAL_F1": "Aktivieren/deaktivieren Sie Tutorials, indem Sie F1 drücken",
        "KINGMOD_TUTORIAL_FORM_MASTERY": "Mit Formbeherrschung erhältst du mit der Zeit oder durch Schaden an Gegnern Erfahrung. Ein höheres Formlevel gewährt:\n- Einen höheren Attributbonus deiner Transformation.\n- Einen geringeren Ki-Verbrauch deiner Transformation.\n- Eine höhere allgemeine Ki-Regeneration.\nIn der Grundform steigen Ki-Regeneration und maximales Ki.",
        "KINGMOD_TUTORIAL_TRANSFORM_TRIGGER": "Ist dein Meisterschaftslevel hoch genug, tippe auf die Transformationstaste (standardmäßig C), um eine Haupttransformation zu aktivieren; mit X kehrst du zu einer niedrigeren Form zurück. Sind weitere Transformationen freigeschaltet, drücke die Taste erneut, um weiter aufzusteigen!",
        "KINGMOD_TUTORIAL_ULTIMATE_SKILL": "Während du verwandelt bist, hast du Zugang zu einer ultimativen Fähigkeit. Aktivieren Sie es, indem Sie die unten zugeordnete Taste drücken.",
        "KINGMOD_TUTORIAL_KI_RESOURCE": "Ki ist eine Ressource, die Ihre Fähigkeiten nutzen. Gewinnen Sie etwas zurück, indem Sie Feinde mit Ihrer Primärfähigkeit treffen.",
        "KINGMOD_TUTORIAL_ZENKAI": "Erhalte Zenkais, indem du stirbst oder 30 Sekunden lang unter 20 % deiner Gesundheit bleibst. Gewährt dauerhafte Bonusstatistiken.",
        "KINGMOD_TUTORIAL_LIGHT_CHARGE": "Erhalte leichte Ladung, indem du Feinde mit deinem Schwert triffst. Sobald es voll ist, aktivieren Sie es, indem Sie die Transformationstaste gedrückt halten. Gewährt zusätzlichen Schaden und kritische Trefferchance, solange es aktiv ist.",
        "KINGMOD_TUTORIAL_KAIOKEN": "Schalte Kaioken-Formen frei, indem du deine Grundform aufwertest.\nIst Kaioken verfügbar, erscheinen Pfeile über der Kaioken-Anzeige.\nHalte die Transformationstaste gedrückt, um Kaioken zu aktivieren.\nWährenddessen wird dein Körper belastet und die Anzeige füllt sich.\nIst sie voll, wirst du mit hoher Wahrscheinlichkeit betäubt.\nEin höheres Level der Grundform erhöht deine Belastungsgrenze.\nEine schnellere Belastung verlängert die Betäubung.\nHaupttransformationen benötigen Meisterschaft, um Kaioken standzuhalten.",
        "KINGMOD_POPUP_ADDED_FORMAT": "{0} hinzugefügt!",
        "KINGMOD_ULTIMATE_SKILL_TITLE": "ULTIMATIVE FÄHIGKEIT",
        "KINGMOD_TRANSFORMATIONS": "Transformationen",
        "KINGMOD_TRANSFORMATION": "Transformation",
        "KINGMOD_BASE_FORM": "Grundform",
        "KINGMOD_LEVEL": "Stufe"
    }
}
