    "ROB_NEMESIS_BODY_MELEE_NAME": "Assalto Brutale",
    "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Sferra un pugno per <style=cIsDamage>350% di danno</style>. Usa da <style=cIsUtility>fermo</style> per pestare il suolo per <style=cIsDamage>800% di danno</style>. Usa in <style=cIsUtility>scatto</style> per travolgere per <style=cIsDamage>600% di danno</style>.",
    "ROB_NEMESIS_BODY_GRAB_NAME": "Presa Mortale",
    "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Afferra un nemico. Usa Primaria per divorarlo e curare il 10% della salute massima, o Secondaria per caricare un lancio fino a 2400% di danno.",
    "ROB_NEMESIS_BODY_DASH_NAME": "Carica Biohazard",
    "ROB_NEMESIS_BODY_DASH_DESCRIPTION": "Usa mentre sei <style=cIsUtility>in aria</style> per scattare in volo <style=cIsDamage>una volta</style>.",
    "ROB_NEMESIS_BODY_ULTIMATE_NAME": "Massa Critica",
    "ROB_NEMESIS_BODY_ULTIMATE_DESCRIPTION": "Tieni premuto per consumare lentamente la <style=cIsHealth>Biomassa</style>, ripristinando fino al <style=cIsHealing>100% della salute massima</style>.",
