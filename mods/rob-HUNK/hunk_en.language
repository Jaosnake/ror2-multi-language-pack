    "ROB_HUNK_DIAMOND_KEYCARD_NAME": "U.C. Keycard (Diamond)",
    "ROB_HUNK_GOLD_KEYCARD_NAME": "U.C. Keycard (Star)",
    "ROB_HUNK_MASTER_KEYCARD_NAME": "U.C. Keycard (Master)",
    "ROB_HUNK_KEYCARD_DESC": "Used to open <color=#C80202>Umbrella Corporation</color> <style=cIsUtility>weapon cases</style>.",
    "ROB_HUNK_KEYCARD_MASTER_DESC": "Used to open <color=#C80202>Umbrella Corporation</color> <style=cIsUtility>weapon cases</style>. Opens <style=cIsHealing>all cases</style>, and turns other keycards into <style=cIsUtility>scrap</style>.",
    "ROB_HUNK_WRISTBAND_NAME": "I.D. Wristband",
    "ROB_HUNK_WRISTBAND_DESC": "An electronic key for use in <color=#C80202>Umbrella Corporation</color> facilities. Used to open a <style=cIsUtility>special weapon case</style>.",
    "ROB_HUNK_TYPEWRITER_NAME": "Typewriter",
    "ROB_HUNK_TYPEWRITER_DESC": "Gain <style=cIsUtility>2</style> additional <color=#C80202>Umbrella Corporation</color> <style=cIsUtility>weapon cases</style> per stage.",
    "ROB_HUNK_CRYSTALSKULL_NAME": "Crystal Skull",
    "ROB_HUNK_CRYSTALSKULL_DESC": "A rare treasure. Can be turned into any <style=cIsUtility>Cauldron</style> to receive one item.",
    "ROB_HUNK_STARSBADGE_NAME": "S.T.A.R.S. Badge",
    "ROB_HUNK_STARSBADGE2_NAME": "USB Dongle Key",
    "ROB_HUNK_STARSBADGE_DESC": "A special badge for R.P.D.'s special forces division, <color=#F20443>S.T.A.R.S.</color> <style=cIsHealth>Maybe picking this up was a bad idea?</style>",
    "ROB_HUNK_STARSBADGE_DESCFULL": "Each stage, a special <color=#F20443>S.T.A.R.S.</color> box spawns that can only be opened using this badge. However, the <style=cIsHealth>Nemesis T-Type</style> will relentlessly hunt you down.",
    "ROB_HUNK_STARSBADGE2_DESC": "Used to access a <style=cIsUtility>special chest</style> on each stage.",
    "ROB_HUNK_STARSBADGE2_DESCFULL": "Each stage, a special <color=#F20443>S.T.A.R.S.</color> box spawns that can only be opened using this badge. However, the <style=cIsHealth>Nemesis T-Type</style> will relentlessly hunt you down.",
    "ROB_HUNK_G_VIRUS_SAMPLE_NAME": "G-Virus Sample",
    "ROB_HUNK_G_VIRUS_SAMPLE_DESC": "Volatile sample of the <color=#C678B4>Golgotha Virus</color>. <style=cIsHealth>Handle with care.</style>",
    "ROB_HUNK_T_VIRUS_SAMPLE_NAME": "T-Virus Sample",
    "ROB_HUNK_T_VIRUS_SAMPLE_DESC": "Volatile sample of the <color=#0066FF>Tyrant Virus</color>. <style=cIsHealth>Handle with care.</style>",
    "ROB_HUNK_C_VIRUS_SAMPLE_NAME": "C-Virus Sample",
    "ROB_HUNK_C_VIRUS_SAMPLE_DESC": "Volatile sample of the <color=#FF0033>Chrysalid Virus</color>. <style=cIsHealth>Handle with care.</style>",
    "ROB_HUNK_URO_SAMPLE_NAME": "Uroboros Sample",
    "ROB_HUNK_URO_SAMPLE_DESC": "Volatile sample of the <color=#140E0E>Uroboros Virus</color>. <style=cIsHealth>Handle with care.</style>",
    "ROB_HUNK_PLAGAS_SAMPLE_NAME": "Plagas Sample",
    "ROB_HUNK_PLAGAS_SAMPLE_DESC": "Volatile sample of the <color=#C678B4>Plagas</color>. <style=cIsHealth>Handle with care.</style>",
