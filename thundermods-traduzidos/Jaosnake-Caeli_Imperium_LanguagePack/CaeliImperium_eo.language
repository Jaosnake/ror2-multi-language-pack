    "CI_BISHOP_SPEAR_THROW": "Jxeti",
    "CI_BISHOP_SPEAR_SLAM": "Frapegi",
    "CI_BISHOP_SPEAR_CHAIN": "En Konstruo",
    "CI_DIFFICULTY_HURTMEPLENTY_NAME": "Dolorigu Min Abunde",
    "CI_DIFFICULTY_HURTMEPLENTY_DESC": "Tiel la ludo estas destinita por esti ludata kiel Doomguy! Venku la Cxefan Finan Estron kiel Doomguy por malsxlosi cxi tiun malfacilecon por cxiuj transvivantoj kaj malsxlosi la ceterajn malfacilecojn por Doomguy (nuntempe cxi tiu funkcio ankoraux ne estas efektivigita).<style=cStack>\n\nRapideco de Monstraj Projektiloj: <style=cIsHealing>-35%</style>\nFlugalteco de Monstroj: <style=cIsHealing>8m</style>\nElitoj: <style=cIsHealing>Forigitaj</style>\nRepusxo: <style=cIsDamage>Forigita</style>\nSpavoj, Objektoj Kaj Ekipajxoj: <style=cIsDamage>Redistribuitaj</style>. <style=cIsHealth>-75% da damagxo. Ne povas svenigi, sxoki, senmovigi kaj frostigi</style>\nMonstroj: <style=cIsHealth>Ne celas servistojn</style>\nSano de Pezaj Monstroj: <style=cIsHealth>+60%</style>\nSano de Estraj Monstroj: <style=cIsHealth>+120%</style>\nPrintiloj Kaj Rubigantoj: <style=cIsHealth>Forigitaj</style>\nMalplenaj Kaj Lunaj Objektoj: <style=cIsHealth>Forigitaj</style>\nMalfortaj Monstroj: <style=cIsHealth>Forigitaj</style>\nFrapsvenigoj: <style=cIsHealth>Forigitaj</style></style>",
    "CI_DOOMGUY_BODY_NAME": "Doomguy",
    "CI_DOOMGUY_BODY_SUBTITLE": "Kondamnita ulo aux kondamnanta ulo aux io tia mns",
    "CI_DOOMGUY_NAME": "Doomguy",
    "CI_DOOMGUY_DESC": "Li estas la Doomguy!",
    "CI_DOOMGUY_SHOTGUN_NAME": "Batala Kartocxfusilo",
    "CI_DOOMGUY_SHOTGUN_DESC": "Pafu kugletojn por <style=cIsDamage>5x120% da damagxo</style>",
    "CI_DOOMGUY_SPEAR_NAME": "Lanca Svingo",
    "CI_DOOMGUY_SPEAR_DESC": "Svingu lancon por <style=cIsDamage>200% da damagxo</style>. <style=cIsUtility>Paradu</style> alvenantajn <style=cIsHealing>paradeblajn</style> atakojn kaj projektilojn. Akiru <style=cDeath>plifortigon</style> kaj <style=cIsUtility>malpliigu malvarmigxon</style> de via Utila kapablo je <style=cIsHealing>sukcesa parado</style>",
    "CI_DOOMGUY_ACCELERATOR_NAME": "Plasma Akcelilo",
    "CI_DOOMGUY_ACCELERATOR_DESC": "Pafu plasman projektilon por <style=cIsDamage>50% da damagxo</style>. Dauxra pafado supersxargxos la akcelilon kaj pliigos la damagxon de plasmaj projektiloj al <style=cIsDamage>125% da damagxo</style>. Liberigu supersxargxon je ellaso de ekigilo kaj faru <style=cIsDamage>500% da damagxo</style>",
    "CI_DOOMGUY_DASH_NAME": "Impeto",
    "CI_DOOMGUY_DASH_DESC": "<style=cIsUtility>Impetu</style> al movodirekto",
    "CI_DOOMGUY_SPEARSPECIAL_NAME": "Lanca Plifortigo",
    "CI_DOOMGUY_SPEARSPECIAL_DESC": "Preparu lancon por <style=cDeath>plifortigo</style>. Konsumas 5 <style=cDeath>plifortigojn</style> dum uzo.\n\nUnuagrada: Jxetu lancon por <style=cIsDamage>2000% da damagxo</style>. Faras <style=cIsDamage>kritikajn trafojn</style> kaj <style=cIsDamage>supersvenigas</style> je kaptrafo.\n\nSekundara: En Konstruo\n\nUtila: Saltu malsupren farante <style=cIsDamage>700% da damagxo</style> en <style=cIsUtility>24-metra radiuso</style>",
    "CI_DOOMGUY_PUNCH_NAME": "Pugnofrapo",
    "CI_DOOMGUY_PUNCH_DESC": "Pugnofrapu celon por <style=cIsDamage>800% da damagxo</style>. Se la celo estas <style=cDeath>sxancelita</style>, sxargxo ne estas konsumita kaj vi sanigxas je <style=cIsHealing>3.125%/12.5%/25%</style> de maksimuma sano kaj <style=cIsHealing>10%/25%/50%</style> de rezerva sanigo laux la celklaso kaj akiras <style=cDeath>plifortigon</style>"
  }
