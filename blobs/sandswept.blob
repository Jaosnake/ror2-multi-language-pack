	public class InverseFalloffProjectile : MonoBehaviour
	{
		public Vector3 initialPosition;

		public float baseDistance = 60f;

		public float minDamage = 0.6f;

		public float minRadius = 0.75f;

		public float maxDamage = 1.4f;

		public float maxRadius = 1.4f;

		public int stages = 0;

		public ProjectileExplosion explosion;

		public ProjectileDamage damage;

		public float originalDamage;

		public float originalRadius;

		public float[] thresholds;

		public void Start()
		{
			//IL_0053: Unknown result type (might be due to invalid IL or missing references)
			//IL_0058: Unknown result type (might be due to invalid IL or missing references)
			damage = ((Component)this).GetComponent<ProjectileDamage>();
			explosion = ((Component)this).GetComponent<ProjectileExplosion>();
			originalDamage = damage.damage;
			if (Object.op_Implicit((Object)(object)explosion))
			{
				originalRadius = explosion.blastRadius;
			}
			initialPosition = ((Component)this).transform.position;
			thresholds = new float[3]
			{
				0f,
				baseDistance,
				baseDistance * 1.5f
			};
		}

		public void DollarStoreConstructor(float dist, float minD, float maxD, float minR, float maxR)
		{
			baseDistance = dist;
			minDamage = minD;
			maxDamage = maxD;
			minRadius = minR;
			maxRadius = maxR;
		}

		public void FixedUpdate()
		{
			//IL_0007: Unknown result type (might be due to invalid IL or missing references)
			//IL_000d: Unknown result type (might be due to invalid IL or missing references)
			float num = Mathf.Clamp(Vector3.Distance(((Component)this).transform.position, initialPosition), 0f, thresholds[2]);
			if (num < thresholds[1])
			{
				stages = 1;
				damage.damage = Util.Remap(num, 0f, thresholds[1], originalDamage * minDamage, originalDamage);
				if (Object.op_Implicit((Object)(object)explosion))
				{
					explosion.blastRadius = Util.Remap(num, 0f, thresholds[1], originalRadius * minRadius, originalRadius);
				}
			}
			if (num > thresholds[1])
			{
				stages = 2;
				damage.damage = Util.Remap(num, thresholds[1], thresholds[2], originalDamage, originalDamage * maxDamage);
				if (Object.op_Implicit((Object)(object)explosion))
				{
					explosion.blastRadius = Util.Remap(num, thresholds[1], thresholds[2], originalRadius, originalRadius * maxRadius);
				}
			}
			if (num > thresholds[2])
			{
				stages = 3;
			}
		}
	}
