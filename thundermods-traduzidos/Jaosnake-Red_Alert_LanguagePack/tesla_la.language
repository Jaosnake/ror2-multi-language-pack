    "HABIBI_TESLA_BODY_PRIMARY_ZAP_NAME": "Manica Tesla",
    "HABIBI_TESLA_BODY_PRIMARY_ZAP_DESCRIPTION": "<style=cIsUtility>Onerans</style>. Percute unitates petitas fulmine electricitatis pro <style=cIsDamage>120% damni</style>. Emittit <style=cIsUtility>usque ad 3 fulmina</style> ex <style=cIsUtility>brevi distantia</style>.",
    "HABIBI_TESLA_BODY_KEYWORD_CHARGED": "<style=cKeywordName>Onerans</style><style=cSub>Socius oneratus proximum impetum <style=cIsUtility>fulgurantem</style> habet et damnum auctum per <style=cIsDamage>1.1x</style></style>",
    "HABIBI_TESLA_BODY_PRIMARY_PUNCH_NAME": "Caestus Tesla",
    "HABIBI_TESLA_BODY_PRIMARY_PUNCH_DESCRIPTION": "Percute hostes pugno pro <style=cIsDamage>300% damni</style> et hostes in cono fulgura pro <style=cIsDamage>150% damni</style>. <style=cIsUtility>Tela Deflectit</style>.",
    "HABIBI_TESLA_BODY_SECONDARY_BIGZAP_NAME": "2000 Voltii",
    "HABIBI_TESLA_BODY_SECONDARY_BIGZAP_DESCRIPTION": "<style=cIsUtility>Stupefaciens.</style> Crea explosionem electricam in magna area pro <style=cIsDamage>690% damni</style>. Prope <style=cIsUtility>Turrem Tesla</style>, fac versionem <style=cIsUtility>roboratam et fulgurantem</style> pro <style=cIsDamage>1500% damni</style>.",
    "HABIBI_TESLA_BODY_SECONDARY_BIGZAPPUNCH_NAME": "Pugnus Oneratus",
    "HABIBI_TESLA_BODY_SECONDARY_BIGZAPPUNCH_DESCRIPTION": "Tene ut pugnum oneres pro <style=cIsDamage>80%-800% damni</style> et hostes in cono fulgura pro <style=cIsDamage>40%-400% damni</style>. Prope <style=cIsUtility>Turrem Tesla</style>, conum fulgurum muta in radium <style=cIsUtility>fulgurantem</style> longae distantiae pro <style=cIsDamage>120%-1200% damni</style>",
    "HABIBI_TESLA_BODY_UTILITY_BARRIER_NAME": "Oneratio",
    "HABIBI_TESLA_BODY_UTILITY_BARRIER_DESCRIPTION": "Per <style=cIsUtility>4 secundas</style>, <style=cIsUtility>100% damni</style> negatur atque <style=cIsUtility>absorbetur</style>. Postea, <style=cIsDamage>explositio</style> fit in lata area <style=cIsDamage>pro damno absorpto</style>.",
    "HABIBI_TESLA_BODY_UTILITY_BLINK_NAME": "Impetus Electricus",
    "HABIBI_TESLA_BODY_UTILITY_BLINK_DESCRIPTION": "<style=cIsUtility>Stupefaciens.</style> Fi <style=cIsUtility>fulmen electricitatis</style> et in hostem petitum irrue, inferens <style=cIsDamage>300% damni</style>. <style=cIsDamage>Iterum mitti potest</style> intra breve spatium. Eundem hostem bis petere non potest.",
    "HABIBI_TESLA_BODY_SPECIAL_TOWER_NAME": "Turris Tesla",
    "HABIBI_TESLA_BODY_SPECIAL_TOWER_DESCRIPTION": "Aedifica Turrem Tesla per <style=cIsUtility>12 secundas</style> quae unitates propinquas fulgurat pro <style=cIsDamage>3x230% damni</style>. Artem Secundariam roborat.",
    "HABIBI_TESLA_BODY_SPECIAL_SCEPTER_TOWER_NAME": "Rete Tesla",
    "HABIBI_TESLA_BODY_SPECIAL_SCEPTER_TOWER_DESCRIPTION": "Aedifica Turrem Tesla per <style=cIsUtility>12 secundas</style> quae unitates propinquas fulgurat pro <style=cIsDamage>3x230% damni</style>. Artem Secundariam roborat.\n<color=#d299ff>SCEPTRUM: Tempus refectionis imminutum, Copia addita, Turris usque ad 3 scopos simul fulgurat</color>",
    "ACHIEVEMENT_HABIBI_TESLA_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Miles Tesla: Magisterium",
