    "WUNT_FISHERMAN_PASSIVE_HOOK_EFFECT_DESCRIPTION": "Quidam impetus pisces <color=#d299ff>Inhamant</color>, eos propius trahentes. Si piscis nimis gravis est ut <color=#d299ff>Inhametur</color>, fac eum <style=cIsHealth>sanguinare</style> pro <style=cIsHealth>120% damni.</style>",
    "WUNT_FISHERMAN_PRIMARY_SLASH_NAME": "<color=#23677f>Exossare</color>",
    "WUNT_FISHERMAN_PRIMARY_SLASH_DESCRIPTION": "Percute ante te pro <style=cIsDamage>260% damni.</style> 1us impetus est punctio longi iactus quae pisces <color=#d299ff>Inhamat</color>.",
    "WUNT_FISHERMAN_SECONDARY_GUN_NAME": "<color=#165475>Iactus</color>",
