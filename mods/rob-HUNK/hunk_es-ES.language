    "ROB_HUNK_BODY_SHOOT_SHOTGUN_DESCRIPTION": "Dispara causando un <style=cIsDamage>14x150% de daño</style>. <style=cIsUtility>Bonificación del 50% por tiro en la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_M3_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_M3_DESCRIPTION": "Dispara causando un <style=cIsDamage>10x130% de daño</style>. <style=cIsUtility>Bonificación del 50% por tiro en la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_SSG_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_SSG_DESCRIPTION": "Dispara causando un <style=cIsDamage>16x200% de daño</style>. <style=cIsUtility>Bonificación del 50% por tiro en la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_STREETSWEEPER_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_STREETSWEEPER_DESCRIPTION": "Dispara causando un <style=cIsDamage>14x24% de daño</style>. <style=cIsUtility>Bonificación del 25% por tiro en la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_DESCRIPTION": "Dispara causando un <style=cIsDamage>3000% de daño</style>. <style=cIsUtility>Bonificación del 50% por tiro en la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_SMG_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_SMG_DESCRIPTION": "Dispara causando un <style=cIsDamage>110% de daño</style>. <style=cIsUtility>Bonificación del 25% por tiro en la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_AR_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_AR_DESCRIPTION": "Dispara causando un <style=cIsDamage>385% de daño</style>. <style=cIsUtility>Bonificación del 50% por tiro en la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Dispara causando un <style=cIsDamage>2x250% de daño</style>. <style=cIsUtility>El daño escala con la velocidad de ataque.</style>",
    "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Mira Estable",
    "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Apunta, <style=cIsUtility>dejando al descubierto los puntos débiles enemigos</style>. <style=cIsDamage>Usar la habilidad primaria al apuntar dispara el arma que empuñas.</style>",
    "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Paso Veloz",
    "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Deslízate</style> una distancia corta. Si se usa a tiempo para <style=cIsUtility>evitar un ataque</style>, ejecutas una <style=cIsDamage>Evasión Perfecta</style>.",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Deslízate</style> una distancia corta. Si se usa a tiempo para <style=cIsUtility>evitar un ataque</style>, ejecutas una <style=cIsDamage>Evasión Perfecta</style>.\n<color=#d299ff>CETRO: El poder de Uroboros corre por tus venas.</color>",
    "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Bloqueo",
    "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Bloquea</style> un ataque, <style=cIsDamage>anulando</style> el daño y <style=cIsUtility>devolviendo el enfriamiento</style>. Si se usa con antelación, ejecutas un <style=cIsDamage>Bloqueo Perfecto</style>.",
    "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Placaje con el Hombro",
    "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Placa</style> a los enemigos cercanos, <style=cIsUtility>aturdiéndolos</style> con un <style=cIsDamage>400% de daño</style>. Si se usa a tiempo para <style=cIsUtility>interrumpir un ataque</style>, ejecutas un <style=cIsDamage>Placaje Perfecto</style>.",
    "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Legión",
    "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Cambia</style> a un <style=cIsDamage>arma de fuego</style> distinta. Pulsa brevemente para volver a tu <style=cIsUtility>última arma empuñada</style>.",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Cuchillo de Combate",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "Un cuchillo reglamentario de grado militar. Sin duda te vendrá de perlas en un apuro.",
    "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "Cuchillo de Combate EX",
