{
  "en": {
    "WUNT_FISHERMAN_NAME": "Fisherman",
    "WUNT_FISHERMAN_SUBTITLE": "Sickly Poacher",
    "WUNT_FISHERMAN_DESCRIPTION": "Fisherman is a utility focused survivor that forces enemies to fight on his terms.<color=#CCD3E0>\n\n< ! > Debone can be used to snatch enemies out of the air and throw attackers out of position\n\n< ! > Cast can be used to grab faraway enemies, chests, drones and all sorts of things in order to clear stages quickly\n\n< ! > The F153 Mobile Shanty plaform may not help you dodge attacks, but can help you navigate large gaps, sheer cliffs and other obstacles\n\n< ! > Man o' War can be used to group up pesky flyers or throw enemies off stage.\n\n< ! > Steady the Nerves is good for comboing enemies and staying alive.</color>",
    "WUNT_FISHERMAN_LORE": "UES Safe Travels Brig Logs\r\n \r\nIncident Report\r\n \r\nDefendant became belligerent after breakfast, confirmed reports indicate he threw his entire tray of food at a guard while yelling \"You cannot force this muck down the gullet of a captain! When we land I'll take a haul and show you what REAL food looks like!\"\r\n \r\nDefendant has been placed in solitary confinement for the remainder of the voyage.",
    "WUNT_FISHERMAN_OUTRO_FLAVOR": "..and so he left, with what little time he had.",
    "WUNT_FISHERMAN_OUTRO_FAILURE": "..and so he vanished, lost at sea.",
    "WUNT_FISHERMAN_MASTERY_SKIN_NAME": "Alternate",
    "WUNT_FISHERMAN_PASSIVE_HOOK_EFFECT_NAME": "The Hooks!",
    "WUNT_FISHERMAN_PASSIVE_HOOK_EFFECT_DESCRIPTION": "Certain attacks Hook fish, pulling them close. If a fish is too heavy to be Hooked, bleed them for 120% damage.",
    "WUNT_FISHERMAN_PRIMARY_SLASH_NAME": "Debone",
    "WUNT_FISHERMAN_PRIMARY_SLASH_DESCRIPTION": "Thwack in front for <style=cIsDamage>{0}% damage.</style> The 1st attack is a long range stab that {1} fish.",
    "WUNT_FISHERMAN_SECONDARY_GUN_NAME": "Cast",
    "WUNT_FISHERMAN_SECONDARY_GUN_DESCRIPTION": "<style=cIsUtility>Non-Lethal.</style> Charge up and cast out an arcing hook. Recall it to {0} fish for <style=cIsDamage>{1}% damage.</style>",
    "WUNT_FISHERMAN_UTILITY_PLATFORM_NAME": "F153 Mobile Shanty Platform",
    "WUNT_FISHERMAN_UTILITY_PLATFORM_DESCRIPTION": "<style=cIsUtility>Soulbound.</style> Deploy a <style=cIsUtility>Directable</style> drone that <style=cIsUtility>you can ride on.</style> Automatically fires at fish with a cannon for <style=cIsDamage>{0}% damage.</style>",
    "WUNT_FISHERMAN_UTILITY_MINION_NAME": "Junior",
    "WUNT_FISHERMAN_UTILITY_DIRECT_NAME": "Direct Platform",
    "WUNT_FISHERMAN_UTILITY_DIRECT_DESCRIPTION": "Tap to direct the platform to move to a targeted location or target a fish with its cannon. Hold to Destroy it.",
    "WUNT_FISHERMAN_UTILITY_WHALE_NAME": "Strange Friend",
    "WUNT_FISHERMAN_UTILITY_WHALE_DESCRIPTION": "Release a <style=cIsUtility>Smackable</style> whale that <style=cIsUtility>inherits all your items.</style> Emits smog that blinds nearby fish. Recast to detonate for <style=cIsDamage>700% damage.</style>",
    "WUNT_FISHERMAN_UTILITY_WHALE_MINION_NAME": "Fisherman's Friend",
    "WUNT_FISHERMAN_SPECIAL_BOMB_NAME": "Man o' War",
    "WUNT_FISHERMAN_SPECIAL_BOMB_DESCRIPTION": "Launch a sticky bomb that <style=cIsUtility>Tethers</style> fish. Re-Activate to {0} <style=cIsUtility>Tethered</style> fish into a cluster.",
    "WUNT_FISHERMAN_SPECIAL_DRINK_NAME": "Steady The Nerves",
    "WUNT_FISHERMAN_SPECIAL_DRINK_DESCRIPTION": "<style=cIsDamage>Stunning</style>. <style=cIsDamage>Regenerative.</style> Perform a forceful uppercut for <style=cIsDamage>{0}% damage</style> and take a drink, cleansing all debuffs.",
    "WUNT_FISHERMAN_masteryAchievement": "As Fisherman, beat the game or obliterate on Monsoon.",
    "WUNT_FISHERMAN_masteryUnlockable": "Fisherman: Mastery",
    "KEYWORD_TREASURE": "<style=cKeywordName>Treasure</style><style=cSub> Cast can Hook drones, items, chests, and more...</style>",
    "KEYWORD_NONLETHAL": "<style=cKeywordName>Non-Lethal</style><style=cSub> Cannot kill.</style>",
    "KEYWORD_TETHER": "<style=cKeywordName>Tether</style><style=cSub> Reduces movement speed by <style=cIsDamage>30%.</style></style>",
    "KEYWORD_UNFINISHED": "<style=cKeywordName>UNFINISHED</style><style=cSub>Ability is still in development, meaning it probably functions poorly.</style>",
    "KEYWORD_DAUNTLESS": "<style=cKeywordName>Regenerative</style><style=cSub>Heal for 5% of your maximum life over 0.5s</style>",
    "KEYWORD_SMACK": "<style=cKeywordName>Smackable</style><style=cSub>This minion can be damaged and pushed by your abilities.</style>",
    "KEYWORD_LINKED": "<style=cKeywordName>Soulbound</style><style=cSub>This minion does not inherit your items, but all damage they deal is credited to you.</style>",
