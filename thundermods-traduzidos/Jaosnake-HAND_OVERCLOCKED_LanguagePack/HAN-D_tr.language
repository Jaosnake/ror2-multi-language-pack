    "MOFFEIN_HAND_BODY_PRIMARY_HAMMER_NAME": "PARAMPARÇA ETMEK",
    "MOFFEIN_HAND_BODY_PRIMARY_HAMMER_DESC": "<style=cIsHealth>Yavaşla</style>ve tüm savaşçıları parçala<style=cIsDamage>%600 hasar</style>. <style=cIsDamage>Sersemletici</style>sırasında<style=cIsDamage>HIZLANDIRMA</style>aktif.",
    "MOFFEIN_HAND_BODY_SECONDARY_NAME": "FORCED_REASSEMBLY",
