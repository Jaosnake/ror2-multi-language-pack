			//IL_0070: Unknown result type (might be due to invalid IL or missing references)
			ButtonState buttonState = InputBankExtensions.GetButtonState(base.body.inputBank, TornFeather.FeatherDash);
			if (((ButtonState)(ref buttonState)).justPressed && base.body.inputBank.moveVector != Vector3.zero)
			{
				PerformDash();
			}
