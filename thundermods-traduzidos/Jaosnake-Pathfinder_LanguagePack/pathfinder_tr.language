    "BOG_PATHFINDER_BODY_SPECIAL_CANCEL_NAME": "Komut Modunu İptal Et",
    "BOG_PATHFINDER_BODY_SPECIAL_CANCEL_DESCRIPTION": "Komut Modunu iptal eder.",
    "BOG_SQUALL_BODY_NAME": "Squall",
    "BOG_SQUALL_BODY_PICKUP": "Pathfinder'ın sadık robot şahini.",
    "BOG_SQUALL_BODY_DESCRIPTION": "Pathfinder'a eşlik eden robot bir şahin. Squall, Pathfinder'ın eşyalarının çoğunu devralır ve <style=cIsUtility>yok edilemez</style>.",
    "BOG_SQUALL_BODY_SKILL_DESCRIPTION": "<color=#FF0000>Saldırı Modu</color>ndayken düşmanlara monteli silahlar ve füzelerle ateş eder; <style=cIsDamage>Boğazına Saldır</style> komutu verildiğinde hedeflere tekrar tekrar saldırır.",
