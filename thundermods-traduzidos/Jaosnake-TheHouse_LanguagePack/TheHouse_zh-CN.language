{
    "zh-CN": {
        "JAVANGLE_HOUSE_BODY_NAME": "House",
        "JAVANGLE_HOUSE_BODY_DESCRIPTION": "",
        "JAVANGLE_HOUSE_BODY_SUBTITLE": "疯狂赌徒",
        "JAVANGLE_HOUSE_BODY_LORE": "说到老虎机，飞船娱乐大厅里刚装了一台新的，大伙都在传那鬼玩意好像活的一样，真是疯了……等等，他们到底装了什么东西？！",
        "JAVANGLE_HOUSE_BODY_OUTRO_FLAVOR": "好吧，要不是我的头奖是这些神器，我也不会从那台老虎机里捞出这么多钱，简直把那鬼玩意变成了印钞机，庄家可不太高兴，把我踢了出来，从那以后我就一直被同一台老虎机追杀",
        "JAVANGLE_HOUSE_BODY_OUTRO_FAILURE": "哇哦哇哦等等！慢点说，虚空里的赌场？一台老虎机差点杀了你？……这么说你就是在那里弄到那些神器的，对吧？",
        "JAVANGLE_HOUSE_BODY_DEFAULT_SKIN_NAME": "House",
        "JAVANGLE_HOUSE_BODY_MASTERY_SKIN_NAME": "Mansion",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "House：精通",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "作为 House，在 Monsoon 难度下通关游戏或抹除自身。",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "House：精通",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "House：宗师",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "作为 House，在 Typhoon 难度下通关游戏或抹除自身。",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "House：宗师",
        "JAVANGLE_HOUSE_PASSIVE_NAME": "博弈",
        "JAVANGLE_HOUSE_PASSIVE_DESCRIPTION": "House 使用<style=cIsUtility>卡牌</style>代替<style=cIsUtility>技能</style>，每张卡牌都具有独特的效果。使用卡牌后，其槽位进入冷却，你将弃置手牌并重新抽取 3 张新卡牌。",
        "JAVANGLE_HOUSE_STANDARDSPREAD_NAME": "牌组：标准牌阵",
        "JAVANGLE_HOUSE_STANDARDSPREAD_DESCRIPTION": "一套简化的牌组，专为易于上手而设计。<style=cSub>[查看“卡牌”标签页以了解该牌组中的卡牌]</style>",
        "JAVANGLE_HOUSE_FULLHOUSE_NAME": "牌组：Full House",
        "JAVANGLE_HOUSE_FULLHOUSE_DESCRIPTION": "经典的 House 游玩体验。<style=cSub>[查看“卡牌”标签页以了解该牌组中的卡牌]</style>",
        "JAVANGLE_HOUSE_DIVINATION_NAME": "牌组：占卜",
        "JAVANGLE_HOUSE_DIVINATION_DESCRIPTION": "一套复杂的牌组，允许你精确掌控卡牌构成。<style=cSub>[查看“卡牌”标签页以了解该牌组中的卡牌]</style>",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_NAME": "弹艺：清空",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_DESCRIPTION": "随机发射一枚已装填的弹药。当没有剩余弹药时：什么都不做。",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_NAME": "弹艺：速拔",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_DESCRIPTION": "射击速度加快，但<style=cArtifact>所有射击造成的伤害降低</style>。当没有剩余弹药时：什么都不做。",
        "JAVANGLE_HOUSE_RELOADSTANDARD_NAME": "装填艺：标准",
        "JAVANGLE_HOUSE_RELOADSTANDARD_DESCRIPTION": "打出任何卡牌都会重装轮盘。根据所用卡牌的类型，有 50%/25% 的几率获得 1/2 发随机特殊弹药（红 = 穿透/霰弹/爆破，紫 = 空包/毒蛇，灰/绿 = 以上任意一种）。<style=cSub>[查看“卡牌”标签页以了解弹药及其效果]</style>",
        "JAVANGLE_HOUSE_RELOADALLIN_NAME": "装填艺：孤注一掷",
        "JAVANGLE_HOUSE_RELOADALLIN_DESCRIPTION": "打出任何卡牌都会重装轮盘。装填 0-6 发穿透/霰弹/爆破弹，<style=cArtifact>所有剩余弹药变为毒蛇弹</style>。<style=cSub>[查看“卡牌”标签页以了解弹药及其效果]</style>",
        "JAVANGLE_HOUSE_CARDARTSHOP_NAME": "牌艺：跃步",
        "JAVANGLE_HOUSE_CARDARTSHOP_DESCRIPTION": "打出任何卡牌时：向当前移动方向跃出一段距离。",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_NAME": "牌艺：横扫",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_DESCRIPTION": "打出任何卡牌时：向前挥甩卡牌，对近战范围内的敌人造成 <style=cIsDamage>{0}% 伤害</style>，且每命中一名敌人<style=cIsUtility>获得相当于你最大生命值 {1}% 的屏障</style>。",
        "JAVANGLE_HOUSE_SHUFFLEART_NAME": "洗牌艺：重洗",
        "JAVANGLE_HOUSE_SHUFFLEART_DESCRIPTION": "每当卡牌耗尽时：将弃牌堆重新洗入抽牌堆。",
        "JAVANGLE_HOUSE_STANDARDSHOT_NAME": "标准弹",
        "JAVANGLE_HOUSE_STANDARDSHOT_DESCRIPTION": "发射一枚标准子弹，造成 <style=cIsDamage>{0}% 伤害</style>。",
        "JAVANGLE_HOUSE_PIERCINGSHOT_NAME": "穿透弹",
        "JAVANGLE_HOUSE_PIERCINGSHOT_DESCRIPTION": "发射一枚特殊的穿透弹，贯穿目标并对每个目标造成 <style=cIsDamage>{0}% 伤害</style>",
        "JAVANGLE_HOUSE_BUCKSHOT_NAME": "霰弹",
        "JAVANGLE_HOUSE_BUCKSHOT_DESCRIPTION": "发射一阵霰弹轰击，造成 <style=cIsDamage>{0}% x {1} 伤害</style>。",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_NAME": "爆破弹",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_DESCRIPTION": "发射一枚爆炸性弹药，在范围区域内造成 <style=cIsDamage>{0}% 伤害</style>。",
        "JAVANGLE_HOUSE_SNAKESHOT_NAME": "毒蛇弹",
        "JAVANGLE_HOUSE_SNAKESHOT_DESCRIPTION": "尝试射击却<style=cSub>失败</style>，并承受相当于你<style=cDeath>最大生命值 {0}% 的自残伤害</style>",
        "JAVANGLE_HOUSE_BLANKSHOT_NAME": "空包弹",
        "JAVANGLE_HOUSE_BLANKSHOT_DESCRIPTION": "尝试射击，咔哒……<style=cSub>什么也没发生</style>。",
        "JAVANGLE_HOUSE_MYSTERYSHOT_NAME": "神秘弹",
        "JAVANGLE_HOUSE_MYSTERYSHOT_DESCRIPTION": "发射一枚随机装填的特殊弹药。",
        "JAVANGLE_HOUSE_ACESHOT_NAME": "王牌绝杀弹",
        "JAVANGLE_HOUSE_ACESHOT_DESCRIPTION": "蓄力发射一枚巨型杀伤弹，对眼前所有敌人造成 <style=cIsDamage>{0}% 伤害</style>，贯通所有距离乃至穿透墙壁",
        "JAVANGLE_HOUSE_7CLUBS_NAME": "梅花7",
        "JAVANGLE_HOUSE_7CLUBS_DESCRIPTION": "在轮盘中装填<style=cIsUtility>3 枚神秘弹</style>。\n此外，<style=cIsUtility>保证</style>你的下一发子弹必定为爆破弹。",
        "JAVANGLE_HOUSE_7SPADES_NAME": "黑桃7",
        "JAVANGLE_HOUSE_7SPADES_DESCRIPTION": "获得<style=cIsUtility>移速提升</style>以及<style=cIsUtility>2 个完全随机的增益效果</style>，持续 {0} 秒。\n此外，<style=cIsUtility>保证</style>你的下一发子弹必定为穿透弹。",
        "JAVANGLE_HOUSE_7DIAMONDS_NAME": "方块7",
        "JAVANGLE_HOUSE_7DIAMONDS_DESCRIPTION": "<style=cShrine>获得金钱</style> <style=cSub>（随宝箱花费成长）</style>。",
        "JAVANGLE_HOUSE_7HEARTS_NAME": "红桃7",
        "JAVANGLE_HOUSE_7HEARTS_DESCRIPTION": "<style=cIsHealing>恢复 50% 最大生命值</style>，并根据当前生命值<style=cIsUtility>获得最高 50% 的屏障</style>。",
        "JAVANGLE_HOUSE_JACKPOT_NAME": "大奖！",
        "JAVANGLE_HOUSE_JACKPOT_DESCRIPTION": "随机以双倍效果触发“梅花7”、“方块7”、“红桃7”或“黑桃7”的效果，有 20% 的几率<style=cIsUtility>同时触发所有效果</style>。",
        "JAVANGLE_HOUSE_52_NAME": "散落的52张牌",
        "JAVANGLE_HOUSE_52_DESCRIPTION": "将所有剩余卡牌抛向空中并重新洗回抽牌堆，每张卡牌会自动追踪敌人并<style=cIsDamage>造成不同数值的伤害</style>。",
        "JAVANGLE_HOUSE_SNAKE_NAME": "双幺",
        "JAVANGLE_HOUSE_SNAKE_DESCRIPTION": "<style=cArtifact>重骰</style>牌组。\n<style=cDeath>装填 6 枚毒蛇弹</style>。\n<style=cArtifact>危机</style>，<style=cDeath>毁灭</style>，<style=cArtifact>灾难</style>，<style=cDeath>损失</style>。\n<style=cIsUtility>[不可摧毁]</style>",
        "JAVANGLE_HOUSE_BUST_NAME": "爆牌！",
        "JAVANGLE_HOUSE_BUST_DESCRIPTION": "立即受到相当于你<style=cDeath>最大生命值 {0}% 的自残伤害</style>，并对周围敌人造成相当于你<style=cIsDamage>最大生命值 {1}% 的伤害</style>。",
        "JAVANGLE_HOUSE_SWORDS_NAME": "宝剑牌组",
        "JAVANGLE_HOUSE_SWORDS_DESCRIPTION": "装填一枚穿透弹，并在下一手牌中抽取一张随机进攻型卡牌。",
        "JAVANGLE_HOUSE_COINS_NAME": "星币牌组",
        "JAVANGLE_HOUSE_COINS_DESCRIPTION": "<style=cArtifact>失去你当前金钱的 {0}%</style>，并对周围敌人造成相当于<style=cIsDamage>所失金钱 {1}% 的伤害</style>。",
        "JAVANGLE_HOUSE_TOWER_NAME": "高塔",
        "JAVANGLE_HOUSE_TOWER_DESCRIPTION": "<style=cArtifact>危机</style>，<style=cDeath>毁灭</style>，<style=cArtifact>灾难</style>，<style=cDeath>损失</style>，<style=cArtifact>阻碍</style>，<style=cDeath>动荡</style>。\n<style=cIsUtility>[不可摧毁]</style>",
        "JAVANGLE_HOUSE_JOKER_NAME": "小丑",
        "JAVANGLE_HOUSE_JOKER_DESCRIPTION": "触发另一种随机<style=cArtifact>紫色卡牌效果</style>，有 20% 的几率<style=cArtifact>同时触发所有紫色卡牌效果</style>。\n<style=cSub>（无法触发高塔。）</style>",
        "JAVANGLE_HOUSE_7JACK_NAME": "方块J",
        "JAVANGLE_HOUSE_7JACK_DESCRIPTION": "装填 6 枚标准弹。\n若在地面上：向前滑行。",
        "JAVANGLE_HOUSE_7QUEEN_NAME": "黑桃Q",
        "JAVANGLE_HOUSE_7QUEEN_DESCRIPTION": "暂时<style=cIsUtility>提升 2 项随机属性</style>，但会<style=cArtifact>削弱另外 2 项随机属性</style>。",
        "JAVANGLE_HOUSE_7KING_NAME": "梅花K",
        "JAVANGLE_HOUSE_7KING_DESCRIPTION": "分别装填一枚爆破弹、穿透弹、霰弹、毒蛇弹、空包弹和神秘弹。",
        "JAVANGLE_HOUSE_7ACE_NAME": "黑桃A",
        "JAVANGLE_HOUSE_7ACE_DESCRIPTION": "仅装填 1 发独特的致命弹药，在较长延迟后造成 <style=cIsDamage>{0}% 伤害</style>。",
        "JAVANGLE_HOUSE_WILDCARD_NAME": "百搭牌",
        "JAVANGLE_HOUSE_WILDCARD_DESCRIPTION": "产生不可预测的效果。可能是好事，可能是坏事，可能都不是……或者兼而有之？\n<style=cIsUtility>[不可摧毁]</style>",
        "JAVANGLE_HOUSE_RROULETTE_NAME": "俄罗斯轮盘",
        "JAVANGLE_HOUSE_RROULETTE_DESCRIPTION": "1/6 几率死亡，4/6 几率获得最大“赌注”层数，1/6 几率消灭地图上的所有敌人。<style=cIsUtility>移速提升</style> {0} 秒，并<style=cIsUtility>保证</style>下发子弹为穿透弹。",
        "JAVANGLE_HOUSE_FORTUNE_NAME": "命运之轮",
        "JAVANGLE_HOUSE_FORTUNE_DESCRIPTION": "<style=cShrine>转动命运之轮</style>：<style=cArtifact>产生强力变动</style>并<style=cIsUtility>触发一个随机的正向塔罗牌效果</style>。",
        "JAVANGLE_HOUSE_THREEOFAKIND_NAME": "三条",
        "JAVANGLE_HOUSE_THREEOFAKIND_DESCRIPTION": "抽取并<style=cIsUtility>一次性打出下一整手牌</style>。",
        "JAVANGLE_HOUSE_GCLUBS_NAME": "黄金梅花7",
        "JAVANGLE_HOUSE_GCLUBS_DESCRIPTION": "在轮盘中装填<style=cIsUtility>3 枚随机增益弹药</style>。\n此外，<style=cIsUtility>保证</style>你的下一发子弹必定为爆破弹。",
        "JAVANGLE_HOUSE_GSPADES_NAME": "黄金黑桃7",
        "JAVANGLE_HOUSE_GSPADES_DESCRIPTION": "获得<style=cIsUtility>移速提升</style>，持续 {0} 秒。\n此外，<style=cIsUtility>保证</style>你的下一发子弹必定为穿透弹。",
        "JAVANGLE_HOUSE_GHEARTS_NAME": "黄金红桃7",
        "JAVANGLE_HOUSE_GHEARTS_DESCRIPTION": "<style=cIsHealing>恢复 100% 最大生命值并获得 100% 屏障</style>。",
        "JAVANGLE_HOUSE_GJACK_NAME": "黄金方块J",
        "JAVANGLE_HOUSE_GJACK_DESCRIPTION": "向前滑行并对沿途一切造成 1000% 伤害。",
        "JAVANGLE_HOUSE_CRAZYCARD_NAME": "愚者",
        "JAVANGLE_HOUSE_CRAZYCARD_DESCRIPTION": "抽取 3 张完全随机、彻底不可预测且可能极为怪诞的卡牌。",
        "JAVANGLE_HOUSE_CASHOUT_NAME": "兑现离场！",
        "JAVANGLE_HOUSE_CASHOUT_DESCRIPTION": "1/3 几率<style=cArtifact>失去所有金钱</style>，1/3 几率无事发生，1/3 几率对<style=cIsDamage>全地图敌人造成伤害</style>并<style=cIsUtility>获得一件临时道具</style>。\n<style=cSub>（造成的伤害和道具稀有度随所冒险的金钱量成长）</style>",
        "JAVANGLE_HOUSE_THESUN_NAME": "太阳",
        "JAVANGLE_HOUSE_THESUN_DESCRIPTION": "<style=cIsUtility>复制手牌中的所有其他卡牌</style>并将其抽入下一手牌中。\n<style=cSub>（对“不可摧毁”卡牌无效）</style>。\n<style=cSub>（此效果无法被其他卡牌触发）</style>。",
        "JAVANGLE_HOUSE_THEMOON_NAME": "月亮",
        "JAVANGLE_HOUSE_THEMOON_DESCRIPTION": "<style=cIsUtility>摧毁手牌中的所有其他卡牌</style>，将其从牌组中彻底移除。\n<style=cSub>（对“不可摧毁”卡牌无效）</style>。\n<style=cSub>（此效果无法被其他卡牌触发）</style>。",
        "JAVANGLE_HOUSE_THESTAR_NAME": "星星",
        "JAVANGLE_HOUSE_THESTAR_DESCRIPTION": "<style=cIsUtility>摧毁抽牌堆、手牌和弃牌堆中的所有“太阳”、“月亮”、“星星”和“世界”卡牌</style>，将其从牌组中彻底移除。<style=cSub>（此效果无法被其他卡牌触发）</style>。",
        "JAVANGLE_HOUSE_THEWORLD_NAME": "世界",
        "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION": "<style=cIsUtility>摧毁抽牌堆、手牌和弃牌堆中的所有“太阳”、“月亮”、“星星”和“世界”卡牌</style>，将其从牌组中彻底移除。\n<style=cSub>（此效果无法被其他卡牌触发）</style>。",
        "JAVANGLE_HOUSE_JUDGEMENT_NAME": "审判",
        "JAVANGLE_HOUSE_JUDGEMENT_DESCRIPTION": "<style=cIsUtility>将牌组彻底重置为初始版本</style>，撤销对其进行的所有修改。<style=cSub>（如同你重生或进入新关卡一样）</style>\n<style=cSub>（此效果无法被其他卡牌触发）</style>。\n<style=cIsUtility>[不可摧毁]</style>",
        "JAVANGLE_HOUSE_KINGOFWANDS_NAME": "权杖国王",
        "JAVANGLE_HOUSE_KINGOFWANDS_DESCRIPTION": "<style=cIsUtility>最多消耗“赌注”层数</style>，并根据消耗量<style=cIsHealing>提供治疗</style>。\n<style=cIsHealing>所有受控友军获得该数值一半的治疗</style>。",
        "JAVANGLE_HOUSE_QUEENOFCUPS_NAME": "圣杯王后",
        "JAVANGLE_HOUSE_QUEENOFCUPS_DESCRIPTION": "<style=cIsUtility>最多消耗“赌注”层数</style>，并赋予一项增益，使 House 能够<style=cIsUtility>在射击时不消耗已装填的弹药</style>。\n该增益的持续时间取决于消耗的“赌注”层数。",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_NAME": "宝剑骑士",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_DESCRIPTION": "<style=cIsUtility>最多消耗“赌注”层数</style>，并<style=cIsUtility>装填等同于所消耗层数的增益弹药</style>。\n此外，<style=cIsUtility>保证</style>你的下一发子弹必定为爆破弹。",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_NAME": "星币侍从",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_DESCRIPTION": "<style=cIsUtility>最多消耗“赌注”层数</style>并召唤月球嵌合体（Lunar Chimeras）为你作战，消耗的“赌注”越多，召唤出的力量就越强大。\n消耗满层时，该卡牌将改为召唤一名随机幸存者。",
        "JAVANGLE_HOUSE_ANTEUP_NAME": "加注！",
        "JAVANGLE_HOUSE_ANTEUP_DESCRIPTION": "<style=cIsUtility>获得“赌注”层数</style>。\n每层赌注会降低护甲，但会提升移动速度和攻击速度。",
        "JAVANGLE_HOUSE_ANCIENTACE_NAME": "远古王牌",
        "JAVANGLE_HOUSE_ANCIENTACE_DESCRIPTION": "在轮盘中装填<style=cIsUtility>6 枚神秘弹</style>。\n此外，<style=cIsUtility>赋予以下效果之一</style>：\n<style=cIsUtility>Dueces</style>：打出的每张卡牌生效两次\n<style=cIsUtility>Flush</style>：每次打出卡牌时，打出当前手牌中的其余卡牌（跳过负面和随机卡牌）\n<style=cIsUtility>Cups</style>：发射轮盘不再消耗弹药\n<style=cIsUtility>[不可摧毁]</style>",
        "ARTIFACT_OF_WILDROOM_NAME": "狂野之室神器",
        "ARTIFACT_OF_WILDROOM_DESCRIPTION": "在每个关卡开始时召唤一间 Wildroom。\nWildroom 不再自行移除，且现在会对非 House 玩家生效。",
        "JAVANGLE_HOUSE_NULL_NAME": "虚无",
        "JAVANGLE_HOUSE_NULL_DESCRIPTION": "毫无作用，甚至不会重装弹药。\n你做到了，你摧毁了一切，你将所有事物化为虚无，而现在唯有虚无留存……你满意了吗……？"
    }
}