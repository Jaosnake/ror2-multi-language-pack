    "KENKO_SPY_SECONDARY_KNIFE2_NAME": "Big Earner",
    "KENKO_SPY_SECONDARY_KNIFE2_DESCRIPTION": "<color=#62746f>Оппортунист</color>. Приготовьте <color=#62746f>Нож</color>. Отпустите, чтобы нанести взмах на <style=cIsDamage>500% урона</style>. Убийства <style=cIsHealth>Ударом в спину</style> дают <style=cIsUtility>скорость передвижения</style> и <style=cIsHealing>барьер</style>, а также <style=cIsUtility>сбрасывают перезарядку этой способности</style>.",
    "KENKO_SPY_UTILITY_SAPPER_NAME": "Жучок",
