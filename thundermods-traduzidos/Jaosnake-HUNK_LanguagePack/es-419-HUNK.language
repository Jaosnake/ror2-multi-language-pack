        "ROB_HUNK_BODY_SHOOT_RAILGUN_DESCRIPTION": "Dispara para <style=cIsDamage>20.000% de daño</style>.",
        "ROB_HUNK_BODY_SHOOT_FLAMETHROWER_NAME": "Disparar",
        "ROB_HUNK_BODY_SHOOT_FLAMETHROWER_DESCRIPTION": "Dispara un chorro de llamas para <style=cIsDamage>toneladas de daño</style>. <style=cIsUtility>Incendia.</style>",
        "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Escanear",
        "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Escanea en busca de <style=cIsUtility>estuches de armas no abiertos</style>.",
        "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Gancho",
        "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Dispara un gancho a un <style=cIsUtility>punto distante</style>, luego <style=cIsUtility>jálate hacia él</style>. <style=cIsDamage>Puedes contraatacar después de aterrizar.</style>",
        "ROB_HUNK_KEYWORD_VIRUS": "Virus",
        "ROB_HUNK_JETPACK_NAME": "Jump Pack Experimental",
        "ROB_HUNK_JETPACK_DESC": "Una herramienta hecha por Umbrella que te permite impulsarte en cualquier dirección presionando salto en el aire.",
        "ROB_HUNK_SURVIVALKIT_NAME": "Kit de Supervivencia de Emergencia",
        "ROB_HUNK_SURVIVALKIT_DESC": "Un kit de supervivencia que aumenta tanto tu habilidad para hurgar municiones como la efectividad de tu cuchillo.",
        "ROB_HUNK_TRANSCEIVER_NAME": "Transmisor Desgastado",
        "ROB_HUNK_TRANSCEIVER_DESC": "Llama a un compañero de escuadrón para ayudar en tu operación.",
        "ROB_HUNK_INFROCKET_NAME": "Cajero automático-4",
        "ROB_HUNK_INFROCKET_DESC": "Un lanzacohetes con <style=cIsHealing>municiones infinitas</style>. Recompensa por el logro <color=#FFFF00>Early Supporter</color>.",
        "ROB_HUNK_TYPEWRITER_NAME": "Máquina de Escribir",
        "ROB_HUNK_TYPEWRITER_DESC": "Otorga <style=cIsUtility>2</style> <color=#C80202>estuches de armas de Umbrella</color> adicionales por Etapa.",
        "ROB_HUNK_CRYSTALSKULL_NAME": "Calavera de Cristal",
        "ROB_HUNK_CRYSTALSKULL_DESC": "Un tesoro raro. Puede intercambiarse en cualquier <style=cIsUtility>Caldero</style> para recibir un objeto.",
        "ROB_HUNK_WRISTBAND_NAME": "Pulsera de Identificación",
        "ROB_HUNK_WRISTBAND_DESC": "Una llave electrónica para uso en las instalaciones de <color=#C80202>Umbrella Corporation</color>. Se usa para abrir un <style=cIsUtility>estuche de arma especial</style>.",
        "ROB_HUNK_SPADE_KEYCARD_NAME": "U.C. Keycard (Picas)",
        "ROB_HUNK_CLUB_KEYCARD_NAME": "U.C. Keycard (Tréboles)",
        "ROB_HUNK_HEART_KEYCARD_NAME": "U.C. Keycard (Corazones)",
        "ROB_HUNK_DIAMOND_KEYCARD_NAME": "U.C. Keycard (Diamantes)",
        "ROB_HUNK_GOLD_KEYCARD_NAME": "U.C. Keycard (Estrella)",
        "ROB_HUNK_MASTER_KEYCARD_NAME": "U.C. Keycard (Maestro)",
        "ROB_HUNK_KEYCARD_DESC": "Usado para abrir <color=#C80202>estuches de armas</color> de <style=cIsUtility>Umbrella Corporation</style>.",
        "ROB_HUNK_KEYCARD_MASTER_DESC": "Usado para abrir <color=#C80202>estuches de armas</color> de <style=cIsUtility>Umbrella Corporation</style>. Abre <style=cIsHealing>todos los estuches</style> y transforma otros keycards en <style=cIsUtility>chatarra</style>.",
        "ROB_HUNK_STARSBADGE_NAME": "Distintivo S.T.A.R.S.",
        "ROB_HUNK_STARSBADGE_DESC": "Un distintivo especial de la división de fuerzas especiales de la R.P.D., <color=#F20443>S.T.A.R.S.</color> <style=cIsHealth>¿Quizás tomar esto fue una mala idea?</style>",
        "ROB_HUNK_STARSBADGE_DESCFULL": "Cada Etapa, un estuche especial de <color=#F20443>S.T.A.R.S.</color> aparece que solo puede abrirse usando este distintivo. Sin embargo, el <style=cIsHealth>Nemesis T-Type</style> te cazará implacablemente.",
        "ROB_HUNK_STARSBADGE2_NAME": "Llave USB Dongle",
        "ROB_HUNK_STARSBADGE2_DESC": "Usado para acceder a un <style=cIsUtility>baúl especial</style> en cada Etapa.",
