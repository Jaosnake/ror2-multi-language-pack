        "ROB_GREAT_GARGOYLE_NAME": "Colmillos Azules",
        "KEYWORD_WHIP_SLAM": "<style=cKeywordName>Azotada de Látigo</style><style=cSub>Toca dos veces mientras estás fijado en un enemigo <style=cIsUtility>en el aire</style> para <style=cIsDamage>azotarlo</style> contra el suelo para <style=cIsDamage>1800% de daño</style>.</style>"
