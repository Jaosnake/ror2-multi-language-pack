    "ROB_HENRY_BODY_SOLDIER_SKIN_NAME": "Şampiyon",
    "ROB_HENRY_BODY_ZOMBIE_SKIN_NAME": "Zombi",
    "ROB_HENRY_BODY_SKELETON_SKIN_NAME": "İskelet",
    "ROB_HENRY_BODY_PASSIVE_NAME": "Henry pasifi",
    "ROB_HENRY_BODY_PASSIVE_DESCRIPTION": "Örnek metin.",
    "ROB_HENRY_BODY_PRIMARY_SLASH_NAME": "Kılıç",
    "ROB_HENRY_BODY_PRIMARY_SLASH_DESCRIPTION": "<style=cIsUtility>Çevik.</style> İleri doğru savurarak <style=cIsDamage>%280 hasar</style> ver.",
    "ROB_HENRY_BODY_PRIMARY_PUNCH_NAME": "Boks Eldivenleri",
    "ROB_HENRY_BODY_PRIMARY_PUNCH_DESCRIPTION": "<style=cIsUtility>Çevik.</style> Hızlıca yumruk atarak <style=cIsDamage>%240 hasar</style> ver. <style=cIsUtility>Zırhı yok sayar.</style>",
    "ROB_HENRY_BODY_PRIMARY_GUN_NAME": "Tabanca",
    "ROB_HENRY_BODY_PRIMARY_GUN_DESCRIPTION": "<style=cIsUtility>Çevik.</style> Küçük bir tabanca ateşleyerek <style=cIsDamage>%90 hasar</style> ver.",
    "ROB_HENRY_BODY_SECONDARY_GUN_NAME": "Tabanca",
    "ROB_HENRY_BODY_SECONDARY_GUN_DESCRIPTION": "<style=cIsUtility>Çevik.</style> Bir tabanca ateşleyerek <style=cIsDamage>%420 hasar</style> ver.",
    "ROB_HENRY_BODY_SECONDARY_STINGER_NAME": "Stinger",
    "ROB_HENRY_BODY_SECONDARY_STINGER_DESCRIPTION": "<style=cIsUtility>Çevik.</style> Bir düşmana atılarak <style=cIsDamage>%450 hasar</style> ver.",
    "ROB_HENRY_BODY_SECONDARY_UZI_NAME": "Uzi",
    "ROB_HENRY_BODY_SECONDARY_UZI_DESCRIPTION": "Bir Uzi ateşleyerek <style=cIsDamage>%75 hasar</style> ver.",
    "ROB_HENRY_BODY_UTILITY_ROLL_NAME": "Takla",
    "ROB_HENRY_BODY_UTILITY_ROLL_DESCRIPTION": "Kısa bir mesafe yuvarlanıp <style=cIsUtility>300 zırh</style> kazan. <style=cIsUtility>Takla sırasında vurulamazsın.</style>",
    "ROB_HENRY_BODY_UTILITY_SHOTGUN_NAME": "Pompalı Tüfek",
    "ROB_HENRY_BODY_UTILITY_SHOTGUN_DESCRIPTION": "<style=cIsUtility>Pompalı tüfek</style> ateşleyerek <style=cIsDamage>14x%140 hasar</style> ver ve geri tepmeyle kendini fırlat.",
    "ROB_HENRY_BODY_SPECIAL_BOMB_NAME": "Bomba",
    "ROB_HENRY_BODY_SPECIAL_BOMB_DESCRIPTION": "<style=cIsDamage>%1600 hasar</style> için bir bomba fırlat.",
    "ROB_HENRY_BODY_SPECIAL_SCEPBOMB_NAME": "Daha Fazla Bomba!",
    "ROB_HENRY_BODY_SPECIAL_SCEPBOMB_DESCRIPTION": "<style=cIsDamage>%1600 hasar</style> için bir bomba fırlat.\n<color=#d299ff>SCEPTER: En fazla 4 bomba taşı. Bekleme süresi yarıya iner.</color>",
    "ROB_HENRY_BODY_SPECIAL_BAZOOKA_NAME": "Bazuka",
    "ROB_HENRY_BODY_SPECIAL_BAZOOKA_DESCRIPTION": "Roketleri şarj edip ateşleyerek <style=cIsDamage>%600-%1600 hasar</style> ver.",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKA_NAME": "Ateş Et",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKA_DESCRIPTION": "Bir roket şarj edip ateşleyerek <style=cIsDamage>%600-%1600 hasar</style> ver.",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKAOUT_NAME": "İptal",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKAOUT_DESCRIPTION": "<style=cIsDamage>Bazukanı</style> kaldır.",
    "ROB_HENRY_BODY_SPECIAL_SCEPBAZOOKA_NAME": "Armageddon",
    "ROB_HENRY_BODY_SPECIAL_SCEPBAZOOKA_DESCRIPTION": "Roketleri şarj edip ateşleyerek <style=cIsDamage>%600-%1600 hasar</style> ver.\n<color=#d299ff>SCEPTER: Aynı anda iki Bazuka taşı.</color>",
    "ROB_HENRY_BODY_PRIMARY_SCEPBAZOOKA_NAME": "Ateş Et",
    "ROB_HENRY_BODY_PRIMARY_SCEPBAZOOKA_DESCRIPTION": "Bir roket şarj edip ateşleyerek <style=cIsDamage>%600-%1600 hasar</style> ver.\n<color=#d299ff>SCEPTER: Aynı anda iki Bazuka taşı.</color>",
    "ROB_HENRY_BODY_SPECIAL_FRENZY_NAME": "Hışım",
    "ROB_HENRY_BODY_SPECIAL_FRENZY_DESCRIPTION": "İsabetlerde <style=cIsHealth>Öfke</style> biriktir. Tam dolunca kullanarak <style=cIsUtility>10 saniye</style> boyunca <style=cIsDamage>çılgınlığa</style> gir. <style=cIsHealth>Düşük canda daha hızlı dolar.</style>",
    "ROB_HENRY_BODY_SPECIAL_SCEPFRENZY_NAME": "Super Saiyan",
    "ROB_HENRY_BODY_SPECIAL_SCEPFRENZY_DESCRIPTION": "Yakın mesafedeki birincil isabetlerle veya herhangi bir yakın dövüş saldırısıyla <style=cIsHealth>Öfke</style> biriktir. Tam dolunca kullanarak <style=cIsUtility>10 saniye</style> boyunca <style=cIsDamage>çılgınlığa</style> gir. <style=cIsHealth>Düşük canda daha hızlı dolar.</style>\n<color=#d299ff>SCEPTER: Nitelik bonusları devasa ölçüde artar. Süre uzar.</color>",
    "ACHIEVEMENT_ROB_HENRY_BODY_UNLOCKABLE_ACHIEVEMENT_ID_NAME": "Başlangıç",
    "ACHIEVEMENT_ROB_HENRY_BODY_UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Titanic Plains'e gir.",
    "ACHIEVEMENT_ROB_HENRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Henry: Ustalık",
    "ACHIEVEMENT_ROB_HENRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Henry olarak oyunu bitir veya Monsoon'da kendini yok et.",
    "ACHIEVEMENT_ROB_HENRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Henry: Büyük Ustalık",
    "ACHIEVEMENT_ROB_HENRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Henry olarak oyunu Typhoon veya Eclipse'te bitir ya da kendini yok et.\n<color=#8888>(Typhoon veya üzeri her zorluk sayılır)</color>",
    "ROB_HENRY_BODY_DANTEUNLOCKABLE_ACHIEVEMENT_NAME": "Henry: Büyük İkramiye",
    "ROB_HENRY_BODY_DANTEUNLOCKABLE_ACHIEVEMENT_DESC": "Henry olarak Monsoon'da bir Twisted Scavenger yen.",
    "ROB_HENRY_BODY_DANTEUNLOCKABLE_UNLOCKABLE_NAME": "Henry: Büyük İkramiye",
    "ROB_HENRY_BODY_VERGILUNLOCKABLE_ACHIEVEMENT_NAME": "Henry: %200 Motivasyonlu",
    "ROB_HENRY_BODY_VERGILUNLOCKABLE_ACHIEVEMENT_DESC": "Henry olarak eşyasız şekilde King of Nothing'i yen.",
    "ROB_HENRY_BODY_VERGILUNLOCKABLE_UNLOCKABLE_NAME": "Henry: %200 Motivasyonlu",
    "ROB_MRGREEN_BODY_NAME": "Mr. Green",
    "ROB_MRGREEN_BODY_DESCRIPTION": "Mr. Green<color=#CCD3E0>\n\n< ! > Kılıç her duruma uygundur; Boks Eldivenleri ise daha güçlü düşmanları pataklamak için daha iyidir.\n\n< ! > Tabanca, kısa bekleme süresi ve yüksek hasarıyla güçlü bir hava savunmasıdır.\n\n< ! > Takla, saldırgan oynamaya yardımcı olan kalıcı bir zırh güçlendirmesi bırakır.\n\n< ! > Bomba, kalabalıkları kolayca temizlemek için kullanılabilir.</color>",
    "ROB_MRGREEN_BODY_SUBTITLE": "O",
    "ROB_MRGREEN_BODY_LORE": "örnek hikaye bölüm 2",
    "ROB_MRGREEN_BODY_OUTRO_FLAVOR": "..ve böylece ayrıldı, alt metin.",
    "ROB_MRGREEN_BODY_DEFAULT_SKIN_NAME": "Varsayılan",
    "ROB_MRGREEN_BODY_PASSIVE_NAME": "Mr. Green pasifi",
    "ROB_MRGREEN_BODY_PASSIVE_DESCRIPTION": "Örnek metin.",
    "ROB_MRGREEN_BODY_PRIMARY_PUNCH_NAME": "Dövüş Sanatları",
    "ROB_MRGREEN_BODY_PRIMARY_PUNCH_DESCRIPTION": "<style=cIsDamage>%90 hasar</style> için hızlı bir yumruk ve tekme kombosu yap.",
    "ROB_MRGREEN_BODY_SECONDARY_CLONETHROW_NAME": "Klon Fırlatma",
    "ROB_MRGREEN_BODY_SECONDARY_CLONETHROW_DESCRIPTION": "Bir klon çağırıp ileri fırlat; yakındaki düşmanları yakalayıp yere çarparak <style=cIsDamage>%420 hasar</style> ver.",
    "ROB_MRGREEN_BODY_UTILITY_DASH_NAME": "People's Elbow",
    "ROB_MRGREEN_BODY_UTILITY_DASH_DESCRIPTION": "Kısa bir mesafe atıl. Bir <style=cIsUtility>klon</style> ile temas ettiğinde havaya sıçra ve güçlü bir <style=cIsUtility>dirsek darbesiyle</style> inerek <style=cIsDamage>%800 hasar</style> ver.",
    "ROB_MRGREEN_BODY_SPECIAL_RES_NAME": "Diriliş",
    "ROB_MRGREEN_BODY_SPECIAL_RES_DESCRIPTION": "Düşen tüm klonları dirilt.",
    "ROB_NEMRY_BODY_NAME": "Nemesis Henry",
    "ROB_NEMRY_BODY_DESCRIPTION": "Nemesis Henry, saldırılarını güçlendirmek için enerji depolayan özel bir kılıç kullanan dengesiz bir kılıç ustasıdır. Bekleme süreleri yoktur, ancak enerjisini iyi yönetmelidir.<color=#CCD3E0>\n\n< ! > Kılıç Modu enerji biriktirmek, Silah Modu ise güçlü saldırılar için enerji harcamak üzere kullanılır.\n\n< ! > Swordmaster daha fazla hasar için şarj edilebilir.\n\n< ! > Flash Step, enerji biriktirmeye yardımcı olan güçlü ve saldırgan bir araçtır.\n\n< ! > Sağlıklı kalmak için Hydra Bite, devasa hasar salmak için Hyper Beam kullan.</color>",
    "ROB_NEMRY_BODY_SUBTITLE": "Düşmüş Olan",
    "ROB_NEMRY_BODY_LORE": "örnek hikaye",
    "ROB_NEMRY_BODY_OUTRO_FLAVOR": "..ve böylece ayrıldı, görünür hiçbir sebep yokken ayı havaya uçurmuş olarak.",
    "ROB_NEMRY_BODY_OUTRO_FAILURE": "..o kadar uğraştı ve bu kadar ilerledi. Ama sonunda bunun hiçbir önemi bile yok.",
    "ROB_NEMRY_BODY_DEFAULT_SKIN_NAME": "Nemesis",
    "ROB_NEMRY_BODY_MASTERY_SKIN_NAME": "Tutsak #001",
    "ROB_NEMRY_BODY_TYPHOON_SKIN_NAME": "FLLFFL",
    "ROB_NEMRY_BODY_PASSIVE_NAME": "Asidik Gunblade",
    "ROB_NEMRY_BODY_PASSIVE_DESCRIPTION": "Nemesis Henry, Kılıç Modu ile Silah Modu arasında geçiş yapabilen özel bir silah kullanır. Ayrıca becerilerinin normal bekleme süreleri yoktur; bunun yerine kılıcının <style=cIsHealing>Enerji</style> sistemine dayanır.",
    "ROB_NEMRY_BODY_PRIMARY_SPEAR_NAME": "Şişle",
    "ROB_NEMRY_BODY_PRIMARY_SPEAR_DESCRIPTION": "<style=cIsUtility>Çevik.</style> İleri saplayarak <style=cIsDamage>%160 hasar</style> ver. <style=cIsDamage>Uç kısmıyla iki kat hasar verir ve verilen hasarın <style=cIsHealing>%50</style> kadarıyla iyileştirir</style>.",
    "ROB_WEAPON_SWAP_SKILL": "Silah Değiştir",
    "ROB_NEMRY_BODY_PRIMARY_SWORD_NAME": "Kılıç Modu",
    "ROB_NEMRY_BODY_PRIMARY_SWORD_DESCRIPTION": "Kılıcını ileri savurarak <style=cIsDamage>%280 hasar</style> ver. İsabet halinde <style=cIsHealing>%20 Enerji</style> üret.",
    "ROB_NEMRY_BODY_PRIMARY_GUN_NAME": "Silah Modu",
    "ROB_NEMRY_BODY_PRIMARY_GUN_DESCRIPTION": "<style=cIsHealing>%2,5 Enerji.</style> <style=cIsDamage>%350 hasar</style> veren delici bir <style=cIsHealing>Enerji</style> atışı yap.",
    "ROB_NEMRY_BODY_PRIMARY_SWORDCSS_NAME": "Kılıç Modu / Silah Modu",
    "ROB_NEMRY_BODY_PRIMARY_SWORDCSS_DESCRIPTION": "Kılıcını savurarak <style=cIsDamage>%280 hasar</style> ver. İsabet halinde <style=cIsHealing>%20 Enerji</style> üret.\n<style=cIsHealing>%2,5 Enerji.</style> <style=cIsDamage>%350 hasar</style> veren delici bir <style=cIsHealing>Enerji</style> atışı yap.",
    "ROB_NEMRY_BODY_SECONDARY_BLAST_NAME": "Null Blast",
    "ROB_NEMRY_BODY_SECONDARY_BLAST_DESCRIPTION": "<style=cIsUtility>Çevik.</style> <style=cIsDamage>%450 hasar</style> için bir <style=cIsHealth>gizemli enerji</style> kütlesi fırlat.",
    "ROB_NEMRY_BODY_SECONDARY_CHARGE_NAME": "Swordmaster",
    "ROB_NEMRY_BODY_SECONDARY_CHARGE_DESCRIPTION": "<style=cIsHealing>%10 Enerji.</style> Yakındaki bir düşmana atılarak <style=cIsDamage>%600 hasar</style> ver. Yakın dövüş menzilindeysen bunun yerine kombo saldırı yap.",
    "ROB_NEMRY_BODY_SECONDARY_TORRENT_NAME": "Gunslinger",
    "ROB_NEMRY_BODY_SECONDARY_TORRENT_DESCRIPTION": "<style=cIsHealing>%5 Enerji.</style> Art arda <style=cIsHealing>Enerji</style> atışları yap. Ateş etmeye devam etmek için basılı tut; her atış daha fazla <style=cIsHealing>Enerji</style> tüketir.",
    "ROB_NEMRY_BODY_SECONDARY_CHARGECSS_NAME": "Swordmaster / Gunslinger",
    "ROB_NEMRY_BODY_SECONDARY_CHARGECSS_DESCRIPTION": "<style=cIsHealing>%10 Enerji.</style> Yakındaki bir düşmana atılarak <style=cIsDamage>%600 hasar</style> ver.\n<style=cIsHealing>%5 Enerji.</style> Art arda <style=cIsHealing>Enerji</style> atışları yap.",
    "ROB_NEMRY_BODY_UTILITY_DODGESLASH_NAME": "Hızlı Kesik",
    "ROB_NEMRY_BODY_UTILITY_DODGESLASH_DESCRIPTION": "Geri takla atarak yakındaki düşmanları kes ve <style=cIsDamage>%300 hasar</style> ver. <style=cIsUtility>Takla sırasında vurulamazsın.</style>",
    "ROB_NEMRY_BODY_UTILITY_BLINK_NAME": "Flash Step",
    "ROB_NEMRY_BODY_UTILITY_BLINK_DESCRIPTION": "<style=cIsHealing>%5 Enerji.</style> Yakındaki bir düşmana <style=cIsUtility>anında ışınlan</style>.",
    "ROB_NEMRY_BODY_UTILITY_BURST_NAME": "Enerji Patlaması",
    "ROB_NEMRY_BODY_UTILITY_BURST_DESCRIPTION": "<style=cIsHealing>%10 Enerji.</style> <style=cIsDamage>%400 hasar</style> veren bir <style=cIsHealing>Enerji</style> patlaması boşalt ve <style=cIsUtility>geri tepmeyle kendini fırlat</style>.",
    "ROB_NEMRY_BODY_UTILITY_BLINKCSS_NAME": "Flash Step / Enerji Patlaması",
    "ROB_NEMRY_BODY_UTILITY_BLINKCSS_DESCRIPTION": "<style=cIsHealing>%5 Enerji.</style> Yakındaki bir düşmana <style=cIsUtility>anında ışınlan</style>.\n<style=cIsHealing>%10 Enerji.</style> <style=cIsDamage>%400 hasar</style> veren bir <style=cIsHealing>Enerji</style> patlaması boşalt.",
    "ROB_NEMRY_BODY_SPECIAL_STAB_NAME": "Hydra Bite",
    "ROB_NEMRY_BODY_SPECIAL_STAB_DESCRIPTION": "<style=cIsHealing>%100 Enerji.</style> Kılıcını bir düşmana saplayarak <style=cIsDamage>%2800 hasar</style> ver ve güçlü bir zayıflatma uygula. <style=cIsHealing>Verilen hasarın %50 kadarıyla iyileş.</style>",
    "ROB_NEMRY_BODY_SPECIAL_BEAM_NAME": "Hyper Beam",
    "ROB_NEMRY_BODY_SPECIAL_BEAM_DESCRIPTION": "<style=cIsHealing>%100 Enerji.</style> <style=cIsDamage>10x%420 hasar</style> veren güçlü bir lazer yağmuru şarj et.",
    "ROB_NEMRY_BODY_SPECIAL_STABCSS_NAME": "Hydra Bite / Hyper Beam",
    "ROB_NEMRY_BODY_SPECIAL_STABCSS_DESCRIPTION": "<style=cIsHealing>%100 Enerji.</style> Kılıcını bir düşmana saplayarak <style=cIsDamage>%2800 hasar</style> ver ve güçlü bir zayıflatma uygula. <style=cIsHealing>Verilen hasarın %50 kadarıyla iyileş.</style>\n<style=cIsHealing>%100 Enerji.</style> <style=cIsDamage>çok büyük hasar</style> veren güçlü bir ışın şarj et.",
    "ROB_NEMRY_BODY_UNLOCKABLE_ACHIEVEMENT_NAME": "???",
    "ROB_NEMRY_BODY_UNLOCKABLE_ACHIEVEMENT_DESC": "Henry'nin Kalıntısını yen.",
    "ROB_NEMRY_BODY_UNLOCKABLE_UNLOCKABLE_NAME": "???",
    "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Nemesis Henry: Ustalık",
    "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Nemesis Henry olarak oyunu bitir veya Monsoon'da kendini yok et.",
    "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Nemesis Henry: Ustalık",
    "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "Nemesis Henry: Büyük Ustalık",
    "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "Nemesis Henry olarak oyunu bitir veya Typhoon'da kendini yok et.",
    "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "Nemesis Henry: Büyük Ustalık"
  }
