					rotation = Quaternion.identity,
					scale = 1.5f,
					color = new Color32((byte)96, (byte)20, (byte)87, byte.MaxValue)
				}, true);
				Util.PlaySound("Play_deathProjectile_pulse", ((Component)this).gameObject);
				Util.PlaySound("Play_deathProjectile_pulse", ((Component)this).gameObject);
				purchaseCount++;
				refreshTimer = 2f;
				if (purchaseCount >= maxPurchaseCount)
				{
					((Component)symbolTransform).gameObject.SetActive(false);
					((ShrineBehavior)this).CallRpcSetPingable(false);
				}
			}
		}

