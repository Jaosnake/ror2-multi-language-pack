{
  "en": {
    "ETHA10_GANONDORF_BODY_NAME": "Ganondorf",
    "ETHA10_GANONDORF_BODY_DESCRIPTION": "Ganondorf, the Great King of Evil has arrived! <color=#CCD3E0>\n\n< ! > Lay down a simple punch and send foes flying, or dash through enemies.\n\n< ! > Use kicks to swiftly deal with aerial foes.\n\n< ! > Use Flame Choke to grab multiple enemies in a row, disabling them in the process.\n\n< ! > Wizard's Foot is a great mobility tool, and a way to send enemies flying.\n\n< ! > Warlock Punch to release a devastating explosive punch.\n\n< ! > Build up your Triforce of Power by attacking or killing foes, in turn increasing your armor, attack and the power of your Utility and Special.\n\n</color>",
    "ETHA10_GANONDORF_BODY_SUBTITLE": "The Great King of Evil",
    "ETHA10_GANONDORF_BODY_LORE": "??",
    "ETHA10_GANONDORF_BODY_OUTRO_FLAVOR": "..and so he left, spreading malice in his wake.",
    "ETHA10_GANONDORF_BODY_OUTRO_FAILURE": "..and so he vanished, sealed for eternity...",
    "ETHA10_GANONDORF_BODY_DEFAULT_SKIN_NAME": "Classic",
    "ETHA10_GANONDORF_BODY_MASTERY_SKIN_NAME": "Regal",
    "ETHA10_GANONDORF_BODY_OLD_SKIN_NAME": "Wise",
    "ETHA10_GANONDORF_BODY_BRAWL_SKIN_NAME": "Royal",
    "ETHA10_GANONDORF_BODY_BLAST_SKIN_NAME": "Blast from the past",
    "ETHA10_GANONDORF_BODY_SKIN1_NAME": "Saturated Classic",
    "ETHA10_GANONDORF_BODY_SKIN2_NAME": "Purple",
    "ETHA10_GANONDORF_BODY_SKIN3_NAME": "Green",
    "ETHA10_GANONDORF_BODY_SKIN5_NAME": "Hulking Malice",
    "ETHA10_GANONDORF_BODY_SKIN7_NAME": "Brown",
    "ETHA10_GANONDORF_BODY_PASSIVE_NAME": "Triforce of Power",
    "ETHA10_GANONDORF_BODY_PASSIVE_DESCRIPTION": "Every successful hit and kill will build up stacks that increase Ganondorf's armor and base damage. Stacks decay after 2 seconds of no build up. All stacks will be consumed to power up a successful hit of your Special, increasing the damage up to <style=cIsDamage>1000%</style> at the maximum amount of stacks.",
    "ETHA10_GANONDORF_BODY_PRIMARY_PUNCH_NAME": "Melee",
    "ETHA10_GANONDORF_BODY_PRIMARY_PUNCH_DESCRIPTION": "On the ground, punch forward for <style=cIsDamage>200% damage</style>.\n<style=cIsUtility>Stunning.</style> When sprinting, dash forward, plowing through enemies for <style=cIsDamage>400% damage</style>.\nWhen airborne, kick twice for <style=cIsDamage>90% damage</style> and <style=cIsDamage>250% damage</style>.\nWhen airborne and while looking downwards, thrust your feet downwards bouncing a short distance upwards for <style=cIsDamage>250% damage</style>.",
    "ETHA10_GANONDORF_BODY_PRIMARY_SWORD_NAME": "Cleave",
    "ETHA10_GANONDORF_BODY_PRIMARY_SWORD_DESCRIPTION": "Cleave through hordes for <style=cIsDamage>220%</style> damage.\nAt <style=cIsDamage>40 triforce stacks</style>, manifest and fire a light beam and that passes through enemies for <style=cIsDamage>200%</style> damage.",
    "ETHA10_GANONDORF_BODY_SECONDARY_KICK_NAME": "Wizard's Foot",
    "ETHA10_GANONDORF_BODY_SECONDARY_KICK_DESCRIPTION": "<style=cIsUtility>Heavy.</style> Launch yourself forward pushing light enemies away for <style=cIsDamage>300% damage</style>.",
    "ETHA10_GANONDORF_BODY_SECONDARY_GRAB_NAME": "Flame Choke",
    "ETHA10_GANONDORF_BODY_SECONDARY_GRAB_DESCRIPTION": "Dash forward grabbing enemies in a row and choke slamming them dealing <style=cIsDamage>550% damage</style>.",
    "ETHA10_GANONDORF_BODY_SECONDARY_SWORD_CHARGE_NAME": "Serrated Whirlwind",
    "ETHA10_GANONDORF_BODY_SECONDARY_SWORD_CHARGE_DESCRIPTION": "Hold down to charge your sword for up to 4s, and release to throw your sword forwards, dealing <style=cIsDamage>500%</style> at no charge per tick. At full charge, damage is increased by <style=cIsDamage>5x</style>. Ganondorf can use his melee attacks while his sword is thrown.",
    "ETHA10_GANONDORF_BODY_UTILITY_GRAB_NAME": "Flame Choke",
    "ETHA10_GANONDORF_BODY_UTILITY_GRAB_DESCRIPTION": "Dash forward grabbing enemies in a row and choke slamming them dealing <style=cIsDamage>700% damage</style>. Consumes 30 stacks on a successful hit in exchange for <style=cIsDamage>300% more damage</style>.",
    "ETHA10_GANONDORF_BODY_UTILITY_KICK_NAME": "Wizard's Foot",
    "ETHA10_GANONDORF_BODY_UTILITY_KICK_DESCRIPTION": "<style=cIsUtility>Heavy.</style> Launch yourself forward pushing light enemies away for <style=cIsDamage>700% damage</style>. Consumes 30 stacks on a successful hit in exchange for <style=cIsDamage>300% more damage</style>.",
    "ETHA10_GANONDORF_BODY_UTILITY_AERIAL_GRAB_NAME": "Dark Dive",
    "ETHA10_GANONDORF_BODY_UTILITY_AERIAL_GRAB_DESCRIPTION": "Leap upwards grabbing enemies in your path, blasting them to smitherines, firstly hitting 5 mini-blasts at base for <style=cIsDamage>65% damage</style> and then finally unleashing a blast for <style=cIsDamage>650% damage</style>. The number of mini-blasts scales with attack speed. Holding the button down before the move ends will cause Ganondorf to fastfall. Consumes 30 stacks on a successful hit in exchange for <style=cIsDamage>300% more damage</style>.",
    "ETHA10_GANONDORF_BODY_SECONDARY_AERIAL_GRAB_NAME": "Dark Dive",
    "ETHA10_GANONDORF_BODY_SECONDARY_AERIAL_GRAB_DESCRIPTION": "Leap upwards grabbing enemies in your path, blasting them to smitherines, firstly hitting 5 mini-blasts at base for <style=cIsDamage>45% damage</style> and then finally unleashing a blast for <style=cIsDamage>450% damage</style>. The number of mini-blasts scales with attack speed. Holding the button down before the move ends will cause Ganondorf to fastfall.",
    "ETHA10_GANONDORF_BODY_SPECIAL_PUNCH_NAME": "Warlock Punch",
    "ETHA10_GANONDORF_BODY_SPECIAL_PUNCH_DESCRIPTION": "Charge up a powerful punch, while gaining a short burst of Super Armor, unleashing <style=cIsDamage>1000% damage</style> onto close range foes.\nConsume 50 stacks to power the move up by <style=cIsDamage>333%</style> damage. Consume 100 stacks to power the move up by <style=cIsDamage>1000%</style> damage.",
    "ETHA10_GANONDORF_BODY_INFERNO_KICK_NAME": "Inferno Guillotine",
    "ETHA10_GANONDORF_BODY_INFERNO_KICK_DESCRIPTION": "Pull enemies into their demise, slamming your foot down, dealing <style=cIsDamage>1100% damage</style> in a radius around you.<color=#D2042D> No Super Armor.</color>\nConsume 50 stacks to power the move up by <style=cIsDamage>333%</style> damage. Consume 100 stacks to power the move up by <style=cIsDamage>1000%</style> damage.",
    "ETHA10_GANONDORF_BODY_OBLITERATE_SWORD_NAME": "Obliterate",
    "ETHA10_GANONDORF_BODY_OBLITERATE_SWORD_DESCRIPTION": "Hold your sword high, charging for up to <style=cIsDamage>5s</style> to increase damage and range. Release to throw your sword down, sending explosions down in the direction you are facing. At base, explosions deal <style=cIsDamage>600%</style> damage, and can scale up to a maximum of <style=cIsDamage>5x</style> per explosion.",
    "ETHA10_GANONDORF_BODY_SCEPTERSPECIAL_NAME": "True Warlock Punch",
    "ETHA10_GANONDORF_BODY_SCEPTERSPECIAL_DESCRIPTION": "Charge up a powerful punch unleashing <style=cIsDamage>1000% damage</style> onto close range foes. The Scaling of Warlock Punch is now stronger, maxing out at <style=cIsDamage>2000% damage</style>.",
    "ETHA10_GANONDORF_BODY_SCEPTER_SPECIAL_KICK_NAME": "True Inferno Guillotine",
    "ETHA10_GANONDORF_BODY_SCEPTER_SPECIAL_KICK_DESCRIPTION": "Pull enemies into their demise, slamming your foot down, dealing <style=cIsDamage>1100% damage</style> in a radius around you.<color=#D2042D> No Super Armor.</color> The Scaling of Inferno Guillotine is now stronger, maxing out at <style=cIsDamage>2000% damage</style>.",
    "ETHA10_GANONDORF_BODY_SCEPTER_OBLITERATE_SWORD_NAME": "True Obliteration",
    "ETHA10_GANONDORF_BODY_SCEPTER_OBLITERATE_SWORD_DESCRIPTION": "Hold your sword high, charging for up to <style=cIsDamage>5s</style> to increase damage and range. Release to throw your sword down, sending explosions down in the direction you are facing. At base, explosions deal <style=cIsDamage>600%</style> damage, and can scale up to a maximum of <style=cIsDamage>5x</style> per explosion. The Scaling of Obliterate is now stronger, maxing out at <style=cIsDamage>2000% damage</style>.",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Ganondorf: Mastery",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESCRIPTION": "As Ganondorf, beat the game on Monsoon.",
    "ETHA10_GANONDORF_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Ganondorf: Mastery",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_EIGHTLUNAR_ACHIEVEMENT_NAME": "Ganondorf: Forbidden Methods",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_EIGHTLUNAR_ACHIEVEMENT_DESCRIPTION": "As Ganondorf, collect 8 Lunar Items in a single run.",
    "ETHA10_GANONDORF_BODY_EIGHTLUNAR_UNLOCKABLE_NAME": "Ganondorf: Forbidden Methods",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_TENGRAB_ACHIEVEMENT_NAME": "Ganondorf: Hands-on",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_TENGRAB_ACHIEVEMENT_DESCRIPTION": "As Ganondorf, grab 15 or more enemies in a single grab.",
    "ETHA10_GANONDORF_BODY_TENGRAB_UNLOCKABLE_NAME": "Ganondorf: Hands-on",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_HEAVYDAMAGE_ACHIEVEMENT_NAME": "Ganondorf: Heavy-handed \"Punch\"-ishment",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_HEAVYDAMAGE_ACHIEVEMENT_DESCRIPTION": "As Ganondorf, perform a move that deals over 7,500 damage in a single hit.",
    "ETHA10_GANONDORF_BODY_HEAVYDAMAGE_UNLOCKABLE_NAME": "Ganondorf: Heavy-handed \"Punch\"-ishment",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_ITEMGATHERER_ACHIEVEMENT_NAME": "Ganondorf: Open for Experimentation",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_ITEMGATHERER_ACHIEVEMENT_DESCRIPTION": "As Ganondorf, hold onto one scrap from each item tier.",
    "ETHA10_GANONDORF_BODY_ITEMGATHERER_UNLOCKABLE_NAME": "Ganondorf: Open for Experimentation",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASSACRE_ACHIEVEMENT_NAME": "Ganondorf: Malice Bringer",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASSACRE_ACHIEVEMENT_DESCRIPTION": "As Ganondorf: Kill 50 Lemurians, Wisps, Jellyfishes, Beetles, Mini Mushrums and Imps in a single run.",
    "ETHA10_GANONDORF_BODY_MASSACRE_UNLOCKABLE_NAME": "Ganondorf: Malice Bringer",
    "KRONONCONSPIRATOR_SKIN_GANONSPACE_NAME": "Ganondorf"
  }
}