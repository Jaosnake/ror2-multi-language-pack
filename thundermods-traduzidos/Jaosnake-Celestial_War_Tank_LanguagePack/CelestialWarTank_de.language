    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "SCHMUTZIGES GRÜN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "BLAU",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "SCHMUTZIGES BLAU",
