    "2R4R_INTERACTABLE_VOID_HUSK_CONTEXT": "Briser pour ouvrir",
    "2R4R_INTERACTABLE_WISHBONECARCASS_NAME": "Présage",
    "2R4R_INTERACTABLE_WISHBONECARCASS_CONTEXT": "Briser le Présage",
    "EQUIPMENT_BROKENZAPINATOR_NAME": "Zapinator Orange",
    "EQUIPMENT_BROKENZAPINATOR_PICKUP": "<style=cIsUtility>J'arrive pas à croire qu'on ait laissé ça dans le jeu !</style>",
    "EQUIPMENT_BROKENZAPINATOR_DESCRIPTION": "Tire un projectile.",
    "EQUIPMENT_NINJAGEAR_NAME": "Équipement de Maître Ninja",
    "EQUIPMENT_NINJAGEAR_PICKUP": "Donne une chance d'esquiver les attaques subies. Activez pour foncer et lâcher une bombe fumigène.",
    "EQUIPMENT_NINJAGEAR_DESCRIPTION": "Activez pour <style=cIsUtility>foncer de 25m vers l'avant</style> et obtenir <style=cIsHealing>20% de chance</style> d'<style=cIsHealing>esquiver</style> les attaques subies. Foncer et esquiver lâcheront une <style=cIsDamage>bombe fumigène</style>, <style=cIsUtility>étourdissant les ennemis</style> dans un rayon de 13m pendant <style=cIsUtility>1 seconde</style>.",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_NAME": "Prière Mort-née",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_PICKUP": "Exauce un unique vœu...",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_DESCRIPTION": "Octroie un objet Peu commun de votre choix.",
    "EQUIPMENT_THEMACHINE_NAME": "La Machine",
    "EQUIPMENT_THEMACHINE_PICKUP": "Elle ne fait rien. C'est toute sa beauté !",
    "EQUIPMENT_THEMACHINE_DESCRIPTION": "Elle ne fait rien. C'est toute sa beauté !",
    "EQUIPMENT_TESLAEQUIPMENT_NAME": "Bobine Tesla Remarquablement Stable",
    "EQUIPMENT_TESLAEQUIPMENT_PICKUP": "Électrocute les ennemis proches et restaure les Boucliers à l'élimination.",
    "EQUIPMENT_TESLAEQUIPMENT_DESCRIPTION": "Vous <style=cIsUtility>Électrise</style> pendant <style=cIsUtility>10.0 secondes</style>. Les éliminations sous <style=cIsUtility>Électrisation</style> foudroient <style=cIsDamage>4.0</style> ennemis proches pour <style=cIsDamage>200% de dégâts</style> et <style=cIsHealing>restaurent 15% de vos boucliers</style>. Octroie passivement un <style=cIsHealing>bouclier</style> égal à <style=cIsHealing>20% de votre santé maximale</style>.",
    "EQUIPMENT_TESLAEQUIPMENT_LORE": "<style=cMono>Logiciel de Présentation Tesla v1.14\nAllumage...\n10...</style>\nÉmission du message de bienvenue...\n<style=cMono>9...</style>\nBienvenue à toutes et à tous !\n<style=cMono>8...</style>\nVeuillez prendre place.\n<style=cMono>7...</style>\nAssurez-vous que les personnes derrière vous puissent voir.\n<style=cMono>6...</style>\nLa présentation va bientôt commencer.\n<style=cMono>5...</style>\nVeuillez obéir au personnel pour votre sécurité.\n<style=cMono>4...\nActivation de l'éclairage d'ambiance...\n3...</style>\nPréparez-vous à contempler...\n<style=cMono>2...</style>\nLes merveilleux prodiges...\n<style=cMono>1...</style>\nDe l'électricité !\n<style=cMono>Anomalie électrique détectée...\nLancement de la procédure de redémarrage dans 10.0...</style>",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_NAME": "Tempo de Chir",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_PICKUP": "Devenez un aspect de la vélocité.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_DESCRIPTION": "Augmente la vitesse de déplacement, d'attaque et de recharge des compétences.",
    "BORBO_ELITE_AFFIX_SPEED_MODIFIER": "{0} Consacré",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_NAME": "Croyance Fracturée",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_PICKUP": "Devenez un aspect de la vanité.",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_DESCRIPTION": "Devenez un aspect de la vanité.",
    "BORBO_ELITE_MIRRORED_MODIFIER": "{0} Miroir",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_NAME": "Concession de N’Kuhana",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_PICKUP": "Devenez un aspect de l'éternité.",
    "BORBO_ELITE_AFFIX_LEECH_MODIFIER": "{0} Serpentin",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_NAME": "Regard Abyssal",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_PICKUP": "Devenez un aspect du simulacre",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_DESCRIPTION": "Des stats en plus j'sais pas, mdr",
    "BORBO_ELITE_AFFIX_SIMULATED_MODIFIER": "{0} Simulé",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_NAME": "Refrain de Bava",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_PICKUP": "Devenez un aspect de la force.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_DESCRIPTION": "Toutes les attaques sont explosives. Tire périodiquement un mortier.",
    "BORBO_ELITE_AFFIX_EXPLOSIVE_MODIFIER": "{0} Volatil",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_NAME": "Une Force Endormie",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_PICKUP": "Devenez un aspect du déluge.",
    "BORBO_ELITE_AFFIX_FLOOD_MODIFIER": "{0} Torrentiel",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_NAME": "Regard Tordu",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_PICKUP": "Devenez un aspect de la bourrasque.",
    "BORBO_ELITE_AFFIX_SQUALL_MODIFIER": "{0} Hurlant",
    "ARTIFACT_AWESOMEPOT_NAME": "Artéfact de Volatilité",
    "ARTIFACT_AWESOMEPOT_DESCRIPTION": "Les barils et jarres explosifs sont d'Élite.",
    "ARTIFACT_FREELUNAR_NAME": "Artéfact du Zélote",
    "ARTIFACT_FREELUNAR_DESCRIPTION": "Commencez chaque partie avec un objet lunaire aléatoire. À la fin de chaque étape, un portail bleu apparaît toujours.",
    "ARTIFACT_QUICKSTART_NAME": "Artéfact du Mort-né",
    "ARTIFACT_QUICKSTART_DESCRIPTION": "Commencez votre partie avec un objet Peu commun de votre choix.",
    "ARTIFACT_RISKIERRAINSPIRIT_NAME": "Artéfact de l'Esprit",
    "ARTIFACT_RISKIERRAINSPIRIT_DESCRIPTION": "Les personnages courent et attaquent plus vite à faible santé.",
    "ITEM_BARRIERONOVERHEAL_NAME": "Égide",
    "ITEM_BARRIERONOVERHEAL_PICKUP": "Octroie une barrière à toute interaction. Hors de danger, la barrière cesse de décroître.",
    "ITEM_BARRIERONOVERHEAL_DESC": "Utiliser n'importe quel interactible octroie une <style=cIsHealing>barrière temporaire</style> de <style=cIsHealing>40.0 PV</style> <style=cStack>(+40.0 par cumul)</style> plus <style=cIsHealing>10.0%</style> supplémentaires de <style=cIsHealing>santé maximale</style>. Hors de danger, <style=cIsUtility>la barrière ne décroîtra pas</style>.",
    "ITEM_GOLDONHIT_NAME": "Couronne Engloutie",
    "ITEM_GOLDONHIT_PICKUP": "Pillez des coffres... <style=cIsHealth>au prix de votre santé.</style>",
    "ITEM_GOLDONHIT_DESC": "Permet d'interagir avec les coffres sans pouvoir les payer, ouvrant le coffre <style=cIsUtility>sans dépenser AUCUN argent</style>. Piller des coffres coûte <style=cIsHealth>[ 25% / 50% / 80% ]</style> de votre <style=cIsHealth>santé maximale</style>, selon la taille du coffre. Vous pouvez piller jusqu'à 1 <style=cStack>(+1 par cumul)</style> fois par étape.",
    "ITEM_REGENERATINGSCRAP_NAME": "Ferraille Chimère",
    "ITEM_REGENERATINGSCRAP_PICKUP": "Priorisée lors de l'utilisation avec <style=cIsHealth>N'IMPORTE QUELLE</style> Imprimante 3D. Produit des objets supplémentaires de rareté inférieure.",
    "ITEM_REGENERATINGSCRAP_DESC": "Ne fait rien. Priorisée lors de l'utilisation avec <style=cIsHealth>N'IMPORTE QUELLE</style> Imprimante 3D. Crée <style=cStack>(</style> 10 <style=cStack>/</style> <style=cIsHealing>5</style> <style=cStack>/</style> <style=cIsHealth>2</style> <style=cStack>)</style> objets, <style=cIsUtility>selon la qualité de l'imprimante</style>.",
    "ITEM_GOLDONHURT_NAME": "Pièces en Chocolat",
    "ITEM_GOLDONHURT_PICKUP": "Les ennemis laissent une friandise donnant or et soin. Se recharge avec le temps.",
    "ITEM_GOLDONHURT_DESC": "À l'impact, lâche une pièce en chocolat qui soigne <style=cIsHealing>5.0 PV</style> <style=cStack>(+5.0 par cumul)</style> plus <style=cIsUtility>1 or</style> <style=cStack>(+1 par cumul)</style>. <style=cIsUtility>Évolue avec le temps</style>. <style=cIsUtility>se recharge après 5.0 secondes.</style>",
    "ITEM_CRITDAMAGE_NAME": "Télescope de Combat",
    "ITEM_CRITDAMAGE_PICKUP": "Augmente les chances et les dégâts de « Coup Critique » à l'arrêt.",
    "ITEM_CRITDAMAGE_DESC": "Les <style=cIsDamage>Coups Critiques</style> infligent <style=cIsDamage>100% de dégâts</style> supplémentaires <style=cStack>(+100% par cumul)</style>. Octroie <style=cIsDamage>30% de chance de Coup Critique</style> après être resté immobile pendant <style=cIsUtility>0.2</style> secondes.",
    "ITEM_REPEATHEAL_NAME": "Fleur cadavérique",
    "ITEM_REPEATHEAL_PICKUP": "Votre santé dégénère avec le temps. Octroie barrière et chance à faible santé.",
    "ITEM_REPEATHEAL_DESC": "Pour chaque tranche de 12.5% de santé manquante, gagnez Pourriture. Après avoir accumulé 3 Pourritures, augmente les dégâts de base de 4 <style=cStack>(+2 par cumul)</style>. À 6 Pourritures, octroie 50% de barrière et augmente la Chance de 2 <style=cStack>(+2 par cumul)</style>. <style=cIsHealth>Réduit la régénération de santé de base de -2 PV/s</style> <style=cStack>(-2 par cumul)</style>.",
    "ITEM_HEALINGPOTION_NAME": "Breuvage du Berserker",
    "ITEM_HEALINGPOTION_PICKUP": "À faible santé, octroie une barrière, purge les malus et réinitialise tous les temps de recharge. Utilisable une fois par étape.",
    "ITEM_HEALINGPOTION_DESC": "Subir des dégâts sous <style=cIsHealth>25% de santé</style> <style=cIsUtility>consomme</style> cet objet, octroyant instantanément <style=cIsHealing>35%</style> de la santé maximale en <style=cIsHealing>barrière</style> et <style=cIsUtility>réinitialisant</style> tous les temps de recharge. Chaque fiole vide augmente la vitesse d'attaque de <style=cIsDamage>15%</style>, la vitesse de déplacement de <style=cIsDamage>14%</style> et réduit les temps de recharge de <style=cIsDamage>6%</style>. Se régénère au début de chaque étape.",
    "EQUIPMENT_MULTISHOPCARD_NAME": "Carte de cadre",
    "EQUIPMENT_MULTISHOPCARD_PICKUP": "Pirate un interactible ciblé. Les multiboutiques piratées restent ouvertes.",
    "EQUIPMENT_MULTISHOPCARD_DESC": "Ciblez un interactible pour le <style=cIsUtility>pirater</style>, débloquant son contenu <style=cIsUtility>gratuitement</style>. Si la cible est un terminal de <style=cIsUtility>multiboutique</style>, les autres terminaux <style=cIsUtility>resteront ouverts</style>.",
    "ITEM_AUTOCASTEQUIPMENT_NAME": "Geste du noyé",
    "ITEM_AUTOCASTEQUIPMENT_PICKUP": "Augmente grandement les charges d'équipement... <style=cIsHealth>MAIS augmente grandement son temps de recharge.</style> Les équipements peuvent être activés pendant leur recharge, <style=cIsHealth>avec une chance de se briser.</style>",
    "ITEM_AUTOCASTEQUIPMENT_DESC": "Stocke <style=cIsUtility>4 charges d'équipement supplémentaires</style> <style=cStack>(+2 par cumul)</style>... <style=cIsHealth>MAIS augmente le temps de recharge de l'équipement de +100%</style> <style=cStack>(+50% par cumul)</style>. Utiliser votre équipement sans charge le <style=cIsUtility>sous-lance</style>, permettant de l'utiliser <style=cIsHealth>avec 40.0% de chance de se briser</style>. <style=cIsUtility>Insensible à la chance.</style>",
    "ITEM_BONUSGOLDPACKONKILL_NAME": "Tome de Ghor",
    "ITEM_BONUSGOLDPACKONKILL_PICKUP": "Transmute les élites en or au contact.",
    "ITEM_BONUSGOLDPACKONKILL_DESC": "Inflige +100% de dégâts aux élites Dorés. Toucher n'importe quel ennemi d'Élite le transmute instantanément en élite Doré, déclenchant tous les effets à l'élimination. N'affecte pas les Boss.",
    "ITEM_SEED_NAME": "Graine sangsue",
    "ITEM_FLATHEALTH_NAME": "Viande Fraîche",
    "ITEM_FLATHEALTH_PICKUP": "Octroie des PV fixes. Régénère la santé après avoir tué un ennemi.",
    "ITEM_FLATHEALTH_DESC": "Octroie 25<style=cStack>(+25 par cumul)</style> PV. Augmente la <style=cIsHealing>régénération de santé de base</style> de <style=cIsHealing>+2 PV/s</style> pendant <style=cIsUtility>3s</style> <style=cStack>(+3s par cumul)</style> après avoir tué un ennemi.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_NAME": "Moka Matinal",
    "ITEM_ATTACKSPEEDANDMOVESPEED_PICKUP": "Octroie un gain temporaire de vitesse après le début d'une étape.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_DESC": "Pendant <style=cIsUtility>80</style> secondes après l'entrée dans une étape, augmente la <style=cIsDamage>vitesse d'attaque</style> et de <style=cIsDamage>déplacement</style> de <style=cIsDamage>20%</style> <style=cStack>(+20% par cumul)</style>, et réduit les <style=cIsUtility>temps de recharge des compétences</style> de <style=cIsUtility>-12%</style> <style=cStack>(-12% par cumul)</style>. Activer un interactible prolonge le bonus de <style=cIsUtility>20 secondes</style>.",
    "ITEM_EXTRASTATSONLEVELUP_NAME": "Chapelet",
    "ITEM_EXTRASTATSONLEVELUP_PICKUP": "Priorisé lors de l'utilisation avec des Imprimantes 3D <style=cIsHealing>Peu communes</style>. Augmente définitivement TOUTES les stats après retrait.",
    "ITEM_EXTRASTATSONLEVELUP_DESC": "Priorisé lors de l'utilisation avec des Imprimantes 3D <style=cIsHealing>Peu communes</style>. Après retrait, octroie définitivement une augmentation de 7% du <style=cIsUtility>gain d'expérience</style>, de la <style=cIsHealing>santé</style>, du <style=cIsHealing>bouclier</style>, de la <style=cIsHealing>régénération</style> et des <style=cIsDamage>dégâts</style>.",
    "ITEM_THORNS_NAME": "Fil barbelé",
    "ITEM_THORNS_PICKUP": "Riposte par une rafale de lames sanglantes en subissant des dégâts. Se recharge avec le temps.",
    "ITEM_THORNS_DESC": "Être touché vous fait exploser en une rafale de lames, faisant <style=cIsDamage>saigner</style> jusqu'à <style=cIsDamage>5.0</style> <style=cStack>(+2.0 par cumul)</style> ennemis proches pour <style=cIsDamage>400%</style> de dégâts de base par <style=cIsDamage>charge de lame</style> expulsée. Vous pouvez stocker jusqu'à 2 <style=cStack>(+1 par cumul)</style> charges de lame, se rechargeant toutes en <style=cIsUtility>5.0</style> secondes.",
    "ITEM_INCREASEHEALING_NAME": "Étagère de rajeunissement",
    "ITEM_INCREASEHEALING_PICKUP": "Stocke les soins excédentaires pour plus tard.",
    "ITEM_INCREASEHEALING_DESC": "Soigner au-delà de la santé maximale <style=cIsHealing>stocke l'excédent</style> dans une <style=cIsHealing>réserve de soins</style> à <style=cIsHealing>50%</style> <style=cStack>(+50% par cumul)</style> d'efficacité, jusqu'à <style=cIsHealing>30%</style> <style=cStack>(+0% par cumul)</style> de votre santé maximale. En cas de blessure, soigne <style=cIsHealing>10%</style> de votre <style=cIsHealing>santé par seconde</style>, puisant dans la <style=cIsHealing>réserve de soins</style> jusqu'à épuisement.",
    "ITEM_LASERTURBINE_NAME": "Disque de résonance",
    "ITEM_LASERTURBINE_PICKUP": "Obtenez un Disque de résonance chargé en tuant des ennemis. Tire automatiquement à pleine charge.",
    "ITEM_LASERTURBINE_DESC": "Tuer des ennemis charge le Disque de résonance. Le disque se lance vers une cible pour <style=cIsDamage>300%</style> de dégâts de base <style=cStack>(+300% par cumul)</style>, transperçant tous les ennemis qu'il ne tue pas, puis explose pour <style=cIsDamage>1000%</style> de dégâts de base <style=cStack>(+1000% par cumul)</style>. Il revient ensuite vers le porteur, frappant tous les ennemis sur son passage pour <style=cIsDamage>300%</style> de dégâts de base <style=cStack>(+300% par cumul)</style>.",
    "ITEM_SQUIDTURRET_NAME": "Polype de calamar",
    "ITEM_PARENTEGG_NAME": "Planula",
    "ITEM_PARENTEGG_PICKUP": "LA PUISSANCE INÉGALÉE DU SOLEIL !",
    "ITEM_PARENTEGG_DESC": "Après avoir lancé l'événement du téléporteur, <style=cIsDamage>invoque un soleil au-dessus</style> qui dure <style=cIsDamage>10.0</style> secondes <style=cStack>(+5.0 par cumul)</style>. <style=cIsHealth>Tous les ennemis et alliés brûlent près du soleil</style>.",
    "ITEM_FOCUSEDCONVERGENCE_NAME": "Convergence focalisée",
    "ITEM_FOCUSEDCONVERGENCE_DESC": "Les Zones de Retenue se chargent <style=cIsUtility>100% <style=cStack>(+100% par cumul)</style> plus vite</style>, mais sont <style=cIsHealth>50% plus petites</style> <style=cStack>(-50% par cumul)</style>. Maximum 5.",
    "ITEM_GHOSTONKILL_NAME": "Masque le plus heureux",
    "ITEM_GHOSTONKILL_PICKUP": "Hante les ennemis proches, les marquant pour exécution. Exécuter des ennemis invoque un fantôme.",
    "ITEM_GHOSTONKILL_DESC": "<style=cIsDamage>Hante</style> un ennemi aléatoire hors boss, le marquant pour Exécution sous <style=cIsHealth>25%</style> de santé. L'Exécution <style=cIsDamage>fait apparaître un fantôme</style> de l'ennemi tué avec <style=cIsDamage>1500%</style> de dégâts, durant <style=cIsDamage>6.66s</style> <style=cStack>(+6.66s par cumul)</style> <style=cIsUtility>(le double pour les ennemis Hantés)</style>.",
    "ITEM_MOVESPEEDONKILL_NAME": "Harpon du chasseur",
    "ITEM_MOVESPEEDONKILL_DESC": "Tuer un ennemi augmente la <style=cIsUtility>vitesse de déplacement</style> de <style=cIsUtility>125%</style> pendant <style=cIsUtility>1</style> <style=cStack>(+1 par cumul)</style> seconde(s). Les éliminations consécutives augmentent la durée du bonus jusqu'à 25 secondes.",
    "ITEM_STRENGTHENBURN_PICKUP": "Vos effets d'embrasement infligent le triple de dégâts.",
    "ITEM_STRENGTHENBURN_DESC": "Octroie <style=cIsDamage>15% de chance d'enflammer</style>. Tous les effets d'embrasement infligent <style=cIsDamage>+200%</style> <style=cStack>(+200% par cumul)</style> de dégâts supplémentaires et durent <style=cIsUtility>+200%</style> <style=cStack>(+200% par cumul)</style> plus longtemps.",
    "DIFFICULTYSWANSONG_NAME": "Extinction",
    "DIFFICULTYSWANSONG_DESC": "Uniquement pour les déterminés et les véritables masochistes.\nLa planète est vivante et se tord d'une haine indicible pour ce qu'on lui a fait. Vous, objet de sa fureur, serez déchiré et rendu méconnaissable. <style=cStack>\n\n>Régénération de Santé du Joueur : <style=cArtifact>-40%</style></style> <style=cStack>\n>Échelle de Difficulté : <style=cArtifact>+100%</style><style=cStack>\n>Difficulté Initiale : <style=cArtifact>Très Difficile</style></style>\n>Élites Rares : <style=cArtifact>Étape 4</style>\n>Visuels du Téléporteur : <style=cArtifact>DÉSACTIVÉS</style>\n>Les ennemis gagnent <style=cArtifact>une mise à l'échelle améliorée</style>\n>Les ennemis gagnent <style=cArtifact>des projectiles triplés</style></style>",
    "EXPANSION2R4R_NAME": "Swan Song",
