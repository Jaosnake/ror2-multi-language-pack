        "ACHIEVEMENT_ENFORCER_CHARACTERUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Riot",
        "ACHIEVEMENT_ENFORCER_CHARACTERUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Убийте магматичного хробака, мандрівного бродягу та кам’яного титана за один захід.",
        "ACHIEVEMENT_ENFORCER_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Mastery",
        "ACHIEVEMENT_ENFORCER_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, пройдіть гру або знищіть на Monsoon.",
        "ACHIEVEMENT_ENFORCER_GRANDMASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Grand Mastery",
        "ACHIEVEMENT_ENFORCER_GRANDMASTERYUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, пройдіть гру або знищіть на Typhoon або Eclipse.\n<color=#8888>(Враховує будь-яку складність Typhoon або вище)</color>",
        "ACHIEVEMENT_ENFORCER_DOOMUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Rip and Tear...",
        "ACHIEVEMENT_ENFORCER_DOOMUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, убийте 20 бесів за один захід.",
        "ACHIEVEMENT_ENFORCER_RIFLEUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Rapidfire",
        "ACHIEVEMENT_ENFORCER_RIFLEUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer досягайте +400% швидкості атаки.",
        "ACHIEVEMENT_ENFORCER_STUNGRENADEUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Crowd Control",
        "ACHIEVEMENT_ENFORCER_STUNGRENADEUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, мати 20 ворогів під дією сльозогінного газу одночасно.",
        "ACHIEVEMENT_ENFORCER_ROBITUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: We Have the Technology",
        "ACHIEVEMENT_ENFORCER_ROBITUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, впадіть і поверніться до життя.",
        "ACHIEVEMENT_ENFORCER_NEMESISSKINUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Clearance",
        "ACHIEVEMENT_ENFORCER_NEMESISSKINUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, стабілізуйте клітину в полях порожнечі.",
        "ACHIEVEMENT_ENFORCER_DOOMINTERNALUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: ...Until it is done",
        "ACHIEVEMENT_ENFORCER_DOOMINTERNALUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, убийте 10 володарів імпів за один пробіг.",
        "ACHIEVEMENT_ENFORCER_CLASSICUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Schmoovin'",
        "ACHIEVEMENT_ENFORCER_CLASSICUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "У ролі Enforcer демонструйте свої танцювальні рухи.",
        "ACHIEVEMENT_ENFORCER_DESPERADOUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Rules of Nature",
        "ACHIEVEMENT_ENFORCER_DESPERADOUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, перемогти унікального охоронця Gilded Coast, відштовхнувши його від краю карти.",
        "ACHIEVEMENT_ENFORCER_BUNGUSUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Enforcing Perfection",
        "ACHIEVEMENT_ENFORCER_BUNGUSUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, станьте єдиним цілим з Bungus.",
        "ACHIEVEMENT_ENFORCER_STORMTROOPERUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Long Live the Empire",
        "ACHIEVEMENT_ENFORCER_STORMTROOPERUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, перемогти елітний Solus Control Unit.",
        "ACHIEVEMENT_ENFORCER_FROGUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Through Thick and Thin",
        "ACHIEVEMENT_ENFORCER_FROGUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, знайдіть друга на Місяці.",
        "ACHIEVEMENT_ENFORCER_STEVEUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Blocks",
        "ACHIEVEMENT_ENFORCER_STEVEUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Як Enforcer, блокуйте атаку своїм щитом.",
        "ENFORCER_STEVEUNLOCKABLE_UNLOCKABLE_NAME": "Enforcer: блоки",
        "ENFORCER_PRIMARY_SHOTGUN_NAME_UPGRADE_DESCRIPTION": "<style=cIsUtility>+5%</style> шкоди, <style=cIsUtility>+10%</style> товщини кулі та <style=cIsUtility>+0,1</style> поширення кулі",
        "ENFORCER_PROC_BULLET": "Куля",
        "ENFORCER_PROC_HAMMER": "Молоток",
        "ENFORCER_PROC_BASH": "Баш",
        "ENFORCER_PROC_GRENADE": "Граната",
        "ENFORCER_PROC_DAMAGING_GAS": "Шкідливий газ",
        "ENFORCER_PROC_SKATEBOARD": "Скейтборд",
        "NEMFORCER_NAME": "Nemesis Enforcer",
        "NEMFORCER_DESCRIPTION": "Nemesis Enforcer — це втілення відваги та сили, надприродного роду, до якого ніхто не ставиться легковажно.<color=#CCD3E0>\n\n< ! > Золотий молот може вразити багатьох ворогів одночасно.\n\n< ! > Використовуйте Домінування з висоти, щоб виконувати нищівні дії. удар.\n\n< ! > Обстріл із золотим мініганом є ключовим для знищення могутніх босів.\n\n< ! > Щити для кицьок.\n\n</color>",
        "NEMFORCER_SUBTITLE": "Непідкупна тінь",
        "NEMFORCER_LORE": "\nважкий tf2\n\n",
        "NEMFORCER_OUTRO_FLAVOR": "..і тому він пішов, з новознайденою силою для вшанування.",
        "NEMFORCER_OUTRO_FAILURE": "..і тому він повернувся, непомильний бастіон, справді увічнений.",
        "NEMFORCER_BOSS_NAME": "Ultra Nemesis Enforcer",
        "NEMFORCER_BOSS_SUBTITLE": "Кінець лінії",
        "DEDEDE_NAME": "Король Дедеде",
        "DEDEDE_BOSS_SUBTITLE": "Король Країни Мрій",
        "ENFORCER_EVENT_NEMFORCERBOSS_START": "З порожнечі виходить неприродна сила...",
        "ENFORCER_EVENT_NEMFORCERBOSS_END": "Вплив пустоти зникає...",
        "NEMFORCER_PASSIVE_NAME": "Колос",
        "NEMFORCER_PASSIVE_DESCRIPTION": "Nemesis Enforcer отримує <style=cIsHealing>додаткове відновлення здоров'я</style> на основі його поточного <style=cIsHealth>відсутнього здоров'я</style>, до <style=cIsHealth>2,5% максимального здоров'я</style>.",
        "NEMFORCER_PASSIVE_REWORK_DESCRIPTION": "Nemesis Enforcer відновлює <style=cIsHealing>2%</style> свого <style=cIsHealing>максимального здоров’я</style> протягом 3 с, коли вражає ворогів <style=cIsDamage>атак ближнього бою</style>.",
        "NEMFORCER_PRIMARY_HAMMER_NAME": "Золотий молот",
        "NEMFORCER_PRIMARY_HAMMER_DESCRIPTION": "Змахніть молотом, щоб отримати шкоди <style=cIsDamage>500%</style>.",
        "NEMFORCER_PRIMARY_THROWHAMMER_NAME": "Метання молота",
        "NEMFORCER_PRIMARY_THROWHAMMER_DESCRIPTION": "Киньте молот, щоб отримати пошкодження <style=cIsDamage>620%</style>.",
        "NEMFORCER_PRIMARY_MINIGUN_NAME": "Золотий мініган",
        "NEMFORCER_PRIMARY_MINIGUN_DESCRIPTION": "Збільште швидкість і випустіть град куль, завдаючи <style=cIsDamage>65% шкоди</style> за кулю. <style=cIsUtility>Уповільнює рух під час зйомки.</style>",
        "KEYWORD_SLAM": "<style=cKeywordName>Удар униз</style><style=cSub><style=cIsDamage>Приголомшливий.</style> Жорстоко <style=cIsHealth>збивайтеся вниз</style> своїм молотом, завдаючи <style=cIsDamage>300%-2500% шкоди</style> і додатково <style=cIsDamage>30%</style> від цього удару. <style=cIsUtility>IРадіус удару масштабується зі швидкістю.</style></style>",
        "NEMFORCER_SECONDARY_BASH_NAME": "Домінування",
        "NEMFORCER_SECONDARY_BASH_DESCRIPTION": "<style=cIsUtility>Заряджайтеся</style>, а потім стрибніть вперед і використовуйте <style=cIsDamage>зростаючий аперкот</style> для <style=cIsDamage>450%-2500% шкоди</style>. Використовуйте, поки <style=cIsUtility>паде і дивиться вниз</style>, щоб виконати <style=cIsUtility>Удар вниз</style>.",
        "NEMFORCER_SECONDARY_SLAM_NAME": "Домінування (мініган)",
        "NEMFORCER_SECONDARY_SLAM_DESCRIPTION": "<style=cIsDamage>Приголомшливо.</style> Перебуваючи в стані міні-гармати, різко <style=cIsHealth>вдарте</style> молотком, завдаючи <style=cIsDamage>600% шкоди</style> і <style=cIsDamage>стукаючи back</style> вороги вдарили. <style=cIsUtility>Вибухає снаряди.</style>",
        "NEMFORCER_UTILITY_GAS_NAME": "Граната XM47",
        "NEMFORCER_UTILITY_GAS_DESCRIPTION": "Киньте гранату, яка вибухає в хмару <style=cIsUtility>корозійного газу</style>, яка <style=cIsUtility>сповільнюється</style> і завдає <style=cIsDamage>200% шкоди за секунду</style> і триває <style=cIsDamage>16 секунд</style>.",
        "NEMFORCER_UTILITY_JUMP_NAME": "Супер стрибок Dedede",
        "NEMFORCER_UTILITY_JUMP_DESCRIPTION": "Стрибніть у повітря, потім вдартеся, завдаючи <style=cIsDamage>3200% шкоди</style>. <style=cIsUtility>Зменшує пошкодження поза центром удару.</style>",
        "KEYWORD_GRAPPLE": "<style=cKeywordName>Grappling</style><style=cSub>Aзастосовує <style=cIsDamage>stun</style> і намагається <style=cIsUtility>захопити</style> ворога поблизу.</style>",
        "NEMFORCER_UTILITY_CRASH_NAME": "Теплова катастрофа",
        "NEMFORCER_UTILITY_CRASH_DESCRIPTION": "<style=cIsUtility>Grappling.</style> Стрибніть у повітря, потім вдартеся, завдаючи <style=cIsDamage>2400% шкоди</style>. <style=cIsUtility>Зменшує пошкодження за межами центру удару.</style>",
        "NEMFORCER_SPECIAL_MINIGUNUP_NAME": "Позиція придушення",
        "NEMFORCER_SPECIAL_MINIGUNUP_DESCRIPTION": "Займіть наступальну позицію, <style=cIsDamage>готуйте свою міні-пушку</style>. <style=cIsHealth>Запобігає спринту</style>.",
        "NEMFORCERBODY_DEFAULT_SKIN_NAME": "Немезида",
        "NEMFORCERBODY_ENFORCER_SKIN_NAME": "Енфорсер",
        "NEMFORCERBODY_CLASSIC_SKIN_NAME": "класичний",
        "NEMFORCERBODY_TYPHOON_SKIN_NAME": "Чемпіон",
        "NEMFORCERBODY_DRIP_SKIN_NAME": "Дріпфорсер",
        "NEMFORCERBODY_DEDEDE_SKIN_NAME": "Король Дедеде",
        "NEMFORCERBODY_MINECRAFT_SKIN_NAME": "Minecraft",
        "NEMFORCERBODY_FEM_SKIN_NAME": "Шипований",
        "ACHIEVEMENT_ENFORCER_NEMESIS2UNLOCKABLE_ACHIEVEMENT_ID_NAME": "???",
        "ACHIEVEMENT_ENFORCER_NEMESIS2UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "У ролі Енфорсера під час мусонів або вище стабілізуйте Поля Порожнечі та здолайте Вестидж Енфорсера.",
        "ACHIEVEMENT_NEMFORCER_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Nemesis Enforcer: Mastery",
