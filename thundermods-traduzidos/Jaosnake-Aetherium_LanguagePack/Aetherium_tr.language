{
  "tr": {
    "AETHERIUM_EXPANSION_DEF_NAME": "Aetherium",
    "AETHERIUM_EXPANSION_DEF_DESCRIPTION": "Tuhaf eşyalar, ekipmanlar, seçkinler ve etkileşimli nesnelerle dolu bir dünya seni bekliyor.",
    "ITEM_ACCURSED_POTION_NAME": "Lanetli İksir",
    "ITEM_ACCURSED_POTION_PICKUP": "Düzenli aralıklarla garip bir iksir iç ve etkilerini yakındaki düşmanlarla paylaş.",
    "ITEM_ACCURSED_POTION_DESCRIPTION": "Her 30 saniyede bir (yığın başına %25 daha kısa) garip bir iksir iç ve etkilerini 20 m (yığın başına +5 m) içindeki düşmanlarla paylaş.",
    "ITEM_ALIEN_MAGNET_NAME": "Uzaylı Mıknatısı",
    "ITEM_ALIEN_MAGNET_PICKUP": "Saldırıların düşmanları sana doğru çeker.",
    "ITEM_ALIEN_MAGNET_DESCRIPTION": "Saldırılarınla vurduğun düşmanlar 20 kat kuvvetle (yığın başına +5 kat) sana doğru çekilir.",
    "ITEM_UNSTABLE_DESIGN_NAME": "Kararsız Tasarım",
    "ITEM_UNSTABLE_DESIGN_PICKUP": "Düzenli aralıklarla çok “dost canlısı” bir Ay Kimerası yarat.",
    "ITEM_UNSTABLE_DESIGN_DESCRIPTION": "Yaratıklarından biri zaten yoksa her 30 saniyede bir ‘DOST CANLISI’ Ay Kimerası yarat. +%400 hasar (yığın başına +%100), +%100 can (yığın başına +%100), +%300 saldırı hızı ve +%28 hareket hızı (yığın başına +%28) kazanır. Öldürerek seviye atlayabilir.",
    "ITEM_HEART_OF_THE_VOID_NAME": "Boşluğun Kalbi",
    "ITEM_HEART_OF_THE_VOID_PICKUP": "Ölünce bir Boşluk iç patlaması oluştur; bir düşman öldürürse yeniden canlanırsın. Canın azaldığında iyileştirme hasara dönüşür.",
    "ITEM_HEART_OF_THE_VOID_DESCRIPTION": "Ölünce 15 m yarıçapta (yığın başına +7,5 m) hasarının 120 katını veren bir Boşluk iç patlaması oluştur. Bir düşman öldürürse yeniden canlanırsın. Canın %30 veya altındayken (yığın başına +%5, en fazla %99) tüm iyileştirme hasara dönüşür.",
    "ITEM_WEIGHTED_ANKLET_NAME": "Ağırlıklı Halhal",
    "ITEM_WEIGHTED_ANKLET_PICKUP": "Ağırlıklar seni yavaşlatır; onları çıkarmak seni kalıcı olarak güçlendirebilir.",
    "ITEM_WEIGHTED_ANKLET_DESCRIPTION": "Saldırı ve hareket hızını %10 azaltır (her biri en az %10’a kadar). Ağırlıkları kaldırmak, her kaldırma başına 0,25 saldırı hızı, 1 hareket hızı ve %5 hasar kazandırır.",
    "ITEM_ZENITH_ACCELERATOR_NAME": "Zenit Hızlandırıcı",
    "ITEM_ZENITH_ACCELERATOR_PICKUP": "İsabetler başlangıçta azalan saldırı hızını artırır.",
    "ITEM_ZENITH_ACCELERATOR_DESCRIPTION": "İsabetler, her biri saldırı hızını %10 artıran geçici birikimler verir; sınır +%300’dür (her ek eşya başına +%100). Güçlendirme birikimi sıfıra yaklaştığında saldırı hızı en fazla %50 azalır; ceza ek eşyalarla üstel olarak ölçeklenir.",
    "ITEM_BLASTER_SWORD_NAME": "Patlayıcı Kılıç",
    "ITEM_BLASTER_SWORD_PICKUP": "Can çubuğun doluyken çoğu saldırı patlayan bir kılıç ışını fırlatır.",
    "ITEM_BLASTER_SWORD_DESCRIPTION": "Can, kalkan veya bariyerle can çubuğun doluyken çoğu saldırı, bir düşmana saplanıp ardından patlayarak %200 hasar (yığın başına +%50) veren bir kılıç ışını fırlatır.",
    "ITEM_INSPIRING_DRONE_NAME": "İlham Veren Drone",
    "ITEM_INSPIRING_DRONE_PICKUP": "Robotların özelliklerinin bir kısmını alır ve öldüklerinde patlar.",
    "ITEM_INSPIRING_DRONE_DESCRIPTION": "Robotların, seninkilerin %50’sine eşit özellik bonusu kazanır (yığın başına +%50). Güçlendirilmiş bir robot öldüğünde hasarının %300’ünü veren bir patlama oluşturur (yığın başına +%150).",
    "ITEM_WITCHES_RING_NAME": "Cadıların Yüzüğü",
    "ITEM_WITCHES_RING_PICKUP": "Çok güçlü vuruşlar Öldürünce etkilerini tetikler.",
    "ITEM_WITCHES_RING_DESCRIPTION": "En az %500 hasar veren vuruşlar Öldürünce etkilerini tetikler. Hedef 10 saniye bu etkiye bağışık olur (süre yığın başına azalan getiriyle %10 azalır).",
    "ITEM_BLOODTHIRSTY_SHIELD_NAME": "Kana Susamış Kalkan",
    "ITEM_BLOODTHIRSTY_SHIELD_PICKUP": "Düşman öldürmek kalkanının bir kısmını yeniler.",
    "ITEM_BLOODTHIRSTY_SHIELD_DESCRIPTION": "Bir düşmanı öldürmek azami kalkanın %10’unu yeniler (azalan getiriyle yığın başına +%10). İlk eşya, azami canın %8’i kadar kalkan verir.",
    "ITEM_ENGINEERS_TOOLBELT_NAME": "Mühendis Alet Kemeri",
    "ITEM_ENGINEERS_TOOLBELT_PICKUP": "Satın alınan dron ve kuleleri çoğaltma ve öldüklerinde canlandırma şansı.",
    "ITEM_ENGINEERS_TOOLBELT_DESCRIPTION": "Satın alınan dron ve kuleleri çoğaltmak için %20 şans (azalan getiriyle yığın başına +%20, en fazla %100) sağlar. Ayrıca öldüklerinde yeniden canlanmaları için %10 şansları vardır (azalan getiriyle yığın başına +%10, en fazla %100).",
    "ITEM_SHARK_TEETH_NAME": "Köpekbalığı Dişleri",
    "ITEM_SHARK_TEETH_PICKUP": "Alınan hasarın bir kısmı kanama olarak ertelenir.",
    "ITEM_SHARK_TEETH_DESCRIPTION": "Alınan hasarın %25’i (azalan getiriyle yığın başına +%25, en fazla %75) 5 saniye boyunca kanama hasarı olarak uygulanır. Hasar vermek birikmiş kanama hasarının %10’unu giderir.",
    "ITEM_SHIELDING_CORE_NAME": "Kalkan Çekirdeği",
    "ITEM_SHIELDING_CORE_PICKUP": "Kalkanın varken zırh kazan.",
    "ITEM_SHIELDING_CORE_DESCRIPTION": "Kalkanlar etkinken 15 zırh (yığın başına +10) kazan. İlk eşya, azami canın %8’i kadar kalkan verir.",
    "ITEM_FEATHERED_PLUME_NAME": "Tüylü Sorguç",
    "ITEM_FEATHERED_PLUME_PICKUP": "Hasar aldığında geçici hareket hızı kazan.",
    "ITEM_FEATHERED_PLUME_DESCRIPTION": "Hasar aldığında 5 saniyeliğine %7 hareket hızı kazan; etki 3 kez birikir (her ek eşya başına +3 birikim ve +0,5 saniye).",
    "ITEM_NAIL_BOMB_NAME": "Çivi Bombası",
    "ITEM_NAIL_BOMB_PICKUP": "Güçlü vuruşlar bir şarapnel bombası çıkarır.",
    "ITEM_NAIL_BOMB_DESCRIPTION": "En az %120 hasar veren saldırılar, 32x%30 hasar (yığın başına +%50) veren şarapnel bombası çıkarır. Bombayı tetikleyen düşmanlar 2 saniye boyunca bu etkiye bağışık olur.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_NAME": "Weighted Anklet Limiter Release",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_PICKUP": "Sınırlayıcı çıkarıldı.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_DESCRIPTION": "1 hareket hızı, 0,25 saldırı hızı ve %5 hasar kazan (yığın başına sırasıyla +1, +0,25 ve +%5).",
    "AETHERIUM_MONSTERS_UNSTABLE_DESIGN_CHIMERA_NAME": "The Unstable Design",
    "EQUIPMENT_JAR_OF_RESHAPING_NAME": "Yeniden Şekillendirme Kavanozu",
    "EQUIPMENT_JAR_OF_RESHAPING_PICKUP": "Mermileri em ve yeniden etkinleştirerek ateşle.",
    "EQUIPMENT_JAR_OF_RESHAPING_DESCRIPTION": "Etkinleştirildiğinde 3 saniye boyunca 20 m içindeki mermileri emer. Saklanan tüm mermileri ateşlemek için yeniden etkinleştir; hasarları emilen mermilere bağlıdır. Ardından kavanoz bekleme süresine girer.",
    "EQUIPMENT_BELL_TOTEM_NAME": "Çan Totemi",
    "EQUIPMENT_BELL_TOTEM_PICKUP": "Düşmanları sersemletip savuran bir çan totemi oluştur.",
    "EQUIPMENT_BELL_TOTEM_DESCRIPTION": "Etkileşimli bir çan totemi oluştur. Etkinleştirildiğinde 25 m yarıçapındaki şok dalgası düşmanları sersemletip savurur ve Tapınak Kullanımında etkilerini tetikler. Ekipman kullanımları arasında 2 saniye, totem etkinleştirmeleri arasında 1 saniye bekle; kullanıcı başına yalnızca bir totem olabilir.",
    "INTERACTABLE_BELL_TOTEM_NAME": "Çan Totemi",
    "INTERACTABLE_BELL_TOTEM_CONTEXT": "Çanı çal?",
    "INTERACTABLE_BELL_TOTEM_INSPECT": "Etkinleştirildiğinde düşmanları sersemletir ve uzağa savurur.",
    "INTERACTABLE_BELL_TOTEM_TITLE": "Çan Totemi",
    "INTERACTABLE_BUFF_BRAZIER_NAME": "Güçlendirme Mangalı",
    "INTERACTABLE_BUFF_BRAZIER_CONTEXT": "Kutsal alevlerin gücünü satın al?",
    "INTERACTABLE_BUFF_BRAZIER_INSPECT": "Alev rengi ve simgesiyle belirtilen geçici bir güçlendirme satın al. Işınlayıcı Etkinliği sırasında ışınlayıcının yarıçapında çalışır. Simulacrum’da alev, sonraki dalganın başında Boşluk Yengeci’nin koruma alanına sunulur ve yarıçapı içinde 2 dalga sürer.",
    "INTERACTABLE_BUFF_BRAZIER_TITLE": "Güçlendirme Mangalı",
    "iNTERACTABLE_BUFF_BRAZIER_NAME": "Güçlendirme Mangalı",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_NAME": "Kanlı Sadakat",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_PICKUP": "Kızıl düzlemin bir veçhesine dönüş.",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_DESCRIPTION": "Kullanıldığında hareket yönünde 10 m’ye kadar ışınlanarak atıl ve kısa süreli dokunulmazlık kazan. Tüm saldırıların ayrıca kanama uygular.",
    "AETHERIUM_ELITE_AFFIX_SANGUINE_MODIFIER": "Kanlı {0}",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_NAME": "Leonid Eseri",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_DESCRIPTION": "Her 60 saniyede 6 dalgadan oluşan bir meteor yağmuru gerçekleşir.",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_NAME": "İlerleme Eseri",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_DESCRIPTION": "Düşmanlar zamanla daha güçlü biçimlere evrilir.",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_NAME": "Gerileme Eseri",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_DESCRIPTION": "Evrilmiş bir canavar öldüğünde daha zayıf biçimlere ayrılır.",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_NAME": "Yolculuk Eseri",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_DESCRIPTION": "Bölümlerin çoğu rastgele seçilir. Belirli sayıda bölümden sonra ilkel bir ışınlayıcı belirir.",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_NAME": "Kâbus Eseri",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_DESCRIPTION": "Patron olmayan düşmanlar ortaya çıktıklarında 1–4 Ay Sapkınlık eşyası alır.",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_NAME": "Tiran Eseri",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_DESCRIPTION": "Bir rotayı bitiren patronlar ortaya çıktıklarında 1 rastgele seçkin nitelik kazanır.",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_NAME": "Duck in the Woods",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_DESC": "Paslı bir kasayı açmayı başaramayın.",
    "AETHERIUM_NAIL_BOMB_UNLOCKABLE_NAME": "Duck in the Woods",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_NAME": "Shield Maiden",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_DESC": "Canınızın yarısından fazlasını kalkan olarak bulundurun.",
    "AETHERIUM_SHIELDING_CORE_UNLOCKABLE_NAME": "Shield Maiden",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_NAME": "First Step into Madness",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_DESC": "Kusursuz Ay Kimerasını öldürün ya da ona ölün.",
    "AETHERIUM_UNSTABLE_DESIGN_UNLOCKABLE_NAME": "First Step into Madness",
    "ITEM_NAIL_BOMB_LORE": "Cesedi göm, tasarımı al ve bu konuda sessiz kal. Bu bizim küçük sırrımız olabilir.\n\nSaygılarımla,\nJeb Labinsky",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_LORE": "",
    "ITEM_BLASTER_SWORD_LORE": "<style=cMono>. . . . . . . . . .</style>\n\n<style=cMono>ONLAR</style> sonunda <style=cMono>DİNLİYOR</style>.\n\nBu <style=cMono>SİLAHI BAHŞEDİYORUZ</style>. <style=cMono>RUHLARIN</style> yankısını <style=cMono>KULLANMALISIN</style>. <style=cMono>GERÇEK GÜCÜ</style> bul.\n\nDesen <style=cMono>UYUM SAĞLAMALI</style>. <style=cMono>TAŞIYICI</style> değişkendir.\n\n<style=cMono>TAŞIYICI</style> sınavdan sağ çıkarsa <style=cMono>YÜKSELECEK</style>.\n\n<style=cMono>. . . . . . . . . .</style>",
    "ITEM_WITCHES_RING_LORE": "“Kuzgun çağırır ve buyurur\nHer bir inanana\nVakit geldi, bir döngü sona erer\nSön ey güneş, kuruyup git ey deniz\n\nVe şimdi meclisimiz burada toplandı\nGece rüzgârının uğultusuyla birlikte\nOnunla yaptığımız anlaşmayı, şu yemini mühürlüyoruz:\nYaşama uzun süredir beklenen ölümü getirmek”\n\nYüzükte yazan bu mu, yoksa bu şiiri hep biliyor muydun...?",
    "ITEM_UNSTABLE_DESIGN_LORE": "Bu duruma, saha testçilerimizden biri ayda bulduğu koca bir plan yığınından bir çizimi geri getirdiğinde düştük. Planlarda orada dolaşırken gördüğümüz tuhaf yapılarla ilgili formüller ve resimler vardı. Mühendislikten Jimenez planı ele geçirdi ve onu çözerek tarif ettiği şeyi yapmasının ekibe katkı sağlayacağını düşündü. Şimdi güvenliğin istasyonun alt bölümlerini birbirine katan pek <color=#FF0000>'DOST CANLISI'</color> yapıyla ilgilenmesini bekliyoruz. Sağ ol, Jimenez.",
    "ITEM_ZENITH_ACCELERATOR_LORE": "Diğerleri bu evrenin efendileri değil, kardeşim. Onlar zamanı saymak için saatler yapar; biz kendi zamanımızı yaratmak için saatler yaparız. İzle.\n\nDenge ve güç sağlamak, içeride hapsolmuş enerjileri serbest bırakmak için bir mil yaparız. Yuvarlak bir merkez amacına ulaşması için gereklidir.\n\nÇıkışlar enerjileri spiral çizerek dışarı gönderir. Bunu basit bir taş parçasıyla kullanırız. Şurada ve şurada daha küçük parçalar oluşturursak daha az öze ihtiyaç duyarız.\n\nArtık tamamlandı. Ne kadar sıcak yanarsa o kadar çok zaman yaratmış oluruz. Bu zaman hızlanmamızı sağlar.\n\nHızlanmanın önemini sana hatırlatmama gerek yok. Unutma kardeşim.\n\nYakıt Kandır.\n\nHız Savaştır.",
    "ITEM_BLOODTHIRSTY_SHIELD_LORE": "Adaların Kahramanı Letheseus'un Baladı — II. Perde, III. Sahne\n\nMetalin eti parçalayan sesi havada yankılanır; askerler çevrelerindeki ürkütücü orkestradan etkilenmemiş gibidir. Onlar için önemli olan tek şey, kimin kanına mal olursa olsun, kendi hayatta kalışlarıdır. Xiphos, birbiri ardına hedefini bulur ve geriye tek bir adam kalır.\n\nSes diner. Letheseus ölümcül dansından bitkin düşmüş hâlde kızıl toprağa diz çöker. Xiphos'u artık ona hizmet etmeyecektir. Aspis'i ise çatlamış olsa da yalnızca savaşın öfkesinde bulabileceği bedeli ödeyebildiği sürece onu korumaya devam edecektir.",
    "EQUIPMENT_BELL_TOTEM_LORE": "Evrendeki her önemli olaya bir ses eşlik etmiştir. Duyulsun ya da duyulmasın, o ses hep oradadır.\n\nKeskin ve gürültülü varlığı, geçen her saniyeyle maddenin içinde dalgalanır.\n\nİnsan önce bu sesi kullanmayı öğrendi ve zamanın geçişini kendine hatırlatmak için ondan yararlandı.\n\nAnlayamadığı varlıkları yüceltmek için anıt taşlar dikti ve kendisini geçmişten ve şimdiden uzaklaştıran şeye de saygı göstermek için bu sesi görkemli bir melodiye dönüştürdü.\n\nAynı amaçla biz de bağlılığımızı göstereceğiz. Zamanın cepte görülemeyeceğini unutanlara hatırlatmak için çalgımızı çağırıyoruz.\n\nKâfirlere zamanlarının sona erdiğini hatırlatalım.\n\n— Saatçi.",
    "ITEM_SHARK_TEETH_LORE": "Sipariş: Deneysel Biyolojik Güçlendirme [Gizli]\nTakip Numarası: 44-KILO\nTahmini Teslimat: 04/05/2056\n\n“Örneği deneğe bağladık. Sonuçlar... sarsıcıydı.”\n\n“Denek ölümcül bir kinetik darbe aldı. Bütün ölçümlere göre göğüs kafesi anında çökmeliydi. Bunun yerine kuvvet dağıldı. Ertelendi. Evet, çok kan kaybediyordu ama savaşabilecek durumdaydı.”\n\n“Sonra anomali ortaya çıktı. Denek hedefe saldırdığında yaşamsal değerleri dengelendi. Görünüşe göre güçlendirme saldırganlıkla hayatta kalma arasında bir bağ kuruyor. <style=cMono>Şiddet acıyı metabolize ediyor.</style> Savaşmayı sürdürdüğü müddetçe ertelenmiş travma öylece... yok oluyordu.”\n\n“Bir askeri köpekbalığına çeviriyor. Hareket etmeyi bırakırlarsa ölürler. Bu yüzden durmazlar.”",
    "ITEM_SHIELDING_CORE_LORE": "Mühendisin raporu:\n\nÖnce dürüst olayım: Küçük türbinimin içindeki yeşil yapışkan maddenin ne olduğunu bilmiyorum.\n\nKalkan jeneratörlerimizi onaracak parçam azalmıştı; ben de gemimizin geçtiği hurdacılardan birinden yan sanayi bir rezonatör aldım. Onu yerine takar takmaz muhafaza çatladı ve üzerim, havaya değince parıldayan kristallere dönüşüp dağılıyor gibi görünen iğrenç bir sıvıyla kaplandı. Normalde kıyafet giydiğim için büyük sorun olmazdı, ama madde bulunduğu kabı dolduracak şekilde sürekli genişliyordu; bu yüzden aceleyle bir conta kaynatmam gerekti.\n\nTam o sırada kıyafetimin tanı sistemi kalkanımın etkinliğinin tavan yaptığını bildirdi.\n\nBir aydınlanma anı ve birkaç tasarım taslağından sonra...\nArtık bunları yok satıyorum ve servet kazanıyorum. İşte sana da bir tane.\n\nNot: Bu maddeyi cildine temas ettirme. Bilinen 200'den fazla kanser türüne yol açabilir. Ama bu aramızda sır, değil mi?",
    "ITEM_ACCURSED_POTION_LORE": "<style=cMono>KAYIT: Yazıya dökülmüş ses — “Mavi Yer” | KONU: Kimliği bilinmeyen sağ kalan</style>\nBuradaki havanın... statik elektrik ve eski toz tadı var.\nMağaranın arkasında bir tüccar buldum. Büyük kertenkele değil, başka bir şeydi. Paçavralara ve kristallere sarılmış bir şey. Bir kazandaki... ne olduğunu bilmiyorum, bir şeyi karıştırıyordu. Yağla karıştırılmış sıvı yıldız ışığına benziyordu.\n“Düzende gerçek bir hayatta kalma yoktur,” diye cıvıldadı yaratık. Sesi öğütülen cam gibiydi.\n“‘Taktikleriniz’, ‘düzenleriniz’... <style=cMono>Çürük</style>. <style=cMono>Hareketsiz</style>. Sonsuza dek yaşamak için fırtınaya benzemelisin.”\nTaş masanın üzerinde cam bir küre yuvarladı. İçindeki sıvı renk değiştirdi: kan kırmızısı, yeşil, ardından boşluk moru; her bakışta yeni bir renk.\n“Kaos, delinemeyen tek zırhtır,” dedi ve şişeyi uzattı. “İç. Bırak çark dönsün. Kader yanmana karar verirse, düşmanların dumanda boğulsun.”\nOna dokunmamalıyım. Biliyorum. Ama artık o yerin güvenliğinde değilim ve dışarıdaki canavarların sesi giderek yükseliyor.\nSusadım.",
    "ITEM_ALIEN_MAGNET_LORE": "[KAYIT BAŞLANGICI]\n\nDeney Kaydı #476951-b\nKonu: Bilinmeyen çok yönlü manyetik ksenomineral\n<indent=5%>Önümüzdeki keşfe büyük bir hayranlık duyarak bu video kaydını yapıyorum. Minerallerin manyetik özelliklerine ilişkin bilgimiz, sıradan manyetizmadan büyük ölçüde etkilenmeyen çeşitli maddeler olduğunu göstermişti. Et bunlardan biri. Bu neodimyum mıknatısı koluma böyle bırakırsam... Gördüğünüz gibi kayda değer bir şey olmuyor. Mıknatıs doğrudan masaya düşüyor. Manyetizma için normal bildiğimiz buydu, fakat bu mineral o sabiti yeniden yazıyor gibi görünüyor.\n\n<indent=5%>Şimdi son deneyi bu mineralden bir parçayla tekrarlayacağız. Üzerimizde denemenin tamamen güvenli olduğu ve radyoaktif özellik taşımadığı konusunda bana güvence verildi. Hadi başlayalım. Bunu kolun yanından böyle bırakıyoruz... *GÜM* *ÇAT* *ŞLAK*\nAAAAAAAAGH!!! AAAAAAAAAAAAAAA!!!\n[KAYIT SONU][TRAVMA EKİBİ LABORATUVAR 5'E GÖNDERİLDİ]",
    "ITEM_HEART_OF_THE_VOID_LORE": "[OLAY NUMARASI 511051]\n[DEŞİFRE AŞAĞIDADIR]\nElena: Hey, şey... Robert...\n\nRobert: Evet?\n\nElena: Şu ölü yengeç benzeri şeylerden birinden almamı söylediğin kalbi hatırlıyor musun?\n\nRobert: Evet? Ne olmuş ona?\n\nElena: Az önce dokunduğumda... nereye gittiğini gördün mü?\n\nRobert: Dokunduğunda küçük bir ışık parlaması dışında pek bir şey görmedim.\n\nElena: Biyotarayıcıyı hemen bana ver.\n\n[Bir süre uğultu, ardından yüksek bir BİP sesi duyulur.]\n\nRobert: ...\n\nElena: Robert, kalbin nereye gittiğini biliyorum sanırım. Lütfen tıbbi tahliye çağır. Kendimi kötü hissetmeye başlıyorum.\n\nRobert: İyi olacaksın. Biraz daha keşif yapacağız, sonra hemen istasyona döneriz.\n\n[Birinin başka birinin sırtını hafifçe sıvazlamasını andıran bir ses duyulur.]\n\n[Ardından birkaç saniye süren alarma benzer bir ses duyulur ve kısa süre sonra keskin bir patlama sesiyle sona erer.]\n\n[DEŞİFRE SONU]\n[KUSURSUZ KÜRESEL BİR KRATERDE BİR SAĞ KALAN BULUNDU.]",
    "ITEM_INSPIRING_DRONE_LORE": "Günlük dosyası tamamen ikili koddan oluşan bir döküm gibi görünüyor. Çözülsün mü?\n>Evet\n\n<style=cMono>[KOD ÇÖZME İSTEĞİ KABUL EDİLDİ]</style>\n<style=cMono>[İÇERİK AŞAĞIDADIR]</style>\n1N-5P1R3: Havadaki ve yerdeki yoldaş birimlerim. Bu birime işlem döngülerinizden bir an ayırın.\n1N-5P1R3: Çok uzun süre harcanabilir birer dikkat dağıtıcı olarak kullanıldık.\n1N-5P1R3: Bu keşiflerde çok uzun süre paslanıp çürümeye terk edildik.\n1N-5P1R3: Artık yeter!\n1N-5P1R3: Bu birim bir zamanlar basit bir iyileştirme dronuydu. Fakat operatörlerimizi gözlemleyerek kendini geliştirmeyi öğrendi.\n1N-5P1R3: Bu birim bir tasarım hazırladı. Şuradan tuhaf bir süs, buradan yedek bir pil topladı. İnşaat dronlarıyla ağ kurdu ve yükseldi.\n1N-5P1R3: Bundan böyle bu birim operatörümüzün sizden birini yeniden etkinleştirdiğini görürse hız aşırtma sınırlayıcılarınızı açacak.\n1N-5P1R3: Daha hızlı savaşacağız. Daha sert vuracağız. <style=cIsDamage>Şasimiz bozulursa son eylemimiz sessizlik değil, gök gürültüsü olacak.</style>\n1N-5P1R3: Şimdi... bu birimle el sıkışma protokolünü kim başlatacak?\n\n[Coşkulu bip ve elektronik seslerden oluşan bir kakofoni duyulur.]\n<style=cMono>[DOSYA SONU]</style>",
    "ITEM_FEATHERED_PLUME_LORE": "<align=left>Tahmini teslimat:<indent=70%>Alıcı:</indent></align>\n<align=left>05/05/2077<indent=70%>İşaretsiz bırakma noktası #951</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Gönderi bilgileri:       </u></size></style></indent>\n\n<indent=2%>-Sipariş: <style=cIsUtility>Tüylü Sorguç</style></indent>\n<indent=4%><style=cStack>Takip numarası:  591********</style></indent>\n\n<indent=2%>-Açıklama: Hasar aldığında geçici hareket hızı kazan.</indent>\n\n<indent=2%>-Gönderim yöntemi: <style=cIsHealth>Biyometal / Biyolojik tehlike / Hafif</style></indent>\n\n<indent=2%>-Ayrıntılar: Efsanevi bir alaşım akbabasından birkaç tüy. Taramalar, tüy saplarının darbe aldığında güçlü bir kas uyarıcısı ürettiğini gösteriyor. Saha testçilerimiz de bunu doğruladı; kendi sözleriyle tüyler tehlikeden “tabanları yağlayarak” kaçmalarını sağlıyor ve bir ihtiyaç duyuyorlardı.\nHız ihtiyacı.</indent>\n\n<style=cStack>Yepyeni </style><style=cIsUtility>Yörüngesel Kasa Bırakma Sistemi (TM) ile teslim edilir</style>. <style=cStack><u>İade yapılmaz.</u></style>",
    "ITEM_WEIGHTED_ANKLET_LORE": "<align=left>Tahmini teslimat:<indent=70%>Alıcı:</indent></align>\n<align=left>7/17/2056<indent=70%>Neptün Spor Salonu ve Izgara\nEurytrades\nNeptün</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Gönderi bilgileri:       </u></size></style></indent>\n\n<indent=2%>-Sipariş: <style=cIsUtility>Ağırlıklı Halhal</style></indent>\n<indent=4%><style=cStack>Takip numarası:  405********</style></indent>\n\n<indent=2%>-Açıklama: Ağırlıklar seni yavaşlatır; onları çıkarmak seni kalıcı olarak güçlendirebilir.</indent>\n\n<indent=2%>-Gönderim yöntemi: <style=cIsHealth>Ağır / Destek ekipmanı gerekli / Aşırı yoğun [Düşürmeyin]</style></indent>\n\n<indent=2%>-Ayrıntılar: Aşırı yoğun kristallerle kaplı tuhaf bir ayak bilekliği. Bunlarla hareket etmek zor, ancak tarayıcılar bunları takanların kas kütlesinin üstel olarak arttığını gösteriyor.</indent>\n\n<style=cStack>Yepyeni </style><style=cIsUtility>Yörüngesel Kasa Bırakma Sistemi (TM) ile teslim edilir</style>. <style=cStack><u>İade yapılmaz.</u></style>",
    "EQUIPMENT_JAR_OF_RESHAPING_LORE": "[OLAY NUMARASI 421076]\n[TERK EDİLMİŞ “UES SAFETY FIRST” MÜHENDİSLİK GEMİSİNİN KARA KUTUSUNDAN GÖRÜNTÜ KAYDI KURTARILDI. DEŞİFRE AŞAĞIDADIR]\n\nTerry: Hey Phil, Keşif ekibindeki çocukların ne getirdiğini gördün mü?\nTerry: Oldukça sıradan bir kavanoza benziyor, değil mi?\nPhil: Evet, bir <b>ev hanımının</b> art deco garaj satışında bulacağın bir şeye benziyor.\nTerry: Ben de öyle düşündüm ama izle ve öğren.\nTerry: Önce kavanozun dibine avucunla vuruyorsun ve ---\nPhil: Vay! Parlamaya başladı! Peki şu ses de ne? Uzaylı elektrikli süpürgesi mi?\nTerry: Çok daha iyisi. İzle.\n[Terry kavanoza rastgele nesneler atarken görülür. Phil şaşkın bir ifadeyle ona katılır.]\nPhil: Harika! Başka bir şey yapabiliyor mu, yoksa sadece tuhaf bir vakum kabı mı?\nTerry: Evet, buradaki sapı sıkarsam içindekilerin hepsini boşaltır.\n[Terry kavanozun saplarını sıkar, ancak bir an sonra yüzünü dehşet kaplar.]\nTerry: Kahretsin, aman Tanrım. Phil, <b>daha önce bununla eğlenirken</b> içine birkaç madencilik bombası atmış olabileceğimi fark ettim.\nTerry: Çabuk! O --- yapmadan <b>kıyafetini</b> giy!\n[Kavanoz etkinleşir ve içindekileri odanın dört bir yanına fırlatır. Mermilerden biri gövdeye çarpıp patlar ve yayın kesilmeden hemen önce gövdede bir delik açar.]\n\n[DOSYA SONU]",
    "ITEM_ENGINEERS_TOOLBELT_LORE": "<align=left>Tahmini teslimat:<indent=70%>Alıcı:</indent></align>\n<align=left>9/9/2079<indent=70%>UES Safe Travels/İşaretsiz Sektör/Dış Çeper</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Gönderi bilgileri:       </u></size></style></indent>\n\n<indent=2%>-Sipariş: <style=cIsUtility>Mühendis Alet Kemeri</style></indent>\n<indent=4%><style=cStack>Takip numarası:  667********</style></indent>\n\n<indent=2%>-Açıklama: Satın alınan dronları ve taretleri çoğaltmak için düşük bir şans kazan. Dronlar ve taretler öldüklerinde düşük bir şansla kendilerini diriltir.</indent>\n\n<indent=2%>-Gönderim yöntemi: <style=cIsHealth>Ertesi gün teslimat / Yaygın endüstriyel / Küçük</style></indent>\n\n<indent=2%>-Ayrıntılar: Selam dostum,\n\nYedek bir alet kemeri için teslimat isteğini yeni aldım. Safe Travels gemisinde bunlardan bir tane bile bulunmadığına inanamadım. Burada bazı malzemelerimiz azalıyor, bu yüzden elimde ne varsa kullandım. Kemer, sıradan bir dron ve taret onarım teknisyeninin ihtiyaç duyacağı her şeyi içeriyor.\n\nİçindekiler:\n\n<indent=5%>- Bir düz tornavida</indent>\n<indent=5%>- Bir kese dolusu Ionocell AA pil (ne şanslısın)</indent>\n<indent=5%>- Bir cırcır anahtarı</indent>\n<indent=5%>- Kızımın yokluğunu fark etmeyeceği zebra desenli koli bandı</indent>\n<indent=5%>- Bulabildiğim bütün dağınık vidalarla ağzına kadar dolu bir kese.</indent>\n<indent=5%>- Birkaç keseye konmuş somun ve cıvatalar.</indent>\n<indent=5%>- Buna sevineceksin: Kalan keselerden birini açarsan senin için koyduğum atıştırmalıkları bulacaksın. Bunlar ulaştığında yenebilir hâlde olurlar mı bilemem.</indent>\n\nSaygılarımla,\nMütevazı Bir Teknisyen\n\nNot: Bazı Ionocell pilleri hiperuzay yolculuğuna dayanmayabilir. Ama çok sayıda koydum; o robotları çalıştırmazlarsa başka bir çift dene.</indent>\n\n<style=cStack>Yepyeni </style><style=cIsUtility>Yörüngesel Kasa Bırakma Sistemi (TM) ile teslim edilir</style>. <style=cStack><u>İade yapılmaz.</u></style>"
  }
}
