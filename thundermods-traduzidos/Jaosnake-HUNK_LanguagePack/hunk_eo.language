    "ROB_HUNK_C4_NAME": "C4",
    "ROB_HUNK_C4_CONTEXT": "Aktivigi detonaciilon",
    "ROB_HUNK_KEYWORD_LOOTING": "<style=cKeywordName>Rabo</style><style=cSub>Malamikoj mortigitaj per cxi tiu kapablo havas malgrandan sxancon faligi municion.</style>",
    "ROB_HUNK_KEYWORD_MANGLED": "<style=cKeywordName>Mutilita</style><style=cSub>Atinginte 6 amasojn de cxi tiu malfortigo, malamikoj suferas tujan <style=cIsDamage>2200% da damagxo</style>.</style>",
    "ROB_HUNK_KEYWORD_PERFECTDODGE": "<style=cKeywordName>Perfekta Evito</style><style=cSub><style=cIsUtility>Repagas resxargtempon</style> kaj igas vin nelonge nevundebla. Permesas al vi fari <style=cIsDamage>Kontrauxatakon</style>.</style>",
    "ROB_HUNK_KEYWORD_PERFECTPARRY": "<style=cKeywordName>Perfekta Parado</style><style=cSub>Kauxzas <style=cIsDamage>800% da damagxo</style> kaj igas vin nelonge nevundebla. Permesas al vi fari <style=cIsDamage>Kontrauxatakon</style>.</style>",
    "ROB_HUNK_KEYWORD_PERFECTBASH": "<style=cKeywordName>Perfekta Sxultrobato</style><style=cSub><style=cIsUtility>Repagas resxargtempon</style> kaj igas vin nelonge nevundebla. Permesas al vi fari <style=cIsDamage>Kontrauxatakon</style>.</style>",
    "ROB_HUNK_KEYWORD_COUNTER": "<style=cKeywordName>Kontrauxatako</style><style=cSub>Premi <style=cIsDamage>cxefan</style> impetas antauxen kaj faras mortigan <style=cIsDamage>kontrauxatakon</style> kontraux proksima malamiko.</style>",
    "ROB_HUNK_KEYWORD_VIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Unufoje en cxiu etapo, hazarda monstro igxas <color=#C678B4>Infektita</color>. Gxi mutacias, <style=cIsHealth>igxante pli forta kun la tempo</style>, kaj mortigi gxin faligas <color=#FFFF00>G-Virusan Specimenon</color>.</style>\n\n<style=cKeywordName>T-Virus</style><style=cSub>Unufoje en cxiu etapo, pluraj monstroj igxas <color=#0066FF>Infektitaj</color>. Tio <style=cIsHealth>revivigas</style> ilin dufoje, kaj mortigi cxiujn donas al vi <color=#FFFF00>T-Virusan Specimenon</color>.</style>\n\n<style=cKeywordName>C-Virus</style><style=cSub>Unufoje en cxiu etapo, pluraj monstroj igxas <color=#FF0033>Infektitaj</color>. Cxe morto cxi tiuj monstroj eniras <style=cIsDamage>frenezon</style> dum <style=cIsUtility>5</style> sekundoj kaj poste <style=cIsHealth>eksplodas</style>, kaj mortigi cxiujn donas al vi <color=#FFFF00>C-Virusan Specimenon</color>.</style>",
    "ROB_HUNK_KEYWORD_GVIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Unufoje en cxiu etapo, hazarda monstro igxas <color=#C678B4>Infektita</color>. Gxi mutacias, <style=cIsHealth>igxante pli forta kun la tempo</style>, kaj mortigi gxin faligas <color=#FFFF00>G-Virusan Specimenon</color>.</style>",
    "ROB_HUNK_KEYWORD_TVIRUS": "<style=cKeywordName>T-Virus</style><style=cSub>Unufoje en cxiu etapo, pluraj monstroj igxas <color=#0066FF>Infektitaj</color>. Tio <style=cIsHealth>revivigas</style> ilin dufoje, kaj mortigi cxiujn donas al vi <color=#FFFF00>T-Virusan Specimenon</color>.</style>",
    "ROB_HUNK_KEYWORD_CVIRUS": "<style=cKeywordName>C-Virus</style><style=cSub>Unufoje en cxiu etapo, pluraj monstroj igxas <color=#FF0033>Infektitaj</color>. Cxe morto cxi tiuj monstroj eniras <style=cIsDamage>frenezon</style> dum <style=cIsUtility>5</style> sekundoj kaj poste <style=cIsHealth>eksplodas</style>, kaj mortigi cxiujn donas al vi <color=#FFFF00>C-Virusan Specimenon</color>.</style>",
    "ROB_HUNK_WEAPON_SMG_NAME": "LE 5",
    "ROB_HUNK_WEAPON_SMG_DESC": "Altrendimenta mitrajleto.",
    "ROB_HUNK_WEAPON_ADDON_SMG_NAME": "Lasera Celilo (LE 5)",
    "ROB_HUNK_WEAPON_ADDON_SMG_DESC": "Speciala parto por la LE 5, kiu plifortigas gxian efikecon je longa distanco kaj trafante malfortajn punktojn.",
    "ROB_HUNK_WEAPON_ADDON2_SMG_NAME": "Plilongigita Sxargilo (LE 5)",
    "ROB_HUNK_WEAPON_ADDON2_SMG_DESC": "Speciala parto por la LE 5, kiu grandege pligrandigas la kapaciton de gxia sxargilo.",
    "ROB_HUNK_WEAPON_ADDON3_SMG_NAME": "Moderigilo (LE 5)",
    "ROB_HUNK_WEAPON_ADDON3_SMG_DESC": "Speciala parto por la LE 5, kiu limigas gxian pafrapidecon, sed konvertas tiun bonuson al damagxo anstatauxe.",
    "ROB_HUNK_WEAPON_SMG2_NAME": "LE 5",
