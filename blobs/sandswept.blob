				float num = stackPercentPlatingGain / 100f * (float)count;
				int num2 = Mathf.RoundToInt((component.maxHealth + component.maxShield) * num);
				platingManager.CurrentPlating += num2;
				if (platingManager.MaxPlating <= 0f)
				{
					platingManager.MaxPlating = num2;
