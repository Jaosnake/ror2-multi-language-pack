        "ROB_BELMONT_KEY_NAME": "Clavis Laconica",
        "ROB_BELMONT_KEY_DESC": "Adhibetur ad aperiendam <color=#FFFF00>Arcam Thesauri</color>. Hae arcae continent <color=#FF0033>sacram reliquiam</color> et oriri solent <style=cIsUtility>quarto</style> quoque stadio in <style=cIsDamage>loco fixo</style>.",
        "ROB_BELMONT_KEY_PICKUP": "Adhibetur ad aperiendam Arcam Thesauri. Prope lucet.",
        "ROB_BELMONT_KEY_LORE": "",
        "ROB_BELMONT_MORNINGSTAR_NAME": "Stella Matutina",
        "ROB_BELMONT_MORNINGSTAR_DESC": "Singuli ictus flagelli <style=cIsUtility>secundariam explosionem</style> excitant ad <style=cIsDamage>600% damni</style>.",
        "ROB_BELMONT_MORNINGSTAR_PICKUP": "Flagellum quod omnes ad noctis cognationem pertinentes perdet.",
        "ROB_BELMONT_MORNINGSTAR_LORE": "",
        "ROB_BELMONT_CRISSAEGRIM_NAME": "Crissaegrim",
        "ROB_BELMONT_CRISSAEGRIM_DESC": "Singuli gladii ictus <style=cIsUtility>ter addito</style> feriunt ad <style=cIsDamage>300% damni</style> uterque.",
        "ROB_BELMONT_CRISSAEGRIM_PICKUP": "Innumerae laminae hostem concidunt.",
        "ROB_BELMONT_CRISSAEGRIM_LORE": "",
        "ROB_BELMONT_WINGEDBOOTS_NAME": "Caligae Pegaseae",
        "ROB_BELMONT_WINGEDBOOTS_DESC": "Post <style=cIsUtility>1</style> secundum cursus in <style=cIsUtility>terra</style>, accipe <style=cIsDamage>12 celeritatis motus</style>. Hostem percutere cum <style=cIsDamage>Rush</style> te facit eum calcitrare <style=cIsUtility>in aera</style> et deinde procul, ad <style=cIsDamage>4x200%</style> et <style=cIsDamage>300%</style> damni.",
        "ROB_BELMONT_WINGEDBOOTS_PICKUP": "Caligae quae peritiam tuam secundariam augent et te cursu venti currere sinunt.",
        "ROB_BELMONT_WINGEDBOOTS_LORE": "",
        "ROB_BELMONT_HOLYCROSS_NAME": "Focale Salvatoris",
        "ROB_BELMONT_HOLYCROSS_DESC": "Singulis <style=cIsUtility>3</style> minutis, substitue tuam <style=cIsDamage>peritiam singularem</style> cum <color=#FF0033>Flamma Sacra</color>.",
        "ROB_BELMONT_HOLYCROSS_PICKUP": "Aditum ad potentissimum ultimum impetum consequere.",
        "ROB_BELMONT_HOLYCROSS_LORE": "",
        "ROB_BELMONT_BROTHERSOUL_NAME": "Anima Regis",
        "ROB_BELMONT_BROTHERSOUL_DESC": "Singuli <style=cIsUtility>flagelli ictus</style> <style=cIsDamage>columnam flammae lunaris</style> gignunt, singuli <style=cIsUtility>gladii ictus</style> <style=cIsDamage>fragmentum lunare</style> creant, singuli <style=cIsUtility>flagelli concussus</style> <style=cIsDamage>terrestres undas concussionis</style> emittunt et singuli <style=cIsUtility>cursus conciti</style> <style=cIsHealing>20% saepimenti</style> gignunt.",
        "ROB_BELMONT_BROTHERSOUL_PICKUP": "Potentiam Regis Nihili quasi tuam gere.",
        "ROB_BELMONT_BROTHERSOUL_LORE": "",
