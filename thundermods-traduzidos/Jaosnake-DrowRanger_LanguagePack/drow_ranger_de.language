{
    "de": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Frost-Bogenschützin",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Grauenvolle Vergeltung",
        "DROWRANGER_DESCRIPTION": "Drow Ranger zeichnet sich durch Distanzkontrolle aus und durchbricht gegnerische Verteidigungen mit tödlichen Pfeilen.<style=cSub>\n\n< ! >Halte Gegner auf Distanz, um Treffsicherheit optimal zu nutzen. Ihre Bolzen fliegen langsam, also ziele sorgfältig, um weit entfernte Ziele zu treffen.\n\n< ! >Frostpfeile verlangsamen gefährliche Feinde. Unterkühlung verwandelt Gegnergruppen in Kettenexplosionen.\n\n< ! >Böe verschafft Raum für den Rückzug, während Gletscher eine temporäre erhöhte Position bietet.\n\n< ! >Wähle ein exklusives Relikt, um deine Reichweite, dein Überleben oder deine kritischen Treffer zu verbessern.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex lässt die gefrorene Ödnis hinter sich.",
        "DROWRANGER_OUTRO_FAILURE": "Der Frost fordert eine weitere Jägerin.",
        "DROWRANGER_RELIC_TITLE": "Exklusives Relikt",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Primäre Pfeile verursachen innerhalb von <style=cIsUtility>50m</style> vollen Schaden und behalten <style=cIsDamage>75%</style> jenseits von <style=cIsUtility>100m</style> bei. Treffer bewirken einen <style=cIsUtility>Rückstoß</style> bei Nicht-Bossgegnern innerhalb von <style=cIsUtility>12m</style>. Alle Pfeilgeschosse fliegen <style=cIsUtility>50% schneller</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Erhöht das Angriffstempo um <style=cIsDamage>20%</style>. Gewährt eine <style=cIsHealing>Chance von 30%, Schaden abzublocken</style>. Stapelt sich mit Härtere Zeiten mit abnehmender Wirkung.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Gewährt <style=cIsDamage>30% Chance auf kritische Treffer</style>. Kritische Treffer verursachen <style=cIsDamage>225% Schaden</style>, vor anderen Boni für kritischen Schaden.",
        "DROWRANGER_PRIMARY_NAME": "Frostpfeile",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Frost</style>. Feuert einen Pfeil für <style=cIsDamage>260% Schaden</style> ab.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Unterkühlung",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Unterkühlung</style>. Feuert einen Pfeil für <style=cIsDamage>260% Schaden</style> ab. Befallene Feinde explodieren beim Tod.",
        "DROWRANGER_SECONDARY_NAME": "Mehrfachschuss",
        "DROWRANGER_SECONDARY_DESC": "Feuert <style=cIsDamage>3 Wellen</style> durchbohrender Pfeile für <style=cIsDamage>3x360% Schaden</style> ab. Jede Welle wendet den gewählten Pfeileffekt an. Angriffstempo verkürzt die Kanalisierungsdauer mit halber Effizienz.",
        "DROWRANGER_UTILITY_NAME": "Böe",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Betäubend</style>. Entfesselt eine Böe, die <style=cIsUtility>Gegner zurückstößt</style> und <style=cIsUtility>3 Stapel</style> des Pfeileffekts anwendet. Gewährt <style=cIsUtility>50% Bewegungsgeschwindigkeit</style> für <style=cIsUtility>4s</style> und lässt rückwärts springen, wenn nicht gesprintet wird.",
        "DROWRANGER_GLACIER_NAME": "Gletscher",
        "DROWRANGER_GLACIER_DESC": "Errichtet einen aufragenden <style=cIsUtility>Gletscher</style> unter Euch für <style=cIsUtility>8s</style>, der Euch auf seinen Gipfel hebt und <style=cIsUtility>Gegner in der Nähe zurückstößt</style>.",
        "DROWRANGER_SPECIAL_NAME": "Treffsicherheit",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Passiv</style>: Wenn sich keine Feinde innerhalb von <style=cIsUtility>15m</style> befinden, haben primäre Pfeile eine Chance von <style=cIsDamage>30%</style>, zu <style=cIsDamage>rüstungsbrechenden Pfeilen</style> für <style=cIsDamage>390% Schaden</style> zu werden.\n<style=cIsUtility>Aktivieren</style>: Erhöht diese Chance auf <style=cIsDamage>100%</style> für <style=cIsUtility>5s</style>, oder auf <style=cIsDamage>50%</style> bei Feinden in der Nähe.",
        "DROWRANGER_WINTER_NAME": "Winterstoß",
        "DROWRANGER_WINTER_DESC": "Kurz anspannen und dann einen <style=cIsDamage>rüstungsbrechenden Pfeil</style> für <style=cIsDamage>1600% Schaden</style> abfeuern, der bis zu <style=cIsDamage>5 Gegner</style> durchbohrt und <style=cIsUtility>10 Stapel</style> des Pfeileffekts anwendet. Das Spannen kann nicht vorzeitig abgebrochen werden.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Frost</style><style=cSub>Verringert die verbleibende Bewegungsgeschwindigkeit um 15% pro Stapel für 3s. Stapelt sich bis zu 10-mal. Treffer erneuern alle Stapel. Friert Gegner nicht vollständig ein.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Unterkühlung</style><style=cSub>Stapelt sich bis zu 10-mal für 7s. Explodiert beim Tod für 150%–600% Schaden in einem Radius von 2–12m basierend auf Stapeln. Explosionen verbreiten Unterkühlung und lösen Kettenreaktionen aus. Verlangsamt Gegner nicht.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Pfeilreichweite</style><style=cSub>Der Schaden primärer Pfeile fällt jenseits von 40m ab und behält bei 80m noch 60% bei. Hurricane Pike erweitert diese Reichweite.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Rüstungsbrechend</style><style=cSub>Ignoriert positive Rüstung. Kann kritische Treffer erzielen und behält den gewählten Pfeileffekt bei.</style>"
    }
}