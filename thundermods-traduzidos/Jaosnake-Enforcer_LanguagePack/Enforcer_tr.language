        "ACHIEVEMENT_ENFORCER_STEVEUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Uygulayıcı olarak kalkanınızla bir saldırıyı engelleyin.",
        "ENFORCER_STEVEUNLOCKABLE_UNLOCKABLE_NAME": "Uygulayıcı: Bloklar",
        "ENFORCER_PRIMARY_SHOTGUN_NAME_UPGRADE_DESCRIPTION": "<style=cIsUtility>+%5</style>zarar,<style=cIsUtility>+%10</style>kurşun kalınlığı ve<style=cIsUtility>+0,1</style>kurşun yayılması",
