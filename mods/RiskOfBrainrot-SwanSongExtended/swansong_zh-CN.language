    "2R4R_INTERACTABLE_LUNAR_GALLERY_CONTEXT": "吃我一记超然物外吧书呆子",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_NAME": "腐朽构装体",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_CONTEXT": "踢一脚构装体",
