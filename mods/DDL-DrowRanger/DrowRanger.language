        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Portée des flèches</style><style=cSub>Les dégâts de la flèche principale diminuent au-delà de 40 m, conservant 60 % à 80 m. Hurricane Pike prolonge cette portée.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Perforant l'armure</style><style=cSub>Ignore l'armure positive. Peut infliger des coups critiques et conserve l'effet de flèche sélectionné.</style>"
    },
    "IT": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Arciera del gelo",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Terribile retribuzione",
        "DROWRANGER_DESCRIPTION": "Drow Ranger eccelle nel controllare la distanza e nello spezzare le difese nemiche con frecce letali.<style=cSub>\n\n< ! >Tieni i nemici a distanza per sfruttare al meglio Precisione di tiro. I suoi dardi viaggiano lentamente, quindi mira con cura per colpire bersagli distanti.\n\n< ! >Frecce di ghiaccio rallenta i nemici pericolosi. Ipotermia trasforma le orde in esplosioni a catena.\n\n< ! >Folata crea spazio per ritirarsi, mentre Ghiacciaio offre una posizione sopraelevata temporanea.\n\n< ! >Scegli una reliquia esclusiva per migliorare gittata, sopravvivenza o colpi critici.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex si lascia alle spalle le distese gelate.",
        "DROWRANGER_OUTRO_FAILURE": "Il gelo reclama un altro cacciatore.",
        "DROWRANGER_RELIC_TITLE": "Reliquia esclusiva",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Le frecce primarie infliggono danni completi entro <style=cIsUtility>50 m</style>, mantenendo il <style=cIsDamage>75%</style> oltre i <style=cIsUtility>100 m</style>. I colpi <style=cIsUtility>respingono</style> i nemici non-boss entro <style=cIsUtility>12 m</style>. Tutti i proiettili a freccia viaggiano il <style=cIsUtility>50% più velocemente</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Aumenta la velocità d'attacco del <style=cIsDamage>20%</style>. Ottieni una <style=cIsHealing>probabilità del 30% di bloccare i danni</style>. Si accumula con Tempi peggiori con rendimenti decrescenti.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Ottieni il <style=cIsDamage>30% di probabilità di colpo critico</style>. I colpi critici infliggono il <style=cIsDamage>225% di danni</style>, prima di altri bonus ai danni critici.",
        "DROWRANGER_PRIMARY_NAME": "Frecce di ghiaccio",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Gelo</style>. Scaglia una freccia per il <style=cIsDamage>260% di danni</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Ipotermia",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Ipotermia</style>. Scaglia una freccia per il <style=cIsDamage>260% di danni</style>. I nemici affetti esplodono alla morte.",
        "DROWRANGER_SECONDARY_NAME": "Tiro multiplo",
        "DROWRANGER_SECONDARY_DESC": "Scaglia <style=cIsDamage>3 ondate</style> di frecce perforanti per <style=cIsDamage>3x360% di danni</style>. Ogni ondata applica l'effetto della freccia selezionata. La velocità d'attacco accorcia la canalizzazione a metà dell'efficienza.",
        "DROWRANGER_UTILITY_NAME": "Folata",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Stordimento</style>. Rilascia una folata che <style=cIsUtility>respinge i nemici all'indietro</style> e applica <style=cIsUtility>3 accumuli</style> dell'effetto della tua freccia selezionata. Ottieni il <style=cIsUtility>50% di velocità di movimento</style> per <style=cIsUtility>4s</style> e salta all'indietro se non stai scattando.",
        "DROWRANGER_GLACIER_NAME": "Ghiacciaio",
        "DROWRANGER_GLACIER_DESC": "Innalza un imponente <style=cIsUtility>ghiacciaio</style> sotto di te per <style=cIsUtility>8s</style>, sollevandoti sulla sua cima e <style=cIsUtility>respingendo indietro i nemici vicini</style>.",
        "DROWRANGER_SPECIAL_NAME": "Precisione di tiro",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Passiva</style>: Senza nemici entro <style=cIsUtility>15 m</style>, le frecce primarie hanno una probabilità del <style=cIsDamage>30%</style> di diventare <style=cIsDamage>frecce perfora-corazza</style> per il <style=cIsDamage>390% di danni</style>.\n<style=cIsUtility>Attiva</style>: Aumenta questa probabilità al <style=cIsDamage>100%</style> per <style=cIsUtility>5s</style>, o al <style=cIsDamage>50%</style> con nemici vicini.",
        "DROWRANGER_WINTER_NAME": "Colpo d'inverno",
        "DROWRANGER_WINTER_DESC": "Prepara brevemente il tiro, poi scaglia una <style=cIsDamage>freccia perfora-corazza</style> per il <style=cIsDamage>1600% di danni</style>, perforando fino a <style=cIsDamage>5 nemici</style> e applicando <style=cIsUtility>10 accumuli</style> dell'effetto della tua freccia selezionata. La preparazione non può essere annullata volontariamente.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Gelo</style><style=cSub>Riduce la velocità di movimento rimanente del 15% per accumulo per 3s. Si accumula fino a 10 volte. I colpi rinnovano tutti gli accumuli. Non congela i nemici.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Ipotermia</style><style=cSub>Si accumula fino a 10 volte per 7s. Alla morte, esplode infliggendo dal 150% al 600% di danni in un raggio di 2-12 m in base agli accumuli. Le esplosioni diffondono Ipotermia e possono concatenarsi. Non rallenta i nemici.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Gittata della freccia</style><style=cSub>I danni della freccia principale diminuiscono oltre i 40 m, mantenendo il 60% a 80 m. Hurricane Pike estende questa gittata.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Perfora-corazza</style><style=cSub>Ignora la corazza positiva. Può sferrare colpi critici e conserva l'effetto della freccia selezionata.</style>"
    },
    "it": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Arciera del gelo",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Terribile retribuzione",
        "DROWRANGER_DESCRIPTION": "Drow Ranger eccelle nel controllare la distanza e nello spezzare le difese nemiche con frecce letali.<style=cSub>\n\n< ! >Tieni i nemici a distanza per sfruttare al meglio Precisione di tiro. I suoi dardi viaggiano lentamente, quindi mira con cura per colpire bersagli distanti.\n\n< ! >Frecce di ghiaccio rallenta i nemici pericolosi. Ipotermia trasforma le orde in esplosioni a catena.\n\n< ! >Folata crea spazio per ritirarsi, mentre Ghiacciaio offre una posizione sopraelevata temporanea.\n\n< ! >Scegli una reliquia esclusiva per migliorare gittata, sopravvivenza o colpi critici.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex si lascia alle spalle le distese gelate.",
        "DROWRANGER_OUTRO_FAILURE": "Il gelo reclama un altro cacciatore.",
        "DROWRANGER_RELIC_TITLE": "Reliquia esclusiva",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Le frecce primarie infliggono danni completi entro <style=cIsUtility>50 m</style>, mantenendo il <style=cIsDamage>75%</style> oltre i <style=cIsUtility>100 m</style>. I colpi <style=cIsUtility>respingono</style> i nemici non-boss entro <style=cIsUtility>12 m</style>. Tutti i proiettili a freccia viaggiano il <style=cIsUtility>50% più velocemente</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Aumenta la velocità d'attacco del <style=cIsDamage>20%</style>. Ottieni una <style=cIsHealing>probabilità del 30% di bloccare i danni</style>. Si accumula con Tempi peggiori con rendimenti decrescenti.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Ottieni il <style=cIsDamage>30% di probabilità di colpo critico</style>. I colpi critici infliggono il <style=cIsDamage>225% di danni</style>, prima di altri bonus ai danni critici.",
        "DROWRANGER_PRIMARY_NAME": "Frecce di ghiaccio",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Gelo</style>. Scaglia una freccia per il <style=cIsDamage>260% di danni</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Ipotermia",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Ipotermia</style>. Scaglia una freccia per il <style=cIsDamage>260% di danni</style>. I nemici affetti esplodono alla morte.",
        "DROWRANGER_SECONDARY_NAME": "Tiro multiplo",
        "DROWRANGER_SECONDARY_DESC": "Scaglia <style=cIsDamage>3 ondate</style> di frecce perforanti per <style=cIsDamage>3x360% di danni</style>. Ogni ondata applica l'effetto della freccia selezionata. La velocità d'attacco accorcia la canalizzazione a metà dell'efficienza.",
        "DROWRANGER_UTILITY_NAME": "Folata",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Stordimento</style>. Rilascia una folata che <style=cIsUtility>respinge i nemici all'indietro</style> e applica <style=cIsUtility>3 accumuli</style> dell'effetto della tua freccia selezionata. Ottieni il <style=cIsUtility>50% di velocità di movimento</style> per <style=cIsUtility>4s</style> e salta all'indietro se non stai scattando.",
        "DROWRANGER_GLACIER_NAME": "Ghiacciaio",
        "DROWRANGER_GLACIER_DESC": "Innalza un imponente <style=cIsUtility>ghiacciaio</style> sotto di te per <style=cIsUtility>8s</style>, sollevandoti sulla sua cima e <style=cIsUtility>respingendo indietro i nemici vicini</style>.",
        "DROWRANGER_SPECIAL_NAME": "Precisione di tiro",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Passiva</style>: Senza nemici entro <style=cIsUtility>15 m</style>, le frecce primarie hanno una probabilità del <style=cIsDamage>30%</style> di diventare <style=cIsDamage>frecce perfora-corazza</style> per il <style=cIsDamage>390% di danni</style>.\n<style=cIsUtility>Attiva</style>: Aumenta questa probabilità al <style=cIsDamage>100%</style> per <style=cIsUtility>5s</style>, o al <style=cIsDamage>50%</style> con nemici vicini.",
        "DROWRANGER_WINTER_NAME": "Colpo d'inverno",
        "DROWRANGER_WINTER_DESC": "Prepara brevemente il tiro, poi scaglia una <style=cIsDamage>freccia perfora-corazza</style> per il <style=cIsDamage>1600% di danni</style>, perforando fino a <style=cIsDamage>5 nemici</style> e applicando <style=cIsUtility>10 accumuli</style> dell'effetto della tua freccia selezionata. La preparazione non può essere annullata volontariamente.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Gelo</style><style=cSub>Riduce la velocità di movimento rimanente del 15% per accumulo per 3s. Si accumula fino a 10 volte. I colpi rinnovano tutti gli accumuli. Non congela i nemici.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Ipotermia</style><style=cSub>Si accumula fino a 10 volte per 7s. Alla morte, esplode infliggendo dal 150% al 600% di danni in un raggio di 2-12 m in base agli accumuli. Le esplosioni diffondono Ipotermia e possono concatenarsi. Non rallenta i nemici.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Gittata della freccia</style><style=cSub>I danni della freccia principale diminuiscono oltre i 40 m, mantenendo il 60% a 80 m. Hurricane Pike estende questa gittata.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Perfora-corazza</style><style=cSub>Ignora la corazza positiva. Può sferrare colpi critici e conserva l'effetto della freccia selezionata.</style>"
    },
    "de": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Frost-Bogenschützin",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Grauenvolle Vergeltung",
        "DROWRANGER_DESCRIPTION": "Drow Ranger zeichnet sich durch Distanzkontrolle aus und durchbricht gegnerische Verteidigungen mit tödlichen Pfeilen.<style=cSub>\n\n< ! >Halte Gegner auf Distanz, um Treffsicherheit optimal zu nutzen. Ihre Bolzen fliegen langsam, also ziele sorgfältig, um weit entfernte Ziele zu treffen.\n\n< ! >Frostpfeile verlangsamen gefährliche Feinde. Unterkühlung verwandelt Gegnergruppen in Kettenexplosionen.\n\n< ! >Böe verschafft Raum für den Rückzug, während Gletscher eine temporäre erhöhte Position bietet.\n\n< ! >Wähle ein exklusives Relikt, um deine Reichweite, dein Überleben oder deine kritischen Treffer zu verbessern.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex lässt die gefrorene Ödnis hinter sich.",
        "DROWRANGER_OUTRO_FAILURE": "Der Frost fordert eine weitere Jägerin.",
        "DROWRANGER_RELIC_TITLE": "Exklusives Relikt",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Primäre Pfeile verursachen innerhalb von <style=cIsUtility>50m</style> vollen Schaden und behalten <style=cIsDamage>75%</style> jenseits von <style=cIsUtility>100m</style> bei. Treffer bewirken einen <style=cIsUtility>Rückstoß</style> bei Nicht-Bossgegnern innerhalb von <style=cIsUtility>12m</style>. Alle Pfeilgeschosse fliegen <style=cIsUtility>50% schneller</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Erhöht das Angriffstempo um <style=cIsDamage>20%</style>. Gewährt eine <style=cIsHealing>Chance von 30%, Schaden abzublocken</style>. Stapelt sich mit Härtere Zeiten mit abnehmender Wirkung.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Gewährt <style=cIsDamage>30% Chance auf kritische Treffer</style>. Kritische Treffer verursachen <style=cIsDamage>225% Schaden</style>, vor anderen Boni für kritischen Schaden.",
        "DROWRANGER_PRIMARY_NAME": "Frostpfeile",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Frost</style>. Feuert einen Pfeil für <style=cIsDamage>260% Schaden</style> ab.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Unterkühlung",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Unterkühlung</style>. Feuert einen Pfeil für <style=cIsDamage>260% Schaden</style> ab. Befallene Feinde explodieren beim Tod.",
        "DROWRANGER_SECONDARY_NAME": "Mehrfachschuss",
        "DROWRANGER_SECONDARY_DESC": "Feuert <style=cIsDamage>3 Wellen</style> durchbohrender Pfeile für <style=cIsDamage>3x360% Schaden</style> ab. Jede Welle wendet den gewählten Pfeileffekt an. Angriffstempo verkürzt die Kanalisierungsdauer mit halber Effizienz.",
        "DROWRANGER_UTILITY_NAME": "Böe",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Betäubend</style>. Entfesselt eine Böe, die <style=cIsUtility>Gegner zurückstößt</style> und <style=cIsUtility>3 Stapel</style> des Pfeileffekts anwendet. Gewährt <style=cIsUtility>50% Bewegungsgeschwindigkeit</style> für <style=cIsUtility>4s</style> und lässt rückwärts springen, wenn nicht gesprintet wird.",
        "DROWRANGER_GLACIER_NAME": "Gletscher",
        "DROWRANGER_GLACIER_DESC": "Errichtet einen aufragenden <style=cIsUtility>Gletscher</style> unter Euch für <style=cIsUtility>8s</style>, der Euch auf seinen Gipfel hebt und <style=cIsUtility>Gegner in der Nähe zurückstößt</style>.",
        "DROWRANGER_SPECIAL_NAME": "Treffsicherheit",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Passiv</style>: Wenn sich keine Feinde innerhalb von <style=cIsUtility>15m</style> befinden, haben primäre Pfeile eine Chance von <style=cIsDamage>30%</style>, zu <style=cIsDamage>rüstungsbrechenden Pfeilen</style> für <style=cIsDamage>390% Schaden</style> zu werden.\n<style=cIsUtility>Aktivieren</style>: Erhöht diese Chance auf <style=cIsDamage>100%</style> für <style=cIsUtility>5s</style>, oder auf <style=cIsDamage>50%</style> bei Feinden in der Nähe.",
        "DROWRANGER_WINTER_NAME": "Winterstoß",
        "DROWRANGER_WINTER_DESC": "Kurz anspannen und dann einen <style=cIsDamage>rüstungsbrechenden Pfeil</style> für <style=cIsDamage>1600% Schaden</style> abfeuern, der bis zu <style=cIsDamage>5 Gegner</style> durchbohrt und <style=cIsUtility>10 Stapel</style> des Pfeileffekts anwendet. Das Spannen kann nicht vorzeitig abgebrochen werden.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Frost</style><style=cSub>Verringert die verbleibende Bewegungsgeschwindigkeit um 15% pro Stapel für 3s. Stapelt sich bis zu 10-mal. Treffer erneuern alle Stapel. Friert Gegner nicht vollständig ein.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Unterkühlung</style><style=cSub>Stapelt sich bis zu 10-mal für 7s. Explodiert beim Tod für 150%–600% Schaden in einem Radius von 2–12m basierend auf Stapeln. Explosionen verbreiten Unterkühlung und lösen Kettenreaktionen aus. Verlangsamt Gegner nicht.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Pfeilreichweite</style><style=cSub>Der Schaden primärer Pfeile fällt jenseits von 40m ab und behält bei 80m noch 60% bei. Hurricane Pike erweitert diese Reichweite.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Rüstungsbrechend</style><style=cSub>Ignoriert positive Rüstung. Kann kritische Treffer erzielen und behält den gewählten Pfeileffekt bei.</style>"
    },
    "RU": {
        "DROWRANGER_NAME": "Дроу-рейнджер",
        "DROWRANGER_SUBTITLE": "Ледяная лучница",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Дроу-рейнджер",
        "DROWRANGER_SKIN_ARCANA_NAME": "Зловещее возмездие",
        "DROWRANGER_DESCRIPTION": "Дроу-рейнджер превосходно контролирует дистанцию и пробивает защиту врагов смертоносными стрелами.<style=cSub>\n\n< ! >Держите врагов на расстоянии, чтобы максимально раскрыть Меткость. Её стрелы летят неторопливо, поэтому цельтесь тщательнее по далёким целям.\n\n< ! >Ледяные стрелы замедляют опасных противников. Гипотермия превращает скопления врагов в цепные взрывы.\n\n< ! >Порыв даёт пространство для отступления, а Ледник создаёт временную тактическую высоту.\n\n< ! >Выберите эксклюзивную реликвию, чтобы увеличить дальность, выживаемость или шанс критического удара.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Траксес оставляет ледяные пустоши позади.",
        "DROWRANGER_OUTRO_FAILURE": "Мороз забирает ещё одного охотника.",
        "DROWRANGER_RELIC_TITLE": "Эксклюзивная реликвия",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Основные стрелы наносят полный урон в пределах <style=cIsUtility>50м</style>, сохраняя <style=cIsDamage>75%</style> урона за пределами <style=cIsUtility>100м</style>. Попадания <style=cIsUtility>отбрасывают</style> врагов, не являющихся боссами, в пределах <style=cIsUtility>12м</style>. Все стрелы летят на <style=cIsUtility>50% быстрее</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Увеличивает скорость атаки на <style=cIsDamage>20%</style>. Даёт <style=cIsHealing>30% шанс заблокировать урон</style>. Складывается с предметом «Тяжёлые времена» с убывающей эффективностью.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Даёт <style=cIsDamage>30% шанс критического удара</style>. Критические удары наносят <style=cIsDamage>225% урона</style> до применения прочих бонусов к критическому урону.",
        "DROWRANGER_PRIMARY_NAME": "Ледяные стрелы",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Мороз</style>. Выпускает стрелу, наносящую <style=cIsDamage>260% урона</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Гипотермия",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Гипотермия</style>. Выпускает стрелу, наносящую <style=cIsDamage>260% урона</style>. Поражённые враги взрываются при смерти.",
        "DROWRANGER_SECONDARY_NAME": "Град стрел",
        "DROWRANGER_SECONDARY_DESC": "Выпускает <style=cIsDamage>3 волны</style> пронзающих стрел, наносящих <style=cIsDamage>3x360% урона</style>. Каждая волна накладывает эффект выбранной стрелы. Скорость атаки сокращает время поддержания с половинной эффективностью.",
        "DROWRANGER_UTILITY_NAME": "Порыв",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Оглушение</style>. Создаёт порыв ветра, который <style=cIsUtility>отбрасывает врагов</style> и накладывает <style=cIsUtility>3 заряда</style> эффекта вашей стрелы. Даёт <style=cIsUtility>50% к скорости передвижения</style> на <style=cIsUtility>4 сек.</style> и заставляет отпрыгнуть назад, если вы не бежите спринтом.",
        "DROWRANGER_GLACIER_NAME": "Ледник",
        "DROWRANGER_GLACIER_DESC": "Поднимает под вами высокий <style=cIsUtility>ледник</style> на <style=cIsUtility>8 сек.</style>, поднимая вас на вершину и <style=cIsUtility>отбрасывая ближайших врагов</style>.",
        "DROWRANGER_SPECIAL_NAME": "Меткость",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Пассивно</style>: если в радиусе <style=cIsUtility>15м</style> нет врагов, основные стрелы имеют шанс <style=cIsDamage>30%</style> стать <style=cIsDamage>бронебойными стрелами</style>, наносящими <style=cIsDamage>390% урона</style>.\n<style=cIsUtility>Активация</style>: увеличивает этот шанс до <style=cIsDamage>100%</style> на <style=cIsUtility>5 сек.</style> или до <style=cIsDamage>50%</style>, если рядом есть враги.",
        "DROWRANGER_WINTER_NAME": "Зимний удар",
        "DROWRANGER_WINTER_DESC": "После короткой подготовки выпускает <style=cIsDamage>бронебойную стрелу</style>, наносящую <style=cIsDamage>1600% урона</style>, пронзающую до <style=cIsDamage>5 врагов</style> и накладывающую <style=cIsUtility>10 зарядов</style> эффекта вашей стрелы. Подготовку нельзя отменить вручную.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Мороз</style><style=cSub>Снижает оставшуюся скорость передвижения на 15% за заряд на 3 сек. Складывается до 10 раз. Попадания обновляют все заряды. Не замораживает врагов намертво.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Гипотермия</style><style=cSub>Складывается до 10 раз на 7 сек. При смерти взрывается, нанося 150%–600% урона в радиусе 2–12м в зависимости от зарядов. Взрывы распространяют Гипотермию и вызывают цепную реакцию. Не замедляет врагов.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Дальность стрел</style><style=cSub>Урон основных стрел снижается после 40м, сохраняя 60% урона на 80м. Hurricane Pike увеличивает эту дальность.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Бронебойность</style><style=cSub>Игнорирует положительную броню. Может наносить критический удар и сохраняет эффект выбранной стрелы.</style>"
    },
    "ru": {
        "DROWRANGER_NAME": "Дроу-рейнджер",
        "DROWRANGER_SUBTITLE": "Ледяная лучница",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Дроу-рейнджер",
        "DROWRANGER_SKIN_ARCANA_NAME": "Зловещее возмездие",
        "DROWRANGER_DESCRIPTION": "Дроу-рейнджер превосходно контролирует дистанцию и пробивает защиту врагов смертоносными стрелами.<style=cSub>\n\n< ! >Держите врагов на расстоянии, чтобы максимально раскрыть Меткость. Её стрелы летят неторопливо, поэтому цельтесь тщательнее по далёким целям.\n\n< ! >Ледяные стрелы замедляют опасных противников. Гипотермия превращает скопления врагов в цепные взрывы.\n\n< ! >Порыв даёт пространство для отступления, а Ледник создаёт временную тактическую высоту.\n\n< ! >Выберите эксклюзивную реликвию, чтобы увеличить дальность, выживаемость или шанс критического удара.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Траксес оставляет ледяные пустоши позади.",
        "DROWRANGER_OUTRO_FAILURE": "Мороз забирает ещё одного охотника.",
        "DROWRANGER_RELIC_TITLE": "Эксклюзивная реликвия",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Основные стрелы наносят полный урон в пределах <style=cIsUtility>50м</style>, сохраняя <style=cIsDamage>75%</style> урона за пределами <style=cIsUtility>100м</style>. Попадания <style=cIsUtility>отбрасывают</style> врагов, не являющихся боссами, в пределах <style=cIsUtility>12м</style>. Все стрелы летят на <style=cIsUtility>50% быстрее</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Увеличивает скорость атаки на <style=cIsDamage>20%</style>. Даёт <style=cIsHealing>30% шанс заблокировать урон</style>. Складывается с предметом «Тяжёлые времена» с убывающей эффективностью.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Даёт <style=cIsDamage>30% шанс критического удара</style>. Критические удары наносят <style=cIsDamage>225% урона</style> до применения прочих бонусов к критическому урону.",
        "DROWRANGER_PRIMARY_NAME": "Ледяные стрелы",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Мороз</style>. Выпускает стрелу, наносящую <style=cIsDamage>260% урона</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Гипотермия",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Гипотермия</style>. Выпускает стрелу, наносящую <style=cIsDamage>260% урона</style>. Поражённые враги взрываются при смерти.",
        "DROWRANGER_SECONDARY_NAME": "Град стрел",
        "DROWRANGER_SECONDARY_DESC": "Выпускает <style=cIsDamage>3 волны</style> пронзающих стрел, наносящих <style=cIsDamage>3x360% урона</style>. Каждая волна накладывает эффект выбранной стрелы. Скорость атаки сокращает время поддержания с половинной эффективностью.",
        "DROWRANGER_UTILITY_NAME": "Порыв",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Оглушение</style>. Создаёт порыв ветра, который <style=cIsUtility>отбрасывает врагов</style> и накладывает <style=cIsUtility>3 заряда</style> эффекта вашей стрелы. Даёт <style=cIsUtility>50% к скорости передвижения</style> на <style=cIsUtility>4 сек.</style> и заставляет отпрыгнуть назад, если вы не бежите спринтом.",
        "DROWRANGER_GLACIER_NAME": "Ледник",
        "DROWRANGER_GLACIER_DESC": "Поднимает под вами высокий <style=cIsUtility>ледник</style> на <style=cIsUtility>8 сек.</style>, поднимая вас на вершину и <style=cIsUtility>отбрасывая ближайших врагов</style>.",
        "DROWRANGER_SPECIAL_NAME": "Меткость",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Пассивно</style>: если в радиусе <style=cIsUtility>15м</style> нет врагов, основные стрелы имеют шанс <style=cIsDamage>30%</style> стать <style=cIsDamage>бронебойными стрелами</style>, наносящими <style=cIsDamage>390% урона</style>.\n<style=cIsUtility>Активация</style>: увеличивает этот шанс до <style=cIsDamage>100%</style> на <style=cIsUtility>5 сек.</style> или до <style=cIsDamage>50%</style>, если рядом есть враги.",
        "DROWRANGER_WINTER_NAME": "Зимний удар",
        "DROWRANGER_WINTER_DESC": "После короткой подготовки выпускает <style=cIsDamage>бронебойную стрелу</style>, наносящую <style=cIsDamage>1600% урона</style>, пронзающую до <style=cIsDamage>5 врагов</style> и накладывающую <style=cIsUtility>10 зарядов</style> эффекта вашей стрелы. Подготовку нельзя отменить вручную.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Мороз</style><style=cSub>Снижает оставшуюся скорость передвижения на 15% за заряд на 3 сек. Складывается до 10 раз. Попадания обновляют все заряды. Не замораживает врагов намертво.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Гипотермия</style><style=cSub>Складывается до 10 раз на 7 сек. При смерти взрывается, нанося 150%–600% урона в радиусе 2–12м в зависимости от зарядов. Взрывы распространяют Гипотермию и вызывают цепную реакцию. Не замедляет врагов.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Дальность стрел</style><style=cSub>Урон основных стрел снижается после 40м, сохраняя 60% урона на 80м. Hurricane Pike увеличивает эту дальность.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Бронебойность</style><style=cSub>Игнорирует положительную броню. Может наносить критический удар и сохраняет эффект выбранной стрелы.</style>"
    },
    "UA": {
        "DROWRANGER_NAME": "Дроу-рейнджер",
        "DROWRANGER_SUBTITLE": "Крижана лучниця",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Дроу-рейнджер",
        "DROWRANGER_SKIN_ARCANA_NAME": "Лиховісна відплата",
        "DROWRANGER_DESCRIPTION": "Дроу-рейнджер чудово контролює дистанцію та пробиває ворожий захист смертоносними стрілами.<style=cSub>\n\n< ! >Тримайте ворогів на відстані, щоб якнайкраще використати Влучність. Її стріли летять неквапливо, тому ретельно цільтеся у віддалені цілі.\n\n< ! >Крижані стріли сповільнюють небезпечних супротивників. Гіпотермія перетворює юрми ворогів на ланцюгові вибухи.\n\n< ! >Порив створює простір для відступу, тоді як Льодовик забезпечує тимчасову вигідну висоту.\n\n< ! >Оберіть ексклюзивну реліквію, щоб покращити дальність, виживання або критичні удари.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Траксес залишає замерзлі пустки позаду.",
        "DROWRANGER_OUTRO_FAILURE": "Мороз забирає ще одного мисливця.",
        "DROWRANGER_RELIC_TITLE": "Ексклюзивна реліквія",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Основні стріли завдають повної шкоди в межах <style=cIsUtility>50м</style>, зберігаючи <style=cIsDamage>75%</style> шкоди понад <style=cIsUtility>100м</style>. Влучання <style=cIsUtility>відкидають</style> ворогів, які не є босами, в межах <style=cIsUtility>12м</style>. Усі стріли летять на <style=cIsUtility>50% швидше</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Збільшує швидкість атаки на <style=cIsDamage>20%</style>. Надає <style=cIsHealing>30% шанс заблокувати шкоду</style>. Складається з предметом «Важкі часи» зі спадною ефективністю.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Надає <style=cIsDamage>30% шанс критичного удару</style>. Критичні удари завдають <style=cIsDamage>225% шкоди</style> до застосування інших бонусів до критичної шкоди.",
        "DROWRANGER_PRIMARY_NAME": "Крижані стріли",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Мороз</style>. Випускає стрілу, що завдає <style=cIsDamage>260% шкоди</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Гіпотермія",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Гіпотермія</style>. Випускає стрілу, що завдає <style=cIsDamage>260% шкоди</style>. Уражені вороги вибухають після смерті.",
        "DROWRANGER_SECONDARY_NAME": "Град стріл",
        "DROWRANGER_SECONDARY_DESC": "Випускає <style=cIsDamage>3 хвилі</style> пронизливих стріл, що завдають <style=cIsDamage>3x360% шкоди</style>. Кожна хвиля накладає ефект обраної стріли. Швидкість атаки скорочує тривалість підтримування з половинною ефективністю.",
        "DROWRANGER_UTILITY_NAME": "Порив",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Оглушення</style>. Створює порив вітру, який <style=cIsUtility>відкидає ворогів</style> і накладає <style=cIsUtility>3 заряди</style> ефекту вашої стріли. Надає <style=cIsUtility>50% до швидкості пересування</style> на <style=cIsUtility>4с</style> і змушує відскочити назад, якщо ви не біжите спринтом.",
        "DROWRANGER_GLACIER_NAME": "Льодовик",
        "DROWRANGER_GLACIER_DESC": "Підіймає високий <style=cIsUtility>льодовик</style> під вами на <style=cIsUtility>8с</style>, виносячи вас на вершину та <style=cIsUtility>відкидаючи найближчих ворогів</style>.",
        "DROWRANGER_SPECIAL_NAME": "Влучність",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Пасивно</style>: якщо в радіусі <style=cIsUtility>15м</style> немає ворогів, основні стріли мають шанс <style=cIsDamage>30%</style> стати <style=cIsDamage>бронебійними стрілами</style>, що завдають <style=cIsDamage>390% шкоди</style>.\n<style=cIsUtility>Активація</style>: збільшує цей шанс до <style=cIsDamage>100%</style> на <style=cIsUtility>5с</style> або до <style=cIsDamage>50%</style>, якщо поруч є вороги.",
        "DROWRANGER_WINTER_NAME": "Зимовий удар",
        "DROWRANGER_WINTER_DESC": "Після короткої підготовки випускає <style=cIsDamage>бронебійну стрілу</style>, що завдає <style=cIsDamage>1600% шкоди</style>, пронизує до <style=cIsDamage>5 ворогів</style> і накладає <style=cIsUtility>10 зарядів</style> ефекту вашої стріли. Підготовку не можна скасувати добровільно.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Мороз</style><style=cSub>Знижує залишкову швидкість пересування на 15% за заряд на 3с. Складається до 10 разів. Влучання оновлюють усі заряди. Не заморожує ворогів повністю.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Гіпотермія</style><style=cSub>Складається до 10 разів на 7с. Після смерті вибухає, завдаючи 150%–600% шкоди в радіусі 2–12м залежно від кількості зарядів. Вибухи поширюють Гіпотермію та викликають ланцюгову реакцію. Не сповільнює ворогів.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Дальність стріл</style><style=cSub>Шкода основних стріл знижується понад 40м, зберігаючи 60% шкоди на 80м. Hurricane Pike розширює цю дальність.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Бронебійність</style><style=cSub>Ігнорує додаткову броню. Може завдавати критичного удару та зберігає ефект обраної стріли.</style>"
    },
    "uk": {
        "DROWRANGER_NAME": "Дроу-рейнджер",
        "DROWRANGER_SUBTITLE": "Крижана лучниця",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Дроу-рейнджер",
        "DROWRANGER_SKIN_ARCANA_NAME": "Лиховісна відплата",
        "DROWRANGER_DESCRIPTION": "Дроу-рейнджер чудово контролює дистанцію та пробиває ворожий захист смертоносними стрілами.<style=cSub>\n\n< ! >Тримайте ворогів на відстані, щоб якнайкраще використати Влучність. Її стріли летять неквапливо, тому ретельно цільтеся у віддалені цілі.\n\n< ! >Крижані стріли сповільнюють небезпечних супротивників. Гіпотермія перетворює юрми ворогів на ланцюгові вибухи.\n\n< ! >Порив створює простір для відступу, тоді як Льодовик забезпечує тимчасову вигідну висоту.\n\n< ! >Оберіть ексклюзивну реліквію, щоб покращити дальність, виживання або критичні удари.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Траксес залишає замерзлі пустки позаду.",
        "DROWRANGER_OUTRO_FAILURE": "Мороз забирає ще одного мисливця.",
        "DROWRANGER_RELIC_TITLE": "Ексклюзивна реліквія",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Основні стріли завдають повної шкоди в межах <style=cIsUtility>50м</style>, зберігаючи <style=cIsDamage>75%</style> шкоди понад <style=cIsUtility>100м</style>. Влучання <style=cIsUtility>відкидають</style> ворогів, які не є босами, в межах <style=cIsUtility>12м</style>. Усі стріли летять на <style=cIsUtility>50% швидше</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Збільшує швидкість атаки на <style=cIsDamage>20%</style>. Надає <style=cIsHealing>30% шанс заблокувати шкоду</style>. Складається з предметом «Важкі часи» зі спадною ефективністю.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Надає <style=cIsDamage>30% шанс критичного удару</style>. Критичні удари завдають <style=cIsDamage>225% шкоди</style> до застосування інших бонусів до критичної шкоди.",
        "DROWRANGER_PRIMARY_NAME": "Крижані стріли",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Мороз</style>. Випускає стрілу, що завдає <style=cIsDamage>260% шкоди</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Гіпотермія",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Гіпотермія</style>. Випускає стрілу, що завдає <style=cIsDamage>260% шкоди</style>. Уражені вороги вибухають після смерті.",
        "DROWRANGER_SECONDARY_NAME": "Град стріл",
        "DROWRANGER_SECONDARY_DESC": "Випускає <style=cIsDamage>3 хвилі</style> пронизливих стріл, що завдають <style=cIsDamage>3x360% шкоди</style>. Кожна хвиля накладає ефект обраної стріли. Швидкість атаки скорочує тривалість підтримування з половинною ефективністю.",
        "DROWRANGER_UTILITY_NAME": "Порив",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Оглушення</style>. Створює порив вітру, який <style=cIsUtility>відкидає ворогів</style> і накладає <style=cIsUtility>3 заряди</style> ефекту вашої стріли. Надає <style=cIsUtility>50% до швидкості пересування</style> на <style=cIsUtility>4с</style> і змушує відскочити назад, якщо ви не біжите спринтом.",
        "DROWRANGER_GLACIER_NAME": "Льодовик",
        "DROWRANGER_GLACIER_DESC": "Підіймає високий <style=cIsUtility>льодовик</style> під вами на <style=cIsUtility>8с</style>, виносячи вас на вершину та <style=cIsUtility>відкидаючи найближчих ворогів</style>.",
        "DROWRANGER_SPECIAL_NAME": "Влучність",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Пасивно</style>: якщо в радіусі <style=cIsUtility>15м</style> немає ворогів, основні стріли мають шанс <style=cIsDamage>30%</style> стати <style=cIsDamage>бронебійними стрілами</style>, що завдають <style=cIsDamage>390% шкоди</style>.\n<style=cIsUtility>Активація</style>: збільшує цей шанс до <style=cIsDamage>100%</style> на <style=cIsUtility>5с</style> або до <style=cIsDamage>50%</style>, якщо поруч є вороги.",
        "DROWRANGER_WINTER_NAME": "Зимовий удар",
        "DROWRANGER_WINTER_DESC": "Після короткої підготовки випускає <style=cIsDamage>бронебійну стрілу</style>, що завдає <style=cIsDamage>1600% шкоди</style>, пронизує до <style=cIsDamage>5 ворогів</style> і накладає <style=cIsUtility>10 зарядів</style> ефекту вашої стріли. Підготовку не можна скасувати добровільно.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Мороз</style><style=cSub>Знижує залишкову швидкість пересування на 15% за заряд на 3с. Складається до 10 разів. Влучання оновлюють усі заряди. Не заморожує ворогів повністю.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Гіпотермія</style><style=cSub>Складається до 10 разів на 7с. Після смерті вибухає, завдаючи 150%–600% шкоди в радіусі 2–12м залежно від кількості зарядів. Вибухи поширюють Гіпотермію та викликають ланцюгову реакцію. Не сповільнює ворогів.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Дальність стріл</style><style=cSub>Шкода основних стріл знижується понад 40м, зберігаючи 60% шкоди на 80м. Hurricane Pike розширює цю дальність.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Бронебійність</style><style=cSub>Ігнорує додаткову броню. Може завдавати критичного удару та зберігає ефект обраної стріли.</style>"
    },
    "ua": {
        "DROWRANGER_NAME": "Дроу-рейнджер",
        "DROWRANGER_SUBTITLE": "Крижана лучниця",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Дроу-рейнджер",
        "DROWRANGER_SKIN_ARCANA_NAME": "Лиховісна відплата",
        "DROWRANGER_DESCRIPTION": "Дроу-рейнджер чудово контролює дистанцію та пробиває ворожий захист смертоносними стрілами.<style=cSub>\n\n< ! >Тримайте ворогів на відстані, щоб якнайкраще використати Влучність. Її стріли летять неквапливо, тому ретельно цільтеся у віддалені цілі.\n\n< ! >Крижані стріли сповільнюють небезпечних супротивників. Гіпотермія перетворює юрми ворогів на ланцюгові вибухи.\n\n< ! >Порив створює простір для відступу, тоді як Льодовик забезпечує тимчасову вигідну висоту.\n\n< ! >Оберіть ексклюзивну реліквію, щоб покращити дальність, виживання або критичні удари.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Траксес залишає замерзлі пустки позаду.",
        "DROWRANGER_OUTRO_FAILURE": "Мороз забирає ще одного мисливця.",
        "DROWRANGER_RELIC_TITLE": "Ексклюзивна реліквія",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Основні стріли завдають повної шкоди в межах <style=cIsUtility>50м</style>, зберігаючи <style=cIsDamage>75%</style> шкоди понад <style=cIsUtility>100м</style>. Влучання <style=cIsUtility>відкидають</style> ворогів, які не є босами, в межах <style=cIsUtility>12м</style>. Усі стріли летять на <style=cIsUtility>50% швидше</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Збільшує швидкість атаки на <style=cIsDamage>20%</style>. Надає <style=cIsHealing>30% шанс заблокувати шкоду</style>. Складається з предметом «Важкі часи» зі спадною ефективністю.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Надає <style=cIsDamage>30% шанс критичного удару</style>. Критичні удари завдають <style=cIsDamage>225% шкоди</style> до застосування інших бонусів до критичної шкоди.",
        "DROWRANGER_PRIMARY_NAME": "Крижані стріли",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Мороз</style>. Випускає стрілу, що завдає <style=cIsDamage>260% шкоди</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Гіпотермія",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Гіпотермія</style>. Випускає стрілу, що завдає <style=cIsDamage>260% шкоди</style>. Уражені вороги вибухають після смерті.",
        "DROWRANGER_SECONDARY_NAME": "Град стріл",
        "DROWRANGER_SECONDARY_DESC": "Випускає <style=cIsDamage>3 хвилі</style> пронизливих стріл, що завдають <style=cIsDamage>3x360% шкоди</style>. Кожна хвиля накладає ефект обраної стріли. Швидкість атаки скорочує тривалість підтримування з половинною ефективністю.",
        "DROWRANGER_UTILITY_NAME": "Порив",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Оглушення</style>. Створює порив вітру, який <style=cIsUtility>відкидає ворогів</style> і накладає <style=cIsUtility>3 заряди</style> ефекту вашої стріли. Надає <style=cIsUtility>50% до швидкості пересування</style> на <style=cIsUtility>4с</style> і змушує відскочити назад, якщо ви не біжите спринтом.",
        "DROWRANGER_GLACIER_NAME": "Льодовик",
        "DROWRANGER_GLACIER_DESC": "Підіймає високий <style=cIsUtility>льодовик</style> під вами на <style=cIsUtility>8с</style>, виносячи вас на вершину та <style=cIsUtility>відкидаючи найближчих ворогів</style>.",
        "DROWRANGER_SPECIAL_NAME": "Влучність",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Пасивно</style>: якщо в радіусі <style=cIsUtility>15м</style> немає ворогів, основні стріли мають шанс <style=cIsDamage>30%</style> стати <style=cIsDamage>бронебійними стрілами</style>, що завдають <style=cIsDamage>390% шкоди</style>.\n<style=cIsUtility>Активація</style>: збільшує цей шанс до <style=cIsDamage>100%</style> на <style=cIsUtility>5с</style> або до <style=cIsDamage>50%</style>, якщо поруч є вороги.",
        "DROWRANGER_WINTER_NAME": "Зимовий удар",
        "DROWRANGER_WINTER_DESC": "Після короткої підготовки випускає <style=cIsDamage>бронебійну стрілу</style>, що завдає <style=cIsDamage>1600% шкоди</style>, пронизує до <style=cIsDamage>5 ворогів</style> і накладає <style=cIsUtility>10 зарядів</style> ефекту вашої стріли. Підготовку не можна скасувати добровільно.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Мороз</style><style=cSub>Знижує залишкову швидкість пересування на 15% за заряд на 3с. Складається до 10 разів. Влучання оновлюють усі заряди. Не заморожує ворогів повністю.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Гіпотермія</style><style=cSub>Складається до 10 разів на 7с. Після смерті вибухає, завдаючи 150%–600% шкоди в радіусі 2–12м залежно від кількості зарядів. Вибухи поширюють Гіпотермію та викликають ланцюгову реакцію. Не сповільнює ворогів.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Дальність стріл</style><style=cSub>Шкода основних стріл знижується понад 40м, зберігаючи 60% шкоди на 80м. Hurricane Pike розширює цю дальність.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Бронебійність</style><style=cSub>Ігнорує додаткову броню. Може завдавати критичного удару та зберігає ефект обраної стріли.</style>"
    },
    "la": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Sagittaria Gelida",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Ultio Formidolosa",
        "DROWRANGER_DESCRIPTION": "Drow Ranger spatio moderando et munitionibus hostium sagittis mortiferis perrumpendis excellit.<style=cSub>\n\n< ! >Hostes eminus retine ut Peritiam Sagittandi optime adhibeas. Sagittae eius lente volant, ergo accurate intende ut scopos remotos ferias.\n\n< ! >Sagittae Gelidae hostes periculosos retardant. Hypothermia turbas in catenatas explosiones vertit.\n\n< ! >Flatus spatium ad recedendum creat, dum Glacies speculam temporariam praebet.\n\n< ! >Elige reliquiam singularem ad spatium sagittarum, salutem vel ictus criticos augendos.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex deserta congelata post se relinquit.",
        "DROWRANGER_OUTRO_FAILURE": "Gelu alteram venatricem vindicat.",
        "DROWRANGER_RELIC_TITLE": "Reliquia Singularis",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Sagittae primariae plenum vulnus intra <style=cIsUtility>50m</style> infligunt, <style=cIsDamage>75%</style> ultra <style=cIsUtility>100m</style> retinentes. Ictus <style=cIsUtility>respellunt</style> hostes non-custodes intra <style=cIsUtility>12m</style>. Omnia missilia sagittarum <style=cIsUtility>50% celerius</style> volant.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Celeritatem impetus per <style=cIsDamage>20%</style> auget. Concedit <style=cIsHealing>30% facultatem arcendi vulneris</style>. Cum Temporibus Difficilioribus cum reditibus decrescentibus cumulatur.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Concedit <style=cIsDamage>30% facultatem ictus critici</style>. Ictus critici <style=cIsDamage>225% vulneris</style> infligunt, ante alia additamenta ictus critici.",
        "DROWRANGER_PRIMARY_NAME": "Sagittae Gelidae",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Gelu</style>. Iace sagittam pro <style=cIsDamage>260% vulneris</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Hypothermia",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Hypothermia</style>. Iace sagittam pro <style=cIsDamage>260% vulneris</style>. Hostes affecti morientes explodunt.",
        "DROWRANGER_SECONDARY_NAME": "Multisagittatio",
        "DROWRANGER_SECONDARY_DESC": "Iace <style=cIsDamage>3 undas</style> sagittarum penetrantium pro <style=cIsDamage>3x360% vulneris</style>. Quaeque unda effectum sagittae selectae adhibet. Celeritas impetus tempus canalizandi dimidia efficacitate minuit.",
        "DROWRANGER_UTILITY_NAME": "Flatus",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Stupefaciens</style>. Emitte flatum qui <style=cIsUtility>hostes respellit</style> et <style=cIsUtility>3 acervos</style> effectus sagittae tuae adhibet. Concede <style=cIsUtility>50% celeritatem motus</style> pro <style=cIsUtility>4s</style>, et retrorsum desili si non curris.",
        "DROWRANGER_GLACIER_NAME": "Glacies",
        "DROWRANGER_GLACIER_DESC": "Attolle excelsam <style=cIsUtility>glaciem</style> sub te pro <style=cIsUtility>8s</style>, te ad summum levans et <style=cIsUtility>hostes propinquos respellens</style>.",
        "DROWRANGER_SPECIAL_NAME": "Peritia Sagittandi",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Passivum</style>: Nullis hostibus intra <style=cIsUtility>15m</style> existentibus, sagittae primariae <style=cIsDamage>30%</style> facultatem habent fiendi <style=cIsDamage>sagittae loricam penetrantes</style> pro <style=cIsDamage>390% vulneris</style>.\n<style=cIsUtility>Activa</style>: Hanc facultatem ad <style=cIsDamage>100%</style> pro <style=cIsUtility>5s</style> auge, vel ad <style=cIsDamage>50%</style> cum hostibus propinquis.",
        "DROWRANGER_WINTER_NAME": "Ictus Hiemalis",
        "DROWRANGER_WINTER_DESC": "Arcum breviter intende, deinde emitte <style=cIsDamage>sagittam loricam penetrantem</style> pro <style=cIsDamage>1600% vulneris</style>, usque ad <style=cIsDamage>5 hostes</style> perforans et <style=cIsUtility>10 acervos</style> effectus sagittae tuae adhibens. Intentio voluntarie revocari non potest.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Gelu</style><style=cSub>Celeritatem motus residuam per 15% pro acervo per 3s minuit. Usque ad 10 vices cumulatur. Ictus omnes acervos renovant. Hostes omnino non congelat.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Hypothermia</style><style=cSub>Usque ad 10 vices per 7s cumulatur. In morte, explodet pro 150%–600% vulneris intra radium 2–12m secundum acervos. Explosiones Hypothermiam spargunt et catenatim propagari possunt. Hostes non retardat.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Sagittae distantia</style><style=cSub>Vulnus sagittae primariae ultra 40m decrescit, 60% ad 80m retinens. Hurricane Pike hoc spatium extendit.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Loricam penetrans</style><style=cSub>Loricam positivam ignorat. Ictum criticum inferre potest et effectum sagittae selectae retinet.</style>"
    },
    "eo": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Frosta Pafarkisto",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Terura Reprezalio",
        "DROWRANGER_DESCRIPTION": "Drow Ranger elstaras je kontrolo de distanco kaj trarompo de malamikaj defendoj per mortigaj sagoj.<style=cSub>\n\n< ! >Tenu malamikojn je distanco por plej bone utiligi Pafarton. Sxiaj sagoj flugas malrapide, do celu zorge por trafi malproksimajn celojn.\n\n< ! >Frostaj Sagoj malrapidigas dangxerajn malamikojn. Hipotermio transformas amasojn en cxenajn eksplodojn.\n\n< ! >Ventopusxo kreas spacon por retretigi, dum Glaciejo provizas provizoran altan pozicion.\n\n< ! >Elektu ekskluzivan relikvon por plibonigi vian atingodistancon, postvivadon aux kritikajn frapojn.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex lasas la frostigitajn dezertojn malantauxe.",
        "DROWRANGER_OUTRO_FAILURE": "La frosto postulas alian cxasiston.",
        "DROWRANGER_RELIC_TITLE": "Ekskluziva Relikvo",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Primaraj sagoj kauxzas plenan damagxon ene de <style=cIsUtility>50m</style>, retenante <style=cIsDamage>75%</style> preter <style=cIsUtility>100m</style>. Trafoj <style=cIsUtility>repusxas</style> ne-estrajn malamikojn ene de <style=cIsUtility>12m</style>. Cxiuj sagaj projektiloj flugas <style=cIsUtility>50% pli rapide</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Pliigas atakrapidecon je <style=cIsDamage>20%</style>. Donas <style=cIsHealing>30%-an sxancon bloki damagxon</style>. Kumuligxas kun Pli Malfacilaj Tempoj kun malkreskantaj rendimentoj.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Donas <style=cIsDamage>30%-an kritikan frapchancecon</style>. Kritikaj frapoj kauxzas <style=cIsDamage>225% da damagxo</style>, antaux aliaj kritikaj damagxaj gratifikoj.",
        "DROWRANGER_PRIMARY_NAME": "Frostaj Sagoj",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Frosto</style>. Pafu sagon por <style=cIsDamage>260% da damagxo</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Hipotermio",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Hipotermio</style>. Pafu sagon por <style=cIsDamage>260% da damagxo</style>. Trafitoj eksplodas cxe morto.",
        "DROWRANGER_SECONDARY_NAME": "Multobla Pafo",
        "DROWRANGER_SECONDARY_DESC": "Pafu <style=cIsDamage>3 ondojn</style> de trapikantaj sagoj por <style=cIsDamage>3x360% da damagxo</style>. Cxiu ondo aplikas vian elektitan sagan efikon. Atakrapideco mallongigas la kanalan dauxron je duona efikeco.",
        "DROWRANGER_UTILITY_NAME": "Ventopusxo",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Stuporigante</style>. Liberigu ventopusxon kiu <style=cIsUtility>repusxas malamikojn</style> kaj aplikas <style=cIsUtility>3 stakojn</style> de via saga efiko. Ricevu <style=cIsUtility>50%-an movrapidecon</style> dum <style=cIsUtility>4s</style>, kaj resaltu malantauxen se vi ne sprintas.",
        "DROWRANGER_GLACIER_NAME": "Glaciejo",
        "DROWRANGER_GLACIER_DESC": "Levu altan <style=cIsUtility>glaciejon</style> sub vi dum <style=cIsUtility>8s</style>, levante vin al gxia supro kaj <style=cIsUtility>repusxante proksimajn malamikojn</style>.",
        "DROWRANGER_SPECIAL_NAME": "Pafarto",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Pasiva</style>: Sen malamikoj ene de <style=cIsUtility>15m</style>, primaraj sagoj havas <style=cIsDamage>30%-an</style> sxancon igxi <style=cIsDamage>kiras-penetraj sagoj</style> por <style=cIsDamage>390% da damagxo</style>.\n<style=cIsUtility>Aktivigo</style>: Pliigu cxi tiun sxancon al <style=cIsDamage>100%</style> dum <style=cIsUtility>5s</style>, aux al <style=cIsDamage>50%</style> cxe proksimaj malamikoj.",
        "DROWRANGER_WINTER_NAME": "Vintra Frapo",
        "DROWRANGER_WINTER_DESC": "Mallonge strecxu la arkon, poste pafu <style=cIsDamage>kiras-penetran sagon</style> por <style=cIsDamage>1600% da damagxo</style>, trapikante gxis <style=cIsDamage>5 malamikojn</style> kaj aplikante <style=cIsUtility>10 stakojn</style> de via saga efiko. La strecxado ne povas esti nuligita propravole.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Frosto</style><style=cSub>Reduktas restantan movrapidecon je 15% po stako dum 3s. Stakigxas gxis 10 fojojn. Trafoj refresxigas cxiujn stakojn. Ne plene frostigas malamikojn.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Hipotermio</style><style=cSub>Stakigxas gxis 10 fojojn dum 7s. Cxe morto, eksplodas por 150%–600% da damagxo en radiuso de 2–12m laux stakoj. Eksplodoj disvastigas Hipotermion kaj povas cxeni. Ne malrapidigas malamikojn.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Saga distanco</style><style=cSub>Primara saga damagxo falas preter 40m, retenante 60% cxe 80m. Hurricane Pike etendas cxi tiun distancon.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Kiras-penetra</style><style=cSub>Ignoras pozitivan kirason. Povas kauxzi kritikan frapon kaj retenas la elektitan sagan efikon.</style>"
    },
    "zh-CN": {
        "DROWRANGER_NAME": "卓尔游侠",
        "DROWRANGER_SUBTITLE": "霜之射手",
        "DROWRANGER_SKIN_DEFAULT_NAME": "卓尔游侠",
        "DROWRANGER_SKIN_ARCANA_NAME": "仇尽寂灭",
        "DROWRANGER_DESCRIPTION": "卓尔游侠是一位擅长控制距离、以致命箭矢击破敌人防御的射手。<style=cSub>\n\n< ! >与敌人保持距离，才能充分发挥射手天赋的威力。但发射的弩箭飞行速度较慢，需要瞄准才能击中远处的目标。\n\n< ! >霜冻之箭能拖慢危险的敌人，低温症则能让成群敌人陷入连环冰爆。\n\n< ! >狂风可以为撤退创造空间，冰川提供临时的制高点。\n\n< ! >选择适合自己的专属装备，强化射程、生存或暴击。</style>",
        "DROWRANGER_OUTRO_FLAVOR": "崔希丝把冰封荒原留在了身后。",
        "DROWRANGER_OUTRO_FAILURE": "霜冻又吞没了一名猎人。",
        "DROWRANGER_RELIC_TITLE": "专属装备",
        "DROWRANGER_PIKE_NAME": "飓风长戟",
        "DROWRANGER_PIKE_DESC": "普通攻击在<style=cIsUtility>50米</style>内造成全额伤害，<style=cIsUtility>100米</style>外仍保留<style=cIsDamage>75%的伤害</style>。命中<style=cIsUtility>12米</style>内的非首领敌人时，将其<style=cIsUtility>击退</style>。所有箭矢的飞行速度提高<style=cIsUtility>50%</style>。",
        "DROWRANGER_BUTTERFLY_NAME": "蝴蝶",
        "DROWRANGER_BUTTERFLY_DESC": "攻击速度提高<style=cIsDamage>20%</style>。获得<style=cIsHealing>30%的概率格挡受到的伤害</style>，可与艰难时光叠加，但收益递减。",
        "DROWRANGER_DAEDALUS_NAME": "代达罗斯之殇",
        "DROWRANGER_DAEDALUS_DESC": "暴击率提高<style=cIsDamage>30%</style>。暴击造成<style=cIsDamage>225%的伤害</style>，可叠加其他暴击伤害加成。",
        "DROWRANGER_PRIMARY_NAME": "霜冻之箭",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>霜冻</style>。射出一支箭矢，造成<style=cIsDamage>260%的伤害</style>。",
        "DROWRANGER_HYPOTHERMIA_NAME": "低温症",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>低温症</style>。射出一支箭矢，造成<style=cIsDamage>260%的伤害</style>。受影响的敌人死亡时会爆炸。",
        "DROWRANGER_SECONDARY_NAME": "数箭齐发",
        "DROWRANGER_SECONDARY_DESC": "连续射出<style=cIsDamage>3波</style>贯穿箭矢，合计造成<style=cIsDamage>3x360%的伤害</style>。每波施加所选箭矢的效果。攻击速度对引导速度的提升效果减半。",
        "DROWRANGER_UTILITY_NAME": "狂风",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>眩晕</style>。释放狂风，<style=cIsUtility>击退</style>前方敌人并施加<style=cIsUtility>3层</style>所选箭矢的效果。移动速度提高<style=cIsUtility>50%</style>，持续<style=cIsUtility>4秒</style>；非疾跑状态下施放时，自身向后跃起。",
        "DROWRANGER_GLACIER_NAME": "冰川",
        "DROWRANGER_GLACIER_DESC": "在脚下升起一座高耸的<style=cIsUtility>冰川</style>，将自身抬至顶部并<style=cIsUtility>击退</style>附近敌人。冰川持续<style=cIsUtility>8秒</style>。",
        "DROWRANGER_SPECIAL_NAME": "射手天赋",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>被动</style>：周围<style=cIsUtility>15米</style>内没有敌人时，普通攻击有<style=cIsDamage>30%</style>的概率射出<style=cIsDamage>破甲箭</style>，造成<style=cIsDamage>390%的伤害</style>。\n<style=cIsUtility>主动</style>：触发概率提高至<style=cIsDamage>100%</style>，持续<style=cIsUtility>5秒</style>；附近有敌人时为<style=cIsDamage>50%</style>。",
        "DROWRANGER_WINTER_NAME": "凛冬一击",
        "DROWRANGER_WINTER_DESC": "短暂蓄力后射出一支<style=cIsDamage>破甲箭</style>，造成<style=cIsDamage>1600%的伤害</style>，最多贯穿<style=cIsDamage>5名敌人</style>并施加<style=cIsUtility>10层</style>所选箭矢的效果。蓄力无法主动取消。",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>霜冻</style><style=cSub>每层使剩余移动速度降低15%，持续3秒。最多叠加10层，再次命中刷新持续时间。不会使敌人完全冻结。</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>低温症</style><style=cSub>持续7秒，最多叠加10层。死亡时依层数在2至12米内爆炸，造成150%至600%的伤害。爆炸会传播低温症并引发连爆。不会使敌人减速。</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>箭矢射程</style><style=cSub>普通攻击伤害在40米后逐渐衰减，80米外保留60%。飓风长戟可延长有效射程。</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>破甲箭</style><style=cSub>无视敌人的护甲加成。可以暴击，并保留所选箭矢的效果。</style>"
    },
    "ja": {
        "DROWRANGER_NAME": "ドロウ・レンジャー",
        "DROWRANGER_SUBTITLE": "霜の射手",
        "DROWRANGER_SKIN_DEFAULT_NAME": "ドロウ・レンジャー",
        "DROWRANGER_SKIN_ARCANA_NAME": "ドレッド・レトリビューション",
        "DROWRANGER_DESCRIPTION": "ドロウ・レンジャーは、敵との間合いを制し、致命的な矢で敵の防御を貫くことを得意とする射手です。<style=cSub>\n\n< ! >マークスマンシップの威力を最大限に引き出すため、敵とは距離を保ちましょう。放たれる矢の弾速は遅いため、遠くの標的を狙う際は慎重に狙いを定めてください。\n\n< ! >フロストアローは危険な敵の足を遅らせ、低体温症は敵の群れに連鎖爆発を引き起こします。\n\n< ! >ガストで後退するスペースを作り、グレイシャーで一時的な有利ポジションを確保しましょう。\n\n< ! >射程、生存能力、クリティカルのいずれかを強化する専用遺物を選びましょう。</style>",
        "DROWRANGER_OUTRO_FLAVOR": "トラクセスは凍てついた荒野を後にした。",
        "DROWRANGER_OUTRO_FAILURE": "霜がまた一人、狩人を呑み込んだ。",
        "DROWRANGER_RELIC_TITLE": "専用遺物",
        "DROWRANGER_PIKE_NAME": "ハリケーン・パイク",
        "DROWRANGER_PIKE_DESC": "メイン攻撃の矢は<style=cIsUtility>50m</style>以内であれば全ダメージを与え、<style=cIsUtility>100m</style>以遠でも<style=cIsDamage>75%</style>を維持する。<style=cIsUtility>12m</style>以内のボス以外の敵に命中すると<style=cIsUtility>ノックバック</style>させる。すべての矢の射出速度が<style=cIsUtility>50%上昇</style>する。",
        "DROWRANGER_BUTTERFLY_NAME": "バタフライ",
        "DROWRANGER_BUTTERFLY_DESC": "攻撃速度が<style=cIsDamage>20%</style>上昇する。<style=cIsHealing>30%の確率でダメージをブロック</style>する効果を得る。『苦難の時』と重複するが、効果は逓減する。",
        "DROWRANGER_DAEDALUS_NAME": "ダイダロス",
        "DROWRANGER_DAEDALUS_DESC": "<style=cIsDamage>クリティカル率が30%</style>上昇する。クリティカル発生時、他のクリティカルダメージ補正が適用される前に<style=cIsDamage>225%のダメージ</style>を与える。",
        "DROWRANGER_PRIMARY_NAME": "フロストアロー",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>フロスト</style>。矢を放ち、<style=cIsDamage>260%のダメージ</style>を与える。",
        "DROWRANGER_HYPOTHERMIA_NAME": "低体温症",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>低体温症</style>。矢を放ち、<style=cIsDamage>260%のダメージ</style>を与える。影響を受けた敵は死亡時に爆発する。",
        "DROWRANGER_SECONDARY_NAME": "マルチショット",
        "DROWRANGER_SECONDARY_DESC": "貫通する矢を<style=cIsDamage>3斉射</style>放ち、<style=cIsDamage>3x360%のダメージ</style>を与える。斉射ごとに選択中の矢の効果を付与する。攻撃速度は半分の効率でチャネリング時間を短縮する。",
        "DROWRANGER_UTILITY_NAME": "ガスト",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>スタン</style>。突風を放って<style=cIsUtility>敵をノックバック</style>させ、選択中の矢の効果を<style=cIsUtility>3スタック</style>付与する。<style=cIsUtility>4秒間</style>、<style=cIsUtility>移動速度が50%上昇</style>し、ダッシュ中でない場合は後方に跳躍する。",
        "DROWRANGER_GLACIER_NAME": "グレイシャー",
        "DROWRANGER_GLACIER_DESC": "足元にそびえ立つ<style=cIsUtility>氷河</style>を<style=cIsUtility>8秒間</style>隆起させ、自身をその頂上へ押し上げて<style=cIsUtility>周囲の敵をノックバック</style>させる。",
        "DROWRANGER_SPECIAL_NAME": "マークスマンシップ",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>パッシブ</style>：<style=cIsUtility>15m</style>以内に敵がいない場合、メイン攻撃の矢が<style=cIsDamage>30%</style>の確率で<style=cIsDamage>徹甲矢</style>となり、<style=cIsDamage>390%のダメージ</style>を与える。\n<style=cIsUtility>発動</style>：<style=cIsUtility>5秒間</style>、この確率が<style=cIsDamage>100%</style>に上昇する（周囲に敵がいる場合は<style=cIsDamage>50%</style>）。",
        "DROWRANGER_WINTER_NAME": "ウィンターストライク",
        "DROWRANGER_WINTER_DESC": "短く力を溜めた後、<style=cIsDamage>徹甲矢</style>を放って<style=cIsDamage>1600%のダメージ</style>を与え、最大<style=cIsDamage>5体の敵</style>を貫通して選択中の矢の効果を<style=cIsUtility>10スタック</style>付与する。溜めを任意でキャンセルすることはできない。",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>フロスト</style><style=cSub>3秒間、スタックごとに残りの移動速度を15%低下させる。最大10回まで重複可能。命中時に全スタックの持続時間をリセットする。敵を氷結させることはない。</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>低体温症</style><style=cSub>7秒間持続し、最大10回までスタック可能。死亡時、スタック数に応じて2～12mの範囲に150%～600%のダメージを与える爆発を起こす。爆発は低体温症を拡散させ、誘爆可能。敵を減速させることはない。</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>矢の有効射程</style><style=cSub>メイン攻撃の矢のダメージは40mを超えると減衰し、80mで60%を維持する。ハリケーン・パイクはこの射程を延長する。</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>徹甲矢</style><style=cSub>正のアーマー値を無視する。クリティカルが可能で、選択中の矢の効果を維持する。</style>"
    },
    "ko": {
        "DROWRANGER_NAME": "드로우 레인저",
        "DROWRANGER_SUBTITLE": "서리 궁수",
        "DROWRANGER_SKIN_DEFAULT_NAME": "드로우 레인저",
        "DROWRANGER_SKIN_ARCANA_NAME": "공포의 응징",
        "DROWRANGER_DESCRIPTION": "드로우 레인저는 거리를 조절하고 치명적인 화살로 적의 방어선을 꿰뚫는 데 특화된 궁수입니다.<style=cSub>\n\n< ! >명사수의 효율을 극대화하려면 적과의 거리를 유지하세요. 화살의 비행 속도가 느리므로 먼 거리의 목표를 맞히려면 신중하게 조준해야 합니다.\n\n< ! >얼음 화살은 위험한 적을 둔화시킵니다. 저체온증은 적 무리를 연쇄 폭발로 몰아넣습니다.\n\n< ! >돌풍으로 후퇴할 공간을 확보하고, 빙하를 생성해 임시 고지대를 확보하세요.\n\n< ! >사거리, 생존력 또는 치명타를 강화할 전용 유물을 선택하세요.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "트랙시스는 얼어붙은 황무지를 뒤로하고 떠났다.",
        "DROWRANGER_OUTRO_FAILURE": "서리가 또 다른 사냥꾼을 집어삼켰다.",
        "DROWRANGER_RELIC_TITLE": "전용 유물",
        "DROWRANGER_PIKE_NAME": "허리케인 파이크",
        "DROWRANGER_PIKE_DESC": "기본 화살이 <style=cIsUtility>50m</style> 이내에서는 최대 피해를 주며, <style=cIsUtility>100m</style> 이상에서도 <style=cIsDamage>75%</style>의 피해량을 유지합니다. <style=cIsUtility>12m</style> 이내의 보스가 아닌 적에게 적중 시 <style=cIsUtility>밀쳐냅니다</style>. 모든 화살 투사체의 비행 속도가 <style=cIsUtility>50% 증가</style>합니다.",
        "DROWRANGER_BUTTERFLY_NAME": "나비검",
        "DROWRANGER_BUTTERFLY_DESC": "공격 속도가 <style=cIsDamage>20%</style> 증가합니다. <style=cIsHealing>30% 확률로 피해를 차단</style>합니다. '힘들었던 시절'과 중첩되지만 점감 효과가 적용됩니다.",
        "DROWRANGER_DAEDALUS_NAME": "다이달로스",
        "DROWRANGER_DAEDALUS_DESC": "<style=cIsDamage>치명타 확률이 30%</style> 증가합니다. 치명타 발생 시 다른 치명타 피해 보너스가 적용되기 전에 <style=cIsDamage>225%의 피해</style>를 입힙니다.",
        "DROWRANGER_PRIMARY_NAME": "얼음 화살",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>서리</style>. 화살을 발사하여 <style=cIsDamage>260%의 피해</style>를 줍니다.",
        "DROWRANGER_HYPOTHERMIA_NAME": "저체온증",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>저체온증</style>. 화살을 발사하여 <style=cIsDamage>260%의 피해</style>를 줍니다. 걸린 적은 사망 시 폭발합니다.",
        "DROWRANGER_SECONDARY_NAME": "다중 발사",
        "DROWRANGER_SECONDARY_DESC": "관통 화살을 <style=cIsDamage>3회 연속 발사</style>하여 <style=cIsDamage>3x360%의 피해</style>를 줍니다. 매 발사마다 선택한 화살 효과를 적용합니다. 공격 속도는 절반의 효율로 집중 시간을 단축합니다.",
        "DROWRANGER_UTILITY_NAME": "돌풍",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>기절</style>. 돌풍을 일으켜 <style=cIsUtility>적을 밀쳐내고</style> 선택한 화살 효과를 <style=cIsUtility>3회 중첩</style> 적용합니다. <style=cIsUtility>4초</style> 동안 <style=cIsUtility>이동 속도가 50% 증가</style>하며, 전력 질주 중이 아니면 뒤로 도약합니다.",
        "DROWRANGER_GLACIER_NAME": "빙하",
        "DROWRANGER_GLACIER_DESC": "발밑에 <style=cIsUtility>8초</style> 동안 우뚝 솟은 <style=cIsUtility>빙하</style>를 생성하여 정상으로 자신을 들어 올리고 <style=cIsUtility>주변 적을 밀쳐냅니다</style>.",
        "DROWRANGER_SPECIAL_NAME": "명사수",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>기본 지속 효과</style>: <style=cIsUtility>15m</style> 이내에 적이 없으면 기본 화살이 <style=cIsDamage>30%</style> 확률로 <style=cIsDamage>철갑 화살</style>이 되어 <style=cIsDamage>390%의 피해</style>를 줍니다.\n<style=cIsUtility>사용 시</style>: <style=cIsUtility>5초</style> 동안 이 확률이 <style=cIsDamage>100%</style>로 증가하며, 주변에 적이 있으면 <style=cIsDamage>50%</style>가 됩니다.",
        "DROWRANGER_WINTER_NAME": "겨울의 일격",
        "DROWRANGER_WINTER_DESC": "잠시 힘을 모은 후 <style=cIsDamage>철갑 화살</style>을 발사하여 <style=cIsDamage>1600%의 피해</style>를 입히고 최대 <style=cIsDamage>5명의 적</style>을 관통하며 선택한 화살 효과를 <style=cIsUtility>10회 중첩</style> 적용합니다. 힘을 모으는 중에는 임의로 취소할 수 없습니다.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>서리</style><style=cSub>3초 동안 중첩당 남은 이동 속도를 15% 감소시킵니다. 최대 10회까지 중첩됩니다. 적중 시 모든 중첩을 갱신합니다. 적을 빙결시키지는 않습니다.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>저체온증</style><style=cSub>7초 동안 지속되며 최대 10회까지 중첩됩니다. 사망 시 중첩 수에 따라 2~12m 반경에 150%~600%의 피해를 입히는 폭발을 일으킵니다. 폭발은 저체온증을 퍼뜨리며 연쇄 폭발을 일으킬 수 있습니다. 적을 느려지게 하지는 않습니다.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>화살 사거리</style><style=cSub>기본 화살의 피해는 40m 이후 감소하며 80m에서 60%를 유지합니다. 허리케인 파이크는 이 사거리를 연장합니다.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>철갑 화살</style><style=cSub>양의 방어력을 무시합니다. 치명타가 발생할 수 있으며 선택한 화살 효과를 유지합니다.</style>"
    },
    "tr": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Ayaz Okçusu",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Korkunç İntikam",
        "DROWRANGER_DESCRIPTION": "Drow Ranger, mesafeyi koruma ve ölümcül oklarıyla düşman savunmalarını yarma konusunda ustalaşmıştır.<style=cSub>\n\n< ! >Nişancılık yeteneğinden en iyi şekilde yararlanmak için düşmanları uzakta tutun. Okları yavaş ilerler, bu yüzden uzaktaki hedefleri vurmak için dikkatli nişan alın.\n\n< ! >Buz Okları tehlikeli düşmanları yavaşlatır. Hipotermi ise kalabalıkları zincirleme patlamalara dönüştürür.\n\n< ! >Şiddetli Rüzgâr geri çekilmek için alan yaratırken, Buzul geçici bir gözetleme noktası sağlar.\n\n< ! >Menzilinizi, hayatta kalma kabiliyetinizi veya kritik vuruşlarınızı geliştirmek için özel bir yadigâr seçin.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex donmuş çorak toprakları geride bıraktı.",
        "DROWRANGER_OUTRO_FAILURE": "Ayaz bir avcının daha canını aldı.",
        "DROWRANGER_RELIC_TITLE": "Özel Yadigâr",
        "DROWRANGER_PIKE_NAME": "Kasırga Mızrağı",
        "DROWRANGER_PIKE_DESC": "Birincil oklar <style=cIsUtility>50m</style> içinde tam hasar verir, <style=cIsUtility>100m</style> ötesinde ise <style=cIsDamage>%75</style> hasarı korur. İsabetler, <style=cIsUtility>12m</style> içindeki boss olmayan düşmanları <style=cIsUtility>geri savurur</style>. Tüm ok mermileri <style=cIsUtility>%50 daha hızlı</style> ilerler.",
        "DROWRANGER_BUTTERFLY_NAME": "Kelebek",
        "DROWRANGER_BUTTERFLY_DESC": "Saldırı hızını <style=cIsDamage>%20</style> artırır. <style=cIsHealing>Hasarı engellemek için %30 şans</style> kazandırır. Zor Zamanlar ile azalan getiriyle birikir.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "<style=cIsDamage>%30 kritik vuruş şansı</style> kazandırır. Kritik vuruşlar, diğer kritik hasar bonuslarından önce <style=cIsDamage>%225 hasar</style> verir.",
        "DROWRANGER_PRIMARY_NAME": "Buz Okları",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Ayaz</style>. <style=cIsDamage>%260 hasar</style> veren bir ok fırlatın.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Hipotermi",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Hipotermi</style>. <style=cIsDamage>%260 hasar</style> veren bir ok fırlatın. Etkilenen düşmanlar öldüklerinde patlar.",
        "DROWRANGER_SECONDARY_NAME": "Çoklu Ok",
        "DROWRANGER_SECONDARY_DESC": "<style=cIsDamage>3x%360 hasar</style> veren delici oklardan oluşan <style=cIsDamage>3 dalga</style> fırlatın. Her dalga seçili ok etkinizi uygular. Saldırı hızı, yarı verimlilikle odaklanma süresini kısaltır.",
        "DROWRANGER_UTILITY_NAME": "Şiddetli Rüzgâr",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Sersemletici</style>. <style=cIsUtility>Düşmanları geri savuran</style> ve ok etkinizden <style=cIsUtility>3 yük</style> uygulayan bir rüzgâr dalgası salın. <style=cIsUtility>4 saniyeliğine</style> <style=cIsUtility>%50 hareket hızı</style> kazanın; depar atmıyorsanız geriye doğru sıçrayın.",
        "DROWRANGER_GLACIER_NAME": "Buzul",
        "DROWRANGER_GLACIER_DESC": "Altınızda <style=cIsUtility>8 saniye</style> boyunca yükselen bir <style=cIsUtility>buzul</style> oluşturarak sizi zirvesine çıkarın ve <style=cIsUtility>yakındaki düşmanları geri savurun</style>.",
        "DROWRANGER_SPECIAL_NAME": "Nişancılık",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Pasif</style>: <style=cIsUtility>15m</style> içinde düşman yoksa, birincil okların <style=cIsDamage>%390 hasar</style> veren <style=cIsDamage>zırh delici oklara</style> dönüşme şansı <style=cIsDamage>%30</style>'dur.\n<style=cIsUtility>Etkinleştir</style>: <style=cIsUtility>5 saniyeliğine</style> bu şansı <style=cIsDamage>%100</style>'e, yakında düşman varsa <style=cIsDamage>%50</style>'ye çıkarır.",
        "DROWRANGER_WINTER_NAME": "Kış Saldırısı",
        "DROWRANGER_WINTER_DESC": "Kısa bir hazırlığın ardından en fazla <style=cIsDamage>5 düşmanı</style> delip geçen ve ok etkinizden <style=cIsUtility>10 yük</style> uygulayarak <style=cIsDamage>%1600 hasar</style> veren bir <style=cIsDamage>zırh delici ok</style> fırlatın. Hazırlık isteğe bağlı olarak iptal edilemez.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Ayaz</style><style=cSub>3 saniyeliğine yük başına kalan hareket hızını %15 azaltır. En fazla 10 defa birikir. İsabetler tüm yükleri yeniler. Düşmanları dondurmaz.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Hipotermi</style><style=cSub>7 saniye boyunca en fazla 10 defa birikir. Ölüm anında yüklere bağlı olarak 2-12m yarıçapta %150–%600 hasar veren bir patlama oluşturur. Patlamalar Hipotermi yayar ve zincirleme tetiklenebilir. Düşmanları yavaşlatmaz.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Ok menzili</style><style=cSub>Birincil ok hasarı 40m'nin ötesinde düşer ve 80m'de %60'ını korur. Kasırga Mızrağı bu menzili uzatır.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Zırh delici ok</style><style=cSub>Pozitif zırhı yok sayar. Kritik vuruş yapabilir ve seçilen ok etkisini korur.</style>"
    }
}