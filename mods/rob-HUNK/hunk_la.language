    "ROB_HUNK_NEMESIS_ACHIEVEMENT_DESC": "Nemesis T-Type neca.",
    "ROB_NEMESIS_BODY_PASSIVE_NAME": "Forma Vitae Ultima",
    "ROB_NEMESIS_BODY_PASSIVE_DESCRIPTION": "<style=cIsDamage>Damnum inferre</style> <style=cIsHealth>Biomassam</style> recondit, <style=cIsDamage>damnum</style> tuum augens cum plena est. Saltus <style=cIsDamage>onerari</style> possunt pro <style=cIsUtility>ingentibus saltibus</style>.",
    "ROB_NEMESIS_BODY_PASSIVE2_NAME": "Armatura Biologica",
    "ROB_NEMESIS_BODY_PASSIVE2_DESCRIPTION": "Nemesis T-Type <style=cIsHealth>mutari</style> potest <style=cIsDamage>personas magni momenti</style> devorando, <style=cIsDamage>artes novas et amplificatas</style> obtinens.",
    "ROB_NEMESIS_BODY_PASSIVE22_NAME": "Augmentum Massae Muscularis",
    "ROB_NEMESIS_BODY_PASSIVE22_DESCRIPTION": "<style=cIsUtility>Impetus comminus</style> <style=cIsDamage>20%</style> plus damni inferunt, <style=cIsHealth>SED socii damnum accipere possunt</style>.",
    "ROB_NEMESIS_BODY_MELEE_NAME": "Impetus Brutalis",
    "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Pugno feri pro <style=cIsDamage>350% damni</style>. Utere dum <style=cIsUtility>immotus stas</style> ut calces pro <style=cIsDamage>800% damni</style>. Utere dum <style=cIsUtility>curris</style> ut in hostem irrumpas pro <style=cIsDamage>600% damni</style>.",
    "ROB_NEMESIS_BODY_GRAB_NAME": "Tactus Letalis",
    "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Hostem prehende. Primaria utere ut eum devores et 10% maximae valetudinis sanes, vel Secundaria ut iactum usque ad 2400% damni oneres.",
    "ROB_NEMESIS_BODY_DASH_NAME": "Impetus Biopericuli",
    "ROB_NEMESIS_BODY_DASH_DESCRIPTION": "Utere dum <style=cIsUtility>in aere es</style> ut per aerem <style=cIsDamage>semel</style> impellas.",
    "ROB_NEMESIS_BODY_ULTIMATE_NAME": "Massa Critica",
    "ROB_NEMESIS_BODY_ULTIMATE_DESCRIPTION": "Tene ut <style=cIsHealth>Biomassam</style> lente consumas, usque ad <style=cIsHealing>100% maximae valetudinis</style> restituens.",
    "ROB_NEMESIS_BODY_DEFAULT_SKIN_NAME": "Defalta",
    "ROB_NEMESIS_BODY_CLASSIC_SKIN_NAME": "Classica",
    "ROB_NEMESIS_BODY_VENOM_SKIN_NAME": "Symbiotes",
    "ROB_NEMESIS_BODY_SUPER_SKIN_NAME": "<color=#FFFF00>Fautor Praecox</color>",
    "ROB_NEMESIS_BODY_MAHORAGA_SKIN_NAME": "Big Raga The Opp Stoppa",
    "ROB_NEMESIS_BODY_MINOS_SKIN_NAME": "Rex Hominum",
    "ROB_HUNK_ITEM_EFFECT_TITLE": "Effectus Additus",
    "ROB_HUNK_ITEM_EFFECT_BACKUPMAG": "Accipe <color=#00FF66>Munitionem Falsam</color> post recargationem felicem.",
    "ROB_HUNK_ITEM_EFFECT_BANDOLIER": "Fasciculi munitionis capsam tuam <color=#00FF66>Munitione Falsa</color> implent.",
    "ROB_HUNK_ITEM_EFFECT_ALIENHEAD": "Accipe <style=cIsUtility>plus munitionis</style> cum ullam colligis.",
    "ROB_HUNK_ITEM_EFFECT_BRAINSTALKS": "Dum activus est, sclopetum tuum emittere <style=cIsUtility>nullam munitionem consumit</style>.",
    "ROB_HUNK_ITEM_EFFECT_LYSATECELL": "Accipe <color=#00FF66>Munitionem Falsam</color> cum armum induis.",
    "ROB_HUNK_ITEM_EFFECT_PURITY": "Duplica <style=cIsUtility>magnitudinem capsae tuae</style>. Consumptio munitionis immutata manet.",
    "ROB_HUNK_ITEM_EFFECT_LUMINOUSSHOT": "Cumulum accipe postquam per <style=cIsUtility>1 secundum</style> intendisti. <style=cIsHealth>Omnes cumulos perdis cum iacularis aut intendere desinis.</style>",
    "ROB_NEMESIS_ITEM_EFFECT_TITLE": "Effectus Additus",
    "ROB_NEMESIS_ITEM_EFFECT_BANDOLIER": "Fasciculi munitionis <style=cIsHealth>10% Biomassae</style> restituunt.",
    "ROB_NEMESIS_ITEM_EFFECT_ALIENHEAD": "Auget <style=cIsHealth>Biomassam</style> acceptam hostes <style=cIsDamage>devorando</style>.",
    "ROB_NEMESIS_ITEM_EFFECT_BRAINSTALKS": "Dum activus est, <style=cIsHealth>Biomassa</style> <style=cIsUtility>infinita</style> est.",
    "ROB_NEMESIS_ITEM_EFFECT_PURITY": "Auget <style=cIsHealth>Biomassam</style> acceptam <style=cIsDamage>in ictu</style>.",
    "ROB_HUNK_JETPACK_NAME": "Propulsor Saltus Experimentalis",
    "ROB_HUNK_JETPACK_DESC": "Instrumentum ab Umbrella fabricatum quod tibi permittit te ipsum in quamlibet directionem propellere saltum in medio aere premendo.",
    "ROB_HUNK_SURVIVALKIT_NAME": "Sarcina Supervivendi Emergentis",
    "ROB_HUNK_SURVIVALKIT_DESC": "Sarcina supervivendi quae et facultatem tuam munitionem perscrutandi et efficaciam cultri tui auget.",
    "ROB_HUNK_TRANSCEIVER_NAME": "Transceptor Tritus",
    "ROB_HUNK_TRANSCEIVER_DESC": "Commilitonem advocat qui te in operatione tua adiuvet.",
    "ROB_HUNK_INFROCKET_NAME": "ATM-4",
    "ROB_HUNK_INFROCKET_DESC": "Emissor rochettarum cum <style=cIsHealing>munitione infinita</style>. Praemium pro re gesta <color=#FFFF00>Fautor Praecox</color>.",
    "ROB_HUNK_SPADE_KEYCARD_NAME": "Tessera U.C. (Pica)",
    "ROB_HUNK_CLUB_KEYCARD_NAME": "Tessera U.C. (Trifolium)",
    "ROB_HUNK_HEART_KEYCARD_NAME": "Tessera U.C. (Cor)",
    "ROB_HUNK_DIAMOND_KEYCARD_NAME": "Tessera U.C. (Rhombus)",
    "ROB_HUNK_GOLD_KEYCARD_NAME": "Tessera U.C. (Stella)",
    "ROB_HUNK_MASTER_KEYCARD_NAME": "Tessera U.C. (Magistra)",
    "ROB_HUNK_KEYCARD_DESC": "Adhibetur ad <style=cIsUtility>capsas armorum</style> <color=#C80202>Umbrella Corporation</color> aperiendas.",
    "ROB_HUNK_KEYCARD_MASTER_DESC": "Adhibetur ad <style=cIsUtility>capsas armorum</style> <color=#C80202>Umbrella Corporation</color> aperiendas. <style=cIsHealing>Omnes capsas</style> aperit et alias tesseras in <style=cIsUtility>ferramenta</style> vertit.",
    "ROB_HUNK_WRISTBAND_NAME": "Armilla Identitatis",
    "ROB_HUNK_WRISTBAND_DESC": "Clavis electronica ad usum in officinis <color=#C80202>Umbrella Corporation</color>. Adhibetur ad <style=cIsUtility>capsam armorum specialem</style> aperiendam.",
    "ROB_HUNK_TYPEWRITER_NAME": "Machina Scriptoria",
    "ROB_HUNK_TYPEWRITER_DESC": "Accipe <style=cIsUtility>2</style> <style=cIsUtility>capsas armorum</style> additas <color=#C80202>Umbrella Corporation</color> per gradum.",
    "ROB_HUNK_CRYSTALSKULL_NAME": "Cranium Crystallinum",
    "ROB_HUNK_CRYSTALSKULL_DESC": "Thesaurus rarus. In quodlibet <style=cIsUtility>Aenum</style> inseri potest ut unam rem accipias.",
    "ROB_HUNK_STARSBADGE_NAME": "Insigne S.T.A.R.S.",
    "ROB_HUNK_STARSBADGE2_NAME": "Clavis USB Dongle",
    "ROB_HUNK_STARSBADGE_DESC": "Insigne speciale divisionis copiarum specialium R.P.D., <color=#F20443>S.T.A.R.S.</color> <style=cIsHealth>Fortasse hoc tollere malum consilium fuit?</style>",
    "ROB_HUNK_STARSBADGE_DESCFULL": "In quoque gradu apparet arca specialis <color=#F20443>S.T.A.R.S.</color> quae tantum hoc insigni aperiri potest. Attamen, <style=cIsHealth>Nemesis T-Type</style> te sine intermissione venabitur.",
    "ROB_HUNK_STARSBADGE2_DESC": "Adhibetur ad <style=cIsUtility>arcam specialem</style> in quoque gradu aperiendam.",
    "ROB_HUNK_STARSBADGE2_DESCFULL": "In quoque gradu apparet arca specialis <color=#F20443>S.T.A.R.S.</color> quae tantum hoc insigni aperiri potest. Attamen, <style=cIsHealth>Nemesis T-Type</style> te sine intermissione venabitur.",
    "ROB_HUNK_G_VIRUS_SAMPLE_NAME": "Specimen G-Virus",
