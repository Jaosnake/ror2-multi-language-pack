    "ROB_HUNK_NEMESIS_ACHIEVEMENT_DESC": "Kill the Nemesis T-Type.",
    "ROB_NEMESIS_BODY_PASSIVE_NAME": "Ultimate Lifeform",
    "ROB_NEMESIS_BODY_PASSIVE_DESCRIPTION": "<style=cIsDamage>Dealing damage</style> stores <style=cIsHealth>Biomass</style>, boosting your <style=cIsDamage>damage</style> when full. Jumps can be <style=cIsDamage>charged</style> for <style=cIsUtility>mighty leaps</style>.",
    "ROB_NEMESIS_BODY_PASSIVE2_NAME": "Biological Weaponry",
    "ROB_NEMESIS_BODY_PASSIVE2_DESCRIPTION": "The Nemesis T-Type can <style=cIsHealth>mutate</style> by consuming <style=cIsDamage>persons of interest</style>, gaining <style=cIsDamage>new and upgraded abilities</style>.",
    "ROB_NEMESIS_BODY_PASSIVE22_NAME": "Muscle Mass Boost",
    "ROB_NEMESIS_BODY_PASSIVE22_DESCRIPTION": "<style=cIsUtility>Melee attacks</style> deal <style=cIsDamage>20%</style> more damage, <style=cIsHealth>BUT allies can take damage</style>.",
    "ROB_NEMESIS_BODY_MELEE_NAME": "Brutal Assault",
    "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Punch for <style=cIsDamage>350% damage</style>. Use while <style=cIsUtility>standing still</style> to stomp for <style=cIsDamage>800% damage</style>. Use while <style=cIsUtility>sprinting</style> to tackle for <style=cIsDamage>600% damage</style>.",
    "ROB_NEMESIS_BODY_GRAB_NAME": "Deadly Reach",
    "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Grab an enemy. Use Primary to consume them and heal 10% max health, or Secondary to charge a throw for up to 2400% damage.",
    "ROB_NEMESIS_BODY_DASH_NAME": "Biohazard Rush",
    "ROB_NEMESIS_BODY_DASH_DESCRIPTION": "Use while <style=cIsUtility>airborne</style> to airdash <style=cIsDamage>once</style>.",
    "ROB_NEMESIS_BODY_ULTIMATE_NAME": "Critical Mass",
    "ROB_NEMESIS_BODY_ULTIMATE_DESCRIPTION": "Hold to slowly consume <style=cIsHealth>Biomass</style>, restoring up to <style=cIsHealing>100% max health</style>.",
    "ROB_NEMESIS_BODY_DEFAULT_SKIN_NAME": "Default",
    "ROB_NEMESIS_BODY_CLASSIC_SKIN_NAME": "Classic",
    "ROB_NEMESIS_BODY_VENOM_SKIN_NAME": "Symbiote",
    "ROB_NEMESIS_BODY_SUPER_SKIN_NAME": "<color=#FFFF00>Early Supporter</color>",
    "ROB_NEMESIS_BODY_MAHORAGA_SKIN_NAME": "Big Raga The Opp Stoppa",
    "ROB_NEMESIS_BODY_MINOS_SKIN_NAME": "King of Men",
    "ROB_HUNK_ITEM_EFFECT_TITLE": "Bonus Effect",
    "ROB_HUNK_ITEM_EFFECT_BACKUPMAG": "Gain <color=#00FF66>Fake Ammo</color> after a successful reload.",
    "ROB_HUNK_ITEM_EFFECT_BANDOLIER": "Ammo packs refill your magazine with <color=#00FF66>Fake Ammo</color>.",
    "ROB_HUNK_ITEM_EFFECT_ALIENHEAD": "Gain <style=cIsUtility>more ammo</style> when picking any up.",
    "ROB_HUNK_ITEM_EFFECT_BRAINSTALKS": "While active, firing your gun <style=cIsUtility>consumes no ammo</style>.",
    "ROB_HUNK_ITEM_EFFECT_LYSATECELL": "Gain <color=#00FF66>Fake Ammo</color> when equipping a weapon.",
    "ROB_HUNK_ITEM_EFFECT_PURITY": "Double your <style=cIsUtility>magazine size</style>. Ammo consumption is unchanged.",
    "ROB_HUNK_ITEM_EFFECT_LUMINOUSSHOT": "Gain a stack after aiming for <style=cIsUtility>1 second</style>. <style=cIsHealth>Lose all stacks when you shoot or stop aiming.</style>",
    "ROB_NEMESIS_ITEM_EFFECT_TITLE": "Bonus Effect",
    "ROB_NEMESIS_ITEM_EFFECT_BANDOLIER": "Ammo packs restore <style=cIsHealth>10% Biomass</style>.",
    "ROB_NEMESIS_ITEM_EFFECT_ALIENHEAD": "Boost <style=cIsHealth>Biomass</style> gained when <style=cIsDamage>consuming</style> enemies.",
    "ROB_NEMESIS_ITEM_EFFECT_BRAINSTALKS": "While active, <style=cIsHealth>Biomass</style> is <style=cIsUtility>unlimited</style>.",
