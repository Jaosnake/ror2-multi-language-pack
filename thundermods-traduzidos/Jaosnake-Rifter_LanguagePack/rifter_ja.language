        "BLAKE_NEM_RIFTER_UTILITY_PRESTIGE_SLIPSTREAM": "プレステージ・スリップストリーム",
        "BLAKE_NEM_RIFTER_UTILITY_SLIPSTREAM_DESCRIPTION": "短距離テレポート。セカンダリースキルのストックを回復する。",
        "BLAKE_NEM_RIFTER_SPECIAL_TIMELOCK": "タイムロック",
