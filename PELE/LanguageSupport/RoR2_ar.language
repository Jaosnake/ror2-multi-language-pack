    "FLAMEDRONE_BODY_NAME": "طائرة إحراق مسيّرة",
    "EMERGENCYDRONE_BODY_NAME": "طائرة طوارئ مسيّرة",
    "DRONE_COMMANDER_BODY_NAME": "العقيد درونمان",
    "TURRET1_BODY_NAME": "برج رشاش",
    "ENGITURRET_BODY_NAME": "برج Engineer",
    "POT2_BODY_NAME": "قدر",
    "FUSIONCELL_BODY_NAME": "خلية اندماج",
    "SQUIDTURRET_BODY_NAME": "برج حبار",
    "POTMOBILE_BODY_NAME": "عربة القدور",
    "SHOPKEEPER_BODY_NAME": "سمندل",
    "URCHINTURRET_BODY_NAME": "قنفذ مالاكيت",
    "SKILL_LUNAR_PRIMARY_REPLACEMENT_NAME": "نظرة جائعة",
    "SKILL_LUNAR_PRIMARY_REPLACEMENT_DESCRIPTION": "أطلق وابلًا من <style=cIsUtility>الشظايا المتعقّبة</style> التي تنفجر بعد مهلة، مُلحقةً <style=cIsDamage>120% ضررًا</style>.",
    "SKILL_LUNAR_SECONDARY_REPLACEMENT_NAME": "دوّامة التقطيع",
    "SKILL_LUNAR_SECONDARY_REPLACEMENT_DESCRIPTION": "اشحن كرة من النصال تُلحق ضررًا متكررًا بمقدار <style=cIsDamage>175%</style>. بعد مهلة، تنفجر و<style=cIsDamage>تُثبّت</style> جميع الأعداء مقابل <style=cIsDamage>700%</style> ضررًا.",
    "SKILL_LUNAR_UTILITY_REPLACEMENT_NAME": "تلاشي الظل",
    "SKILL_LUNAR_UTILITY_REPLACEMENT_DESCRIPTION": "تلاشَ لتصبح <style=cIsUtility>غير مادي</style> و<style=cIsUtility>تكتسب سرعة حركة</style>. <style=cIsHealing>تُشفى</style> بمقدار <style=cIsHealing>25% من صحتك القصوى</style>.",
    "SKILL_LUNAR_SPECIAL_REPLACEMENT_NAME": "خراب",
    "SKILL_LUNAR_SPECIAL_REPLACEMENT_DESCRIPTION": "إلحاق الضرر يضيف تكديسًا من الخراب. يؤدي تفعيل المهارة إلى تفجير جميع تكديسات الخراب من مدى غير محدود، مُلحقًا 300% ضررًا إضافةً إلى 120% ضررًا لكل تكديس من الخراب.",
