        "MINER_TUNDRAUNLOCKABLE_ACHIEVEMENT_DESC": "Ut Miner, perveni ad Rallypoint Delta intra minus quam 8 minuta.",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Temperatus",
        "MINER_BLACKSMITHUNLOCKABLE_UNLOCKABLE_NAME": "Miner: Temperatus",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_DESC": "Ut Miner, instrumentum ferrarii in planeta reperi.",
        "FATACRID_BODY_NAME": "Perro Grande",
        "FATACRID_BODY_SUBTITLE": "(Forma Gigante)",
        "DIGGERPLUGIN_DIRESEEKER_BODY_NAME": "Direseeker",
        "DIGGERPLUGIN_DIRESEEKER_BODY_SUBTITLE": "Vestigatio et Caedes",
        "DIGGERPLUGIN_DIRESEEKER_BODY_LORE": "Fabulae narrant de belua monstruosa quae olim per castra subterranea Petrichor V vagabatur.\n\nA fortissimis superstitibus et foedissimis monstris formidata, belua ingens aequari non poterat. Squamis sanguineis induta erat, inferni igne temperatis. Oculos flavos ardentesque habebat, quorum conspectus tam vehemens erat ut maximas creaturas repente sisteret. Halitum fumantem habebat, satis calidum ut metallum momento funderet.\n\nSemel tantum a superstite satis forti ad ipsum Providence interficiendum retenta, credebatur beluam tandem parem suum convenisse.\n\n<style=cIsHealth>Donec faciem suam terrificam iterum ostendit.</style>",
        "DIGGERPLUGIN_DIRESEEKER_BODY_OUTRO_FLAVOR": "..et ita discessit, novam praedam quaerens.",
        "DIGGERPLUGIN_DIRESEEKER_BODY_DEFAULT_SKIN_NAME": "Defalta"
    }
