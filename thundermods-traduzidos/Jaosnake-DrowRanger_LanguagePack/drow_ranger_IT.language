{
    "IT": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Arciera del gelo",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Terribile retribuzione",
        "DROWRANGER_DESCRIPTION": "Drow Ranger eccelle nel controllare la distanza e nello spezzare le difese nemiche con frecce letali.<style=cSub>\n\n< ! >Tieni i nemici a distanza per sfruttare al meglio Precisione di tiro. I suoi dardi viaggiano lentamente, quindi mira con cura per colpire bersagli distanti.\n\n< ! >Frecce di ghiaccio rallenta i nemici pericolosi. Ipotermia trasforma le orde in esplosioni a catena.\n\n< ! >Folata crea spazio per ritirarsi, mentre Ghiacciaio offre una posizione sopraelevata temporanea.\n\n< ! >Scegli una reliquia esclusiva per migliorare gittata, sopravvivenza o colpi critici.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex si lascia alle spalle le distese gelate.",
        "DROWRANGER_OUTRO_FAILURE": "Il gelo reclama un altro cacciatore.",
        "DROWRANGER_RELIC_TITLE": "Reliquia esclusiva",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Le frecce primarie infliggono danni completi entro <style=cIsUtility>50 m</style>, mantenendo il <style=cIsDamage>75%</style> oltre i <style=cIsUtility>100 m</style>. I colpi <style=cIsUtility>respingono</style> i nemici non-boss entro <style=cIsUtility>12 m</style>. Tutti i proiettili a freccia viaggiano il <style=cIsUtility>50% più velocemente</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Aumenta la velocità d'attacco del <style=cIsDamage>20%</style>. Ottieni una <style=cIsHealing>probabilità del 30% di bloccare i danni</style>. Si accumula con Tempi peggiori con rendimenti decrescenti.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Ottieni il <style=cIsDamage>30% di probabilità di colpo critico</style>. I colpi critici infliggono il <style=cIsDamage>225% di danni</style>, prima di altri bonus ai danni critici.",
        "DROWRANGER_PRIMARY_NAME": "Frecce di ghiaccio",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Gelo</style>. Scaglia una freccia per il <style=cIsDamage>260% di danni</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Ipotermia",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Ipotermia</style>. Scaglia una freccia per il <style=cIsDamage>260% di danni</style>. I nemici affetti esplodono alla morte.",
        "DROWRANGER_SECONDARY_NAME": "Tiro multiplo",
        "DROWRANGER_SECONDARY_DESC": "Scaglia <style=cIsDamage>3 ondate</style> di frecce perforanti per <style=cIsDamage>3x360% di danni</style>. Ogni ondata applica l'effetto della freccia selezionata. La velocità d'attacco accorcia la canalizzazione a metà dell'efficienza.",
        "DROWRANGER_UTILITY_NAME": "Folata",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Stordimento</style>. Rilascia una folata che <style=cIsUtility>respinge i nemici all'indietro</style> e applica <style=cIsUtility>3 accumuli</style> dell'effetto della tua freccia selezionata. Ottieni il <style=cIsUtility>50% di velocità di movimento</style> per <style=cIsUtility>4s</style> e salta all'indietro se non stai scattando.",
        "DROWRANGER_GLACIER_NAME": "Ghiacciaio",
        "DROWRANGER_GLACIER_DESC": "Innalza un imponente <style=cIsUtility>ghiacciaio</style> sotto di te per <style=cIsUtility>8s</style>, sollevandoti sulla sua cima e <style=cIsUtility>respingendo indietro i nemici vicini</style>.",
        "DROWRANGER_SPECIAL_NAME": "Precisione di tiro",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Passiva</style>: Senza nemici entro <style=cIsUtility>15 m</style>, le frecce primarie hanno una probabilità del <style=cIsDamage>30%</style> di diventare <style=cIsDamage>frecce perfora-corazza</style> per il <style=cIsDamage>390% di danni</style>.\n<style=cIsUtility>Attiva</style>: Aumenta questa probabilità al <style=cIsDamage>100%</style> per <style=cIsUtility>5s</style>, o al <style=cIsDamage>50%</style> con nemici vicini.",
        "DROWRANGER_WINTER_NAME": "Colpo d'inverno",
        "DROWRANGER_WINTER_DESC": "Prepara brevemente il tiro, poi scaglia una <style=cIsDamage>freccia perfora-corazza</style> per il <style=cIsDamage>1600% di danni</style>, perforando fino a <style=cIsDamage>5 nemici</style> e applicando <style=cIsUtility>10 accumuli</style> dell'effetto della tua freccia selezionata. La preparazione non può essere annullata volontariamente.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Gelo</style><style=cSub>Riduce la velocità di movimento rimanente del 15% per accumulo per 3s. Si accumula fino a 10 volte. I colpi rinnovano tutti gli accumuli. Non congela i nemici.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Ipotermia</style><style=cSub>Si accumula fino a 10 volte per 7s. Alla morte, esplode infliggendo dal 150% al 600% di danni in un raggio di 2-12 m in base agli accumuli. Le esplosioni diffondono Ipotermia e possono concatenarsi. Non rallenta i nemici.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Gittata della freccia</style><style=cSub>I danni della freccia principale diminuiscono oltre i 40 m, mantenendo il 60% a 80 m. Hurricane Pike estende questa gittata.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Perfora-corazza</style><style=cSub>Ignora la corazza positiva. Può sferrare colpi critici e conserva l'effetto della freccia selezionata.</style>"
    }
}