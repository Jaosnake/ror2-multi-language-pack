    "ROB_WRISTBANDCOST": "I.D. Wristband",
    "ROB_HUNK_STARSBADGECHEST_NAME": "S.T.A.R.S. Box",
    "ROB_HUNK_STARSBADGECHEST_CONTEXT": "Open S.T.A.R.S. box",
    "ROB_STARSBADGECOST": "S.T.A.R.S. Badge",
    "ROB_HUNK_TERMINAL_NAME": "Umbrella Terminal",
    "ROB_HUNK_TERMINAL_CONTEXT": "Insert sample",
    "ROB_SAMPLECOST": "Virus Sample",
    "ROB_HUNK_CHEST_NAME": "Weapon Case: ",
    "ROB_HUNK_CHEST_CONTEXT": "Open weapon case",
    "ROB_HUNK_CASE_INSPECT_NAME": "Weapon Case",
    "ROB_HUNK_CASE_INSPECT_DESC": "Case containing a new weapon for HUNK. Requires a specific keycard to open.",
    "ROB_HUNK_SPECIALCASE_INSPECT_NAME": "Special Weapon Case",
    "ROB_HUNK_SPECIALCASE_INSPECT_DESC": "Special case containing a powerful new weapon for HUNK. Requires a certain level of security clearance to open.",
    "ROB_HUNK_STARSBOX_INSPECT_NAME": "S.T.A.R.S. Box",
    "ROB_HUNK_STARSBOX_INSPECT_DESC": "Special box containing powerful gear for S.T.A.R.S. members. Requires a badge to open.",
    "ROB_HUNK_WEAPONBOX_INSPECT_NAME": "Supply Case",
    "ROB_HUNK_WEAPONBOX_INSPECT_DESC": "A weapon case with useful stuff inside.",
    "ROB_HUNK_LOOTBOX_INSPECT_NAME": "Supply Case",
    "ROB_HUNK_LOOTBOX_INSPECT_DESC": "An Umbrella-branded case with useful stuff inside.",
    "ROB_HUNK_TERMINAL_INSPECT_NAME": "Umbrella Terminal",
    "ROB_HUNK_TERMINAL_INSPECT_DESC": "Used to send virus samples to Umbrella Corporation. Turned in samples are rewarded appropriately.",
    "ROB_HUNK_AMMO_NAME": "Ammo",
    "ROB_HUNK_AMMO_CONTEXT": "Pick up ammo",
    "ROB_HUNK_GRENADE_NAME": "Grenade",
    "ROB_HUNK_GRENADE_CONTEXT": "Pick up grenade",
    "ROB_HUNK_BADGE_NAME": "Corpse",
    "ROB_HUNK_BADGE_CONTEXT": "Inspect corpse",
    "ROB_HUNK_BADGE_CONTEXT2": "Take badge?",
    "ROB_HUNK_C4_NAME": "C4",
    "ROB_HUNK_C4_CONTEXT": "Activate detonator",
    "ROB_HUNK_KEYWORD_LOOTING": "<style=cKeywordName>Looting</style><style=cSub>Enemies slain with this skill have a small chance to drop ammo.</style>",
    "ROB_HUNK_KEYWORD_MANGLED": "<style=cKeywordName>Mangled</style><style=cSub>Upon reaching 6 stacks of this debuff, enemies suffer an instant <style=cIsDamage>2200% damage</style>.</style>",
    "ROB_HUNK_KEYWORD_PERFECTDODGE": "<style=cKeywordName>Perfect Dodge</style><style=cSub><style=cIsUtility>Refund cooldown</style> and become briefly invulnerable. Allows you to perform a <style=cIsDamage>Counterattack</style>.</style>",
    "ROB_HUNK_KEYWORD_PERFECTPARRY": "<style=cKeywordName>Perfect Parry</style><style=cSub>Deal <style=cIsDamage>800% damage</style> and become briefly invulnerable. Allows you to perform a <style=cIsDamage>Counterattack</style>.</style>",
    "ROB_HUNK_KEYWORD_PERFECTBASH": "<style=cKeywordName>Perfect Bash</style><style=cSub><style=cIsUtility>Refund cooldown</style> and become briefly invulnerable. Allows you to perform a <style=cIsDamage>Counterattack</style>.</style>",
    "ROB_HUNK_KEYWORD_COUNTER": "<style=cKeywordName>Counterattack</style><style=cSub>Pressing <style=cIsDamage>primary</style> lunges and performs a lethal <style=cIsDamage>counterattack</style> on a nearby enemy.</style>",
    "ROB_HUNK_KEYWORD_VIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Once every stage, a random monster becomes <color=#C678B4>Infected</color>. It mutates, <style=cIsHealth>growing stronger over time</style>, and killing it drops a <color=#FFFF00>G-Virus Sample</color>.</style>\n\n<style=cKeywordName>T-Virus</style><style=cSub>Once every stage, several monsters become <color=#0066FF>Infected</color>. This <style=cIsHealth>revives</style> them twice, and killing all of them nets you a <color=#FFFF00>T-Virus Sample</color>.</style>\n\n<style=cKeywordName>C-Virus</style><style=cSub>Once every stage, several monsters become <color=#FF0033>Infected</color>. Upon death these monsters go on a <style=cIsDamage>frenzy</style> for <style=cIsUtility>5</style> seconds and then <style=cIsHealth>explode</style>, and killing all of them nets you a <color=#FFFF00>C-Virus Sample</color>.</style>",
    "ROB_HUNK_KEYWORD_GVIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Once every stage, a random monster becomes <color=#C678B4>Infected</color>. It mutates, <style=cIsHealth>growing stronger over time</style>, and killing it drops a <color=#FFFF00>G-Virus Sample</color>.</style>",
    "ROB_HUNK_KEYWORD_TVIRUS": "<style=cKeywordName>T-Virus</style><style=cSub>Once every stage, several monsters become <color=#0066FF>Infected</color>. This <style=cIsHealth>revives</style> them twice, and killing all of them nets you a <color=#FFFF00>T-Virus Sample</color>.</style>",
    "ROB_HUNK_KEYWORD_CVIRUS": "<style=cKeywordName>C-Virus</style><style=cSub>Once every stage, several monsters become <color=#FF0033>Infected</color>. Upon death these monsters go on a <style=cIsDamage>frenzy</style> for <style=cIsUtility>5</style> seconds and then <style=cIsHealth>explode</style>, and killing all of them nets you a <color=#FFFF00>C-Virus Sample</color>.</style>",
    "ROB_HUNK_WEAPON_SMG_NAME": "LE 5",
    "ROB_HUNK_WEAPON_SMG_DESC": "A high-performance submachine gun.",
    "ROB_HUNK_WEAPON_ADDON_SMG_NAME": "Laser Sight (LE 5)",
    "ROB_HUNK_WEAPON_ADDON_SMG_DESC": "A custom part for the LE 5 that boosts its effectiveness at long range and when striking weak points.",
    "ROB_HUNK_WEAPON_ADDON2_SMG_NAME": "Extended Magazine (LE 5)",
    "ROB_HUNK_WEAPON_ADDON2_SMG_DESC": "A custom part for the LE 5 that greatly boosts its magazine capacity.",
    "ROB_HUNK_WEAPON_ADDON3_SMG_NAME": "Moderator (LE 5)",
    "ROB_HUNK_WEAPON_ADDON3_SMG_DESC": "A custom part for the LE 5 that limits its rate of fire, but converts that bonus to damage instead.",
    "ROB_HUNK_WEAPON_SMG2_NAME": "LE 5",
    "ROB_HUNK_WEAPON_SMG2_DESC": "A high-performance submachine gun.",
    "ROB_HUNK_WEAPON_M19_NAME": "M19",
    "ROB_HUNK_WEAPON_M19_DESC": "A powerful handgun with a built-in laser sight.",
    "ROB_HUNK_WEAPON_ADDON_M19_NAME": "Suppressor (M19)",
    "ROB_HUNK_WEAPON_ADDON_M19_DESC": "A custom part for the M19 that suppresses the sound of gunfire and acts as a counterweight to greatly reduce muzzle rise and boost bullet velocity.",
    "ROB_HUNK_WEAPON_ADDON2_M19_NAME": "High-Capacity Mag (M19)",
    "ROB_HUNK_WEAPON_ADDON2_M19_DESC": "A custom part for the M19 that extends clip capacity to 15 rounds.",
    "ROB_HUNK_WEAPON_MUP_NAME": "MUP",
    "ROB_HUNK_WEAPON_MUP_DESC": "A well-balanced handgun.",
    "ROB_HUNK_WEAPON_ADDON_MUP_NAME": "Gun Stock (MUP)",
    "ROB_HUNK_WEAPON_ADDON_MUP_DESC": "A custom part for the MUP that allows the gun to fire 3 rounds per pull of the trigger.",
    "ROB_HUNK_WEAPON_ADDON2_MUP_NAME": "Dot Sight (MUP)",
    "ROB_HUNK_WEAPON_ADDON2_MUP_DESC": "A custom part for the MUP. Adds a sight that boosts its effectiveness at long range and when striking weak points.",
    "ROB_HUNK_WEAPON_ADDON3_MUP_NAME": "High-Capacity Mag (MUP)",
    "ROB_HUNK_WEAPON_ADDON3_MUP_DESC": "A custom part for the MUP that extends clip capacity to 33 rounds and shortens reload time.",
    "ROB_HUNK_WEAPON_ADDON4_MUP_NAME": "Muzzle Brake (MUP)",
    "ROB_HUNK_WEAPON_ADDON4_MUP_DESC": "A custom part for the MUP that boosts its damage to 600%.",
    "ROB_HUNK_WEAPON_SG09_NAME": "SG-09 R",
    "ROB_HUNK_WEAPON_SG09_DESC": "An easy-to-use handgun with a high ammo capacity.",
    "ROB_HUNK_WEAPON_ADDON_SG09_NAME": "High-Capacity Mag (SG-09 R)",
    "ROB_HUNK_WEAPON_ADDON_SG09_DESC": "A custom part for the SG-09 R that extends clip capacity to 32 rounds.",
    "ROB_HUNK_WEAPON_ADDON2_SG09_NAME": "Muzzle Brake (SG-09 R)",
    "ROB_HUNK_WEAPON_ADDON2_SG09_DESC": "A custom part for the SG-09 R that boosts its damage to 900%.",
    "ROB_HUNK_WEAPON_ADDON3_SG09_NAME": "Laser Sight (SG-09 R)",
    "ROB_HUNK_WEAPON_ADDON3_SG09_DESC": "A custom part for the SG-09 R. Adds a sight that boosts its effectiveness at long range and when striking weak points",
    "ROB_HUNK_WEAPON_BROOMHC_NAME": "Broom HC",
    "ROB_HUNK_WEAPON_BROOMHC_DESC": "A compact, high-performance handgun.",
    "ROB_HUNK_WEAPON_MAGNUM_NAME": "Lightning Hawk",
    "ROB_HUNK_WEAPON_MAGNUM_DESC": "An easy-to-handle magnum with high power.",
    "ROB_HUNK_WEAPON_ADDON_MAGNUM_NAME": "Long Barrel (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON_MAGNUM_DESC": "A custom part for the Lightning Hawk that boosts its damage to 3000%.",
