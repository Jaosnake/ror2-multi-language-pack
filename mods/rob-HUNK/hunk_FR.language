    "ROB_HUNK_BODY_PPASSIVE_NAME": "OSP (Approvisionnement sur site)",
    "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK peut ramasser des <color=#FFFF00>Cartes U.C.</color> pour ouvrir des <style=cIsDamage>mallettes d'armes</style> et enrichir son arsenal.",
    "ROB_HUNK_BODY_PPASSIVE2_NAME": "Soldat Oublié",
    "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "Le premier <style=cIsHealth>boss</style> tué à chaque niveau laisse tomber un <style=cIsDamage>pack de ravitaillement</style> contenant une arme ou un accessoire.",
    "ROB_HUNK_BODY_PASSIVE_NAME": "Lutte Acharnée",
    "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Commencez avec un <style=cIsDamage>LE 5</style> et une <style=cIsDamage>arme de poing</style>. Vous pouvez <style=cIsDamage>fouiller</style> les <style=cIsUtility>coffres</style> pour trouver des munitions.",
    "ROB_HUNK_BODY_PASSIVE2_NAME": "Terreur Imminente",
    "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "Commencez avec un <style=cIsDamage>arsenal complet</style>, <style=cIsHealth>MAIS</style> vous êtes désormais <style=cIsHealth>incapable d'obtenir davantage de munitions</style>.",
    "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "Nouvelle Partie+",
    "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Commencez avec un <style=cIsDamage>LE 5</style> et une <style=cIsDamage>arme de poing</style>. Vous pouvez <style=cIsDamage>fouiller</style> les <style=cIsUtility>coffres</style> pour trouver des munitions. <style=cIsHealth>Le contenu de toutes les mallettes d'armes est aléatoire.</style>",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Autorité Suprême",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "Commencez avec <style=cIsHealth>UNIQUEMENT</style> un <style=cIsDamage>W-870</style>. Vous pouvez <style=cIsDamage>fouiller</style> les <style=cIsUtility>coffres</style> pour trouver des munitions.",
    "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Mercenaire Ultime",
    "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Commencez avec <style=cIsHealth>UNIQUEMENT</style> un <style=cIsDamage>LE 5 entièrement amélioré</style>. Vous pouvez <style=cIsDamage>fouiller</style> les <style=cIsUtility>coffres</style> pour trouver des munitions. <style=cIsDamage>Spécial</style> est remplacé par <color=#C80202>Mode Carnage</color>.",
    "ROB_HUNK_BODY_WPASSIVE_NAME": "Saturation Globale Complète",
    "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "Commencez avec <style=cIsHealth>UNIQUEMENT</style> une <style=cIsDamage>arme de poing</style>. Vous pouvez <style=cIsDamage>fouiller</style> les <style=cIsUtility>coffres</style> pour trouver des munitions. <style=cIsDamage>Utilitaire</style> est remplacé par <color=#C80202>Uroboros</color>.",
    "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Pyromanie",
    "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "Commencez avec <style=cIsHealth>UNIQUEMENT</style> un <style=cIsDamage>Lance-flammes Chimique</style>. Vous pouvez <style=cIsDamage>fouiller</style> les <style=cIsUtility>coffres</style> pour trouver des munitions. <style=cIsHealth>Une SEULE mallette d'arme apparaît par niveau.</style>",
    "ROB_HUNK_BODY_CONFIRM_NAME": "Confirmer",
    "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "Continuer avec la compétence actuelle.",
    "ROB_HUNK_BODY_CANCEL_NAME": "Annuler",
    "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "Annuler la compétence actuelle.",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Couteau de Combat",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Pillage.</style> <style=cIsDamage>Tranchez</style> les combattants à courte portée pour <style=cIsDamage>200% de dégâts</style>, infligeant <style=cIsHealth>Mutilé</style>.",
    "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Combat Rapproché)",
    "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Pillage.</style> <style=cIsDamage>Frappez deux fois du pied</style> pour <style=cIsDamage>200% et 250% de dégâts</style>. Si le <style=cIsUtility>second coup de pied</style> touche, enchaînez avec une <style=cIsDamage>Contre-attaque</style>.",
    "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Scanner",
    "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Scannez pour repérer les <style=cIsUtility>mallettes d'armes non ouvertes</style>.",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Grappin",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Tirez un crochet vers un <style=cIsUtility>point éloigné</style>, puis <style=cIsUtility>hissez-vous jusqu'à lui</style>. <style=cIsDamage>Vous pouvez contre-attaquer après l'atterrissage.</style>",
    "ROB_HUNK_BODY_SHOOT_ATM_NAME": "Tirer",
