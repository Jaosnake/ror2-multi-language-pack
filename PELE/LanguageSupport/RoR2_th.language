    "CAPTAIN_SUPPLY_EQUIPMENT_RESTOCK_INTERACTION": "รับประจุอุปกรณ์",
    "CAPTAIN_SUPPLY_SHOCKING_NAME": "สัญญาณ: ช็อตไฟฟ้า",
    "CAPTAIN_SUPPLY_SHOCKING_DESCRIPTION": "<style=cIsDamage>ช็อต</style>ศัตรูใกล้เคียงทั้งหมดเป็นระยะ ทำให้เคลื่อนที่ไม่ได้",
    "CAPTAIN_SKILL_USED_UP_NAME": "ใช้งานไม่ได้",
