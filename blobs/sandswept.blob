				Util.PlaySound("Play_loader_m1_shield", ((Component)component).gameObject);
				Util.PlaySound("Play_loader_m1_shield", ((Component)component).gameObject);
				platingManager.usedUpAllPlatingThisPickup = false;
				NetMessageExtensions.Send((INetMessage)(object)new MakeshiftPlateAddSync(((Component)component).gameObject, platingManager.CurrentPlating, platingManager.MaxPlating, remove: false), (NetworkDestination)1);
			}
		}

