    "ROB_NEMESIS_BODY_MELEE_NAME": "Brutaler Ansturm",
    "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Schlage für <style=cIsDamage>350% Schaden</style> zu. Im <style=cIsUtility>Stehen</style> auslösen, um für <style=cIsDamage>800% Schaden</style> aufzustampfen. Beim <style=cIsUtility>Sprinten</style> auslösen, um für <style=cIsDamage>600% Schaden</style> zu rammen.",
    "ROB_NEMESIS_BODY_GRAB_NAME": "Tödliche Reichweite",
    "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Greife einen Gegner. Nutze Primär, um ihn zu verschlingen und 10% maximale Gesundheit zu heilen, oder Sekundär, um einen Wurf für bis zu 2400% Schaden aufzuladen.",
    "ROB_NEMESIS_BODY_DASH_NAME": "Biogefahren-Sturm",
    "ROB_NEMESIS_BODY_DASH_DESCRIPTION": "In der <style=cIsUtility>Luft</style> einsetzen, um <style=cIsDamage>einmal</style> durch die Luft zu schnellen.",
    "ROB_NEMESIS_BODY_ULTIMATE_NAME": "Kritische Masse",
    "ROB_NEMESIS_BODY_ULTIMATE_DESCRIPTION": "Halten, um langsam <style=cIsHealth>Biomasse</style> zu verbrauchen und bis zu <style=cIsHealing>100% maximale Gesundheit</style> wiederherzustellen.",
