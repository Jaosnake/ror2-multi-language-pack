    "KENKO_CADET_PRIMARY_SHOTGUN_DESCRIPTION": "<style=cIsUtility>Agile</style>. Fire a burst for <style=cIsDamage>3x100% damage</style>. Requires a <style=cIsUtility>reload</style> after <style=cIsDamage>10</style> bullets.",
