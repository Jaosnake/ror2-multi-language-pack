    "CHEESEWITHHOLES_BASICTANK_BODY_BRUISER_DESCRIPTION": "<color=#FFFF00>엔진 출력: </color>1000\n<color=#00FFFF>속도: </color>10\nTraverse 속도: 4\n\n<color=#00FF00>체력: </color>150\n<color=#FF0000>방어력: </color>15\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>100\n무게: 164\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_TIGER_I_NAME": "Tiger I 차체",
    "CHEESEWITHHOLES_BASICTANK_BODY_TIGER_I_DESCRIPTION": "<color=#FFFF00>엔진 출력: </color>1100\n<color=#00FFFF>속도: </color>9.5\nTraverse 속도: 3.5\n\n<color=#00FF00>체력: </color>175\n<color=#FF0000>방어력: </color>20\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>105\n무게: 195\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_CROMWELL_NAME": "Cromwell 차체",
    "CHEESEWITHHOLES_BASICTANK_BODY_CROMWELL_DESCRIPTION": "<color=#FFFF00>엔진 출력: </color>900\n<color=#00FFFF>속도: </color>10\nTraverse 속도: 5\n\n<color=#00FF00>체력: </color>75\n<color=#FF0000>방어력: </color>11\n\n<color=#AA00FF>추진력: </color>40.5\n<color=#ffc080>연료량: </color>95\n무게: 86\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_T62_NAME": "T62 차체",
    "CHEESEWITHHOLES_BASICTANK_BODY_T62_DESCRIPTION": "<color=#FFFF00>엔진 출력: </color>850\n<color=#00FFFF>속도: </color>11\nTraverse 속도: 4\n\n<color=#00FF00>체력: </color>125\n<color=#FF0000>방어력: </color>12\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>100\n무게: 137\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_SOMUA_S35_NAME": "Somua S35 차체",
    "CHEESEWITHHOLES_BASICTANK_BODY_SOMUA_S35_DESCRIPTION": "<color=#FFFF00>엔진 출력: </color>950\n<color=#00FFFF>속도: </color>10\nTraverse 속도: 3.5\n\n<color=#00FF00>체력: </color>60\n<color=#FF0000>방어력: </color>9\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>105\n무게: 60\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_CHURCHILL_NAME": "Churchill 차체",
    "CHEESEWITHHOLES_BASICTANK_BODY_CHURCHILL_DESCRIPTION": "<color=#FFFF00>엔진 출력: </color>1200\n<color=#00FFFF>속도: </color>9\nTraverse 속도: 3.5\n\n<color=#00FF00>체력: </color>140\n<color=#FF0000>방어력: </color>13\n\n<color=#AA00FF>추진력: </color>39\n<color=#ffc080>연료량: </color>115\n무게: 153\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_MAUS_NAME": "Maus 차체",
    "CHEESEWITHHOLES_BASICTANK_BODY_MAUS_DESCRIPTION": "<color=#FFFF00>엔진 출력: </color>1400\n<color=#00FFFF>속도: </color>8\nTraverse 속도: 3\n\n<color=#00FF00>체력: </color>200\n<color=#FF0000>방어력: </color>40\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>110\n무게: 240\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_TETRARCH_NAME": "Tetrarch 차체",
    "CHEESEWITHHOLES_BASICTANK_BODY_TETRARCH_DESCRIPTION": "<color=#FFFF00>엔진 출력: </color>1000\n<color=#00FFFF>속도: </color>10.5\nTraverse 속도: 4.5\n\n<color=#00FF00>체력: </color>50\n<color=#FF0000>방어력: </color>8\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>95\n무게: 58\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_APC_NAME": "APC 차체",
    "CHEESEWITHHOLES_BASICTANK_BODY_APC_DESCRIPTION": "<color=#FFFF00>엔진 출력: </color>970\n<color=#00FFFF>속도: </color>10\nTraverse 속도: 4\n\n<color=#00FF00>체력: </color>80\n<color=#FF0000>방어력: </color>2\n\n<color=#AA00FF>추진력: </color>37.5\n<color=#ffc080>연료량: </color>120\n무게: 82\n",
