    "ROB_HUNK_BODY_PPASSIVE_NAME": "OSP (Aprovisionamiento sobre el Terreno)",
    "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK puede recoger <color=#FFFF00>Tarjetas de Acceso U.C.</color> para abrir <style=cIsDamage>maletines de armas</style> y ampliar su arsenal.",
    "ROB_HUNK_BODY_PPASSIVE2_NAME": "Soldado Olvidado",
    "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "El primer <style=cIsHealth>jefe</style> que muera en cada fase deja caer un <style=cIsDamage>lote de suministros</style> con un arma o un accesorio.",
    "ROB_HUNK_BODY_PASSIVE_NAME": "Pugna Despiadada",
    "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Empiezas con un <style=cIsDamage>LE 5</style> y una <style=cIsDamage>pistola auxiliar</style>. Puedes <style=cIsDamage>registrar</style> <style=cIsUtility>cofres</style> en busca de munición.",
    "ROB_HUNK_BODY_PASSIVE2_NAME": "Pavor Acechante",
    "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "Empiezas con el <style=cIsDamage>arsenal completo</style>, <style=cIsHealth>PERO</style> ya <style=cIsHealth>no podrás conseguir más munición</style>.",
    "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "Nueva Partida+",
    "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Empiezas con un <style=cIsDamage>LE 5</style> y una <style=cIsDamage>pistola auxiliar</style>. Puedes <style=cIsDamage>registrar</style> <style=cIsUtility>cofres</style> en busca de munición. <style=cIsHealth>El contenido de todos los maletines de armas es aleatorio.</style>",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Autoridad Máxima",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "Empiezas <style=cIsHealth>SOLO</style> con una <style=cIsDamage>W-870</style>. Puedes <style=cIsDamage>registrar</style> <style=cIsUtility>cofres</style> en busca de munición.",
    "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Mercenario Supremo",
    "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Empiezas <style=cIsHealth>SOLO</style> con un <style=cIsDamage>LE 5 mejorado al máximo</style>. Puedes <style=cIsDamage>registrar</style> <style=cIsUtility>cofres</style> en busca de munición. <style=cIsDamage>Especial</style> se sustituye por <color=#C80202>Modo Desenfreno</color>.",
    "ROB_HUNK_BODY_WPASSIVE_NAME": "Saturación Global Total",
    "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "Empiezas <style=cIsHealth>SOLO</style> con una <style=cIsDamage>pistola auxiliar</style>. Puedes <style=cIsDamage>registrar</style> <style=cIsUtility>cofres</style> en busca de munición. <style=cIsDamage>Utilidad</style> se sustituye por <color=#C80202>Uroboros</color>.",
    "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Piromanía",
    "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "Empiezas <style=cIsHealth>SOLO</style> con un <style=cIsDamage>Lanzallamas Químico</style>. Puedes <style=cIsDamage>registrar</style> <style=cIsUtility>cofres</style> en busca de munición. <style=cIsHealth>Solo aparece UN maletín de armas por fase.</style>",
    "ROB_HUNK_BODY_CONFIRM_NAME": "Confirmar",
    "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "Prosigue con la habilidad actual.",
    "ROB_HUNK_BODY_CANCEL_NAME": "Cancelar",
    "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "Cancela la habilidad actual.",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Cuchillo de Combate",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Botín.</style> <style=cIsDamage>Acuchilla</style> a enemigos cercanos para causar un <style=cIsDamage>200% de daño</style> e infligir <style=cIsHealth>Desgarrado</style>.",
    "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Combate Cuerpo a Cuerpo)",
    "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Botín.</style> <style=cIsDamage>Propina dos patadas</style> de <style=cIsDamage>200% y 250% de daño</style>. Si la <style=cIsUtility>segunda patada</style> acierta, continúa con un <style=cIsDamage>Contraataque</style>.",
    "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Escanear",
    "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Escanea en busca de <style=cIsUtility>maletines de armas cerrados</style>.",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Garfio",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Dispara un garfio hacia un <style=cIsUtility>punto lejano</style> y luego <style=cIsUtility>impúlsate hacia él</style>. <style=cIsDamage>Puedes contraatacar al aterrizar.</style>",
    "ROB_HUNK_BODY_SHOOT_ATM_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_ATM_DESCRIPTION": "Dispara causando un <style=cIsDamage>8000% de daño</style>. <style=cIsUtility>Inflige el mayor daño en impactos directos.</style>",
    "ROB_HUNK_BODY_SHOOT_ATM2_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_ATM2_DESCRIPTION": "Dispara causando un <style=cIsDamage>8000% de daño</style>. <style=cIsUtility>Inflige el mayor daño en impactos directos.</style>",
    "ROB_HUNK_BODY_SHOOT_RPG_NAME": "Disparar",
