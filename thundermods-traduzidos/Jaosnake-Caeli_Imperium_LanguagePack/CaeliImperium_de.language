    "CI_BUILDER_COLLIDES_VALID": "Nein",
    "CI_BUILDER_COLLIDES_INVALID": "Ja",
    "CI_BISHOP_SPEAR_THROW": "Werfen",
    "CI_BISHOP_SPEAR_SLAM": "Schmettern",
    "CI_BISHOP_SPEAR_CHAIN": "In Arbeit",
    "CI_DIFFICULTY_HURTMEPLENTY_NAME": "Hurt Me Plenty",
    "CI_DIFFICULTY_HURTMEPLENTY_DESC": "So ist das Spiel gedacht, wenn man als Doomguy spielt! Besiege den Hauptendboss als Doomguy, um diesen Schwierigkeitsgrad für alle Überlebenden und die restlichen Schwierigkeitsgrade für Doomguy freizuschalten (derzeit ist diese Funktion noch nicht implementiert).<style=cStack>\n\nProjektilgeschwindigkeit von Monstern: <style=cIsHealing>-35 %</style>\nFlughöhe von Monstern: <style=cIsHealing>8 m</style>\nEliten: <style=cIsHealing>Weg</style>\nRückstoß: <style=cIsDamage>Weg</style>\nDrohnen, Gegenstände und Ausrüstungen: <style=cIsDamage>Neu verteilt</style>. <style=cIsHealth>-75 % Schaden. Können nicht betäuben, schocken, festhalten und einfrieren</style>\nMonster: <style=cIsHealth>Visieren keine Schergen an</style>\nGesundheit schwerer Monster: <style=cIsHealth>+60 %</style>\nGesundheit von Boss-Monstern: <style=cIsHealth>+120 %</style>\nDrucker und Schredder: <style=cIsHealth>Weg</style>\nLeeren- und Mond-Gegenstände: <style=cIsHealth>Weg</style>\nSchwache Monster: <style=cIsHealth>Weg</style>\nTrefferbetäubungen: <style=cIsHealth>Weg</style></style>",
    "CI_DOOMGUY_BODY_NAME": "Doomguy",
    "CI_DOOMGUY_BODY_SUBTITLE": "Verdammter Typ oder verdammender Typ oder so, keine Ahnung",
    "CI_DOOMGUY_NAME": "Doomguy",
    "CI_DOOMGUY_DESC": "Er ist der Doomguy!",
    "CI_DOOMGUY_SHOTGUN_NAME": "Kampfschrotflinte",
    "CI_DOOMGUY_SHOTGUN_DESC": "Verschieße Schrotkugeln für <style=cIsDamage>5x120 % Schaden</style>",
    "CI_DOOMGUY_SPEAR_NAME": "Speerschwung",
    "CI_DOOMGUY_SPEAR_DESC": "Schwinge den Speer für <style=cIsDamage>200 % Schaden</style>. <style=cIsUtility>Pariere</style> eingehende <style=cIsHealing>parierbare</style> Angriffe und Projektile. Erhalte <style=cDeath>Ermächtigung</style> und <style=cIsUtility>verringere die Abklingzeit</style> deiner Unterstützungsfertigkeit bei einer <style=cIsHealing>erfolgreichen Parade</style>",
    "CI_DOOMGUY_ACCELERATOR_NAME": "Plasmabeschleuniger",
    "CI_DOOMGUY_ACCELERATOR_DESC": "Verschieße ein Plasmaprojektil für <style=cIsDamage>50 % Schaden</style>. Dauerfeuer überlädt den Beschleuniger und erhöht den Schaden des Plasmaprojektils auf <style=cIsDamage>125 % Schaden</style>. Entlade die Überladung beim Loslassen des Abzugs und verursache <style=cIsDamage>500 % Schaden</style>",
    "CI_DOOMGUY_DASH_NAME": "Sprint",
    "CI_DOOMGUY_DASH_DESC": "<style=cIsUtility>Sprinte</style> in Bewegungsrichtung",
    "CI_DOOMGUY_SPEARSPECIAL_NAME": "Speer-Ermächtigung",
    "CI_DOOMGUY_SPEARSPECIAL_DESC": "Bereite den Speer auf <style=cDeath>Ermächtigung</style> vor. Verbraucht 5 <style=cDeath>Ermächtigung</style> bei Verwendung.\n\nPrimär: Wirf den Speer für <style=cIsDamage>2000 % Schaden</style>. Verursacht <style=cIsDamage>kritische Treffer</style> und <style=cIsDamage>Super-Betäubung</style> bei Kopftreffern.\n\nSekundär: In Arbeit\n\nUnterstützung: Springe nach unten und verursache <style=cIsDamage>700 % Schaden</style> in einem <style=cIsUtility>Radius von 24 Metern</style>",
    "CI_DOOMGUY_PUNCH_NAME": "Schlag",
    "CI_DOOMGUY_PUNCH_DESC": "Schlage das Ziel für <style=cIsDamage>800 % Schaden</style>. Wenn das Ziel <style=cDeath>ins Taumeln gebracht</style> ist, wird die Ladung nicht verbraucht, du heilst dich um <style=cIsHealing>3,125 %/12,5 %/25 %</style> der maximalen Gesundheit sowie <style=cIsHealing>10 %/25 %/50 %</style> Reserveheilung basierend auf der Zielklasse und erhältst <style=cDeath>Ermächtigung</style>"
  }
}
