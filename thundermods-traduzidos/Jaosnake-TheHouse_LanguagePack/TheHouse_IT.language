{
    "IT": {
        "JAVANGLE_HOUSE_BODY_NAME": "House",
        "JAVANGLE_HOUSE_BODY_DESCRIPTION": "House è un giocatore folle che si affida alla sorte per superare situazioni difficili, usando due misteriosi artefatti del destino: un revolver da 6 colpi chiamato \"Roulette\" e un mazzo di carte apparentemente maledetto.",
        "JAVANGLE_HOUSE_BODY_SUBTITLE": "Il Giocatore Folle",
        "JAVANGLE_HOUSE_BODY_LORE": "A proposito di slot machine, ne hanno appena installata una nuova nella sala ricreativa della nave, la gente va dicendo che quel maledetto aggeggio è vivo o roba del genere, pazzi f-... Hanno installato cosa adesso?!",
        "JAVANGLE_HOUSE_BODY_OUTRO_FLAVOR": "Beh, se non fosse che il mio primo premio sono stati questi artefatti, forse non avrei tirato così tanto quella slot machine, trasformando quel dannato aggeggio in una stampante di soldi, il proprietario non ne è stato affatto contento, mi hanno cacciato fuori, e da allora sono inseguito da quella stessa slot machine",
        "JAVANGLE_HOUSE_BODY_OUTRO_FAILURE": "Ehi ehi Ehi! Calma, rallenta un attimo, un casinò nel vuoto? Una slot machine ha quasi finito per ucciderti?... Immagino sia lì che hai preso quegli artefatti, eh?",
        "JAVANGLE_HOUSE_BODY_DEFAULT_SKIN_NAME": "House",
        "JAVANGLE_HOUSE_BODY_MASTERY_SKIN_NAME": "Mansion",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "House: Maestria",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni di House, completa la partita o obliterati a difficoltà Monsoon.",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "House: Maestria",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "House: Grande Maestria",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni di House, completa la partita o obliterati a difficoltà Typhoon.",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "House: Grande Maestria",
        "JAVANGLE_HOUSE_PASSIVE_NAME": "Il Gioco",
        "JAVANGLE_HOUSE_PASSIVE_DESCRIPTION": "Invece delle <style=cIsUtility>Abilità</style>, The House usa le <style=cIsUtility>Carte</style>, ciascuna carta possiede un effetto unico. Una volta usata una carta, il suo slot entra in ricarica, scarti la tua mano e peschi 3 nuove carte.",
        "JAVANGLE_HOUSE_STANDARDSPREAD_NAME": "Mazzo: Distribuzione Standard",
        "JAVANGLE_HOUSE_STANDARDSPREAD_DESCRIPTION": "Gestisce un casinò nel vuoto, solo Dio sa come faccia ad attirare clienti laggiù, tutto ciò che posso dirvi è che a loro decisamente NON piace che detti clienti escano con più di quanto avevano quando sono entrati, una slot machine mi ha quasi ucciso. Un mazzo semplificato, progettato per essere facile da usare.<style=cSub>[Controlla la scheda Carte per vedere le carte in questo mazzo]</style>",
        "JAVANGLE_HOUSE_FULLHOUSE_NAME": "Mazzo: Full House",
        "JAVANGLE_HOUSE_FULLHOUSE_DESCRIPTION": "Cosa dici adesso? La classica esperienza di House.<style=cSub>[Controlla la scheda Carte per vedere le carte in questo mazzo]</style>",
        "JAVANGLE_HOUSE_DIVINATION_NAME": "Mazzo: Divinazione",
        "JAVANGLE_HOUSE_DIVINATION_DESCRIPTION": "Beh, ho avuto un incontro con lei. Un mazzo complesso che ti permette di controllare la composizione delle carte.<style=cSub>[Controlla la scheda Carte per vedere le carte in questo mazzo]</style>",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_NAME": "BulletArts: Vuoto",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_DESCRIPTION": "Eh, parli come se l'avessi conosciuta. Spara un proiettile carico casuale. Quando non hai più colpi: non fa nulla.",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_NAME": "BulletArts: Estrazione Rapida",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_DESCRIPTION": "Spara <style=cIsUtility>più velocemente</style>, ma <style=cArtifact>tutti i colpi infliggono meno danni</style>. Quando non hai più colpi: non fa nulla.",
        "JAVANGLE_HOUSE_RELOADSTANDARD_NAME": "ReloadArts: Standard",
        "JAVANGLE_HOUSE_RELOADSTANDARD_DESCRIPTION": "Giocare qualsiasi carta ricarica la roulette.\n50%/25% di probabilità di ottenere 1/2 munizioni speciali casuali in base al tipo di carta usata (rosso = Perforante/Bocchettone/Esplosivo, viola = Vuoto/Serpente, grigio/verde = uno dei precedenti).\n<style=cSub>[Controlla la scheda Carte per vedere i colpi e i loro effetti]</style>",
        "JAVANGLE_HOUSE_RELOADALLIN_NAME": "ReloadArts: All-In",
        "JAVANGLE_HOUSE_RELOADALLIN_DESCRIPTION": "... perbacco! Le carte sembrano possedere un potere immenso e scatenano strani effetti, e per quanto mi sforzi, non riesco mai a pescarne altre finché non ne uso una. Giocare qualsiasi carta ricarica la roulette. Carica da 0 a 6 colpi Perforante/Pallini/Esplosivo, <style=cArtifact>tutti i colpi rimanenti sono Serpente</style>.<style=cSub>[Controlla la scheda Carte per vedere i Colpi e i loro effetti]</style>",
        "JAVANGLE_HOUSE_CARDARTSHOP_NAME": "CardArts: Balzo",
        "JAVANGLE_HOUSE_CARDARTSHOP_DESCRIPTION": "Giocare qualsiasi carta mentre sei a mezz'aria ti spinge in avanti.",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_NAME": "CardArts: Spazzata",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_DESCRIPTION": "Giocare qualsiasi carta: scaglia la carta in avanti, infliggendo <style=cIsDamage>{0}% di danno</style> ai nemici a distanza ravvicinata e <style=cIsUtility>ottiene una barriera pari al {1}% della tua salute massima</style> per ogni nemico colpito.",
        "JAVANGLE_HOUSE_SHUFFLEART_NAME": "ShuffleArts: Ouroboros",
        "JAVANGLE_HOUSE_SHUFFLEART_DESCRIPTION": "Scarta la tua mano attuale e pesca 3 nuove carte.",
        "JAVANGLE_HOUSE_STANDARDSHOT_NAME": "Colpo Standard",
        "JAVANGLE_HOUSE_STANDARDSHOT_DESCRIPTION": "Spara un proiettile standard che infligge <style=cIsDamage>{0}% di danno</style>.",
        "JAVANGLE_HOUSE_PIERCINGSHOT_NAME": "Colpo Perforante",
        "JAVANGLE_HOUSE_PIERCINGSHOT_DESCRIPTION": "Spara un proiettile speciale che trapassa i bersagli infliggendo <style=cIsDamage>{0}% di danno</style> a ciascuno.",
        "JAVANGLE_HOUSE_BUCKSHOT_NAME": "Colpo a Pallini",
        "JAVANGLE_HOUSE_BUCKSHOT_DESCRIPTION": "Spara una rosa di proiettili a pompa infliggendo <style=cIsDamage>{0}% x {1} di danno</style>.",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_NAME": "Colpo Esplosivo",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_DESCRIPTION": "Spara un proiettile esplosivo che infligge <style=cIsDamage>{0}% di danno</style> in un'area d'effetto.",
        "JAVANGLE_HOUSE_SNAKESHOT_NAME": "Colpo Serpente",
        "JAVANGLE_HOUSE_SNAKESHOT_DESCRIPTION": "Tenta di sparare, <style=cSub>fallisce</style>, e subisci <style=cDeath>{0}% della tua salute massima come danno</style>.",
        "JAVANGLE_HOUSE_BLANKSHOT_NAME": "Colpo a Salve",
        "JAVANGLE_HOUSE_BLANKSHOT_DESCRIPTION": "Tenta di sparare, <style=cSub>fallisce</style>, e fai una figura ridicola.",
        "JAVANGLE_HOUSE_MYSTERYSHOT_NAME": "Colpo Misterioso",
        "JAVANGLE_HOUSE_MYSTERYSHOT_DESCRIPTION": "Spara un colpo speciale casuale (tranne Colpo Serpente).",
        "JAVANGLE_HOUSE_ACESHOT_NAME": "Colpo dell'Asso",
        "JAVANGLE_HOUSE_ACESHOT_DESCRIPTION": "Carica un colpo gigantesco che infligge <style=cIsDamage>{0}% di danno</style> a tutti i nemici davanti a te, colpendo a qualsiasi distanza e perfino attraverso i muri.",
        "JAVANGLE_HOUSE_7CLUBS_NAME": "7 di Fiori",
        "JAVANGLE_HOUSE_7CLUBS_DESCRIPTION": "Carica <style=cIsUtility>3 Colpi Misteriosi</style> nella roulette.\nInoltre, <style=cIsUtility>Garantisce</style> che il tuo prossimo colpo sarà un Colpo Esplosivo.",
        "JAVANGLE_HOUSE_7SPADES_NAME": "7 di Picche",
        "JAVANGLE_HOUSE_7SPADES_DESCRIPTION": "Ottieni <style=cIsUtility>Velocità di Movimento Aumentata</style> e <style=cIsUtility>2 potenziamenti completamente casuali</style> per {0} secondi.\nInoltre, <style=cIsUtility>Garantisce</style> che il tuo prossimo colpo sarà un Colpo Esplosivo.",
        "JAVANGLE_HOUSE_7DIAMONDS_NAME": "7 di Quadri",
        "JAVANGLE_HOUSE_7DIAMONDS_DESCRIPTION": "<style=cShrine>Ottieni Oro</style> <style=cSub>(scala con il costo dei forzieri)</style>.",
        "JAVANGLE_HOUSE_7HEARTS_NAME": "7 di Cuori",
        "JAVANGLE_HOUSE_7HEARTS_DESCRIPTION": "<style=cIsHealing>Cura per il 25% dei tuoi PV massimi</style>.\nInoltre, <style=cIsUtility>Garantisce</style> che il tuo prossimo colpo sarà un Colpo Perforante.",
        "JAVANGLE_HOUSE_JACKPOT_NAME": "Jackpot",
        "JAVANGLE_HOUSE_JACKPOT_DESCRIPTION": "Attiva casualmente gli effetti di ''7 di Fiori'', ''7 di Quadri'', ''7 di Cuori'' o ''7 di Picche'' con efficacia raddoppiata, 20% di probabilità di <style=cIsUtility>attivarli tutti insieme</style>.",
        "JAVANGLE_HOUSE_52_NAME": "Raccogli 52",
        "JAVANGLE_HOUSE_52_DESCRIPTION": "Scaglia carte in ogni direzione infliggendo <style=cIsDamage>danni a tutti i nemici vicini</style>.",
        "JAVANGLE_HOUSE_SNAKE_NAME": "Occhi di Serpente",
        "JAVANGLE_HOUSE_SNAKE_DESCRIPTION": "<style=cArtifact>Carica 2 Colpi Serpente</style> nella roulette, oppure subisci <style=cDeath>danni</style>.\n<style=cArtifact>Se la roulette è piena</style>, subisci <style=cDeath>danni massicci</style>.\n<style=cArtifact>Se la roulette non contiene Colpi Serpente</style>, subisci <style=cDeath>danni letali</style>.\n<style=cIsUtility>Conferisce oro proporzionale al rischio</style>.",
        "JAVANGLE_HOUSE_BUST_NAME": "Sballo",
        "JAVANGLE_HOUSE_BUST_DESCRIPTION": "<style=cDeath>Perdi {0} di salute</style>, infligge <style=cIsDamage>{1}% di danno</style> ai nemici vicini.",
        "JAVANGLE_HOUSE_SWORDS_NAME": "10 di Spade",
        "JAVANGLE_HOUSE_SWORDS_DESCRIPTION": "Spara 10 proiettili a forma di spada in avanti, impalando i nemici e infliggendo sanguinamento.",
        "JAVANGLE_HOUSE_COINS_NAME": "5 di Denari",
        "JAVANGLE_HOUSE_COINS_DESCRIPTION": "<style=cArtifact>Ottieni {0} moneta/e</style>, infligge <style=cIsDamage>{1}% di danno</style> ai nemici vicini.",
        "JAVANGLE_HOUSE_TOWER_NAME": "La Torre",
        "JAVANGLE_HOUSE_TOWER_DESCRIPTION": "<style=cArtifact>Carica 3 Colpi Serpente</style> nella roulette, oppure subisci <style=cDeath>danni</style>.\n<style=cArtifact>Se la roulette è piena</style>, subisci <style=cDeath>danni massicci</style>.\n<style=cArtifact>Se la roulette non contiene Colpi Serpente</style>, subisci <style=cDeath>danni letali</style>.\n<style=cIsUtility>Conferisce danno e armatura bonus</style>.",
        "JAVANGLE_HOUSE_JOKER_NAME": "Joker",
        "JAVANGLE_HOUSE_JOKER_DESCRIPTION": "1/6 di probabilità di <style=cArtifact>morire</style>, 4/6 di probabilità di non fare nulla e conferire il massimo di accumuli di 'Posta', 1/6 di probabilità di <style=cArtifact>annientare tutto sulla mappa</style>, conferire oggetti e rianimare i giocatori caduti.\n<style=cSub>(La rarità e la quantità di oggetti aumentano con il numero di livelli completati)</style>",
        "JAVANGLE_HOUSE_7JACK_NAME": "Fante di Quadri",
        "JAVANGLE_HOUSE_7JACK_DESCRIPTION": "Carica 6 colpi standard.\nSe a terra: scivola in avanti.",
        "JAVANGLE_HOUSE_7QUEEN_NAME": "Regina di Cuori",
        "JAVANGLE_HOUSE_7QUEEN_DESCRIPTION": "Temporaneamente <style=cIsUtility>potenzia 2 statistiche casuali</style>, ma <style=cArtifact>riduce altre 2 statistiche casuali</style>.",
        "JAVANGLE_HOUSE_7KING_NAME": "Re di Fiori",
        "JAVANGLE_HOUSE_7KING_DESCRIPTION": "Carica un Colpo Esplosivo, Perforante, a Pallini, Serpente, a Salve e Misterioso.",
        "JAVANGLE_HOUSE_7ACE_NAME": "Asso di Picche",
        "JAVANGLE_HOUSE_7ACE_DESCRIPTION": "Non carica nulla tranne 1 singolo colpo che infligge <style=cIsDamage>{0}% di danno</style> dopo un lungo ritardo.",
        "JAVANGLE_HOUSE_WILDCARD_NAME": "Carta Jolly",
        "JAVANGLE_HOUSE_WILDCARD_DESCRIPTION": "Fa qualcosa di imprevedibile. Potrebbe essere positivo, potrebbe essere negativo, potrebbe non essere nessuno dei due... forse entrambi?\n<style=cIsUtility>[Indistruttibile]</style>",
        "JAVANGLE_HOUSE_RROULETTE_NAME": "Roulette Russa",
        "JAVANGLE_HOUSE_RROULETTE_DESCRIPTION": "Spara proiettili carichi dalla roulette in rapida successione.\nInoltre, <style=cIsUtility>Trasforma casualmente</style> fino a {0} colpi nella roulette in <style=cIsUtility>munizioni speciali positive</style>.",
        "JAVANGLE_HOUSE_FORTUNE_NAME": "Ruota della Fortuna",
        "JAVANGLE_HOUSE_FORTUNE_DESCRIPTION": "50% di probabilità di <style=cShrine>raddoppiare l'oro attuale</style>, 50% di probabilità di <style=cArtifact>perdere tutto l'oro</style> ed <style=cIsUtility>estrarre un oggetto casuale</style> in base all'oro perso.",
        "JAVANGLE_HOUSE_THREEOFAKIND_NAME": "Tris",
        "JAVANGLE_HOUSE_THREEOFAKIND_DESCRIPTION": "Pesca e <style=cIsUtility>gioca l'intera mano successiva</style> tutta in una volta.",
        "JAVANGLE_HOUSE_GCLUBS_NAME": "Fiori",
        "JAVANGLE_HOUSE_GCLUBS_DESCRIPTION": "Carica <style=cIsUtility>3 Colpi Positivi casuali</style> nella roulette.\nInoltre, <style=cIsUtility>Garantisce</style> che il tuo prossimo colpo sarà un Colpo Esplosivo.",
        "JAVANGLE_HOUSE_GSPADES_NAME": "Picche",
        "JAVANGLE_HOUSE_GSPADES_DESCRIPTION": "Ottieni <style=cIsUtility>Velocità di Movimento Aumentata</style> per {0} secondi\nInoltre, <style=cIsUtility>Garantisce</style> che il tuo prossimo colpo sarà un Colpo Perforante.",
        "JAVANGLE_HOUSE_GHEARTS_NAME": "Cuori",
        "JAVANGLE_HOUSE_GHEARTS_DESCRIPTION": "<style=cIsHealing>Cura per il 50% dei tuoi PV massimi</style>",
        "JAVANGLE_HOUSE_GJACK_NAME": "Fante",
        "JAVANGLE_HOUSE_GJACK_DESCRIPTION": "Non fa nulla.",
        "JAVANGLE_HOUSE_CRAZYCARD_NAME": "Cartapazza",
        "JAVANGLE_HOUSE_CRAZYCARD_DESCRIPTION": "Attiva un'altra carta del Mazzo Standard a caso.",
        "JAVANGLE_HOUSE_CASHOUT_NAME": "Incasso",
        "JAVANGLE_HOUSE_CASHOUT_DESCRIPTION": "1/3 di probabilità di <style=cArtifact>perdere tutto il denaro</style>, 1/3 di probabilità di non fare nulla, 1/3 di probabilità di <style=cIsDamage>danneggiare ogni nemico sulla mappa</style> e <style=cIsUtility>concedere un oggetto temporaneo</style>.\n<style=cSub>(Il danno e la rarità dell'oggetto scalano con il denaro rischiato)</style>",
        "JAVANGLE_HOUSE_THESUN_NAME": "Il Sole",
        "JAVANGLE_HOUSE_THESUN_DESCRIPTION": "<style=cIsUtility>Crea un duplicato di ogni altra carta nella mano</style> e le inserisce nella mano successiva.\n<style=cSub>(Non funziona sulle carte 'Indistruttibili')</style>.\n<style=cSub>(Questo effetto non può essere attivato da altre carte)</style>.",
        "JAVANGLE_HOUSE_THEMOON_NAME": "La Luna",
        "JAVANGLE_HOUSE_THEMOON_DESCRIPTION": "<style=cIsUtility>Distrugge ogni altra carta nella mano</style>, rimuovendola dal mazzo.\n<style=cSub>(Non funziona sulle carte 'Indistruttibili')</style>.\n<style=cSub>(Questo effetto non può essere attivato da altre carte)</style>.",
        "JAVANGLE_HOUSE_THESTAR_NAME": "La Stella",
        "JAVANGLE_HOUSE_THESTAR_DESCRIPTION": "<style=cIsUtility>Distrugge tutte le carte 'Il Sole', 'La Luna', 'La Stella' e 'Il Mondo'</style> dal mazzo di pesca, dalla mano e dalla pila degli scarti, rimuovendole dal mazzo.<style=cSub>(Questo effetto non può essere attivato da altre carte)</style>.",
        "JAVANGLE_HOUSE_THEWORLD_NAME": "Il Mondo",
        "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION": "<style=cIsUtility>Distrugge tutte le carte 'Il Sole', 'La Luna', 'La Stella' e 'Il Mondo'</style> dal mazzo di pesca, dalla mano e dalla pila degli scarti, rimuovendole dal mazzo.\n<style=cSub>(Questo effetto non può essere attivato da altre carte)</style>.",
        "JAVANGLE_HOUSE_JUDGEMENT_NAME": "Il Giudizio",
        "JAVANGLE_HOUSE_JUDGEMENT_DESCRIPTION": "<style=cIsUtility>Sostituisce completamente il mazzo con la sua versione originale</style>, annullando qualsiasi modifica apportata ad esso. <style=cSub>(come se fossi rinato o avessi cambiato livello)</style>\n<style=cSub>(Questo effetto non può essere attivato da altre carte)</style>.\n<style=cIsUtility>[Indistruttibile]</style>",
        "JAVANGLE_HOUSE_KINGOFWANDS_NAME": "Re di Bastoni",
        "JAVANGLE_HOUSE_KINGOFWANDS_DESCRIPTION": "<style=cIsUtility>Consuma fino ad accumuli di 'Posta'</style>, e <style=cIsHealing>fornisce fino al % di cure</style> a seconda di quanta 'Posta' è stata spesa.\n<style=cIsHealing>Tutti gli alleati controllati vengono curati per metà dell'importo</style>.",
        "JAVANGLE_HOUSE_QUEENOFCUPS_NAME": "Regina di Coppe",
        "JAVANGLE_HOUSE_QUEENOFCUPS_DESCRIPTION": "<style=cIsUtility>Consuma fino ad accumuli di 'Posta'</style>, e fornisce un potenziamento che permette a House di <style=cIsUtility>sparare colpi carichi senza consumarli</style>.\nQuesto potenziamento dura fino a secondi, a seconda di quanta 'Posta' viene spesa.",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_NAME": "Cavaliere di Spade",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_DESCRIPTION": "<style=cIsUtility>Consuma fino ad accumuli di 'Posta'</style>, e <style=cIsUtility>carica una quantità di colpi positivi</style> pari alla 'Posta' spesa.\nInoltre, <style=cIsUtility>Garantisce</style> che il tuo prossimo colpo sarà un Colpo Esplosivo.",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_NAME": "Paggio di Denari",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_DESCRIPTION": "<style=cIsUtility>Consuma fino ad accumuli di 'Posta'</style>, ed evoca Chimere Lunari che combattono per te; maggiore è la 'Posta' spesa, maggiore sarà la forza evocata.\nCon accumuli spesi, questa carta evocherà invece un sopravvissuto casuale",
        "JAVANGLE_HOUSE_ANTEUP_NAME": "Alza la Posta!",
        "JAVANGLE_HOUSE_ANTEUP_DESCRIPTION": "<style=cIsUtility>Conferisce accumuli di 'Posta'</style>.\nOgni accumulo di Posta riduce l'armatura e aumenta la velocità di movimento e di attacco",
        "JAVANGLE_HOUSE_ANCIENTACE_NAME": "Asso Antico",
        "JAVANGLE_HOUSE_ANCIENTACE_DESCRIPTION": "Carica <style=cIsUtility>6 Colpi Misteriosi</style> nella roulette.\nInoltre, <style=cIsUtility>Conferisce uno dei seguenti effetti</style>.\n<style=cIsUtility>Coppie</style>: Ogni carta giocata si attiva due volte\n<style=cIsUtility>Colore</style>: Ogni volta che giochi una carta, gioca il resto della tua mano (saltando carte negative e casuali)\n<style=cIsUtility>Coppe</style>: Sparare con la Roulette non consuma più Munizioni\n<style=cIsUtility>[Indistruttibile]</style>",
        "ARTIFACT_OF_WILDROOM_NAME": "Artifact of Wildroom",
        "ARTIFACT_OF_WILDROOM_DESCRIPTION": "Evoca una Wildroom all'inizio di ogni livello.\nWildroom non può più svanire da sola e ora influenza i giocatori che non usano House.",
        "JAVANGLE_HOUSE_NULL_NAME": "Nullo",
        "JAVANGLE_HOUSE_NULL_DESCRIPTION": "Non fa nulla, non ricarica nemmeno.\nCe l'hai fatta, hai distrutto tutto, hai ridotto tutto a niente, e ora il niente è tutto ciò che resta... sei contento..?"
    }
}