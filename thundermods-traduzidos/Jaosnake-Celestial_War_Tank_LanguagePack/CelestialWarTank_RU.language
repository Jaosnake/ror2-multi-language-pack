    "CHEESEWITHHOLES_BASICTANK_BODY_SCORPION_DESCRIPTION": "<color=#FFFF00>Мощность двигателя: </color>1200\n<color=#00FFFF>Скорость: </color>8\nСкорость поворота: 4\n\n<color=#00FF00>Здоровье: </color>45\n<color=#FF0000>Броня: </color>2\n\n<color=#AA00FF>Сила тяги: </color>42\n<color=#ffc080>Запас топлива: </color>110\nВес: 47\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BRUISER_NAME": "Bruiser",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BRUISER_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>75\n<color=#FF0000>Броня: </color>15\n\nСкорость вращения: 40\n\nВес: 88\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TIGER_I_NAME": "Tiger I",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TIGER_I_DESCRIPTION": " <color=#80fc80>+7% к урону</color>\n <color=#fc8080>+10% к общей перезарядке</color>\n <color=#fc8080>-7% к скорости атаки</color>\n\n<color=#00FF00>Здоровье: </color>90\n<color=#FF0000>Броня: </color>18\n\nСкорость вращения: 35\n\nВес: 108\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CROMWELL_NAME": "Cromwell",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CROMWELL_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>50\n<color=#FF0000>Броня: </color>11\n\nСкорость вращения: 50\n\nВес: 55\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T62_NAME": "T62",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T62_DESCRIPTION": " <color=#80fc80>-20% к перезарядке втор. навыка</color>\n <color=#fc8080>-12% к скорости атаки</color>\n <color=#fc8080>+8% к перезарядке осн. навыка</color>\n <color=#fc8080>+8% к перезарядке спецсредств</color>\n <color=#fc8080>+8% к перезарядке особого навыка</color>\n\n<color=#00FF00>Здоровье: </color>80\n<color=#FF0000>Броня: </color>11\n\nСкорость вращения: 38\n\nВес: 91\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_NAME": "Somua S35",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_DESCRIPTION": " <color=#80fc80>+15 к шансу крит. удара</color>\n <color=#fc8080>-5% к урону</color>\n\n<color=#00FF00>Здоровье: </color>30\n<color=#FF0000>Броня: </color>8\n\nСкорость вращения: 45\n\nВес: 33\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_NAME": "Churchill",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_DESCRIPTION": "<color=#fcdf03>+3 монеты</color> каждые <style=cIsUtility>5</style> сек. <color=#7a7a7a>(+2 за уровень)</color>\n\n<color=#00FF00>Здоровье: </color>85\n<color=#FF0000>Броня: </color>12\n\nСкорость вращения: 34\n\nВес: 97\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_NAME": "Maus",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>150\n<color=#FF0000>Броня: </color>30\n\nСкорость вращения: 30\n\nВес: 180\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_NAME": "Tetrarch",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>20\n<color=#FF0000>Броня: </color>7\n\nСкорость вращения: 50\n\nВес: 27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% к скорости атаки</color>\n <color=#fc8080>-15% к регенерации здоровья</color>\n <color=#fc8080>+5% к общей перезарядке</color>\n\n<color=#00FF00>Здоровье: </color>20\n<color=#FF0000>Броня: </color>2\n\nСкорость вращения: 40\n\nВес: 20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>10\n<color=#FF0000>Броня: </color>0\n\nСкорость вращения: 55\n\nВес: 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>100\n<color=#FF0000>Броня: </color>20\n\nСкорость вращения: 33\n\nВес: 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% к перезарядке особого навыка</color>\n <color=#fc8080>+15% к перезарядке втор. навыка</color>\n <color=#fc8080>-10% к скорости атаки</color>\n\n<color=#00FF00>Здоровье: </color>120\n<color=#FF0000>Броня: </color>23\n\nСкорость вращения: 29\n\nВес: 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% к урону</color>\n <color=#fc8080>+10% к общей перезарядке</color>\n\n<color=#00FF00>Здоровье: </color>160\n<color=#FF0000>Броня: </color>0\n\nСкорость вращения: 25\nОграничение угла: 90\n\nВес: 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>45\n<color=#FF0000>Броня: </color>4\n\nСкорость вращения: 25\n\nВес: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>35\n<color=#FF0000>Броня: </color>15\n\nСкорость вращения: 35\n\nВес: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% к перезарядке осн. навыка</color>\n <color=#fc8080>+8% к перезарядке втор. навыка</color>\n <color=#fc8080>+8% к перезарядке спецсредств</color>\n <color=#fc8080>+8% к перезарядке особого навыка</color>\n <color=#fc8080>-15% к скорости атаки</color>\n\n<color=#00FF00>Здоровье: </color>35\n<color=#FF0000>Броня: </color>3\n\nСкорость вращения: 30\n\nВес: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% к урону</color>\n\n<color=#00FF00>Здоровье: </color>5\n<color=#FF0000>Броня: </color>1\n\nСкорость вращения: 40\nОграничение угла: 30\n\nВес: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ОРИГИНАЛ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "КРАСНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "СВЕТЛО-КРАСНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "ЗЕЛЁНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "ТЁМНО-ЗЕЛЁНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "СИНИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "ГОЛУБОЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "РОЗОВЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "ЯРКО-РОЗОВЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "ПУРПУРНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "ЖЁЛТЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "НЕОНОВО-ЖЁЛТЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "НЕОНОВО-ФИОЛЕТОВЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "ОРАНЖЕВЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "БЕЛЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "ЧЁРНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Меняет цвет светящихся частей машины.  Не влияет на игровой процесс.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Грязный",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Чистый",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Ломаный_камуфляж",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Пиксельный_камуфляж",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Бумажный_камуфляж",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Рифлёная_сталь",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Клёпаная_плита",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Процедурный_набор",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Красочная_смесь",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Радужный_градиент",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Монохром",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Жидкая_галактика",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Космос",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Системы двигателя",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Спецсредства и тяга расходуют топливо. Восполнение топлива зависит от <style=cIsUtility>скорости атаки</style>; запас топлива зависит от <style=cIsUtility>форсажных камер</style> и <style=cIsUtility>предметов для прыжков</style>. Танк может <style=cIsUtility>бежать в любом направлении</style>. Тяга даёт гибкий контроль в воздухе. Однако <color=#fc8080>танк не может нормально прыгать</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Суперарсенал",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "Выбор корпуса и башни влияет на здоровье, броню, скорость, тягу и массу. <style=cIsUtility>Большая масса помогает толкать тяжёлых врагов</style>; иначе вы будете сильнее подвержены <color=#ffff80>отбрасыванию</color>.\n\nБроня или скорость помогут сгладить <color=#fc8080>ужасную регенерацию здоровья</color> танка.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Небесная нестабильность",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "Танк не может выравниваться в воздухе, <color=#ffff80>легко теряя управление</color>. Приземление на крышу делает вас <color=#fc8080>обездвиженным и уязвимым на короткое время</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Полётные двигатели",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Удерживайте <style=cIsUtility>Прыжок</style> для полёта. Направление полёта зависит от наклона танка. <style=cIsUtility>Самый универсальный полёт</style>, но может быть сложен в освоении.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Импульсные двигатели",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Позволяет танку нормально <style=cIsUtility>прыгать</style>, как другим выжившим. Наклон танка активируется со 2-го прыжка. Каждый прыжок расходует <color=#ffc080>25</color> ед. топлива.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Парящие двигатели",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Позволяет танку парить над землёй. Удерживайте <style=cIsUtility>Прыжок</style> для подъёма; удерживайте <style=cIsUtility>Левый Alt</style> для снижения. Подъём расходует больше топлива.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Пулемёты",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Непрерывно стреляйте, нанося <style=cIsDamage>2x40% урона</style>.\n<style=cSub>[Вес: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Дробовик",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Выстрелите на <style=cIsDamage>12x75% урона</style>.  <color=#ffc080>Сжигайте топливо</color>, чтобы <style=cIsUtility>получать дополнительные заряды</style>; <color=#80fc80>выполните трюк</color>, чтобы временно получить мощный выстрел на <style=cIsDamage>18x150% урона</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 1с</style> | Вес: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Гранатомёт",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Выпускайте неточные снаряды, наносящие <style=cIsDamage>4x250% урона</style>.  Снаряды взрывоопасные и тяжёлые.\n<style=cSub>[<style=cIsUtility>Перезарядка: 4с</style> | <style=cIsDamage>Радиус взрыва: 5м</style> | Вес: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Ракетница",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Выпускайте точные ракеты, наносящие <style=cIsDamage>1000% урона</style>. <style=cIsDamage>Урон увеличивается по мере полёта</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 3с</style> | <style=cIsDamage>Радиус взрыва: 8м</style> | Вес: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Огнемёт",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Извергайте пламя, нанося <color=#E85E31>25% урона от горения</color> и расходуя <color=#ffc080>15 ед. топлива в секунду</color>.  Урон растёт с зарядами эффекта; <style=cIsUtility>скорость атаки увеличивает дальность</style>.\n<style=cSub>[<color=#ffc080>Работает на топливе</color> | Вес: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ультраантенна",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Ударьте себя током</color> и <style=cIsUtility>активируйте предметы, срабатывающие при убийстве</style>.  <style=cIsUtility>Соприкосновение с врагами также бьёт их током</style>, нанося <style=cIsDamage>250% урона</style> за каждый предмет с эффектом <style=cIsUtility>при убийстве</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 7с</style> | <style=cIsDamage>Радиус взрыва: 5м</style> | Вес: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Критическая пушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Выстрелите, нанося <color=#ff4d76>1200% критического урона</color>. Шанс критического удара увеличивает урон пушки.\n<style=cSub>[<style=cIsUtility>Перезарядка: 7с</style> | <style=cIsDamage>Радиус взрыва: 10м</style> | Вес: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Гаубица",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Зарядите выстрел, наносящий мощные <style=cIsDamage>7000% урона по площади</style>. <style=cIsUtility>Может отбросить танк, если выстрелить в воздухе.</style>\n<style=cSub>[<style=cIsUtility>Перезарядка: 16с</style> | <style=cIsDamage>Радиус взрыва: 15м</style> | Вес: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Отбойная пушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Неточный выстрел на <style=cIsDamage>1700% урона</style>. <style=cIsDamage>Урон уменьшается с расстоянием</style>; <style=cIsDamage>предметы со срабатыванием вместо этого увеличивают урон</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 3с</style> | <style=cIsDamage>Радиус взрыва: 5м</style> | Вес: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Пробивная пушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Выстрелите на <style=cIsDamage>2500% урона</style>.  Удерживайте для калибровки, чтобы нанести <style=cIsDamage>3500% урона</style> с возможностью <style=cIsUtility>поражать слабые места</style>.  При калибровке <color=#fc8080>движение ухудшает точность</color>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 5с</style> | <style=cIsDamage>Радиус взрыва: 2м</style> | Вес: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Французское орудие",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Выстрелите на жалкие <style=cIsDamage>550% урона</style>. Почему-то обладает <style=cIsUtility>слишком высоким коэффициентом срабатывания</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 1с</style> | Вес: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Миниган",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Стреляйте очередями по <style=cIsDamage>50% урона</style>. При 75% перегрева поджигает <color=#E85E31>огнём</color>; <color=#fc8080>перегрев блокирует орудие</color>. <style=cIsUtility>Предметы на перезарядку ускоряют охлаждение</style>; <style=cIsUtility>Запасные магазины предотвращают перегрев</style>.\n<style=cSub>[Вес: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Базовая пушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Выпустите быстрый снаряд, наносящий <style=cIsDamage>5400% урона</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 12с</style> | <style=cIsDamage>Радиус взрыва: 7м</style> | Вес: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Зенитная пушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Выстрелите на <style=cIsDamage>300% урона</style>.  Снаряд детонирует рядом с воздушными целями, нанося <style=cIsDamage>2.5x урона</style>.  <color=#fc8080>При стрельбе танк замедляется</color>.\n<style=cSub>[<style=cIsDamage>Радиус взрыва: 5.5м</style> | Вес: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Осколочная пушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Выстрелите на <style=cIsDamage>2200% урона</style> по <style=cIsUtility>большой дуге</style>, разбрасывая осколки на <style=cIsDamage>10x5% общего урона</style>.  Урон растёт с расстоянием вплоть до <style=cIsDamage>5500% урона</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 10с</style> | <style=cIsDamage>Радиус взрыва: 16м</style> | Вес: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Небесная пушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Расходует <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> ед. топлива, нанося <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>урона</color>.  Заряженные лазеры пробивают насквозь; <color=#fc8080>нехватка топлива выводит оружие из строя.</color>\n<style=cSub>[<color=#ffc080>Работает на топливе</color> | Вес: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Пушка-Облитератор",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Зарядите для автоматического выстрела <color=#E85E31>снарядом, активирующим эффекты убийства</color>, на <style=cIsDamage>12000% урона</style>.  После выстрела <color=#fc8080>способности отключаются на 4 секунды.  Снаряд может ранить союзников</color>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 21с</style> | <style=cIsDamage>Радиус взрыва: 5м</style> | Вес: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Автопушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Выпустите до 4 снарядов, каждый из которых наносит <style=cIsDamage>2000% урона</style>. Последний снаряд наносит <style=cIsDamage>2x урона</style> в фиксированной точке.\n<style=cSub>[<style=cIsUtility>Перезарядка: 14с</style> | <style=cIsDamage>Радиус взрыва: 7м</style> | Вес: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Отвал",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Рывок на небольшое расстояние</style> за <color=#ffc080>50</color> ед. топлива. Отбрасывает <style=cIsUtility>любого врага</style>, нанося <style=cIsDamage>1000% урона</style> и восполняя <color=#ffc080>40</color> ед. топлива.\n<style=cSub>[<style=cIsUtility>Перезарядка: 2с</style> | Вес: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Шипы",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Рывок на большое расстояние</style> за <color=#ffc080>50</color> ед. топлива. Тараньте врагов, нанося <color=#AA2B2A>550% урона от кровотечения</color>.  <style=cIsUtility>Без перезарядки</style>.\n<style=cSub>[Вес: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Турбо",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Ускорьтесь</style>, расходуя <color=#ffc080>30</color> ед. топлива в секунду.  Таран наносит <style=cIsDamage>250% урона</style> и восстанавливает <color=#ffc080>20</color> ед. топлива.\n<style=cSub>[<style=cIsUtility>Перезарядка: 1с</style> | Вес: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Суперпрыжок",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Подпрыгните вверх за <color=#ffc080>50</color> ед. топлива.  Во время бега вместо этого совершите рывок вперёд за <color=#ffc080>75</color> ед. топлива, вращая танком и нанося <style=cIsDamage>2500% урона</style>.  Вес танка увеличивает урон.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Бульдозер",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Ускорьтесь</style>, расходуя <color=#ffc080>20</color> ед. топлива в секунду.  Позволяет таранить <style=cIsUtility>любого врага</style>, нанося постоянные <style=cIsDamage>200% урона</style>.  Наносит <style=cIsDamage>350% урона</style> при столкновении.\n<style=cSub>[<style=cIsUtility>Перезарядка: 1с</style> | Вес: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Разрыватель",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Зарядите для <style=cIsUtility>рывка на максимальную дистанцию</style> за <color=#ffc080>100</color> ед. топлива.  <style=cIsUtility>Прорывайтесь сквозь толпы</style>, нанося <color=#AA2B2A>4000% урона от кровотечения</color> и <style=cIsUtility>продлевая рывок</style>; поверните, чтобы прервать рывок; <color=#80fc80>выполните трюк</color>, чтобы <style=cIsUtility>пропустить зарядку</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 7с</style> | Вес: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Траншеекопатель",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Удерживайте, чтобы закопаться</style>, расходуя <color=#ffc080>20</color> ед. топлива в секунду и <style=cIsUtility>защищая танк под землёй</style>.  Отпустите, чтобы вынырнуть и нанести <style=cIsDamage>900% урона</style> ближайшим врагам.  Под землёй нельзя атаковать.\n<style=cSub>[<style=cIsDamage>Радиус взрыва: 10м</style> | Вес: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Царь-мина",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Установите мину, наносящую <style=cIsDamage>3000% урона</style>.  <style=cIsDamage>Предметы со срабатыванием вместо этого увеличивают урон</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 10с</style> | <style=cIsDamage>Радиус взрыва: 10м</style> | Вес: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Мини-мины",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Прицельтесь и выпустите все мини-мины, каждая из которых наносит <style=cIsDamage>750% урона</style>.  Предметы на заряды и интерактивные объекты увеличивают максимум мин.  <color=#ffc080>Сжигайте топливо</color>, чтобы <style=cIsUtility>получать дополнительные заряды</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 3с</style> | <style=cIsDamage>Радиус взрыва: 10м</style> | Вес: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Бочкомёт",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Запустите бочку за <color=#ffc080>25</color> ед. топлива, которая взрывается при столкновении, нанося <style=cIsDamage>6500% урона</style>, и оставляет <color=#E85E31>горящую лужу</color>.  <color=#80fc80>Выполнение трюка</color> делает эту способность временно <color=#fc8080>нестабильной</color>, из-за чего <style=cIsUtility>ваш танк швыряет в воздух</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 14с</style> | <style=cIsDamage>Радиус взрыва: 18м</style> | <style=cIsDamage>Радиус зоны: 8</style> | Вес: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Самоуничтожение",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Аннигилируйте <color=#d40000>ВСЁ</color> в радиусе 35м, нанося <style=cIsDamage>100000% урона</style>.  В начале нового забега даёт <color=#80fc80>Dio's Best Friend</color>.\n<style=cSub>[<style=cIsDamage>Радиус взрыва: 35м</style> | Вес: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "ГОСПОДСТВО",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Замедлитесь и зарядите залп ракет.  Урон растёт с расстоянием вплоть до <style=cIsDamage>12x3000% урона.</style>\n<style=cSub>[<style=cIsUtility>Перезарядка: 30с</style> | <style=cIsDamage>Радиус взрыва: 10м</style> | Вес: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Уклонение",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Выпустите дымовую завесу, оглушая ближайших врагов на <style=cIsDamage>150% урона</style> и скрываясь из виду.  <style=cIsUtility>Даёт неуязвимость</style> к урону на 1 секунду.\n<style=cSub>[<style=cIsUtility>Перезарядка: 12с</style> | <style=cIsDamage>Радиус взрыва: 10м</style> | Вес: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Пассивно: Берсерк",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Убирает этот навык. Увеличивает <style=cIsDamage>базовую скорость атаки на 0.5</style> и сокращает <style=cIsUtility>перезарядку на 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Пассивно: Двигатели",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Убирает этот навык. Увеличивает <style=cIsUtility>базовую скорость на 1м/с</style> и <style=cIsUtility>силу тяги на 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Пассивно: Броня",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Убирает этот навык. Увеличивает <style=cIsUtility>базовую броню на 30</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Мастерство",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Играя за Celestial War Tank, пройдите игру или уничтожьтесь на сложности Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Мастерство",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Небесная пушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Играя за Celestial War Tank, вернитесь домой",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Небесная пушка",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Облитератор",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Играя за Celestial War Tank, нанесите более 1 000 000 ед. урона одним выстрелом.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Облитератор",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Разрыватель",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Играя за Celestial War Tank, пройдите игру или уничтожьтесь на сложности Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Разрыватель",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Живучий",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Играя за Celestial War Tank, получите 10000 ОЗ.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Живучий",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "Совершенный танк разрушения. Противостойте любым врагам, давите и крушите их своим исполинским весом и мощным оружием!\n\n<style=cSub>< ! > Танк огромен и крайне медлителен, что делает вас уязвимым для любого урона. Играйте либо предельно осторожно, либо крайне агрессивно, чтобы снизить получаемый урон. Помните, что у танка нет регенерации.\n\n< ! > Корпус танка сам по себе является оружием — давите врагов гусеницами или расплющивайте их своим весом!\n\n< ! > При опрокидывании тяжёлому танку требуется время, чтобы перевернуться обратно, и он получает больше урона от падения. Танк не может выполнять трюки.\n\n< ! > Эффекты исцеления ослаблены — у танка слишком много здоровья!\n\n< ! > Нажмите 'T', чтобы посигналить.  Настраивается в параметрах мода.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Инородный объект",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "В ходе дальнейших исследований мы выяснили происхождение этих танков — это дело рук мусорщиков. Используя качественный металлолом и предметы с корабля UES, они сумели создать эти боевые машины.\n\nОднако это наводит на опасные выводы. Заполучив одну из вражеских антенн, мы привлекли внимание этого исполинского танка. Он размером с жуков-стражей!\n\nКонечно, после затяжного боя мы всё-таки одолели его. Мы надеемся продолжить исследования и перепрограммировать его разум, чтобы получить ответы. Задача не из лёгких, ведь это ИНОПЛАНЕТНАЯ технология.\n\nОсобо стоит отметить, что перед поражением он открыл аварийный портал. Самый огромный и яростный портал из всех, что мы видели. И хотя он может привести нас прямиком к разгадке, лёгкой прогулки ждать не стоит. Даже обычный танк смертельно опасен, и страшно представить, какие ещё изобретения мусорщиков поджидают нас там.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ОРИГИНАЛ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "БЕЛЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "ЧЁРНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "КРАСНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "ТЁМНО-КРАСНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "ЗЕЛЁНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "СИНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "ГОЛУБОЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "ЖЁЛТЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "НЕОНОВО-ЖЁЛТЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "ПУРПУРНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "ФИОЛЕТОВЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "ОРАНЖЕВЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "КОРИЧНЕВЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "США",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "ГЕРМАНИЯ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "ВЕЛИКОБРИТАНИЯ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "РОССИЯ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "ФРАНЦИЯ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "Меняет цвет корпуса.  Не влияет на игровой процесс.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "ОСНОВНОЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "ГРЯЗНО-ЖЁЛТЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "ЗЕЛЁНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "ГРЯЗНО-ЗЕЛЁНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "СИНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "ГРЯЗНО-СИНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "КРАСНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "ГРЯЗНО-КРАСНЫЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "МАСТЕРСТВО",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Корпус Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Мощность двигателя: </color>3000\n<color=#00FFFF>Скорость: </color>10\nСкорость поворота: 0.8\n\n<color=#00FF00>Здоровье: </color>1000\n<color=#FF0000>Броня: </color>75\n\n<color=#AA00FF>Сила тяги: </color>35\n<color=#ffc080>Запас топлива: </color>500\nВес: 1000\n\nТип корпуса: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Корпус Griffon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Совместим с башней</color>.\n\n<color=#FFFF00>Мощность двигателя: </color>2300\n<color=#00FFFF>Скорость: </color>11\nСкорость поворота: 1\n\n<color=#00FF00>Здоровье: </color>800\n<color=#FF0000>Броня: </color>25\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас топлива: </color>500\nВес: 800\n\nТип корпуса: Машина",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "Корпус TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Мощность двигателя: </color>1200\n<color=#00FFFF>Скорость: </color>12\nСкорость поворота: 2\n\n<color=#00FF00>Здоровье: </color>500\n<color=#FF0000>Броня: </color>25\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас топлива: </color>300\nВес: 450\n\nТип корпуса: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Корпус Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Мощность двигателя: </color>3500\n<color=#00FFFF>Скорость: </color>8\nСкорость поворота: 0.6\n\n<color=#00FF00>Здоровье: </color>1400\n<color=#FF0000>Броня: </color>100\n\n<color=#AA00FF>Сила тяги: </color>34\n<color=#ffc080>Запас топлива: </color>750\nВес: 1250\n\nТип корпуса: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Корпус Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Даёт больше <style=cIsUtility>контроля в воздухе</style>.\n\n\n<color=#FFFF00>Мощность двигателя: </color>2000\n<color=#00FFFF>Скорость: </color>13\nСкорость поворота: 1.4\n\n<color=#00FF00>Здоровье: </color>600\n<color=#FF0000>Броня: </color>20\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас топлива: </color>450\nВес: 750\n\nТип корпуса: Машина",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "Корпус AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>Вес не влияет на скорость</style>.\n\n<color=#FFFF00>Мощность двигателя: </color>700\n<color=#00FFFF>Скорость: </color>9\nСкорость поворота: 0.7\n\n<color=#00FF00>Здоровье: </color>900\n<color=#FF0000>Броня: </color>50\n\n<color=#AA00FF>Сила тяги: </color>35\n<color=#ffc080>Запас топлива: </color>370\nВес: 1100\n\nТип корпуса: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "Корпус TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Мощность двигателя: </color>3700\n<color=#00FFFF>Скорость: </color>8\nСкорость поворота: 0.5\n\n<color=#00FF00>Здоровье: </color>1150\n<color=#FF0000>Броня: </color>60\n\n<color=#AA00FF>Сила тяги: </color>34\n<color=#ffc080>Запас топлива: </color>1000\nВес: 1200\n\nТип корпуса: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Корпус Pigeon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Совместим с башней</color>.\n\n<color=#FFFF00>Мощность двигателя: </color>1500\n<color=#00FFFF>Скорость: </color>7\nСкорость поворота: 1.4\n\n<color=#00FF00>Здоровье: </color>150\n<color=#FF0000>Броня: </color>5\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас топлива: </color>300\nВес: 100\n\nТип корпуса: Машина",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Корпус Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Может карабкаться по стенам</style>. Прыжок задерживается на секунду, а <color=#fc8080>урон от тарана снижен на 50%</color>.\n\n\n<color=#FFFF00>Мощность двигателя: </color>2750\n<color=#00FFFF>Скорость: </color>9\nСкорость поворота: 0.8\n\n<color=#00FF00>Здоровье: </color>1300\n<color=#FF0000>Броня: </color>90\n\n<color=#AA00FF>Сила тяги: </color>31\n<color=#ffc080>Запас топлива: </color>550\nВес: 1300\n\nТип корпуса: Мех",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "Корпус TANKDOZER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "Отвал <style=cIsUtility>блокирует</style> весь <style=cIsDamage>входящий урон</style>.\n\nРежим ПТ-САУ: <color=#fc8080>Нельзя установить башню</color>.\n\n<color=#FFFF00>Мощность двигателя: </color>2500\n<color=#00FFFF>Скорость: </color>8.5\nСкорость поворота: 0.9\n\n<color=#00FF00>Здоровье: </color>1250\n<color=#FF0000>Броня: </color>80\n\n<color=#AA00FF>Сила тяги: </color>34\n<color=#ffc080>Запас топлива: </color>500\nВес: 1200\n\nТип корпуса: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Корпус Truck Kan",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "Урон от тарана увеличен на <color=#80fc80>100.0%</color>\n\n<color=#80fc80>Совместим с башней</color>.\n<style=cIsUtility>Вес не влияет на скорость</style>.\n\n<color=#FFFF00>Мощность двигателя: </color>1000\n<color=#00FFFF>Скорость: </color>12\nСкорость поворота: 0.9\n\n<color=#00FF00>Здоровье: </color>450\n<color=#FF0000>Броня: </color>15\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас топлива: </color>600\nВес: 600\n\nТип корпуса: Машина",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>250\n<color=#FF0000>Броня: </color>25\n\nСкорость вращения: 7.5\n\nВес: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Башня",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>100\n<color=#FF0000>Броня: </color>10\n\nСкорость вращения: 20\n\nВес: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>100\n<color=#FF0000>Броня: </color>15\n\nСкорость вращения: 15\n\nВес: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>400\n<color=#FF0000>Броня: </color>50\n\nСкорость вращения: 5\n\nВес: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% урона</style>?  Я не смог найти в коде место, где увеличивается урон для этой конкретной башни.\n- Разработчик\n\n\n<color=#00FF00>Здоровье: </color>150\n<color=#FF0000>Броня: </color>25\n\nСкорость вращения: 13\nОграничение угла: 60\n\nВес: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Добавляет <style=cIsDamage>5 зарядов</style> <style=cIsUtility>вторичному</style> навыку.\n<style=cIsUtility>Восстанавливает все заряды</style> после перезарядки.\nУрон пушки снижается на 80%\n\n<color=#00FF00>Здоровье: </color>300\n<color=#FF0000>Броня: </color>20\n\nСкорость вращения: 7\n\nВес: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>200\n<color=#FF0000>Броня: </color>30\n\nСкорость вращения: 9\n\nВес: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Здоровье: </color>300\n<color=#FF0000>Броня: </color>35\n\nСкорость вращения: 7\n\nВес: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Тяжёлый вес",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "Танк может <style=cIsUtility>давить врагов</style>, причём <style=cIsDamage>урон зависит от скорости</style>.  При падении в тяжёлой комплектации ваш вес создаёт <style=cIsUtility>ударную волну</style>, наносящую урон врагам поблизости.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Нет",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Убирает этот навык.  Увеличивает следующие характеристики:\n\nСкорость атаки: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Нет",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Нет",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Убирает этот навык.  Увеличивает следующие характеристики:\n\nСкорость: <color=#80fc80>+1</color> м/с\nМощность тяги: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Нет",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Убирает этот навык.  Увеличивает броню на <color=#80fc80>30</color> и увеличивает запас топлива на <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Мини-пушка",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Неточная стрельба на <style=cIsDamage>200% урона.</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "ЭМИ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Воспламените свой щит и создайте ЭМИ на <style=cIsDamage>2000% урона</style>, поражающий врагов током!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "Вмещает огромный запас до 22 ракет! Каждая наносит от <style=cIsDamage>1100% урона</style> до <style=cIsDamage>1800% урона</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Скорострельная автопушка",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Стреляйте по врагам разрывными снарядами, нанося <style=cIsDamage>500% урона</style>. Требуется перезарядка каждые 4 секунды.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Могучая пушка",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Выстрелите на <style=cIsDamage>7500% урона</style>, отбрасывая врагов.\n<style=cSub>[<style=cIsUtility>Перезарядка: 16с</style> | <style=cIsDamage>Радиус взрыва: 12.5м</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Артиллерийское орудие",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Удерживайте для прицеливания</style> и отпустите, чтобы выпустить мощный снаряд на <style=cIsDamage>7000% урона</style>.  Урон растёт с расстоянием вплоть до <style=cIsDamage>14000% урона</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 16с</style> | <style=cIsDamage>Радиус взрыва: 12.5м</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Криопушка",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Выпустите гигантский снежок, наносящий <color=#75EAFF>1500% урона</color> и замораживающий врагов.\n<style=cSub>[<style=cIsUtility>Перезарядка: 5с</style> | <style=cIsDamage>Радиус взрыва: 10м</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Двуствольная пушка",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Выстрелите на <style=cIsDamage>5400% урона</style>. Удерживайте, чтобы выпустить 2 снаряда, что затем <color=#fc8080>увеличивает время перезарядки навыка</color>. Двойной выстрел <color=#80fc80>сильно сокращает</color> время следующей зарядки в течение 2 секунд.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "Британская пушка",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Выстрелите на <style=cIsDamage>2400% урона</style>.  <color=#fc8080>Не активирует эффекты предметов</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Большая грозная пушка",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Выстрелите на <style=cIsDamage>2000% урона</style>.  <style=cIsUtility>Удерживайте для зарядки</style>, чтобы нанести до <style=cIsDamage>11000% урона</style>.  При максимальном заряде пушка автоматически выстреливает, нанося дополнительно <style=cIsDamage>5500% урона лазером</style> с <style=cIsUtility>дополнительным отбрасыванием</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Эксперимент Oppenheimer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Позвольте снаряду разрушить ваш щит и аннигилируйте врагов, нанося <color=#ff4d76>9000% критического урона</color>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Реактивные сопла",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Включите зажигание, расходуя <color=#ffc080>70 ед. топлива</color> в секунду и позволяя танку со временем набирать всё большую скорость.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Цикл питания",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Активируйте для переключения между 3 режимами — Уклонение, Атака или Защита: \n\n<style=cIsUtility>Уклонение</style>: снижает скорость атаки на 50% и увеличивает перезарядку на 50% взамен на дополнительные 50% скорости, 10% силы тяги и 50% мощности двигателя!\n\n<color=#80fc80>Защита</color>: жертвует 70% скорости и 100% силы тяги ради 500 ед. брони.\n\n<style=cIsDamage>Атака</style>: всё оружие наносит двойной урон. Сокращает перезарядку на 33% и увеличивает скорость атаки на 33%, но лишает ВСЕЙ брони и исцеления. Активация этого режима бьёт танк током на 2 секунды.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Разгон",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Позвольте скорости разрушить ваш щит и вызовите мощный взрыв двигателей на <style=cIsDamage>6000% урона</style>, подбрасывающий вас в воздух и <style=cIsUtility>предотвращающий урон от падения</style>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Щиты",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "Активируйте, чтобы стать <style=cIsUtility>неуязвимым к внешнему урону</style> на 4 секунды.  Можно пожертвовать ради однократной <color=#03fcc2>силовой способности</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Шквальный залп",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Выстрелите из 4 пушек, каждая из которых наносит <style=cIsDamage>1400% урона</style> в огромном радиусе. Оружие <color=#fc8080>перегревается</color> вместо перезарядки.\n<style=cSub>[<style=cIsDamage>Радиус взрыва: 10м</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Стандартное",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Стандартное управление.\n\nТанк движется и поворачивает в выбранном направлении движения.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Альтернативное",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Меняет стиль управления этим танком.\n\nТанк движется по направлению корпуса, но <color=#fc8080>не поворачивает автоматически в сторону движения</color>.  Поворот осуществляется <style=cIsUtility>вручную</style>.\n\nВ полёте управление переключается на Стандартное.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Силовой режим: <style=cIsUtility>Уклонение</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Снижает скорость атаки на 50% и увеличивает перезарядку на 50% взамен на дополнительные 50% скорости, 10% силы тяги и 50% мощности двигателя.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Силовой режим: <color=#80fc80>Защита</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "Жертвует 70% скорости и 100% силы тяги ради 500 ед. брони.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Силовой режим: <style=cIsDamage>Атака</style>",
