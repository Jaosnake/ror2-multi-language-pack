{
  "eo": {
    "POPCORN_ARSONIST_BODY_NAME": "Arsonist",
    "POPCORN_ARSONIST_BODY_DESCRIPTION": "Arsonist estas proksimbatala tanko, kiu uzas fajron kiel rimedon por sia celo. Regi lian Trovarmigxan mezurilon permesas al li fari grandegan damagxon al grupoj da malamikoj. Ekvilibro estas kerna por venko.<color=#CCD3E0>\n\n< ! > Viaj atakoj estas pli malfortaj dum vi trovarmigxas. Se vi estas en embaraso, Purigo povas tuj fini la trovarmigxan periodon intersxangxe por plilongigi sian malvarmigxan tempon.\n\n< ! > La Antauxgxuaj stakoj de Masohxismo dauxre akumuligxas dum la dauxro de la kapablo, kio signifas, ke vi povas aktivigi gxin frue kaj eliri kun la maksimuma dauxro.\n\n< ! > Purigo povas forigi la fajran malavantagxon de via pasiva kapablo. Uzu gxin por eliri el dangxera situacio.\n\n</color>",
    "POPCORN_ARSONIST_BODY_SUBTITLE": "Mania Incendiisto",
    "POPCORN_ARSONIST_BODY_LORE": "S o n r e g i s t r a j x o  p r e n i t a  e l  p e r s o n a  r e g i s t r i l o .\r\n\r\nP r e s a n t e  t r a n s s k r i b o n . . .\r\n\r\nAligxi al UES montrigxis facila. Precipe kun iliaj laboranoncoj. \r\n\r\nMalkonstrua fakulo ne multe diferencas de la laboro, kiun mi jam faras. Kaj jes, krimbruligo estas laboro. La armeo estis suficxe afabla por lasi la malnovan ekipajxon de la Incendia Unuo kusxi cxirkauxe, por ke akraj okuloj kiel miaj trovu gxin. Ne estis malfacile ekscii gxuste kion ili provis fari per tiu unuo, kaj estis damna domagxo, ke ili fermis gxin.\r\n\r\nIli estis brilaj. Ili estis brilaj, kaj UES diris al ili, ke ili estas psikopatoj. Mi apenaux povis savi la restajxojn de tio malmulta, kio ne estis tute detruita. Ecx tiam, mi ne havis multan sxancon testi miajn restauxrojn pro la alta sekureco de mia sekcio.\r\n\r\nMi auxdis de kolego, ke okazas tasko. Iaspeca savmisio sur la UES Safe Travels al neesplorita planedo. Mi auxdis rakontojn pri tiu loko, ne tre agrablajn pri la kreitajxoj, kiuj vivas tie.\r\n\r\nHm.\r\n\r\nEble mi iros. Sxajnas, ke mi trovos tre bonajn laboratoriajn ratojn.\r\n\r\nF i n o  d e  r e g i s t r a j x o .\r\n\r\n",
    "POPCORN_ARSONIST_BODY_OUTRO_FLAVOR": "..kaj tiel li foriris, kun nova sangavido ekflaminta.",
    "POPCORN_ARSONIST_BODY_OUTRO_FAILURE": "..kaj tiel li malaperis, kun sia sola bedauxro: nefinita laboro.",
    "POPCORN_ARSONIST_BODY_DEFAULT_SKIN_NAME": "Arsonist",
    "POPCORN_ARSONIST_BODY_MASTERY_SKIN_NAME": "Jupio",
    "POPCORN_ARSONIST_BODY_GRANDMASTERY_SKIN_NAME": "Piromaniulo",
    "POPCORN_ARSONIST_BODY_SURVIVAL_SKIN_NAME": "Anarhxisto",
    "POPCORN_ARSONIST_BODY_PASSIVE_NAME": "Piromanio",
    "POPCORN_ARSONIST_BODY_PASSIVE_DESCRIPTION": "Rezistu fajran damagxon el cxiuj fontoj. Konvertas unu atakon, kiu faras pli ol <style=cIsDamage>30%</style> de la tuta sano, al <style=cIsDamage>50%</style> fajra damagxo dum tempo.",
    "POPCORN_ARSONIST_BODY_PASSIVE_NORMAL_GAUGE_NAME": "Normala Mezurilo",
    "POPCORN_ARSONIST_BODY_PASSIVE_NORMAL_GAUGE_DESCRIPTION": "Faradas <style=cIsDamage>100%</style> damagxon en la blanka parto. Baza Mezurilo estas rezista al Trovarmigxo.",
    "POPCORN_ARSONIST_BODY_PASSIVE_BLUE_GAUGE_NAME": "Superkritika Mezurilo",
    "POPCORN_ARSONIST_BODY_PASSIVE_BLUE_GAUGE_DESCRIPTION": "Faradas <style=cIsDamage>70%</style> damagxon en la blanka parto kaj <style=cIsDamage>250%</style> damagxon en la blua parto. Maksimuma varmo estas fiksa.",
    "POPCORN_ARSONIST_BODY_PRIMARY_FIRESPRAY_NAME": "Fajrobulo",
    "POPCORN_ARSONIST_BODY_PRIMARY_FIRESPRAY_DESCRIPTION": "<style=cIsUtility>Varmo. </style>Pafas fajrobulon, kiu faras <style=cIsDamage>225% damagxon kaj ekbruligas</style> malamikojn cxe trafo.",
    "POPCORN_ARSONIST_BODY_ALT_PRIMARY_FIRESPRAY_NAME": "Superpelado",
    "POPCORN_ARSONIST_BODY_ALT_PRIMARY_FIRESPRAY_DESCRIPTION": "<style=cIsUtility>Varmo. </style><style=cIsUtility>Superkritika. </style>Pafas fajrobulon, kiu faras <style=cIsDamage>160% damagxon kaj ekbruligas</style> malamikojn cxe trafo.",
    "POPCORN_ARSONIST_BODY_PRIMARY_FLAMETHROWER_NAME": "Draka Spiro",
    "POPCORN_ARSONIST_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Pafas faskon da fajro, kiu faras <style=cIsDamage>90%</style> damagxon. Havas pligrandigitan sxancon ekbruligi ju pli proksime vi estas al la celo.",
    "POPCORN_ARSONIST_BODY_PRIMARY_FIRESPRAY_SCEPTER_NAME": "Fajrosxtormo",
    "POPCORN_ARSONIST_BODY_PRIMARY_FIRESPRAY_SCEPTER_DESCRIPTION": "<style=cIsUtility>Varmo. </style>Pafas trapikantan radion de intensa varmo, kiu faras <style=cIsDamage>300% damagxon kaj ekbruligas</style> malamikojn cxe trafo. Se tenata dum mallonga tempo, pafas detruan radion, kiu faras <style=cIsDamage>450% damagxon</style> cxe liberigo.",
    "POPCORN_ARSONIST_BODY_PRIMARY_FLAMETHROWER_SCEPTER_NAME": "Riprocxo de Dante",
    "POPCORN_ARSONIST_BODY_PRIMARY_FLAMETHROWER_SCEPTER_DESCRIPTION": "Pafas intensan radion, kiu faras <style=cIsDamage>140% damagxon.</style> Havas pligrandigitan sxancon ekbruligi ju pli proksime vi estas al la celo. Se tenata dum 2 sekundoj aux pli, pafas finan radion cxe liberigo por <style=cIsDamage>150% damagxo.</style>",
    "POPCORN_ARSONIST_BODY_SECONDARY_FLAREGUN_NAME": "Signala Flamo",
    "POPCORN_ARSONIST_BODY_SECONDARY_FLAREGUN_DESCRIPTION": "Pafas signalan flamon, kiu faras <style=cIsDamage>400%</style> damagxon dum 5 sekundoj, poste eksplodas por <style=cIsDamage>400%</style> damagxo, lancxante 5 flamojn, kiuj faras po <style=cIsDamage>200%</style> damagxon.",
    "POPCORN_ARSONIST_BODY_SECONDARY_PUNCH_NAME": "Nulpunkta Eksplodo",
    "POPCORN_ARSONIST_BODY_SECONDARY_PUNCH_DESCRIPTION": "<style=cIsUtility>Agila. Varmo. </style>Peladas vin antauxen, eksplodante malamikojn malantaux vi por <style=cIsDamage>200% damagxo</style>. Kolizii baldaux post lancxo kun la unua malamiko faras <style=cIsDamage>200% damagxon</style> per eksplodo cxirkaux vi.",
    "POPCORN_ARSONIST_BODY_UTILITY_CLEANSE_NAME": "Purigo",
    "POPCORN_ARSONIST_BODY_UTILITY_CLEANSE_DESCRIPTION": "<style=cIsUtility>Agila. Varmo. </style><style=cIsDamage>Ekbruligas</style> la areon cxirkaux vi, farante <style=cIsDamage>50%</style> damagxon al proksimaj malamikoj kaj forbruligante aliajn statusefektojn. Donas malgrandan rapidpligrandigon.",
    "POPCORN_ARSONIST_BODY_SPECIAL_MASOCHIST_NAME": "Masohxismo",
    "POPCORN_ARSONIST_BODY_SPECIAL_MASOCHIST_DESCRIPTION": "<style=cIsUtility>Agila. Varmo. </style>Damagxo pro esti <style=cIsDamage>Ekbruligita</style> igxas <style=cIsHealing>kuracado</style> dum 6.5 sekundoj. Pligrandigas atakrapidecon je <style=cIsDamage>125%</style>.",
    "POPCORN_ARSONIST_BODY_SPECIAL_MASOCHISM_NAME": "Masohxismo",
    "POPCORN_ARSONIST_BODY_SPECIAL_MASOCHISM_DESCRIPTION": "Atinginte la sojlon de Antauxgxuo, periode damagxu vin mem intersxangxe por area brulanta Vivsxtelo. Post maksimume 10 sekundoj, <style=cIsDamage>Detonacii</style>, poste Trovarmigxu.",
    "POPCORN_ARSONIST_BODY_SPECIAL_MASOCHISM_SURGE_NAME": "Spito",
    "POPCORN_ARSONIST_BODY_SPECIAL_MASOCHISM_SURGE_DESCRIPTION": "Atinginte la sojlon de Antauxgxuo, vi movigxas pli rapide kaj ricevas Duoblan Pafon kaj Vivsxtelon. Post maksimume 10 sekundoj, <style=cIsDamage>Detonacii</style>, poste Trovarmigxu.",
    "POPCORN_ARSONIST_BODY_KEYWORD_PASSIVE": "<style=cKeywordName>Varmo</style>Kapabloj pligrandigas/malpligrandigas varmon. Cxe maksimuma varmo, Arsonist trovarmigxas, malfortigante siajn kapablojn kaj kauxzante pli longajn malvarmigxajn tempojn. Atakrapideco pligrandigas la malvarmigxan ritmon. La elektita cxeffajro sxangxas la varmomezurilon.",
    "POPCORN_ARSONIST_BODY_KEYWORD_BASEGAUGE": "<style=cKeywordName>Baza Mezurilo</style>Varmomezurilo kreskas po nivelo kaj ankaux per sxargx-bazitaj objektoj. Malvarmigxa ritmo ankaux kreskas cxe pli altaj procentoj de varmo.",
    "POPCORN_ARSONIST_BODY_KEYWORD_CRITICALGAUGE": "<style=cKeywordName>Superkritika Mezurilo</style>Varmomezurilo ne kreskas; anstatauxe superkritika mezurilo kreskas po nivelo kaj per sxargx-bazitaj objektoj. Gajnu 2.5x damagxon dum varmo estas en la blua parto de la mezurilo.",
    "POPCORN_ARSONIST_BODY_KEYWORD_FIRESPRAYHEAT": "<style=cKeywordName>Varmo</style>Kostas <style=cIsDamage>10 varmon</style>. Malpligrandigita damagxo kaj rapideco dum trovarmigxo.",
    "POPCORN_ARSONIST_BODY_KEYWORD_PRIMARYHEAT": "<style=cKeywordName>Varmo</style>Cxeffajro altigas varmon, cxiuj aliaj kapabloj malaltigas varmon. Cxe maksimuma varmo, Arsonist trovarmigxas, provizore malpligrandigante atakrapidecon kaj damagxon.",
    "POPCORN_ARSONIST_BODY_KEYWORD_FLAREHEAT": "<style=cKeywordName>Varmo</style>Malpligrandigas Varmon je <style=cIsDamage>0.3x</style> de la aktuala akumulita varmo. Duona damagxo dum trovarmigxo.",
    "POPCORN_ARSONIST_BODY_KEYWORD_ZEROPOINTHEAT": "<style=cKeywordName>Varmo</style>Malvarmigas <style=cIsUtility>duonon de la AKTUALA varmo</style>. Duona damagxo dum trovarmigxo.",
    "POPCORN_ARSONIST_BODY_KEYWORD_CLEANSEHEAT": "<style=cKeywordName>Varmo</style>Malvarmigas <style=cIsUtility>duonon de la TUTA varmo</style>. Akcelas malvarmigxon dum trovarmigxo, tamen sen ekbruligo.",
    "POPCORN_ARSONIST_BODY_KEYWORD_MASOCHISMHEAT": "<style=cKeywordName>Varmo</style>Kostas <style=cIsDamage>50 varmon</style>. Duona kuracado dum trovarmigxo.",
    "POPCORN_ARSONIST_BODY_KEYWORD_FLARENOTE": "La signala flamo ne disigxos krom se gxi trafas celon, estas surpasita aux malamiko estas trafita de la eksplodo.",
    "POPCORN_ARSONIST_BODY_KEYWORD_PYROMANIAPASSIVE": "Piromanio ne influas faldamagxon krom se Fragileco estas aktiva.",
    "POPCORN_ARSONIST_BODY_KEYWORD_BASEGAUGEPASSIVE": "Sxargx-bazitaj objektoj pligrandigas maksimuman varmon. Pligrandigi atakrapidecon akcelas varmdisigxon.",
    "POPCORN_ARSONIST_BODY_KEYWORD_SUPERCRITICALPASSIVE": "Sxargx-bazitaj objektoj pligrandigas la bluan parton. Pligrandigi atakrapidecon akcelas varmdisigxon.",
    "POPCORN_ARSONIST_BODY_KEYWORD_MASO_ANTICIPATION": "<style=cKeywordName>Antauxgxuo</style>Por cxiuj 100 varmoj perditaj kaj/aux gajnitaj, Arsonist gajnas 1 stakon de Antauxgxuo; post gajno de 5 stakoj, li povas aktivigi Masohxismon; pliaj stakoj pligrandigas damagxon kaj dauxron; cxiuj stakoj elcxerpigxas cxe la fino.",
    "POPCORN_ARSONIST_BODY_KEYWORD_MASO_ANTICIPATION_SPITE": "<style=cKeywordName>Antauxgxuo</style>Por cxiuj 100 varmoj perditaj kaj/aux gajnitaj, Arsonist gajnas 1 stakon de Antauxgxuo; post gajno de 5 stakoj, li povas aktivigi Spiton. Pliaj stakoj pligrandigas damagxon kaj dauxron. La nombro da stakoj forigitaj cxe la fino rilatas al kiom longe vi restas en la stato.",
    "POPCORN_ARSONIST_BODY_KEYWORD_MASO_LIFESTEAL": "<style=cKeywordName>Vivsxtelo</style>Arsonist kuracas 18% de sia farita damagxo dum Masohxismo estas aktiva.",
    "POPCORN_ARSONIST_BODY_KEYWORD_MASO_SURGE_LIFESTEAL": "<style=cKeywordName>Vivsxtelo</style>Arsonist kuracas 5% de sia farita damagxo dum Spito estas aktiva.",
    "POPCORN_ARSONIST_BODY_KEYWORD_MASO_DETONATE": "<style=cKeywordName>Detonacii</style>Arsonist eksplodas, farante <style=cIsDamage>150% damagxon</style> multiplikitan per la nombro da akumulitaj Antauxgxuaj stakoj.",
    "POPCORN_ARSONIST_BODY_KEYWORD_MASO_DETONATE_SPITE": "<style=cKeywordName>Detonacii</style>Arsonist eksplodas, farante <style=cIsDamage>70% damagxon</style> multiplikitan per la nombro da akumulitaj Antauxgxuaj stakoj.",
    "POPCORN_ARSONIST_BODY_KEYWORD_MASO_DOUBLE_TAP": "<style=cKeywordName>Duobla Pafo</style>Pafas du projektilojn por la varmokosto de unu.",
    "POPCORN_ARSONIST_BODY_KEYWORD_OVERHEAT_MASO": "<style=cKeywordName>Trovarmigxo: Masohxismo</style>Se Arsonist eliras el Masohxismo pro troa varmoakumulado, EX-Trovarmigxo estas aplikata, malpligrandigante vian Movrapidecon kaj Damagxon al 70%. Nuligi aux lasi la kapablon fini sian dauxron aplikas Trovarmigxon, malpligrandigante vian Atakrapidecon al 50%.",
    "POPCORN_ARSONIST_BODY_OVERHEAT_TEXT": "TROVARMIGXO!",
    "POPCORN_ARSONIST_BODY_OVERHEAT_EX_TEXT": "TROVARMIGXO:EX!",
    "POPCORN_ARSONIST_BODY_COOLING_TEXT": "MALVARMIGXAS...!",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Arsonist: Majstreco",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESCRIPTION": "Kiel Arsonist, venku la ludon aux neniigu vin en Monsoon.",
    "POPCORN_ARSONIST_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Arsonist: Majstreco",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_ECLIPSE5UNLOCKABLE_ACHIEVEMENT_NAME": "Arsonist: Grandmajstreco",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_ECLIPSE5UNLOCKABLE_ACHIEVEMENT_DESCRIPTION": "Kiel Arsonist, venku la ludon en Eclipse 5 aux pli alte, AUX venku la ludon en Typhoon (Starstorm 2 mod necesa).",
    "POPCORN_ARSONIST_BODY_ECLIPSE5UNLOCKABLE_UNLOCKABLE_NAME": "Arsonist: Grandmajstreco",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_ECLIPSE8UNLOCKABLE_ACHIEVEMENT_NAME": "Arsonist: Transvivo",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_ECLIPSE8UNLOCKABLE_ACHIEVEMENT_DESCRIPTION": "Kiel Arsonist, venku la ludon en Eclipse 8, AUX venku la ludon en Inferno (Inferno mod necesa).",
    "POPCORN_ARSONIST_BODY_ECLIPSE8UNLOCKABLE_UNLOCKABLE_NAME": "Arsonist: Transvivo",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_FLAMETHROWERUNLOCKABLE_ACHIEVEMENT_NAME": "Arsonist: Piromaniulo",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_FLAMETHROWERUNLOCKABLE_ACHIEVEMENT_DESCRIPTION": "Kiel Arsonist, venku etapon sen trovarmigxi.",
    "POPCORN_ARSONIST_BODY_FLAMETHROWERUNLOCKABLE_UNLOCKABLE_NAME": "Arsonist: Piromaniulo",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_ARSONISTUNLOCKABLE_ACHIEVEMENT_NAME": "Brajxoj",
    "ACHIEVEMENT_POPCORN_ARSONIST_BODY_ARSONISTUNLOCKABLE_ACHIEVEMENT_DESCRIPTION": "Mortigu teleportilan estron dum gxi estas ekbruligita.",
    "POPCORN_ARSONIST_BODY_ARSONISTUNLOCKABLE_UNLOCKABLE_NAME": "Brajxoj"
  }
}
