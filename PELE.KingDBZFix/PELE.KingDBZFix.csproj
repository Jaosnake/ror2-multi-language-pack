<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PELE.KingDBZFix</AssemblyName>
    <RootNamespace>PELE.KingDBZFix</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(ProgramFiles)\Steam\steamapps\common\Risk of Rain 2\Risk of Rain 2_Data\Managed</GameManagedPath>
    <ProfileCorePath Condition="'$(ProfileCorePath)' == ''">$(AppData)\Thunderstore Mod Manager\DataFolder\RiskOfRain2\profiles\Default\BepInEx\core</ProfileCorePath>
    <ProfilePluginsPath Condition="'$(ProfilePluginsPath)' == ''">$(AppData)\Thunderstore Mod Manager\DataFolder\RiskOfRain2\profiles\Default\BepInEx\plugins</ProfilePluginsPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(ProfileCorePath)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ProfileCorePath)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RoR2">
      <HintPath>$(GameManagedPath)\RoR2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedPath)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="KingModUtilities">
      <HintPath>$(ProfilePluginsPath)\kinggrinyov-KingModUtilities\KingModUtilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
