    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "ORANGXA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "BRUNA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "USONO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "GERMANIO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "UNUIGXINTA REGXLANDO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "RUSIO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "FRANCIO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "Tio sxangxas la korpan koloron.  Ne influas la ludmanieron.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "CXEFA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "MALPURA FLAVA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "VERDA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "MALPURA VERDA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "BLUA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "MALPURA BLUA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "RUGXA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "MALPURA RUGXA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "MAJSTRECO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Kareno Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Motora Potenco: </color>3000\n<color=#00FFFF>Rapideco: </color>10\nTurnigxa Rapideco: 0.8\n\n<color=#00FF00>Sano: </color>1000\n<color=#FF0000>Kiraso: </color>75\n\n<color=#AA00FF>Pusxa Potenco: </color>35\n<color=#ffc080>Brulajxa Kvanto: </color>500\nPezo: 1000\n\nKarena Tipo: Tanko",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Kareno Griffon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Kongrua kun kanonturo</color>.\n\n<color=#FFFF00>Motora Potenco: </color>2300\n<color=#00FFFF>Rapideco: </color>11\nTurnigxa Rapideco: 1\n\n<color=#00FF00>Sano: </color>800\n<color=#FF0000>Kiraso: </color>25\n\n<color=#AA00FF>Pusxa Potenco: </color>40\n<color=#ffc080>Brulajxa Kvanto: </color>500\nPezo: 800\n\nKarena Tipo: Auxto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "Kareno TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Motora Potenco: </color>1200\n<color=#00FFFF>Rapideco: </color>12\nTurnigxa Rapideco: 2\n\n<color=#00FF00>Sano: </color>500\n<color=#FF0000>Kiraso: </color>25\n\n<color=#AA00FF>Pusxa Potenco: </color>40\n<color=#ffc080>Brulajxa Kvanto: </color>300\nPezo: 450\n\nKarena Tipo: Tanko",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Kareno Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Motora Potenco: </color>3500\n<color=#00FFFF>Rapideco: </color>8\nTurnigxa Rapideco: 0.6\n\n<color=#00FF00>Sano: </color>1400\n<color=#FF0000>Kiraso: </color>100\n\n<color=#AA00FF>Pusxa Potenco: </color>34\n<color=#ffc080>Brulajxa Kvanto: </color>750\nPezo: 1250\n\nKarena Tipo: Tanko",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Kareno Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Donas pli da <style=cIsUtility>aera kontrolo</style>.\n\n\n<color=#FFFF00>Motora Potenco: </color>2000\n<color=#00FFFF>Rapideco: </color>13\nTurnigxa Rapideco: 1.4\n\n<color=#00FF00>Sano: </color>600\n<color=#FF0000>Kiraso: </color>20\n\n<color=#AA00FF>Pusxa Potenco: </color>40\n<color=#ffc080>Brulajxa Kvanto: </color>450\nPezo: 750\n\nKarena Tipo: Auxto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "Kareno AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>Rapideco ne estas influa de pezo</style>.\n\n<color=#FFFF00>Motora Potenco: </color>700\n<color=#00FFFF>Rapideco: </color>9\nTurnigxa Rapideco: 0.7\n\n<color=#00FF00>Sano: </color>900\n<color=#FF0000>Kiraso: </color>50\n\n<color=#AA00FF>Pusxa Potenco: </color>35\n<color=#ffc080>Brulajxa Kvanto: </color>370\nPezo: 1100\n\nKarena Tipo: Tanko",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "Kareno TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Motora Potenco: </color>3700\n<color=#00FFFF>Rapideco: </color>8\nTurnigxa Rapideco: 0.5\n\n<color=#00FF00>Sano: </color>1150\n<color=#FF0000>Kiraso: </color>60\n\n<color=#AA00FF>Pusxa Potenco: </color>34\n<color=#ffc080>Brulajxa Kvanto: </color>1000\nPezo: 1200\n\nKarena Tipo: Tanko",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Kareno Pigeon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Kongrua kun kanonturo</color>.\n\n<color=#FFFF00>Motora Potenco: </color>1500\n<color=#00FFFF>Rapideco: </color>7\nTurnigxa Rapideco: 1.4\n\n<color=#00FF00>Sano: </color>150\n<color=#FF0000>Kiraso: </color>5\n\n<color=#AA00FF>Pusxa Potenco: </color>40\n<color=#ffc080>Brulajxa Kvanto: </color>300\nPezo: 100\n\nKarena Tipo: Auxto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Kareno Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Povas grimpi murojn</style>. Salto malfruigxas je sekundo, kaj <color=#fc8080>kolizia damagxo malpligrandigxas je 50%</color>.\n\n\n<color=#FFFF00>Motora Potenco: </color>2750\n<color=#00FFFF>Rapideco: </color>9\nTurnigxa Rapideco: 0.8\n\n<color=#00FF00>Sano: </color>1300\n<color=#FF0000>Kiraso: </color>90\n\n<color=#AA00FF>Pusxa Potenco: </color>31\n<color=#ffc080>Brulajxa Kvanto: </color>550\nPezo: 1300\n\nKarena Tipo: Mekao",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "Kareno TANKDOZER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "Plugilo <style=cIsUtility>blokas</style> cxian <style=cIsDamage>envenantan damagxon</style>.\n\nTankdetruila Regximo: <color=#fc8080>Ne povas munti kanonturon</color>.\n\n<color=#FFFF00>Motora Potenco: </color>2500\n<color=#00FFFF>Rapideco: </color>8.5\nTurnigxa Rapideco: 0.9\n\n<color=#00FF00>Sano: </color>1250\n<color=#FF0000>Kiraso: </color>80\n\n<color=#AA00FF>Pusxa Potenco: </color>34\n<color=#ffc080>Brulajxa Kvanto: </color>500\nPezo: 1200\n\nKarena Tipo: Tanko",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Kareno Truck Kan",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "Kolizia damagxo pligrandigxas je <color=#80fc80>100.0%</color>\n\n<color=#80fc80>Kongrua kun kanonturo</color>.\n<style=cIsUtility>Rapideco ne estas influa de pezo</style>.\n\n<color=#FFFF00>Motora Potenco: </color>1000\n<color=#00FFFF>Rapideco: </color>12\nTurnigxa Rapideco: 0.9\n\n<color=#00FF00>Sano: </color>450\n<color=#FF0000>Kiraso: </color>15\n\n<color=#AA00FF>Pusxa Potenco: </color>40\n<color=#ffc080>Brulajxa Kvanto: </color>600\nPezo: 600\n\nKarena Tipo: Auxto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Sano: </color>250\n<color=#FF0000>Kiraso: </color>25\n\nRotacia Rapideco: 7.5\n\nPezo: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Kanonturo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Sano: </color>100\n<color=#FF0000>Kiraso: </color>10\n\nRotacia Rapideco: 20\n\nPezo: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Sano: </color>100\n<color=#FF0000>Kiraso: </color>15\n\nRotacia Rapideco: 15\n\nPezo: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Sano: </color>400\n<color=#FF0000>Kiraso: </color>50\n\nRotacia Rapideco: 5\n\nPezo: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% damagxo</style>?  Mi ne povis trovi la kodon kie gxi pligrandigas damagxon por cxi tiu specifa kanonturo.\n- Programisto\n\n\n<color=#00FF00>Sano: </color>150\n<color=#FF0000>Kiraso: </color>25\n\nRotacia Rapideco: 13\nAngula Limo: 60\n\nPezo: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Aldonas <style=cIsDamage>5 sxargxojn</style> al la <style=cIsUtility>dua</style> kapablo.\n<style=cIsUtility>Replenigas cxiujn sxargxojn</style> post malvarmigxo.\nKanona damagxo malpligrandigxas je 80%\n\n<color=#00FF00>Sano: </color>300\n<color=#FF0000>Kiraso: </color>20\n\nRotacia Rapideco: 7\n\nPezo: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Sano: </color>200\n<color=#FF0000>Kiraso: </color>30\n\nRotacia Rapideco: 9\n\nPezo: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Sano: </color>300\n<color=#FF0000>Kiraso: </color>35\n\nRotacia Rapideco: 7\n\nPezo: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Pezega Pezo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "La tanko povas <style=cIsUtility>surveturi malamikojn</style>, kun <style=cIsDamage>damagxo dependanta de rapideco</style>.  Fali kun peza agordo igas vian pezon krei <style=cIsUtility>sxokondon</style>, vundante proksimajn malamikojn.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Neniu",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Forigas cxi tiun kapablon.  Pligrandigas la jenajn statistikojn:\n\nAtakrapideco: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Neniu",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Neniu",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Forigas cxi tiun kapablon.  Pligrandigas la jenajn statistikojn:\n\nRapideco: <color=#80fc80>+1</color> m/s\nPusxila Potenco: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Neniu",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Forigas cxi tiun kapablon.  Pligrandigas kirason je <color=#80fc80>30</color> kaj pligrandigas brulajxan kapablon je <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Mini-Kanono",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Malprecize pafu por <style=cIsDamage>200% da damagxo.</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "EMP",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Ekbruligu vian sxildon, kaj kreu EMP por <style=cIsDamage>2000% da damagxo</style>, kiu elektrosxokas malamikojn!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "Tenu grandegan provizon de gxis 22 misiloj! Cxiu faras de <style=cIsDamage>1100% da damagxo</style> gxis <style=cIsDamage>1800% da damagxo</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Rapida Auxtomata Kanono",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Pafu eksplodemajn obusojn al malamikoj por <style=cIsDamage>500% da damagxo</style>. Devas resxargxi cxiujn 4 sekundojn.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Potenca Kanono",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Pafu por <style=cIsDamage>7500% da damagxo</style>, forpusxante malamikojn.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 16s</style> | <style=cIsDamage>Eksploda Radiuso: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Artileria Kanono",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Tenu por celi</style>, kaj malpremu por pafi potencan obuson por <style=cIsDamage>7000% da damagxo</style>.  Damagxo pligrandigxas ju pli malproksimen gxi flugas gxis <style=cIsDamage>14000% da damagxo</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 16s</style> | <style=cIsDamage>Eksploda Radiuso: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Kriokanono",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Pafu gigantan negxbulon por <color=#75EAFF>1500% da damagxo</color> kaj frostigu malamikojn.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 5s</style> | <style=cIsDamage>Eksploda Radiuso: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Duobla Kanono",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Pafu por <style=cIsDamage>5400% da damagxo</style>. Tenu por pafi 2 obusojn, kio <color=#fc8080>pligrandigas kapablan malvarmigxon</color> poste. Pafi duoblon <color=#80fc80>grandege malpligrandigas</color> la sekvan sxargxotempon dum 2 sekundoj.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "Brita Kanono",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Pafu por <style=cIsDamage>2400% da damagxo</style>.  <color=#fc8080>Ne povas aktivigi objektojn</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Granda Malbona Kanono",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Pafu por <style=cIsDamage>2000% da damagxo</style>.  <style=cIsUtility>Tenu por sxargxi</style> kaj fari gxis <style=cIsDamage>11000% da damagxo</style>.  Maksimuma sxargxo auxtomate pafas la kanonon por aldonaj <style=cIsDamage>5500% da lasera damagxo</style> kun <style=cIsUtility>aldona repusxo</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Eksperimento de Oppenheimer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Lasu vian obuson detrui vian sxildon, kaj neniigu por <color=#ff4d76>9000% da kritika damagxo</color>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Jetoj",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Ekbruligu kaj konsumu <color=#ffc080>70 da brulajxo</color> sekunde, ebligante al la tanko gajni pli kaj pli da rapideco dum tempo.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Potenca Ciklo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Aktivigu por intersxangxi inter 3 regximoj- Evito, Atako, aux Defendo: \n\n<style=cIsUtility>Evito</style>: Malpligrandigu atakrapidecon je 50% kaj pligrandigu malvarmigxon je 50% por ekstra 50% da rapideco, 10% da pusxa potenco, kaj 50% da motora potenco!\n\n<color=#80fc80>Defendo</color>: Oferu 70% da rapideco kaj 100% da pusxa potenco por 500 da kiraso.\n\n<style=cIsDamage>Atako</style>: Cxiuj armiloj faras duoblan damagxon. Malpligrandigu malvarmigxojn je 33% kaj pligrandigu atakrapidecon je 33%, sed perdu CXION da kiraso kaj resanigxo. Aktivigi cxi tiun regximon sxokas vian tankon dum 2 sekundoj.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Superhorlogxigo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Lasu vian rapidecon detrui vian sxildon, kaj perforte eksplodigu viajn pusxilojn por <style=cIsDamage>6000% da damagxo</style> sendante vin en la aeron, <style=cIsUtility>malhelpante fal-damagxon</style>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Sxildoj",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "Aktivigu por igxi <style=cIsUtility>imuna kontraux ekstera damagxo</style> dum 4 sekundoj.  Povas esti oferita por unufoja <color=#03fcc2>Potenca Kapablo</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Eksplodego",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Pafu 4 kanonojn, cxiu farante <style=cIsDamage>1400% da damagxo</style> en grandega radiuso. Armiloj <color=#fc8080>trovarmigxas</color> anstataux resxargxi.\n<style=cSub>[<style=cIsDamage>Eksploda Radiuso: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Norma",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Baza sperto.\n\nLa tanko movigxas kaj turnigxas surbaze de via elektita vojagxdirekto.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Alternativa",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Sxangxas la manieron kiel cxi tiu tanko estas ludata.\n\nLa tanko movigxas surbaze de karena direkto, sed <color=#fc8080>ne turnigxos en la direkto de vojagxo</color>.  Tio estas traktata per <style=cIsUtility>mana turnigxo</style>.\n\nDum flugado, kontroloj revenas al Norma.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Potenca Regximo: <style=cIsUtility>Evito</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Malpligrandigu atakrapidecon je 50% kaj pligrandigu malvarmigxon je 50% por ekstra 50% da rapideco, 10% da pusxa potenco, kaj 50% da motora potenco.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Potenca Regximo: <color=#80fc80>Defendo</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "Oferu 70% da rapideco kaj 100% da pusxa potenco por 500 da kiraso.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Potenca Regximo: <style=cIsDamage>Atako</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "Cxiuj armiloj faras duoblan damagxon. Malpligrandigu malvarmigxojn je 33% kaj pligrandigu atakrapidecon je 33%, sed perdu CXION da kiraso kaj resanigxo. Aktivigi cxi tiun regximon sxokas vian tankon dum 2 sekundoj.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "Kaj pensi ke Dedee estis finfine liberigita, \r\ngxi estis denove kaptita de la UES.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "Senkanontura",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "Forigas la kanonturon.  <style=cIsDamage>Pligrandigas cxian damagxon je 30%</style>"
  }
}