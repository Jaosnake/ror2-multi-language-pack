        "MINER_UNLOCKABLE_ACHIEVEMENT_NAME": "Adrenaline Rush",
        "MINER_UNLOCKABLE_UNLOCKABLE_NAME": "アドレナリンラッシュ",
        "MINER_UNLOCKABLE_ACHIEVEMENT_DESC": "伝説の宝箱を開けます。",
        "MINER_ALTUNLOCKABLE_ACHIEVEMENT_NAME": "Forged in Flames",
        "MINER_ALTUNLOCKABLE_UNLOCKABLE_NAME": "炎の中で鍛えられた",
        "MINER_ALTUNLOCKABLE_ACHIEVEMENT_DESC": "Abyssal Depths のユニークなガーディアンを倒します。",
        "MINER_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Grand Mastery",
        "MINER_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "マイナー: グランドマスタリー",
        "MINER_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "マイナーとして、ゲームに勝つか、Typhoon または Eclipse を消滅させます。\n<color=#8888>(Typhoon の難易度には Starstorm 2 が必要です)</color>",
        "MINER_MONSOONUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Mastery",
        "MINER_MONSOONUNLOCKABLE_UNLOCKABLE_NAME": "マイナー: マスタリー",
        "MINER_MONSOONUNLOCKABLE_ACHIEVEMENT_DESC": "鉱山労働者として、ゲームに勝つか、モンスーンを全滅させてください。",
        "MINER_CRUSHUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Pillaged Gold",
        "MINER_CRUSHUNLOCKABLE_UNLOCKABLE_NAME": "マイナー: 略奪された金",
        "MINER_CRUSHUNLOCKABLE_ACHIEVEMENT_DESC": "鉱夫として、ギルデッド コーストのユニークなガーディアンに 12 スタックのクリーブを適用します。",
        "MINER_CRACKUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Junkie",
        "MINER_CRACKUNLOCKABLE_UNLOCKABLE_NAME": "マイナー: ジャンキー",
        "MINER_CRACKUNLOCKABLE_ACHIEVEMENT_DESC": "鉱夫として、アドレナリンを 50 スタック獲得します。",
        "MINER_CAVEINUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Compacted",
        "MINER_CAVEINUNLOCKABLE_UNLOCKABLE_NAME": "マイナー: 圧縮済み",
        "MINER_CAVEINUNLOCKABLE_ACHIEVEMENT_DESC": "マイナーとして、1 回のバックブラストで 20 人の敵を攻撃する。",
        "MINER_PUPLEUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: The Five Keys",
        "MINER_PUPLEUNLOCKABLE_UNLOCKABLE_NAME": "マイナー: 5 つの鍵",
        "MINER_PUPLEUNLOCKABLE_ACHIEVEMENT_DESC": "マイナーとして、G-N-O-M-E のデバッグの秘密を発見してください。",
        "MINER_TUNDRAUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Frozen",
        "MINER_TUNDRAUNLOCKABLE_UNLOCKABLE_NAME": "マイナー: 冷凍",
        "MINER_TUNDRAUNLOCKABLE_ACHIEVEMENT_DESC": "マイナーとして、8 分以内にラリーポイント デルタに到達します。",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Tempered",
        "MINER_BLACKSMITHUNLOCKABLE_UNLOCKABLE_NAME": "マイナー: 強化",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_DESC": "鉱山労働者として、地球上で鍛冶ツールを見つけてください。",
        "FATACRID_BODY_NAME": "ペロ グランデ",
        "FATACRID_BODY_SUBTITLE": "(フォルマ・ギガンテ)",
        "DIGGERPLUGIN_DIRESEEKER_BODY_NAME": "ダイアシーカー",
        "DIGGERPLUGIN_DIRESEEKER_BODY_SUBTITLE": "追跡して殺す",
        "DIGGERPLUGIN_DIRESEEKER_BODY_LORE": "伝説によれば、かつてペトリコール 5 世の地下兵舎を徘徊していた巨大な獣について語られています。\n\n最も勇敢な生存者や最も凶悪な怪物たちに恐れられたこの巨大な獣は、無敵でした。それは業火によって鍛えられた血のように赤い鱗を身に着けていた。それは燃えるような黄色い目をしており、その眩しさは最大の生物をその場で立ち止まらせるほど強烈でした。くすぶっている息があり、金属を瞬時に溶かすほどの熱さでした。\n\nプロビデンス自身を殺すほど強い生存者に一度だけ止められ、その獣はついに勝負を果たしたと信じられていました。\n\n<style=cIsHealth>その恐ろしい顔を再び見せるまでは。</style>",
        "DIGGERPLUGIN_DIRESEEKER_BODY_OUTRO_FLAVOR": "...そして、新しい獲物を求めて出発しました。",
        "DIGGERPLUGIN_DIRESEEKER_BODY_DEFAULT_SKIN_NAME": "デフォルト"
    }
}