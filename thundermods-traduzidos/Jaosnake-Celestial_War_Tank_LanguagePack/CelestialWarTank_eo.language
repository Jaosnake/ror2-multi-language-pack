    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_DESCRIPTION": "<color=#fcdf03>+3 moneroj</color> cxiujn <style=cIsUtility>5</style> sekundojn <color=#7a7a7a>(+2 por nivelo)</color>\n\n<color=#00FF00>Sano: </color>85\n<color=#FF0000>Kiraso: </color>12\n\nRotacia Rapideco: 34\n\nPezo: 97\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_NAME": "Maus",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_DESCRIPTION": "\n<color=#00FF00>Sano: </color>150\n<color=#FF0000>Kiraso: </color>30\n\nRotacia Rapideco: 30\n\nPezo: 180\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_NAME": "Tetrarch",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>Sano: </color>20\n<color=#FF0000>Kiraso: </color>7\n\nRotacia Rapideco: 50\n\nPezo: 27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% Atakrapideco</color>\n <color=#fc8080>-15% Sanregenerado</color>\n <color=#fc8080>+5% Totala malvarmigxo</color>\n\n<color=#00FF00>Sano: </color>20\n<color=#FF0000>Kiraso: </color>2\n\nRotacia Rapideco: 40\n\nPezo: 20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Sano: </color>10\n<color=#FF0000>Kiraso: </color>0\n\nRotacia Rapideco: 55\n\nPezo: 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Sano: </color>100\n<color=#FF0000>Kiraso: </color>20\n\nRotacia Rapideco: 33\n\nPezo: 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% Speciala malvarmigxo</color>\n <color=#fc8080>+15% Dua malvarmigxo</color>\n <color=#fc8080>-10% Atakrapideco</color>\n\n<color=#00FF00>Sano: </color>120\n<color=#FF0000>Kiraso: </color>23\n\nRotacia Rapideco: 29\n\nPezo: 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% Damagxo</color>\n <color=#fc8080>+10% Totala malvarmigxo</color>\n\n<color=#00FF00>Sano: </color>160\n<color=#FF0000>Kiraso: </color>0\n\nRotacia Rapideco: 25\nAngula Limo: 90\n\nPezo: 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Sano: </color>45\n<color=#FF0000>Kiraso: </color>4\n\nRotacia Rapideco: 25\n\nPezo: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Sano: </color>35\n<color=#FF0000>Kiraso: </color>15\n\nRotacia Rapideco: 35\n\nPezo: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% Unua malvarmigxo</color>\n <color=#fc8080>+8% Dua malvarmigxo</color>\n <color=#fc8080>+8% Utilajxa malvarmigxo</color>\n <color=#fc8080>+8% Speciala malvarmigxo</color>\n <color=#fc8080>-15% Atakrapideco</color>\n\n<color=#00FF00>Sano: </color>35\n<color=#FF0000>Kiraso: </color>3\n\nRotacia Rapideco: 30\n\nPezo: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% Damagxo</color>\n\n<color=#00FF00>Sano: </color>5\n<color=#FF0000>Kiraso: </color>1\n\nRotacia Rapideco: 40\nAngula Limo: 30\n\nPezo: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ORIGINALA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "RUGXA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "HELRUGXA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "VERDA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "MALHELVERDA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "BLUA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "CEJANA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "ROZKOLORA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "VIGLA ROZA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "MAGENTO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "FLAVA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "NEONFLAVA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "NEONPURPURA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "ORANGXA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "BLANKA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "NIGRA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Tio sxangxas la 'brilan' parton de la veturilo al alia koloro.  Ne influas la ludmanieron.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Malpura",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Pura",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Denta_Kamuflajxo",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Rastruma_Kamuflajxo",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Papera_Kamuflajxo",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Romba_Plato",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Bolita_Plato",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Procedura_Aro",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Kolora_Miksajxo",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Cxielarka_Gradiento",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Unukolora",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Flua_Galaksio",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Kosmo",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Motoraj Sistemoj",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Utilajxoj kaj pusxo konsumas brulajxon. Brulajxa replenigo estas influa de <style=cIsUtility>atakrapideco</style>; brulajxa kapablo estas influa de <style=cIsUtility>postbruligiloj</style> kaj <style=cIsUtility>salt-bazitaj objektoj</style>. Tanko povas <style=cIsUtility>kuradegi en ajna direkto</style>. Pusxo ebligas multflankan kontrolon en la aero. Tamen, <color=#fc8080>tanko ne povas normale salti</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Supera Armilejo",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "Elektoj de kareno kaj kanonturo influas sanon, kirason, rapidecon, pusxon, kaj mason. <style=cIsUtility>Pli peza maso povas helpi pusxi pli pezajn malamikojn</style>; alie vi estos pliinklina al <color=#ffff80>repusxo</color>.\n\nKiraso aux rapideco povas helpi mildigi la <color=#fc8080>abisman sanregeneradon</color> de la tanko.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Cxiela Malstabileco",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "Tanko ne povas reekvilibrigi sin en la aero, <color=#ffff80>estante inklina perdi kontrolon</color>. Surterigxi sur via kapo lasas vin <color=#fc8080>senmovigita kaj vundebla dum mallonga tempo</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Flugaj Pusxiloj",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Tenu <style=cIsUtility>Salton</style> por komenci flugon. Direkto de flugo dependas de la angulo de via tanko. <style=cIsUtility>Plej multflanka flugo</style>, sed povas esti malfacile uzebla.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Pulsaj Pusxiloj",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Ebligas al la tanko <style=cIsUtility>salti</style> normale kiel aliaj postvivantoj. Tankoklinigxo povas esti aktivigita je la 2-a salto. Cxiu salto konsumas <color=#ffc080>25</color> da brulajxo.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Sxvebaj Pusxiloj",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Ebligas al la tanko sxvebi super la tero. Tenu <style=cIsUtility>Salton</style> por supreniri; tenu <style=cIsUtility>LeftAlt</style> por malsupreniri. Supreniro konsumas pli da brulajxo.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Masxinpafiloj",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Konstante pafu por <style=cIsDamage>2x40% da damagxo</style>.\n<style=cSub>[Pezo: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Kugletpafilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Pafu por <style=cIsDamage>12x75% da damagxo</style>.  <color=#ffc080>Bruligu brulajxon</color> por <style=cIsUtility>gajni ekstran provizon</style>; <color=#80fc80>surterigu trukon</color> por provizore gajni potencan pafon por <style=cIsDamage>18x150% da damagxo</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 1s</style> | Pezo: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Grenadjxetilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Pafu malprecizajn obusojn por <style=cIsDamage>4x250% da damagxo</style>.  Obusoj estas eksplodemaj kaj pezaj.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 4s</style> | <style=cIsDamage>Eksploda Radiuso: 5m</style> | Pezo: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Misiljxetilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Pafu precizajn misilojn por <style=cIsDamage>1000% da damagxo</style>. <style=cIsDamage>Damagxo pligrandigxas dum gxi flugas</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 3s</style> | <style=cIsDamage>Eksploda Radiuso: 8m</style> | Pezo: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Flamjxetilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Elsprucxu fajron por <color=#E85E31>25% da brula damagxo</color> po <color=#ffc080>15 da brulajxo sekunde</color>.  Damagxo pligrandigxas kun amasigxoj; <style=cIsUtility>Atakrapideco pligrandigas atingopovon</style>.\n<style=cSub>[<color=#ffc080>Funkcias per Brulajxo</color> | Pezo: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ultraanteno",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Elektrosxoku vin mem</color> kaj <style=cIsUtility>aktivigu cxe-mortigajn objektojn</style>.  <style=cIsUtility>Tusxi malamikojn ankaux elektrosxokas ilin</style>, kaj ili ricevas <style=cIsDamage>250% da damagxo</style> por cxiu <style=cIsUtility>cxe-mortiga</style> objekto.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 7s</style> | <style=cIsDamage>Eksploda Radiuso: 5m</style> | Pezo: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Kritika Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Pafu por <color=#ff4d76>1200% da kritika damagxo</color>. Kritika sxanco pligrandigas la damagxon de la kanono.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 7s</style> | <style=cIsDamage>Eksploda Radiuso: 10m</style> | Pezo: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Hauxbiza Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Sxargxu por pafi por plauxdaj <style=cIsDamage>7000% da damagxo</style>. <style=cIsUtility>Povas jxeti tankon se en la aero.</style>\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 16s</style> | <style=cIsDamage>Eksploda Radiuso: 15m</style> | Pezo: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Frapista Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Pafu malprecize por <style=cIsDamage>1700% da damagxo</style>. <style=cIsDamage>Damagxo malpligrandigxas dum gxi flugas</style>; <style=cIsDamage>Aktivigaj objektoj anstatauxe pligrandigas damagxon</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 3s</style> | <style=cIsDamage>Eksploda Radiuso: 5m</style> | Pezo: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Trapika Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Pafu por <style=cIsDamage>2500% da damagxo</style>.  Tenu por kalibri kaj fari <style=cIsDamage>3500% da damagxo</style>, kapabla <style=cIsUtility>trafi malfortajn punktojn</style>.  Kiam kalibrita, <color=#fc8080>movigxo malbonigas precizecon</color>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 5s</style> | <style=cIsDamage>Eksploda Radiuso: 2m</style> | Pezo: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Franca Pafilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Pafu por mizeraj <style=cIsDamage>550% da damagxo</style>. Pro iu kialo, <style=cIsUtility>havas tro multe da aktivigo</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 1s</style> | Pezo: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Minipafilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Elsprucxu por <style=cIsDamage>50% da damagxo</style>. Je 75% da trovarmigxo aplikas <color=#E85E31>fajron</color>; <color=#fc8080>trovarmigxo sxlosas la pafilon</color>. <style=cIsUtility>Malvarmigxaj objektoj pligrandigas malvarmigxanoftecon</style>; <style=cIsUtility>Rezervaj kargxujoj malhelpas trovarmigxon</style>.\n<style=cSub>[Pezo: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Baza Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Pafu rapidan obuson por <style=cIsDamage>5400% da damagxo</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 12s</style> | <style=cIsDamage>Eksploda Radiuso: 7m</style> | Pezo: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Kontrauxaviadila Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Pafu por <style=cIsDamage>300% da damagxo</style>.  Pafajxo eksplodas proksime al aeraj celoj, farante <style=cIsDamage>2.5x da damagxo</style>.  <color=#fc8080>Tanko malrapidigxas por pafi</color>.\n<style=cSub>[<style=cIsDamage>Eksploda Radiuso: 5.5m</style> | Pezo: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Plauxda Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Pafu por <style=cIsDamage>2200% da damagxo</style> en <style=cIsUtility>granda arko</style>, plauxdante por <style=cIsDamage>10x5% da totala damagxo</style>.  Damagxo pligrandigxas ju pli malproksimen gxi flugas, gxis <style=cIsDamage>5500% da damagxo</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 10s</style> | <style=cIsDamage>Eksploda Radiuso: 16m</style> | Pezo: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Cxiela Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Konsumu <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> da brulajxo por <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>da damagxo</color>.  Sxargxitaj laseroj trapikas; <color=#fc8080>Nesuficxa brulajxo malfunkciigas la armilon.</color>\n<style=cSub>[<color=#ffc080>Funkcias per Brulajxo</color> | Pezo: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Neniiga Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Sxargxu por auxtomate pafi <color=#E85E31>mortig-aktivigan obuson</color> por <style=cIsDamage>12000% da damagxo</style>.  Poste, <color=#fc8080>kapabloj estas malaktivigitaj dum 4 sekundoj.  Obuso povas vundi aliancanojn</color>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 21s</style> | <style=cIsDamage>Eksploda Radiuso: 5m</style> | Pezo: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Auxtomata Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Pafu gxis 4 obusojn kiuj faras <style=cIsDamage>2000% da damagxo</style> cxiu. Lasta obuso faras <style=cIsDamage>2x da damagxo</style> en fiksa punkto.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 14s</style> | <style=cIsDamage>Eksploda Radiuso: 7m</style> | Pezo: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Plugilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Impetu mallongan distancon</style> por <color=#ffc080>50</color> da brulajxo. Povas repusxi <style=cIsUtility>iun ajn malamikon</style> por <style=cIsDamage>1000% da damagxo</style> kaj replenigi <color=#ffc080>40</color> da brulajxo.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 2s</style> | Pezo: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Pikiloj",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Impetu grandan distancon</style> por <color=#ffc080>50</color> da brulajxo. Koliziu malamikojn por <color=#AA2B2A>550% da sanga damagxo</color>.  <style=cIsUtility>Havas neniun malvarmigxon</style>.\n<style=cSub>[Pezo: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Turbo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Rapidegu</style> kaj konsumu <color=#ffc080>30</color> da brulajxo sekunde.  Povas kolizii por <style=cIsDamage>250% da damagxo</style>. Kolizio aldonas <color=#ffc080>20</color> da brulajxo.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 1s</style> | Pezo: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Supersalto",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Lansxu supren por <color=#ffc080>50</color> da brulajxo.  Dum kuradego, anstatauxe lansxu antauxen por <color=#ffc080>75</color> da brulajxo kaj svingu vian tankon por <style=cIsDamage>2500% da damagxo</style>.  Tankopezo pligrandigas damagxon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Buldozo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Akcelu</style> kaj konsumu <color=#ffc080>20</color> da brulajxo sekunde.  Povas plugi <style=cIsUtility>iun ajn malamikon</style> por konstanta <style=cIsDamage>200% da damagxo</style>.  Faras <style=cIsDamage>350% da damagxo</style> cxe kolizio.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 1s</style> | Pezo: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Sxirbuldozo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Sxargxu por <style=cIsUtility>impeti la plej grandan distancon</style> por <color=#ffc080>100</color> da brulajxo.  <style=cIsUtility>Trapiku homamasojn</style> por <color=#AA2B2A>4000% da sanga damagxo</color> kaj <style=cIsUtility>plilongigu impeton</style>; Turnu por fini impeton; <color=#80fc80>surterigu trukon</color> por <style=cIsUtility>preterpasi la sxargxon</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 7s</style> | Pezo: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Trancxefosilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Tenu por enfosigxi</style>, konsumante <color=#ffc080>20</color> da brulajxo sekunde, <style=cIsUtility>protektante vian tankon dum subtere</style>.  Malpremu por elsalti kaj fari <style=cIsDamage>900% da damagxo</style> al proksimaj malamikoj.  Ne povas batali dum subtere.\n<style=cSub>[<style=cIsDamage>Eksploda Radiuso: 10m</style> | Pezo: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Regxa Mino",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Demetu terminon kiu faras <style=cIsDamage>3000% da damagxo</style>.  <style=cIsDamage>Aktivigaj objektoj anstatauxe pligrandigas damagxon</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 10s</style> | <style=cIsDamage>Eksploda Radiuso: 10m</style> | Pezo: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Mini-Minoj",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Celu kaj eluzu cxiujn miniaturajn terminojn kiuj faras <style=cIsDamage>750% da damagxo</style> cxiu.  Provizaj kaj interag-bazitaj objektoj pligrandigas maksimumajn minojn.  <color=#ffc080>Bruligu brulajxon</color> por <style=cIsUtility>gajni ekstran provizon</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 3s</style> | <style=cIsDamage>Eksploda Radiuso: 10m</style> | Pezo: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Bareljxeto",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Lansxu barelon por <color=#ffc080>25</color> da brulajxo kiu ekbrulas cxe kolizio por <style=cIsDamage>6500% da damagxo</style>, kaj lasas <color=#E85E31>brulantan flakon</color>.  <color=#80fc80>Surterigi trukon</color> igas cxi tiun kapablon provizore <color=#fc8080>malstabila</color>, kio <style=cIsUtility>svingas vian tankon</style>.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 14s</style> | <style=cIsDamage>Eksploda Radiuso: 18m</style> | <style=cIsDamage>Zona Radiuso: 8</style> | Pezo: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Memdetruo",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Neniigu <color=#d40000>CXION</color> ene de 35m por <style=cIsDamage>100000% da damagxo</style>.  Komencu kun <color=#80fc80>Dio's Best Friend</color> en nova ludo.\n<style=cSub>[<style=cIsDamage>Eksploda Radiuso: 35m</style> | Pezo: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "REGADO",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Malrapidigxu kaj sxargxu por pafi salvon de misiloj.  Damagxo pligrandigxas ju pli malproksimen gxi flugas, gxis <style=cIsDamage>12x3000% da damagxo.</style>\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 30s</style> | <style=cIsDamage>Eksploda Radiuso: 10m</style> | Pezo: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Evito",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Eligu fumon, svenigante proksimajn malamikojn por <style=cIsDamage>150% da damagxo</style> kaj kasxigxu.  <style=cIsUtility>Igxu imuna</style> kontraux damagxo dum 1 sekundo.\n<style=cSub>[<style=cIsUtility>Malvarmigxo: 12s</style> | <style=cIsDamage>Eksploda Radiuso: 10m</style> | Pezo: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Pasiva: Furiozulo",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Forigas cxi tiun kapablon. Pligrandigas <style=cIsDamage>bazan atakrapidecon je 0.5</style> kaj malpligrandigas <style=cIsUtility>malvarmigxon je 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Pasiva: Motoroj",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Forigas cxi tiun kapablon. Pligrandigas <style=cIsUtility>bazan rapidecon je 1m/s</style> kaj <style=cIsUtility>pusxan potencon je 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Pasiva: Kiraso",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Forigas cxi tiun kapablon. Pligrandigas <style=cIsUtility>bazan kirason je 30</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Majstreco",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Kiel Celestial War Tank, venku la ludon aux neniigxu en Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Majstreco",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Cxiela Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Kiel Celestial War Tank, iru hejmen",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Cxiela Kanono",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Neniigilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Kiel Celestial War Tank, faru pli ol 1,000,000 da damagxo per unu pafo.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Neniigilo",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Sxirbuldozo",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Kiel Celestial War Tank, venku la ludon aux neniigxu en Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Sxirbuldozo",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Fortika",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Kiel Celestial War Tank, Akiru 10000 da SP.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Fortika",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "La finfina tanko de detruo. Rezistu cxiajn malamikojn, surkurante kaj dispremante ilin per gxia potenca pezo kaj armiloj!\n\n<style=cSub>< ! > Tanko estas grandega kaj tre malrapida, igante vin vundebla al ajna formo de damagxo. Ludi aux ekstreme defende aux agreseme helpos mildigi la kvanton da damagxo kiun vi ricevos. Sciu ke la tanko ne havas resanigxon.\n\n< ! > La korpo de la tanko povas esti uzata por damagxo- surveturu viajn malamikojn aux uzu vian pezon por dispremi ilin cxiujn!\n\n< ! > Kiam tanko kolizias, gxi estas pli peza kaj bezonas tempon por rekomenci, vundebla al pli da fal-damagxo. Tanko ne povas fari trukojn.\n\n< ! > Resanigaj faktoroj estas mildigitaj- tanko havas tro multe da sano!\n\n< ! > Premu 'T' por hupadi.  Agordebla en modifaj agordoj.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Fremda Ento",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Post plua esplorado, ni trovis iun originon al cxi tiuj tankoj- la manoj de la rubistoj. Kreitaj per kvalitaj rubopartoj kaj objektoj el la UES, ili sukcese kreis cxi tiujn militajn tankojn.\n\nTamen, tio kondukas al dangxeraj konkludoj. Post akiro de unu el la malamikaj antenoj, ni alarmis cxi tiun kolosan tankon. Gxi havas la grandecon de skarabaj gardistoj!\n\nKompreneble post longe batalita batalo, ni finfine venkis gxin. Ni esperas fari pluan esploradon kaj sxangxi gxian menson, esperante ricevi pli bonajn respondojn. Tio estos malfacila tasko, cxar gxi ESTAS ekstertera teknologio.\n\nUnu grandega noto por konsideri, estas ke cxe gxia malvenko, gxi alvokis krizan portalon. La plej granda, plej perforta portalo kiun ni iam vidis. Kvankam gxi povus konduki nin rekte al respondoj, mi ne pensas ke gxi estos facila promenado en la parko. Averagxa tanko estas jam tro mortiga, kaj mi ne certas kiaj aliaj inventoj faritaj de la rubistoj estas tie ekstere.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ORIGINALA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "BLANKA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "NIGRA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "RUGXA",
