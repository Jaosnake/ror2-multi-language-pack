{
  "de": {
    "ROB_HENRY_BODY_NAME": "Henry",
    "ROB_HENRY_BODY_DESCRIPTION": "Henry ist ein geschickter Kämpfer, der ein breites Arsenal an Waffen einsetzt, um seine Feinde niederzustrecken.<color=#CCD3E0>\n\n< ! > Das Schwert ist ein guter Allrounder, während Boxhandschuhe besser geeignet sind, um mächtigere Gegner zu verprügeln.\n\n< ! > Die Pistole ist mit kurzer Abklingzeit und hohem Schaden stark gegen Luftziele.\n\n< ! > Die Rolle hat einen anhaltenden Rüstungsbonus, der hilft, sie aggressiv einzusetzen.\n\n< ! > Die Bombe kann genutzt werden, um Gegnergruppen mühelos auszulöschen.</color>",
    "ROB_HENRY_BODY_SUBTITLE": "Der Auserwählte",
    "ROB_HENRY_BODY_LORE": "Beispielgeschichte",
    "ROB_HENRY_BODY_OUTRO_FLAVOR": "..und so zog er fort, auf der Suche nach einer neuen Identität.",
    "ROB_HENRY_BODY_OUTRO_FAILURE": "..und so verschwand er, für immer ein unbeschriebenes Blatt.",
    "ROB_HENRY_BODY_DEFAULT_SKIN_NAME": "Standard",
    "ROB_HENRY_BODY_MASTERY_SKIN_NAME": "Alternativ",
    "ROB_HENRY_BODY_TYPHOON_SKIN_NAME": "V1",
    "ROB_HENRY_BODY_DANTE_SKIN_NAME": "Dante",
    "ROB_HENRY_BODY_VERGIL_SKIN_NAME": "Vergil",
    "ROB_HENRY_BODY_SAMURAI_SKIN_NAME": "Samurai",
    "ROB_HENRY_BODY_SOLDIER_SKIN_NAME": "Champion",
    "ROB_HENRY_BODY_ZOMBIE_SKIN_NAME": "Zombie",
    "ROB_HENRY_BODY_SKELETON_SKIN_NAME": "Skelett",
    "ROB_HENRY_BODY_PASSIVE_NAME": "Henrys Passiv",
    "ROB_HENRY_BODY_PASSIVE_DESCRIPTION": "Beispieltext.",
    "ROB_HENRY_BODY_PRIMARY_SLASH_NAME": "Schwert",
    "ROB_HENRY_BODY_PRIMARY_SLASH_DESCRIPTION": "<style=cIsUtility>Agil.</style> Schwinge nach vorne für <style=cIsDamage>280% Schaden</style>.",
    "ROB_HENRY_BODY_PRIMARY_PUNCH_NAME": "Boxhandschuhe",
    "ROB_HENRY_BODY_PRIMARY_PUNCH_DESCRIPTION": "<style=cIsUtility>Agil.</style> Schlage schnell zu für <style=cIsDamage>240% Schaden</style>. <style=cIsUtility>Ignoriert Rüstung.</style>",
    "ROB_HENRY_BODY_PRIMARY_GUN_NAME": "Pistole",
    "ROB_HENRY_BODY_PRIMARY_GUN_DESCRIPTION": "<style=cIsUtility>Agil.</style> Feuere eine kleine Pistole für <style=cIsDamage>90% Schaden</style>.",
    "ROB_HENRY_BODY_SECONDARY_GUN_NAME": "Handfeuerwaffe",
    "ROB_HENRY_BODY_SECONDARY_GUN_DESCRIPTION": "<style=cIsUtility>Agil.</style> Feuere eine Handfeuerwaffe für <style=cIsDamage>420% Schaden</style>.",
    "ROB_HENRY_BODY_SECONDARY_STINGER_NAME": "Stinger",
    "ROB_HENRY_BODY_SECONDARY_STINGER_DESCRIPTION": "<style=cIsUtility>Agil.</style> Stürme auf einen Gegner zu für <style=cIsDamage>450% Schaden</style>.",
    "ROB_HENRY_BODY_SECONDARY_UZI_NAME": "Uzi",
    "ROB_HENRY_BODY_SECONDARY_UZI_DESCRIPTION": "Feuere eine Uzi für <style=cIsDamage>75% Schaden</style>.",
    "ROB_HENRY_BODY_UTILITY_ROLL_NAME": "Rolle",
    "ROB_HENRY_BODY_UTILITY_ROLL_DESCRIPTION": "Rolle eine kurze Distanz und erhalte <style=cIsUtility>300 Rüstung</style>. <style=cIsUtility>Während der Rolle kannst du nicht getroffen werden.</style>",
    "ROB_HENRY_BODY_UTILITY_SHOTGUN_NAME": "Schrotflinte",
    "ROB_HENRY_BODY_UTILITY_SHOTGUN_DESCRIPTION": "Feuere eine <style=cIsUtility>Schrotflinte</style> für <style=cIsDamage>14x140% Schaden</style> und schleudere dich mit dem Rückstoß weg.",
    "ROB_HENRY_BODY_SPECIAL_BOMB_NAME": "Bombe",
    "ROB_HENRY_BODY_SPECIAL_BOMB_DESCRIPTION": "Wirf eine Bombe für <style=cIsDamage>1600% Schaden</style>.",
    "ROB_HENRY_BODY_SPECIAL_SCEPBOMB_NAME": "Mehr Bomben!",
    "ROB_HENRY_BODY_SPECIAL_SCEPBOMB_DESCRIPTION": "Wirf eine Bombe für <style=cIsDamage>1600% Schaden</style>.\n<color=#d299ff>SCEPTER: Halte bis zu 4 Bomben. Abklingzeit wird halbiert.</color>",
    "ROB_HENRY_BODY_SPECIAL_BAZOOKA_NAME": "Bazooka",
    "ROB_HENRY_BODY_SPECIAL_BAZOOKA_DESCRIPTION": "Lade und feuere Raketen für <style=cIsDamage>600%-1600% Schaden</style>.",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKA_NAME": "Feuern",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKA_DESCRIPTION": "Lade und feuere eine Rakete für <style=cIsDamage>600%-1600% Schaden</style>.",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKAOUT_NAME": "Abbrechen",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKAOUT_DESCRIPTION": "Lege deine <style=cIsDamage>Bazooka</style> weg.",
    "ROB_HENRY_BODY_SPECIAL_SCEPBAZOOKA_NAME": "Armageddon",
    "ROB_HENRY_BODY_SPECIAL_SCEPBAZOOKA_DESCRIPTION": "Lade und feuere Raketen für <style=cIsDamage>600%-1600% Schaden</style>.\n<color=#d299ff>SCEPTER: Halte zwei Bazookas gleichzeitig.</color>",
    "ROB_HENRY_BODY_PRIMARY_SCEPBAZOOKA_NAME": "Feuern",
    "ROB_HENRY_BODY_PRIMARY_SCEPBAZOOKA_DESCRIPTION": "Lade und feuere eine Rakete für <style=cIsDamage>600%-1600% Schaden</style>.\n<color=#d299ff>SCEPTER: Halte zwei Bazookas gleichzeitig.</color>",
    "ROB_HENRY_BODY_SPECIAL_FRENZY_NAME": "Amoklauf",
    "ROB_HENRY_BODY_SPECIAL_FRENZY_DESCRIPTION": "Lade bei Treffern <style=cIsHealth>Zorn</style> auf. Bei voller Ladung aktivieren, um für <style=cIsUtility>10 Sekunden</style> in einen <style=cIsDamage>Rausch</style> zu verfallen. <style=cIsHealth>Lädt bei niedriger Gesundheit schneller.</style>",
    "ROB_HENRY_BODY_SPECIAL_SCEPFRENZY_NAME": "Super Saiyan",
    "ROB_HENRY_BODY_SPECIAL_SCEPFRENZY_DESCRIPTION": "Lade <style=cIsHealth>Zorn</style> durch Primärtreffer aus nächster Nähe oder beliebige Nahkampftreffer auf. Bei voller Ladung aktivieren, um für <style=cIsUtility>10 Sekunden</style> in einen <style=cIsDamage>Rausch</style> zu verfallen. <style=cIsHealth>Lädt bei niedriger Gesundheit schneller.</style>\n<color=#d299ff>SCEPTER: Attributsboni massiv erhöht. Dauer erhöht.</color>",
    "ACHIEVEMENT_ROB_HENRY_BODY_UNLOCKABLE_ACHIEVEMENT_ID_NAME": "Auftakt",
    "ACHIEVEMENT_ROB_HENRY_BODY_UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Betritt Titanic Plains.",
    "ACHIEVEMENT_ROB_HENRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Henry: Meisterschaft",
    "ACHIEVEMENT_ROB_HENRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Schließe als Henry das Spiel ab oder obliteriere auf Monsoon.",
    "ACHIEVEMENT_ROB_HENRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Henry: Großmeisterschaft",
    "ACHIEVEMENT_ROB_HENRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Schließe als Henry das Spiel ab oder obliteriere auf Typhoon oder Eclipse.\n<color=#8888>(Zählt jede Schwierigkeit ab Typhoon oder höher)</color>",
    "ROB_HENRY_BODY_DANTEUNLOCKABLE_ACHIEVEMENT_NAME": "Henry: Jackpot",
    "ROB_HENRY_BODY_DANTEUNLOCKABLE_ACHIEVEMENT_DESC": "Besiege als Henry einen Twisted Scavenger auf Monsoon.",
    "ROB_HENRY_BODY_DANTEUNLOCKABLE_UNLOCKABLE_NAME": "Henry: Jackpot",
    "ROB_HENRY_BODY_VERGILUNLOCKABLE_ACHIEVEMENT_NAME": "Henry: 200% Motiviert",
    "ROB_HENRY_BODY_VERGILUNLOCKABLE_ACHIEVEMENT_DESC": "Besiege als Henry den King of Nothing ohne Gegenstände.",
    "ROB_HENRY_BODY_VERGILUNLOCKABLE_UNLOCKABLE_NAME": "Henry: 200% Motiviert",
    "ROB_MRGREEN_BODY_NAME": "Mr. Green",
    "ROB_MRGREEN_BODY_DESCRIPTION": "Mr. Green<color=#CCD3E0>\n\n< ! > Das Schwert ist ein guter Allrounder, während Boxhandschuhe besser geeignet sind, um mächtigere Gegner zu verprügeln.\n\n< ! > Die Pistole ist mit kurzer Abklingzeit und hohem Schaden stark gegen Luftziele.\n\n< ! > Die Rolle hat einen anhaltenden Rüstungsbonus, der hilft, sie aggressiv einzusetzen.\n\n< ! > Die Bombe kann genutzt werden, um Gegnergruppen mühelos auszulöschen.</color>",
    "ROB_MRGREEN_BODY_SUBTITLE": "Der",
    "ROB_MRGREEN_BODY_LORE": "Beispielgeschichte Teil 2",
    "ROB_MRGREEN_BODY_OUTRO_FLAVOR": "..und so zog er fort, Text unten.",
    "ROB_MRGREEN_BODY_DEFAULT_SKIN_NAME": "Standard",
    "ROB_MRGREEN_BODY_PASSIVE_NAME": "Mr. Greens Passiv",
    "ROB_MRGREEN_BODY_PASSIVE_DESCRIPTION": "Beispieltext.",
    "ROB_MRGREEN_BODY_PRIMARY_PUNCH_NAME": "Kampfkunst",
    "ROB_MRGREEN_BODY_PRIMARY_PUNCH_DESCRIPTION": "Führe eine schnelle Kombination aus Schlägen und Tritten für <style=cIsDamage>90% Schaden</style> aus.",
    "ROB_MRGREEN_BODY_SECONDARY_CLONETHROW_NAME": "Klonwurf",
    "ROB_MRGREEN_BODY_SECONDARY_CLONETHROW_DESCRIPTION": "Beschwöre einen Klon und wirf ihn nach vorne, sodass er nahe Gegner greift und sie für <style=cIsDamage>420% Schaden</style> zu Boden schmettert.",
    "ROB_MRGREEN_BODY_UTILITY_DASH_NAME": "People's Elbow",
    "ROB_MRGREEN_BODY_UTILITY_DASH_DESCRIPTION": "Sprinte eine kurze Strecke. Bei Kontakt mit einem <style=cIsUtility>Klon</style> springst du in die Luft und stürzt mit einem mächtigen <style=cIsUtility>Ellbogenschlag</style> für <style=cIsDamage>800% Schaden</style> herab.",
    "ROB_MRGREEN_BODY_SPECIAL_RES_NAME": "Wiederauferstehung",
    "ROB_MRGREEN_BODY_SPECIAL_RES_DESCRIPTION": "Belebe alle gefallenen Klone wieder.",
    "ROB_NEMRY_BODY_NAME": "Nemesis Henry",
    "ROB_NEMRY_BODY_DESCRIPTION": "Nemesis Henry ist ein unberechenbarer Schwertkämpfer, der eine besondere Klinge führt, die Energie speichert, um seine Angriffe zu verstärken. Er hat keine Abklingzeiten, muss aber seine Energie gut verwalten.<color=#CCD3E0>\n\n< ! > Schwertmodus baut Energie auf, während Waffenmodus Energie für starke Angriffe verbraucht.\n\n< ! > Swordmaster kann für mehr Schaden aufgeladen werden.\n\n< ! > Flash Step ist ein starkes aggressives Werkzeug, das beim Aufbau von Energie hilft.\n\n< ! > Nutze Hydra Bite, um gesund zu bleiben, und Hyper Beam, um gewaltigen Schaden zu entfesseln.</color>",
    "ROB_NEMRY_BODY_SUBTITLE": "Der Gefallene",
    "ROB_NEMRY_BODY_LORE": "Beispielgeschichte",
    "ROB_NEMRY_BODY_OUTRO_FLAVOR": "..und so zog er fort, nachdem er ohne ersichtlichen Grund den Mond in die Luft gejagt hatte.",
    "ROB_NEMRY_BODY_OUTRO_FAILURE": "..er hat sich so sehr bemüht und es so weit gebracht. Doch am Ende zählt es nicht einmal.",
    "ROB_NEMRY_BODY_DEFAULT_SKIN_NAME": "Nemesis",
    "ROB_NEMRY_BODY_MASTERY_SKIN_NAME": "Gefangener #001",
    "ROB_NEMRY_BODY_TYPHOON_SKIN_NAME": "FLLFFL",
    "ROB_NEMRY_BODY_PASSIVE_NAME": "Säure-Gunblade",
    "ROB_NEMRY_BODY_PASSIVE_DESCRIPTION": "Nemesis Henry führt eine Spezialwaffe, die zwischen Schwertmodus und Waffenmodus wechseln kann. Zudem haben seine Fertigkeiten keine regulären Abklingzeiten, sondern nutzen stattdessen das <style=cIsHealing>Energie</style>-System seines Schwerts.",
    "ROB_NEMRY_BODY_PRIMARY_SPEAR_NAME": "Aufspießen",
    "ROB_NEMRY_BODY_PRIMARY_SPEAR_DESCRIPTION": "<style=cIsUtility>Agil.</style> Stich nach vorne für <style=cIsDamage>160% Schaden</style>. <style=cIsDamage>Verursacht an der Spitze doppelten Schaden und heilt um <style=cIsHealing>50%</style> des verursachten Schadens</style>.",
    "ROB_WEAPON_SWAP_SKILL": "Waffenwechsel",
    "ROB_NEMRY_BODY_PRIMARY_SWORD_NAME": "Schwertmodus",
    "ROB_NEMRY_BODY_PRIMARY_SWORD_DESCRIPTION": "Schwinge deine Klinge nach vorne für <style=cIsDamage>280% Schaden</style>. Erzeugt bei Treffern <style=cIsHealing>20% Energie</style>.",
    "ROB_NEMRY_BODY_PRIMARY_GUN_NAME": "Waffenmodus",
    "ROB_NEMRY_BODY_PRIMARY_GUN_DESCRIPTION": "<style=cIsHealing>2,5% Energie.</style> Feuere einen durchdringenden <style=cIsHealing>Energie</style>schuss für <style=cIsDamage>350% Schaden</style>.",
    "ROB_NEMRY_BODY_PRIMARY_SWORDCSS_NAME": "Schwertmodus / Waffenmodus",
    "ROB_NEMRY_BODY_PRIMARY_SWORDCSS_DESCRIPTION": "Schwinge deine Klinge für <style=cIsDamage>280% Schaden</style>. Erzeugt bei Treffern <style=cIsHealing>20% Energie</style>.\n<style=cIsHealing>2,5% Energie.</style> Feuere einen durchdringenden <style=cIsHealing>Energie</style>schuss für <style=cIsDamage>350% Schaden</style>.",
    "ROB_NEMRY_BODY_SECONDARY_BLAST_NAME": "Null Blast",
    "ROB_NEMRY_BODY_SECONDARY_BLAST_DESCRIPTION": "<style=cIsUtility>Agil.</style> Wirf eine Kugel aus <style=cIsHealth>geheimnisvoller Energie</style> für <style=cIsDamage>450% Schaden</style>.",
    "ROB_NEMRY_BODY_SECONDARY_CHARGE_NAME": "Swordmaster",
    "ROB_NEMRY_BODY_SECONDARY_CHARGE_DESCRIPTION": "<style=cIsHealing>10% Energie.</style> Stürme auf einen nahen Gegner zu für <style=cIsDamage>600% Schaden</style>. Führe stattdessen einen Komboangriff aus, wenn du in Nahkampfreichweite bist.",
    "ROB_NEMRY_BODY_SECONDARY_TORRENT_NAME": "Gunslinger",
    "ROB_NEMRY_BODY_SECONDARY_TORRENT_DESCRIPTION": "<style=cIsHealing>5% Energie.</style> Feuere eine Salve von <style=cIsHealing>Energie</style>schüssen ab. Halte gedrückt, um weiterzufeuern, wobei jeder Schuss mehr <style=cIsHealing>Energie</style> verbraucht.",
    "ROB_NEMRY_BODY_SECONDARY_CHARGECSS_NAME": "Swordmaster / Gunslinger",
    "ROB_NEMRY_BODY_SECONDARY_CHARGECSS_DESCRIPTION": "<style=cIsHealing>10% Energie.</style> Stürme auf einen nahen Gegner zu für <style=cIsDamage>600% Schaden</style>.\n<style=cIsHealing>5% Energie.</style> Feuere eine Salve von <style=cIsHealing>Energie</style>schüssen ab.",
    "ROB_NEMRY_BODY_UTILITY_DODGESLASH_NAME": "Schneller Schnitt",
    "ROB_NEMRY_BODY_UTILITY_DODGESLASH_DESCRIPTION": "Mache einen Rückwärtssalto und schlitze nahe Gegner für <style=cIsDamage>300% Schaden</style>. <style=cIsUtility>Während des Saltos kannst du nicht getroffen werden.</style>",
    "ROB_NEMRY_BODY_UTILITY_BLINK_NAME": "Flash Step",
    "ROB_NEMRY_BODY_UTILITY_BLINK_DESCRIPTION": "<style=cIsHealing>5% Energie.</style> <style=cIsUtility>Teleportiere dich sofort</style> zu einem nahen Gegner.",
    "ROB_NEMRY_BODY_UTILITY_BURST_NAME": "Energieschub",
    "ROB_NEMRY_BODY_UTILITY_BURST_DESCRIPTION": "<style=cIsHealing>10% Energie.</style> Entlade einen Stoß aus <style=cIsHealing>Energie</style> für <style=cIsDamage>400% Schaden</style> und <style=cIsUtility>schleudere dich durch den Rückstoß weg</style>.",
    "ROB_NEMRY_BODY_UTILITY_BLINKCSS_NAME": "Flash Step / Energieschub",
    "ROB_NEMRY_BODY_UTILITY_BLINKCSS_DESCRIPTION": "<style=cIsHealing>5% Energie.</style> <style=cIsUtility>Teleportiere dich sofort</style> zu einem nahen Gegner.\n<style=cIsHealing>10% Energie.</style> Entlade einen Stoß aus <style=cIsHealing>Energie</style> für <style=cIsDamage>400% Schaden</style>.",
    "ROB_NEMRY_BODY_SPECIAL_STAB_NAME": "Hydra Bite",
    "ROB_NEMRY_BODY_SPECIAL_STAB_DESCRIPTION": "<style=cIsHealing>100% Energie.</style> Stoße deine Klinge in einen Gegner für <style=cIsDamage>2800% Schaden</style> und füge einen starken Debuff zu. <style=cIsHealing>Heile dich um 50% des verursachten Schadens.</style>",
    "ROB_NEMRY_BODY_SPECIAL_BEAM_NAME": "Hyper Beam",
    "ROB_NEMRY_BODY_SPECIAL_BEAM_DESCRIPTION": "<style=cIsHealing>100% Energie.</style> Lade einen mächtigen Laserhagel auf, der <style=cIsDamage>10x420% Schaden</style> verursacht.",
    "ROB_NEMRY_BODY_SPECIAL_STABCSS_NAME": "Hydra Bite / Hyper Beam",
    "ROB_NEMRY_BODY_SPECIAL_STABCSS_DESCRIPTION": "<style=cIsHealing>100% Energie.</style> Stoße deine Klinge in einen Gegner für <style=cIsDamage>2800% Schaden</style> und füge einen starken Debuff zu. <style=cIsHealing>Heile dich um 50% des verursachten Schadens.</style>\n<style=cIsHealing>100% Energie.</style> Lade einen mächtigen Strahl auf, der <style=cIsDamage>gewaltigen Schaden</style> verursacht.",
    "ROB_NEMRY_BODY_UNLOCKABLE_ACHIEVEMENT_NAME": "???",
    "ROB_NEMRY_BODY_UNLOCKABLE_ACHIEVEMENT_DESC": "Besiege Henrys Vestige.",
    "ROB_NEMRY_BODY_UNLOCKABLE_UNLOCKABLE_NAME": "???",
    "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Nemesis Henry: Meisterschaft",
    "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Schließe als Nemesis Henry das Spiel ab oder obliteriere auf Monsoon.",
    "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Nemesis Henry: Meisterschaft",
    "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "Nemesis Henry: Großmeisterschaft",
    "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "Schließe als Nemesis Henry das Spiel ab oder obliteriere auf Typhoon.",
    "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "Nemesis Henry: Großmeisterschaft"
  }
}
