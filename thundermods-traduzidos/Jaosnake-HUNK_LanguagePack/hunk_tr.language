        "ROB_HUNK_WEAPON_REVOLVER_NAME": "Quickdraw Army",
        "ROB_HUNK_WEAPON_REVOLVER_DESC": "Magnum mermisi kullanan eski usul bir altıpatlar.",
        "ROB_HUNK_WEAPON_ADDON_REVOLVER_NAME": "Hızlı Doldurucu (Quickdraw Army)",
        "ROB_HUNK_WEAPON_ADDON_REVOLVER_DESC": "Quickdraw Army için boş tamburu daha hızlı doldurmanı sağlayan özel bir parça.",
        "ROB_HUNK_WEAPON_FLAMETHROWER_NAME": "Kimyasal Alev Makinesi",
        "ROB_HUNK_WEAPON_FLAMETHROWER_DESC": "Kor gibi alevler üretmek için basınçlı gaz kullanan Umbrella yapımı bir silah. Taşınabilir ve yeniden doldurulabilir olduğundan uzun soluklu çatışmalara her zaman hazırdır.",
        "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_NAME": "Regülatör (Kimyasal Alev Makinesi)",
        "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_DESC": "Alev makinesi için özel bir parça. Sıvı yakıt ve sıkıştırılmış gaz tüketimini kısıtlayarak çok daha uzun süre ateş edilmesini sağlar.",
        "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_NAME": "Yüksek Kaliteli Yakıt Tankı (Kimyasal Alev Makinesi)",
        "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_DESC": "Alev makinesi için özel bir parça. Alevlerin gücünü artırarak yerde ateş izleri bırakır.",
        "ROB_HUNK_WEAPON_GRENADELAUNCHER_NAME": "GM-79",
        "ROB_HUNK_WEAPON_GRENADELAUNCHER_DESC": "Yangın mühimmatı ateşleyebilen tek atımlık kırmalı bombaatar.",
        "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_NAME": "Omuz Dipçiği (GM-79)",
        "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_DESC": "GM-79 için geri tepmeyi büyük ölçüde azaltan ve her atışa daha dengeli bir yörünge kazandıran özel bir parça.",
        "ROB_HUNK_WEAPON_MGL_NAME": "MGL",
        "ROB_HUNK_WEAPON_MGL_DESC": "Patlayıcı mühimmat ateşleyebilen yarı otomatik bombaatar prototipi.",
        "ROB_HUNK_WEAPON_ADDON_MGL_NAME": "Yenilenmiş Tambur (MGL)",
        "ROB_HUNK_WEAPON_ADDON_MGL_DESC": "MGL için özel bir parça. Bozuk tamburu çalışan bir tamburla değiştirerek yarı otomatik atış yapılmasını sağlar.",
        "ROB_HUNK_WEAPON_GOLDGUN_NAME": "Altın Tabanca",
        "ROB_HUNK_WEAPON_GOLDGUN_DESC": "Her şeyi yalnızca tek bir atışta öldürebilen 1 mermi kapasiteli tabanca.",
        "ROB_HUNK_WEAPON_BLUEROSE_NAME": "Blue Rose",
        "ROB_HUNK_WEAPON_BLUEROSE_DESC": "Aynı anda iki mermi ateşleyen altı hazneli bir altıpatlar mı? Böyle bir şeyi hangi kaçık uydurur ki?",
        "ROB_HUNK_WEAPON_AR_NAME": "CQBR",
        "ROB_HUNK_WEAPON_AR_DESC": "Tam otomatik ateş edebilen bir tüfek.",
        "ROB_HUNK_WEAPON_ADDON_AR_NAME": "Süngü (CQBR)",
        "ROB_HUNK_WEAPON_ADDON_AR_DESC": "CQBR için Savaş Bıçağının yerini alan ve %600 hasar veren özel bir parça.",
        "ROB_HUNK_WEAPON_RAILGUN_NAME": "Yeni Nesil Piyade Tipi Ferromanyetik Raylı Top",
        "ROB_HUNK_WEAPON_RAILGUN_DESC": "Bir salgın durumunda biyolojik silahları ortadan kaldırmak üzere Cornell Garner ve ABD ordusu tarafından geliştirilen taşınabilir raylı top.",
        "ROB_HUNK_WEAPON_MINIGUN_NAME": "Minigun",
        "ROB_HUNK_WEAPON_MINIGUN_DESC": "7.62 mm NATO mermisi ateşleyen altı namlulu motorlu minigun. İnanılmaz yüksek atış hızına sahiptir ve çok fazla hasar verir.",
        "ROB_HUNK_WEAPON_COLT_NAME": "Colt Single Action Army",
        "ROB_HUNK_WEAPON_COLT_DESC": "Şimdiye kadar yapılmış en büyük tabanca.",
        "ROB_HUNK_WEAPON_ADDON_COLT_NAME": "Uzun Namlu (Colt)",
        "ROB_HUNK_WEAPON_ADDON_COLT_DESC": "Colt için hasarını %4800'e çıkaran özel bir parça.",
        "ROB_HUNK_WEAPON_SPARKSHOT_NAME": "Kıvılcım Atar",
        "ROB_HUNK_WEAPON_SPARKSHOT_DESC": "Denek hayvanlar üzerinde kullanılmak üzere üretilmiş yüksek voltajlı bir silah. Doldurulması biraz zaman alır ve iğnelerin telleri kolayca kopar, ancak gerçekten sert vurur.",
