    "ITEM_BORBOFUSE_PICKUP": "Kreas svenigan novan eksplodon kiam viaj ŝildoj rompiĝas.",
    "ITEM_BORBOFUSE_DESCRIPTION": "Akiru <style=cIsHealing>25.0 ŝildon</style> <style=cStack>(+25.0 por stako)</style>. Rompi viajn ŝildojn <style=cIsUtility>Ŝokas</style> ĝis 3 <style=cStack>(+1 por stako)</style> malamikojn ene de <style=cIsUtility>40.0m</style> <style=cStack>(+4.0 por stako)</style>. <style=cIsDamage>La ŝoka daŭro skalas kun ŝilda sano</style>.",
    "ITEM_NEARBYDEFENSE_NAME": "Meduz-koliero",
    "ITEM_NEARBYDEFENSE_PICKUP": "Pliigas kirason kaj regeneradon dum malamikoj estas proksime.",
    "ITEM_NEARBYDEFENSE_DESCRIPTION": "Pliigas bazan sanregeneradon je <style=cIsHealing>+1 sano/s</style> <style=cStack>(+1 sano/s por stako)</style> kaj kirason je <style=cIsHealing>+10</style> <style=cStack>(+10 por stako)</style>. Por ĉiu malamiko ene de <style=cIsUtility>20m</style>, ankaŭ akiru <style=cIsHealing>+0.5 sano/s</style> <style=cStack>(+0.5 sano/s por stako)</style> bazan sanregeneradon kaj <style=cIsHealing>+5</style> <style=cStack>(+5 por stako)</style> kirason, ĝis <style=cIsUtility>5</style> fojoj.",
    "ITEM_ICHORRED_NAME": "Metamorfa Ikoro (Ruĝa)",
    "ITEM_ICHORRED_PICKUP": "Pliigas atakrapidon kaj ŝancon de kritika trafo.",
    "ITEM_ICHORRED_DESCRIPTION": "Pliigas <style=cIsDamage>atakrapidon</style> je <style=cIsDamage>7.5%</style> <style=cStack>(+7.5% por stako)</style>. Pliigas <style=cIsDamage>ŝancon de kritika trafo</style> je <style=cIsDamage>5%</style> <style=cStack>(+5% por stako)</style>. <style=cIsVoid>Koruptas ĉiujn Forpuŝajn Kirasplatojn kaj Flavajn Ikorojn</style>.",
    "ITEM_ICHORVIOLET_NAME": "Metamorfa Ikoro (Viola)",
    "ITEM_ICHORVIOLET_PICKUP": "Akiru barilon kiam vundita. <style=cIsVoid>Koruptas ĉiujn Medicinajn Kompletojn kaj Ruĝajn Ikorojn</style>.",
    "ITEM_ICHORVIOLET_DESCRIPTION": "Akiru <style=cIsHealing>22 barilon</style> kiam vundita <style=cStack>(+22 por stako)</style>. <style=cIsVoid>Koruptas ĉiujn Medicinajn Kompletojn kaj Ruĝajn Ikorojn</style>.",
    "ITEM_ICHORYELLOW_NAME": "Metamorfa Ikoro (Flava)",
    "ITEM_ICHORYELLOW_PICKUP": "Akiru sanregeneradon. <style=cIsVoid>Koruptas ĉiujn Soldatajn Injektilojn kaj Violajn Ikorojn</style>.",
    "ITEM_ICHORYELLOW_DESCRIPTION": "Pliigas <style=cIsHealing>bazan sanregeneradon</style> je <style=cIsHealing>0.8 sano/s</style> <style=cStack>(+0.8 sano/s por stako)</style>. <style=cIsVoid>Koruptas ĉiujn Soldatajn Injektilojn kaj Violajn Ikorojn</style>.",
    "ITEM_PHRYGIANLILY_NAME": "Frigia Lilio",
    "ITEM_PHRYGIANLILY_PICKUP": "Eniru furiozon post aktivigo de la teleportilo. <style=cIsVoid>Koruptas ĉiujn Leptonajn Lekantetojn.</style>",
    "ITEM_PHRYGIANLILY_DESCRIPTION": "<style=cIsDamage>Eniru furiozon</style> dum 20 sekundoj post aktivigo de la teleportilo. Dum furiozo, pliigas atakrapidon je +30% <style=cStack>(+15% por stako)</style> kaj reduktas kapablajn malvarmigajn tempojn je 30% <style=cStack>(15% por stako)</style>",
    "ITEM_HEALFROMBLEEDINGENEMIES_NAME": "Sangosuĉa Koralito",
    "ITEM_HEALFROMBLEEDINGENEMIES_PICKUP": "Sangantaj malamikoj resanigas vin ĉe trafo. Koruptas ĉiujn Hirudajn Semojn.",
    "ITEM_HEALFROMBLEEDINGENEMIES_DESCRIPTION": "Akiru <style=cIsHealth>10% sangadan ŝancon</style>. Sangantaj malamikoj resanigas vin je <style=cIsDamage>+0.2 sano</style> ĉe trafo <style=cIsHealth>por stako da sangado</style>, ĝis maksimumo de 2 <style=cStack>(+1 por stako)</style> sano. <style=cIsVoid>Koruptas ĉiujn Hirudajn Semojn.</style>",
    "ITEM_WICKEDBAND_NAME": "Fia Bendo",
    "ITEM_WICKEDBAND_PICKUP": "Altdamaĝaj trafoj reduktas malvarmigajn tempojn je 1 sekundo.",
    "ITEM_WICKEDBAND_DESCRIPTION": "Trafoj kiuj kaŭzas <style=cIsDamage>pli ol 400% da damaĝo</style> ankaŭ <style=cIsUtility>reduktos ĈIUJN malvarmigajn tempojn je 1.0s</style> <style=cStack>(+1.0 por stako)</style>. <style=cIsHealth>1.0 sekunda malvarmiga tempo.</style>",
    "ITEM_GALLERY_ITEM_DROP_NAME": "Galeria Objektofalo",
    "ITEM_GALLERY_ITEM_DROP_PICKUP": "Vi ne devus vidi ĉi tion lol",
    "ITEM_GALLERY_ITEM_DROP_DESCRIPTION": "Vi ne devus vidi ĉi tion lol",
    "ITEM_HEALTHUP_NAME": "SanoSupren",
    "ITEM_AOEONCRIT_NAME": "Hipo-Enfadenigilo",
    "ITEM_AOEONCRIT_PICKUP": "'Kritikaj Trafoj' pafas laseran ĉenon.",
    "ITEM_AOEONCRIT_DESCRIPTION": "Akiru <style=cIsDamage>5% kritikan ŝancon</style>. <style=cIsDamage>Kritikaj trafoj</style> pafas <style=cIsDamage>resaltantan laseron</style> por <style=cIsDamage>60%</style> <style=cStack>(+20% por stako)</style> TUTA damaĝo al ĝis <style=cIsDamage>1 <style=cStack>(+1 por stako)</style> malamikoj</style>.",
    "ITEM_AOEONCRIT_LORE": "Vi stultulo! Ĉi tiuj aferoj supozeble estas NEROMPEBLAJ. Kiel diable vi sukcesis fari tion?\r\n\r\nAmiko... Pardonu ke mi diras tion, sed hiper-enfadenigiloj estas treege malmultekostaj. Kostos al vi nur poŝmonerojn akiri novan. Ĉu vi iam scivolis kial?\r\n\r\nMi tute ne zorgas, ulo. Ĉi tiu afero apenaŭ funkcias nun. Se iu aĉetos al mi novan, tio estas VI.\r\n\r\nHaha, amiko, nu, ĉu vi pensas ke mi estas farita el mono? Mi nu-\r\n\r\nMi diris al vi. Mi. Tute. NE. ZORGAS.",
    "ITEM_BORBOBIGBATTERY_NAME": "AAAAAAA Baterio",
    "ITEM_BORBOBIGBATTERY_PICKUP": "Pliigas ŝildoreŝargan rapidon. Dum ŝildoj estas aktivaj, akiru atakrapidan gratifikon.",
    "ITEM_BORBOBIGBATTERY_DESCRIPTION": "Akiru <style=cIsHealing>ŝildon</style> egalan al <style=cIsHealing>4%</style> de via maksimuma sano. Reduktas <style=cIsUtility>ŝildoreŝargan prokraston</style> je <style=cIsUtility>1.0s</style>. Dum ŝildoj estas aktivaj, pliigas <style=cIsDamage>atakrapidon</style> je <style=cIsDamage>20%</style> <style=cStack>(+20% por stako)</style>.",
    "ITEM_BORBOBIGBATTERY_LORE": "Mendo: Prototipa Baterio\r\nSpurNumero: 11***********\r\nLaŭtaksa Livero: 5/6/2056\r\nSendmetodo: Prioritata\r\nLiveradreso: Esplorstacio Palia, Suno\r\nSenddetaloj:\r\n\r\nBone, kiel estas ĉi tiu?\r\n\r\nNi nu,\r\n\r\n*subrido*\r\n\r\nNu, ni reviziis viajn notojn pri la lasta prototipo, kaj, nu\r\n\r\n(fona babilado)\r\n\r\nNi iomete alĝustigis la dimensiojn\r\n\r\n*subrido*\r\n\r\nNun, ĝi estas iomete pli longa ol via generatora afero, sed, nu\r\n\r\n(sufokita rido)\r\n\r\nNi ankaŭ desegnis ĉi tiun malgrandan, nu, konektilon…\r\n\r\n(Silentu diable, uloj)\r\n\r\nNu, ĉiel ajn, vi povas simple enŝovi ĝin rekte tien, kiel en la demonstra video\r\n\r\n(laŭtaj paŝoj)\r\n\r\nKaj honeste mi pensas ke ni,\r\n\r\n*subrido*\r\n\r\nMi pensas ke ni vere trovis ion bonan ĉi tie, ulo\r\n\r\nKiel ĉi tio povus esti la nu\r\n\r\nLa nova norma elektroprovizo\r\n\r\n*subrido*\r\n\r\nĈu vi komprenas?",
    "ITEM_BINARYSHIELD_NAME": "Kirasa Pereopodo",
    "ITEM_BINARYSHIELD_PICKUP": "Pliigas movrapidon dum ŝildoj estas malaktivaj.",
    "ITEM_BINARYSHIELD_DESCRIPTION": "Akiru <style=cIsHealing>25.0 ŝildon</style> kaj <style=cIsUtility>5% <style=cStack>(+19% por stako)</style> movrapidon</style>. Dum ŝildoj estas malaktivaj, pliigas <style=cIsUtility>movrapidon</style> je <style=cIsUtility>19%</style> <style=cStack>(+19% por stako)</style>. <style=cIsVoid>Koruptas ĉiujn Kaprohufojn de Paŭlo.</style>",
    "ITEM_BIRDBAND_NAME": "Objekto de Programisto",
    "ITEM_BIRDBAND_PICKUP": "Altdamaĝaj trafoj ankaŭ igas vin Regenera por mallonga daŭro. Reŝargiĝas kun la tempo.",
    "ITEM_BIRDBAND_DESCRIPTION": "Trafoj kiuj kaŭzas <style=cIsDamage>pli ol 400% da damaĝo</style> ankaŭ igas vin <style=cIsHealing>Regenera</style> dum <style=cIsDamage>1.5 sekundoj</style> <style=cStack>(+0.75 sekundoj por stako)</style>, restarigante <style=cIsHealing>10% de via maksimuma sano</style> sekunde. Reŝargiĝas ĉiujn 7 sekundojn.",
    "ITEM_BIRDBAND_LORE": "“Mi diras al vi, ili estas realaj.”\r\n\r\n“Neniel, ulo. Tio estas ridinda eĉ por fantoma rakonto.”\r\n\r\n“Jes! ‘Eĉ pli altaj ol la dioj mem’? Realiĝu.”\r\n\r\n“Mi vidis pruvon, mi diras al vi. Aferoj kiuj spitas klarigon.”\r\n\r\n“Ho, rakontu do. Mi tre scivolas.”\r\n\r\n“Ĉu vi konas tiujn misillanĉilojn? Tiujn kiuj kutimis pafi unu grandegan fikan raketon? Kial ili subite komencis vomi tiujn malgrandajn pikilojn?”\r\n\r\n“Mi ne scias.”\r\n\r\n“Estis ili. Ili reverkis ĝin. Kaj- kaj ĉio tiu rubo kiu simple malaperis, kvazaŭ ĝi neniam estus tie. Kaj ĉiuj niaj medicinaj provizoj kiuj subite fariĝis multe malpli efikaj. Ĉu vi rimarkis ke ĉiuj monstroj ne batas tiel forte kiel antaŭe?”\r\n\r\n“Ulo…”\r\n\r\n“Estas reale, mi diras al vi! Kaj ĉiuj niaj vestoj fariĝis tiom pli… mallertaj. Ĉiuj samtempe. Kvankam nenio malbonas kun ili.”\r\n\r\n“...”\r\n\r\n“Kaj mia wungus nun resanigas nur unu sanpoenton.”\r\n\r\n“Ulo. Pri kio diable vi parolas?”\r\n\r\n“Li perdis la saĝon.”",
    "ITEM_CLOUDBOTTLE_NAME": "Nubo En Botelo",
    "ITEM_CLOUDBOTTLE_PICKUP": "Duoble saltu proksime al malamikoj por svenigi ilin!",
    "ITEM_CLOUDBOTTLE_DESCRIPTION": "Akiru aersaltan ŝargon. <style=cIsUtility>15</style>s malvarmiga tempo. Kiam preta, aersalti ene de <style=cIsUtility>9.0m</style> <style=cStack>(+9.0m por stako)</style> de iu ajn malamiko faligas <style=cIsUtility>fumbombon</style>, <style=cIsDamage>svenigante</style> ilin dum <style=cIsDamage>1.0s</style> kaj reduktante la malvarmigan tempon je <style=cIsUtility>10s.</style>",
    "ITEM_FARTBOTTLE_NAME": "Kvarantenita Poluanto",
    "ITEM_FARTBOTTLE_PICKUP": "Duobla salto proksime al malamikoj kripligas kaj damaĝas ilin. <style=cIsVoid>Koruptas ĉiujn Nubojn En Botelo.</style>",
    "ITEM_FARTBOTTLE_DESCRIPTION": "Akiru aersaltan ŝargon. Kiam preta, aersalti ene de <style=cIsUtility>11.0m</style> de malamiko produktas <style=cIsDamage>toksan gason</style>, kaŭzante <style=cIsDamage>200%</style> bazan damaĝon <style=cStack>(+100% por stako)</style> sekunde kaj Kripligante malamikojn interne. Ne povas esti reaktivigita dum <style=cIsUtility>4</style>s. <style=cIsVoid>Koruptas ĉiujn Nubojn En Botelo.</style>",
    "ITEM_CHICKEN_NAME": "Kruda Kokido",
    "ITEM_CHICKEN_PICKUP": "Pliigas maks. sanon. Provu reteni ĝin!",
    "ITEM_CHICKEN_DESCRIPTION": "Pliigas vian <style=cIsHealing>maksimuman sanon</style> je <style=cIsHealing>30%</style> <style=cStack>(+30% por stako)</style>. <style=cIsHealing>Suferu nutraĵveneniĝon</style>, reduktante vian <style=cIsHealing>bazan sanregeneradon</style> je <style=cIsHealing>-2.0 sano/s</style> dum 120 sekundoj.",
    "ITEM_DISCOUNTCARDNEW_NAME": "Lojaleckarto",
    "ITEM_DISCOUNTCARDNEW_PICKUP": "Butikaj terminaloj redonas monon kaj restas malfermitaj. Uzebla dufoje.",
    "ITEM_DISCOUNTCARDNEW_DESCRIPTION": "Kiam oni aĉetas ĉe <style=cIsUtility>multbutikaj</style> terminaloj, la aliaj terminaloj <style=cIsUtility>restas malfermitaj</style>, repagante <style=cIsUtility>$20</style>. Uzebla ĝis du fojoj.",
    "ITEM_BOSSITEMCONSUMABLE_NAME": "Obsidiana Skalpelo",
    "ITEM_BOSSITEMCONSUMABLE_PICKUP": "Grandaj monstroj havas multe pli grandan ŝancon faligi trofeon. Konsumita ĉe falo.",
    "ITEM_BOSSITEMCONSUMABLE_DESCRIPTION": "Mortigi malamikojn kapablajn faligi <style=cIsDamage>trofeajn objektojn</style> donas aldonan <style=cIsUtility>50%</style> ŝancon faligi la <style=cIsDamage>trofeon</style>. Konsumita ĉe sukcesa uzo.",
    "ITEM_BOSSITEMCONSUMABLE_LORE": "Mendo: Medicina Skalpelo (Obsidiano)\r\nSpurNumero: 91***********\r\nLaŭtaksa Livero: 09/30/2056\r\nSendmetodo: Prioritata/Rompebla\r\nLiveradreso: Monto Goliato, Marso\r\nSenddetaloj:\r\n\r\nFajne farita laŭ viaj specifoj. Tre akra. Klingodikeco estas mezurata en Planck-longoj. Ĉi tio certe tranĉos kion ajn vi bezonas.\r\nMi ne povas garantii la daŭripovon, tamen. Provu fari ĝin ĝuste la unuan fojon.\r\nKaj ankoraŭ unu afero – kiam ĝi rompiĝos, ĝi ne atendos ĝis via operacio finiĝos. Ne uzu ĝin sur io kion vi ne volas damaĝi. Aŭ mortigi.\r\nVi jam sciis ĉion tion, tamen. Mi ne povas ne scivoli por kio vi daŭre mendas ĉi tiujn aferojn.",
    "ITEM_EGG_NAME": "Ovo",
    "ITEM_EGG_PICKUP": "Iomete pliigas sanon. Komencas ovoĉasadon. <style=cIsVoid>Koruptas plej multajn manĝeblajn kaj bestajn materiojn</style>.",
    "ITEM_EGG_DESCRIPTION": "Akiru <style=cIsHealing>5 maks. sanon</style>. <style=cIsUtility>Komencu ovoĉasadon</style>. <style=cIsVoid>Koruptas ĉiujn Infuzaĵojn, Bizonajn Bifstekojn kaj Eksterterajn Kapojn</style>.",
    "ITEM_EGG_LORE": "ĉi tiu ovo estas tiom fike bongusta",
    "ITEM_FROZENSHELL_NAME": "Frostita Testudŝelo",
    "ITEM_FROZENSHELL_PICKUP": "Reduktas alvenantan damaĝon ĉe malalta sano.",
    "ITEM_FROZENSHELL_DESCRIPTION": "<style=cIsHealing>Pliigas maksimuman sanon</style> je <style=cIsHealing>8%</style> <style=cStack>(+8% por stako)</style>. Por ĉiuj mankantaj <style=cIsHealth>10% de maks. sano</style>, akiru <style=cIsHealing>5</style> <style=cStack>(+5 por stako)</style> aldonan kirason.",
    "ITEM_GAMMAKNIFE_NAME": "Gama-Tranĉilo",
    "ITEM_GAMMAKNIFE_PICKUP": "Mortigi ĉampionojn konstante reduktas malvarmigajn tempojn kaj portempe garantias Kritikajn Trafojn. <style=cIsVoid>Koruptas ĉiujn Obsidianajn Skalpelojn.</style>",
    "ITEM_GAMMAKNIFE_DESCRIPTION": "Mortigi <style=cIsDamage>Ĉampionon</style> pliigas vian <style=cIsDamage>ŝancon de Kritika Trafo</style> je <style=cIsDamage>100%</style> dum <style=cIsDamage>9.0</style> sekundoj KAJ <style=cIsHealth>konstante</style> pliigas vian <style=cIsUtility>kirason</style> je <style=cIsUtility>5</style> kaj reduktas ĉiujn <style=cIsDamage>kapablajn malvarmigajn tempojn</style> je <style=cIsDamage>-5%</style>, ĝis <style=cIsUtility>9</style> <style=cStack>(+9 por stako)</style> fojoj. <style=cIsVoid>Koruptas ĉiujn Obsidianajn Skalpelojn.</style>",
    "ITEM_GOLDEN_EGG_NAME": "Ora Ovo",
    "ITEM_GOLDEN_EGG_PICKUP": "Kelkfoje, revoj realiĝas...",
    "ITEM_GOLDEN_EGG_DESCRIPTION": "Komence de la sekva etapo, unu ora ovo elkoviĝos en vakuan objekton.",
    "ITEM_BORBODISCOUNT_NAME": "Avida Ringo",
    "ITEM_BORBODISCOUNT_PICKUP": "Akiru ekstran monon kaj regeneradon post malfermo de kestoj.",
    "ITEM_BORBODISCOUNT_DESCRIPTION": "Post elspezo de <style=cIsDamage>mono</style>, akiru <style=cIsDamage>Rabatkuponon</style> dum 20.0 sekundoj. Dum via <style=cIsDamage>Rabatkupono</style> estas aktiva, pliigas enspezon je 15% <style=cStack>(+7.5% por stako)</style> kaj <style=cIsHealing>bazan sanregeneradon</style> je <style=cIsHealing>3.0 sano/s</style> <style=cStack>(+3.0 sano/s por stako)</style>.",
    "ITEM_BORBODISCOUNT_LORE": "Mendo: Mapel Kupon-Kaptilo (Lite)\r\nSpurNumero: 06***********\r\nLaŭtaksa Livero: 11/04/2056\r\nSendmetodo: Prioritata\r\nLiveradreso: 308, Stacio Belfasto, Tero\r\nSenddetaloj:\r\n\r\nBone, jen vi havas. Kiel promesite, ĝi (laŭleĝe kompreneble) rigardas la kodon ĉe elektronikaj aĉetoj por trovi reklamkodojn kaj rabatojn kaj apliki ilin al la aĉeto, sen bezono de uzanta enigo! Ĝi estas tre laŭleĝa.\r\nĜi povas esti iomete malglata en praktiko, ĉar vi bezonas havi la plenan koston ĉemane kaj la kuponkodoj eble ne estas la plej bonaj ofertitaj. Laŭleĝaj kialoj por tio, nature. Ho, kaj estas limo pri kiom da aĉetoj vi povas fari- vi devas atendi iomete por ke ĝi refreŝiĝu se vi volas tiujn kuponojn.\r\nKompreneble, vi ĉiam povas aĉeti la altkvalitan version por senlimaj rabatoj~\r\n",
    "ITEM_KALEIDOSKULL_NAME": "Kalejdokranio",
    "ITEM_KALEIDOSKULL_PICKUP": "Kritikaj Trafoj kaŭzas hazardan malfortigon. <style=cIsVoid>Koruptas ĉiujn Predajn Instinktojn.</style>",
    "ITEM_KALEIDOSKULL_DESCRIPTION": "Akiru <style=cIsDamage>5% kritikan ŝancon</style>. <style=cIsDamage>Kritikaj trafoj</style> hazarde kaŭzas <style=cIsDamage>Ekbruligon</style> aŭ <style=cIsUtility>Froston</style>. Krome havas 50% ŝancon kaŭzi <style=cIsUtility>1</style> <style=cStack>(+1 por stako)</style> hazardajn malfortigojn. <style=cIsVoid>Koruptas ĉiujn Predajn Instinktojn.</style>",
    "ITEM_LIGHTNINGATTRACTOR_NAME": "Kupra Forko",
    "ITEM_LIGHTNINGATTRACTOR_PICKUP": "Altiras fulmon ĉe ripetaj trafoj.",
    "ITEM_LIGHTNINGATTRACTOR_DESCRIPTION": "Damaĝo de iu ajn <style=cIsDamage>kapablo aŭ ekipaĵo</style> ankaŭ pikas la malamikon per kupra forko dum <style=cIsUtility>3.0</style> sekundoj. Ripete ataki forkitan malamikon rekomencigas la daŭron de la forko kaj altiras fulmon, <style=cIsDamage>Svenigante</style> proksiman malamikon por <style=cIsDamage>300% baza damaĝo</style> <style=cStack>(+300% por stako)</style>. Maks. 1, reŝargiĝas <style=cIsUtility>5.0s</style> post kiam la forko eksvalidiĝas.",
    "ITEM_LIGHTNINGATTRACTOR_LORE": "Nova, de CuCo!\r\n\r\nLa CopperWare Manĝilaro ofertas sennombrajn avantaĝojn super via banala Neoksidebla Ŝtala arĝentaĵaro.\r\n\r\nStila ruĝec-bruna koloro por kongrui kun via tabloilaro, kaj perfekta kongruo por via CuCo CopperWare Potoj kaj Patoj aro!\r\n\r\nSuplementa Kupra konsumo rekte el viaj manĝiloj!\r\n\r\nFacila purigado! Viŝado per iu ajn hejma acido kiel Vinagro aŭ Citronsuko revenigos vian CopperWare al fabrika brilo!\r\n\r\nProvu CopperWare hodiaŭ!\r\n\r\nPRODUKTAJ AVERTOJ\r\n\r\nPor eviti riskon de galvana korodo, ne lasu CopperWare kontakti aliajn metalajn surfacojn, precipe en ĉeesto de elektrolitoj kiel salo.\r\n\r\nNe uzu CopperWare manĝilojn en kuirado. Ĉi tio prezentas signifan brulriskon kaj povas ellasi kupron en la pladon.\r\n\r\nKlientoj pli ol 65-jaraj ne estas rekomenditaj uzi CopperWare pro ligoj inter kupro kaj Alzheimer-malsano.\r\n\r\nPro alta elektra konduktiveco de kupro, estas rekomendite ne uzi iujn ajn CopperWare produktojn proksime al elektraj kurentoj aŭ aparatoj.\r\n\r\nPor mildigi riskon de mortiga elektrokuto, bonvolu ne uzi CopperWare produktojn kiam vi manĝas ekstere.\r\n\r\nKun via konsento aĉeti kaj uzi ĉi tiun produkton, CuCo estas liberigita de respondeco pri ajnaj konsumantaj plendoj rilataj al la naturo de kupraj kuirejaj iloj.",
    "ITEM_LOWHEALTHREGEN_NAME": "Ĉarma Kantarelo",
    "ITEM_LOWHEALTHREGEN_PICKUP": "Pliigas regeneradon, sed ĝi nur burĝonas sub 60% sano!",
    "ITEM_LOWHEALTHREGEN_DESCRIPTION": "Dum sub <style=cIsHealing>60% maksimuma sano</style>, pliigas <style=cIsHealing>bazan sanregeneradon</style> je <style=cIsHealing>+2.0 sano/s</style> <style=cStack>(+2.0 sano/s por stako)</style>.",
    "ITEM_LUNARBRAND_NAME": "Stelfajra Marko",
    "ITEM_LUNARBRAND_PICKUP": "Kaŭterizas brulantajn malamikojn, kaŭzante pezan damaĝon <style=cIsHealth>KAJ viŝante ĉiujn iliajn malfortigojn.</style>",
    "ITEM_LUNARBRAND_DESCRIPTION": "Akiru <style=cIsDamage>20%</style> ŝancon <style=cIsDamage>Ekbruligi</style> ĉe trafo. Kaŭzi <style=cIsDamage>5</style> stakojn da brulado Kaŭterizas malamikojn dum <style=cIsDamage>5</style> sekundoj <style=cStack>(+5 por stako)</style>, kaŭzante <style=cIsDamage>900%</style> <style=cStack>(+450% por stako)</style> damaĝon. Plie, Kaŭterizo malrapidigas malamikojn je 50% kaj nuligas ĉian resanigon, <style=cIsHealth>SED... Kaŭterizitaj malamikoj estas purigitaj de ĉiuj malfortigoj kaj havas +30 kirason.</style>",
    "ITEM_LUNARINCREASECD_NAME": "Kunprema Buklo",
    "ITEM_LUNARINCREASECD_PICKUP": "Ĉiuj kapabloj pafas lunajn splitojn... <style=cIsHealth>SED ĉiuj kapabloj havas pliigitajn malvarmigajn tempojn</style>",
    "ITEM_LUNARINCREASECD_DESCRIPTION": "Ĉe iu ajn kapablouzo, pafu <style=cIsDamage>lunajn splitojn</style> por <style=cIsDamage>160% damaĝo</style> (pliiĝas kun kapabla malvarmiga tempo). <style=cIsHealth>Pliigas la malvarmigajn tempojn de ĉiuj kapabloj je 1.0 sekundo</style> <style=cStack>(+1.0 por stako)</style>.",
    "ITEM_MAGICQUIVER_NAME": "Magia Sagujo",
    "ITEM_MAGICQUIVER_PICKUP": "Uzi kapablojn havas ŝancon ne konsumi ŝargon.",
    "ITEM_MAGICQUIVER_DESCRIPTION": "Donas <style=cIsDamage>10.0%</style> <style=cStack>(+10.0% por stako)</style> ŝancon ne konsumi ŝargon ĉe kapablouzo. <style=cIsUtility>Netuŝita de bonŝanco</style>.",
    "ITEM_BORBOMANAFLOWER_NAME": "Donaco de Naturo",
    "ITEM_BORBOMANAFLOWER_PICKUP": "Iomete pliigas atakrapidon kaj reduktas Primaran kaj Sekundaran malvarmigajn tempojn.",
    "ITEM_BORBOMANAFLOWER_DESCRIPTION": "Pliigas <style=cIsDamage>atakrapidon</style> je <style=cIsUtility>8%</style> <style=cStack>(+8% por stako)</style>, kaj reduktas <style=cIsUtility>Primarajn kaj Sekundarajn kapablajn malvarmigajn tempojn</style> je <style=cIsUtility>8%</style> <style=cStack>(+8% por stako)</style>.",
    "ITEM_BORBOMANAFLOWER_LORE": "Mendo: Jupitera Rozo\r\nSpurNumero: 58***********\r\nLaŭtaksa Livero: 07/30/2056\r\nSendmetodo: Norma\r\nLiveradreso: 280 Oak Boulevard, Venuso\r\nSenddetaloj:\r\n\r\nĈu ĝi ne estas bela?\r\nNur rigardi ĝin plenigas min per energio.\r\nLa naturo estas tiel magia :)",
    "ITEM_MINIAMETHYST_NAME": "Ametista Fragmento",
    "ITEM_MINIAMETHYST_PICKUP": "Aktivigi vian Ekipaĵon reduktas viajn kapablajn malvarmigajn tempojn.",
    "ITEM_MINIAMETHYST_DESCRIPTION": "Aktivigi vian Ekipaĵon reduktas <style=cIsUtility>ĉiujn kapablajn malvarmigajn tempojn</style> je <style=cIsUtility>10%</style> <style=cStack>(+10% por stako)</style> de la baza malvarmiga tempo de via Ekipaĵo.",
    "ITEM_DANGERCRIT_NAME": "La Nova Hakilo",
    "ITEM_DANGERCRIT_PICKUP": "Amase pliigas 'Kritikan Trafon' damaĝon ĉe malalta sano.",
    "ITEM_DANGERCRIT_DESCRIPTION": "Akiru <style=cIsDamage>20% kritikan ŝancon.</style> Fali sub <style=cIsHealth>50% sano</style> sendas vin en furiozon, pliigante <style=cIsDamage>kritikan trafdamaĝon je 250%</style> <style=cStack>(+250% por stako)</style>, kaj <style=cIsDamage>kritikan trafŝancon je 30%</style>. Mortigi malamikojn <style=cIsDamage>plilongigas</style> la furiozon je <style=cIsDamage>4.0 sekundoj</style>.",
    "ITEM_DANGERCRIT_LORE": "Nomo: [FORIGITA]\r\nNaskiĝdato: 21-a de junio 1961\r\nOkupo: Ekzekutisto\r\n\r\nTempo de morto: 23-a de aŭgusto 2058\r\nLoko de morto: [FORIGITA], Merkuro\r\nKaŭzo de morto: Severa sangoperdo pro korpa mutilado\r\n\r\nNotoj:\r\nHakilo en senmakula stato estis trovita apud la korpo. Ekzameno determinis ke la armilo estas tre imuna al kaj eluziĝo kaj makuloj, precipe de sango. La konstruo de la hakilo kongruas kun forĝisto sur Sues Drive, Jupitero, kun kiu [FORIGITA] estis en kontakto mallonge antaŭ sia morto. \r\n\r\n[FORIGITA] faris 126 konatajn hommortigojn en la horo antaŭ sia morto. Ĉiu viktimo estis mortigita per senkapigo kaj havis neniujn aliajn vundojn. Atestantoj raportas ke [FORIGITA] akcidente batis sin mem kaj duonigis sian korpon ĉe la talio, sangante ĝismorte momentojn poste. \r\n\r\nNekropsio rivelas degeneron de internaj organoj antaŭanta la morton de [FORIGITA]. Simptomoj ŝajnas kongrui kun certaj stamoj de [FORIGITA] trovitaj sur Jupitero. Neniu degenero estis trovita en la cerbo, tamen estas eble ke la malsano influis lian mensan staton.\r\n",
    "ITEM_GOODEXECUTIONITEM_NAME": "Ĉiamfrosto",
    "ITEM_GOODEXECUTIONITEM_PICKUP": "Ŝanco Frostigi malamikojn ĉe pezaj trafoj, tuj mortigante ilin ĉe malalta sano.",
    "ITEM_GOODEXECUTIONITEM_DESCRIPTION": "<style=cIsDamage>3.0%</style> <style=cStack>(+2.0% por stako)</style> ŝanco ĉe trafo <style=cIsDamage>por % de malamika maksimuma sano kaŭzita kiel damaĝo</style> por <style=cIsUtility>Frostigi</style> malamikojn surloke dum <style=cIsUtility>1.5 sekundoj.</style> Frostigitaj malamikoj estas <style=cIsHealth>tuj mortigitaj</style> ĉe malalta sano.",
    "ITEM_PHOTOGRAPH_NAME": "Fotografaĵo",
    "ITEM_PHOTOGRAPH_PICKUP": "Printi objektojn pliigas kritikan trafŝancon kaj damaĝon. Rekomenciĝas komence de ĉiu etapo.",
    "ITEM_PHOTOGRAPH_DESCRIPTION": "Elspezi objektojn ĉe iu ajn printilo pliigas <style=cIsDamage>kritikan trafŝancon</style> kaj <style=cIsDamage>kritikan trafdamaĝon</style> je <style=cIsDamage>+10.0%</style> <style=cStack>(+5.0% por stako)</style>, ĝis <style=cIsUtility>3 fojoj</style> <style=cStack>(+0 por stako)</style>. Rekomenciĝas komence de ĉiu etapo.",
    "ITEM_PHOTOGRAPH_LORE": "Ĉu vi printigis viajn fotojn?\n\n\"Bogos binted?\"\n\nHe?\n\n\"Download GreenAlienHead\"",
    "ITEM_CHARGEDMALACHITESPINE_NAME": "Ŝargita Malakita Spino",
    "ITEM_CHARGEDMALACHITESPINE_PICKUP": "Venenas vin mem kiam ŝildoj rompiĝas, gajnante grandan damaĝreziston.",
    "ITEM_CHARGEDMALACHITESPINE_DESCRIPTION": "Akiru <style=cIsHealing>50.0 ŝildon</style> <style=cStack>(+50.0 por stako)</style>. Dum venenite, akiru <style=cIsHealing>200.0 kirason</style>. <style=cIsHealth>Veneno estas kaŭzita dum 5.0 sekundoj ĉe ŝildorompo</style> <style=cStack>(+5.0 sekundoj por stako)</style>.",
    "ITEM_WISHBONE_NAME": "Dezirosto",
    "ITEM_WISHBONE_PICKUP": "Rompiĝas dum ŝtormoj. Se portita al la Teleportilo, deziro estos plenumita.",
    "ITEM_WISHBONE_DESCRIPTION": "Rompiĝas dum ŝtormoj. Se portita al la Teleportilo, deziro estos plenumita.",
    "ITEM_WISHBONE_LORE": "rakoooonnntttooooo",
    "ITEM_RANDOMBARRIERTARGET_NAME": "Kristala Globuso",
    "ITEM_RANDOMBARRIERTARGET_PICKUP": "Emfazas proksiman malamikon. Akiru barilon kaj kritikan trafŝancon ĉe trafo.",
    "ITEM_RANDOMBARRIERTARGET_DESCRIPTION": "Reduktas barilan kadukiĝon je <style=cIsHealing>-20%</style>. <style=cIsDamage>Emfazas</style> hazardan malamikon. Ataki la celitan malamikon donas <style=cIsHealing>portempan barilon</style> por <style=cIsHealing>8.0 sano</style> <style=cStack>(+8.0 por stako)</style> kaj pliigas <style=cIsDamage>kritikan trafŝancon</style> je <style=cIsDamage>+20.0%</style> <style=cStack>(+10.0% por stako)</style>.",
    "ITEM_RANDOMBARRIERTARGET_LORE": "Mendo: Kristala Globuso\r\nSpurNumero: 66***********\r\nLaŭtaksa Livero: 5/6/2056\r\nSendmetodo: Reveno\r\nLiveradreso: Arcane Suppliers Inc., La Ŝvebanta Citadelo, Neptuno\r\nSenddetaloj:\r\n\r\nMi mendis ĉi tiun Aŭguran Globon de vi, kaj ho miaj dioj, mi NENIAM plu aĉetos ion el ĉi tiu loko. Ĉi tio estas tuta fika FRAŬDO!!! \r\n\r\nMi provis dum HOROJ, ke ĉi tiu globo montru al mi ION AJN, kaj neniam eĉ unufoje mi ricevis momenton de dia klarvidado. \r\n\r\nKaj kredu min, mi SCIAS ke mi estas klerigita, mi estas MULTE PLI klerigita ol iu ajn el vi DAMNITAJ MUSTELOJ ĉe Arcane FRAŬDISTOJ. Ne fike diru al mi ke mi ne estas sufiĉe klerigita. \r\n\r\nVia kristala, aŭ ĉu mi diru plasta, globo kostis al mi pli ol miajn TUTAJN ŝparaĵojn. MI POSTULAS MIAN MONON REEN, AŬ VI ALFRONTOS TERURAJN KONSEKVENCOJN!!!",
    "ITEM_SHIELDAMP_NAME": "Klaka Ŝtono",
    "ITEM_SHIELDAMP_PICKUP": "Dum ŝildoj estas plenaj, via sekva atako drenas malgrandan kvanton da ŝildo por plifortigita damaĝo.",
    "ITEM_SHIELDAMP_DESCRIPTION": "Akiru <style=cIsHealing>40 ŝildon</style>. Dum ŝildoj estas plenaj, <style=cIsDamage>plifortigas</style> damaĝon de kapabloj. <style=cIsDamage>Plifortigitaj</style> trafoj <style=cIsDamage>drenas 40%</style> de via maks. ŝildo <style=cStack>(-8% por stako)</style>, kaŭzante <style=cIsDamage>+400% BAZAN damaĝon</style> <style=cStack>(+250% por stako)</style>. Plifortigita damaĝo disvastiĝas al <style=cIsDamage>2</style> proksimaj malamikoj.",
    "ITEM_STARVEIL_NAME": "Stela Vualo",
    "ITEM_STARVEIL_PICKUP": "Ricevi damaĝon igas vin nevenkebla... <style=cIsHealth>SED meteoroj falos proksime, vundante kaj malamikojn kaj aliancanojn.</style>",
    "ITEM_STARVEIL_DESCRIPTION": "Post esti trafita, fariĝu <style=cIsUtility>nevenkebla al ĉiu alvenanta damaĝo</style> dum 0.33 <style=cStack>(+0.33 por stako)</style> sekundoj. Poste, kaŭzu 3 <style=cStack>(+2 por stako)</style> <style=cIsDamage>ondojn de meteoroj</style> fali el la ĉielo, <style=cIsHealth>damaĝante ĈIUJN rolulojn</style> por <style=cIsDamage>300% damaĝo por eksplodo.</style>",
    "ITEM_STARVEIL_LORE": "ESTAS MI. MI HAVAS ĜIN.\r\n\r\nĈU VI EKSCITIĜAS? ĈU VI TIMAS? ĈU VI PENTAS? ĈU VI NE KREDAS?\r\n\r\nMURDISTO.\r\n\r\nVI MORTIGIS MIAJN ?????. VI PROFANIS ILIAJN FORMOJN. VI UZIS ILIAJN ANIMOJN POR BUĈI MIAJN ?????. VI FARIS TERURAJN EKSPERIMENTOJN EN LA NOMO DE FALSAJ DIOJ. KAJ LA REZULTO DONIS AL VI POTENCON.\r\n\r\nSED VI PERDIS ĜIN.\r\n\r\nKAJ NUN MI HAVAS ĜIN. MI ESTAS ĈIRKAŬITA DE LA ANIMOJ DE MIAJ ????? KAJ MI ESTAS PLENA DE VENĜO.\r\n\r\nDE KIO VI ESTAS PLENA? TIMO KAJ BEDAŬRO?\r\n\r\nKIE ESTAS VIA “NEVENKEBLECO” NUN? KIE ESTAS VIA “DIOMORTIGA POTENCO?” KIE ESTAS VIAJ “STELOJ?”\r\n\r\nILI ESTAS KUN MI. VI ESTAS TIOM PLI OL MURDISTO. VI ESTAS STULTULO. IMBECILO. SENSAĜULO. KAJ VI BEDAŬROS ĈION KION VI FARIS AL MI KAJ MIAJ ?????.\r\n\r\nĈAR MI VENAS POR VI. ĈIUN KOMPATINDAN BATON KIUN VI DONAS AL MI MI UZOS POR PLUVIGI MORTON SUR ĈION KION VI IAM KONIS.\r\n\r\nKION VI FAROS? VIAJ FALSAJ DIOJ NE RESPONDOS PREĜON. ESTAS NENIO KION VI POVAS FARI. SE VI KUROS MI NUR ESTOS PLI KOLERA.\r\n\r\nMI ESTOS TIE BALDAŬ. VI NE DEVOS MALESPERI LONGE.\r\n\r\nLA ANIMOJ DE MIAJ ????? TRINKOS VIAJN KRIOJN KIEL NEKTARON.",
    "ITEM_UTILITYBARRIER_NAME": "Utileca Tranĉilo",
    "ITEM_UTILITYBARRIER_PICKUP": "Uzi vian Utilecan kapablon donas portempan barilon.",
    "ITEM_UTILITYBARRIER_DESCRIPTION": "Aktivigi vian <style=cIsUtility>Utilecan kapablon</style> ankaŭ donas al vi <style=cIsHealing>portempan barilon</style> por <style=cIsHealing>3%</style> de via maksimuma sano <style=cStack>(+1.5% por stako)</style> por sekundo de la <style=cIsUtility>baza malvarmiga tempo</style> de la kapablo.",
    "ITEM_VOIDLASERTURBINE_NAME": "Super-Solenoida Motoro",
    "ITEM_VOIDLASERTURBINE_PICKUP": "Uzi kapablojn ŝargas detruan laseran primaran atakon. <style=cIsVoid>Koruptas ĉiujn Brilajn Behemotojn kaj Resonancajn Diskojn.</style>",
    "ITEM_VOIDLASERTURBINE_DESCRIPTION": "Uzi viajn kapablojn konstruas ŝargon. Post kiam 90 sekundoj da ŝargo akumuliĝis, preparu 1 uzon <style=cStack>(+1 por stako)</style> de <style=cIsVoid>Ĉieltraborilo</style>, anstataŭigante vian Primaran atakon. Pafi per <style=cIsVoid>Ĉieltraborilo</style> kaŭzas <style=cIsDamage>3200% damaĝon</style>, traborante ĈIUJN malamikojn kaj terenon. <style=cIsVoid>Koruptas ĉiujn Brilajn Behemotojn kaj Resonancajn Diskojn.</style>",
    "ITEM_VOIDUTILITYBELT_NAME": "Mebiusa Fluo",
    "ITEM_VOIDUTILITYBELT_PICKUP": "Uzi vian Utilecan kapablon donas aldonan eksplodon de movrapido. <style=cIsVoid>Koruptas ĉiujn Utilecajn Tranĉilojn.</style>",
    "ITEM_VOIDUTILITYBELT_DESCRIPTION": "Aktivigi vian <style=cIsUtility>Utilecan kapablon</style> ankaŭ pliigas vian <style=cIsUtility>movrapidon</style> je <style=cIsUtility>4%</style> <style=cStack>(+4% por stako)</style> por sekundo de la <style=cIsUtility>baza malvarmiga tempo</style> de la kapablo. Daŭras <style=cIsUtility>2.5 sekundojn</style>. <style=cIsVoid>Koruptas ĉiujn Utilecajn Tranĉilojn.</style>",
    "ITEM_CUCKLER_NAME": "Kobalta Ŝildo",
    "ITEM_CUCKLER_PICKUP": "Nuligas ĉian repuŝon. Reduktas alvenantan damaĝon kaj akiras barilon dum senmova.",
    "ITEM_CUCKLER_DESCRIPTION": "Nuligas <style=cIsUtility>ĈIAN repuŝon</style>. Pliigas <style=cIsHealing>kirason</style> je <style=cIsHealing>20</style> <style=cStack>(+20 por stako)</style> kaj <style=cIsHealing>barilan generadon</style> je <style=cIsHealing>6 sano/s</style> <style=cStack>(+6 sano/s por stako)</style>. Dum senmova, ĉi tiuj efikoj estas <style=cIsUtility>kvinobligitaj</style>.",
    "ITEM_CUCKLER_LORE": "<style=cIsHealth>Mi ne povas lasi vin eniri ĝis vi liberigos min de mia malbeno.</style>",
    "ITEM_ECONOMYWEAPON_NAME": "Monera Pafilo",
    "ITEM_ECONOMYWEAPON_PICKUP": "Kaŭzas gratifikan damaĝon por ĉiu kesto kiun vi povas pagi.",
    "ITEM_ECONOMYWEAPON_DESCRIPTION": "Komencu ĉiun etapon kun <style=cIsUtility>$25</style>. Dum tenado de <style=cIsUtility>$25 aŭ pli</style>, kaŭzu <style=cIsDamage>20% gratifikan damaĝon</style> <style=cStack>(+20% por stako)</style>, plus <style=cIsDamage>4%</style> <style=cStack>(+4% por stako)</style> por <style=cIsUtility>aldonaj $25 tenataj</style>, ĝis maksimumo de <style=cIsUtility>10 fojoj</style>.",
    "ITEM_ECONOMYWEAPON_LORE": "Ulo, ĉi tiu afero estas tiel mojosa. B-zap! Haha.\r\n\r\nHej. Amiko. Rigardu ĉi tion.\r\n\r\nKio diable estas tio?\r\n\r\nNe. Rigardu.\r\n\r\n…He? Tio aĉas.\r\n\r\nAŭskultu, ulo. DU. MONAJ. PAFILOJ.\r\n\r\nVi estas idioto. Ĉi tiu ŝargas per oro. Tiu pafas oron. Kio okazas se vi forpafas tutan nian oron, Cooper? Ni ne povas ŝargi niajn pafilojn.\r\n\r\nEstas bone, ulo. La monstroj sur ĉi tiu planedo estas plenaj de mono. Rigardu ĉion ĉi!\r\n\r\n…Hm. Kio estas tiu afero?\r\n\r\nEstas ĉi tiu, kiel, ĉapela afero kiun mi trovis? Ĝi altiras monon aŭ ion. Se ni postvivos ĉi tion ni estos riĉaj.\r\n\r\nVi devas ĉesi preni tiujn aferojn. Ili ĉiuj provis mortigi nin iam.\r\n\r\nNe ĉi tiu, ulo. Rigardu- ups. Aŭ.\r\n\r\nNu.\r\n\r\nKio?\r\n\r\nKien iris tuta nia oro?",
    "ITEM_CRITRETALIATE_NAME": "Emblemo de Detruanto",
    "ITEM_CRITRETALIATE_PICKUP": "Kritike trafu post ricevo de damaĝo.",
    "ITEM_CRITRETALIATE_DESCRIPTION": "Post esti trafita, akiru <style=cIsDamage>100.0%</style> ŝancon <style=cIsDamage>Kritike Trafi</style>, velkantan dum <style=cIsDamage>3.0 sekundoj</style> <style=cStack>(+1.5 por stako)</style>.",
    "ITEM_FLOWERCROWN_NAME": "Flora Krono",
    "ITEM_FLOWERCROWN_PICKUP": "Pliigas vian maksimuman sanon.",
    "ITEM_FLOWERCROWN_DESCRIPTION": "Pliigas <style=cIsHealing>maksimuman sanon</style> je <style=cIsHealing>12%</style> <style=cStack>(+12% por stako)</style>.",
    "ITEM_FLOWERCROWN_LORE": "Mendo: Flora Krono\r\nSpurNumero: 10***********\r\nLaŭtaksa Livero: 11/02/2056\r\nSendmetodo: Prioritata/Rompebla\r\nLiveradreso: Etaĝo 16, Spiralaj Ĝardenoj, Tero\r\nSenddetaloj:\r\n\r\nDankon pro ĉiam sendi al ni donacojn. Mi faris kelkajn el ili en ĉi tiun floran kronon por vi. Porti ĝin sentigas min forta, kvazaŭ nenio povus venki min. Espereble ĝi faras la samon por vi! <3\r\n",
    "ITEM_BORBOMOLOTOV_NAME": "Molotov (1-Pako)",
    "ITEM_BORBOMOLOTOV_PICKUP": "Ŝanco ĉe trafo ĵeti brulantan molotovon.",
    "ITEM_BORBOMOLOTOV_DESCRIPTION": "<style=cIsDamage>9.0%</style> ŝanco ĉe trafo ĵeti <style=cIsDamage>molotov-koktelon</style>, kiu <style=cIsDamage>ekbruligas</style> malamikojn por <style=cIsDamage>60%</style> <style=cStack>(+60% por stako)</style> TUTA damaĝo kaj lasas <style=cIsDamage>brulantan</style> areon por <style=cIsDamage>30%</style> <style=cStack>(+30% por stako)</style> TUTA damaĝo sekunde.",
    "ITEM_BORBOMOLOTOV_LORE": "Mendo: Etanola Botelo (32 oz.), 6-Pako\r\nSpurNumero: 81******\r\nLaŭtaksa Livero: 05/8/2058\r\nSendmetodo: Prioritata\r\nLiveradreso: Bieno Teromere, Strato Privet, Marso\nSenddetaloj: Sciigu niajn amikojn interne ke ni venos por trinki la 16-an de junio. Estos infera festo, ili verŝajne devus ekiri antaŭ ol aferoj tro eskalados.",
    "ITEM_SLUNGUS_NAME": "Dormantaj Sporoj",
    "ITEM_SLUNGUS_PICKUP": "Stari senmove ŝirmas vin, malrapidigante proksimajn malamikojn kaj pafaĵojn. Moviĝu pli rapide ĝis trafita.",
    "ITEM_SLUNGUS_DESCRIPTION": "Dum senmova, kreu ŝirman <style=cIsUtility>stazan kampon</style> atingantan 24.0m ĉirkaŭ vi, <style=cIsUtility>malrapidigante</style> proksimajn malamikojn kaj pafaĵojn je <style=cIsUtility>80%</style>. Moviĝu 20% pli rapide <style=cStack>(30% por stako)</style> ĝis la sekva fojo kiam vi estos trafita.",
    "ITEM_SLUNGUS_LORE": "Mendo: Lay-Z Funga Vojaĝkunulo\r\nSpurNumero: 58***********\r\nLaŭtaksa Livero: 09/23/2056\r\nSendmetodo: Prioritata/Biologia\r\nLiveradreso: 444 Slate Drive, Marso\r\nSenddetaloj:\r\n\r\nDankon pro via aĉeto!\r\n\r\nInstrukcioj:\r\nTurnu ajuton al ‘Malfermita’. Sporoj disvastiĝos en la aeron, kaŭzante ke tempo kurbiĝu kaj pasu pli malrapide, tiel mallongigante vian atendon dum la cetero de realeco spertos tempon pli rapide. Povas daŭri iom da tempo por ke la kurbaj efikoj okazu; lasu la sporbotelon en unu areo por maksimumigi spornombron. Se vi vojaĝas en malgranda fermita spaco, la sporoj povas eventuale plenigi la tutan areon. Ventolu regule por malhelpi trosaturiĝon.\r\nPor fini tempokurban efikon, fermu ajuton kaj forlasu aŭ ventolu la trafitan areon. Ĉiam fermu ajuton antaŭ ol forlasi trafitan areon; parta korpa eksponiĝo al tempokurbiĝo povas havi nedeziratajn efikojn.\r\nNoto- vi eble spertos tempon normale dum pluraj sekundoj aŭ minutoj post kiam la kurbiĝo komenciĝas; ĉi tio estas normala. Simple atendu ĝis tempo malrapidiĝos ankaŭ por vi (la malrapide moviĝantaj objektoj rekomencos sian normalan rapidon kaj netrafitaj objektoj ŝajnos akceliĝi) kaj tiam feliĉan atendadon!\r\n\r\nAvertoj:\r\nObjektoj ŝajnas moviĝi pli malrapide, sed portas la saman forton kiel normale. Ne interagu kun normale rapide moviĝantaj aŭ fortaj objektoj en nesekura maniero.\r\nLa trafita areo spertas malaltigitan temperaturon; vi eble volos porti varmajn vestaĵojn aŭ altigi vian hejtilon. Termometroj ne precize mezuras temperaturon en trafita areo; supozu ke praktikaj temperaturoj estas ĝis 50 gradojn pli malaltaj ol mezuritaj.\r\n<style=cIsHealth>Ne malfermu botelon. Traktu kun ekstrema zorgo. Ventolu regule.</style>\r\n\r\nFUN-GUYS Inc. ne respondecas pri ajna malsano, vundo, morto, plilongigita aŭ konstanta ŝanĝo en tempopercepto, spaca kurbiĝo, manio aŭ letargio, halucino, paranojo, akuta panika atako, aŭ alie nekontentigaj rezultoj. Ĉiuj aĉetoj estas finaj.",
    "ITEM_VOIDHAPPIESTMASK_NAME": "Forgesita Fasado",
    "ITEM_VOIDHAPPIESTMASK_PICKUP": "Ŝanco ĉe mortigo de malamiko alvoki vakuajn infektantojn. <style=cIsVoid>Koruptas ĉiujn Plej Feliĉajn Maskojn.</style>",
    "ITEM_VOIDHAPPIESTMASK_DESCRIPTION": "Mortigi monstrojn havas <style=cIsDamage>7.0%</style> ŝancon aperigi 2 <style=cStack>(+1 por stako)</style> <style=cIsDamage>vakuajn infektantojn</style> en ilia loko. <style=cIsVoid>Koruptas ĉiujn Plej Feliĉajn Maskojn.</style>",
    "ITEM_ATTACKSPEEDHELPER_NAME": "AtakrapidaHelpanto",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_NAME": "Luna Galerio",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_CONTEXT": "manĝu mian transcendecon, nerdo",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_NAME": "Kaduka Konstruaĵo",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_CONTEXT": "Piedbati la Konstruaĵon",
    "2R4R_INTERACTABLE_EGG_PILE_NAME": "Ovo",
    "2R4R_INTERACTABLE_EGG_PILE_CONTEXT": "Trovis ovon",
    "2R4R_INTERACTABLE_FLOWERBLOOM_NAME": "Ho...?",
    "2R4R_INTERACTABLE_FLOWERBLOOM_CONTEXT": "Ĝi estas bela, ho tiel bela...",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_NAME": "Sanktejo de Konverĝo",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_CONTEXT": "Preĝi al la Sanktejo de Konverĝo",
    "2R4R_INTERACTABLE_VOID_HUSK_NAME": "Fendita Ŝelo",
    "2R4R_INTERACTABLE_VOID_HUSK_CONTEXT": "Malfermi per rompo",
    "2R4R_INTERACTABLE_WISHBONECARCASS_NAME": "Aŭguro",
    "2R4R_INTERACTABLE_WISHBONECARCASS_CONTEXT": "Rompi Aŭguron",
    "EQUIPMENT_BROKENZAPINATOR_NAME": "Oranĝa Zapinator",
    "EQUIPMENT_BROKENZAPINATOR_PICKUP": "<style=cIsUtility>Mi ne povas kredi ke ni lasis ĉi tion en la ludo!</style>",
    "EQUIPMENT_BROKENZAPINATOR_DESCRIPTION": "Pafas pafaĵon.",
    "EQUIPMENT_NINJAGEAR_NAME": "Ekipaĵo de Majstra Ninĵo",
    "EQUIPMENT_NINJAGEAR_PICKUP": "Havas ŝancon eviti alvenantajn atakojn. Aktivigu por impeti kaj faligi fumbombon.",
    "EQUIPMENT_NINJAGEAR_DESCRIPTION": "Aktivigu por <style=cIsUtility>impeti antaŭen 25m</style>, kaj akiru <style=cIsHealing>20% ŝancon</style> <style=cIsHealing>eviti</style> alvenantajn atakojn. Impeti kaj eviti faligos <style=cIsDamage>fumbombon</style>, <style=cIsUtility>svenigante malamikojn</style> ene de 13m dum <style=cIsUtility>1 sekundo</style>.",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_NAME": "Mortnaskita Preĝo",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_PICKUP": "Donas unuopan deziron...",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_DESCRIPTION": "Donas Nekutiman objekton laŭ via elekto.",
    "EQUIPMENT_THEMACHINE_NAME": "La Maŝino",
    "EQUIPMENT_THEMACHINE_PICKUP": "Ĝi faras nenion. Tio estas la beleco de ĝi!",
    "EQUIPMENT_THEMACHINE_DESCRIPTION": "Ĝi faras nenion. Tio estas la beleco de ĝi!",
    "EQUIPMENT_TESLAEQUIPMENT_NAME": "Rimarkinde Stabila Tesla Bobeno",
    "EQUIPMENT_TESLAEQUIPMENT_PICKUP": "Ŝokas proksimajn malamikojn kaj restarigas Ŝildojn ĉe mortigo.",
    "EQUIPMENT_TESLAEQUIPMENT_DESCRIPTION": "<style=cIsUtility>Elektrigu</style> vin mem dum <style=cIsUtility>10.0 sekundoj</style>. Mortigoj dum <style=cIsUtility>Elektrigita</style> ŝokos <style=cIsDamage>4.0</style> proksimajn malamikojn por <style=cIsDamage>200% damaĝo</style> kaj <style=cIsHealing>restarigos 15% de viaj ŝildoj</style>. Pasive akiru <style=cIsHealing>ŝildon</style> egalan al <style=cIsHealing>20% de via maksimuma sano</style>.",
    "EQUIPMENT_TESLAEQUIPMENT_LORE": "<style=cMono>Tesla Prezentprogramaro v1.14\nŜaltiĝante...\n10...</style>\nEligante bonvenigan deklaron...\n<style=cMono>9...</style>\nBonvenon al ĉiuj!\n<style=cMono>8...</style>\nBonvolu sidiĝi.\n<style=cMono>7...</style>\nCertigu ke tiuj malantaŭ vi povas vidi.\n<style=cMono>6...</style>\nLa prezento komenciĝos baldaŭ.\n<style=cMono>5...</style>\nBonvolu obei la personaron por via sekureco.\n<style=cMono>4...\nKomencante ĉambran etosan lumigadon...\n3...</style>\nPretiĝu por rigardi...\n<style=cMono>2...</style>\nLa mirindajn miraklojn...\n<style=cMono>1...</style>\nDe elektro!\n<style=cMono>Potenca anomalio detektita...\nKomencante rekomencan proceduron post 10.0...</style>",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_NAME": "Tempo de Chir",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_PICKUP": "Fariĝu aspekto de rapideco.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_DESCRIPTION": "Pliigas mov-, atak- kaj kapabloreŝargan rapidon.",
    "BORBO_ELITE_AFFIX_SPEED_MODIFIER": "Sanktigita {0}",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_NAME": "Fendita Kredo",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_PICKUP": "Fariĝu aspekto de vanteco.",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_DESCRIPTION": "Fariĝu aspekto de vanteco.",
    "BORBO_ELITE_MIRRORED_MODIFIER": "Spegulita {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_NAME": "Koncedo de N’Kuhana",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_PICKUP": "Fariĝu aspekto de eterneco.",
    "BORBO_ELITE_AFFIX_LEECH_MODIFIER": "Serpenta {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_NAME": "Abisma rigardo",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_PICKUP": "Fariĝu aspekto de la simulakro",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_DESCRIPTION": "Iuj statistikoj supren mi ne scias, lol",
    "BORBO_ELITE_AFFIX_SIMULATED_MODIFIER": "Simulita {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_NAME": "Refreno de Bava",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_PICKUP": "Fariĝu aspekto de forto.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_DESCRIPTION": "Ĉiuj atakoj estas eksplodemaj. Periode pafas bombkanonon.",
    "BORBO_ELITE_AFFIX_EXPLOSIVE_MODIFIER": "Volatila {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_NAME": "Dormanta Forto",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_PICKUP": "Fariĝu aspekto de inundo.",
