        "ROB_HUNK_BODY_SHOOT_ROCKETLAUNCHER_NAME": "Огонь",
        "ROB_HUNK_BODY_SHOOT_ROCKETLAUNCHER_DESCRIPTION": "Стреляет на <style=cIsDamage>12.000% урона</style>. <style=cIsDamage>Зажигательный.</style>",
        "ROB_HUNK_BODY_SHOOT_GRENADELAUNCHER_NAME": "Огонь",
        "ROB_HUNK_BODY_SHOOT_GRENADELAUNCHER_DESCRIPTION": "Стреляет на <style=cIsDamage>3.200% урона</style>. <style=cIsDamage>Зажигательный.</style>",
        "ROB_HUNK_BODY_SHOOT_MGL_NAME": "Огонь",
        "ROB_HUNK_BODY_SHOOT_MGL_DESCRIPTION": "Стреляет на <style=cIsDamage>2.400% урона</style>.",
        "ROB_HUNK_BODY_SHOOT_RAILGUN_NAME": "Огонь",
        "ROB_HUNK_BODY_SHOOT_RAILGUN_DESCRIPTION": "Стреляет на <style=cIsDamage>20.000% урона</style>.",
        "ROB_HUNK_BODY_SHOOT_FLAMETHROWER_NAME": "Огонь",
        "ROB_HUNK_BODY_SHOOT_FLAMETHROWER_DESCRIPTION": "Стреляет струёй пламени на <style=cIsDamage>тонны урона</style>. <style=cIsUtility>Поджигает.</style>",
        "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Сканирование",
        "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Сканирует в поисках <style=cIsUtility>неоткрытых кейсов с оружием</style>.",
        "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Крюк-кошка",
        "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Выстрелите крюком в <style=cIsUtility>отдалённую точку</style>, затем <style=cIsUtility>подтянитесь к ней</style>. <style=cIsDamage>Вы можете контратаковать после приземления.</style>",
        "ROB_HUNK_KEYWORD_VIRUS": "Вирус",
        "ROB_HUNK_JETPACK_NAME": "Экспериментальный Реактивный Ранец",
        "ROB_HUNK_JETPACK_DESC": "Инструмент, созданный Umbrella, позволяющий двигаться в любом направлении, нажав прыжок в воздухе.",
        "ROB_HUNK_SURVIVALKIT_NAME": "Аварийный Набор Выживания",
        "ROB_HUNK_SURVIVALKIT_DESC": "Набор выживания, увеличивающий как способность обыскивать патроны, так и эффективность вашего ножа.",
        "ROB_HUNK_TRANSCEIVER_NAME": "Изношенный Передатчик",
