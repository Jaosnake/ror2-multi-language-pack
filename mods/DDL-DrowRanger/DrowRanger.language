{
    "strings": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Frost Archer",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Dread Retribution",
        "DROWRANGER_DESCRIPTION": "Drow Ranger excels at controlling distance and breaking through enemy defenses with deadly arrows.<style=cSub>\n\n< ! >Keep enemies at a distance to make the most of Marksmanship. Her bolts travel slowly, so aim carefully to hit distant targets.\n\n< ! >Frost Arrows slow dangerous foes. Hypothermia turns crowds into chain explosions.\n\n< ! >Gust creates room to retreat, while Glacier provides a temporary vantage point.\n\n< ! >Choose an exclusive relic to improve your range, survival or critical strikes.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex leaves the frozen wastes behind.",
        "DROWRANGER_OUTRO_FAILURE": "The frost claims another hunter.",
        "DROWRANGER_RELIC_TITLE": "Exclusive Relic",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Primary arrows deal full damage within <style=cIsUtility>50m</style>, retaining <style=cIsDamage>75%</style> beyond <style=cIsUtility>100m</style>. Hits <style=cIsUtility>knock back</style> non-boss enemies within <style=cIsUtility>12m</style>. All arrow projectiles travel <style=cIsUtility>50% faster</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Increase attack speed by <style=cIsDamage>20%</style>. Gain a <style=cIsHealing>30% chance to block damage</style>. Stacks with Tougher Times with diminishing returns.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Gain <style=cIsDamage>30% critical strike chance</style>. Critical strikes deal <style=cIsDamage>225% damage</style>, before other critical damage bonuses.",
        "DROWRANGER_PRIMARY_NAME": "Frost Arrows",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Frost</style>. Fire an arrow for <style=cIsDamage>260% damage</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Hypothermia",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Hypothermia</style>. Fire an arrow for <style=cIsDamage>260% damage</style>. Afflicted enemies explode on death.",
        "DROWRANGER_SECONDARY_NAME": "Multishot",
        "DROWRANGER_SECONDARY_DESC": "Fire <style=cIsDamage>3 waves</style> of piercing arrows for <style=cIsDamage>3x360% damage</style>. Each wave applies your selected arrow effect. Attack speed shortens the channel at half efficiency.",
        "DROWRANGER_UTILITY_NAME": "Gust",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Stunning</style>. Release a gust that <style=cIsUtility>knocks enemies back</style> and applies <style=cIsUtility>3 stacks</style> of your arrow effect. Gain <style=cIsUtility>50% movement speed</style> for <style=cIsUtility>4s</style>, and leap backwards if not sprinting.",
        "DROWRANGER_GLACIER_NAME": "Glacier",
        "DROWRANGER_GLACIER_DESC": "Raise a towering <style=cIsUtility>glacier</style> beneath you for <style=cIsUtility>8s</style>, lifting you to its summit and <style=cIsUtility>knocking nearby enemies back</style>.",
        "DROWRANGER_SPECIAL_NAME": "Marksmanship",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Passive</style>: With no enemies within <style=cIsUtility>15m</style>, primary arrows have a <style=cIsDamage>30%</style> chance to become <style=cIsDamage>armor-piercing arrows</style> for <style=cIsDamage>390% damage</style>.\n<style=cIsUtility>Activate</style>: Increase this chance to <style=cIsDamage>100%</style> for <style=cIsUtility>5s</style>, or <style=cIsDamage>50%</style> with nearby enemies.",
        "DROWRANGER_WINTER_NAME": "Winter Strike",
        "DROWRANGER_WINTER_DESC": "Briefly wind up, then fire an <style=cIsDamage>armor-piercing arrow</style> for <style=cIsDamage>1600% damage</style>, piercing up to <style=cIsDamage>5 enemies</style> and applying <style=cIsUtility>10 stacks</style> of your arrow effect. The windup cannot be cancelled voluntarily.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Frost</style><style=cSub>Reduce remaining movement speed by 15% per stack for 3s. Stacks up to 10 times. Hits refresh all stacks. Does not freeze enemies.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Hypothermia</style><style=cSub>Stacks up to 10 times for 7s. On death, explode for 150%–600% damage in a 2–12m radius based on stacks. Explosions spread Hypothermia and can chain. Does not slow enemies.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Arrow range</style><style=cSub>Primary arrow damage falls beyond 40m, retaining 60% at 80m. Hurricane Pike extends this range.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Armor-piercing</style><style=cSub>Ignores positive armor. Can critically strike and retains the selected arrow effect.</style>"
    },
    "default": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Frost Archer",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Dread Retribution",
        "DROWRANGER_DESCRIPTION": "Drow Ranger excels at controlling distance and breaking through enemy defenses with deadly arrows.<style=cSub>\n\n< ! >Keep enemies at a distance to make the most of Marksmanship. Her bolts travel slowly, so aim carefully to hit distant targets.\n\n< ! >Frost Arrows slow dangerous foes. Hypothermia turns crowds into chain explosions.\n\n< ! >Gust creates room to retreat, while Glacier provides a temporary vantage point.\n\n< ! >Choose an exclusive relic to improve your range, survival or critical strikes.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex leaves the frozen wastes behind.",
        "DROWRANGER_OUTRO_FAILURE": "The frost claims another hunter.",
        "DROWRANGER_RELIC_TITLE": "Exclusive Relic",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Primary arrows deal full damage within <style=cIsUtility>50m</style>, retaining <style=cIsDamage>75%</style> beyond <style=cIsUtility>100m</style>. Hits <style=cIsUtility>knock back</style> non-boss enemies within <style=cIsUtility>12m</style>. All arrow projectiles travel <style=cIsUtility>50% faster</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Increase attack speed by <style=cIsDamage>20%</style>. Gain a <style=cIsHealing>30% chance to block damage</style>. Stacks with Tougher Times with diminishing returns.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Gain <style=cIsDamage>30% critical strike chance</style>. Critical strikes deal <style=cIsDamage>225% damage</style>, before other critical damage bonuses.",
        "DROWRANGER_PRIMARY_NAME": "Frost Arrows",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Frost</style>. Fire an arrow for <style=cIsDamage>260% damage</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Hypothermia",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Hypothermia</style>. Fire an arrow for <style=cIsDamage>260% damage</style>. Afflicted enemies explode on death.",
        "DROWRANGER_SECONDARY_NAME": "Multishot",
        "DROWRANGER_SECONDARY_DESC": "Fire <style=cIsDamage>3 waves</style> of piercing arrows for <style=cIsDamage>3x360% damage</style>. Each wave applies your selected arrow effect. Attack speed shortens the channel at half efficiency.",
        "DROWRANGER_UTILITY_NAME": "Gust",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Stunning</style>. Release a gust that <style=cIsUtility>knocks enemies back</style> and applies <style=cIsUtility>3 stacks</style> of your arrow effect. Gain <style=cIsUtility>50% movement speed</style> for <style=cIsUtility>4s</style>, and leap backwards if not sprinting.",
        "DROWRANGER_GLACIER_NAME": "Glacier",
        "DROWRANGER_GLACIER_DESC": "Raise a towering <style=cIsUtility>glacier</style> beneath you for <style=cIsUtility>8s</style>, lifting you to its summit and <style=cIsUtility>knocking nearby enemies back</style>.",
        "DROWRANGER_SPECIAL_NAME": "Marksmanship",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Passive</style>: With no enemies within <style=cIsUtility>15m</style>, primary arrows have a <style=cIsDamage>30%</style> chance to become <style=cIsDamage>armor-piercing arrows</style> for <style=cIsDamage>390% damage</style>.\n<style=cIsUtility>Activate</style>: Increase this chance to <style=cIsDamage>100%</style> for <style=cIsUtility>5s</style>, or <style=cIsDamage>50%</style> with nearby enemies.",
        "DROWRANGER_WINTER_NAME": "Winter Strike",
        "DROWRANGER_WINTER_DESC": "Briefly wind up, then fire an <style=cIsDamage>armor-piercing arrow</style> for <style=cIsDamage>1600% damage</style>, piercing up to <style=cIsDamage>5 enemies</style> and applying <style=cIsUtility>10 stacks</style> of your arrow effect. The windup cannot be cancelled voluntarily.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Frost</style><style=cSub>Reduce remaining movement speed by 15% per stack for 3s. Stacks up to 10 times. Hits refresh all stacks. Does not freeze enemies.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Hypothermia</style><style=cSub>Stacks up to 10 times for 7s. On death, explode for 150%–600% damage in a 2–12m radius based on stacks. Explosions spread Hypothermia and can chain. Does not slow enemies.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Arrow range</style><style=cSub>Primary arrow damage falls beyond 40m, retaining 60% at 80m. Hurricane Pike extends this range.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Armor-piercing</style><style=cSub>Ignores positive armor. Can critically strike and retains the selected arrow effect.</style>"
    },
    "en": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Frost Archer",
