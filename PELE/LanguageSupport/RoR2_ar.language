    "VOIDSURVIVOR_PASSIVE_DESCRIPTION": "عند اكتمال <style=cIsVoid>الفساد</style>، تتحول قدراتك إلى أشكال أكثر شراسة.",
    "VOIDSURVIVOR_PRIMARY_NAME": "【الإغراق」",
