    "ROB_HUNK_C4_CONTEXT": "Zünder aktivieren",
    "ROB_HUNK_KEYWORD_LOOTING": "<style=cKeywordName>Plündernd</style><style=cSub>Mit dieser Fertigkeit besiegte Gegner haben eine geringe Chance, Munition fallen zu lassen.</style>",
    "ROB_HUNK_KEYWORD_MANGLED": "<style=cKeywordName>Zerfetzt</style><style=cSub>Bei 6 Stapeln dieses Schwächungseffekts erleiden Gegner sofort <style=cIsDamage>2200% Schaden</style>.</style>",
    "ROB_HUNK_KEYWORD_PERFECTDODGE": "<style=cKeywordName>Perfektes Ausweichen</style><style=cSub><style=cIsUtility>Erstattet die Abklingzeit zurück</style> und macht dich kurzzeitig unverwundbar. Ermöglicht einen <style=cIsDamage>Gegenangriff</style>.</style>",
    "ROB_HUNK_KEYWORD_PERFECTPARRY": "<style=cKeywordName>Perfektes Parieren</style><style=cSub>Verursacht <style=cIsDamage>800% Schaden</style> und macht dich kurzzeitig unverwundbar. Ermöglicht einen <style=cIsDamage>Gegenangriff</style>.</style>",
    "ROB_HUNK_KEYWORD_PERFECTBASH": "<style=cKeywordName>Perfekter Schulterstoß</style><style=cSub><style=cIsUtility>Erstattet die Abklingzeit zurück</style> und macht dich kurzzeitig unverwundbar. Ermöglicht einen <style=cIsDamage>Gegenangriff</style>.</style>",
    "ROB_HUNK_KEYWORD_COUNTER": "<style=cKeywordName>Gegenangriff</style><style=cSub>Durch Drücken von <style=cIsDamage>Primär</style> stürzt du vor und führst einen tödlichen <style=cIsDamage>Gegenangriff</style> gegen einen nahen Gegner aus.</style>",
    "ROB_HUNK_KEYWORD_VIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Einmal pro Stufe wird ein zufälliges Monster <color=#C678B4>Infiziert</color>. Es mutiert, <style=cIsHealth>wird mit der Zeit stärker</style>, und sein Tod lässt eine <color=#FFFF00>G-Virus-Probe</color> fallen.</style>\n\n<style=cKeywordName>T-Virus</style><style=cSub>Einmal pro Stufe werden mehrere Monster <color=#0066FF>Infiziert</color>. Dadurch werden sie zweimal <style=cIsHealth>wiederbelebt</style>, und alle zu töten bringt dir eine <color=#FFFF00>T-Virus-Probe</color> ein.</style>\n\n<style=cKeywordName>C-Virus</style><style=cSub>Einmal pro Stufe werden mehrere Monster <color=#FF0033>Infiziert</color>. Nach dem Tod geraten diese Monster für <style=cIsUtility>5</style> Sekunden in <style=cIsDamage>Raserei</style> und <style=cIsHealth>explodieren</style> dann; alle zu töten bringt dir eine <color=#FFFF00>C-Virus-Probe</color> ein.</style>",
    "ROB_HUNK_KEYWORD_GVIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Einmal pro Stufe wird ein zufälliges Monster <color=#C678B4>Infiziert</color>. Es mutiert, <style=cIsHealth>wird mit der Zeit stärker</style>, und sein Tod lässt eine <color=#FFFF00>G-Virus-Probe</color> fallen.</style>",
    "ROB_HUNK_KEYWORD_TVIRUS": "<style=cKeywordName>T-Virus</style><style=cSub>Einmal pro Stufe werden mehrere Monster <color=#0066FF>Infiziert</color>. Dadurch werden sie zweimal <style=cIsHealth>wiederbelebt</style>, und alle zu töten bringt dir eine <color=#FFFF00>T-Virus-Probe</color> ein.</style>",
    "ROB_HUNK_KEYWORD_CVIRUS": "<style=cKeywordName>C-Virus</style><style=cSub>Einmal pro Stufe werden mehrere Monster <color=#FF0033>Infiziert</color>. Nach dem Tod geraten diese Monster für <style=cIsUtility>5</style> Sekunden in <style=cIsDamage>Raserei</style> und <style=cIsHealth>explodieren</style> dann; alle zu töten bringt dir eine <color=#FFFF00>C-Virus-Probe</color> ein.</style>",
    "ROB_HUNK_WEAPON_SMG_NAME": "LE 5",
    "ROB_HUNK_WEAPON_SMG_DESC": "Eine leistungsstarke Maschinenpistole.",
    "ROB_HUNK_WEAPON_ADDON_SMG_NAME": "Laservisier (LE 5)",
    "ROB_HUNK_WEAPON_ADDON_SMG_DESC": "Ein Spezialteil für die LE 5, das ihre Wirksamkeit auf große Entfernung und bei Schwachstellentreffern erhöht.",
    "ROB_HUNK_WEAPON_ADDON2_SMG_NAME": "Erweitertes Magazin (LE 5)",
    "ROB_HUNK_WEAPON_ADDON2_SMG_DESC": "Ein Spezialteil für die LE 5, das ihre Magazinkapazität deutlich erhöht.",
    "ROB_HUNK_WEAPON_ADDON3_SMG_NAME": "Moderator (LE 5)",
    "ROB_HUNK_WEAPON_ADDON3_SMG_DESC": "Ein Spezialteil für die LE 5, das ihre Feuerrate begrenzt, diesen Bonus aber stattdessen in Schaden umwandelt.",
    "ROB_HUNK_WEAPON_SMG2_NAME": "LE 5",
    "ROB_HUNK_WEAPON_SMG2_DESC": "Eine leistungsstarke Maschinenpistole.",
