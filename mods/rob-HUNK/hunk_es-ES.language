    "ROB_NEMESIS_BODY_PASSIVE_NAME": "Forma de Vida Definitiva",
    "ROB_NEMESIS_BODY_PASSIVE_DESCRIPTION": "<style=cIsDamage>Infligir daño</style> almacena <style=cIsHealth>Biomasa</style>, potenciando tu <style=cIsDamage>daño</style> al llenarse. Los saltos pueden <style=cIsDamage>cargarse</style> para efectuar <style=cIsUtility>saltos colosales</style>.",
    "ROB_NEMESIS_BODY_PASSIVE2_NAME": "Armamento Biológico",
    "ROB_NEMESIS_BODY_PASSIVE2_DESCRIPTION": "El Nemesis T-Type puede <style=cIsHealth>mutar</style> devorando a <style=cIsDamage>objetivos de interés</style>, adquiriendo <style=cIsDamage>habilidades nuevas y mejoradas</style>.",
    "ROB_NEMESIS_BODY_PASSIVE22_NAME": "Impulso de Masa Muscular",
    "ROB_NEMESIS_BODY_PASSIVE22_DESCRIPTION": "Los <style=cIsUtility>ataques cuerpo a cuerpo</style> infligen un <style=cIsDamage>20%</style> más de daño, <style=cIsHealth>PERO los aliados pueden recibir daño</style>.",
    "ROB_NEMESIS_BODY_MELEE_NAME": "Asalto Brutal",
    "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Asesta un puñetazo del <style=cIsDamage>350% de daño</style>. Úsalo estando <style=cIsUtility>quieto</style> para pisotear con un <style=cIsDamage>800% de daño</style>. Úsalo al <style=cIsUtility>esprintar</style> para placar con un <style=cIsDamage>600% de daño</style>.",
    "ROB_NEMESIS_BODY_GRAB_NAME": "Alcance Letal",
    "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Atrapa a un enemigo. Usa Primaria para devorarlo y curar un 10% de salud máxima, o Secundaria para cargar un lanzamiento de hasta un 2400% de daño.",
    "ROB_NEMESIS_BODY_DASH_NAME": "Acometida Biológica",
    "ROB_NEMESIS_BODY_DASH_DESCRIPTION": "Úsalo estando <style=cIsUtility>en el aire</style> para impulsarte <style=cIsDamage>una vez</style>.",
    "ROB_NEMESIS_BODY_ULTIMATE_NAME": "Masa Crítica",
    "ROB_NEMESIS_BODY_ULTIMATE_DESCRIPTION": "Mantén pulsado para consumir poco a poco la <style=cIsHealth>Biomasa</style>, restaurando hasta un <style=cIsHealing>100% de salud máxima</style>.",
