    "POPCORN_LEE_HYPERREAL_BODY_PASSIVE_GREEN_VFX_NAME": "Grüne VFX",
    "POPCORN_LEE_HYPERREAL_BODY_PASSIVE_GREEN_VFX_DESCRIPTION": "Ändert die VFX-Farbe in Grün.",
    "POPCORN_LEE_HYPERREAL_BODY_PASSIVE_BLUE_VFX_NAME": "Blauer VFX",
    "POPCORN_LEE_HYPERREAL_BODY_PASSIVE_BLUE_VFX_DESCRIPTION": "Ändert die VFX-Farbe in Blau.",
