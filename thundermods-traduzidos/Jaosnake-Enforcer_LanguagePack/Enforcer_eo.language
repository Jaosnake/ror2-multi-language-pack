        "ACHIEVEMENT_ENFORCER_CLASSICUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Kiel Enforcer, montru viajn dancmovojn.",
        "ACHIEVEMENT_ENFORCER_DESPERADOUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Rules of Nature",
        "ACHIEVEMENT_ENFORCER_DESPERADOUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Kiel Enforcer, venku la unikan gardanton de Gilded Coast pusxante gxin de la rando de la mapo.",
        "ACHIEVEMENT_ENFORCER_BUNGUSUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Deviganta Perfekteco",
        "ACHIEVEMENT_ENFORCER_BUNGUSUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Kiel Enforcer, unuigu vin kun la Bungus.",
        "ACHIEVEMENT_ENFORCER_STORMTROOPERUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Vivu la Imperio",
        "ACHIEVEMENT_ENFORCER_STORMTROOPERUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Kiel Enforcer, venku elitan Solus Control Unit.",
        "ACHIEVEMENT_ENFORCER_FROGUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Tra Dika kaj Maldika",
        "ACHIEVEMENT_ENFORCER_FROGUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Kiel Enforcer, faru amikon sur la luno.",
        "ACHIEVEMENT_ENFORCER_STEVEUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Enforcer: Blokoj",
        "ACHIEVEMENT_ENFORCER_STEVEUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Kiel Enforcer, bloku atakon per via sxildo.",
        "ENFORCER_STEVEUNLOCKABLE_UNLOCKABLE_NAME": "Enforcer: Blokoj",
        "ENFORCER_PRIMARY_SHOTGUN_NAME_UPGRADE_DESCRIPTION": "<style=cIsUtility>+5%</style> da damagxo, <style=cIsUtility>+10%</style> da kuglodekeco, kaj <style=cIsUtility>+0.1</style> da kuglodisvastigxo",
        "ENFORCER_PROC_BULLET": "Kuglo",
        "ENFORCER_PROC_HAMMER": "Martelo",
