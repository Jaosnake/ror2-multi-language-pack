{
    "es-419": {
        "ROB_HUNK_BODY_NAME": "HUNK",
        "ROB_HUNK_BODY_DESCRIPTION": "HUNK es un infiltrado de élite que porta un gran arsenal de armas obtenidas mediante OSP (On-Site Procurement).<color=#CCD3E0>\n\n< ! > Usa el cuchillo de combate contra enemigos débiles para ahorrar munición.\n\n< ! > Al conseguir la muestra del virus G obtendrás una tarjeta para abrir maletines de armas en cada fase.\n\n< ! > Esquiva cerca de un enemigo atacante o proyectil para lograr una esquiva perfecta y contraataca con la habilidad primaria.\n\n< ! > La munición escasea, pero puedes encontrarla en cofres abiertos. Las cargas de secundaria y la reducción de enfriamiento también afectan a la munición.\n\n< ! > Esto es la guerra. Sobrevivir es tu responsabilidad.</color>",
        "ROB_HUNK_BODY_SUBTITLE": "El Segador",
        "ROB_HUNK_BODY_OUTRO_FLAVOR": "..y así partió, todo bien.",
        "ROB_HUNK_BODY_OUTRO_FAILURE": "..y así desapareció, unidad humana ahora neutralizada.",
        "ROB_HUNK_BODY_DEFAULT_SKIN_NAME": "Predeterminado",
        "ROB_HUNK_BODY_CLASSIC_SKIN_NAME": "RE2hacer",
        "ROB_HUNK_BODY_TOFU_SKIN_NAME": "tofu",
        "ROB_HUNK_BODY_SUPER_SKIN_NAME": "<color=#FFFF00> Partidario temprano</color>",
        "ROB_HUNK_BODY_LIGHTWEIGHT_SKIN_NAME": "Ligero",
        "ROB_HUNK_BODY_GUERRILLA_SKIN_NAME": "Tropa",
        "ROB_HUNK_BODY_ROOKIE_SKIN_NAME": "Recluta",
        "ROB_HUNK_BODY_SWAT_SKIN_NAME": "Pacificador",
        "ROB_HUNK_BODY_LEON_SKIN_NAME": "Especialista",
        "ROB_HUNK_BODY_LEONSHIRT_SKIN_NAME": "Especialista EX",
        "ROB_HUNK_BODY_ENFORCER_SKIN_NAME": "Excavadora",
        "ROB_HUNK_BODY_WESKER_SKIN_NAME": "Cerebro",
        "ROB_HUNK_BODY_DOOM_SKIN_NAME": "Asesino",
        "ROB_HUNK_BODY_COMMANDO_SKIN_NAME": "Commando",
        "ROB_HUNK_BODY_JACKET_SKIN_NAME": "Chaqueta",
        "ROB_HUNK_BODY_PPASSIVE_NAME": "OSP (contratación in situ)",
        "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK puede recolectar <color=#FFFF00>U.C. Keycards</color> para abrir <style=cIsDamage>estuches de armas</style> y expandir su arsenal.",
        "ROB_HUNK_BODY_PPASSIVE2_NAME": "Soldado Olvidado",
        "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "El primer <style=cIsHealth>jefe</style> en morir en cada Etada deja caer un <style=cIsDamage>paquete de suministros</style> que contiene un arma o accesorio.",
        "ROB_HUNK_BODY_PASSIVE_NAME": "Lucha Sombría",
        "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Comienza con una <style=cIsDamage>LE 5</style> y un <style=cIsDamage>arma secundaria</style>. Puedes <style=cIsDamage>hurgar</style> <style=cIsUtility>baúles</style> en busca de municiones.",
        "ROB_HUNK_BODY_PASSIVE2_NAME": "Temor Inminente",
        "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "Comienza con un <style=cIsDamage>arsenal completo</style>, <style=cIsHealth>PERO</style> no puedes <style=cIsHealth>obtener municiones adicionales</style>.",
        "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "Nuevo juego+",
        "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Comienza con una <style=cIsDamage>LE 5</style> y un <style=cIsDamage>arma secundaria</style>. Puedes <style=cIsDamage>hurgar</style> <style=cIsUtility>baúles</style> en busca de municiones. <style=cIsHealth>Todo el contenido de los estuches de armas es aleatorio.</style>",
        "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Autoridad Suprema",
        "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "Comienza con una <style=cIsDamage>W-870</style> y un <style=cIsDamage>arma secundaria</style>. Puedes <style=cIsDamage>hurgar</style> <style=cIsUtility>baúles</style> en busca de municiones.",
        "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Mercenario Supremo",
        "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Comienza <style=cIsHealth>SOLO</style> con una <style=cIsDamage>LE 5 totalmente mejorada</style>. Puedes <style=cIsDamage>hurgar</style> <style=cIsUtility>baúles</style> en busca de municiones. El <style=cIsDamage>Especial</style> es reemplazado por <color=#C80202>Modo Caos</color>.",
        "ROB_HUNK_BODY_WPASSIVE_NAME": "Saturación Global Completa",
        "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "Comienza <style=cIsHealth>SOLO</style> con un <style=cIsDamage>arma secundaria</style>. Puedes <style=cIsDamage>hurgar</style> <style=cIsUtility>baúles</style> en busca de municiones. La <style=cIsDamage>Utilidad</style> es reemplazada por <color=#C80202>Uroboros</color>.",
        "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Piromanía",
        "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "Comienza <style=cIsHealth>SOLO</style> con un <style=cIsDamage>Lanzallamas Químico</style>. Puedes <style=cIsDamage>hurgar</style> <style=cIsUtility>baúles</style> en busca de municiones. <style=cIsHealth>Solo UN estuche de armas aparece por Etapa.</style>",
        "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Cuchillo de Combate",
        "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Saqueo.</style> <style=cIsDamage>Corta</style> a enemigos cercanos e inflige <style=cIsDamage>200% de daño</style> y <style=cIsHealth>Mutilación</style>.",
        "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Combate Cuerpo a Cuerpo)",
        "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Saqueo.</style> <style=cIsDamage>Patea dos veces</style> e inflige <style=cIsDamage>200% y 250% de daño</style>. Si acierta la <style=cIsUtility>segunda patada</style>, ejecuta un <style=cIsDamage>contraataque</style>.",
        "ROB_HUNK_BODY_PRIMARY_RELOAD_NAME": "Recargar",
        "ROB_HUNK_BODY_RELOAD_DESCRIPTION": "Recarga tu arma actual.",
        "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Apuntar Firme",
        "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Apunta, <style=cIsUtility>exponiendo puntos débiles del enemigo</style>. <style=cIsDamage>Usar el primario mientras apuntas dispara tu arma equipada.</style>",
        "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Paso ligero",
        "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Avanza</style> una corta distancia. Si se usa preventivamente para <style=cIsUtility>evitar un ataque</style>, realiza una <style=cIsDamage>Esquiva Perfecta</style>.",
        "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "uroboros",
        "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Avanza</style> una corta distancia. Si se usa preventivamente para <style=cIsUtility>evitar un ataque</style>, realiza una <style=cIsDamage>Esquiva Perfecta</style>. El poder de Uroboros fluye a través de ti.",
        "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Aparar",
        "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Bloquea</style> un ataque, <style=cIsDamage>anulando</style> el daño y <style=cIsUtility>reembolsando la recarga</style>. Si se usa preventivamente, realiza una <style=cIsDamage>Aparición Perfecta</style>.",
        "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Embestida de Hombro",
        "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Golpea</style> a enemigos cercanos con el hombro, <style=cIsUtility>atudiéndolos</style> para <style=cIsDamage>400% de daño</style>. Si se usa preventivamente para <style=cIsUtility>cancelar un ataque</style>, realiza una <style=cIsDamage>Deflexión Perfecta</style>.",
        "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Legión",
        "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Cambia</style> a un <style=cIsDamage>arma diferente</style>. Toca para cambiar a tu <style=cIsUtility>última arma usada</style>.",
        "ROB_HUNK_BODY_SPECIAL_MAYHEM_NAME": "Modo Caos",
        "ROB_HUNK_BODY_SPECIAL_MAYHEM_DESCRIPTION": "Entra en <style=cIsDamage>Modo Caos</style>, aumentando drásticamente el rendimiento del arma.",
        "ROB_HUNK_BODY_CONFIRM_NAME": "Confirmar",
        "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "Proceder con la habilidad actual.",
        "ROB_HUNK_BODY_CANCEL_NAME": "Cancelar",
        "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "Cancelar la habilidad actual.",
        "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Cuchillo de Combate",
        "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "Un cuchillo militar estándar. Ciertamente útil en momentos difíciles.",
        "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "Cuchillo de Combate EX",
        "ROB_HUNK_BODY_KNIFE_INFINITE_DESCRIPTION": "Un cuchillo militar especialmente tratado que ha sido endurecido a un grado increíble. Se dice que está hecho para durar realmente.",
        "ROB_HUNK_BODY_KNIFE_HIDDEN_NAME": "Hoja Oculta",
        "ROB_HUNK_BODY_KNIFE_HIDDEN_DESCRIPTION": "Una hoja retráctil de bajo perfil escondida en la manga. Ideal para operaciones sigilosas.",
        "ROB_HUNK_BODY_KNIFE_WESKER_NAME": "Cuchillo Personalizado",
        "ROB_HUNK_BODY_KNIFE_WESKER_DESCRIPTION": "Una hoja cruel con borde dentado para ayudar a desgarrar a tus oponentes.",
        "ROB_HUNK_BODY_KNIFE_MACHETE_NAME": "Machete",
        "ROB_HUNK_BODY_KNIFE_MACHETE_DESCRIPTION": "Una hoja enorme destinada principalmente a tácticas de guerrilla.",
        "ROB_HUNK_BODY_KNIFE_RE4_NAME": "Cuchillo Primario",
        "ROB_HUNK_BODY_KNIFE_RE4_DESCRIPTION": "Un cuchillo forjado con infinitas posibilidades.",
        "ROB_HUNK_BODY_KNIFE_BLOODY_NAME": "Hoja Ensangrentada",
        "ROB_HUNK_BODY_KNIFE_BLOODY_DESCRIPTION": "Una hoja ensangrentada con un borde dentado que ya ha desgarrado a muchos oponentes.",
        "ROB_HUNK_BODY_KNIFE_HOTDOGGER_NAME": "PERRITO CALIENTE",
        "ROB_HUNK_BODY_KNIFE_HOTDOGGER_DESCRIPTION": "Como el nombre indica, este cuchillo anti-bioweapon desarrollado por Umbrella es usado por aquellos que les gusta presumir.",
