    "GNOMECHEF_BOOSTED_UTILITY_NAME": "原油",
    "GNOMECHEF_BOOSTED_UTILITY_DESCRIPTION": "洒出更多的油，<style=cIsUtility>减速敌人</style>。当<style=cIsUtility>上油</style>的敌人被<style=cIsDamage>点火</style>时，造成<style=cIsDamage>78%伤害</style>。",
