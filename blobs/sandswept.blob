					for (int j = 0; j < decayStacks; j++)
					{
						InflictDotInfo val5 = default(InflictDotInfo);
						val5.attackerObject = ((Component)base.body).gameObject;
						val5.victimObject = ((Component)body).gameObject;
						val5.totalDamage = null;
						val5.damageMultiplier = 1f;
						val5.dotIndex = Decay.decayIndex;
						val5.maxStacksFromAttacker = uint.MaxValue;
						val5.duration = float.MaxValue;
						InflictDotInfo val6 = val5;
						DotController.InflictDot(ref val6);
					}
				}
			}
			if (val2.hitPoints.Length != 0)
			{
				for (int k = 0; k < 20; k++)
				{
					Util.PlaySound("Play_voidDevastator_step", ((Component)this).gameObject);
				}
				Util.PlaySound("Play_voidRaid_gauntlet_platform_move_start", ((Component)this).gameObject);
				Util.PlaySound("Play_voidDevastator_m2_secondary_explo", ((Component)this).gameObject);
				Util.PlaySound("Play_voidJailer_m1_shoot", ((Component)this).gameObject);
				EffectData val7 = new EffectData
				{
					origin = base.body.corePosition,
					scale = PreservedAtoll.radius
				};
				EffectData val8 = new EffectData
				{
					origin = base.body.corePosition,
					scale = PreservedAtoll.radius / 1.35f
				};
				EffectData val9 = new EffectData
				{
					origin = base.body.corePosition,
					scale = PreservedAtoll.radius / 2f
				};
				EffectManager.SpawnEffect(PreservedAtoll.missVFX, val7, true);
				EffectManager.SpawnEffect(PreservedAtoll.missVFX, val8, true);
				EffectManager.SpawnEffect(PreservedAtoll.missVFX, val9, true);
				if (base.body.HasBuff(PreservedAtoll.readyBuff))
				{
					base.body.RemoveBuff(PreservedAtoll.readyBuff);
					for (int l = 1; (float)l <= PreservedAtoll.cooldown; l++)
					{
						base.body.AddTimedBuff(PreservedAtoll.cooldownBuff, (float)l);
					}
				}
			}
			else
			{
				EffectData val10 = new EffectData
				{
					origin = base.body.corePosition,
					scale = PreservedAtoll.radius
				};
				EffectManager.SpawnEffect(PreservedAtoll.missVFX, val10, true);
				Util.PlaySound("Play_voidRaid_snipe_pool_damage", ((Component)this).gameObject);
			}
		}

		public void OnDestroy()
		{
			if (base.body.HasBuff(PreservedAtoll.readyBuff))
			{
				base.body.RemoveBuff(PreservedAtoll.readyBuff);
			}
			if (base.body.HasBuff(PreservedAtoll.cooldownBuff))
			{
				base.body.RemoveBuff(PreservedAtoll.cooldownBuff);
			}
		}
	}
