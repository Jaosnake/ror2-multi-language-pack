    "GUNSLINGER_GAMBLE_UNLOCKABLE_ACHIEVEMENT_DESC": "Löse als Gunslinger in einem einzigen Durchlauf einen Shrine of Chance 7 Mal hintereinander erfolgreich aus.",
    "GUNSLINGER_GAUNTLET_ITEM_NAME": "Infinity-Handschuh",
    "GUNSLINGER_GAUNTLET_ITEM_DESC": "<style=cIsDamage>Tötet zufällig 50%</style> <style=cIsHealth>aller</style> Lebewesen. Lädt sich alle <style=cIsUtility>60s</style> wieder auf.",
    "GUNSLINGER_GAUNTLET_ITEM_PICKUP": "Lösche die Hälfte allen Lebens nach dem Zufallsprinzip aus.",
    "GUNSLINGER_GAUNTLET_ITEM_LORE": "„Ich weiß, wie es ist zu verlieren. Verzweifelt zu spüren, dass man im Recht ist, und dennoch zu scheitern. Es ist beängstigend, lässt einem die Knie zittern.“",
    "GUNSLINGER_NAME": "Gunslinger",
    "GUNSLINGER_SUBTITLE": "Friedenswächter",
    "GUNSLINGER_PASSIVE_NAME": "Gespenstergestalt",
    "GUNSLINGER_PASSIVE_DESCRIPTION": "Gunslinger wird stärker, wenn er sich in der Nähe feindlicher Einheiten befindet.               <style=cKeywordName>Gespenstergestalt</style><style=cSub></style>",
    "GUNSLINGER_VENDETTA": "Vendetta",
    "GUNSLINGER_VENDETTA_DESCRIPTION": "Gunslinger feuert Vendetta für 280% Schaden pro Kugel ab, führt bis zu sechs Kugeln mit sich und lädt nach der letzten nach. Jede sechste Kugel trifft kritisch für zusätzliche 25% Schaden.",
    "GUNSLINGER_UNLOAD": "Entladen",
    "GUNSLINGER_UNLOAD_DESCRIPTION": "Feuere Vendetta für 200% Schaden ab. Für jeden erfolgreichen Treffer auf einen Feind werden Schaden und kritische Trefferchance von Entladen erhöht, bis zu +150% Schaden und 40% kritische Trefferchance. Verfehlte Schüsse (Skybox zählt nicht) setzen die Stapel von Entladen zurück.",
    "GUNSLINGER_ACCURSEDARM": "Verfluchter Arm",
    "GUNSLINGER_ACCURSEDARM_DESCRIPTION": "Gunslinger lädt einen mächtigen Fluch auf, der 400% Schaden verursacht und Feinde in einer Linie durchdringt. Getroffene Feinde werden geschwächt.",
    "GUNSLINGER_ORB": "Verfluchte Kugel",
    "GUNSLINGER_ORB_DESCRIPTION": "Gunslinger schleudert eine mächtige Fluchsphäre, die nahe Feinde für 10% Schaden schockt und beim Aufprall in einem weiten Bereich für 320% Schaden explodiert. Durch die Explosion getroffene Feinde werden geschwächt.",
    "GUNSLINGER_WRAITHSTEP": "Gespensterschritt",
    "GUNSLINGER_WRAITHSTEP_DESCRIPTION": "Gunslinger sprintet eine kurze Distanz vorwärts. Speichert bis zu fünf Ladungen.",
    "GUNSLINGER_WRAITHFRENZY": "Gespensterrausch",
    "GUNSLINGER_WRAITHFRENZY_DESCRIPTION": "Gunslinger gerät in einen Rauschzustand und erhält 50% Bewegungsgeschwindigkeit und 20% Lebensraub. Hält 3 Sekunden an.",
    "GUNSLINGER_SOULPIERCER": "Seelendurchbohrer",
    "GUNSLINGER_SOULPIERCER_DESCRIPTION": "Gunslinger feuert eine Salve von Gespenstergeschossen ab, die 180% Schaden pro Schuss verursachen. Die Anzahl der Geschosse steigt mit dem Angriffstempo. Durchdringt Feinde. Verursacht Bonusschaden basierend auf der verlorenen Gesundheit des Feindes.",
    "GUNSLINGER_DEADEYE": "Scharfschütze",
    "GUNSLINGER_DEADEYE_DESCRIPTION": "Ziele präzise auf ein Ziel. Feuere bis zu 3 mächtige Kugeln ab, die beim Aufprall explodieren und in einem kleinen Bereich 300% Schaden verursachen. Getroffene Feinde werden verlangsamt. <style=cKeywordName>Schweben</style><style=cSub></style>",
    "GUNSLINGER_DEADEYE_KEYWORD": "<style=cKeywordName>Schweben</style><style=cSub> Gunslinger schwebt in der Luft und ist für die Dauer bewegungsunfähig. Feuert währenddessen 3 Kugeln in schneller Folge ab, die jeweils 200% Schaden verursachen.</style>",
    "GUNSLINGER_DEADEYE_PRIMARY": "Scharfschütze",
    "GUNSLINGER_DEADEYE_PRIMARY_DESCRIPTION": "Gunslinger schwebt in der Luft und zielt präzise auf ein Ziel. Feuere bis zu 3 mächtige Kugeln ab, die beim Aufprall explodieren und in einem kleinen Bereich 300% Schaden verursachen. Getroffene Feinde werden verlangsamt.",
    "GUNSLINGER_DESCRIPTION": "Der schnellste Doot im wilden Westen.<color=#CCD3E0></color>",
    "GUNSLINGER_OUTRO": "..und so ging er, Take Me Home singend.",
    "GUNSLINGER_FAIL": "..und so verschwand er, weit in die Weiten des Weltalls.",
    "GUNSLINGER_RING_ITEM_LORE": "Als letzter verbliebener Boshafter Ring erwarte ich eine stattliche Summe."
  }
