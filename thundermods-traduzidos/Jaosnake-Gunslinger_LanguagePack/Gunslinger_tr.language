    "GUNSLINGER_GAUNTLET_ITEM_DESC": "<style=cIsHealth>Tüm</style> canlıların <style=cIsDamage>%50'sini rastgele öldürür</style>. Her <style=cIsUtility>60 sn.</style> bir dolar.",
