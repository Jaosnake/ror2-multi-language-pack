    "GUNSLINGER_GAUNTLET_ITEM_NAME": "Manica Infinita",
    "GUNSLINGER_GAUNTLET_ITEM_DESC": "<style=cIsDamage>50%</style> <style=cIsHealth>omnium</style> animantium fortuite <style=cIsDamage>occidit</style>. Post <style=cIsUtility>60s</style> reficitur.",
    "GUNSLINGER_GAUNTLET_ITEM_PICKUP": "Dimidium omnis vitae fortuite dele.",
    "GUNSLINGER_GAUNTLET_ITEM_LORE": "\"Scio quid sit perdere. Tam desperanter te rectum esse sentire, tamen nihilominus deficere. Terribile est, crura tremere facit.\"",
    "GUNSLINGER_NAME": "Gunslinger",
    "GUNSLINGER_SUBTITLE": "Pacificator",
    "GUNSLINGER_PASSIVE_NAME": "Forma Umbralis",
    "GUNSLINGER_PASSIVE_DESCRIPTION": "Gunslinger robustior fit cum prope entia hostilia versatur.               <style=cKeywordName>Forma Umbralis</style><style=cSub></style>",
    "GUNSLINGER_VENDETTA": "Vendetta",
    "GUNSLINGER_VENDETTA_DESCRIPTION": "Gunslinger Vendetta emittit pro 280% damni per glandem, usque ad sex glandes gerit, post ultimam emissam reficit. Omnis sexta glans critice percutit pro 25% damni addito.",
    "GUNSLINGER_UNLOAD": "Efundere",
    "GUNSLINGER_UNLOAD_DESCRIPTION": "Vendetta emitte pro 200% damni. Pro quoque ictu prospero in hostem, damnum et fors critica Efundere augentur, usque ad +150% damni et 40% fortis criticae. Ictus omissi (caelum non computatur) acervos Efundere restituunt.",
    "GUNSLINGER_ACCURSEDARM": "Bracchium Maledictum",
    "GUNSLINGER_ACCURSEDARM_DESCRIPTION": "Gunslinger maledictionem potentem onerat quae 400% damni infert, hostes in linea transfigens. Hostes percussi debilitantur.",
    "GUNSLINGER_ORB": "Orbis Maledictus",
    "GUNSLINGER_ORB_DESCRIPTION": "Gunslinger sphaeram maledictam potentem emittit quae hostes propinquos concutit pro 10% damni et ad ictum in lato spatio displodit pro 320% damni. Hostes displosione percussi debilitantur.",
    "GUNSLINGER_WRAITHSTEP": "Passus Umbralis",
    "GUNSLINGER_WRAITHSTEP_DESCRIPTION": "Gunslinger ad breve spatium prorumpit. Usque ad quinque impetus servat.",
    "GUNSLINGER_WRAITHFRENZY": "Furor Umbralis",
    "GUNSLINGER_WRAITHFRENZY_DESCRIPTION": "Gunslinger in statum furoris init, 50% Celeritatis Motus et 20% Hauritionis Vitae accipiens. Durat 3 secundis.",
    "GUNSLINGER_SOULPIERCER": "Transfixor Animarum",
    "GUNSLINGER_SOULPIERCER_DESCRIPTION": "Gunslinger impetum glandium umbralium emittit, 180% damni per glandem inferens. Numerus glandium cum celeritate impetus augetur. Hostes transfigit. Damnum additum pro vita amissa hostis infert.",
    "GUNSLINGER_DEADEYE": "Oculus Intentus",
    "GUNSLINGER_DEADEYE_DESCRIPTION": "Scopus accurate intende. Usque ad 3 glandes potentes emitte quae ad ictum displodunt, 300% damni in parvo spatio inferentes. Hostes percussi tardantur. <style=cKeywordName>Volitare</style><style=cSub></style>",
    "GUNSLINGER_DEADEYE_KEYWORD": "<style=cKeywordName>Volitare</style><style=cSub> Gunslinger in aere volitat et per tempus immobilis manet. Dum in aere est, 3 glandes raptim emittit, 200% damni pro singula inferens.</style>",
    "GUNSLINGER_DEADEYE_PRIMARY": "Oculus Intentus",
    "GUNSLINGER_DEADEYE_PRIMARY_DESCRIPTION": "Gunslinger in aere volitat et scopum accurate intendit. Usque ad 3 glandes potentes emitte quae ad ictum displodunt, 300% damni in parvo spatio inferentes. Hostes percussi tardantur.",
    "GUNSLINGER_DESCRIPTION": "Celerrimus sclopetarius occidentalis.<color=#CCD3E0></color>",
    "GUNSLINGER_OUTRO": "..et ita discessit, canens Take Me Home.",
    "GUNSLINGER_FAIL": "..et ita evanuit, longe in spatium.",
    "GUNSLINGER_RING_ITEM_LORE": "Ut ultimus Anulus Nefarius qui superest, magnam summam pecuniae exspecto."
