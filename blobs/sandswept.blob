		private void ProcessJump(orig_ProcessJump_bool orig, GenericCharacterMain self, bool ignoreRequirements)
		{
			//IL_0065: Unknown result type (might be due to invalid IL or missing references)
			int buffCount = ((EntityState)self).characterBody.GetBuffCount(extraJump);
			if (self.jumpInputReceived && buffCount > 0 && Object.op_Implicit((Object)(object)((EntityState)self).characterMotor) && ((EntityState)self).characterMotor.jumpCount >= ((EntityState)self).characterBody.maxJumpCount && !ignoreRequirements)
			{
				if (((EntityState)self).isAuthority)
				{
					((EntityState)self).characterBody.SetBuffCountSynced(extraJump.buffIndex, buffCount - 1);
				}
				Util.PlaySound("Play_transistor_jump", ((EntityState)self).gameObject);
				ignoreRequirements = true;
			}
			orig.Invoke(self, ignoreRequirements);
		}

