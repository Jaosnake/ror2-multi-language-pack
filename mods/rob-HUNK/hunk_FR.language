    "ROB_HUNK_BODY_SHOOT_AR_NAME": "Tirer",
    "ROB_HUNK_BODY_SHOOT_AR_DESCRIPTION": "Tirez pour <style=cIsDamage>385% de dégâts</style>. <style=cIsUtility>50% de bonus de tir à la tête.</style>",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_NAME": "Tirer",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Tirez pour <style=cIsDamage>2x250% de dégâts</style>. <style=cIsUtility>Les dégâts évoluent avec la vitesse d'attaque.</style>",
    "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Visée Stable",
    "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Visez, <style=cIsUtility>exposant les points faibles des ennemis</style>. <style=cIsDamage>Utiliser la compétence principale en visant fait feu avec votre arme en main.</style>",
    "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Pas Rapide",
    "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Foncez</style> sur une courte distance. Si utilisé de manière préventive pour <style=cIsUtility>éviter une attaque</style>, effectuez une <style=cIsDamage>Esquive Parfaite</style>.",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Foncez</style> sur une courte distance. Si utilisé de manière préventive pour <style=cIsUtility>éviter une attaque</style>, effectuez une <style=cIsDamage>Esquive Parfaite</style>.\n<color=#d299ff>SCEPTER : La puissance d'Uroboros coule en vous.</color>",
    "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Parade",
    "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Bloquez</style> une attaque, <style=cIsDamage>annulant</style> les dégâts et <style=cIsUtility>remboursant le temps de recharge</style>. Si utilisé de manière préventive, effectuez une <style=cIsDamage>Parade Parfaite</style>.",
    "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Coup d'Épaule",
    "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Percutez</style> les ennemis proches, <style=cIsUtility>les étourdissant</style> pour <style=cIsDamage>400% de dégâts</style>. Si utilisé de manière préventive pour <style=cIsUtility>interrompre une attaque</style>, effectuez un <style=cIsDamage>Coup d'Épaule Parfait</style>.",
    "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Légion",
    "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Changez</style> pour une autre <style=cIsDamage>arme à feu</style>. Appuyez brièvement pour revenir à votre <style=cIsUtility>dernière arme tenue</style>.",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Couteau de Combat",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "Un couteau militaire standard. Toujours utile dans une situation critique.",
    "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "Couteau de Combat EX",
    "ROB_HUNK_BODY_KNIFE_INFINITE_DESCRIPTION": "Un couteau militaire traité spécialement et durci à un degré incroyable. On dit qu'il a été conçu pour vraiment durer.",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_NAME": "Lame Secrète",
