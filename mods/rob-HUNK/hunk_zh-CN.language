        "ROB_HUNK_WEAPON_ADDON3_MUP_NAME": "大容量弹匣（MUP）",
        "ROB_HUNK_WEAPON_ADDON3_MUP_DESC": "MUP 的定制配件，将弹匣容量扩充至 33 发并缩短换弹时间。",
        "ROB_HUNK_WEAPON_ADDON4_MUP_NAME": "枪口制退器（MUP）",
        "ROB_HUNK_WEAPON_ADDON4_MUP_DESC": "MUP 的定制配件，将其伤害提升至 600%。",
        "ROB_HUNK_WEAPON_SG09_NAME": "SG-09 R",
        "ROB_HUNK_WEAPON_SG09_DESC": "易于操控且弹匣容量较大的手枪。",
        "ROB_HUNK_WEAPON_ADDON_SG09_NAME": "大容量弹匣（SG-09 R）",
        "ROB_HUNK_WEAPON_ADDON_SG09_DESC": "SG-09 R 的定制配件，将弹匣容量扩充至 32 发。",
        "ROB_HUNK_WEAPON_ADDON2_SG09_NAME": "枪口制退器（SG-09 R）",
