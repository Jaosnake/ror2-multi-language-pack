    "ROB_HUNK_BODY_SHOOT_STREETSWEEPER_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_STREETSWEEPER_DESCRIPTION": "Dispara causando <style=cIsDamage>14x24% de daño</style>. <style=cIsUtility>25% de bonificación por disparo a la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_DESCRIPTION": "Dispara causando <style=cIsDamage>3000% de daño</style>. <style=cIsUtility>50% de bonificación por disparo a la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_SMG_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_SMG_DESCRIPTION": "Dispara causando <style=cIsDamage>110% de daño</style>. <style=cIsUtility>25% de bonificación por disparo a la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_AR_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_AR_DESCRIPTION": "Dispara causando <style=cIsDamage>385% de daño</style>. <style=cIsUtility>50% de bonificación por disparo a la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Dispara causando <style=cIsDamage>2x250% de daño</style>. <style=cIsUtility>El daño escala con la velocidad de ataque.</style>",
    "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Puntería Firme",
    "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Apunta para <style=cIsUtility>exponer los puntos débiles del enemigo</style>. <style=cIsDamage>Usar la habilidad primaria mientras apuntas dispara el arma que sostienes.</style>",
    "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Paso Rápido",
    "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Lánzate</style> una distancia corta. Si se usa de forma preventiva para <style=cIsUtility>esquivar un ataque</style>, realiza un <style=cIsDamage>Esquive Perfecto</style>.",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Lánzate</style> una distancia corta. Si se usa de forma preventiva para <style=cIsUtility>esquivar un ataque</style>, realiza un <style=cIsDamage>Esquive Perfecto</style>.\n<color=#d299ff>CETRO: El poder de Uroboros fluye a través de ti.</color>",
    "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Parada",
    "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Bloquea</style> un ataque, <style=cIsDamage>anulando</style> el daño y <style=cIsUtility>reembolsando el enfriamiento</style>. Si se usa de forma preventiva, realiza una <style=cIsDamage>Parada Perfecta</style>.",
    "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Embestida de Hombro",
    "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Embiste</style> a los enemigos cercanos, <style=cIsUtility>aturdiéndolos</style> por <style=cIsDamage>400% de daño</style>. Si se usa de forma preventiva para <style=cIsUtility>cancelar un ataque</style>, realiza una <style=cIsDamage>Embestida Perfecta</style>.",
    "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Legión",
    "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Cambia</style> a un <style=cIsDamage>arma</style> diferente. Toca para cambiar a tu <style=cIsUtility>última arma equipada</style>.",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Cuchillo de Combate",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "Un cuchillo militar estándar. Seguro que te sacará de más de un apuro.",
    "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "Cuchillo de Combate EX",
    "ROB_HUNK_BODY_KNIFE_INFINITE_DESCRIPTION": "Un cuchillo militar con tratamiento especial endurecido a un nivel increíble. Dicen que fue hecho para durar de verdad.",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_NAME": "Hoja Oculta",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_DESCRIPTION": "Una hoja retráctil discreta escondida en la manga. Ideal para operaciones de sigilo.",
