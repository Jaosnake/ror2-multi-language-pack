    "CI_PIPELINE_CANCEL_CONTEXT": "Cancelar Construção",
    "CI_RESOURCEWELL_CONTEXT": "Chamar Extrator",
    "CI_PIPELINEVEHICLE_EXIT": "Deslizar para fora",
