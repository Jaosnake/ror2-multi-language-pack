			EntityStateMachine.FindByCustomName(prefab, "Body").initialStateType = new SerializableEntityStateType(typeof(SpawnState));
			((Component)body).GetComponent<CharacterDeathBehavior>().deathState = new SerializableEntityStateType(typeof(JellyDeath));
		}

