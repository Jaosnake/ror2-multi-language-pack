        "JAVANGLE_HOUSE_COINS_DESCRIPTION": "<style=cArtifact>Втратьте 40% поточного золота</style> та <style=cIsDamage>завдайте 400% втраченого золота як шкоду</style> ворогам поблизу.",
        "JAVANGLE_HOUSE_TOWER_NAME": "Вежа",
