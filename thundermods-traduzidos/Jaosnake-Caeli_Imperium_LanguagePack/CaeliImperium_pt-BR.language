    "CI_BUILDER_COLLIDES_VALID": "Não",
    "CI_BUILDER_COLLIDES_INVALID": "Sim",
    "CI_BISHOP_SPEAR_THROW": "Arremessar",
    "CI_BISHOP_SPEAR_SLAM": "Impacto",
    "CI_BISHOP_SPEAR_CHAIN": "WIP",
    "CI_DIFFICULTY_HURTMEPLENTY_NAME": "Hurt Me Plenty",
    "CI_DIFFICULTY_HURTMEPLENTY_DESC": "É assim que o jogo deve ser jogado como Doomguy! Derrote o Chefe Final Principal como Doomguy para desbloquear esta dificuldade para todos os sobreviventes e desbloquear o restante das dificuldades para o Doomguy (no momento, este recurso ainda não foi implementado).<style=cStack>\n\nVelocidade de Projéteis dos Monstros: <style=cIsHealing>-35%</style>\nAltura de Voo dos Monstros: <style=cIsHealing>8m</style>\nElites: <style=cIsHealing>Removidos</style>\nRepulsão: <style=cIsDamage>Removida</style>\nDrones, Itens e Equipamentos: <style=cIsDamage>Reorganizados</style>. <style=cIsHealth>-75% de dano. Não podem atordoar, eletrocutar, imobilizar nem congelar</style>\nMonstros: <style=cIsHealth>Não miram em lacaios</style>\nVida de Monstros Pesados: <style=cIsHealth>+60%</style>\nVida de Monstros Chefes: <style=cIsHealth>+120%</style>\nImpressoras e Sucateadores: <style=cIsHealth>Removidos</style>\nItens do Vazio e Lunares: <style=cIsHealth>Removidos</style>\nMonstros Fracos: <style=cIsHealth>Removidos</style>\nAtordoamentos de Impacto: <style=cIsHealth>Removidos</style></style>",
    "CI_DOOMGUY_BODY_NAME": "Doomguy",
    "CI_DOOMGUY_BODY_SUBTITLE": "Cara condenado ou cara da perdição ou algo assim sei lá",
    "CI_DOOMGUY_NAME": "Doomguy",
    "CI_DOOMGUY_DESC": "Ele é o Doomguy!",
    "CI_DOOMGUY_SHOTGUN_NAME": "Escopeta de Combate",
    "CI_DOOMGUY_SHOTGUN_DESC": "Dispara balins que causam <style=cIsDamage>5x120% de dano</style>",
    "CI_DOOMGUY_SPEAR_NAME": "Golpe de Lança",
    "CI_DOOMGUY_SPEAR_DESC": "Balança a lança causando <style=cIsDamage>200% de dano</style>. <style=cIsUtility>Apara</style> ataques e projéteis <style=cIsHealing>aparáveis</style> recebidos. Ganha <style=cDeath>fortalecimento</style> e <style=cIsUtility>reduz o tempo de recarga</style> da sua habilidade Utilitária em um <style=cIsHealing>aparar bem-sucedido</style>",
    "CI_DOOMGUY_ACCELERATOR_NAME": "Acelerador de Plasma",
    "CI_DOOMGUY_ACCELERATOR_DESC": "Dispara projétil de plasma causando <style=cIsDamage>50% de dano</style>. O disparo contínuo sobrecarregará o acelerador e aumentará o dano do projétil de plasma para <style=cIsDamage>125% de dano</style>. Libera a sobrecarga ao soltar o gatilho e causa <style=cIsDamage>500% de dano</style>",
    "CI_DOOMGUY_DASH_NAME": "Investida",
    "CI_DOOMGUY_DASH_DESC": "<style=cIsUtility>Avança</style> na direção do movimento",
    "CI_DOOMGUY_SPEARSPECIAL_NAME": "Fortalecimento de Lança",
    "CI_DOOMGUY_SPEARSPECIAL_DESC": "Prepara a lança para <style=cDeath>fortalecimento</style>. Consome 5 de <style=cDeath>fortalecimento</style> ao usar.\n\nPrimária: Arremessa a lança causando <style=cIsDamage>2000% de dano</style>. Causa <style=cIsDamage>acerto crítico</style> e <style=cIsDamage>superatordoamento</style> em tiro na cabeça.\n\nSecundária: WIP\n\nUtilitária: Salta para baixo causando <style=cIsDamage>700% de dano</style> em um <style=cIsUtility>raio de 24 metros</style>",
    "CI_DOOMGUY_PUNCH_NAME": "Soco",
    "CI_DOOMGUY_PUNCH_DESC": "Soca o alvo causando <style=cIsDamage>800% de dano</style>. Se o alvo estiver <style=cDeath>cambaleando</style>, a carga não é consumida e cura em <style=cIsHealing>3.125%/12.5%/25%</style> da vida máxima e <style=cIsHealing>10%/25%/50%</style> de cura de reserva com base na classe do alvo, além de ganhar <style=cDeath>fortalecimento</style>"
  }
}
