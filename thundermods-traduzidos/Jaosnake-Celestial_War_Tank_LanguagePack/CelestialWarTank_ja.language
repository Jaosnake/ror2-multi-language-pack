    "CHEESEWITHHOLES_BASICTANK_TURRET_T62_NAME": "T62",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T62_DESCRIPTION": " <color=#80fc80>-20% セカンダリクールダウン</color>\n <color=#fc8080>-12% 攻撃速度</color>\n <color=#fc8080>+8% プライマリクールダウン</color>\n <color=#fc8080>+8% ユーティリティクールダウン</color>\n <color=#fc8080>+8% スペシャルクールダウン</color>\n\n<color=#00FF00>体力: </color>80\n<color=#FF0000>アーマー: </color>11\n\nRotation 速度: 38\n\n重量: 91\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_NAME": "Somua S35",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_DESCRIPTION": " <color=#80fc80>+15 クリティカル率</color>\n <color=#fc8080>-5% ダメージ</color>\n\n<color=#00FF00>体力: </color>30\n<color=#FF0000>アーマー: </color>8\n\nRotation 速度: 45\n\n重量: 33\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_NAME": "Churchill",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_DESCRIPTION": "<style=cIsUtility>5</style>秒ごとに<color=#fcdf03>+3コイン</color> <color=#7a7a7a>(レベルごとに+2)</color>\n\n<color=#00FF00>体力: </color>85\n<color=#FF0000>アーマー: </color>12\n\nRotation 速度: 34\n\n重量: 97\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_NAME": "Maus",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_DESCRIPTION": "\n<color=#00FF00>体力: </color>150\n<color=#FF0000>アーマー: </color>30\n\nRotation 速度: 30\n\n重量: 180\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_NAME": "Tetrarch",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>体力: </color>20\n<color=#FF0000>アーマー: </color>7\n\nRotation 速度: 50\n\n重量: 27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% 攻撃速度</color>\n <color=#fc8080>-15% 体力自然回復</color>\n <color=#fc8080>+5% 合計クールダウン</color>\n\n<color=#00FF00>体力: </color>20\n<color=#FF0000>アーマー: </color>2\n\nRotation 速度: 40\n\n重量: 20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>体力: </color>10\n<color=#FF0000>アーマー: </color>0\n\nRotation 速度: 55\n\n重量: 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>体力: </color>100\n<color=#FF0000>アーマー: </color>20\n\nRotation 速度: 33\n\n重量: 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% スペシャルクールダウン</color>\n <color=#fc8080>+15% セカンダリクールダウン</color>\n <color=#fc8080>-10% 攻撃速度</color>\n\n<color=#00FF00>体力: </color>120\n<color=#FF0000>アーマー: </color>23\n\nRotation 速度: 29\n\n重量: 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% ダメージ</color>\n <color=#fc8080>+10% 合計クールダウン</color>\n\n<color=#00FF00>体力: </color>160\n<color=#FF0000>アーマー: </color>0\n\nRotation 速度: 25\n角度制限: 90\n\n重量: 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>体力: </color>45\n<color=#FF0000>アーマー: </color>4\n\nRotation 速度: 25\n\n重量: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>体力: </color>35\n<color=#FF0000>アーマー: </color>15\n\nRotation 速度: 35\n\n重量: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% プライマリクールダウン</color>\n <color=#fc8080>+8% セカンダリクールダウン</color>\n <color=#fc8080>+8% ユーティリティクールダウン</color>\n <color=#fc8080>+8% スペシャルクールダウン</color>\n <color=#fc8080>-15% 攻撃速度</color>\n\n<color=#00FF00>体力: </color>35\n<color=#FF0000>アーマー: </color>3\n\nRotation 速度: 30\n\n重量: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% ダメージ</color>\n\n<color=#00FF00>体力: </color>5\n<color=#FF0000>アーマー: </color>1\n\nRotation 速度: 40\n角度制限: 30\n\n重量: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "オリジナル",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "レッド",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "ライトレッド",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "グリーン",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "ダークグリーン",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "ブルー",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "シアン",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "ピンク",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "ホットピンク",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "マゼンタ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "イエロー",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "ネオンイエロー",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "ネオンパープル",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "オレンジ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "ホワイト",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "ブラック",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "車両の「発光」部分を別の色に変更します。ゲームプレイには影響しません。",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "汚れ",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "クリーン",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "ギザギザ迷彩",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "ピクセル迷彩",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "ペーパー迷彩",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "縞鋼板",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "ボルト留め装甲板",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "プロシージャルセット",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "カラフルブレンド",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "グラデーションレインボー",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "モノクローム",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "フルイドギャラクシー",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "スペース",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "エンジンシステム",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "ユーティリティと推進は燃料を消費する。燃料の補充速度は<style=cIsUtility>攻撃速度</style>の影響を受け、燃料容量は<style=cIsUtility>アフターバーナー</style>や<style=cIsUtility>ジャンプ系アイテム</style>の影響を受ける。戦車は<style=cIsUtility>あらゆる方向にスプリント可能</style>。 推進により空中での自在な制御が可能になる。ただし、<color=#fc8080>戦車は通常のジャンプができない</color>。",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "スーパーアーマリー",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "車体と砲塔の選択は、体力、アーマー、速度、推進力、質量に影響する。<style=cIsUtility>質量が重いほど大型の敵を押し返しやすくなる</style>が、軽いと<color=#ffff80>ノックバック</color>を受けやすくなる。\n\nアーマーや速度を高めることで、戦車の<color=#fc8080>極端に低い体力自然回復</color>を補うことができる。",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "天界の不安定性",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "戦車は空中で体勢を自動制御できず、<color=#ffff80>コントロールを失いやすい</color>。逆さまに着地すると、<color=#fc8080>短時間行動不能になり無防備になる</color>。",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "フライトスラスター",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "<style=cIsUtility>ジャンプ</style>長押しで飛行を開始する。飛行方向は戦車の角度に依存する。<style=cIsUtility>最も自由度の高い飛行方式</style>だが、操作は難しいかもしれない。",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "パルススラスター",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "他のサバイバーと同様に戦車が通常の<style=cIsUtility>ジャンプ</style>を行えるようになる。2段目のジャンプで戦車の傾き制御が有効になる。各ジャンプは燃料を<color=#ffc080>25</color>消費する。",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "ホバースラスター",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "戦車が地面からホバリングできるようになる。<style=cIsUtility>ジャンプ</style>長押しで上昇し、<style=cIsUtility>LeftAlt</style>長押しで下降する。上昇時はより多くの燃料を消費する。",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "マシンガン",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "連続射撃を行い、<style=cIsDamage>2x40%のダメージ</style>を与える。\n<style=cSub>[重量: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "ショットガン",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "発射して<style=cIsDamage>12x75%のダメージ</style>を与える。<color=#ffc080>燃料を消費</color>して<style=cIsUtility>追加ストックを獲得</style>できる。<color=#80fc80>スタント着地を決める</color>と、一時的に<style=cIsDamage>18x150%のダメージ</style>を与えるパワーショットを得る。\n<style=cSub>[<style=cIsUtility>クールダウン: 1秒</style> | 重量: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "グレネードランチャー",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "精度の低い榴弾を発射し、<style=cIsDamage>4x250%のダメージ</style>を与える。榴弾は爆発性を持ち、重量がある。\n<style=cSub>[<style=cIsUtility>クールダウン: 4秒</style> | <style=cIsDamage>爆発半径: 5m</style> | 重量: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "ミサイルランチャー",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "高精度のミサイルを発射し、<style=cIsDamage>1000%のダメージ</style>を与える。<style=cIsDamage>飛距離に応じてダメージが増加する</style>。\n<style=cSub>[<style=cIsUtility>クールダウン: 3秒</style> | <style=cIsDamage>爆発半径: 8m</style> | 重量: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "火炎放射器",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "<color=#ffc080>毎秒15の燃料</color>を消費して火炎を放射し、<color=#E85E31>25%の炎上ダメージ</color>を与える。スタック数に応じてダメージが増加し、<style=cIsUtility>攻撃速度によって射程が延びる</style>。\n<style=cSub>[<color=#ffc080>燃料駆動</color> | 重量: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "ウルトラアンテナ",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>自身を感電</color>させ、<style=cIsUtility>キル時発動アイテムを起動する</style>。<style=cIsUtility>接触した敵も感電させ</style>、<style=cIsUtility>キル時発動</style>アイテム1つにつき<style=cIsDamage>250%のダメージ</style>を与える。\n<style=cSub>[<style=cIsUtility>クールダウン: 7秒</style> | <style=cIsDamage>爆発半径: 5m</style> | 重量: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "クリティカル・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "発射して<color=#ff4d76>1200%のクリティカルダメージ</color>を与える。クリティカル率によって砲撃のダメージが増加する。\n<style=cSub>[<style=cIsUtility>クールダウン: 7秒</style> | <style=cIsDamage>爆発半径: 10m</style> | 重量: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "榴弾砲",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "チャージして発射し、広範囲に<style=cIsDamage>7000%のダメージ</style>を与える。<style=cIsUtility>空中で撃つと戦車自身を吹き飛ばすことができる。</style>\n<style=cSub>[<style=cIsUtility>クールダウン: 16秒</style> | <style=cIsDamage>爆発半径: 15m</style> | 重量: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "ノッカー・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "精度の低い砲撃を行い、<style=cIsDamage>1700%のダメージ</style>を与える。<style=cIsDamage>飛距離に応じてダメージが減衰する</style>が、<style=cIsDamage>発動系アイテムによってダメージが増加する</style>。\n<style=cSub>[<style=cIsUtility>クールダウン: 3秒</style> | <style=cIsDamage>爆発半径: 5m</style> | 重量: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "ピアシング・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "発射して<style=cIsDamage>2500%のダメージ</style>を与える。長押しで照準を調整すると<style=cIsDamage>3500%のダメージ</style>を与え、<style=cIsUtility>弱点を狙撃可能</style>になる。照準調整中は<color=#fc8080>移動すると精度が低下する</color>。\n<style=cSub>[<style=cIsUtility>クールダウン: 5秒</style> | <style=cIsDamage>爆発半径: 2m</style> | 重量: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "フレンチ・ガン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "発射してわずか<style=cIsDamage>550%のダメージ</style>を与える。どういうわけか、<style=cIsUtility>異常に高い発動係数を持つ</style>。\n<style=cSub>[<style=cIsUtility>クールダウン: 1秒</style> | 重量: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "ミニガン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "乱射して<style=cIsDamage>50%のダメージ</style>を与える。オーバーヒートが75%に達すると<color=#E85E31>炎上</color>を付与し、<color=#fc8080>完全にオーバーヒートすると銃がロックされる</color>。<style=cIsUtility>クールダウン系アイテムで冷却速度が上がり</style>、<style=cIsUtility>バックアップマガジンでオーバーヒートを抑制できる</style>。\n<style=cSub>[重量: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "ベーシック・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "高速の砲弾を発射し、<style=cIsDamage>5400%のダメージ</style>を与える。\n<style=cSub>[<style=cIsUtility>クールダウン: 12秒</style> | <style=cIsDamage>爆発半径: 7m</style> | 重量: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "対空機関砲",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "発射して<style=cIsDamage>300%のダメージ</style>を与える。砲弾は空中の標的の近くで起爆し、<style=cIsDamage>2.5xのダメージ</style>を与える。<color=#fc8080>射撃中は戦車の速度が低下する</color>。\n<style=cSub>[<style=cIsDamage>爆発半径: 5.5m</style> | 重量: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "スプラッシュ・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "<style=cIsUtility>大きな弧</style>を描いて発射し、<style=cIsDamage>2200%のダメージ</style>を与え、さらに周囲へ<style=cIsDamage>合計ダメージの10x5%</style>を撒き散らす。飛距離が長いほどダメージが増加し、最大で<style=cIsDamage>5500%のダメージ</style>に達する。\n<style=cSub>[<style=cIsUtility>クールダウン: 10秒</style> | <style=cIsDamage>爆発半径: 16m</style> | 重量: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "セレスティアル・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "<color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> の燃料を消費し、<color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> の<color=#E85E31>ダメージ</color>を与える。チャージされたレーザーは敵を貫通する。<color=#fc8080>燃料が不足すると兵器が停止する。</color>\n<style=cSub>[<color=#ffc080>燃料駆動</color> | 重量: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "オブリタレイター・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "チャージして<color=#E85E31>キル時効果を発動する砲弾</color>を自動発射し、<style=cIsDamage>12000%のダメージ</style>を与える。発射後、<color=#fc8080>4秒間すべてのスキルが使用不能になる。砲弾は味方にも被害を与える可能性がある</color>。\n<style=cSub>[<style=cIsUtility>クールダウン: 21秒</style> | <style=cIsDamage>爆発半径: 5m</style> | 重量: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "オート・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "それぞれ<style=cIsDamage>2000%のダメージ</style>を与える砲弾を最大4発発射する。最後の砲弾は固定地点に<style=cIsDamage>2xのダメージ</style>を与える。\n<style=cSub>[<style=cIsUtility>クールダウン: 14秒</style> | <style=cIsDamage>爆発半径: 7m</style> | 重量: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "プラウ",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "燃料を<color=#ffc080>50</color>消費して<style=cIsUtility>短距離ダッシュ</style>する。<style=cIsUtility>あらゆる敵</style>をノックバックして<style=cIsDamage>1000%のダメージ</style>を与え、燃料を<color=#ffc080>40</color>補充できる。\n<style=cSub>[<style=cIsUtility>クールダウン: 2秒</style> | 重量: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "スパイク",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "燃料を<color=#ffc080>50</color>消費して<style=cIsUtility>長距離ダッシュ</style>する。敵に体当たりして<color=#AA2B2A>550%の出血ダメージ</color>を与える。<style=cIsUtility>クールダウンなし</style>。\n<style=cSub>[重量: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "ターボ",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "毎秒<color=#ffc080>30</color>の燃料を消費して<style=cIsUtility>急加速</style>する。体当たりで<style=cIsDamage>250%のダメージ</style>を与え、体当たりが命中すると燃料が<color=#ffc080>20</color>回復する。\n<style=cSub>[<style=cIsUtility>クールダウン: 1秒</style> | 重量: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "スーパージャンプ",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "燃料を<color=#ffc080>50</color>消費して上空へ飛び上がる。スプリント中は代わりに燃料を<color=#ffc080>75</color>消費して前方へ飛び出し、戦車を激しく回転させて<style=cIsDamage>2500%のダメージ</style>を与える。戦車の重量によってダメージが増加する。",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "ブルドーザー",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "毎秒<color=#ffc080>20</color>の燃料を消費して<style=cIsUtility>ブースト</style>する。<style=cIsUtility>あらゆる敵</style>を押し退けて継続的に<style=cIsDamage>200%のダメージ</style>を与え、衝突時に<style=cIsDamage>350%のダメージ</style>を与える。\n<style=cSub>[<style=cIsUtility>クールダウン: 1秒</style> | 重量: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "チャージして燃料を<color=#ffc080>100</color>消費し、<style=cIsUtility>最長距離をダッシュ</style>する。<style=cIsUtility>敵の群れを貫通</style>して<color=#AA2B2A>4000%の出血ダメージ</color>を与え、<style=cIsUtility>ダッシュ時間を延長する</style>。旋回するとダッシュを終了する。<color=#80fc80>スタント着地を決める</color>と<style=cIsUtility>チャージをスキップできる</style>。\n<style=cSub>[<style=cIsUtility>クールダウン: 7秒</style> | 重量: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "トレンチャー",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>長押しで地中に潜り</style>、毎秒<color=#ffc080>20</color>の燃料を消費して<style=cIsUtility>地中にある間戦車を保護する</style>。ボタンを離すと地上へ飛び出し、周囲の敵に<style=cIsDamage>900%のダメージ</style>を与える。地中では攻撃できない。\n<style=cSub>[<style=cIsDamage>爆発半径: 10m</style> | 重量: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "キング・マイン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "<style=cIsDamage>3000%のダメージ</style>を与える地雷を設置する。<style=cIsDamage>発動系アイテムによってダメージが増加する</style>。\n<style=cSub>[<style=cIsUtility>クールダウン: 10秒</style> | <style=cIsDamage>爆発半径: 10m</style> | 重量: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "ミニ・マイン",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "狙いを定めてすべての小型地雷を射出し、それぞれ<style=cIsDamage>750%のダメージ</style>を与える。ストック系およびインタラクト発動系アイテムによって最大地雷数が増加する。<color=#ffc080>燃料を消費</color>して<style=cIsUtility>追加ストックを獲得</style>できる。\n<style=cSub>[<style=cIsUtility>クールダウン: 3秒</style> | <style=cIsDamage>爆発半径: 10m</style> | 重量: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "バレル・ランチ",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "燃料を<color=#ffc080>25</color>消費してドラム缶を発射する。衝突時に爆発して<style=cIsDamage>6500%のダメージ</style>を与え、<color=#E85E31>炎の水たまり</color>を残す。<color=#80fc80>スタント着地を決める</color>とこのスキルが一時的に<color=#fc8080>不安定</color>になり、<style=cIsUtility>戦車自身を激しく吹き飛ばす</style>。\n<style=cSub>[<style=cIsUtility>クールダウン: 14秒</style> | <style=cIsDamage>爆発半径: 18m</style> | <style=cIsDamage>ゾーン半径: 8</style> | 重量: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "自爆",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "35m以内の<color=#d40000>すべて</color>を殲滅し、<style=cIsDamage>100000%のダメージ</style>を与える。新しいランの開始時に<color=#80fc80>Dio's Best Friend</color>を所持した状態でスタートする。\n<style=cSub>[<style=cIsDamage>爆発半径: 35m</style> | 重量: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "レイン・オブ・ミサイル",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "減速してチャージし、ミサイルの弾幕を発射する。飛距離が長いほどダメージが増加し、最大で<style=cIsDamage>12x3000%のダメージ</style>に達する。\n<style=cSub>[<style=cIsUtility>クールダウン: 30秒</style> | <style=cIsDamage>爆発半径: 10m</style> | 重量: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "イヴェイド",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "煙幕を展開し、周囲の敵をスタンさせて<style=cIsDamage>150%のダメージ</style>を与え、姿を隠す。1秒間ダメージに対して<style=cIsUtility>無敵になる</style>。\n<style=cSub>[<style=cIsUtility>クールダウン: 12秒</style> | <style=cIsDamage>爆発半径: 10m</style> | 重量: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "パッシブ: バーサーク",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "このスキルを除外する。<style=cIsDamage>基本攻撃速度が0.5増加</style>し、<style=cIsUtility>クールダウンが10%短縮</style>される。",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "パッシブ: エンジン",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "このスキルを除外する。<style=cIsUtility>基本速度が1m/s増加</style>し、<style=cIsUtility>推進力が10%増加</style>する。",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "パッシブ: アーマー",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "このスキルを除外する。<style=cIsUtility>基本アーマーが30増加</style>する。",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: マスタリー",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Celestial War Tankで、Monsoon難易度のゲームをクリアするか、存在を抹消する。",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: マスタリー",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: セレスティアル・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Celestial War Tankで、家に帰る",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: セレスティアル・キャノン",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: オブリタレイター",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Celestial War Tankで、一撃で1,000,000以上のダメージを与える。",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: オブリタレイター",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Celestial War Tankで、Monsoon難易度のゲームをクリアするか、存在を抹消する。",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: 重装甲",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Celestial War Tankで、HPを10000獲得する。",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: 重装甲",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "究極の破壊戦車。あらゆる種類の敵に耐え抜き、その圧倒的な重量と兵器で敵を轢き潰せ！\n\n<style=cSub>< ! > この戦車は巨大で非常に鈍重なため、あらゆる攻撃の的になりやすい。極端に防御的、あるいは極端に攻撃的に立ち回ることで被ダメージを抑えられる。なお、この戦車には自然回復がないことに注意しよう。\n\n< ! > 戦車の車体そのものを武器として使える――敵を轢き倒すか、巨体で押し潰してしまおう！\n\n< ! > 戦車が転倒すると、重いため起き上がるのに時間がかかり、落下ダメージもより多く受けてしまう。また、スタントは行えない。\n\n< ! > 回復効果は軽減される――戦車の体力が多すぎるためだ！\n\n< ! > 「T」キーでクラクションを鳴らす。Mod設定で変更可能。\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "異界の存在",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "さらなる調査の結果、これらの戦車の起源が判明した――スカベンジャーたちの手によるものだ。良質なスクラップパーツとUESから回収したアイテムを組み合わせ、彼らはこの戦争兵器を見事に作り上げたのだ。\n\nしかし、これは危険な結論へと繋がる。敵のアンテナを1つ入手した後、私たちはこの怪物じみたサイズの戦車を呼び寄せてしまった。なんとビートルガードと同じくらいの大きさがあるのだ！\n\nもちろん、長い激戦の末にようやくこれを撃破した。より明確な答えを得るため、さらなる調査を行い、その人工知能を書き換えたいと考えている。もっとも、正真正銘の異星技術であるため、容易な作業ではないだろう。\n\n特筆すべき重大な事実として、撃破された際にこの戦車は緊急ポータルを召喚した。私たちがこれまで目にした中で最大かつ最も激しいポータルだ。答えに直結する手がかりになるかもしれないが、決して楽な道のりにはならないだろう。通常の戦車ですらあれほど危険なのだ、スカベンジャーが作り出した他の発明品がどれほど恐ろしいものか想像もつかない。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "オリジナル",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "ホワイト",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "ブラック",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "レッド",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "ダークレッド",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "グリーン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "ブルー",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "シアン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "イエロー",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "ネオンイエロー",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "マゼンタ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "パープル",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "オレンジ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "ブラウン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "アメリカ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "ドイツ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "イギリス",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "ロシア",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "フランス",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "車体の色を変更します。ゲームプレイには影響しません。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "メイン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "ダーティイエロー",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "グリーン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "ダーティグリーン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "ブルー",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "ダーティブルー",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "レッド",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "ダーティレッド",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "マスタリー",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Rogue 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>エンジン出力: </color>3000\n<color=#00FFFF>速度: </color>10\nTraverse 速度: 0.8\n\n<color=#00FF00>体力: </color>1000\n<color=#FF0000>アーマー: </color>75\n\n<color=#AA00FF>推進力: </color>35\n<color=#ffc080>燃料量: </color>500\n重量: 1000\n\n車体タイプ: 戦車",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Griffon 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>砲塔対応</color>。\n\n<color=#FFFF00>エンジン出力: </color>2300\n<color=#00FFFF>速度: </color>11\nTraverse 速度: 1\n\n<color=#00FF00>体力: </color>800\n<color=#FF0000>アーマー: </color>25\n\n<color=#AA00FF>推進力: </color>40\n<color=#ffc080>燃料量: </color>500\n重量: 800\n\n車体タイプ: 車両",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "TONK 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>エンジン出力: </color>1200\n<color=#00FFFF>速度: </color>12\nTraverse 速度: 2\n\n<color=#00FF00>体力: </color>500\n<color=#FF0000>アーマー: </color>25\n\n<color=#AA00FF>推進力: </color>40\n<color=#ffc080>燃料量: </color>300\n重量: 450\n\n車体タイプ: 戦車",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Type 5 Heavy 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>エンジン出力: </color>3500\n<color=#00FFFF>速度: </color>8\nTraverse 速度: 0.6\n\n<color=#00FF00>体力: </color>1400\n<color=#FF0000>アーマー: </color>100\n\n<color=#AA00FF>推進力: </color>34\n<color=#ffc080>燃料量: </color>750\n重量: 1250\n\n車体タイプ: 戦車",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Bigfoot 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "<style=cIsUtility>空中制御</style>が向上する。\n\n\n<color=#FFFF00>エンジン出力: </color>2000\n<color=#00FFFF>速度: </color>13\nTraverse 速度: 1.4\n\n<color=#00FF00>体力: </color>600\n<color=#FF0000>アーマー: </color>20\n\n<color=#AA00FF>推進力: </color>40\n<color=#ffc080>燃料量: </color>450\n重量: 750\n\n車体タイプ: 車両",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "AMX50B 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>速度が重量の影響を受けない</style>。\n\n<color=#FFFF00>エンジン出力: </color>700\n<color=#00FFFF>速度: </color>9\nTraverse 速度: 0.7\n\n<color=#00FF00>体力: </color>900\n<color=#FF0000>アーマー: </color>50\n\n<color=#AA00FF>推進力: </color>35\n<color=#ffc080>燃料量: </color>370\n重量: 1100\n\n車体タイプ: 戦車",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "TOG II 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>エンジン出力: </color>3700\n<color=#00FFFF>速度: </color>8\nTraverse 速度: 0.5\n\n<color=#00FF00>体力: </color>1150\n<color=#FF0000>アーマー: </color>60\n\n<color=#AA00FF>推進力: </color>34\n<color=#ffc080>燃料量: </color>1000\n重量: 1200\n\n車体タイプ: 戦車",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Pigeon 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>砲塔対応</color>。\n\n<color=#FFFF00>エンジン出力: </color>1500\n<color=#00FFFF>速度: </color>7\nTraverse 速度: 1.4\n\n<color=#00FF00>体力: </color>150\n<color=#FF0000>アーマー: </color>5\n\n<color=#AA00FF>推進力: </color>40\n<color=#ffc080>燃料量: </color>300\n重量: 100\n\n車体タイプ: 車両",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Pontera AC 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>壁を登ることができる</style>。ジャンプが1秒遅延し、<color=#fc8080>体当たりダメージが50%減少する</color>。\n\n\n<color=#FFFF00>エンジン出力: </color>2750\n<color=#00FFFF>速度: </color>9\nTraverse 速度: 0.8\n\n<color=#00FF00>体力: </color>1300\n<color=#FF0000>アーマー: </color>90\n\n<color=#AA00FF>推進力: </color>31\n<color=#ffc080>燃料量: </color>550\n重量: 1300\n\n車体タイプ: メカ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "TANKDOZER 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "プラウがすべての<style=cIsDamage>被ダメージ</style>を<style=cIsUtility>ブロック</style>する。\n\n駆逐戦車モード: <color=#fc8080>砲塔を搭載できない</color>。\n\n<color=#FFFF00>エンジン出力: </color>2500\n<color=#00FFFF>速度: </color>8.5\nTraverse 速度: 0.9\n\n<color=#00FF00>体力: </color>1250\n<color=#FF0000>アーマー: </color>80\n\n<color=#AA00FF>推進力: </color>34\n<color=#ffc080>燃料量: </color>500\n重量: 1200\n\n車体タイプ: 戦車",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Truck Kan 車体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "体当たりダメージが <color=#80fc80>100.0%</color> 増加する\n\n<color=#80fc80>砲塔対応</color>。\n<style=cIsUtility>速度が重量の影響を受けない</style>。\n\n<color=#FFFF00>エンジン出力: </color>1000\n<color=#00FFFF>速度: </color>12\nTraverse 速度: 0.9\n\n<color=#00FF00>体力: </color>450\n<color=#FF0000>アーマー: </color>15\n\n<color=#AA00FF>推進力: </color>40\n<color=#ffc080>燃料量: </color>600\n重量: 600\n\n車体タイプ: 車両",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>体力: </color>250\n<color=#FF0000>アーマー: </color>25\n\nRotation 速度: 7.5\n\n重量: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "砲塔",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>体力: </color>100\n<color=#FF0000>アーマー: </color>10\n\nRotation 速度: 20\n\n重量: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>体力: </color>100\n<color=#FF0000>アーマー: </color>15\n\nRotation 速度: 15\n\n重量: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>体力: </color>400\n<color=#FF0000>アーマー: </color>50\n\nRotation 速度: 5\n\n重量: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200%ダメージ</style>？この特定の砲塔のダメージを増加させるコードが見つかりませんでした。\n- 開発者\n\n\n<color=#00FF00>体力: </color>150\n<color=#FF0000>アーマー: </color>25\n\nRotation 速度: 13\n角度制限: 60\n\n重量: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "<style=cIsUtility>セカンダリ</style>スキルに<style=cIsDamage>5チャージ</style>を追加する。\nクールダウン後に<style=cIsUtility>全チャージを補充</style>する。\n砲撃ダメージが80%減少する\n\n<color=#00FF00>体力: </color>300\n<color=#FF0000>アーマー: </color>20\n\nRotation 速度: 7\n\n重量: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>体力: </color>200\n<color=#FF0000>アーマー: </color>30\n\nRotation 速度: 9\n\n重量: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>体力: </color>300\n<color=#FF0000>アーマー: </color>35\n\nRotation 速度: 7\n\n重量: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "ヘビーウェイト",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "戦車は<style=cIsUtility>敵を轢き倒す</style>ことができ、<style=cIsDamage>速度に応じたダメージ</style>を与える。重い構成で落下すると、その重量によって<style=cIsUtility>衝撃波</style>が発生し、周囲の敵にダメージを与える。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "なし",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "このスキルを除外する。以下のステータスが増加する:\n\n攻撃速度: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "なし",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "なし",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "このスキルを除外する。以下のステータスが増加する:\n\n速度: <color=#80fc80>+1</color> m/s\nスラスター出力: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "なし",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "このスキルを除外する。アーマーが <color=#80fc80>30</color> 増加し、燃料容量が <color=#80fc80>200</color> 増加する",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "ミニキャノン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "精度の低い射撃を行い、<style=cIsDamage>200%のダメージ</style>を与える。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "EMP",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "シールドを燃焼させてEMPを発生させ、敵を感電させて<style=cIsDamage>2000%のダメージ</style>を与える！",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "最大22発もの大量のミサイルを保持する！1発につき<style=cIsDamage>1100%のダメージ</style>から最大<style=cIsDamage>1800%のダメージ</style>を与える。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "ラピッド・オートキャノン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "敵に炸裂弾を発射し、<style=cIsDamage>500%のダメージ</style>を与える。4秒ごとにリロードが必要。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "マイティ・キャノン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "発射して<style=cIsDamage>7500%のダメージ</style>を与え、敵を吹き飛ばす。\n<style=cSub>[<style=cIsUtility>クールダウン: 16秒</style> | <style=cIsDamage>爆発半径: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "アーティラリー・キャノン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>長押しで狙いを定め</style>、離すと強力な砲弾を発射して<style=cIsDamage>7000%のダメージ</style>を与える。飛距離が長いほどダメージが増加し、最大<style=cIsDamage>14000%のダメージ</style>に達する。\n<style=cSub>[<style=cIsUtility>クールダウン: 16秒</style> | <style=cIsDamage>爆発半径: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "クライオ・キャノン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "巨大な雪玉を発射して<color=#75EAFF>1500%のダメージ</color>を与え、敵を凍結させる。\n<style=cSub>[<style=cIsUtility>クールダウン: 5秒</style> | <style=cIsDamage>爆発半径: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "デュオ・キャノン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "発射して<style=cIsDamage>5400%のダメージ</style>を与える。長押しで2発発射できるが、その後の<color=#fc8080>スキルクールダウンが増加する</color>。2連射を行うと、2秒間だけ次のチャージ時間が<color=#80fc80>大幅に短縮される</color>。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "ブリティッシュ・キャノン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "発射して<style=cIsDamage>2400%のダメージ</style>を与える。<color=#fc8080>アイテム効果を発動できない</color>。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "ビッグ・バッド・キャノン",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "発射して<style=cIsDamage>2000%のダメージ</style>を与える。<style=cIsUtility>長押しでチャージ</style>し、最大<style=cIsDamage>11000%のダメージ</style>を与える。最大チャージで自動発射され、追加の<style=cIsDamage>5500%レーザーダメージ</style>と<style=cIsUtility>追加ノックバック</style>を発生させる。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Oppenheimerの実験兵器",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "砲弾で自身のシールドを破壊し、<color=#ff4d76>9000%のクリティカルダメージ</color>ですべてを殲滅する！",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "ジェット",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "点火して毎秒<color=#ffc080>70の燃料</color>を消費し、時間の経過とともに戦車をどんどん加速させる。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "パワーサイクル",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "発動すると、回避・攻撃・防御の3つのモードを切り替える:\n\n<style=cIsUtility>回避</style>: 攻撃速度が50%低下しクールダウンが50%増加する代わりに、速度+50%、推進力+10%、エンジン出力+50%を獲得する！\n\n<color=#80fc80>防御</color>: 速度70%と推進力100%を犠牲にして、アーマーを500獲得する。\n\n<style=cIsDamage>攻撃</style>: すべての武器が2倍のダメージを与える。クールダウンが33%短縮され攻撃速度が33%増加するが、すべてのアーマーと回復を失う。このモードを発動すると2秒間戦車が感電する。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "オーバークロック",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "自身の速度でシールドを破壊し、スラスターを激しく爆発させて<style=cIsDamage>6000%のダメージ</style>を与えながら空高く飛び上がり、<style=cIsUtility>落下ダメージを無効化する</style>！",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "シールド",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "発動すると4秒間<style=cIsUtility>外部からのダメージを無効化する</style>。シールドを犠牲にして1回限りの<color=#03fcc2>パワーアビリティ</color>を発動できる。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "ブラスティキュラー",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "4門の砲を発射し、それぞれ広範囲に<style=cIsDamage>1400%のダメージ</style>を与える。この武器はリロードの代わりに<color=#fc8080>オーバーヒート</color>する。\n<style=cSub>[<style=cIsDamage>爆発半径: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "スタンダード",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "標準的な操作感。\n\n選択した進行方向に基づいて戦車が移動・旋回する。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "オルタナティブ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "戦車の操作方法を変更する。\n\n戦車は車体の向きに基づいて移動するが、<color=#fc8080>進行方向へ自動旋回しなくなる</color>。<style=cIsUtility>手動で旋回</style>して操作する。\n\n飛行中は操作がスタンダードに戻る。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "パワーモード: <style=cIsUtility>回避</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "攻撃速度が50%低下しクールダウンが50%増加する代わりに、速度+50%、推進力+10%、エンジン出力+50%を獲得する。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "パワーモード: <color=#80fc80>防御</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "速度70%と推進力100%を犠牲にして、アーマーを500獲得する。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "パワーモード: <style=cIsDamage>攻撃</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "すべての武器が2倍のダメージを与える。クールダウンが33%短縮され攻撃速度が33%増加するが、すべてのアーマーと回復を失う。このモードを発動すると2秒間戦車が感電する。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "Dedeeはついに自由を手に入れたかと思われたが、\r\nまたしてもUESに捕らえられてしまった。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "砲塔なし",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "砲塔を取り外す。<style=cIsDamage>すべてのダメージが30%増加する</style>"
  }
}