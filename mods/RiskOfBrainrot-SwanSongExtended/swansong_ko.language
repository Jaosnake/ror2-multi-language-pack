{
  "ko": {
    "FRUITSKILLVOIDLASERTURBINESKILL": "천공 관통기",
    "FRUITSKILLVOIDLASERTURBINESKILL_DESCRIPTION": "<style=cIsVoid>파괴적인 레이저 광선</style>을 발사하여 모든 적과 지형을 관통하고 <style=cIsDamage>3200%의 피해</style>를 입힙니다.",
    "SCAVAMUSED_NAME": "즐거워하는 아파아파",
    "SCAVUNSTOPPABLE_NAME": "불굴의 보보",
    "SCAVGOOBO_NAME": "교활한 칩칩",
    "SCAVENLIGHTENED_NAME": "깨달은 바바",
    "ITEM_AGLET_NAME": "애글릿",
    "ITEM_AGLET_PICKUP": "지상에 있는 동안 이동 속도가 증가합니다.",
    "ITEM_AGLET_DESCRIPTION": "지상에 있는 동안 이동 속도가 점차 증가하여, 5초 후 최대 30%(중첩당 +30%)까지 증가합니다.",
    "ITEM_BORBOBAKEDBEANS_NAME": "비극의 콩",
    "ITEM_BORBOBAKEDBEANS_PICKUP": "처치 시 즉시 체력을 회복합니다. 연속 처치 시 회복량이 증가합니다.",
    "ITEM_BORBOBAKEDBEANS_DESCRIPTION": "적 처치 시 <style=cIsHealing>체력을 8 회복</style><style=cStack>(중첩당 +4)</style>합니다. 또한 이 회복량을 <style=cIsHealing>버프당 12</style><style=cStack>(중첩당 +6)</style> 증가시키는 <style=cIsUtility>일시적 버프</style>를 획득하며, 최대 <style=cIsUtility>4회</style>까지 중첩됩니다.",
    "ITEM_BORBOBAKEDBEANS_LORE": "안에는 아무것도 없다.",
    "ITEM_CHEFITEM_NAME": "요리사의 콧수염",
    "ITEM_CHEFITEM_PICKUP": "불타는 적이 체력을 회복시키는 고기 덩어리를 떨어뜨립니다.",
    "ITEM_CHEFITEM_DESCRIPTION": "<style=cIsDamage>점화 확률 25%</style>를 얻습니다. 불타는 적을 타격하면 <style=cIsDamage>1%</style><style=cStack>(중첩당 +1%)</style> 확률로 <style=cIsHealing>체력 25.0</style>을 회복시키는 <style=cIsHealing>치유 너겟</style> 2개를 생성합니다. 너겟 생성 확률은 <style=cIsDamage>화상 중첩 수에 따라</style> 최대 <style=cIsDamage>10</style>배까지 증가합니다.",
    "ITEM_BORBOFUSE_NAME": "휘발성 퓨즈",
    "ITEM_BORBOFUSE_PICKUP": "보호막이 파괴될 때 적을 기절시키는 폭발을 일으킵니다.",
    "ITEM_BORBOFUSE_DESCRIPTION": "<style=cIsHealing>보호막 25.0</style><style=cStack>(중첩당 +25.0)</style>을 얻습니다. 보호막이 파괴되면 <style=cIsUtility>40.0m</style><style=cStack>(중첩당 +4.0)</style> 내의 최대 3명<style=cStack>(중첩당 +1)</style>의 적에게 <style=cIsUtility>감전</style>을 유발합니다. <style=cIsDamage>감전 지속 시간은 보호막 체력에 비례합니다</style>.",
    "ITEM_NEARBYDEFENSE_NAME": "해파리 목걸이",
    "ITEM_NEARBYDEFENSE_PICKUP": "적이 근처에 있는 동안 방어력과 체력 재생이 증가합니다.",
    "ITEM_NEARBYDEFENSE_DESCRIPTION": "기본 체력 재생이 <style=cIsHealing>+1 hp/s</style><style=cStack>(중첩당 +1 hp/s)</style>, 방어력이 <style=cIsHealing>+10</style><style=cStack>(중첩당 +10)</style> 증가합니다. <style=cIsUtility>20m</style> 내의 적 하나당 기본 체력 재생 <style=cIsHealing>+0.5 hp/s</style><style=cStack>(중첩당 +0.5 hp/s)</style> 및 방어력 <style=cIsHealing>+5</style><style=cStack>(중첩당 +5)</style>를 추가로 얻으며, 최대 <style=cIsUtility>5</style>회까지 중첩됩니다.",
    "ITEM_ICHORRED_NAME": "변성 이코르 (적색)",
    "ITEM_ICHORRED_PICKUP": "공격 속도와 치명타 확률이 증가합니다.",
    "ITEM_ICHORRED_DESCRIPTION": "<style=cIsDamage>공격 속도</style>가 <style=cIsDamage>7.5%</style><style=cStack>(중첩당 +7.5%)</style> 증가합니다. <style=cIsDamage>치명타 확률</style>이 <style=cIsDamage>5%</style><style=cStack>(중첩당 +5%)</style> 증가합니다. <style=cIsVoid>모든 반발 방어구 판과 황색 이코르를 타락시킵니다</style>.",
    "ITEM_ICHORVIOLET_NAME": "변성 이코르 (자색)",
    "ITEM_ICHORVIOLET_PICKUP": "피해를 입으면 방어막을 얻습니다. <style=cIsVoid>모든 구급상자와 적색 이코르를 타락시킵니다</style>.",
    "ITEM_ICHORVIOLET_DESCRIPTION": "피해를 입으면 <style=cIsHealing>방어막 22</style><style=cStack>(중첩당 +22)</style>를 얻습니다. <style=cIsVoid>모든 구급상자와 적색 이코르를 타락시킵니다</style>.",
    "ITEM_ICHORYELLOW_NAME": "변성 이코르 (황색)",
    "ITEM_ICHORYELLOW_PICKUP": "체력 재생을 얻습니다. <style=cIsVoid>모든 병사의 주사기와 자색 이코르를 타락시킵니다</style>.",
    "ITEM_ICHORYELLOW_DESCRIPTION": "<style=cIsHealing>기본 체력 재생</style>이 <style=cIsHealing>0.8 hp/s</style><style=cStack>(중첩당 +0.8 hp/s)</style> 증가합니다. <style=cIsVoid>모든 병사의 주사기와 자색 이코르를 타락시킵니다</style>.",
    "ITEM_PHRYGIANLILY_NAME": "프리기아 백합",
    "ITEM_PHRYGIANLILY_PICKUP": "텔레포터를 작동시킨 후 분노 상태에 빠집니다. <style=cIsVoid>모든 렙톤 데이지를 타락시킵니다.</style>",
    "ITEM_PHRYGIANLILY_DESCRIPTION": "텔레포터를 작동시키면 20초 동안 <style=cIsDamage>분노 상태</style>가 됩니다. 분노 중에는 공격 속도가 +30%<style=cStack>(중첩당 +15%)</style> 증가하고 스킬 재사용 대기시간이 30%<style=cStack>(중첩당 15%)</style> 감소합니다.",
    "ITEM_HEALFROMBLEEDINGENEMIES_NAME": "흡혈 코랄라이트",
    "ITEM_HEALFROMBLEEDINGENEMIES_PICKUP": "출혈 상태인 적을 공격하면 체력을 회복합니다. 모든 거머리 씨앗을 타락시킵니다.",
    "ITEM_HEALFROMBLEEDINGENEMIES_DESCRIPTION": "<style=cIsHealth>출혈 확률 10%</style>를 얻습니다. 출혈 상태인 적을 타격하면 <style=cIsHealth>출혈 중첩당</style> <style=cIsDamage>+0.2의 체력</style>을 회복하며, 최대 2<style=cStack>(중첩당 +1)</style>의 체력을 회복합니다. <style=cIsVoid>모든 거머리 씨앗을 타락시킵니다.</style>",
    "ITEM_WICKEDBAND_NAME": "사악한 고리",
    "ITEM_WICKEDBAND_PICKUP": "높은 피해의 타격이 재사용 대기시간을 1초 감소시킵니다.",
    "ITEM_WICKEDBAND_DESCRIPTION": "<style=cIsDamage>400% 이상의 피해</style>를 입히는 타격이 <style=cIsUtility>모든 재사용 대기시간을 1.0초</style><style=cStack>(중첩당 +1.0)</style> 감소시킵니다. <style=cIsHealth>재사용 대기시간 1.0초.</style>",
    "ITEM_GALLERY_ITEM_DROP_NAME": "갤러리 아이템 드롭",
    "ITEM_GALLERY_ITEM_DROP_PICKUP": "이게 보이면 안 되는데 ㅋㅋ",
    "ITEM_GALLERY_ITEM_DROP_DESCRIPTION": "이게 보이면 안 되는데 ㅋㅋ",
    "ITEM_HEALTHUP_NAME": "체력 증가",
    "ITEM_AOEONCRIT_NAME": "하이포 스레더",
    "ITEM_AOEONCRIT_PICKUP": "'치명타' 시 연쇄 레이저를 발사합니다.",
    "ITEM_AOEONCRIT_DESCRIPTION": "<style=cIsDamage>치명타 확률 5%</style>를 얻습니다. <style=cIsDamage>치명타</style> 시 최대 <style=cIsDamage>1명<style=cStack>(중첩당 +1)</style>의 적</style>에게 튕기는 <style=cIsDamage>연쇄 레이저</style>를 발사하여 총 피해량의 <style=cIsDamage>60%</style><style=cStack>(중첩당 +20%)</style>를 입힙니다.",
    "ITEM_AOEONCRIT_LORE": "이 멍청아! 이건 '절대 안 부서지는' 물건이라고. 도대체 어떻게 해야 이 꼴이 나는 거야?\r\n\r\n야... 말하기 미안한데 하이퍼 스레더는 개싼값이야. 새 거 하나 사는 데 푼돈밖에 안 든다고. 왜 그런지 생각해 본 적 있어?\r\n\r\n알 바 아니라고. 이건 이제 거의 작동도 안 해. 누가 새 걸 사준다면 그건 바로 너야.\r\n\r\n하하, 야, 어, 내가 돈으로 만들어졌다고 생각하냐? 난 어—\r\n\r\n말했잖아. 알. 바. 아. 니. 라. 고.",
    "ITEM_BORBOBIGBATTERY_NAME": "AAAAAAA 배터리",
    "ITEM_BORBOBIGBATTERY_PICKUP": "보호막 재충전 속도가 증가합니다. 보호막이 활성화된 동안 공격 속도 보너스를 얻습니다.",
    "ITEM_BORBOBIGBATTERY_DESCRIPTION": "최대 체력의 <style=cIsHealing>4%</style>에 해당하는 <style=cIsHealing>보호막</style>을 얻습니다. <style=cIsUtility>보호막 재충전 대기시간</style>을 <style=cIsUtility>1.0초</style> 단축합니다. 보호막이 활성화된 동안 <style=cIsDamage>공격 속도</style>가 <style=cIsDamage>20%</style><style=cStack>(중첩당 +20%)</style> 증가합니다.",
    "ITEM_BORBOBIGBATTERY_LORE": "주문품: 시제품 배터리\r\n송장 번호: 11***********\r\n예상 배송일: 2056/5/6\r\n배송 방법: 우선 배송\r\n배송지: 태양 팔리아 연구 기지\r\n배송 상세:\r\n\r\n자, 이건 어때요?\r\n\r\n저희가 어,\r\n\r\n*킥킥*\r\n\r\n지난 시제품에 대한 메모를 검토해 봤는데, 어,\r\n\r\n(배경 잡담 소리)\r\n\r\n치수를 살짝 조정했습니다\r\n\r\n*킥킥*\r\n\r\n이번 건 당신 발전기 그거보다 약간 더 길긴 한데, 어\r\n\r\n(참는 웃음소리)\r\n\r\n이 작은, 어, 커넥터 같은 것도 그려봤어요...\r\n\r\n(닥쳐 이 자식들아)\r\n\r\n어, 어쨌든, 데모 영상처럼 그냥 거기다 푹 꽂으면 돼요\r\n\r\n(큰 발소리)\r\n\r\n솔직히 말해서 저희가,\r\n\r\n*킥킥*\r\n\r\n진짜 대단한 걸 찾아낸 것 같아요, 진짜로\r\n\r\n이게 새로운 어\r\n\r\n표준 전원 공급 장치가 될 수도 있잖아요\r\n\r\n*킥킥*\r\n\r\n안 그래요?",
    "ITEM_BINARYSHIELD_NAME": "판금 페레오포드",
    "ITEM_BINARYSHIELD_PICKUP": "보호막이 꺼져 있는 동안 이동 속도가 증가합니다.",
    "ITEM_BINARYSHIELD_DESCRIPTION": "<style=cIsHealing>보호막 25.0</style> 및 <style=cIsUtility>이동 속도 5%<style=cStack>(중첩당 +19%)</style></style>를 얻습니다. 보호막이 꺼져 있는 동안 <style=cIsUtility>이동 속도</style>가 <style=cIsUtility>19%</style><style=cStack>(중첩당 +19%)</style> 증가합니다. <style=cIsVoid>모든 폴의 염소 발굽을 타락시킵니다.</style>",
    "ITEM_BIRDBAND_NAME": "개발자의 아이템",
    "ITEM_BIRDBAND_PICKUP": "높은 피해의 타격을 입히면 잠시 동안 재생 상태가 됩니다. 시간이 지나면 재충전됩니다.",
    "ITEM_BIRDBAND_DESCRIPTION": "<style=cIsDamage>400% 이상의 피해</style>를 입히는 타격 시 <style=cIsDamage>1.5초</style><style=cStack>(중첩당 +0.75초)</style> 동안 <style=cIsHealing>재생</style> 상태가 되어 매초 <style=cIsHealing>최대 체력의 10%</style>를 회복합니다. 7초마다 재충전됩니다.",
    "ITEM_BIRDBAND_LORE": "“내 말 믿어, 걔네 진짜라고.”\r\n\r\n“말도 안 돼, 임마. 괴담치고도 너무 터무니없잖아.”\r\n\r\n“그래! ‘신들 자신보다도 높은 존재’라고? 정신 차려.”\r\n\r\n“증거를 봤다니까. 설명할 수 없는 미친 일들이라고.”\r\n\r\n“오, 어디 말해 봐. 완전 기대되네.”\r\n\r\n“저 미사일 발사기 알지? 예전엔 존나 큰 로켓 한 방 쏘던 거 말이야. 왜 갑자기 저 작은 침들을 토해내기 시작한 걸까?”\r\n\r\n“글쎄.”\r\n\r\n“걔네 소행이야. 다시 썼다고. 그리고— 처음부터 없었던 것처럼 싹 사라진 그 모든 것들도. 갑자기 효과가 확 떨어진 우리 의료품들도 다 마찬가지야. 괴물들이 예전만큼 세게 안 때리는 거 눈치 못 챘어?”\r\n\r\n“야...”\r\n\r\n“진짜라니까! 우리 슈트도 전부 갑자기... 굼떠졌잖아. 아무 문제도 없는데 한꺼번에 말이야.”\r\n\r\n“...”\r\n\r\n“그리고 내 웡거스는 이제 체력을 1밖에 안 채워줘.”\r\n\r\n“야. 너 도대체 무슨 헛소리를 하는 거냐?”\r\n\r\n“얘 완전히 맛 갔네.”",
    "ITEM_CLOUDBOTTLE_NAME": "병 속의 구름",
    "ITEM_CLOUDBOTTLE_PICKUP": "적 근처에서 이단 점프를 하여 기절시키세요!",
    "ITEM_CLOUDBOTTLE_DESCRIPTION": "공중 점프 충전을 1회 얻습니다. 재사용 대기시간 <style=cIsUtility>15</style>초. 준비되었을 때 적 <style=cIsUtility>9.0m</style><style=cStack>(중첩당 +9.0m)</style> 이내에서 공중 점프를 하면 <style=cIsUtility>연막탄</style>을 떨어뜨려 <style=cIsDamage>1.0초</style> 동안 <style=cIsDamage>기절</style>시키고 재사용 대기시간을 <style=cIsUtility>10초</style> 단축합니다.",
    "ITEM_FARTBOTTLE_NAME": "격리된 오염 물질",
    "ITEM_FARTBOTTLE_PICKUP": "적 근처에서 이단 점프를 하면 불구 상태로 만들고 피해를 입힙니다. <style=cIsVoid>모든 병 속의 구름을 타락시킵니다.</style>",
    "ITEM_FARTBOTTLE_DESCRIPTION": "공중 점프 충전을 1회 얻습니다. 준비되었을 때 적 <style=cIsUtility>11.0m</style> 이내에서 공중 점프를 하면 <style=cIsDamage>유독 가스</style>를 생성하여 매초 <style=cIsDamage>200%</style><style=cStack>(중첩당 +100%)</style>의 기본 피해를 입히고 범위 내의 적을 불구로 만듭니다. <style=cIsUtility>4</style>초 동안 재발동할 수 없습니다. <style=cIsVoid>모든 병 속의 구름을 타락시킵니다.</style>",
    "ITEM_CHICKEN_NAME": "생닭고기",
    "ITEM_CHICKEN_PICKUP": "최대 체력이 증가합니다. 토하지 않게 조심하세요!",
    "ITEM_CHICKEN_DESCRIPTION": "<style=cIsHealing>최대 체력</style>이 <style=cIsHealing>30%</style><style=cStack>(중첩당 +30%)</style> 증가합니다. <style=cIsHealing>식중독</style>에 걸려 120초 동안 <style=cIsHealing>기본 체력 재생</style>이 <style=cIsHealing>-2.0 hp/s</style> 감소합니다.",
    "ITEM_DISCOUNTCARDNEW_NAME": "로열티 카드",
    "ITEM_DISCOUNTCARDNEW_PICKUP": "상점 터미널에서 현금을 환급받고 열린 상태를 유지합니다. 두 번 사용할 수 있습니다.",
    "ITEM_DISCOUNTCARDNEW_DESCRIPTION": "<style=cIsUtility>멀티샵</style> 터미널에서 구매 시, 다른 터미널이 <style=cIsUtility>열린 상태를 유지</style>하며 <style=cIsUtility>$20</style>를 환급받습니다. 최대 2회까지 사용 가능합니다.",
    "ITEM_BOSSITEMCONSUMABLE_NAME": "흑요석 메스",
    "ITEM_BOSSITEMCONSUMABLE_PICKUP": "대형 몬스터가 전리품을 떨어뜨릴 확률이 크게 증가합니다. 드롭 시 소모됩니다.",
    "ITEM_BOSSITEMCONSUMABLE_DESCRIPTION": "<style=cIsDamage>전리품 아이템</style>을 떨어뜨릴 수 있는 적을 처치하면 <style=cIsDamage>전리품</style> 드롭 확률이 추가로 <style=cIsUtility>50%</style> 증가합니다. 발동에 성공하면 소모됩니다.",
    "ITEM_BOSSITEMCONSUMABLE_LORE": "주문품: 의료용 메스 (흑요석)\r\n송장 번호: 91***********\r\n예상 배송일: 2056/09/30\r\n배송 방법: 우선 배송/취급 주의\r\n배송지: 화성 골리앗 산\r\n배송 상세:\r\n\r\n요청하신 사양에 맞춰 맞춤 제작되었습니다. 매우 날카롭습니다. 칼날 두께는 플랑크 길이 단위로 측정되었습니다. 필요한 무엇이든 확실히 잘라낼 것입니다.\r\n다만 내구성은 장담할 수 없습니다. 한 번에 끝내도록 하세요.\r\n그리고 한 가지 더— 부러질 때는 수술이 끝날 때까지 기다려 주지 않습니다. 손상되거나 죽이고 싶지 않은 것에는 사용하지 마세요.\r\n뭐, 이미 다 알고 계시겠지만요. 도대체 무슨 용도로 이걸 계속 주문하시는지 궁금할 따름입니다.",
    "ITEM_EGG_NAME": "달걀",
    "ITEM_EGG_PICKUP": "체력이 소량 증가합니다. 에그 헌트를 시작합니다. <style=cIsVoid>대부분의 식용 및 동물성 물질을 타락시킵니다</style>.",
    "ITEM_EGG_DESCRIPTION": "<style=cIsHealing>최대 체력 5</style>를 얻습니다. <style=cIsUtility>에그 헌트를 시작</style>합니다. <style=cIsVoid>모든 주입, 들소 스테이크, 외계인 머리를 타락시킵니다</style>.",
    "ITEM_EGG_LORE": "이 달걀 존나게 맛있네",
    "ITEM_FROZENSHELL_NAME": "얼어붙은 거북 등껍질",
    "ITEM_FROZENSHELL_PICKUP": "체력이 낮을 때 받는 피해가 감소합니다.",
    "ITEM_FROZENSHELL_DESCRIPTION": "<style=cIsHealing>최대 체력</style>이 <style=cIsHealing>8%</style><style=cStack>(중첩당 +8%)</style> 증가합니다. 잃은 <style=cIsHealth>최대 체력의 10%</style>마다 방어력을 <style=cIsHealing>5</style><style=cStack>(중첩당 +5)</style> 추가로 얻습니다.",
    "ITEM_GAMMAKNIFE_NAME": "감마 나이프",
    "ITEM_GAMMAKNIFE_PICKUP": "챔피언을 처치하면 영구적으로 재사용 대기시간이 감소하고 일시적으로 치명타가 확정됩니다. <style=cIsVoid>모든 흑요석 메스를 타락시킵니다.</style>",
    "ITEM_GAMMAKNIFE_DESCRIPTION": "<style=cIsDamage>챔피언</style>을 처치하면 <style=cIsDamage>9.0</style>초 동안 <style=cIsDamage>치명타 확률</style>이 <style=cIsDamage>100%</style> 증가하고, <style=cIsHealth>영구적으로</style> <style=cIsUtility>방어력</style>이 <style=cIsUtility>5</style> 증가하며 모든 <style=cIsDamage>스킬 재사용 대기시간</style>이 <style=cIsDamage>-5%</style> 감소합니다(최대 <style=cIsUtility>9</style><style=cStack>(중첩당 +9)</style>회). <style=cIsVoid>모든 흑요석 메스를 타락시킵니다.</style>",
    "ITEM_GOLDEN_EGG_NAME": "황금 달걀",
    "ITEM_GOLDEN_EGG_PICKUP": "때로는 꿈이 이루어지기도 합니다...",
    "ITEM_GOLDEN_EGG_DESCRIPTION": "다음 스테이지 시작 시, 황금 달걀 하나가 부화하여 공허 아이템이 됩니다.",
    "ITEM_BORBODISCOUNT_NAME": "탐욕의 반지",
    "ITEM_BORBODISCOUNT_PICKUP": "상자를 연 후 추가 골드와 체력 재생을 얻습니다.",
    "ITEM_BORBODISCOUNT_DESCRIPTION": "<style=cIsDamage>돈</style>을 지출한 후 20.0초 동안 <style=cIsDamage>리베이트</style>를 얻습니다. <style=cIsDamage>리베이트</style>가 활성화된 동안 수입이 15%<style=cStack>(중첩당 +7.5%)</style> 증가하고 <style=cIsHealing>기본 체력 재생</style>이 <style=cIsHealing>3.0 hp/s</style><style=cStack>(중첩당 +3.0 hp/s)</style> 증가합니다.",
    "ITEM_BORBODISCOUNT_LORE": "주문품: Mapel 쿠폰 게터 (라이트)\r\n송장 번호: 06***********\r\n예상 배송일: 2056/11/04\r\n배송 방법: 우선 배송\r\n배송지: 지구 벨파스트 정거장 308호\r\n배송 상세:\r\n\r\n자, 여기 있습니다. 약속드린 대로 전자 결제 시 코드를 (물론 합법적으로) 확인하여 프로모션 코드와 할인을 찾아내어 사용자 입력 없이 구매에 자동 적용합니다! 아주 합법적이죠.\r\n실제로는 전체 금액을 미리 소지하고 있어야 하고, 적용되는 쿠폰 코드가 최선의 할인이 아닐 수도 있어 조금 투박할 수 있습니다. 물론 법적인 이유 때문이죠. 아, 그리고 사용 횟수에 제한이 있어서 쿠폰을 다시 받으려면 갱신될 때까지 잠시 기다려야 합니다.\r\n물론 무제한 할인을 원하신다면 언제든 프리미엄 버전을 구매하실 수 있습니다~\r\n",
    "ITEM_KALEIDOSKULL_NAME": "만화경 해골",
    "ITEM_KALEIDOSKULL_PICKUP": "치명타 적중 시 무작위 디버프를 부여합니다. <style=cIsVoid>모든 포식 본능을 타락시킵니다.</style>",
    "ITEM_KALEIDOSKULL_DESCRIPTION": "<style=cIsDamage>치명타 확률 5%</style>를 얻습니다. <style=cIsDamage>치명타</style> 시 무작위로 <style=cIsDamage>점화</style> 또는 <style=cIsUtility>서리</style>를 부여합니다. 또한 50% 확률로 무작위 디버프 <style=cIsUtility>1</style><style=cStack>(중첩당 +1)</style>개를 부여합니다. <style=cIsVoid>모든 포식 본능을 타락시킵니다.</style>",
    "ITEM_LIGHTNINGATTRACTOR_NAME": "구리 포크",
    "ITEM_LIGHTNINGATTRACTOR_PICKUP": "연속 타격 시 번개를 끌어당깁니다.",
    "ITEM_LIGHTNINGATTRACTOR_DESCRIPTION": "<style=cIsDamage>스킬 또는 장비</style>로 피해를 입히면 적에게 <style=cIsUtility>3.0</style>초 동안 구리 포크가 꽂힙니다. 포크가 꽂힌 적을 반복해서 공격하면 포크의 지속 시간이 초기화되고 번개를 끌어당겨 근처의 적을 <style=cIsDamage>기절</style>시키며 <style=cIsDamage>300%의 기본 피해</style><style=cStack>(중첩당 +300%)</style>를 입힙니다. 최대 1개, 포크가 만료된 후 <style=cIsUtility>5.0초</style> 뒤에 재충전됩니다.",
    "ITEM_LIGHTNINGATTRACTOR_LORE": "CuCo의 신제품!\r\n\r\nCopperWare 식기 세트는 평범한 스테인리스 스틸 식기보다 수많은 장점을 제공합니다.\r\n\r\n식탁과 어울리는 세련된 적갈색으로, CuCo CopperWare 냄비 및 프라이팬 세트와 완벽한 조화를 이룹니다!\r\n\r\n식기를 통해 직접 보충 구리를 섭취할 수 있습니다!\r\n\r\n손쉬운 세척! 식초나 레몬즙 같은 가정용 산성 물질로 가볍게 닦아주기만 하면 출고 당시의 광택을 되찾을 수 있습니다!\r\n\r\n오늘 CopperWare를 만나보세요!\r\n\r\n제품 경고\r\n\r\n갈바닉 부식의 위험을 피하기 위해, 특히 소금과 같은 전해질이 있는 환경에서는 CopperWare가 다른 금속 표면과 닿지 않도록 하세요.\r\n\r\n요리 중에 CopperWare 식기를 사용하지 마세요. 심각한 화상 위험이 있으며 음식에 구리가 용출될 수 있습니다.\r\n\r\n구리와 알츠하이머병의 연관성으로 인해 65세 이상 고객에게는 CopperWare 사용을 권장하지 않습니다.\r\n\r\n구리의 높은 전기 전도성으로 인해 전류나 전기 기기 근처에서는 CopperWare 제품을 사용하지 않는 것이 좋습니다.\r\n\r\n치명적인 감전 위험을 줄이기 위해 야외에서 식사할 때는 CopperWare 제품을 사용하지 마세요.\r\n\r\n본 제품을 구매하고 사용함에 동의함으로써, CuCo는 구리 주방용품의 특성으로 인해 발생하는 소비자의 불만에 대한 모든 책임에서 면제됩니다.",
    "ITEM_LOWHEALTHREGEN_NAME": "매력적인 꾀꼬리버섯",
    "ITEM_LOWHEALTHREGEN_PICKUP": "체력 재생이 증가하지만, 체력이 60% 미만일 때만 자라납니다!",
    "ITEM_LOWHEALTHREGEN_DESCRIPTION": "<style=cIsHealing>최대 체력의 60%</style> 미만일 때 <style=cIsHealing>기본 체력 재생</style>이 <style=cIsHealing>+2.0 hp/s</style><style=cStack>(중첩당 +2.0 hp/s)</style> 증가합니다.",
    "ITEM_LUNARBRAND_NAME": "별불꽃 낙인",
    "ITEM_LUNARBRAND_PICKUP": "불타는 적을 지져 큰 피해를 입히고 <style=cIsHealth>적의 모든 디버프를 제거합니다.</style>",
    "ITEM_LUNARBRAND_DESCRIPTION": "타격 시 <style=cIsDamage>20%</style> 확률로 <style=cIsDamage>점화</style>를 부여합니다. 화상을 <style=cIsDamage>5</style>중첩 부여하면 적을 <style=cIsDamage>5</style>초<style=cStack>(중첩당 +5)</style> 동안 지져 <style=cIsDamage>900%</style><style=cStack>(중첩당 +450%)</style>의 피해를 입힙니다. 또한 지짐 효과는 적의 이동 속도를 50% 늦추고 모든 치유를 무효화하지만, <style=cIsHealth>지져진 적은 모든 디버프가 정화되고 방어력이 +30 증가합니다.</style>",
    "ITEM_LUNARINCREASECD_NAME": "압축 고리",
    "ITEM_LUNARINCREASECD_PICKUP": "모든 스킬이 달빛 파편을 발사하지만... <style=cIsHealth>모든 스킬의 재사용 대기시간이 증가합니다</style>",
    "ITEM_LUNARINCREASECD_DESCRIPTION": "스킬 사용 시 <style=cIsDamage>160% 피해</style>의 <style=cIsDamage>달빛 파편</style>을 발사합니다(스킬 재사용 대기시간에 따라 증가). <style=cIsHealth>모든 스킬의 재사용 대기시간이 1.0초 증가합니다</style><style=cStack>(중첩당 +1.0)</style>.",
    "ITEM_MAGICQUIVER_NAME": "마법 화살통",
    "ITEM_MAGICQUIVER_PICKUP": "스킬 사용 시 확률적으로 충전 횟수를 소모하지 않습니다.",
    "ITEM_MAGICQUIVER_DESCRIPTION": "스킬 시전 시 <style=cIsDamage>10.0%</style><style=cStack>(중첩당 +10.0%)</style> 확률로 충전 횟수를 소모하지 않습니다. <style=cIsUtility>행운의 영향을 받지 않습니다</style>.",
    "ITEM_BORBOMANAFLOWER_NAME": "자연의 선물",
    "ITEM_BORBOMANAFLOWER_PICKUP": "공격 속도가 소폭 증가하고 기본 및 보조 스킬의 재사용 대기시간이 감소합니다.",
    "ITEM_BORBOMANAFLOWER_DESCRIPTION": "<style=cIsDamage>공격 속도</style>가 <style=cIsUtility>8%</style><style=cStack>(중첩당 +8%)</style> 증가하고, <style=cIsUtility>기본 및 보조 스킬의 재사용 대기시간</style>이 <style=cIsUtility>8%</style><style=cStack>(중첩당 +8%)</style> 감소합니다.",
    "ITEM_BORBOMANAFLOWER_LORE": "주문품: 주피터 로즈\r\n송장 번호: 58***********\r\n예상 배송일: 2056/07/30\r\n배송 방법: 일반 배송\r\n배송지: 금성 오크 대로 280\r\n배송 상세:\r\n\r\n예쁘지 않나요?\r\n바라만 보고 있어도 에너지가 샘솟는 것 같아요.\r\n자연은 정말 마법 같네요 :)",
    "ITEM_MINIAMETHYST_NAME": "자수정 파편",
    "ITEM_MINIAMETHYST_PICKUP": "장비를 발동하면 스킬 재사용 대기시간이 감소합니다.",
    "ITEM_MINIAMETHYST_DESCRIPTION": "장비를 발동하면 <style=cIsUtility>모든 스킬 재사용 대기시간</style>이 장비 기본 재사용 대기시간의 <style=cIsUtility>10%</style><style=cStack>(중첩당 +10%)</style>만큼 감소합니다.",
    "ITEM_DANGERCRIT_NAME": "더 뉴 로퍼",
    "ITEM_DANGERCRIT_PICKUP": "체력이 낮을 때 '치명타' 피해가 대폭 증가합니다.",
    "ITEM_DANGERCRIT_DESCRIPTION": "<style=cIsDamage>치명타 확률 20%</style>를 얻습니다. <style=cIsHealth>체력이 50% 미만</style>으로 떨어지면 광란 상태에 빠져 <style=cIsDamage>치명타 피해가 250%</style><style=cStack>(중첩당 +250%)</style>, <style=cIsDamage>치명타 확률이 30%</style> 증가합니다. 적을 처치하면 광란 상태가 <style=cIsDamage>4.0초</style> <style=cIsDamage>연장</style>됩니다.",
    "ITEM_DANGERCRIT_LORE": "성명: [검열됨]\r\n생년월일: 1961년 6월 21일\r\n직업: 사형 집행인\r\n\r\n사망 시각: 2058년 8월 23일\r\n사망 장소: 수성 [검열됨]\r\n사망 원인: 신체 절단으로 인한 과다 출혈\r\n\r\n비고:\r\n시신 옆에서 손상되지 않은 도끼가 발견되었다. 조사 결과 이 무기는 마모와 얼룩, 특히 혈흔에 매우 강한 내성을 지닌 것으로 밝혀졌다. 도끼의 제작 방식은 [검열됨]이 사망 직전에 접촉했던 목성 수즈 드라이브의 대장장이의 것과 일치한다.\r\n\r\n[검열됨]은 사망 전 1시간 동안 확인된 것만 126건의 살인을 저질렀다. 모든 피해자는 참수로 살해되었으며 다른 외상은 없었다. 목격자들에 따르면 [검열됨]은 실수로 자신을 내리쳐 허리가 두 동강 났으며, 몇 순간 뒤 과다 출혈로 사망했다고 한다.\r\n\r\n부검 결과 [검열됨]의 사망 이전부터 내부 장기의 손상이 진행되고 있었던 것으로 드러났다. 증상은 목성에서 발견된 특정 [검열됨] 균주와 일치한다. 뇌에서는 손상이 발견되지 않았으나, 이 질병이 그의 정신 상태에 영향을 미쳤을 가능성이 있다.\r\n",
    "ITEM_GOODEXECUTIONITEM_NAME": "영구동토",
    "ITEM_GOODEXECUTIONITEM_PICKUP": "강한 타격 시 확률적으로 적을 빙결시키며, 체력이 낮은 적은 즉시 처치합니다.",
    "ITEM_GOODEXECUTIONITEM_DESCRIPTION": "타격 시 <style=cIsDamage>입힌 피해가 적 최대 체력에서 차지하는 비율 1%당</style> <style=cIsDamage>3.0%</style><style=cStack>(중첩당 +2.0%)</style> 확률로 적을 제자리에 <style=cIsUtility>1.5초 동안</style> <style=cIsUtility>빙결</style>시킵니다. 빙결된 적은 체력이 낮을 때 <style=cIsHealth>즉시 처치</style>됩니다.",
    "ITEM_PHOTOGRAPH_NAME": "사진",
    "ITEM_PHOTOGRAPH_PICKUP": "아이템을 출력하면 치명타 확률과 피해가 증가합니다. 각 스테이지 시작 시 초기화됩니다.",
    "ITEM_PHOTOGRAPH_DESCRIPTION": "아무 출력기에서 아이템을 소모하면 <style=cIsDamage>치명타 확률</style>과 <style=cIsDamage>치명타 피해</style>가 <style=cIsDamage>+10.0%</style><style=cStack>(중첩당 +5.0%)</style> 증가하며, 최대 <style=cIsUtility>3회</style><style=cStack>(중첩당 +0)</style>까지 중첩됩니다. 각 스테이지 시작 시 초기화됩니다.",
    "ITEM_PHOTOGRAPH_LORE": "사진 출력했어?\n\n\"보거스 빈티드?\"\n\n어?\n\n\"GreenAlienHead를 다운로드하세요\"",
    "ITEM_CHARGEDMALACHITESPINE_NAME": "충전된 공작석 가시",
    "ITEM_CHARGEDMALACHITESPINE_PICKUP": "보호막이 파괴될 때 자신을 중독시켜 높은 피해 저항력을 얻습니다.",
    "ITEM_CHARGEDMALACHITESPINE_DESCRIPTION": "<style=cIsHealing>보호막 50.0</style><style=cStack>(중첩당 +50.0)</style>을 얻습니다. 중독된 동안 <style=cIsHealing>방어력 200.0</style>을 얻습니다. <style=cIsHealth>보호막 파괴 시 5.0초 동안 중독됩니다</style><style=cStack>(중첩당 +5.0초)</style>.",
    "ITEM_WISHBONE_NAME": "위시본",
    "ITEM_WISHBONE_PICKUP": "폭풍우 중에 부러집니다. 텔레포터로 가져가면 소원이 이루어집니다.",
    "ITEM_WISHBONE_DESCRIPTION": "폭풍우 중에 부러집니다. 텔레포터로 가져가면 소원이 이루어집니다.",
    "ITEM_WISHBONE_LORE": "설정어어어어어어",
    "ITEM_RANDOMBARRIERTARGET_NAME": "수정구",
    "ITEM_RANDOMBARRIERTARGET_PICKUP": "근처의 적을 강조 표시합니다. 타격 시 방어막과 치명타 확률을 얻습니다.",
    "ITEM_RANDOMBARRIERTARGET_DESCRIPTION": "방어막 감소를 <style=cIsHealing>-20%</style> 줄입니다. 무작위 적 하나를 <style=cIsDamage>강조 표시</style>합니다. 표적의 적을 공격하면 <style=cIsHealing>체력 8.0</style><style=cStack>(중첩당 +8.0)</style>의 <style=cIsHealing>일시적 방어막</style>을 얻고 <style=cIsDamage>치명타 확률</style>이 <style=cIsDamage>+20.0%</style><style=cStack>(중첩당 +10.0%)</style> 증가합니다.",
    "ITEM_RANDOMBARRIERTARGET_LORE": "주문품: 수정구\r\n송장 번호: 66***********\r\n예상 배송일: 2056/5/6\r\n배송 방법: 반품\r\n배송지: 해왕성 부유 성채 Arcane Suppliers Inc.\r\n배송 상세:\r\n\r\n당신네한테서 이 징조의 구슬을 주문했는데, 맙소사, 다시는 이딴 곳에서 아무것도 안 살 겁니다. 이건 완전 개같은 사기야!!!\r\n\r\n이 구슬이 뭐라도 보여주게 하려고 몇 시간이나 애썼는데, 단 한 번도 신성한 투시의 순간이 오질 않았어.\r\n\r\n그리고 날 믿어, 난 내가 깨달았다는 걸 알아. Arcane '사기꾼들'에 있는 그 빌어먹을 족제비 같은 놈들 전부보다 훨씬 더 깨달았다고. 내가 충분히 깨닫지 못했다는 개소리는 집어치워.\r\n\r\n당신네 수정구, 아니 플라스틱 공 때문에 내 전 재산보다 더 많은 돈이 날아갔어. 당장 환불해 줘, 안 그러면 끔찍한 대가를 치르게 될 거야!!!",
    "ITEM_SHIELDAMP_NAME": "스내핑 스톤",
    "ITEM_SHIELDAMP_PICKUP": "보호막이 가득 찼을 때 다음 공격이 소량의 보호막을 소모하여 피해를 증폭시킵니다.",
    "ITEM_SHIELDAMP_DESCRIPTION": "<style=cIsHealing>보호막 40</style>을 얻습니다. 보호막이 가득 찼을 때 스킬로 입히는 피해를 <style=cIsDamage>증폭</style>시킵니다. <style=cIsDamage>증폭된</style> 타격은 <style=cIsDamage>최대 보호막의 40%를 소모</style><style=cStack>(중첩당 -8%)</style>하여 <style=cIsDamage>+400%의 기본 피해</style><style=cStack>(중첩당 +250%)</style>를 입힙니다. 증폭된 피해는 근처의 적 <style=cIsDamage>2명</style>에게 퍼집니다.",
    "ITEM_STARVEIL_NAME": "별의 베일",
    "ITEM_STARVEIL_PICKUP": "피해를 입으면 무적이 됩니다... <style=cIsHealth>하지만 근처에 유성이 떨어져 적과 아군 모두에게 피해를 입힙니다.</style>",
    "ITEM_STARVEIL_DESCRIPTION": "피격 후 0.33초<style=cStack>(중첩당 +0.33초)</style> 동안 <style=cIsUtility>모든 받는 피해에 무적</style>이 됩니다. 그 후 하늘에서 3차례<style=cStack>(중첩당 +2차례)</style> <style=cIsDamage>유성우</style>가 쏟아져 <style=cIsHealth>모든 캐릭터</style>에게 <style=cIsDamage>폭발당 300%의 피해를 입힙니다.</style>",
    "ITEM_STARVEIL_LORE": "나다. 내가 가졌다.\r\n\r\n흥분되나? 두렵나? 뉘우치나? 믿기지 않나?\r\n\r\n살인자여.\r\n\r\n네가 내 ?????를 죽였다. 그들의 형상을 모독했다. 거짓된 신들의 이름으로 끔찍한 실험을 자행했고, 그들의 영혼으로 내 ?????를 도륙했다. 그리고 그 결과로 넌 힘을 얻었지.\r\n\r\n하지만 넌 그것을 잃었다.\r\n\r\n그리고 이제 내가 그것을 가졌다. 나는 ?????의 영혼들에 둘러싸여 복수심으로 가득 차 있다.\r\n\r\n넌 무엇으로 가득 차 있지? 공포와 후회인가?\r\n\r\n네 \"무적\"은 지금 어디 있나? 네 \"신살의 힘\"은 어디 있나? 네 \"별들\"은 어디 있나?\r\n\r\n그것들은 나와 함께 있다. 넌 단순한 살인자 그 이상이다. 바보요, 천치요, 멍청이다. 나와 내 ?????에게 저지른 모든 짓을 후회하게 될 것이다.\r\n\r\n내가 너에게 가고 있기 때문이다. 네가 내게 가하는 한심한 일격마다, 네가 알던 모든 것 위에 죽음의 비를 내려주마.\r\n\r\n어쩔 테냐? 네 거짓된 신들은 기도에 응답하지 않을 것이다. 네가 할 수 있는 건 아무것도 없다. 도망친다면 난 더욱 분노할 뿐이다.\r\n\r\n곧 그곳에 당도하리라. 오래 절망할 필요도 없을 것이다.\r\n\r\n내 ?????의 영혼들이 네 비명을 꿀처럼 들이마실 테니까.",
    "ITEM_UTILITYBARRIER_NAME": "유틸리티 나이프",
    "ITEM_UTILITYBARRIER_PICKUP": "유틸리티 스킬을 시전하면 일시적 방어막을 얻습니다.",
    "ITEM_UTILITYBARRIER_DESCRIPTION": "<style=cIsUtility>유틸리티 스킬</style>을 활성화하면 스킬의 <style=cIsUtility>기본 재사용 대기시간</style> 1초당 최대 체력의 <style=cIsHealing>3%</style><style=cStack>(중첩당 +1.5%)</style>만큼 <style=cIsHealing>일시적 방어막</style>을 얻습니다.",
    "ITEM_VOIDLASERTURBINE_NAME": "초솔레노이드 엔진",
    "ITEM_VOIDLASERTURBINE_PICKUP": "스킬을 사용하면 파괴적인 레이저 기본 공격을 충전합니다. <style=cIsVoid>모든 찬란한 거수와 공명 원반을 타락시킵니다.</style>",
    "ITEM_VOIDLASERTURBINE_DESCRIPTION": "스킬을 사용하면 충전량이 쌓입니다. 90초 분량의 충전량이 누적되면 기본 공격을 대체하는 <style=cIsVoid>천공 관통기</style> 1회<style=cStack>(중첩당 +1회)</style> 사용이 장전됩니다. <style=cIsVoid>천공 관통기</style>를 발사하면 모든 적과 지형을 관통하여 <style=cIsDamage>3200%의 피해</style>를 입힙니다. <style=cIsVoid>모든 찬란한 거수와 공명 원반을 타락시킵니다.</style>",
    "ITEM_VOIDUTILITYBELT_NAME": "뫼비우스 스트림",
    "ITEM_VOIDUTILITYBELT_PICKUP": "유틸리티 스킬을 시전하면 추가 이동 속도 급증을 얻습니다. <style=cIsVoid>모든 유틸리티 나이프를 타락시킵니다.</style>",
    "ITEM_VOIDUTILITYBELT_DESCRIPTION": "<style=cIsUtility>유틸리티 스킬</style>을 활성화하면 스킬의 <style=cIsUtility>기본 재사용 대기시간</style> 1초당 <style=cIsUtility>이동 속도</style>가 <style=cIsUtility>4%</style><style=cStack>(중첩당 +4%)</style> 증가합니다. <style=cIsUtility>2.5초</style> 동안 지속됩니다. <style=cIsVoid>모든 유틸리티 나이프를 타락시킵니다.</style>",
    "ITEM_CUCKLER_NAME": "코발트 방패",
    "ITEM_CUCKLER_PICKUP": "모든 밀쳐내기를 무효화합니다. 정지해 있는 동안 받는 피해가 감소하고 방어막을 얻습니다.",
    "ITEM_CUCKLER_DESCRIPTION": "<style=cIsUtility>모든 밀쳐내기</style>를 무효화합니다. <style=cIsHealing>방어력</style>이 <style=cIsHealing>20</style><style=cStack>(중첩당 +20)</style>, <style=cIsHealing>방어막 생성량</style>이 <style=cIsHealing>6 hp/s</style><style=cStack>(중첩당 +6 hp/s)</style> 증가합니다. 정지해 있는 동안 이 효과는 <style=cIsUtility>5배</style>가 됩니다.",
    "ITEM_CUCKLER_LORE": "<style=cIsHealth>내 저주를 풀어주기 전까지는 들여보낼 수 없다.</style>",
    "ITEM_ECONOMYWEAPON_NAME": "동전 총",
    "ITEM_ECONOMYWEAPON_PICKUP": "열 수 있는 상자 수만큼 추가 피해를 입힙니다.",
    "ITEM_ECONOMYWEAPON_DESCRIPTION": "각 스테이지를 <style=cIsUtility>$25</style>를 소지한 채 시작합니다. <style=cIsUtility>$25 이상</style> 보유 중일 때 <style=cIsDamage>20% 추가 피해</style><style=cStack>(중첩당 +20%)</style>를 입히며, <style=cIsUtility>추가 $25</style>를 보유할 때마다 <style=cIsDamage>4%</style><style=cStack>(중첩당 +4%)</style>씩 최대 <style=cIsUtility>10회</style>까지 증가합니다.",
    "ITEM_ECONOMYWEAPON_LORE": "야, 이거 진짜 끝내준다. 찌릿! 하하.\r\n\r\n이봐, 친구. 이것 좀 봐.\r\n\r\n저 빌어먹을 게 대체 뭐야?\r\n\r\n아니, 잘 보라고.\r\n\r\n…어? 완전 구리네.\r\n\r\n잘 들어, 임마. 머니. 건. 두 자루라고.\r\n\r\n바보냐. 이건 골드로 충전하고, 저건 골드를 쏘는 거잖아. 쿠퍼, 네가 골드를 다 쏴버리면 어떻게 돼? 우리 총을 충전할 수가 없잖아.\r\n\r\n괜찮아, 임마. 이 행성 괴물들은 돈이 넘쳐난다고. 이것 좀 봐!\r\n\r\n…응? 그건 또 뭐야?\r\n\r\n내가 찾은 무슨 모자 같은 건데? 돈을 끌어당기나 봐. 여기서 살아남기만 하면 우린 부자가 될 거야.\r\n\r\n그런 정체불명의 물건 좀 그만 주워. 지금까지 다 우리를 죽이려 들었잖아.\r\n\r\n이번 건 달라, 봐봐— 앗. 아야.\r\n\r\n어.\r\n\r\n왜?\r\n\r\n우리 골드 다 어디 갔지?",
    "ITEM_CRITRETALIATE_NAME": "파괴자의 문장",
    "ITEM_CRITRETALIATE_PICKUP": "피해를 입은 후 치명타가 발동합니다.",
    "ITEM_CRITRETALIATE_DESCRIPTION": "피격 후 <style=cIsDamage>100.0%</style>의 <style=cIsDamage>치명타</style> 확률을 얻으며, <style=cIsDamage>3.0초</style><style=cStack>(중첩당 +1.5초)</style>에 걸쳐 서서히 사라집니다.",
    "ITEM_FLOWERCROWN_NAME": "화관",
    "ITEM_FLOWERCROWN_PICKUP": "최대 체력이 증가합니다.",
    "ITEM_FLOWERCROWN_DESCRIPTION": "<style=cIsHealing>최대 체력</style>이 <style=cIsHealing>12%</style><style=cStack>(중첩당 +12%)</style> 증가합니다.",
    "ITEM_FLOWERCROWN_LORE": "주문품: 화관\r\n송장 번호: 10***********\r\n예상 배송일: 2056/11/02\r\n배송 방법: 우선 배송/취급 주의\r\n배송지: 지구 스파이럴 가든 16층\r\n배송 상세:\r\n\r\n항상 선물 보내줘서 고마워요. 그중 몇 개로 이 화관을 만들어 봤어요. 이걸 쓰고 있으면 아무것도 날 무너뜨릴 수 없을 것처럼 강해진 기분이 들어요. 당신에게도 똑같은 힘이 되기를 바라요! <3\r\n",
    "ITEM_BORBOMOLOTOV_NAME": "화염병 (1개입)",
    "ITEM_BORBOMOLOTOV_PICKUP": "타격 시 확률적으로 불타는 화염병을 던집니다.",
    "ITEM_BORBOMOLOTOV_DESCRIPTION": "타격 시 <style=cIsDamage>9.0%</style> 확률로 <style=cIsDamage>화염병</style>을 던져 적을 <style=cIsDamage>점화</style>시켜 총 피해량의 <style=cIsDamage>60%</style><style=cStack>(중첩당 +60%)</style>를 입히고, 매초 총 피해량의 <style=cIsDamage>30%</style><style=cStack>(중첩당 +30%)</style>를 입히는 <style=cIsDamage>불타는</style> 지역을 남깁니다.",
    "ITEM_BORBOMOLOTOV_LORE": "주문품: 에탄올 병 (32온스), 6개입\r\n송장 번호: 81******\r\n예상 배송일: 2058/05/8\r\n배송 방법: 우선 배송\r\n배송지: 화성 프리벳 로드 테로미어 저택\n배송 상세: 안에 있는 친구들에게 우리가 6월 16일에 술 마시러 간다고 전해줘. 끝내주는 파티가 될 테니, 상황이 너무 통제 불능이 되기 전에 미리 짐 싸서 떠나는 게 좋을 거야.",
    "ITEM_SLUNGUS_NAME": "졸음 포자",
    "ITEM_SLUNGUS_PICKUP": "가만히 서 있으면 자신을 보호하며 근처의 적과 투사체를 느리게 만듭니다. 피격될 때까지 이동 속도가 빨라집니다.",
    "ITEM_SLUNGUS_DESCRIPTION": "정지해 있는 동안 주변 24.0m에 보호용 <style=cIsUtility>정지 역장</style>을 생성하여 근처의 적과 투사체를 <style=cIsUtility>80%</style> <style=cIsUtility>둔화</style>시킵니다. 이동 속도가 20% 빨라지며 <style=cStack>(중첩당 30%)</style> 다음 피격 시까지 지속됩니다.",
    "ITEM_SLUNGUS_LORE": "주문품: 레이지 머쉬룸 여행 친구\r\n송장 번호: 58***********\r\n예상 배송일: 2056/09/23\r\n배송 방법: 우선 배송/생물학적\r\n배송지: 화성 슬레이트 드라이브 444\r\n배송 상세:\r\n\r\n구매해 주셔서 감사합니다!\r\n\r\n사용 방법:\r\n노즐을 ‘열림’으로 돌리세요. 포자가 공기 중으로 퍼져나가 시간이 왜곡되고 느리게 흐르게 됩니다. 이로써 바깥 현실의 시간이 더 빠르게 흐르게 되어 대기 시간을 단축할 수 있습니다. 왜곡 효과가 나타나기까지 약간의 시간이 걸릴 수 있으므로, 포자 수를 최대화하려면 포자 병을 한곳에 두세요. 좁은 밀폐 공간에서 이동할 경우 결국 공간 전체가 포자로 가득 찰 수 있습니다. 과포화를 방지하기 위해 정기적으로 환기하세요.\r\n시간 왜곡 효과를 종료하려면 노즐을 닫고 해당 구역을 벗어나거나 환기하세요. 영향 구역을 떠나기 전에는 반드시 노즐을 닫으세요. 신체의 일부만 시간 왜곡에 노출될 경우 원치 않는 결과가 발생할 수 있습니다.\r\n참고: 왜곡이 시작된 후 몇 초 또는 몇 분 동안은 시간이 정상적으로 느껴질 수 있으나 이는 정상입니다. 당신에게도 시간이 느려질 때까지(천천히 움직이던 물체가 정상 속도로 돌아오고 영향을 받지 않은 물체가 빨라 보일 것입니다) 기다린 후 즐거운 대기 시간을 보내세요!\r\n\r\n경고:\r\n물체가 느리게 보이지만 평소와 동일한 힘을 지니고 있습니다. 원래 빠르게 움직이거나 강한 힘을 가진 물체와 위험한 방식으로 접촉하지 마세요.\r\n영향 구역은 온도가 낮아지므로 따뜻한 옷을 입거나 난방을 높이는 것이 좋습니다. 영향 구역 내에서는 온도계가 정확히 측정되지 않으므로, 실제 체감 온도는 측정치보다 최대 50도 낮다고 가정하세요.\r\n<style=cIsHealth>병을 열지 마세요. 각별히 주의하여 취급하세요. 정기적으로 환기하세요.</style>\r\n\r\nFUN-GUYS Inc.는 질병, 부상, 사망, 시간 감각의 장기적 또는 영구적 변화, 공간 왜곡, 조증 또는 무기력증, 환각, 편집증, 급성 공황 발작 및 기타 불만족스러운 결과에 대해 어떠한 책임도 지지 않습니다. 모든 구매는 최종적입니다.",
    "ITEM_VOIDHAPPIESTMASK_NAME": "잊혀진 가면",
    "ITEM_VOIDHAPPIESTMASK_PICKUP": "적 처치 시 확률적으로 공허 감염충을 소환합니다. <style=cIsVoid>모든 가장 행복한 가면을 타락시킵니다.</style>",
    "ITEM_VOIDHAPPIESTMASK_DESCRIPTION": "몬스터 처치 시 <style=cIsDamage>7.0%</style> 확률로 그 자리에 <style=cIsDamage>공허 감염충</style> 2마리<style=cStack>(중첩당 +1마리)</style>를 생성합니다. <style=cIsVoid>모든 가장 행복한 가면을 타락시킵니다.</style>",
    "ITEM_ATTACKSPEEDHELPER_NAME": "공격속도 도우미",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_NAME": "달빛 갤러리",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_CONTEXT": "내 초월이나 처먹어라 이 너드야",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_NAME": "부식된 구조물",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_CONTEXT": "구조물 차기",
    "2R4R_INTERACTABLE_EGG_PILE_NAME": "달걀",
    "2R4R_INTERACTABLE_EGG_PILE_CONTEXT": "달걀을 발견했다",
    "2R4R_INTERACTABLE_FLOWERBLOOM_NAME": "어라...?",
    "2R4R_INTERACTABLE_FLOWERBLOOM_CONTEXT": "예쁘다, 아, 정말 예쁘구나...",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_NAME": "수렴의 성소",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_CONTEXT": "수렴의 성소에 기도하기",
    "2R4R_INTERACTABLE_VOID_HUSK_NAME": "부서진 껍질",
    "2R4R_INTERACTABLE_VOID_HUSK_CONTEXT": "부숴서 열기",
    "2R4R_INTERACTABLE_WISHBONECARCASS_NAME": "징조",
    "2R4R_INTERACTABLE_WISHBONECARCASS_CONTEXT": "징조 부수기",
    "EQUIPMENT_BROKENZAPINATOR_NAME": "오렌지 재피네이터",
    "EQUIPMENT_BROKENZAPINATOR_PICKUP": "<style=cIsUtility>우리가 이걸 게임에 남겨뒀다니 믿기지가 않네!</style>",
    "EQUIPMENT_BROKENZAPINATOR_DESCRIPTION": "투사체를 발사합니다.",
    "EQUIPMENT_NINJAGEAR_NAME": "마스터 닌자 장비",
    "EQUIPMENT_NINJAGEAR_PICKUP": "들어오는 공격을 확률적으로 회피합니다. 활성화하면 돌진하고 연막탄을 떨어뜨립니다.",
    "EQUIPMENT_NINJAGEAR_DESCRIPTION": "활성화 시 <style=cIsUtility>전방으로 25m 돌진</style>하며, 들어오는 공격을 <style=cIsHealing>회피</style>할 <style=cIsHealing>20% 확률</style>을 얻습니다. 돌진 및 회피 시 <style=cIsDamage>연막탄</style>을 떨어뜨려 13m 내의 적을 <style=cIsUtility>1초</style> 동안 <style=cIsUtility>기절</style>시킵니다.",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_NAME": "사산의 기도",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_PICKUP": "단 하나의 소원을 이루어 줍니다...",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_DESCRIPTION": "원하는 고급 아이템을 하나 얻습니다.",
    "EQUIPMENT_THEMACHINE_NAME": "기계",
    "EQUIPMENT_THEMACHINE_PICKUP": "아무것도 하지 않습니다. 그게 바로 이 물건의 묘미죠!",
    "EQUIPMENT_THEMACHINE_DESCRIPTION": "아무것도 하지 않습니다. 그게 바로 이 물건의 묘미죠!",
    "EQUIPMENT_TESLAEQUIPMENT_NAME": "놀라울 정도로 안정적인 테슬라 코일",
    "EQUIPMENT_TESLAEQUIPMENT_PICKUP": "근처의 적에게 전격을 가하고 처치 시 보호막을 회복합니다.",
    "EQUIPMENT_TESLAEQUIPMENT_DESCRIPTION": "<style=cIsUtility>10.0초</style> 동안 자신을 <style=cIsUtility>대전</style> 상태로 만듭니다. <style=cIsUtility>대전</style> 상태에서 적을 처치하면 근처 <style=cIsDamage>4.0</style>명의 적에게 <style=cIsDamage>200% 피해</style>의 전격을 가하고 <style=cIsHealing>보호막을 15% 회복</style>합니다. 기본 지속 효과로 <style=cIsHealing>최대 체력의 20%</style>에 해당하는 <style=cIsHealing>보호막</style>을 얻습니다.",
    "EQUIPMENT_TESLAEQUIPMENT_LORE": "<style=cMono>테슬라 프레젠테이션 소프트웨어 v1.14\n전원 켜는 중...\n10...</style>\n환영 성명 발표 중...\n<style=cMono>9...</style>\n여러분 모두 환영합니다!\n<style=cMono>8...</style>\n자리에 착석해 주시기 바랍니다.\n<style=cMono>7...</style>\n뒷사람도 잘 보일 수 있도록 배려해 주세요.\n<style=cMono>6...</style>\n프레젠테이션이 곧 시작됩니다.\n<style=cMono>5...</style>\n안전을 위해 직원의 안내를 따라 주세요.\n<style=cMono>4...\n실내 분위기 조명 가동 중...\n3...</style>\n이제 두 눈으로 확인하세요...\n<style=cMono>2...</style>\n전기가 빚어내는...\n<style=cMono>1...</style>\n경이로운 기적을!\n<style=cMono>전력 이상 감지됨...\n10.0초 후 재부팅 절차를 시작합니다...</style>",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_NAME": "치르의 템포",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_PICKUP": "속도의 화신이 됩니다.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_DESCRIPTION": "이동 속도, 공격 속도, 스킬 재충전 속도가 증가합니다.",
    "BORBO_ELITE_AFFIX_SPEED_MODIFIER": "신성한 {0}",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_NAME": "부서진 신념",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_PICKUP": "허영의 화신이 됩니다.",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_DESCRIPTION": "허영의 화신이 됩니다.",
    "BORBO_ELITE_MIRRORED_MODIFIER": "거울상 {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_NAME": "느쿠하나의 양보",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_PICKUP": "영원의 화신이 됩니다.",
    "BORBO_ELITE_AFFIX_LEECH_MODIFIER": "구불거리는 {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_NAME": "심연의 시선",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_PICKUP": "시뮬라크럼의 화신이 됩니다",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_DESCRIPTION": "능력치가 좀 오르나 봄, ㅋㅋ",
    "BORBO_ELITE_AFFIX_SIMULATED_MODIFIER": "시뮬레이션된 {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_NAME": "바바의 후렴",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_PICKUP": "힘의 화신이 됩니다.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_DESCRIPTION": "모든 공격이 폭발성을 띱니다. 주기적으로 박격포를 발사합니다.",
    "BORBO_ELITE_AFFIX_EXPLOSIVE_MODIFIER": "휘발성 {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_NAME": "잠든 힘",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_PICKUP": "홍수의 화신이 됩니다.",
    "BORBO_ELITE_AFFIX_FLOOD_MODIFIER": "쇄도하는 {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_NAME": "뒤틀린 응시",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_PICKUP": "돌풍의 화신이 됩니다.",
    "BORBO_ELITE_AFFIX_SQUALL_MODIFIER": "울부짖는 {0}",
    "ARTIFACT_AWESOMEPOT_NAME": "휘발성의 유물",
    "ARTIFACT_AWESOMEPOT_DESCRIPTION": "폭발성 통 및 항아리가 엘리트 등급이 됩니다.",
    "ARTIFACT_FREELUNAR_NAME": "광신도의 유물",
    "ARTIFACT_FREELUNAR_DESCRIPTION": "무작위 루나 아이템 하나를 가지고 게임을 시작합니다. 각 스테이지 종료 시 항상 푸른색 포탈이 나타납니다.",
    "ARTIFACT_QUICKSTART_NAME": "사산의 유물",
    "ARTIFACT_QUICKSTART_DESCRIPTION": "원하는 고급 아이템 하나를 가지고 게임을 시작합니다.",
    "ARTIFACT_RISKIERRAINSPIRIT_NAME": "정신의 유물",
    "ARTIFACT_RISKIERRAINSPIRIT_DESCRIPTION": "체력이 낮을수록 캐릭터의 이동 및 공격 속도가 빨라집니다.",
    "ITEM_BARRIERONOVERHEAL_NAME": "이지스",
    "ITEM_BARRIERONOVERHEAL_PICKUP": "아무 상호작용 시 방어막을 얻습니다. 위험에서 벗어나 있는 동안 방어막이 감소하지 않습니다.",
    "ITEM_BARRIERONOVERHEAL_DESC": "아무 상호작용 오브젝트를 사용하면 <style=cIsHealing>체력 40.0</style><style=cStack>(중첩당 +40.0)</style>에 더해 <style=cIsHealing>최대 체력</style>의 <style=cIsHealing>10.0%</style>에 해당하는 <style=cIsHealing>일시적 방어막</style>을 얻습니다. 위험에서 벗어나 있는 동안 <style=cIsUtility>방어막이 감소하지 않습니다</style>.",
    "ITEM_GOLDONHIT_NAME": "가라앉은 왕관",
    "ITEM_GOLDONHIT_PICKUP": "상자에서 훔칩니다... <style=cIsHealth>체력을 대가로.</style>",
    "ITEM_GOLDONHIT_DESC": "구매 비용이 부족해도 상자와 상호작용하여 <style=cIsUtility>돈을 전혀 쓰지 않고</style> 상자를 열 수 있습니다. 상자에서 훔칠 때는 상자 크기에 따라 <style=cIsHealth>최대 체력</style>의 <style=cIsHealth>[ 25% / 50% / 80% ]</style>를 소모합니다. 스테이지당 최대 1회<style=cStack>(중첩당 +1회)</style> 훔칠 수 있습니다.",
    "ITEM_REGENERATINGSCRAP_NAME": "키메라 고철",
    "ITEM_REGENERATINGSCRAP_PICKUP": "<style=cIsHealth>모든</style> 3D 프린터에서 우선적으로 소모됩니다. 하위 등급의 아이템을 추가로 생성합니다.",
    "ITEM_REGENERATINGSCRAP_DESC": "아무 효과도 없습니다. <style=cIsHealth>모든</style> 3D 프린터에서 우선적으로 소모됩니다. <style=cIsUtility>프린터의 등급에 따라</style> <style=cStack>(</style> 10 <style=cStack>/</style> <style=cIsHealing>5</style> <style=cStack>/</style> <style=cIsHealth>2</style> <style=cStack>)</style>개의 아이템을 생성합니다.",
    "ITEM_GOLDONHURT_NAME": "초콜릿 동전",
    "ITEM_GOLDONHURT_PICKUP": "적이 골드와 회복을 제공하는 간식을 떨어뜨립니다. 시간이 지나면 재충전됩니다.",
    "ITEM_GOLDONHURT_DESC": "타격 시 <style=cIsHealing>체력을 5.0</style><style=cStack>(중첩당 +5.0)</style> 회복하고 <style=cIsUtility>1 골드</style><style=cStack>(중첩당 +1)</style>를 주는 초콜릿 동전을 떨어뜨립니다. <style=cIsUtility>시간에 따라 비례 증가</style>하며 <style=cIsUtility>5.0초 후 재충전됩니다.</style>",
    "ITEM_CRITDAMAGE_NAME": "전투 망원경",
    "ITEM_CRITDAMAGE_PICKUP": "정지해 있는 동안 '치명타' 확률과 피해가 증가합니다.",
    "ITEM_CRITDAMAGE_DESC": "<style=cIsDamage>치명타</style>가 추가로 <style=cIsDamage>100%의 피해</style><style=cStack>(중첩당 +100%)</style>를 입힙니다. <style=cIsUtility>0.2</style>초 동안 가만히 서 있으면 <style=cIsDamage>치명타 확률 30%</style>를 얻습니다.",
    "ITEM_REPEATHEAL_NAME": "시체꽃",
    "ITEM_REPEATHEAL_PICKUP": "시간이 지남에 따라 체력이 감소합니다. 체력이 낮을 때 방어막과 행운을 얻습니다.",
    "ITEM_REPEATHEAL_DESC": "체력을 12.5% 잃을 때마다 부패를 얻습니다. 부패가 3개 누적되면 기본 피해가 4<style=cStack>(중첩당 +2)</style> 증가합니다. 부패가 6개일 때 50% 방어막을 얻고 행운이 2<style=cStack>(중첩당 +2)</style> 증가합니다. <style=cIsHealth>기본 체력 재생이 -2 hp/s 감소합니다</style><style=cStack>(중첩당 -2)</style>.",
    "ITEM_HEALINGPOTION_NAME": "광전사의 비약",
    "ITEM_HEALINGPOTION_PICKUP": "체력이 낮을 때 방어막을 얻고 디버프를 정화하며 모든 재사용 대기시간을 초기화합니다. 스테이지당 한 번 사용 가능합니다.",
    "ITEM_HEALINGPOTION_DESC": "피해를 입어 <style=cIsHealth>체력 25% 미만</style>이 되면 이 아이템을 <style=cIsUtility>소모</style>하여 즉시 최대 체력의 <style=cIsHealing>35%</style>만큼 <style=cIsHealing>방어막</style>을 얻고 모든 재사용 대기시간을 <style=cIsUtility>초기화</style>합니다. 빈 병 하나당 공격 속도가 <style=cIsDamage>15%</style>, 이동 속도가 <style=cIsDamage>14%</style> 증가하고 재사용 대기시간이 <style=cIsDamage>6%</style> 감소합니다. 각 스테이지 시작 시 재생성됩니다.",
    "EQUIPMENT_MULTISHOPCARD_NAME": "임원 카드",
    "EQUIPMENT_MULTISHOPCARD_PICKUP": "대상 상호작용 오브젝트를 해킹합니다. 해킹된 멀티샵은 열린 상태를 유지합니다.",
    "EQUIPMENT_MULTISHOPCARD_DESC": "상호작용 오브젝트를 대상으로 지정해 <style=cIsUtility>해킹</style>하여 내용물을 <style=cIsUtility>무료</style>로 잠금 해제합니다. 대상이 <style=cIsUtility>멀티샵</style> 터미널인 경우 다른 터미널도 <style=cIsUtility>열린 상태를 유지</style>합니다.",
    "ITEM_AUTOCASTEQUIPMENT_NAME": "익사자의 몸짓",
    "ITEM_AUTOCASTEQUIPMENT_PICKUP": "장비 충전 횟수가 크게 증가하지만... <style=cIsHealth>장비 재사용 대기시간도 크게 증가합니다.</style> 재사용 대기시간 중에도 장비를 사용할 수 있으나 <style=cIsHealth>파손될 확률이 있습니다.</style>",
    "ITEM_AUTOCASTEQUIPMENT_DESC": "<style=cIsUtility>추가 장비 충전 횟수 4회</style><style=cStack>(중첩당 +2)</style>를 보유하지만... <style=cIsHealth>장비 재사용 대기시간이 +100%</style><style=cStack>(중첩당 +50%)</style> 증가합니다. 충전 없이 장비를 사용하면 <style=cIsUtility>강제 시전</style>되어 사용할 수 있지만 <style=cIsHealth>40.0% 확률로 파손됩니다</style>. <style=cIsUtility>행운의 영향을 받지 않습니다.</style>",
    "ITEM_BONUSGOLDPACKONKILL_NAME": "고르의 고서",
    "ITEM_BONUSGOLDPACKONKILL_PICKUP": "접촉 시 엘리트 적을 황금으로 변환합니다.",
    "ITEM_BONUSGOLDPACKONKILL_DESC": "황금빛 엘리트에게 +100%의 피해를 입힙니다. 모든 엘리트 적과 접촉하면 즉시 황금빛 엘리트로 변환시키며 모든 처치 시 효과를 발동합니다. 보스 적에게는 효과가 없습니다.",
    "ITEM_SEED_NAME": "거머리 씨앗",
    "ITEM_FLATHEALTH_NAME": "신선한 고기",
    "ITEM_FLATHEALTH_PICKUP": "고정 체력을 얻습니다. 적을 처치한 후 체력을 재생합니다.",
    "ITEM_FLATHEALTH_DESC": "체력 25<style=cStack>(중첩당 +25)</style>를 얻습니다. 적을 처치한 후 <style=cIsUtility>3초</style><style=cStack>(중첩당 +3초)</style> 동안 <style=cIsHealing>기본 체력 재생</style>이 <style=cIsHealing>+2 hp/s</style> 증가합니다.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_NAME": "모닝 모카",
    "ITEM_ATTACKSPEEDANDMOVESPEED_PICKUP": "스테이지 시작 후 일시적인 속도 증가 효과를 얻습니다.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_DESC": "어느 스테이지든 진입 후 <style=cIsUtility>80</style>초 동안 <style=cIsDamage>공격 속도</style> 및 <style=cIsDamage>이동 속도</style>가 <style=cIsDamage>20%</style><style=cStack>(중첩당 +20%)</style> 증가하고 <style=cIsUtility>스킬 재사용 대기시간</style>이 <style=cIsUtility>-12%</style><style=cStack>(중첩당 -12%)</style> 감소합니다. 상호작용 오브젝트를 활성화하면 버프가 <style=cIsUtility>20초</style> 연장됩니다.",
    "ITEM_EXTRASTATSONLEVELUP_NAME": "염주",
    "ITEM_EXTRASTATSONLEVELUP_PICKUP": "<style=cIsHealing>고급</style> 3D 프린터에서 우선적으로 소모됩니다. 제거된 후 모든 능력치가 영구적으로 증가합니다.",
    "ITEM_EXTRASTATSONLEVELUP_DESC": "<style=cIsHealing>고급</style> 3D 프린터에서 우선적으로 소모됩니다. 제거된 후 영구적으로 <style=cIsUtility>경험치 획득량</style>, <style=cIsHealing>체력</style>, <style=cIsHealing>보호막</style>, <style=cIsHealing>체력 재생</style>, <style=cIsDamage>피해량</style>이 7% 증가합니다.",
    "ITEM_THORNS_NAME": "면도날 철사",
    "ITEM_THORNS_PICKUP": "피해를 입으면 출혈을 일으키는 면도날을 터뜨려 반격합니다. 시간이 지나면 재충전됩니다.",
    "ITEM_THORNS_DESC": "피격 시 면도날이 폭발하여 근처 최대 <style=cIsDamage>5.0</style><style=cStack>(중첩당 +2.0)</style>명의 적에게 <style=cIsDamage>출혈</style>을 일으키고 방출된 <style=cIsDamage>면도날 충전</style>당 <style=cIsDamage>400%</style>의 기본 피해를 입힙니다. 면도날 충전은 최대 2개<style=cStack>(중첩당 +1)</style>까지 보유할 수 있으며, 모두 <style=cIsUtility>5.0</style>초에 걸쳐 재장전됩니다.",
    "ITEM_INCREASEHEALING_NAME": "회춘의 선반",
    "ITEM_INCREASEHEALING_PICKUP": "초과 회복량을 나중에 사용하기 위해 저장합니다.",
    "ITEM_INCREASEHEALING_DESC": "최대 체력을 초과한 회복량을 <style=cIsHealing>50%</style><style=cStack>(중첩당 +50%)</style>의 효율로 최대 체력의 <style=cIsHealing>30%</style><style=cStack>(중첩당 +0%)</style>까지 <style=cIsHealing>치유 비축량</style>에 <style=cIsHealing>저장</style>합니다. 부상을 입으면 <style=cIsHealing>치유 비축량</style>이 빌 때까지 매초 <style=cIsHealing>체력</style>의 <style=cIsHealing>10%</style>를 회복합니다.",
    "ITEM_LASERTURBINE_NAME": "공명 원반",
    "ITEM_LASERTURBINE_PICKUP": "적을 처치하여 충전되는 공명 원반을 얻습니다. 완전히 충전되면 자동으로 발사됩니다.",
    "ITEM_LASERTURBINE_DESC": "적을 처치하면 공명 원반이 충전됩니다. 원반은 목표를 향해 날아가 <style=cIsDamage>300%</style><style=cStack>(중첩당 +300%)</style>의 기본 피해를 입히며 처치하지 못한 모든 적을 관통한 뒤, 폭발하여 <style=cIsDamage>1000%</style><style=cStack>(중첩당 +1000%)</style>의 기본 피해를 입힙니다. 그 후 사용자에게 돌아오며 경로상의 모든 적에게 <style=cIsDamage>300%</style><style=cStack>(중첩당 +300%)</style>의 기본 피해를 입힙니다.",
    "ITEM_SQUIDTURRET_NAME": "오징어 폴립",
    "ITEM_PARENTEGG_NAME": "플라눌라",
    "ITEM_PARENTEGG_PICKUP": "견줄 데 없는 태양의 힘!",
    "ITEM_PARENTEGG_DESC": "텔레포터 이벤트를 시작한 후 머리 위에 <style=cIsDamage>10.0</style>초<style=cStack>(중첩당 +5.0)</style> 동안 지속되는 <style=cIsDamage>태양을 소환</style>합니다. <style=cIsHealth>태양 근처의 모든 적과 아군이 불타오릅니다</style>.",
    "ITEM_FOCUSEDCONVERGENCE_NAME": "집중된 수렴",
    "ITEM_FOCUSEDCONVERGENCE_DESC": "점령 구역의 충전 속도가 <style=cIsUtility>100%<style=cStack>(중첩당 +100%)</style> 빨라지지만</style>, 크기가 <style=cIsHealth>50% 작아집니다</style><style=cStack>(중첩당 -50%)</style>. 최대 5개.",
    "ITEM_GHOSTONKILL_NAME": "가장 행복한 가면",
    "ITEM_GHOSTONKILL_PICKUP": "근처 적에게 빙의하여 처형 표식을 남깁니다. 적을 처형하면 유령을 소환합니다.",
    "ITEM_GHOSTONKILL_DESC": "보스가 아닌 무작위 적에게 <style=cIsDamage>빙의</style>하여 체력 <style=cIsHealth>25%</style> 미만 시 처형 표식을 남깁니다. 처형 시 처치된 적의 <style=cIsDamage>유령을 소환</style>하며, <style=cIsDamage>1500%</style>의 피해량으로 <style=cIsDamage>6.66초</style><style=cStack>(중첩당 +6.66초)</style> 동안 지속됩니다<style=cIsUtility>(빙의된 적의 경우 2배)</style>.",
    "ITEM_MOVESPEEDONKILL_NAME": "사냥꾼의 작살",
    "ITEM_MOVESPEEDONKILL_DESC": "적 처치 시 <style=cIsUtility>1</style><style=cStack>(중첩당 +1)</style>초 동안 <style=cIsUtility>이동 속도</style>가 <style=cIsUtility>125%</style> 증가합니다. 연속 처치 시 버프 지속 시간이 최대 25초까지 증가합니다.",
    "ITEM_STRENGTHENBURN_PICKUP": "점화 효과가 3배의 피해를 입힙니다.",
    "ITEM_STRENGTHENBURN_DESC": "<style=cIsDamage>점화 확률 15%</style>를 얻습니다. 모든 점화 효과의 피해량이 <style=cIsDamage>+200%</style><style=cStack>(중첩당 +200%)</style> 증가하고 지속 시간이 <style=cIsUtility>+200%</style><style=cStack>(중첩당 +200%)</style> 늘어납니다.",
    "DIFFICULTYSWANSONG_NAME": "Extinction",
    "DIFFICULTYSWANSONG_DESC": "오직 굳건한 의지를 지닌 진정한 피학성애자만을 위한 난이도.\n행성은 살아 있으며, 자신에게 가해진 만행에 대한 형언할 수 없는 증오로 몸부림치고 있습니다. 그 분노의 표적이 된 당신은 갈기갈기 찢겨 형체조차 알아볼 수 없게 될 것입니다. <style=cStack>\n\n>플레이어 체력 재생: <style=cArtifact>-40%</style></style> <style=cStack>\n>난이도 증가율: <style=cArtifact>+100%</style><style=cStack>\n>시작 난이도: <style=cArtifact>매우 어려움</style></style>\n>희귀 엘리트: <style=cArtifact>스테이지 4</style>\n>텔레포터 시각 효과: <style=cArtifact>꺼짐</style>\n>적이 <style=cArtifact>강화된 성장률</style> 획득\n>적이 <style=cArtifact>3배의 투사체</style> 획득</style>",
    "EXPANSION2R4R_NAME": "Swan Song",
    "EXPANSION2R4R_DESCRIPTION": "'Swan Song' 확장팩의 콘텐츠를 게임에 추가합니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_0": "{0}이(가) 콰광 하고 터졌습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_0_2P": "삼가고인의명복MGSGHBAB.",
    "PLAYER_DEATH_QUOTE_SWANSONG_1": "{0}은(는) 형편없는 밸런스 결정을 내렸습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_1_2P": "당신은 형편없는 밸런스 결정을 내렸습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_2": "{0}이(가) 납작하게 터졌습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_2_2P": "당신은 납작하게 터졌습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_3": "{0}이(가) 당해버렸습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_3_2P": "당해버렸습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_4": "{0}이(가) 즉흥 뇌엽 절제술을 받았습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_4_2P": "즉흥 뇌엽 절제술을 축하합니다!",
    "PLAYER_DEATH_QUOTE_SWANSONG_5": "{0}의 내장이 외장이 되었습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_5_2P": "당신의 내장이 외장이 되었습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_6": "{0}의 죽음에 대한 간청이 응답받았습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_6_2P": "당신의 죽음에 대한 간청이 응답받았습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_7": "{0}은(는) 날씨 탓을 하고 있습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_7_2P": "그냥 바람이었을 겁니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_8": "{0}은(는) 부끄러운 유언을 남겼습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_8_2P": "엘리트 폭력도 포함해서 세는 건가요, 아닌가요?",
    "PLAYER_DEATH_QUOTE_SWANSONG_9": "{0}은(는) 완전히 망했습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_9_2P": "폭망!",
    "PLAYER_DEATH_QUOTE_SWANSONG_10": "{0}은(는) 설정을 바꾸고 싶어 합니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_10_2P": "어쩌면 그건 설정으로 바꿀 수 있지 않을까요?",
    "PLAYER_DEATH_QUOTE_SWANSONG_11": "{0}은(는) 잠시 쉬어야 한다고 제안합니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_11_2P": "휴식을 취하는 것을 잊지 마세요.",
    "PLAYER_DEATH_QUOTE_SWANSONG_12": "{0}은(는) 물 한 잔 마시고 싶어 합니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_12_2P": "물 마시는 것을 잊지 마세요.",
    "PLAYER_DEATH_QUOTE_SWANSONG_13": "{0}은(는) 거기까지 계산하지 못했습니다.",
    "PLAYER_DEATH_QUOTE_SWANSONG_13_2P": "거기까지 계산하지 못했나요?",
    "PLAYER_DEATH_QUOTE_SWANSONG_14": "{0}이(가) 살해당했습니다..",
    "PLAYER_DEATH_QUOTE_SWANSONG_14_2P": "당신은 살해당했습니다..",
    "PLAYER_DEATH_QUOTE_SWANSONG_15": "{0}은(는) 충분히 푸르지 못했습니다..",
    "PLAYER_DEATH_QUOTE_SWANSONG_15_2P": "당신은 충분히 푸르지 못했습니다..",
    "OBJECTIVE_SHELTER": "폭풍으로부터 <style=cDeath>피난처 <sprite name=\"TP\" tint=1></style>를 찾으세요!",
    "OBJECTIVE_WISHBONE": "<style=cIsDamage>위시본</style> 수집",
    "OBJECTIVE_METEORDEFAULT_2R4R": "유성 폭풍 임박",
    "OBJECTIVE_LIGHTNING_2R4R": "뇌우 임박",
    "OBJECTIVE_FIRE_2R4R": "화염 폭풍 임박",
    "OBJECTIVE_COLD_2R4R": "눈보라 임박",
    "SHRINE_LUNARGALLERY_USE_MESSAGE_2P": "<style=cShrine>당신은 전투에 <style=cIsLunar>{1}</style>을(를) 불러냈습니다.</color>",
    "SHRINE_LUNARGALLERY_USE_MESSAGE": "<style=cShrine>{0}이(가) 전투에 <style=cIsLunar>{1}</style>을(를) 불러냈습니다.</color>",
    "SHRINE_CONVERGE_USE_MESSAGE": "당신은 수렴의 도전을 불러왔습니다..",
    "SHRINE_CONVERGE_USE_MESSAGE_2P": "{0}이(가) 수렴의 도전을 불러왔습니다..",
    "SHRINE_CONVERGE_BEGIN_MESSAGE": "수렴의 도전을... 시작합니다!",
    "ITEM_DISCOUNTCARDUSED_NAME": "쿠폰 (사용됨)",
    "ITEM_DISCOUNTCARDUSED_PICKUP": "상점 터미널에서 현금을 환급받고 열린 상태를 유지합니다. 1회 사용 남음.",
    "ITEM_DISCOUNTCARDUSED_DESCRIPTION": "<style=cIsUtility>멀티샵</style> 터미널에서 구매 시, 다른 터미널이 <style=cIsUtility>열린 상태를 유지</style>하며 <style=cIsUtility>$20</style>를 환급받습니다. 1회 사용 남음.",
    "ITEM_DISCOUNTCARDSPENT_NAME": "쿠폰 (소진됨)",
    "ITEM_DISCOUNTCARDSPENT_PICKUP": "구멍이 숭숭 뚫린 종이 조각일 뿐입니다.",
    "ITEM_DISCOUNTCARDSPENT_DESCRIPTION": "구멍이 숭숭 뚫린 종이 조각일 뿐입니다.",
    "ITEM_BROKENSCALPEL_NAME": "부러진 메스",
    "ITEM_BROKENSCALPEL_PICKUP": "칼날이 수없이 많은 조각으로 산산조각 났습니다.",
    "ITEM_BROKENSCALPEL_DESCRIPTION": "더 이상 사용할 수 없습니다.",
    "ITEM_GAMMAKNIFESTATBOOST_NAME": "가짜 영혼 버터",
    "ITEM_GAMMAKNIFESTATBOOST_PICKUP": "피부를 가르고 진실을 구부리세요...",
