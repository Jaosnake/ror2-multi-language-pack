    "BORBO_ELITE_AFFIX_SQUALL_MODIFIER": "怒号{0}",
    "ARTIFACT_AWESOMEPOT_NAME": "易爆神器",
    "ARTIFACT_AWESOMEPOT_DESCRIPTION": "爆炸桶和罐子变为精英级。",
    "ARTIFACT_FREELUNAR_NAME": "狂热者神器",
    "ARTIFACT_FREELUNAR_DESCRIPTION": "每局游戏开始时携带一件随机月球物品。每关结束时必定出现蓝色传送门。",
    "ARTIFACT_QUICKSTART_NAME": "死胎神器",
    "ARTIFACT_QUICKSTART_DESCRIPTION": "每局游戏开始时自选一件稀有（绿色）物品。",
    "ARTIFACT_RISKIERRAINSPIRIT_NAME": "精神神器",
    "ARTIFACT_RISKIERRAINSPIRIT_DESCRIPTION": "生命值越低，角色的移动和攻击速度越快。",
    "ITEM_BARRIERONOVERHEAL_NAME": "宙斯盾",
    "ITEM_BARRIERONOVERHEAL_PICKUP": "进行任何交互时获得屏障。脱离危险时，屏障停止衰减。",
    "ITEM_BARRIERONOVERHEAL_DESC": "使用任何可交互物会获得<style=cIsHealing>40.0点生命值</style><style=cStack>（每层+40.0）</style>外加<style=cIsHealing>最大生命值</style>的<style=cIsHealing>10.0%</style>的<style=cIsHealing>临时屏障</style>。处于危险之外时，<style=cIsUtility>屏障不会衰减</style>。",
    "ITEM_GOLDONHIT_NAME": "沉没王冠",
    "ITEM_GOLDONHIT_PICKUP": "从宝箱中偷窃…<style=cIsHealth>以生命值为代价。</style>",
    "ITEM_GOLDONHIT_DESC": "允许在金钱不足时与宝箱交互，<style=cIsUtility>不花费任何金钱</style>打开宝箱。从宝箱偷窃会根据宝箱大小消耗你<style=cIsHealth>最大生命值</style>的<style=cIsHealth>[ 25% / 50% / 80% ]</style>。每关最多可偷窃1<style=cStack>（每层+1）</style>次。",
    "ITEM_REGENERATINGSCRAP_NAME": "奇美拉废料",
    "ITEM_REGENERATINGSCRAP_PICKUP": "在<style=cIsHealth>任何</style>3D打印机中都会被优先消耗。产出额外数量的低阶物品。",
    "ITEM_REGENERATINGSCRAP_DESC": "没有任何效果。在<style=cIsHealth>任何</style>3D打印机中都会被优先消耗。<style=cIsUtility>根据打印机的品质</style>生成<style=cStack>(</style> 10 <style=cStack>/</style> <style=cIsHealing>5</style> <style=cStack>/</style> <style=cIsHealth>2</style> <style=cStack>)</style>件物品。",
    "ITEM_GOLDONHURT_NAME": "巧克力金币",
    "ITEM_GOLDONHURT_PICKUP": "敌人会掉落提供金币和治疗的糖果。随时间充能。",
    "ITEM_GOLDONHURT_DESC": "击中时掉落一枚巧克力金币，恢复<style=cIsHealing>5.0点生命值</style><style=cStack>（每层+5.0）</style>并提供<style=cIsUtility>1金币</style><style=cStack>（每层+1）</style>。<style=cIsUtility>随时间成长</style>。<style=cIsUtility>5.0秒后重新充能。</style>",
    "ITEM_CRITDAMAGE_NAME": "战斗望远镜",
    "ITEM_CRITDAMAGE_PICKUP": "静止时提高“暴击”几率和伤害。",
    "ITEM_CRITDAMAGE_DESC": "<style=cIsDamage>暴击</style>额外造成<style=cIsDamage>100%伤害</style><style=cStack>（每层+100%）</style>。静止站立<style=cIsUtility>0.2</style>秒后获得<style=cIsDamage>30%暴击率</style>。",
    "ITEM_REPEATHEAL_NAME": "尸花",
    "ITEM_REPEATHEAL_PICKUP": "你的生命值随时间衰减。低生命值时获得屏障和幸运。",
    "ITEM_REPEATHEAL_DESC": "每损失12.5%生命值，获得1层腐朽。累计3层腐朽后，基础伤害提高4<style=cStack>（每层+2）</style>。达到6层腐朽时，获得50%屏障且幸运提高2<style=cStack>（每层+2）</style>。<style=cIsHealth>基础生命再生降低-2 生命/秒</style><style=cStack>（每层-2）</style>。",
    "ITEM_HEALINGPOTION_NAME": "狂战士之酿",
    "ITEM_HEALINGPOTION_PICKUP": "低生命值时获得屏障、清除减益并重置所有冷却时间。每关可使用一次。",
    "ITEM_HEALINGPOTION_DESC": "受到伤害使生命值低于<style=cIsHealth>25%</style>时<style=cIsUtility>消耗</style>此物品，立即获得相当于最大生命值<style=cIsHealing>35%</style>的<style=cIsHealing>屏障</style>并<style=cIsUtility>重置</style>所有冷却时间。每个空瓶使攻击速度提高<style=cIsDamage>15%</style>、移动速度提高<style=cIsDamage>14%</style>，并使冷却时间缩短<style=cIsDamage>6%</style>。每关开始时重新生成。",
    "EQUIPMENT_MULTISHOPCARD_NAME": "行政卡",
    "EQUIPMENT_MULTISHOPCARD_PICKUP": "黑入一个目标可交互物。被黑入的多选商店会保持开启。",
    "EQUIPMENT_MULTISHOPCARD_DESC": "瞄准一个可交互物并将其<style=cIsUtility>黑入</style>，<style=cIsUtility>免费</style>解锁其中内容。若目标为<style=cIsUtility>多选商店</style>终端，其余终端将<style=cIsUtility>保持开启</style>。",
    "ITEM_AUTOCASTEQUIPMENT_NAME": "溺水者的手势",
    "ITEM_AUTOCASTEQUIPMENT_PICKUP": "大幅增加装备充能次数…<style=cIsHealth>但大幅延长装备冷却时间。</style>可在冷却期间强行激活装备，<style=cIsHealth>但有几率损坏。</style>",
    "ITEM_AUTOCASTEQUIPMENT_DESC": "可额外持有<style=cIsUtility>4次装备充能</style><style=cStack>（每层+2）</style>…<style=cIsHealth>但装备冷却时间延长+100%</style><style=cStack>（每层+50%）</style>。在没有充能时使用装备会<style=cIsUtility>透支施放</style>，允许使用但<style=cIsHealth>有40.0%几率损坏</style>。<style=cIsUtility>不受幸运值影响。</style>",
    "ITEM_BONUSGOLDPACKONKILL_NAME": "戈尔之书",
    "ITEM_BONUSGOLDPACKONKILL_PICKUP": "接触时将精英敌人转化为黄金。",
    "ITEM_BONUSGOLDPACKONKILL_DESC": "对镀金精英造成+100%伤害。接触任何精英敌人会立即将其转化为镀金精英，并触发所有击杀时效果。对首领敌人无效。",
    "ITEM_SEED_NAME": "吸血种子",
    "ITEM_FLATHEALTH_NAME": "新鲜肉块",
    "ITEM_FLATHEALTH_PICKUP": "获得固定生命值。击杀敌人后再生生命值。",
    "ITEM_FLATHEALTH_DESC": "获得25<style=cStack>（每层+25）</style>点生命值。击杀敌人后，在<style=cIsUtility>3秒</style><style=cStack>（每层+3秒）</style>内使<style=cIsHealing>基础生命再生</style>提高<style=cIsHealing>+2 生命/秒</style>。",
    "ITEM_ATTACKSPEEDANDMOVESPEED_NAME": "清晨摩卡",
    "ITEM_ATTACKSPEEDANDMOVESPEED_PICKUP": "进入关卡后获得临时速度提升。",
    "ITEM_ATTACKSPEEDANDMOVESPEED_DESC": "进入任意关卡后的<style=cIsUtility>80</style>秒内，<style=cIsDamage>攻击速度</style>和<style=cIsDamage>移动速度</style>提高<style=cIsDamage>20%</style><style=cStack>（每层+20%）</style>，<style=cIsUtility>技能冷却时间</style>缩短<style=cIsUtility>-12%</style><style=cStack>（每层-12%）</style>。激活可交互物会使该增益延长<style=cIsUtility>20秒</style>。",
    "ITEM_EXTRASTATSONLEVELUP_NAME": "念珠",
    "ITEM_EXTRASTATSONLEVELUP_PICKUP": "在<style=cIsHealing>稀有</style>3D打印机中会被优先消耗。消耗后永久提高所有属性。",
    "ITEM_EXTRASTATSONLEVELUP_DESC": "在<style=cIsHealing>稀有</style>3D打印机中会被优先消耗。消耗后，永久使<style=cIsUtility>经验获取</style>、<style=cIsHealing>生命值</style>、<style=cIsHealing>护盾</style>、<style=cIsHealing>生命再生</style>和<style=cIsDamage>伤害</style>提高7%。",
    "ITEM_THORNS_NAME": "剃刀铁丝网",
    "ITEM_THORNS_PICKUP": "受伤时爆发一圈造成流血的剃刀进行反击。随时间充能。",
    "ITEM_THORNS_DESC": "受击时爆发剃刀，使附近最多<style=cIsDamage>5.0</style><style=cStack>（每层+2.0）</style>名敌人<style=cIsDamage>流血</style>，每消耗一层<style=cIsDamage>剃刀充能</style>造成<style=cIsDamage>400%</style>基础伤害。最多可持有2<style=cStack>（每层+1）</style>层剃刀充能，全部会在<style=cIsUtility>5.0</style>秒内重新装填。",
    "ITEM_INCREASEHEALING_NAME": "恢复架",
    "ITEM_INCREASEHEALING_PICKUP": "储存过量治疗以备后用。",
    "ITEM_INCREASEHEALING_DESC": "超过满生命值的治疗会以<style=cIsHealing>50%</style><style=cStack>（每层+50%）</style>的效率<style=cIsHealing>储存</style>在<style=cIsHealing>治疗储备</style>中，最高可达最大生命值的<style=cIsHealing>30%</style><style=cStack>（每层+0%）</style>。受伤时，从<style=cIsHealing>治疗储备</style>中提取并每秒恢复<style=cIsHealing>生命值</style>的<style=cIsHealing>10%</style>，直至储备耗尽。",
    "ITEM_LASERTURBINE_NAME": "共鸣圆盘",
    "ITEM_LASERTURBINE_PICKUP": "获得一个通过击杀敌人充能的共鸣圆盘。充满时自动发射。",
    "ITEM_LASERTURBINE_DESC": "击杀敌人会为共鸣圆盘充能。圆盘会射向目标造成<style=cIsDamage>300%</style><style=cStack>（每层+300%）</style>基础伤害，穿透所有未能击杀的敌人，随后爆炸造成<style=cIsDamage>1000%</style><style=cStack>（每层+1000%）</style>基础伤害。接着返回使用者身边，对沿途所有敌人造成<style=cIsDamage>300%</style><style=cStack>（每层+300%）</style>基础伤害。",
    "ITEM_SQUIDTURRET_NAME": "鱿鱼珊瑚虫",
    "ITEM_PARENTEGG_NAME": "浮浪幼虫",
    "ITEM_PARENTEGG_PICKUP": "无与伦比的太阳之力！",
    "ITEM_PARENTEGG_DESC": "开启传送门事件后，在头顶<style=cIsDamage>召唤一颗太阳</style>，持续<style=cIsDamage>10.0</style>秒<style=cStack>（每层+5.0）</style>。<style=cIsHealth>太阳附近的所有敌人和友军都会被点燃</style>。",
    "ITEM_FOCUSEDCONVERGENCE_NAME": "聚焦汇聚",
    "ITEM_FOCUSEDCONVERGENCE_DESC": "占领区域充能速度<style=cIsUtility>加快100%<style=cStack>（每层+100%）</style></style>，但范围<style=cIsHealth>缩小50%</style><style=cStack>（每层-50%）</style>。最多叠加5层。",
    "ITEM_GHOSTONKILL_NAME": "鬼脸面具",
    "ITEM_GHOSTONKILL_PICKUP": "缠绕附近的敌人，将其标记为可处决。处决敌人会召唤幽灵。",
    "ITEM_GHOSTONKILL_DESC": "<style=cIsDamage>缠绕</style>一名随机的非首领敌人，在生命值低于<style=cIsHealth>25%</style>时将其标记为可处决。处决会<style=cIsDamage>召唤被击杀敌人的幽灵</style>，拥有<style=cIsDamage>1500%</style>伤害，持续<style=cIsDamage>6.66秒</style><style=cStack>（每层+6.66秒）</style><style=cIsUtility>（对被缠绕的敌人翻倍）</style>。",
    "ITEM_MOVESPEEDONKILL_NAME": "猎人的鱼叉",
    "ITEM_MOVESPEEDONKILL_DESC": "击杀敌人使<style=cIsUtility>移动速度</style>提高<style=cIsUtility>125%</style>，持续<style=cIsUtility>1</style><style=cStack>（每层+1）</style>秒。连续击杀最多可将增益持续时间延长至25秒。",
    "ITEM_STRENGTHENBURN_PICKUP": "你的点燃效果造成三倍伤害。",
    "ITEM_STRENGTHENBURN_DESC": "获得<style=cIsDamage>15%点燃几率</style>。所有点燃效果造成的伤害提高<style=cIsDamage>+200%</style><style=cStack>（每层+200%）</style>，持续时间延长<style=cIsUtility>+200%</style><style=cStack>（每层+200%）</style>。",
    "DIFFICULTYSWANSONG_NAME": "Extinction",
    "DIFFICULTYSWANSONG_DESC": "献给真正意志坚定与纯粹的受虐狂。\n这颗星球是活着的，正因自身所遭受的暴行而怀着无法言喻的憎恨剧烈扭动。作为它狂怒的目标，你将被撕成碎片，变得面目全非。<style=cStack>\n\n>玩家生命再生：<style=cArtifact>-40%</style></style> <style=cStack>\n>难度成长：<style=cArtifact>+100%</style><style=cStack>\n>初始难度：<style=cArtifact>非常困难</style></style>\n>稀有精英：<style=cArtifact>第4关</style>\n>传送门视觉提示：<style=cArtifact>关闭</style>\n>敌人获得<style=cArtifact>强化成长</style>\n>敌人获得<style=cArtifact>三倍投射物</style></style>",
    "EXPANSION2R4R_NAME": "Swan Song",
    "EXPANSION2R4R_DESCRIPTION": "将“Swan Song”扩展包的内容添加到游戏中。",
    "PLAYER_DEATH_QUOTE_SWANSONG_0": "{0} 轰然炸裂了。",
    "PLAYER_DEATH_QUOTE_SWANSONG_0_2P": "安息吧MGSGHBAB。",
    "PLAYER_DEATH_QUOTE_SWANSONG_1": "{0} 做出了一个糟糕的平衡性决定。",
    "PLAYER_DEATH_QUOTE_SWANSONG_1_2P": "你做出了一个糟糕的平衡性决定。",
    "PLAYER_DEATH_QUOTE_SWANSONG_2": "{0} 被拍扁了。",
    "PLAYER_DEATH_QUOTE_SWANSONG_2_2P": "你被拍扁了。",
    "PLAYER_DEATH_QUOTE_SWANSONG_3": "{0} 被拿下了。",
    "PLAYER_DEATH_QUOTE_SWANSONG_3_2P": "被拿下了吧。",
    "PLAYER_DEATH_QUOTE_SWANSONG_4": "{0} 被自发性脑白质切除术了。",
    "PLAYER_DEATH_QUOTE_SWANSONG_4_2P": "恭喜你完成了自发性脑白质切除术！",
    "PLAYER_DEATH_QUOTE_SWANSONG_5": "{0} 的内脏变成了外脏。",
    "PLAYER_DEATH_QUOTE_SWANSONG_5_2P": "你的内脏变成了外脏。",
    "PLAYER_DEATH_QUOTE_SWANSONG_6": "{0} 的求死祈祷得到了回应。",
    "PLAYER_DEATH_QUOTE_SWANSONG_6_2P": "你的求死祈祷得到了回应。",
    "PLAYER_DEATH_QUOTE_SWANSONG_7": "{0} 把锅甩给了天气。",
    "PLAYER_DEATH_QUOTE_SWANSONG_7_2P": "一定是风吹的。",
    "PLAYER_DEATH_QUOTE_SWANSONG_8": "{0} 留下了尴尬的遗言。",
    "PLAYER_DEATH_QUOTE_SWANSONG_8_2P": "算不算精英暴力的账？",
    "PLAYER_DEATH_QUOTE_SWANSONG_9": "{0} 彻底扑街了。",
    "PLAYER_DEATH_QUOTE_SWANSONG_9_2P": "扑街了！",
    "PLAYER_DEATH_QUOTE_SWANSONG_10": "{0} 想修改配置。",
    "PLAYER_DEATH_QUOTE_SWANSONG_10_2P": "也许那玩意儿可以在配置里改？",
    "PLAYER_DEATH_QUOTE_SWANSONG_11": "{0} 建议大家休息一下。",
    "PLAYER_DEATH_QUOTE_SWANSONG_11_2P": "记得适当休息。",
    "PLAYER_DEATH_QUOTE_SWANSONG_12": "{0} 想去喝口水。",
    "PLAYER_DEATH_QUOTE_SWANSONG_12_2P": "记得多喝水。",
    "PLAYER_DEATH_QUOTE_SWANSONG_13": "{0} 没把那事算进去。",
    "PLAYER_DEATH_QUOTE_SWANSONG_13_2P": "没把那事算进去吗？",
    "PLAYER_DEATH_QUOTE_SWANSONG_14": "{0} 被击杀了..",
    "PLAYER_DEATH_QUOTE_SWANSONG_14_2P": "你被击杀了..",
    "PLAYER_DEATH_QUOTE_SWANSONG_15": "{0} 还不够绿..",
    "PLAYER_DEATH_QUOTE_SWANSONG_15_2P": "你还不够绿..",
