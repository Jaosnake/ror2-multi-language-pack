    "POPCORN_LEE_HYPERREAL_BODY_YI_SKIN_NAME": "Yi",
    "POPCORN_LEE_HYPERREAL_BODY_BK_SKIN_NAME": "Boykisser",
    "POPCORN_LEE_HYPERREAL_BODY_PASSIVE_ORB_AND_AMMO_NAME": "Kugel- und Munitionssystem",
    "POPCORN_LEE_HYPERREAL_BODY_PASSIVE_ORB_AND_AMMO_DESCRIPTION": "Lee: Hyperreal verwendet <style=cIsUtility>[Orbs]</style>, die die Ausführung einzigartiger Fähigkeiten ermöglichen. Sein <style=cIsUtility>[Munitionszähler]</style> gewährt einzigartige Effekte für <style=cIsUtility>[Scharfschützenhaltung]</style>.",
    "POPCORN_LEE_HYPERREAL_BODY_PASSIVE_DOMAIN_NAME": "Hypermatrix-System",
    "POPCORN_LEE_HYPERREAL_BODY_PASSIVE_DOMAIN_DESCRIPTION": "Lee: Hyperreal hat Zugriff auf die <style=cIsUtility>[Hypermatrix]</style>, wenn die Primärtaste gedrückt gehalten wird und die <style=cIsUtility>[Leistungsanzeige]</style> voll ist. Lee: Hyperreal erhält mehr Treffer statt Angriffsgeschwindigkeit, die Scharfschützenhaltung skaliert jedoch normal.",
    "POPCORN_LEE_HYPERREAL_BODY_PASSIVE_VFX_COLOR_NAME": "VFX-Farbe",
