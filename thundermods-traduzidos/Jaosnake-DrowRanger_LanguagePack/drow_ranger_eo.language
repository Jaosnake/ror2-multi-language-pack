{
    "eo": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Frosta Pafarkisto",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Terura Reprezalio",
        "DROWRANGER_DESCRIPTION": "Drow Ranger elstaras je kontrolo de distanco kaj trarompo de malamikaj defendoj per mortigaj sagoj.<style=cSub>\n\n< ! >Tenu malamikojn je distanco por plej bone utiligi Pafarton. Sxiaj sagoj flugas malrapide, do celu zorge por trafi malproksimajn celojn.\n\n< ! >Frostaj Sagoj malrapidigas dangxerajn malamikojn. Hipotermio transformas amasojn en cxenajn eksplodojn.\n\n< ! >Ventopusxo kreas spacon por retretigi, dum Glaciejo provizas provizoran altan pozicion.\n\n< ! >Elektu ekskluzivan relikvon por plibonigi vian atingodistancon, postvivadon aux kritikajn frapojn.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex lasas la frostigitajn dezertojn malantauxe.",
        "DROWRANGER_OUTRO_FAILURE": "La frosto postulas alian cxasiston.",
        "DROWRANGER_RELIC_TITLE": "Ekskluziva Relikvo",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Primaraj sagoj kauxzas plenan damagxon ene de <style=cIsUtility>50m</style>, retenante <style=cIsDamage>75%</style> preter <style=cIsUtility>100m</style>. Trafoj <style=cIsUtility>repusxas</style> ne-estrajn malamikojn ene de <style=cIsUtility>12m</style>. Cxiuj sagaj projektiloj flugas <style=cIsUtility>50% pli rapide</style>.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Pliigas atakrapidecon je <style=cIsDamage>20%</style>. Donas <style=cIsHealing>30%-an sxancon bloki damagxon</style>. Kumuligxas kun Pli Malfacilaj Tempoj kun malkreskantaj rendimentoj.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Donas <style=cIsDamage>30%-an kritikan frapchancecon</style>. Kritikaj frapoj kauxzas <style=cIsDamage>225% da damagxo</style>, antaux aliaj kritikaj damagxaj gratifikoj.",
        "DROWRANGER_PRIMARY_NAME": "Frostaj Sagoj",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Frosto</style>. Pafu sagon por <style=cIsDamage>260% da damagxo</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Hipotermio",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Hipotermio</style>. Pafu sagon por <style=cIsDamage>260% da damagxo</style>. Trafitoj eksplodas cxe morto.",
        "DROWRANGER_SECONDARY_NAME": "Multobla Pafo",
        "DROWRANGER_SECONDARY_DESC": "Pafu <style=cIsDamage>3 ondojn</style> de trapikantaj sagoj por <style=cIsDamage>3x360% da damagxo</style>. Cxiu ondo aplikas vian elektitan sagan efikon. Atakrapideco mallongigas la kanalan dauxron je duona efikeco.",
        "DROWRANGER_UTILITY_NAME": "Ventopusxo",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Stuporigante</style>. Liberigu ventopusxon kiu <style=cIsUtility>repusxas malamikojn</style> kaj aplikas <style=cIsUtility>3 stakojn</style> de via saga efiko. Ricevu <style=cIsUtility>50%-an movrapidecon</style> dum <style=cIsUtility>4s</style>, kaj resaltu malantauxen se vi ne sprintas.",
        "DROWRANGER_GLACIER_NAME": "Glaciejo",
        "DROWRANGER_GLACIER_DESC": "Levu altan <style=cIsUtility>glaciejon</style> sub vi dum <style=cIsUtility>8s</style>, levante vin al gxia supro kaj <style=cIsUtility>repusxante proksimajn malamikojn</style>.",
        "DROWRANGER_SPECIAL_NAME": "Pafarto",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Pasiva</style>: Sen malamikoj ene de <style=cIsUtility>15m</style>, primaraj sagoj havas <style=cIsDamage>30%-an</style> sxancon igxi <style=cIsDamage>kiras-penetraj sagoj</style> por <style=cIsDamage>390% da damagxo</style>.\n<style=cIsUtility>Aktivigo</style>: Pliigu cxi tiun sxancon al <style=cIsDamage>100%</style> dum <style=cIsUtility>5s</style>, aux al <style=cIsDamage>50%</style> cxe proksimaj malamikoj.",
        "DROWRANGER_WINTER_NAME": "Vintra Frapo",
        "DROWRANGER_WINTER_DESC": "Mallonge strecxu la arkon, poste pafu <style=cIsDamage>kiras-penetran sagon</style> por <style=cIsDamage>1600% da damagxo</style>, trapikante gxis <style=cIsDamage>5 malamikojn</style> kaj aplikante <style=cIsUtility>10 stakojn</style> de via saga efiko. La strecxado ne povas esti nuligita propravole.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Frosto</style><style=cSub>Reduktas restantan movrapidecon je 15% po stako dum 3s. Stakigxas gxis 10 fojojn. Trafoj refresxigas cxiujn stakojn. Ne plene frostigas malamikojn.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Hipotermio</style><style=cSub>Stakigxas gxis 10 fojojn dum 7s. Cxe morto, eksplodas por 150%–600% da damagxo en radiuso de 2–12m laux stakoj. Eksplodoj disvastigas Hipotermion kaj povas cxeni. Ne malrapidigas malamikojn.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Saga distanco</style><style=cSub>Primara saga damagxo falas preter 40m, retenante 60% cxe 80m. Hurricane Pike etendas cxi tiun distancon.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Kiras-penetra</style><style=cSub>Ignoras pozitivan kirason. Povas kauxzi kritikan frapon kaj retenas la elektitan sagan efikon.</style>"
    }
}