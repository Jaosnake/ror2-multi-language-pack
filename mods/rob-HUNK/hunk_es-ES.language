    "ROB_HUNK_WEAPON_STICKYBOMB_DESC": "",
    "ROB_HUNK_WEAPON_BEHEMOTH_NAME": "Behemoth Brillante",
    "ROB_HUNK_WEAPON_BEHEMOTH_DESC": "",
    "ROB_HUNK_WEAPON_ATM4_NAME": "ATM-4",
    "ROB_HUNK_WEAPON_ATM4_DESC": "Un lanzacohetes sin retroceso que dispara proyectiles de 84mm. El poder perforante del cohete provoca más daño que la explosión.",
