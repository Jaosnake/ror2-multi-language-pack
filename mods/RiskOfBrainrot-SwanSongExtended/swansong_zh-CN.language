    "2R4R_INTERACTABLE_WISHBONECARCASS_CONTEXT": "折断预兆",
    "EQUIPMENT_BROKENZAPINATOR_NAME": "橙色电击枪",
    "EQUIPMENT_BROKENZAPINATOR_PICKUP": "<style=cIsUtility>真不敢相信我们居然把这个留在了游戏里！</style>",
    "EQUIPMENT_BROKENZAPINATOR_DESCRIPTION": "发射一枚弹丸。",
    "EQUIPMENT_NINJAGEAR_NAME": "忍者大师装备",
    "EQUIPMENT_NINJAGEAR_PICKUP": "有几率闪避来袭攻击。激活时向前冲刺并投下烟雾弹。",
    "EQUIPMENT_NINJAGEAR_DESCRIPTION": "激活时<style=cIsUtility>向前冲刺25米</style>，并获得<style=cIsHealing>20%几率</style><style=cIsHealing>闪避</style>来袭攻击。冲刺和闪避时都会投下一枚<style=cIsDamage>烟雾弹</style>，使13米内的敌人<style=cIsUtility>眩晕</style><style=cIsUtility>1秒</style>。",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_NAME": "死胎祈祷",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_PICKUP": "实现一个愿望…",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_DESCRIPTION": "自选一件稀有（绿色）物品。",
    "EQUIPMENT_THEMACHINE_NAME": "机器",
    "EQUIPMENT_THEMACHINE_PICKUP": "它什么都不做。这正是它的美妙之处！",
    "EQUIPMENT_THEMACHINE_DESCRIPTION": "它什么都不做。这正是它的美妙之处！",
    "EQUIPMENT_TESLAEQUIPMENT_NAME": "异常稳定的特斯拉线圈",
    "EQUIPMENT_TESLAEQUIPMENT_PICKUP": "电击附近的敌人，并在击杀时恢复护盾。",
    "EQUIPMENT_TESLAEQUIPMENT_DESCRIPTION": "使自己<style=cIsUtility>带电</style>，持续<style=cIsUtility>10.0秒</style>。<style=cIsUtility>带电</style>期间击杀敌人会电击附近<style=cIsDamage>4.0</style>名敌人，造成<style=cIsDamage>200%伤害</style>并<style=cIsHealing>恢复15%护盾</style>。被动获得相当于<style=cIsHealing>最大生命值20%</style>的<style=cIsHealing>护盾</style>。",
    "EQUIPMENT_TESLAEQUIPMENT_LORE": "<style=cMono>特斯拉演示软件 v1.14\n正在启动...\n10...</style>\n正在发布欢迎辞...\n<style=cMono>9...</style>\n欢迎各位的到来！\n<style=cMono>8...</style>\n请入座。\n<style=cMono>7...</style>\n请确保后排的观众也能看清。\n<style=cMono>6...</style>\n演示即将开始。\n<style=cMono>5...</style>\n为了您的安全，请服从工作人员安排。\n<style=cMono>4...\n正在启动室内氛围灯光...\n3...</style>\n准备好见证…\n<style=cMono>2...</style>\n电力的…\n<style=cMono>1...</style>\n神奇奇迹吧！\n<style=cMono>检测到电力异常...\n将于10.0秒后启动重启程序...</style>",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_NAME": "奇尔的节拍",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_PICKUP": "化身为速度之相。",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_DESCRIPTION": "提高移动速度、攻击速度和技能充能速度。",
    "BORBO_ELITE_AFFIX_SPEED_MODIFIER": "神圣{0}",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_NAME": "碎裂信仰",
