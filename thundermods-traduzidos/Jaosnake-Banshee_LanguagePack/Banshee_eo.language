{
  "eo": {
    "KENKO_BANSHEE_NAME": "Banshee",
    "KENKO_BANSHEE_DESCRIPTION": "Banshee estas aera transvivanto, kiu elstaras en enirado kaj elirado de proksima batalo.<color=#CCD3E0>\n\n< ! > La ATK Ombrelo svingigxas malrapide, sed estas bonega maniero levigxi en la aeron. Vi ankaux povas svingi gxin dum sxvebado, kiam neniu malamiko estas spurata.\n\n< ! > Kolekti sxargojn de Plongxbombo antaux ol liberigi gxin povas kauxzi detruan damagxon en gxia ideala trafpunkto.\n\n< ! > La HDN Pusxiloj povas konsiderinde pligrandigi la aeran movigxemon de Banshee - uzu ilin sxpareme por eviti mortigajn malamikajn projektilojn.\n\n< ! > La CAL Grenado estas bonega por kunigi malamikojn - provu celi vian Plongxbombon al gxia centro por maksimuma efikeco!\n\n</color>",
    "KENKO_BANSHEE_SUBTITLE": "Antauxanoncanto de la Transa Domo",
    "KENKO_BANSHEE_LORE": "Dum iloj farigxas armiloj, novaj fortoj levigxis ene de la strikta hierarkio de la Transa Domo por \"eksperimenti\" per siaj novaj teknologioj. Inter cxi tiuj fortoj, la Banshee-oj dominas en aeraj armiloj per siaj FLT Ombreloj. Per la kapablo alvoki vagfajrojn kaj kolapsigi graviton, ilia detrua povo estas senfina. En la estonteco, la Transa Domo esperas perfektigi siajn dezajnojn preter la suno kaj la luno.",
    "KENKO_BANSHEE_OUTRO_FLAVOR": "..kaj tiel sxi foriris, sxiaj flustroj ehxantaj tra la eterneco.",
    "KENKO_BANSHEE_OUTRO_FAILURE": "..kaj tiel sxi malaperis, ehxigante surdigan silenton.",
    "KENKO_BANSHEE_PASSIVE_NAME": "FLT Ombrelo",
    "KENKO_BANSHEE_PASSIVE_DESCRIPTION": "Teni la saltoklavon igas Banshee sxvebi en la aero. Dum sxvebado, via <style=cIsUtility>Cxefa Kapablo</style> konvertigxas al celita atako, kiu aplikas <color=#ba8fff>Antauxsignon</color>.",
    "KENKO_BANSHEE_PRIMARY_ATKUMBRELLA_NAME": "ATK Ombrelo",
    "KENKO_BANSHEE_PRIMARY_ATKUMBRELLA_DESCRIPTION": "<color=#ba8fff>Antauxsigno</color>. Trancxu antaux vi por <style=cIsDamage>250% da damagxo</style>. Cxiu 3-a trancxo pusxas vin antauxen kaj en la aeron, donante <style=cIsDamage>300% da damagxo</style>.",
    "KENKO_BANSHEE_PRIMARY_THRSTUMBRELLA_NAME": "THRST Ombrelo",
    "KENKO_BANSHEE_PRIMARY_THRSTUMBRELLA_DESCRIPTION": "<color=#ba8fff>Antauxsigno</color>. Trancxu antaux vi por <style=cIsDamage>250% da damagxo</style>. Cxiu 3-a trancxo pusxas vin en la aeron, donante <style=cIsDamage>300% da damagxo</style>.",
    "KENKO_BANSHEE_PRIMARY_WISP_NAME": "Etera Vagfajro",
    "KENKO_BANSHEE_PRIMARY_WISP_DESCRIPTION": "Pafas vagfajron por <style=cIsDamage>200% da damagxo</style>.",
    "KENKO_BANSHEE_SECONDARY_DIVE_NAME": "Plongxbombo",
    "KENKO_BANSHEE_SECONDARY_DIVE_DESCRIPTION": "<style=cIsUtility>Aerodinamika</style>. Plongxu malsupren, donante <style=cIsDamage>250% da damagxo</style> cxe trafo. <style=cIsHealth>Konsumas</style> cxiujn <style=cIsUtility>kapablo</style>-sxargojn, pliigante la <style=cIsDamage>kauxzitan damagxon</style> por cxiu konsumita.",
    "KENKO_BANSHEE_UTILITY_THRUST_NAME": "HDN Pusxiloj",
    "KENKO_BANSHEE_UTILITY_THRUST_DESCRIPTION": "<color=#ba8fff>Antauxsigno</color>. Impetu en iun direkton.",
    "KENKO_BANSHEE_UTILITY_SUPERTHRUST_NAME": "EXP Pusxilo",
    "KENKO_BANSHEE_UTILITY_SUPERTHRUST_DESCRIPTION": "<color=#ba8fff>Antauxsigno</color>. Impetu en iun direkton. <color=#ba8fff>Antauxsigno</color> aktivigxas krome <style=cIsUtility>4</style> fojojn.",
    "KENKO_BANSHEE_SPECIAL_CALAMITAS_NAME": "CAL Grenado",
    "KENKO_BANSHEE_SPECIAL_CALAMITAS_DESCRIPTION": "Jxetu grenadon, kiu kreas malstabilan nigran truon. Post <style=cIsUtility>2</style> sekundoj, la nigra truo kolapsas, donante <style=cIsDamage>700% da damagxo</style>.",
    "KENKO_BANSHEE_SPECIAL_SCEP_CALAMITAS_NAME": "Calamitas",
    "KENKO_BANSHEE_SPECIAL_SCEP_CALAMITAS_DESCRIPTION": "Jxetu 3 grenadojn, kiuj kreas malstabilajn nigrajn truojn. Post <style=cIsUtility>5</style> sekundoj, la nigraj truoj kolapsas, donante <style=cIsDamage>700% da damagxo</style>.",
    "ACHIEVEMENT_KENKO_BANSHEE_UNLOCK_ACHIEVEMENT_NAME": "Mi estas Mary Poppins, fiulacxo!",
    "ACHIEVEMENT_KENKO_BANSHEE_UNLOCK_ACHIEVEMENT_DESCRIPTION": "Finu etapon sen tusxi la grundon pli ol unu fojon.",
    "ACHIEVEMENT_KENKO_BANSHEE_MASTERYACHIEVEMENT_NAME": "Banshee: Majstreco",
    "ACHIEVEMENT_KENKO_BANSHEE_MASTERYACHIEVEMENT_DESCRIPTION": "Kiel Banshee, venku la ludon aux neniigu vin en Monsoon.",
    "<style=cKeywordName>Agile</style><style=cSub>The skill can be used while sprinting.</style>": "<style=cKeywordName>Agila</style><style=cSub>La kapablo povas esti uzata dum kurado.</style>",
    "<style=cKeywordName>Omen</style><style=cSub>This skill fires an <color=#ba8fff>Ethereal Wisp</color> when completed which deals <style=cIsDamage>200% damage</style> on hit and restores <style=cIsUtility>1</style> stock to your secondary skill.</style>": "<style=cKeywordName>Antauxsigno</style><style=cSub>Cxi tiu kapablo pafas <color=#ba8fff>Eteran Vagfajron</color> kiam gxi finigxas, kiu donas <style=cIsDamage>200% da damagxo</style> cxe trafo kaj restarigas <style=cIsUtility>1</style> sxargon al via duaranga kapablo.</style>",
    "<style=cKeywordName>Aerodynamic</style><style=cSub>The skill deals more damage the longer the distance traveled before impact.</style>": "<style=cKeywordName>Aerodinamika</style><style=cSub>La kapablo donas pli da damagxo ju pli longa estas la distanco trairita antaux la trafo.</style>"
  }
}
