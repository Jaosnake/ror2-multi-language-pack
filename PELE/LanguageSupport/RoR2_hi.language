    "OBJECTIVE_VOID_DEEP_PORTAL": "<style=cIsVoid>गहन शून्य</style> में प्रवेश करें",
    "OBJECTIVE_VOID_OUTRO_PORTAL": "<style=cIsVoid>गहन शून्य</style> से बाहर निकलें",
    "OBJECTIVE_VOIDCAMP": "<style=cIsVoid>शून्य के बीज</style> के इलाके को साफ़ करें।\n{0} राक्षस बाकी",
    "OBJECTIVE_VOID_BATTERY": "<style=cIsVoid>गहन शून्य के संकेत</style> चार्ज करें ({0}%)",
    "OBJECTIVE_VOID_BATTERY_OOB": "<style=cIsVoid>गहन शून्य के संकेत की सीमा में आएँ!</style> ({0}%)",
    "OBJECTIVE_COLOSSUS_EVENT_BEGIN": "Colossus की कृपा प्राप्त करें",
    "ARTIFACT_DEVOTION_NAME": "समर्पण का पुरावशेष",
    "ARTIFACT_DEVOTION_DESCRIPTION": "टूटे ड्रोन की जगह Lemurian के अंडे आते हैं। अनुयायी पाने के लिए एक वस्तु चढ़ाएँ।",
    "ARTIFACT_DELUSION_NAME": "भ्रम का पुरावशेष",
    "ARTIFACT_DELUSION_DESCRIPTION": "टेलीपोर्टर की घटना पूरी होने पर, और वस्तुएँ पाने के लिए याददाश्त की परीक्षा में अपनी वस्तुएँ दाँव पर लगाएँ।",
    "ARTIFACT_REBIRTH_NAME": "पुनर्जन्म का पुरावशेष",
    "ARTIFACT_REBIRTH_DESCRIPTION": "पिछले जीवन के उपहार लेकर Petrichor V पर उतरें।",
    "ARTIFACT_REBIRTH_PARTYMEMBER_NAME": "सहेजा गया उपहार",
    "ARTIFACT_REBIRTH_UNKNOWN_NAME": "अज्ञात उपहार",
    "ARTIFACT_REBIRTH_UNKNOWN_DESCRIPTION": "बड़ा उपहार सहेजने के लिए Meridian लौटें।",
    "ARTIFACT_PRESTIGE_DESCRIPTION": "हर चरण में पर्वत की कम-से-कम एक वेदी प्रकट होती है। पर्वत की वेदी के प्रभाव स्थायी रहते हैं।",
    "ARTIFACT_PRESTIGE_NAME": "प्रतिष्ठा का पुरावशेष",
    "DIFFICULTY_EASY_NAME": "Drizzle",
    "DIFFICULTY_EASY_DESCRIPTION": "नए खिलाड़ियों के लिए कठिनाई घटाता है। रोने और दाँत पीसने की जगह हँसी और गुदगुदी ले लेती है।<style=cStack>\n\n>खिलाड़ी का स्वास्थ्य पुनर्जनन: <style=cIsHealing>+50%</style>\n>खिलाड़ी को होने वाली क्षति में कमी: <style=cIsHealing>+38%</style>\n>कठिनाई बढ़ने की दर: <style=cIsHealing>-50%</style></style>",
    "DIFFICULTY_NORMAL_NAME": "Rainstorm",
    "DIFFICULTY_NORMAL_DESCRIPTION": "खेल इसी तरह खेलने के लिए बना है! दुर्जेय दुश्मनों के सामने अपनी क्षमताएँ और कुशलता परखें।",
    "DIFFICULTY_HARD_NAME": "Monsoon",
    "DIFFICULTY_HARD_DESCRIPTION": "कट्टर खिलाड़ियों के लिए। हर मोड़ पर इस ग्रह की पीड़ा और दहशत आपका इंतज़ार करती है। आपकी मौत होगी।<style=cStack>\n\n>खिलाड़ी का स्वास्थ्य पुनर्जनन: <style=cIsHealth>-40%</style>\n>कठिनाई बढ़ने की दर: <style=cIsHealth>+50%</style></style>",
    "ECLIPSE_GAMEMODE_NAME": "Eclipse",
    "ECLIPSE_GAMEMODE_DESCRIPTION": "<style=cIsUtility>Eclipse</style> एक गेम मोड है जिसमें आपके अभियान की चुनौतियाँ क्रमशः जुड़ती जाती हैं।\n\nहर बार जब आप <style=cIsUtility>खेल जीतते हैं</style>, उस उत्तरजीवी का Eclipse स्तर <style=cIsUtility>स्थायी रूप से बढ़ता</style> है, अधिकतम <style=cIsUtility>8</style> बार।",
    "ECLIPSE_GAMEMODE_START": "Eclipse शुरू करें",
    "ECLIPSE_1_NAME": "Eclipse (1)",
    "ECLIPSE_2_NAME": "Eclipse (2)",
    "ECLIPSE_3_NAME": "Eclipse (3)",
    "ECLIPSE_4_NAME": "Eclipse (4)",
    "ECLIPSE_5_NAME": "Eclipse (5)",
    "ECLIPSE_6_NAME": "Eclipse (6)",
    "ECLIPSE_7_NAME": "Eclipse (7)",
    "ECLIPSE_8_NAME": "Eclipse (8)",
    "GAMEMODE_CLASSIC_RUN_NAME": "Classic",
    "GAMEMODE_WEEKLY_RUN_NAME": "Prismatic Trials",
    "ECLIPSE_1_DESCRIPTION": "शुरुआत Monsoon की मूल कठिनाई से होती है।<style=cSub>\n\n<mspace=0.5em>(1)</mspace> सहयोगियों का शुरुआती स्वास्थ्य: <style=cIsHealth>-50%</style></style>",
    "ECLIPSE_2_DESCRIPTION": "शुरुआत Monsoon की मूल कठिनाई से होती है।<style=cSub>\n\n<mspace=0.5em>(1)</mspace> सहयोगियों का शुरुआती स्वास्थ्य: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(2)</mspace> टेलीपोर्टर की त्रिज्या: <style=cIsHealth>-50%</style></style>",
    "ECLIPSE_3_DESCRIPTION": "शुरुआत Monsoon की मूल कठिनाई से होती है।<style=cSub>\n\n<mspace=0.5em>(1)</mspace> सहयोगियों का शुरुआती स्वास्थ्य: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(2)</mspace> टेलीपोर्टर की त्रिज्या: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(3)</mspace> गिरने से सहयोगियों को होने वाली क्षति: <style=cIsHealth>+100% और प्राणघातक</style></style>",
    "ECLIPSE_4_DESCRIPTION": "शुरुआत Monsoon की मूल कठिनाई से होती है।<style=cSub>\n\n<mspace=0.5em>(1)</mspace> सहयोगियों का शुरुआती स्वास्थ्य: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(2)</mspace> टेलीपोर्टर की त्रिज्या: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(3)</mspace> गिरने से सहयोगियों को होने वाली क्षति: <style=cIsHealth>+100% और प्राणघातक</style>\n<mspace=0.5em>(4)</mspace> दुश्मनों की गति: <style=cIsHealth>+40%</style></style>",
    "ECLIPSE_5_DESCRIPTION": "शुरुआत Monsoon की मूल कठिनाई से होती है।<style=cSub>\n\n<mspace=0.5em>(1)</mspace> सहयोगियों का शुरुआती स्वास्थ्य: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(2)</mspace> टेलीपोर्टर की त्रिज्या: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(3)</mspace> गिरने से सहयोगियों को होने वाली क्षति: <style=cIsHealth>+100% और प्राणघातक</style>\n<mspace=0.5em>(4)</mspace> दुश्मनों की गति: <style=cIsHealth>+40%</style>\n<mspace=0.5em>(5)</mspace> सहयोगियों को मिलने वाली चिकित्सा: <style=cIsHealth>-50%</style></style>",
    "ECLIPSE_6_DESCRIPTION": "शुरुआत Monsoon की मूल कठिनाई से होती है।<style=cSub>\n\n<mspace=0.5em>(1)</mspace> सहयोगियों का शुरुआती स्वास्थ्य: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(2)</mspace> टेलीपोर्टर की त्रिज्या: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(3)</mspace> गिरने से सहयोगियों को होने वाली क्षति: <style=cIsHealth>+100% और प्राणघातक</style>\n<mspace=0.5em>(4)</mspace> दुश्मनों की गति: <style=cIsHealth>+40%</style>\n<mspace=0.5em>(5)</mspace> सहयोगियों को मिलने वाली चिकित्सा: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(6)</mspace> दुश्मनों से गिरने वाला सोना: <style=cIsHealth>-20%</style></style>",
    "ECLIPSE_7_DESCRIPTION": "शुरुआत Monsoon की मूल कठिनाई से होती है।<style=cSub>\n\n<mspace=0.5em>(1)</mspace> सहयोगियों का शुरुआती स्वास्थ्य: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(2)</mspace> टेलीपोर्टर की त्रिज्या: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(3)</mspace> गिरने से सहयोगियों को होने वाली क्षति: <style=cIsHealth>+100% और प्राणघातक</style>\n<mspace=0.5em>(4)</mspace> दुश्मनों की गति: <style=cIsHealth>+40%</style>\n<mspace=0.5em>(5)</mspace> सहयोगियों को मिलने वाली चिकित्सा: <style=cIsHealth>-50%</style>\n<mspace=0.5em>(6)</mspace> दुश्मनों से गिरने वाला सोना: <style=cIsHealth>-20%</style>\n<mspace=0.5em>(7)</mspace> दुश्मनों की पुनर्प्रयोग अवधि: <style=cIsHealth>-50%</style></style>",
    "ECLIPSE_8_DESCRIPTION": "“तुम रोशनी में जश्न मना पाते हो... क्योंकि मैं इसकी इजाज़त देता हूँ।” \n\nशुरुआत Monsoon की मूल कठिनाई से होती है। <style=cSub>\n\n<mspace=0.5em>(1)</mspace> सहयोगियों का शुरुआती स्वास्थ्य: <style=cIsHealth>-50%</style> \n<mspace=0.5em>(2)</mspace> टेलीपोर्टर की त्रिज्या: <style=cIsHealth>-50%</style> \n<mspace=0.5em>(3)</mspace> गिरने से सहयोगियों को होने वाली क्षति: <style=cIsHealth>+100% और प्राणघातक</style> \n<mspace=0.5em>(4)</mspace> दुश्मनों की गति: <style=cIsHealth>+40%</style> \n<mspace=0.5em>(5)</mspace> सहयोगियों को मिलने वाली चिकित्सा: <style=cIsHealth>-50%</style> \n<mspace=0.5em>(6)</mspace> दुश्मनों से गिरने वाला सोना: <style=cIsHealth>-20%</style> \n<mspace=0.5em>(7)</mspace> दुश्मनों की पुनर्प्रयोग अवधि: <style=cIsHealth>-50%</style> \n<mspace=0.5em>(8)</mspace> सहयोगियों को होती है <style=cIsHealth>स्थायी क्षति</style></style>",
    "CAPTAIN_BODY_SUBTITLE": "थका हुआ अनुभवी सैनिक",
    "CAPTAIN_PASSIVE_NAME": "रक्षात्मक माइक्रोबॉट्स",
    "CAPTAIN_PASSIVE_DESCRIPTION": "निष्क्रिय रूप से <style=cIsUtility>माइक्रोबॉट्स</style> मिलते हैं जो <style=cIsUtility>पास के दुश्मन प्रक्षेप्यों को मार गिराते हैं</style>। <style=cIsUtility>ड्रोन</style> को भी <style=cIsUtility>माइक्रोबॉट्स</style> मिलते हैं।",
    "CAPTAIN_PRIMARY_NAME": "वल्कन शॉटगन",
    "CAPTAIN_PRIMARY_DESCRIPTION": "छर्रों की बौछार चलाएँ जो <style=cIsDamage>8x120% क्षति</style> पहुँचाती है। हमले को चार्ज करने से <style=cIsUtility>फैलाव</style> कम होता है।",
    "CAPTAIN_SECONDARY_NAME": "पावर टेज़र",
    "CAPTAIN_SECONDARY_DESCRIPTION": "<style=cIsDamage>झटका</style>। तेज़ टेज़र चलाएँ जो <style=cIsDamage>100% क्षति</style> पहुँचाता है। उछलने पर यह और दूर जाता है।",
    "CAPTAIN_UTILITY_NAME": "ऑर्बिटल प्रोब",
    "CAPTAIN_UTILITY_DESCRIPTION": "<style=cIsDamage>अचेत करता है</style>। <style=cIsDamage>UES Safe Travels</style> से अधिकतम <style=cIsDamage>3</style> ऑर्बिटल प्रोब मँगाएँ। हर प्रोब <style=cIsDamage>1000% क्षति</style> पहुँचाती है।",
    "CAPTAIN_UTILITY_ALT1_NAME": "OGM-72 'DIABLO' हमला",
    "CAPTAIN_UTILITY_ALT1_DESCRIPTION": "<style=cIsDamage>अचेत करता है</style>। <style=cIsDamage>गतिज हमला</style> <style=cIsDamage>UES Safe Travels</style> से मँगाएँ। <style=cIsUtility>20 सेकंड</style> बाद यह सभी पात्रों को <style=cIsDamage>40,000% क्षति</style> पहुँचाता है।",
    "CAPTAIN_SPECIAL_NAME": "ऑर्बिटल सप्लाई बीकन",
    "CAPTAIN_SPECIAL_DESCRIPTION": "<style=cIsUtility>स्थायी</style> सप्लाई बीकन मँगाएँ। इसे हर चरण में केवल <style=cIsUtility>दो बार</style> मँगाया जा सकता है।",
    "CAPTAIN_SUPPLY_HEAL_NAME": "बीकन: उपचार",
    "CAPTAIN_SUPPLY_HEAL_DESCRIPTION": "पास के सभी सहयोगियों को हर सेकंड उनकी <style=cIsHealing>अधिकतम सेहत</style> के <style=cIsHealing>10%</style> के बराबर <style=cIsHealing>उपचार</style> दें।",
    "CAPTAIN_SUPPLY_DEFENSE_NAME": "बीकन: रक्षा",
    "CAPTAIN_SUPPLY_DEFENSE_DESCRIPTION": "इस्तेमाल करने पर सहयोगी को <style=cIsUtility>बफ़</style> दें, जिससे अगली क्षति <style=cIsUtility>रुक जाती है</style>।",
    "CAPTAIN_SUPPLY_DEFENSE_RESTOCK_INTERACTION": "डिस्पोज़ेबल कवच लें",
    "CAPTAIN_SUPPLY_HACKING_NAME": "बीकन: हैकिंग",
    "CAPTAIN_SUPPLY_HACKING_DESCRIPTION": "पास की सभी खरीदी जा सकने वाली वस्तुओं को <style=cIsUtility>हैक</style> करें, ताकि समय के साथ उनकी कीमत <style=cIsUtility>$0</style> हो जाए।",
    "CAPTAIN_SUPPLY_EQUIPMENT_RESTOCK_NAME": "बीकन: पुनः आपूर्ति",
    "CAPTAIN_SUPPLY_EQUIPMENT_RESTOCK_DESCRIPTION": "इस्तेमाल करने पर <style=cIsUtility>उपकरण को रीचार्ज करें</style>।",
    "CAPTAIN_SUPPLY_EQUIPMENT_RESTOCK_INTERACTION": "उपकरण चार्ज लें",
    "CAPTAIN_SUPPLY_SHOCKING_NAME": "बीकन: झटका",
    "CAPTAIN_SUPPLY_SHOCKING_DESCRIPTION": "आस-पास के सभी दुश्मनों को समय-समय पर <style=cIsDamage>झटका</style> देकर स्थिर कर देता है।",
    "CAPTAIN_SKILL_USED_UP_NAME": "उपलब्ध नहीं",
    "CAPTAIN_SKILL_USED_UP_DESCRIPTION": "आप इस चरण में सप्लाई ड्रॉप पहले ही मँगा चुके हैं।",
    "CAPTAIN_SKILL_DISCONNECT_NAME": "कनेक्शन टूट गया",
    "CAPTAIN_SKILL_DISCONNECT_DESCRIPTION": "UES Safe Travels से आपका संपर्क टूट गया है...",
    "CAPTAIN_SKIN_ALT1_NAME": "एडमिरल",
    "CHEF_BODY_SUBTITLE": "पाक कला विशेषज्ञ",
    "CHEF_PASSIVE_NAME": "शेफ़ की वाहवाही",
    "CHEF_PASSIVE_DESCRIPTION": "दुश्मनों को 2 या अधिक कौशलों से मारने पर वे पक जाते हैं और <style=cIsHealing>उपचार</style> देने वाला भोजन गिराते हैं।",
    "CHEF_PRIMARY_NAME": "टुकड़े करना",
    "CHEF_PRIMARY_DESCRIPTION": "<style=cIsUtility>तेज़</style>। दुश्मनों पर <style=cIsDamage>भेदने वाला</style> चाकू फेंकें जो <style=cIsDamage>200%</style> क्षति पहुँचाता है। हमले का बटन दबाए रखने पर <style=cIsDamage>वापसी की क्षति दोगुनी होती है</style>।",
    "CHEF_PRIMARY_BOOST_DESCRIPTION_SKILL": "सभी दिशाओं में चाकू फेंकता है, जो <style=cIsDamage>400% क्षति</style> पहुँचाते हैं।",
    "CHEF_SECONDARY_NAME": "भूनना",
    "CHEF_SECONDARY_DESCRIPTION": "<style=cIsDamage>आग लगाता है</style>। पास के दुश्मनों को झुलसाकर <style=cIsDamage>600% क्षति</style> पहुँचाएँ।",
    "CHEF_SECONDARY_BOOST_DESCRIPTION_SKILL": "पास के दुश्मनों को झुलसाएँ और तीन आग के गोले चलाएँ जो <style=cIsDamage>700% क्षति</style> पहुँचाते हैं। जलते तेल के गोले टकराने पर जलते तेल के पोखर छोड़ते हैं।",
    "CHEF_SECONDARY_ALT_NAME": "आइस बॉक्स",
    "CHEF_SECONDARY_ALT_DESCRIPTION": "<style=cIsUtility>पाला</style>। बर्फ के टुकड़े चलाएँ जो <style=cIsDamage>3x150% क्षति</style> पहुँचाते हैं।",
    "CHEF_UTILITY_NAME": "लुढ़कना",
    "CHEF_UTILITY_DESCRIPTION": "<style=cIsDamage>अचेत करता है</style>। बेलन को चार्ज करके आगे <style=cIsUtility>तेज़ी से बढ़ें</style> और <style=cIsDamage>300%-600% क्षति</style> पहुँचाएँ।",
    "CHEF_UTILITY_BOOST_DESCRIPTION_SKILL": "<style=cIsHealth>रक्तस्राव।</style> घूमते बर्तनों के साथ आगे बढ़ें और पास के सभी दुश्मनों को अतिरिक्त <style=cIsDamage>200%</style> क्षति पहुँचाएँ।",
    "CHEF_UTILITY_ALT_NAME": "तेल का फैलाव",
    "CHEF_UTILITY_ALT_DESCRIPTION": "ऊपर घूमकर नीचे पटकें और <style=cIsUtility>तेल</style> के विस्फोट से <style=cIsDamage>200% क्षति</style> पहुँचाएँ। ज़मीन पर उतरने से पहले क्षमता दोबारा चलाकर <style=cIsDamage>फिर उछलें</style>, कुल अधिकतम <style=cIsDamage>4</style> बार।",
    "CHEF_UTILITY_ALT_BOOST_DESCRIPTION_SKILL": "ऊपर घूमकर नीचे पटकें और <style=cIsUtility>तेल</style> के विस्फोट से <style=cIsDamage>200% क्षति</style> पहुँचाएँ। ज़मीन पर उतरने से पहले क्षमता दोबारा चलाकर <style=cIsDamage>फिर उछलें</style>, कुल अधिकतम <style=cIsDamage>4</style> बार।",
    "CHEF_SPECIAL_NAME": "ग्लेज़",
    "CHEF_SPECIAL_DESCRIPTION": "<style=cIsUtility>तेल</style> के गोले तेज़ी से चलाएँ, जो <style=cIsDamage>7x250% क्षति</style> पहुँचाते हैं।",
    "CHEF_SPECIAL_ALT1_NAME": "जी, CHEF!",
    "CHEF_SPECIAL_ALT1_DESCRIPTION": "विस्फोट करें जो <style=cIsDamage>400%</style> क्षति पहुँचाता है और <style=cIsDamage>आग</style> या <style=cIsUtility>पाला</style> लगाता है। अगले कौशल को <style=cIsUtility>बढ़ाता है</style>।",
    "DRIFTER_BODY_SUBTITLE": "बेलगाम संग्रहकर्ता",
    "DRIFTER_PASSIVE_NAME": "कचरे से खज़ाना",
    "DRIFTER_PASSIVE_DESCRIPTION": "<style=cIsUtility>रीसायकल</style>। <style=cIsUtility>आइटम स्क्रैप</style> रखने से स्टैक होने वाले बफ़ पाएँ।",
    "DRIFTER_PRIMARY_NAME": "प्रचंड प्रहार",
    "DRIFTER_PRIMARY_DESCRIPTION": "दुश्मनों पर वार करके <style=cIsDamage>170% क्षति</style> पहुँचाएँ। तीसरा वार <style=cIsDamage>350%</style> क्षति पहुँचाता है और दुश्मनों को <style=cIsUtility>अचेत करता है</style>। <style=cIsUtility>कचरा</style> गिरने की संभावना है।",
    "DRIFTER_SECONDARY_NAME": "सफ़ाई",
    "DRIFTER_SECONDARY_DESCRIPTION": "मलबे की बौछार से <style=cIsDamage>4x100% क्षति</style> पहुँचाएँ और थैले में रखा <style=cIsUtility>यादृच्छिक प्रक्षेप्य</style> भी फेंकें। कूलडाउन छोड़ने के लिए <style=cIsUtility>2 कचरा</style> खर्च कर सकते हैं।",
    "DRIFTER_SECONDARY_ALT_NAME": "कचरे का घन",
    "DRIFTER_SECONDARY_ALT_DESCRIPTION": "कचरे का घन पटककर <style=cIsDamage>400% क्षति</style> पहुँचाएँ। घन पर वार करने से वह उछलकर अधिकतम 3 बार दुश्मनों को <style=cIsDamage>400% क्षति</style> पहुँचाता है, फिर फटकर <style=cIsDamage>800%</style> क्षति देता है। कूलडाउन छोड़ने के लिए <style=cIsUtility>4 कचरा</style> खर्च कर सकते हैं।",
    "DRIFTER_SECONDARY_A_NAME": "फिर से चुनें",
    "DRIFTER_SECONDARY_A_DESCRIPTION": "वर्तमान प्रक्षेप्य को फिर से चुनने के लिए दबाएँ।",
    "DRIFTER_SECONDARY_B_NAME": "उड़ेलना",
    "DRIFTER_SECONDARY_B_DESCRIPTION": "प्रक्षेप्य तैयार रहने तक उन्हें लगातार फेंकने के लिए दबाए रखें।",
    "DRIFTER_SPECIAL_NAME": "बचाव सामग्री",
    "DRIFTER_SPECIAL_DESCRIPTION": "<style=cIsUtility>8 कचरा</style> खर्च करके <style=cIsTemporary>4 अस्थायी आइटम</style> बनाएँ।",
    "DRIFTER_SPECIAL_ALT_NAME": "छेड़छाड़",
    "DRIFTER_SPECIAL_ALT_DESCRIPTION": "<style=cIsUtility>अचेत करता है</style>। <style=cIsUtility>8 कचरा</style> खर्च करके शॉकवेव छोड़ें जो <style=cIsDamage>100% क्षति</style> पहुँचाती है, <style=cIsUtility>यादृच्छिक डिबफ़</style> लगाती है और उठाने योग्य आइटम तथा आइटम रखने वाली वस्तुओं से <style=cIsUtility>छेड़छाड़</style> करती है। <style=cIsUtility>प्रभाव लक्ष्य के अनुसार बदलते हैं।</style>",
    "DRIFTER_UTILITY_NAME": "वापस लेना",
    "DRIFTER_UTILITY_DESCRIPTION": "आगे छलाँग लगाकर <style=cIsDamage>दुश्मन</style> या <style=cIsUtility>इंटरैक्टिव वस्तु</style> को थैले में पकड़ें। थैले की सामग्री फेंकने के लिए दोबारा इस्तेमाल करें। पकड़ी गई वस्तुओं पर <style=cIsDamage>प्रहार</style> किया जाता है।",
    "DRIFTER_UTILITY_B_NAME": "फेंकना",
    "DRIFTER_UTILITY_B_DESCRIPTION": "थैले से रखी वस्तु फेंकें। टकराने पर <style=cIsUtility>अचेत</style> करती है और <style=cIsDamage>280% क्षति</style> पहुँचाती है जो वस्तु के द्रव्यमान से बढ़ती है। <style=cIsUtility>कचरा</style> गिराती है।",
    "DRIFTER_UTILITY_C_NAME": "प्रहार",
    "DRIFTER_UTILITY_C_DESCRIPTION": "थैले में रखी वस्तु से दुश्मनों को मारें और <style=cIsDamage>280% क्षति</style> पहुँचाएँ जो वस्तु के द्रव्यमान से बढ़ती है। हर प्रहार में <style=cIsUtility>कचरा</style> गिरता है और वस्तु को क्षति पहुँचती है। राक्षस तीन प्रहारों के बाद निकल जाते हैं।",
    "FALSESON_BODY_SUBTITLE": "विखंडित उत्तराधिकारी",
    "FALSESON_PASSIVE_NAME": "चंद्र छेड़छाड़",
    "FALSESON_PASSIVE_DESCRIPTION": "अप्रयुक्त चंद्र शूल <style=cIsUtility>+5% हमले की गति</style> और <style=cIsUtility>+2.5 कवच</style> देते हैं। प्रयुक्त शूल <style=cIsUtility>+5% गति</style> और <style=cIshealing>+2.5 सेहत पुनर्जनन</style> देते हैं।",
    "FALSESON_PRIMARY_NAME": "परित्यक्तों की गदा",
    "FALSESON_PRIMARY_DESCRIPTION": "गदा घुमाकर <style=cIsDamage>450% क्षति</style> पहुँचाएँ। प्राथमिक और द्वितीयक कौशल दबाए रखकर प्रहार चार्ज करें जो <style=cIsDamage>1000% क्षति</style> पहुँचाता है।",
    "FALSESON_SECONDARY_NAME": "चंद्र शूल",
    "FALSESON_SECONDARY_DESCRIPTION": "<style=cIsUtility>चंद्र विनाश</style>। <style=cIsUtility>फुर्तीला</style>। चंद्र शूल फेंकें जो <style=cIsDamage>200% क्षति</style> पहुँचाता है। <style=cIsHealing>वृद्धि</style> से और शूल पाएँ।",
    "FALSESON_SECONDARY_ALT1_NAME": "चंद्र भाले",
    "FALSESON_SECONDARY_ALT1_DESCRIPTION": "<style=cIsUtility>चंद्र विनाश</style>। <style=cIsDamage>भेदने वाला</style>, <style=cIsDamage>बिजली</style> से युक्त चंद्र भाला चलाएँ जो <style=cIsDamage>300% क्षति</style> पहुँचाता है। <style=cIsHealing>वृद्धि</style> से और भाले पाएँ। इसे <style=cIsUtility>2</style> चंद्र शूल माना जाता है।",
    "FALSESON_UTILITY_NAME": "भाइयों का कदम",
    "FALSESON_UTILITY_DESCRIPTION": "थोड़ी दूरी तक झपटें और हर प्रभावित दुश्मन के लिए <style=cIsDamage>200% क्षति</style> का विस्फोट करें। <style=cIsUtility>दो उपयोग</style>।",
    "FALSESON_UTILITY_ALT1_NAME": "Meridian की इच्छा",
    "FALSESON_UTILITY_ALT1_DESCRIPTION": "<style=cIsDamage>अचेत करता है</style>। <style=cIsUtility>टेलीपोर्ट</style> करें और विस्फोट से <style=cIsDamage>150% क्षति</style> पहुँचाकर दुश्मनों को <style=cIsUtility>खींचें</style>। अपनी निष्क्रिय क्षमता के लाभ <style=cIsUtility>4s</style> तक तीन गुना करें। <style=cIsHealing>वृद्धि</style> यह अवधि बढ़ाती है।",
    "FALSESON_SPECIAL_NAME": "पिता का लेज़र",
    "FALSESON_SPECIAL_DESCRIPTION": "<style=cIsUtility>चार्ज करें</style> तेज़ी से प्रहार करने वाला लेज़र जो <style=cIsDamage>240%-1400% क्षति</style> <style=cIsUtility>4s</style> तक पहुँचाता है और चंद्र शूल <style=cIsUtility>भरता है</style>। इसकी <style=cIsUtility>अवधि</style> <style=cIsHealing>वृद्धि</style> से बढ़ती है।",
    "FALSESON_SPECIAL_ALT1_NAME": "लेज़र बर्स्ट",
    "FALSESON_SPECIAL_ALT1_DESCRIPTION": "भेदने वाला लेज़र चलाएँ जो <style=cIsDamage>1250% क्षति</style> पहुँचाता है और <style=cIsUtility>50%</style> चंद्र शूल भरता है। <style=cIsHealing>वृद्धि</style> से इसके उपयोगों की संख्या बढ़ती है।",
    "RAILGUNNER_BODY_SUBTITLE": "विस्मृत घुमक्कड़",
    "RAILGUNNER_PASSIVE_NAME": "चुंबकीय त्वरक",
    "RAILGUNNER_PASSIVE_DESCRIPTION": "सारी <style=cIsDamage>क्रिटिकल हिट की संभावना</style> को <style=cIsDamage>क्रिटिकल हिट की क्षति</style> में बदला जाता है।",
    "RAILGUNNER_PRIMARY_NAME": "XQR स्मार्ट राउंड सिस्टम",
    "RAILGUNNER_PRIMARY_DESCRIPTION": "दुश्मनों का पीछा करने वाली गोलियाँ चलाएँ, जो <style=cIsDamage>100% क्षति</style> पहुँचाती हैं।",
    "RAILGUNNER_SECONDARY_NAME": "M99 स्नाइपर",
    "RAILGUNNER_SECONDARY_DESCRIPTION": "अपना <style=cIsUtility>लंबी दूरी का स्कोप</style> सक्रिय करें, जो <style=cIsDamage>कमज़ोर बिंदुओं</style> को दिखाता है और हथियार को भेदने वाली रेलगन में बदलता है जो <style=cIsDamage>1000% क्षति</style> पहुँचाती है।",
    "RAILGUNNER_SECONDARY_ALT_NAME": "HH44 मार्क्समैन",
    "RAILGUNNER_SECONDARY_ALT_DESCRIPTION": "अपना <style=cIsUtility>कम दूरी का स्कोप</style> सक्रिय करें, जो <style=cIsDamage>कमज़ोर बिंदुओं</style> को दिखाता है और हथियार को तेज़ रेलगन में बदलता है जो <style=cIsDamage>400% क्षति</style> पहुँचाती है।",
    "RAILGUNNER_SNIPE_HEAVY_DESCRIPTION": "भारी प्रक्षेप्य चलाएँ जो <style=cIsDamage>1000% क्षति</style> पहुँचाता है।",
    "RAILGUNNER_SNIPE_LIGHT_DESCRIPTION": "हल्का प्रक्षेप्य चलाएँ जो <style=cIsDamage>400% क्षति</style> पहुँचाता है।",
    "RAILGUNNER_SNIPE_SUPER_NAME": "सुपरचार्ज्ड रेलगन",
    "RAILGUNNER_SNIPE_SUPER_DESCRIPTION": "सुपरचार्ज्ड प्रक्षेप्य चलाएँ जो <style=cIsDamage>4000% क्षति</style> पहुँचाता है। क्रिटिकल हिट की क्षति <style=cIsDamage>1.5</style> गुना होती है।",
    "RAILGUNNER_SNIPE_CRYO_NAME": "क्रायोचार्ज्ड रेलगन",
    "RAILGUNNER_SNIPE_CRYO_DESCRIPTION": "<style=cIsUtility>जमाता है</style>। अत्यधिक ठंडा प्रक्षेप्य चलाएँ जो <style=cIsDamage>350% क्षति</style> पहुँचाता है।",
    "RAILGUNNER_UTILITY_NAME": "कन्कशन डिवाइस",
    "RAILGUNNER_UTILITY_DESCRIPTION": "ऐसा उपकरण फेंकें जो आपको और आस-पास के सभी दुश्मनों को <style=cIsUtility>पीछे धकेलता है</style>। अधिकतम 2 रख सकते हैं।",
    "RAILGUNNER_UTILITY_ALT_NAME": "पोलर फील्ड डिवाइस",
    "RAILGUNNER_UTILITY_ALT_DESCRIPTION": "ऐसा उपकरण फेंकें जो <style=cIsUtility>धीमा करता है</style> आस-पास के सभी <style=cIsUtility>दुश्मनों और प्रक्षेप्यों</style> को।",
    "RAILGUNNER_SPECIAL_NAME": "सुपरचार्ज",
    "RAILGUNNER_SPECIAL_DESCRIPTION": "<style=cIsDamage>भेदने वाली</style> गोली चलाएँ जो <style=cIsDamage>4000% क्षति</style> और <style=cIsDamage>कमज़ोर बिंदु पर 150% क्षति</style> पहुँचाती है। इसके बाद <style=cIsHealth>आपके सभी हथियार</style> <style=cIsHealth>5</style> सेकंड के लिए बंद हो जाते हैं।",
    "RAILGUNNER_SPECIAL_ALT_NAME": "क्रायोचार्ज",
    "RAILGUNNER_SPECIAL_ALT_DESCRIPTION": "<style=cIsUtility>जमाता है</style>। <style=cIsDamage>भेदने वाली</style> गोली चलाएँ जो <style=cIsDamage>2000% क्षति</style> पहुँचाती है।",
    "RAILGUNNER_ACTIVE_RELOAD_NAME": "सक्रिय रीलोड",
    "RAILGUNNER_ACTIVE_RELOAD_DESCRIPTION": "तेज़ी से तैयार होने और अगली गोली की क्षति <style=cIsDamage>+500%</style> बढ़ाने के लिए सही समय पर रीलोड करें।",
    "RAILGUNNER_FLAVOR_READY": "सभी सिस्टम सामान्य हैं",
    "RAILGUNNER_FLAVOR_NOTREADY": "सिस्टम त्रुटि - अज्ञात इनपुट मिला",
    "RAILGUNNER_FLAVOR_CHARGING": "चार्ज हो रहा है...",
    "RAILGUNNER_FLAVOR_CHARGED": "पूरी तरह चार्ज - गोली चलाने को तैयार",
    "RAILGUNNER_FLAVOR_OFFLINE": "सिस्टम दोबारा चालू हो रहा है...",
    "RAILGUNNER_FLAVOR_SCOPE": "2x ज़ूम सक्रिय",
    "RAILGUNNER_SKIN_ALT1_NAME": "निशानेबाज़",
    "SEEKER_BODY_SUBTITLE": "House Beyond की द्रष्टा",
    "SEEKER_PASSIVE_NAME": "भीतरी शक्ति",
    "SEEKER_PASSIVE_DESCRIPTION": "हर <style=cIsUtility>शांति के साथ क्षमताएँ बढ़ती हैं, अधिकतम 7 तक</style>।",
    "SEEKER_PRIMARY_NAME": "आत्मिक मुक्का",
    "SEEKER_PRIMARY_DESCRIPTION": "दुश्मनों पर बिना शरीर वाली <style=cIsDamage>भेदने वाली</style> मुट्ठियाँ चलाएँ जो <style=cIsDamage>250% क्षति</style> पहुँचाती हैं। हर 3वाँ प्रहार फटकर <style=cIsDamage>350% क्षति</style> पहुँचाता है।",
    "SEEKER_PRIMARY_ALT1_NAME": "आत्मा की खोज",
    "SEEKER_PRIMARY_ALT1_DESCRIPTION": "दुश्मनों पर पीछा करने वाले गोले चलाएँ, जो फटकर <style=cIsDamage>250% क्षति</style> पहुँचाते हैं।",
    "SEEKER_SECONDARY_NAME": "अदृश्य हाथ",
    "SEEKER_SECONDARY_DESCRIPTION": "<style=cIsDamage>अचेत करता है</style>। ज़मीन से <style=cIsDamage>भेदने वाला</style> भुतहा हाथ निकालें जो <style=cIsDamage>600% क्षति</style> पहुँचाता है। <style=cIsHealing>पहुँचाई गई क्षति का 3.5% उपचार देता है</style>।",
    "SEEKER_SECONDARY_ALT1_NAME": "आत्मा का सर्पिल",
    "SEEKER_SECONDARY_ALT1_DESCRIPTION": "घूमते गोले बनाएँ जो <style=cIsDamage>150% क्षति</style> पहुँचाते हैं। प्रहार से <style=cIsHealing>अस्थायी बैरियर</style> मिलता है। अधिकतम गोलों पर सक्रिय करने से <style=cIsUtility>उत्साह</style> मिलता है।",
    "SEEKER_UTILITY_NAME": "विचरण",
    "SEEKER_UTILITY_DESCRIPTION": "<style=cIsDamage>अचेत करता है</style>। <style=cIsUtility>उड़ान</style> भरें और विस्फोट करके <style=cIsDamage>500% क्षति</style> पहुँचाएँ। हर सेकंड <style=cIsHealth>25% सेहत</style> देकर <style=cIsDamage>क्षति बढ़ाएँ</style>।",
    "SEEKER_UTILITY_ALT1_NAME": "राहत",
    "SEEKER_UTILITY_ALT1_DESCRIPTION": "<style=cIsHealing>बैरियर</style> पाएँ और <style=cIsUtility>उड़ान</style> भरें। पूरा <style=cIsHealing>बैरियर</style> खोने या टकराने पर <style=cIsUtility>चक्रवात</style> बनता है, जो सहयोगियों को <style=cIsHealing>ठीक करता है</style> और हर सेकंड <style=cIsDamage>200% क्षति</style> पहुँचाता है।",
    "SEEKER_SPECIAL_NAME": "ध्यान",
    "SEEKER_SPECIAL_DESCRIPTION": "<style=cIsUtility>मन केंद्रित करें</style> ताकि विस्फोट से <style=cIsDamage>300% क्षति</style> पहुँचे, <style=cIsHealing>पास के सहयोगी ठीक हों</style> और <style=cIsUtility>शांति</style> मिले। अधिकतम शांति पर <style=cIsHealing>पुनर्जीवित</style> करता है और <style=cIsHealing>जीवनरक्षक कृपा</style> देता है।",
    "SEEKER_SPECIAL_ALT1_NAME": "हथेली विस्फोट",
    "SEEKER_SPECIAL_ALT1_DESCRIPTION": "<style=cIsUtility>चार्ज करें</style> एक <style=cIsDamage>भेदने वाला</style> प्रेत हाथ जो <style=cIsDamage>400%-700% क्षति</style> पहुँचाता है और सहयोगियों को <style=cIsHealing>ठीक करता है</style>। तीन पात्रों पर <style=cIsDamage>एकाधिक प्रहार</style> करके <style=cIsUtility>शांति</style> और <style=cIsHealing>बैरियर</style> पाएँ।",
    "VOIDSURVIVOR_BODY_SUBTITLE": "『भ्रष्ट स्मृतिभ्रंश पीड़ित】",
    "VOIDSURVIVOR_PASSIVE_NAME": "『शून्य का भ्रष्टाचार】",
    "VOIDSURVIVOR_PASSIVE_DESCRIPTION": "<style=cIsVoid>भ्रष्टाचार</style> पूरा होने पर आपकी क्षमताएँ अधिक आक्रामक रूप लेती हैं।",
    "VOIDSURVIVOR_PRIMARY_NAME": "【डुबोना」",
    "VOIDSURVIVOR_PRIMARY_DESCRIPTION": "लंबी दूरी की किरण चलाएँ जो <style=cIsUtility>धीमा करती है</style> और <style=cIsDamage>300% क्षति</style> पहुँचाती है।",
    "VOIDSURVIVOR_PRIMARY_UPRADE_TOOLTIP": "<style=cKeywordName>【भ्रष्टाचार उन्नयन】</style><style=cSub>कम दूरी की किरण में बदलता है जो 2000% क्षति पहुँचाती है।</style>",
    "VOIDSURVIVOR_SECONDARY_NAME": "『बाढ़」",
    "VOIDSURVIVOR_SECONDARY_DESCRIPTION": "प्लाज़्मा बोल्ट चलाएँ जो <style=cIsDamage>600% क्षति</style> पहुँचाता है। पूरा चार्ज करने पर विस्फोटक प्लाज़्मा गोला चलता है, जो <style=cIsDamage>1100% क्षति</style> पहुँचाता है।",
    "VOIDSURVIVOR_SECONDARY_UPRADE_TOOLTIP": "<style=cKeywordName>【भ्रष्टाचार उन्नयन】</style><style=cSub>चाप में जाने वाले बम में बदलता है जो 1100% क्षति पहुँचाता है और जिसका दायरा 2x है।</style>",
    "VOIDSURVIVOR_UTILITY_NAME": "「अतिक्रमण】",
    "VOIDSURVIVOR_UTILITY_DESCRIPTION": "शून्य में <style=cIsUtility>गायब हो जाएँ</style> और <style=cIsUtility>सभी डिबफ़ दूर करते हुए</style> <style=cIsUtility>ऊपर की ओर चाप में</style> बढ़ें।",
    "VOIDSURVIVOR_UTILITY_UPRADE_TOOLTIP": "<style=cKeywordName>【भ्रष्टाचार उन्नयन】</style><style=cSub>इसके बजाय आगे की ओर तेज़ और दूर तक जाने वाले चाप में बदलता है।</style>",
    "VOIDSURVIVOR_SPECIAL_NAME": "【दमन』",
    "VOIDSURVIVOR_SPECIAL_DESCRIPTION": "अपना <style=cIsVoid>25% भ्रष्टाचार</style> नष्ट करके <style=cIsHealing>अधिकतम सेहत का 25%</style> ठीक करें।",
    "VOIDSURVIVOR_SPECIAL_UPRADE_TOOLTIP": "<style=cKeywordName>【भ्रष्टाचार उन्नयन】</style><style=cSub>इसके बजाय 25% सेहत खर्च करके 25% भ्रष्टाचार प्राप्त करता है।</style>",
    "VOIDSURVIVOR_SKIN_ALT1_NAME": "शुद्ध",
    "BANDIT2_BODY_NAME": "Bandit",
    "BANDIT2_BODY_SUBTITLE": "बेताब डाकू",
    "BANDIT2_PASSIVE_NAME": "पीठ पर वार",
    "BANDIT2_PASSIVE_DESCRIPTION": "<style=cIsDamage>पीछे</style> से किए सभी हमले <style=cIsDamage>क्रिटिकल वार</style> होते हैं।",
    "BANDIT2_PRIMARY_NAME": "छर्रों की बौछार",
    "BANDIT2_PRIMARY_DESCRIPTION": "शॉटगन से छर्रे चलाएँ, जो <style=cIsDamage>5x100% क्षति</style> पहुँचाते हैं। 4 कारतूस तक रख सकते हैं।",
    "BANDIT2_PRIMARY_ALT_NAME": "राइफ़ल की गोली",
    "BANDIT2_PRIMARY_ALT_DESCRIPTION": "राइफ़ल की गोली चलाएँ, जो <style=cIsDamage>330% क्षति</style> पहुँचाती है। 4 गोलियाँ तक रख सकते हैं।",
    "BANDIT2_SECONDARY_NAME": "दाँतेदार खंजर",
    "BANDIT2_SECONDARY_DESCRIPTION": "आगे झपटकर काटें और <style=cIsDamage>360% क्षति</style> पहुँचाएँ। क्रिटिकल वार से <style=cIsHealth>भीषण रक्तस्राव</style> भी होता है।",
    "BANDIT2_SECONDARY_ALT_NAME": "दाँतेदार छुरा",
    "BANDIT2_SECONDARY_ALT_DESCRIPTION": "छुपा हुआ छुरा फेंककर <style=cIsDamage>240% क्षति</style> पहुँचाएँ। क्रिटिकल वार से <style=cIsHealth>भीषण रक्तस्राव</style> भी होता है।",
    "BANDIT2_UTILITY_NAME": "धुएँ का बम",
    "BANDIT2_UTILITY_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। <style=cIsDamage>200% क्षति</style> पहुँचाएँ, <style=cIsUtility>अदृश्य</style> हो जाएँ और फिर <style=cIsDamage>200% क्षति</style> पहुँचाएँ।",
    "BANDIT2_SPECIAL_NAME": "बत्ती गुल",
    "BANDIT2_SPECIAL_DESCRIPTION": "<style=cIsDamage>संहारक</style>। रिवॉल्वर का एक वार करें, जो <style=cIsDamage>600% क्षति</style> पहुँचाता है। इससे दुश्मन को मारने पर <style=cIsUtility>सभी कौशलों की पुनर्प्रयोग अवधि रीसेट</style> होती है।",
    "BANDIT2_SPECIAL_ALT_NAME": "बाग़ी बंदूकबाज़",
    "BANDIT2_SPECIAL_ALT_DESCRIPTION": "<style=cIsDamage>संहारक</style>। रिवॉल्वर का एक वार करें, जो <style=cIsDamage>600% क्षति</style> पहुँचाता है। हत्याओं से <style=cIsDamage>जमा होने वाले निशान</style> मिलते हैं। हर निशान बाग़ी बंदूकबाज़ की क्षति <style=cIsDamage>10%</style> बढ़ाता है।",
    "BANDIT2_SKIN_ALT1_NAME": "सर्द",
    "BANDIT2_SKIN_ALT2_NAME": "कानून से बाहर",
    "BANDIT2_SKIN_ALT3_NAME": "समुद्री डाकू",
    "BANDIT2_SKIN_ALT4_NAME": "महामारी का मारा",
    "TOOLBOT_BODY_NAME": "MUL-T",
    "TOOLBOT_BODY_SUBTITLE": "ग़लत काम का सही औज़ार",
    "TOOLBOT_PASSIVE_NAME": "बहुकार्यी",
    "TOOLBOT_PASSIVE_DESCRIPTION": "MUL-T एक साथ <style=cIsUtility>दो उपकरण</style> रख सकता है। <style=cIsDamage>औज़ार बदलें</style> का उपयोग करने पर सक्रिय उपकरण बदल जाता है।",
    "TOOLBOT_PRIMARY_NAME": "स्वचालित कील बंदूक",
    "TOOLBOT_PRIMARY_DESCRIPTION": "तेज़ी से कीलें चलाएँ, जो <style=cIsDamage>70% क्षति</style> पहुँचाती हैं। अंत में <style=cIsDamage>12</style> कीलों की बौछार छूटती है।",
    "TOOLBOT_PRIMARY_ALT1_NAME": "सरिया प्रक्षेपक",
    "TOOLBOT_PRIMARY_ALT1_DESCRIPTION": "लक्ष्यों को भेदने वाली सरिया चलाएँ, जो <style=cIsDamage>600% क्षति</style> पहुँचाती है।",
    "TOOLBOT_PRIMARY_ALT2_NAME": "कबाड़ प्रक्षेपक",
    "TOOLBOT_PRIMARY_ALT2_DESCRIPTION": "रॉकेट चलाएँ, जिसका विस्फोट <style=cIsDamage>360% क्षति</style> पहुँचाता है। 4 तक रख सकते हैं।",
    "TOOLBOT_PRIMARY_ALT3_NAME": "बिजली आरी",
    "TOOLBOT_PRIMARY_ALT3_DESCRIPTION": "पास के दुश्मनों को आरी से काटें और <style=cIsDamage>प्रति सेकंड 1000% क्षति</style> पहुँचाएँ।",
    "TOOLBOT_SECONDARY_NAME": "विस्फोटक कनस्तर",
    "TOOLBOT_SECONDARY_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। एक कनस्तर छोड़ें जो <style=cIsDamage>220% क्षति</style> पहुँचाता है। यह <style=cIsDamage>स्तब्धकारी</style> छोटे बम गिराता है जो <style=cIsDamage>5x44% क्षति</style> पहुँचाते हैं।",
    "TOOLBOT_UTILITY_NAME": "परिवहन मोड",
    "TOOLBOT_UTILITY_DESCRIPTION": "<style=cIsUtility>भारी</style>। आगे तेज़ी से बढ़ें और <style=cIsUtility>200 कवच</style> तथा <style=cIsUtility>220% चलने की गति</style> पाएँ। दुश्मनों को <style=cIsDamage>250% क्षति</style> पहुँचाता है।",
    "TOOLBOT_SPECIAL_NAME": "औज़ार बदलें",
    "TOOLBOT_SPECIAL_DESCRIPTION": "एक साथ <style=cIsUtility>दो उपकरण</style> रख सकते हैं। औज़ार बदलें सक्रिय करने पर <style=cIsUtility>सक्रिय उपकरण</style> और <style=cIsDamage>MUL-T का प्राथमिक हमला</style> बदल जाते हैं।",
    "TOOLBOT_SPECIAL_ALT_NAME": "शक्ति मोड",
    "TOOLBOT_SPECIAL_ALT_DESCRIPTION": "भारी मुद्रा अपनाएँ और दोनों <style=cIsDamage>प्राथमिक हमले</style> एक साथ इस्तेमाल करें। <style=cIsUtility>100 कवच</style> पाएँ, लेकिन <style=cIsHealth>चलने की गति -60%</style>।",
    "TOOLBOT_SPECIAL_ALT_QUIT_NAME": "शक्ति मोड छोड़ें",
    "TOOLBOT_SPECIAL_ALT_QUIT_DESCRIPTION": "शक्ति मोड छोड़कर सामान्य स्थिति में लौटें। बीप बीप!",
    "TOOLBOT_SKIN_ALT1_NAME": "सफ़ाईकर्मी",
    "TOOLBOT_SKIN_ALT2_NAME": "पहरेदार",
    "TOOLBOT_SKIN_ALT3_NAME": "चिड़ियों का घर",
    "TOOLBOT_SKIN_ALT4_NAME": "पीली टोपी",
    "BANDIT2_DESCRIPTION": "Bandit को कुशलता और हमलों के सही मेल की ज़रूरत है। वह छिपने और बाहर आने के बीच दुश्मनों की पीठ पर घातक वार कर सकता है।<style=cSub>\r\n\r\n< ! > छिपे रहते हुए बंदूक फिर भर सकते हैं। अगर खुले में वक्त गँवाना मुमकिन नहीं, तो छिपकर भरें!\r\n\r\n< ! > बत्ती गुल से सही समय पर कौशल की पुनर्प्रयोग अवधि रीसेट करना ज़िंदगी और मौत का फ़र्क हो सकता है।\r\n\r\n< ! > पीठ पर वार Bandit का अहम कौशल है, लेकिन मज़बूत नज़दीकी दुश्मनों के सामने जोखिमभरा हो सकता है।\r\n\r\n< ! > दाँतेदार धार का रक्तस्राव जमा होता है। कमज़ोर दुश्मनों पर बत्ती गुल से पुनर्प्रयोग अवधि रीसेट कर बॉस पर और रक्तस्राव जमा कर सकते हैं।\r\n</style>\r\n",
    "TOOLBOT_DESCRIPTION": "MUL-T आक्रामक उत्तरजीवी है जिसके पास हर काम का औज़ार है! <style=cSub>\r\n\r\n< ! > स्वचालित कील बंदूक बहुत ज़्यादा क्षति पहुँचाती है। इसकी कम दूरी इसे जोखिमभरा, मगर ताक़तवर बनाती है।\r\n\r\n< ! > परिवहन मोड से राक्षसों के छोटे समूहों को कुचल सकते हैं या बड़े राक्षसों को करारी चोट दे सकते हैं।\r\n\r\n< ! > विस्फोटक कनस्तर दुश्मनों के बड़े समूह को देर तक रोक सकता है। इससे आपको और आपके सहयोगियों को सही निशाना लगाने का वक्त मिलता है।\r\n\r\n< ! > बार-बार औज़ार बदलने से सरिया प्रक्षेपक कमज़ोर और नाज़ुक दुश्मनों को खत्म कर सकता है, जबकि स्वचालित कील बंदूक की क्षति ऊँची बनी रहती है।</style>\r\n",
    "ACHIEVEMENT_BANDIT2CLEARGAMEMONSOON_NAME": "Bandit: महारत",
    "ACHIEVEMENT_BANDIT2CLEARGAMEMONSOON_DESCRIPTION": "Bandit के रूप में Monsoon पर खेल जीतें या ओबिलिस्क पर अपना अस्तित्व मिटाएँ।",
    "ACHIEVEMENT_BANDIT2CONSECUTIVERESET_NAME": "Bandit: पुराना अंदाज़",
    "ACHIEVEMENT_BANDIT2CONSECUTIVERESET_DESCRIPTION": "Bandit के रूप में बत्ती गुल का सफल उपयोग कर लगातार 15 बार अपनी पुनर्प्रयोग अवधि रीसेट करें।",
    "ACHIEVEMENT_BANDIT2REVOLVERFINALE_NAME": "Bandit: सेंधमारी",
    "ACHIEVEMENT_BANDIT2REVOLVERFINALE_DESCRIPTION": "Bandit के रूप में बत्ती गुल से अंतिम बॉस को मारें।",
    "ACHIEVEMENT_BANDIT2STACKSUPERBLEED_NAME": "Bandit: परपीड़क",
    "ACHIEVEMENT_BANDIT2STACKSUPERBLEED_DESCRIPTION": "Bandit के रूप में ऐसे राक्षस को मारें जिस पर भीषण रक्तस्राव की 20 परतें हों।",
    "ACHIEVEMENT_BANDIT2CLEARULTIMA_NAME": "Bandit: मृत्यु को याद रखो",
    "ACHIEVEMENT_BANDIT2CLEARULTIMA_DESCRIPTION": "Bandit के रूप में Soulbound Threshold के द्वार के पार जो भी है, उसे हराएँ।",
    "ACHIEVEMENT_TOOLBOTGUARDTELEPORTER_NAME": "MUL-T: कीट नियंत्रण",
    "ACHIEVEMENT_TOOLBOTGUARDTELEPORTER_DESCRIPTION": "MUL-T के रूप में टेलीपोर्टर का क्षेत्र छोड़े बिना दो Beetle Queen हराएँ।",
    "ACHIEVEMENT_TOOLBOTKILLIMPBOSSWITHBFG_NAME": "MUL-T: पकड़ लिया!",
    "ACHIEVEMENT_TOOLBOTKILLIMPBOSSWITHBFG_DESCRIPTION": "MUL-T के रूप में Preon Accumulator से Imp Overlord पर अंतिम घातक वार करें।",
    "ACHIEVEMENT_TOOLBOTBEATARENALATER_NAME": "MUL-T: सातवाँ दिन",
    "ACHIEVEMENT_TOOLBOTBEATARENALATER_DESCRIPTION": "MUL-T के रूप में चरण 7 या बाद में Void Fields पूरा करें।",
    "ACHIEVEMENT_TOOLBOTCLEARGAMEMONSOON_NAME": "MUL-T: महारत",
    "ACHIEVEMENT_TOOLBOTCLEARGAMEMONSOON_DESCRIPTION": "MUL-T के रूप में Monsoon पर खेल जीतें या ओबिलिस्क पर अपना अस्तित्व मिटाएँ।",
    "ACHIEVEMENT_TOOLBOTCLEARGAMEHEXES_NAME": "MUL-T: तमाम बाधाओं के बावजूद",
    "ACHIEVEMENT_TOOLBOTCLEARGAMEHEXES_DESCRIPTION": "MUL-T के रूप में 10 अभिशाप लिए एक अभियान पूरा करें।",
    "COMMANDO_BODY_NAME": "Commando",
    "COMMANDO_BODY_SUBTITLE": "घिरा हुआ बंदूकबाज़",
    "COMMANDO_PRIMARY_NAME": "दोहरी गोली",
    "COMMANDO_PRIMARY_DESCRIPTION": "दुश्मन पर तेज़ी से गोली चलाकर <style=cIsDamage>100% क्षति</style> पहुँचाएँ।",
    "COMMANDO_SECONDARY_NAME": "फ़ेज़ गोली",
    "COMMANDO_SECONDARY_DESCRIPTION": "एक <style=cIsDamage>भेदी</style> गोली चलाएँ, जो <style=cIsDamage>300% क्षति</style> पहुँचाती है। हर दुश्मन को भेदने पर क्षति <style=cIsDamage>40%</style> बढ़ती है।",
    "COMMANDO_SECONDARY_ALT1_NAME": "फ़ेज़ धमाका",
    "COMMANDO_SECONDARY_ALT1_DESCRIPTION": "कम दूरी पर दो धमाके करें, जो कुल <style=cIsDamage>8x200% क्षति</style> पहुँचाते हैं।",
    "COMMANDO_UTILITY_NAME": "लुढ़ककर बचाव",
    "COMMANDO_UTILITY_DESCRIPTION": "थोड़ी दूरी तक <style=cIsUtility>लुढ़कें</style>।",
    "COMMANDO_UTILITY_ALT_NAME": "सामरिक स्लाइड",
    "COMMANDO_UTILITY_ALT_DESCRIPTION": "ज़मीन पर थोड़ी दूरी तक <style=cIsUtility>फिसलें</style>। आप <style=cIsDamage>फिसलते हुए गोली चला सकते हैं</style>।",
    "COMMANDO_SPECIAL_NAME": "दमनकारी गोलीबारी",
    "COMMANDO_SPECIAL_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। लगातार गोलियाँ चलाएँ। हर गोली <style=cIsDamage>100% क्षति</style> पहुँचाती है। हमले की गति बढ़ने पर ज़्यादा गोलियाँ चलती हैं।",
    "COMMANDO_SPECIAL_ALT1_NAME": "छर्रा ग्रेनेड",
    "COMMANDO_SPECIAL_ALT1_DESCRIPTION": "एक ग्रेनेड फेंकें, जिसके धमाके से <style=cIsDamage>700% क्षति</style> होती है। अधिकतम 2 ग्रेनेड रख सकते हैं।",
    "COMMANDO_DESCRIPTION": "Commando हर तरह की भूमिका निभा सकता है और खेल की हर स्थिति में भरोसेमंद है। <style=cSub>\r\n\r\n< ! > दोहरी गोली पास और दूर, दोनों से असरदार है। इसकी तेज़ गोलीबारी कई आइटम प्रभाव सक्रिय करती है।\r\n\r\n< ! > जिन हमलों के संकेत पहले से साफ़ दिखते हैं, उनसे बचने के लिए सही समय पर लुढ़ककर बचें।\r\n\r\n< ! > दमनकारी गोलीबारी से एक दुश्मन को बार-बार या कई दुश्मनों को एक साथ स्तब्ध कर सकते हैं।\r\n\r\n< ! > फ़ेज़ गोलियाँ दीवारों को भेद सकती हैं। इसका फ़ायदा उठाएँ!\r\n</style>\r\n",
    "COMMANDO_SKIN_ALT1_NAME": "हॉर्नेट",
    "COMMANDO_SKIN_ALT2_NAME": "हीलॉट",
    "COMMANDO_SKIN_ALT3_NAME": "अधिगृहीत",
    "COMMANDO_SKIN_ALT4_NAME": "विदीर्ण",
    "COMMANDO_SPECIAL_ALT2_NAME": "तोड़फोड़",
    "COMMANDO_SPECIAL_ALT2_DESCRIPTION": "3 विस्फोटक फेंकें, जो सतहों से <style=cIsUtility>चिपक जाते हैं</style>। उन पर <style=cIsDamage>हमला करने</style> पर वे दुश्मनों को <style=cIsDamage>झटका देकर</style> <style=cIsDamage>400% क्षति</style> पहुँचाते हैं।",
    "HUNTRESS_BODY_NAME": "Huntress",
    "HUNTRESS_BODY_SUBTITLE": "न्यायाधीश, निर्णायक मंडल और जल्लाद",
    "HUNTRESS_PRIMARY_NAME": "तेज़ तीर",
    "HUNTRESS_PRIMARY_DESCRIPTION": "<style=cIsUtility>फुर्तीला</style>। लक्ष्य का पीछा करने वाला तीर तेज़ी से चलाकर <style=cIsDamage>150% क्षति</style> पहुँचाएँ।",
    "HUNTRESS_PRIMARY_ALT_NAME": "तीरों की बौछार",
    "HUNTRESS_PRIMARY_ALT_DESCRIPTION": "<style=cIsUtility>फुर्तीला</style>। धनुष खींचकर लक्ष्य का पीछा करने वाले <style=cIsDamage>3</style> तीर छोड़ें, जो <style=cIsDamage>3x100% क्षति</style> पहुँचाते हैं। क्रिटिकल हिट होने पर <style=cIsDamage>6</style> तीर छूटते हैं।",
    "HUNTRESS_SECONDARY_NAME": "लेज़र ग्लेव",
    "HUNTRESS_SECONDARY_DESCRIPTION": "लक्ष्य का पीछा करने वाला ग्लेव फेंकें, जो अधिकतम <style=cIsDamage>6</style> बार उछलता है और <style=cIsDamage>250% क्षति</style> पहुँचाता है। हर उछाल पर क्षति <style=cIsDamage>10%</style> बढ़ती है।",
    "HUNTRESS_UTILITY_NAME": "पलक झपक",
    "HUNTRESS_UTILITY_DESCRIPTION": "<style=cIsUtility>गायब हों</style> और आगे <style=cIsUtility>टेलीपोर्ट करें</style>।",
    "HUNTRESS_UTILITY_ALT1_NAME": "फ़ेज़ झपक",
    "HUNTRESS_UTILITY_ALT1_DESCRIPTION": "<style=cIsUtility>फुर्तीला</style>। <style=cIsUtility>गायब हों</style> और थोड़ी दूरी तक <style=cIsUtility>टेलीपोर्ट करें</style>। अधिकतम <style=cIsUtility>3</style> चार्ज जमा कर सकते हैं।",
    "HUNTRESS_SPECIAL_NAME": "तीरों की बारिश",
    "HUNTRESS_SPECIAL_DESCRIPTION": "आसमान में <style=cIsUtility>टेलीपोर्ट करें</style>। किसी क्षेत्र पर तीरों की बारिश करें, जिससे सभी दुश्मन <style=cIsUtility>धीमे होते हैं</style> और उन्हें <style=cIsDamage>प्रति सेकंड 225% क्षति</style> पहुँचती है।",
    "HUNTRESS_SPECIAL_ALT1_NAME": "बैलिस्टा",
    "HUNTRESS_SPECIAL_ALT1_DESCRIPTION": "पीछे की ओर आसमान में <style=cIsUtility>टेलीपोर्ट करें</style>। <style=cIsDamage>3</style> तक ऊर्जा-बाण चलाएँ, जो <style=cIsDamage>3x900% क्षति</style> पहुँचाते हैं।",
    "HUNTRESS_DESCRIPTION": "Huntress बेहद फुर्तीली है और भारी क्षति पहुँचाती है, लेकिन नाज़ुक है। <style=cSub>\r\n\r\n< ! > तेज़ तीर दौड़ते हुए भी चला सकती हैं। इससे पूरी रफ़्तार बनाए रखते हुए खतरों से निपट सकती हैं।\r\n\r\n< ! > पलक झपक और तीरों की बारिश से दुश्मनों के पास जा सकती हैं या मुश्किल में हमले से बच सकती हैं।\r\n\r\n< ! > दो मज़बूत दुश्मनों के बीच उछलता हुआ लेज़र ग्लेव दोनों को जल्दी ढेर कर देता है।\r\n\r\n< ! > तीरों की बारिश भारी क्षति पहुँचाती है और क्षेत्र के दुश्मनों को धीमा कर देती है। यह तेज़ और मज़बूत दुश्मनों पर कारगर है।</style>\r\n",
    "HUNTRESS_SKIN_ALT1_NAME": "आर्कटिक",
    "HUNTRESS_SKIN_ALT2_NAME": "वन प्रदेश",
    "HUNTRESS_SKIN_ALT3_NAME": "परभक्षी",
    "HUNTRESS_SKIN_ALT4_NAME": "वेस्पर",
    "HUNTRESS_SECONDARY_ALT_NAME": "लेज़र चक्रवात",
    "HUNTRESS_SECONDARY_ALT_DESCRIPTION": "घूमता हुआ ग्लेव फेंकें, जो <style=cIsDamage>प्रति सेकंड 400% क्षति</style> पहुँचाता है। ग्लेव पकड़ते समय वही बटन फिर दबाएँ ताकि उसे दोबारा उछाल सकें। हर बार ऐसा करने पर क्षति <style=cIsDamage>+400%</style> बढ़ती है।",
    "KEYWORD_AGILE": "<style=cKeywordName>फुर्तीला</style><style=cSub>यह कौशल दौड़ते हुए भी इस्तेमाल कर सकते हैं।</style>",
    "KEYWORD_STUNNING": "<style=cKeywordName>स्तब्धकारी</style><style=cSub>दुश्मनों की क्रिया रोकता है और उन्हें थोड़ी देर के लिए स्तब्ध कर देता है।</style>",
    "ENGI_BODY_NAME": "Engineer",
    "ENGI_PRIMARY_NAME": "उछलते ग्रेनेड",
    "ENGI_PRIMARY_DESCRIPTION": "<style=cIsDamage>8</style> ग्रेनेड तक चार्ज करें। हर एक <style=cIsDamage>100% क्षति</style> पहुँचाता है।",
    "ENGI_PRIMARY_ALT_NAME": "लेज़र कटर",
    "ENGI_PRIMARY_ALT_DESCRIPTION": "एक भारी लेज़र चार्ज करें, जो <style=cIsDamage>प्रति सेकंड 270%-630% क्षति</style> पहुँचाता है और बुर्जों व ड्रोन की <style=cIsHealing>मरम्मत</style> करता है।",
    "ENGI_SECONDARY_NAME": "दबाव वाली बारूदी सुरंगें",
    "ENGI_SECONDARY_DESCRIPTION": "दो चरण वाली बारूदी सुरंग रखें, जो <style=cIsDamage>300% क्षति</style> पहुँचाती है। पूरी तरह सक्रिय होने पर यह <style=cIsDamage>900% क्षति</style> पहुँचाती है। 4 तक रख सकते हैं।",
    "ENGI_SPIDERMINE_NAME": "मकड़ी सुरंगें",
    "ENGI_SPIDERMINE_DESCRIPTION": "एक रोबोटिक सुरंग रखें जो किसी दुश्मन के पास आने पर <style=cIsDamage>600% क्षति</style> पहुँचाती है। 4 तक रख सकते हैं।",
    "ENGI_UTILITY_NAME": "गोलाकार ढाल",
    "ENGI_UTILITY_DESCRIPTION": "एक <style=cIsUtility>अभेद्य ढाल</style> लगाएँ, जो सामने से आने वाली सारी क्षति रोकती है।",
    "ENGI_SPECIAL_NAME": "TR12 स्वचालित गाउस बुर्ज",
    "ENGI_SPECIAL_DESCRIPTION": "एक बुर्ज रखें, जिसे <style=cIsUtility>आपकी सभी वस्तुएँ विरासत में मिलती हैं।</style> इसकी तोप <style=cIsDamage>100% क्षति</style> पहुँचाती है। 2 तक रख सकते हैं।",
    "ENGI_SPECIAL_ALT1_NAME": "TR58 कार्बनाइज़र बुर्ज",
    "ENGI_SPECIAL_ALT1_DESCRIPTION": "एक <style=cIsUtility>चलायमान</style> बुर्ज रखें, जिसे <style=cIsUtility>आपकी सभी वस्तुएँ विरासत में मिलती हैं।</style> इसका लेज़र <style=cIsDamage>प्रति सेकंड 200% क्षति</style> पहुँचाता है और <style=cIsUtility>दुश्मनों को धीमा करता है</style>। 2 तक रख सकते हैं।",
    "ENGI_SKILL_HARPOON_NAME": "ताप-संवेदी हार्पून",
    "ENGI_SKILL_HARPOON_DESCRIPTION": "<style=cIsUtility>लक्ष्य चिह्नित करने का मोड</style> चालू करें और ताप का पीछा करने वाली हार्पून मिसाइलें छोड़ें। हर मिसाइल <style=cIsDamage>500% क्षति</style> पहुँचाती है। 4 तक जमा रख सकते हैं।",
    "ENGI_SKILL_PAINT_NAME": "लक्ष्य चिह्नित करें",
    "ENGI_SKILL_PAINT_DESCRIPTION": "ताप-संवेदी हार्पून के लिए लक्ष्य चिह्नित करने हेतु बटन दबाए रखें।",
    "ENGI_SKIN_ALT1_NAME": "बम निष्क्रियकरण विशेषज्ञ",
    "ENGI_SKIN_ALT2_NAME": "HC तकनीशियन",
    "ENGI_SKIN_ALT3_NAME": "बचाए गए पुर्ज़े",
    "ENGI_SKIN_ALT4_NAME": "Nautilus",
    "MAGE_BODY_NAME": "Artificer",
    "MAGE_PASSIVE_NAME": "ENV सूट",
    "MAGE_PASSIVE_DESCRIPTION": "कूद बटन दबाए रखने पर Artificer <style=cIsUtility>हवा में मँडराती है</style>।",
    "MAGE_PRIMARY_FIRE_NAME": "ज्वाला गोला",
    "MAGE_PRIMARY_FIRE_DESCRIPTION": "<style=cIsDamage>आग लगाएँ</style>। <style=cIsUtility>तेज़</style>। एक गोला चलाएँ जो दुश्मनों को <style=cIsDamage>280% क्षति</style> पहुँचाता है। 4 तक जमा रख सकते हैं।",
    "MAGE_PRIMARY_LIGHTNING_NAME": "प्लाज़्मा गोला",
    "MAGE_PRIMARY_LIGHTNING_DESCRIPTION": "<style=cIsUtility>तेज़</style>। एक गोला चलाएँ जो <style=cIsDamage>280% क्षति</style> पहुँचाता है और छोटे क्षेत्र में <style=cIsDamage>फटता</style> है। 4 तक जमा रख सकते हैं।",
    "MAGE_SECONDARY_LIGHTNING_NAME": "आवेशित नैनो बम",
    "MAGE_SECONDARY_LIGHTNING_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। एक <style=cIsDamage>विस्फोटक</style> नैनो बम चार्ज करें, जो <style=cIsDamage>400%-2000%</style> क्षति पहुँचाता है।",
    "MAGE_SECONDARY_ICE_NAME": "नैनो भाला प्रक्षेपण",
    "MAGE_SECONDARY_ICE_DESCRIPTION": "<style=cIsUtility>जमा देने वाला</style>। लक्ष्य को <style=cIsDamage>भेदने वाला</style> नैनो भाला चार्ज करें, जो <style=cIsDamage>400%-1200%</style> क्षति पहुँचाता है।",
    "MAGE_UTILITY_ICE_NAME": "झटपट जमाव",
    "MAGE_UTILITY_ICE_DESCRIPTION": "<style=cIsUtility>जमा देने वाला</style>। एक दीवार बनाएँ जो दुश्मनों को <style=cIsDamage>100% क्षति</style> पहुँचाती है।",
    "MAGE_UTILITY_ALT_NAME": "भूगर्भीय धमाका",
    "MAGE_UTILITY_ALT_DESCRIPTION": "टुकड़ों की बौछार छोड़ें, जो <style=cIsDamage>8x100% क्षति</style> पहुँचाती है और दुश्मनों पर <style=cIsUtility>तेल</style> चढ़ाती है।",
    "MAGE_SPECIAL_FIRE_NAME": "अग्निक्षेपक",
    "MAGE_SPECIAL_FIRE_DESCRIPTION": "<style=cIsDamage>आग लगाएँ</style>। सामने के सभी दुश्मनों को जलाकर <style=cIsDamage>2000% क्षति</style> पहुँचाएँ।",
    "MAGE_SPECIAL_LIGHTNING_NAME": "आयन उछाल",
    "MAGE_SPECIAL_LIGHTNING_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। आसमान में उछलें और <style=cIsDamage>800% क्षति</style> पहुँचाएँ।",
    "MAGE_SKIN_ALT1_NAME": "क्रोम",
    "MAGE_SKIN_ALT2_NAME": "Meridian",
    "MAGE_SKIN_ALT3_NAME": "संरचना",
    "MAGE_SKIN_ALT4_NAME": "ऐंड्राडाइट",
    "ENGI_DESCRIPTION": "Engineer एक अनोखी श्रेणी है जिसकी सफलता अच्छी योजना और सही जगह चुनने पर निर्भर है।<style=cSub>\r\n\r\n< ! > पहले से सुरंगें बिछाकर अपने किनारों और तंग गलियारों की रक्षा कर सकते हैं।\r\n\r\n< ! > Engineer गाउस बुर्जों पर बहुत निर्भर है। उन्हें ऐसी जगह लगाएँ जहाँ वे सुरक्षित हों और आपको बढ़त दें।\r\n \r\n< ! > साफ़ संकेत देने वाले बॉस के हमलों के ख़िलाफ़ गोलाकार ढाल कारगर है। यह आपके सहयोगियों की रक्षा भी कर सकती है!\r\n\r\n< ! > उछलते ग्रेनेड ताक़तवर हैं, लेकिन हिलते लक्ष्यों पर लगाना मुश्किल है। तेज़ या उड़ने वाले राक्षसों से निपटने के लिए अपने बुर्ज बचाए रखें।\r\n</style>\r\n",
    "MAGE_DESCRIPTION": "Artificer कम समय में भारी क्षति पहुँचाती है और दुश्मनों के बड़े समूहों व बॉस से लड़ने में माहिर है। <style=cSub>\r\n\r\n< ! > ज्वाला गोले के चार्ज तेज़ी से खर्च होते हैं और धीरे लौटते हैं। दूसरे कौशलों के बीच बुनियादी हमले डालें।\r\n\r\n< ! > आवेशित नैनो बम सीधे निशाने पर लगे तो हारती हुई लड़ाई भी पलट सकती है।\r\n\r\n< ! > कम स्वास्थ्य पर जमे हुए दुश्मन तुरंत मारे जाते हैं। यह मज़बूत दुश्मनों को खत्म करने में कारगर है।\r\n\r\n< ! > याद रखें, Artificer के पास कोई रक्षात्मक कौशल नहीं है। सही जगह चुनना और रक्षात्मक वस्तुएँ अहम हैं!</style>\r\n",
    "LOADER_BODY_NAME": "Loader",
    "LOADER_PASSIVE_NAME": "कबाड़ अवरोध",
    "LOADER_PASSIVE_DESCRIPTION": "Loader गिरने से होने वाली क्षति से <style=cIsUtility>प्रतिरक्षित है</style>। मुट्ठी वाले दस्तानों से दुश्मनों पर वार करने से <style=cIsHealing>अस्थायी अवरोध</style> मिलता है।",
    "LOADER_PRIMARY_NAME": "धमाकेदार मुक्का",
    "LOADER_PRIMARY_DESCRIPTION": "आस-पास के दुश्मनों पर मुक्का चलाकर <style=cIsDamage>320% क्षति</style> पहुँचाएँ।",
    "LOADER_SECONDARY_NAME": "पकड़ने वाली मुट्ठी",
    "LOADER_SECONDARY_DESCRIPTION": "दस्ताना आगे दागें, जो आपको लक्ष्य की ओर <style=cIsUtility>खींचता है</style>।",
    "LOADER_YANKHOOK_NAME": "काँटेदार मुट्ठी",
    "LOADER_YANKHOOK_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। आगे दस्ताना दागकर <style=cIsDamage>320% क्षति</style> पहुँचाएँ। यह आपको भारी लक्ष्यों की ओर <style=cIsUtility>खींचता है</style>। हल्के लक्ष्य <style=cIsUtility>आपकी ओर खिंचते हैं</style>।",
    "LOADER_UTILITY_NAME": "आवेशित दस्ताना",
    "LOADER_UTILITY_DESCRIPTION": "<style=cIsUtility>भारी</style>। लक्ष्य <style=cIsUtility>भेदने वाला</style> मुक्का चार्ज करें जो <style=cIsDamage>600%-2700% क्षति</style> पहुँचाता है।",
    "LOADER_UTILITY_ALT1_NAME": "वज्र दस्ताना",
    "LOADER_UTILITY_ALT1_DESCRIPTION": "<style=cIsUtility>भारी</style>। <style=cIsUtility>एक लक्ष्य</style> पर लगने वाला मुक्का चार्ज करें, जो <style=cIsDamage>2100% क्षति</style> पहुँचाता है और शंक्वाकार क्षेत्र के दुश्मनों को <style=cIsDamage>बिजली का झटका</style> देकर <style=cIsDamage>1000% क्षति</style> पहुँचाता है।",
    "LOADER_SPECIAL_NAME": "M551 स्तंभ",
    "LOADER_SPECIAL_DESCRIPTION": "तैरता हुआ स्तंभ फेंकें, जो <style=cIsDamage>बिजली के झटके</style> देकर पास के <style=cIsDamage>6</style> दुश्मनों तक को <style=cIsDamage>100% क्षति</style> पहुँचाता है। इसे <style=cIsUtility>हुक से पकड़ सकते हैं</style>।",
    "LOADER_SPECIAL_ALT_NAME": "वज्र प्रहार",
    "LOADER_SPECIAL_ALT_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। मुट्ठियाँ नीचे पटकें। टक्कर पर <style=cIsDamage>2000%</style> क्षति होती है।",
    "LOADER_SKIN_ALT1_NAME": "क्लासिक",
    "LOADER_SKIN_ALT2_NAME": "नवयुग",
    "LOADER_SKIN_ALT3_NAME": "बोझमुक्त",
    "LOADER_SKIN_ALT4_NAME": "ट्रफ़ल",
    "CROCO_BODY_NAME": "Acrid",
    "CROCO_PASSIVE_NAME": "ज़हर",
    "CROCO_PASSIVE_DESCRIPTION": "<style=cIsHealing>विषैले</style> हमले समय के साथ भारी क्षति पहुँचाते हैं।",
    "CROCO_PASSIVE_ALT_NAME": "झुलसा",
    "CROCO_PASSIVE_ALT_DESCRIPTION": "जिन वारों से <style=cIsHealing>ज़हर</style> लगता है, वे उसकी जगह जमा होने वाला <style=cIsDamage>झुलसा</style> लगाते हैं, जो <style=cIsDamage>प्रति सेकंड 60% क्षति</style> पहुँचाता है।",
    "CROCO_PRIMARY_NAME": "घातक घाव",
    "CROCO_PRIMARY_DESCRIPTION": "दुश्मन को नोचकर <style=cIsDamage>200% क्षति</style> पहुँचाएँ। हर 3वाँ वार <style=cIsHealing>पुनर्जीवी</style> है और <style=cIsDamage>400% क्षति</style> पहुँचाता है।",
    "CROCO_SECONDARY_NAME": "तंत्रिका विष",
    "CROCO_SECONDARY_DESCRIPTION": "<style=cIsHealing>विषैला</style>। ज़हरीला पित्त थूककर <style=cIsDamage>240% क्षति</style> पहुँचाएँ।",
    "CROCO_SECONDARY_ALT_NAME": "भूखी काट",
    "CROCO_SECONDARY_ALT_DESCRIPTION": "<style=cIsHealing>विषैला</style>। <style=cIsDamage>संहारक</style>। <style=cIsHealing>पुनर्जीवी</style>। दुश्मन को काटकर <style=cIsDamage>310% क्षति</style> पहुँचाएँ।",
    "CROCO_UTILITY_NAME": "तेज़ाबी छलाँग",
    "CROCO_UTILITY_DESCRIPTION": "<style=cIsHealing>विषैला</style>। <style=cIsDamage>स्तब्धकारी</style>। हवा में छलाँग लगाकर <style=cIsDamage>320% क्षति</style> पहुँचाएँ। पीछे तेज़ाब छोड़ें जो <style=cIsDamage>25% क्षति</style> पहुँचाता है।",
    "CROCO_UTILITY_ALT1_NAME": "उन्मादी छलाँग",
    "CROCO_UTILITY_ALT1_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। हवा में छलाँग लगाकर <style=cIsDamage>550% क्षति</style> पहुँचाएँ। हर दुश्मन को वार लगने पर पुनर्प्रयोग अवधि में <style=cIsUtility>कमी</style> आती है, ठीक <style=cIsUtility>2 सेकंड</style> की।",
    "CROCO_SPECIAL_NAME": "महामारी",
    "CROCO_SPECIAL_DESCRIPTION": "<style=cIsHealing>विषैला</style>। एक घातक बीमारी छोड़ें, जो <style=cIsDamage>100% क्षति</style> पहुँचाती है। यह <style=cIsDamage>20</style> लक्ष्यों तक फैलती है।",
    "CROCO_SPECIAL_ALT_NAME": "दमघोंटू साँस",
    "CROCO_SPECIAL_ALT_DESCRIPTION": "<style=cIsHealing>विषैला</style>। ज़हरीली साँस का देर तक रहने वाला बादल छोड़ें, जो <style=cIsDamage>प्रति सेकंड 240% क्षति</style> पहुँचाता है।",
    "CROCO_SKIN_ALT1_NAME": "वर्णहीन",
    "CROCO_SKIN_ALT2_NAME": "Iguania",
    "CROCO_SKIN_ALT3_NAME": "फिर से जंगली",
    "CROCO_SKIN_ALT4_NAME": "आदिम",
    "LOADER_DESCRIPTION": "Loader धीमी मगर ताक़तवर योद्धा है, जो हुक की मदद से इलाकों को अनोखे ढंग से पार करती है। <style=cSub>\r\n\r\n< ! > कबाड़ अवरोध Loader को तब तक लड़ाई में टिकाए रखता है, जब तक आप मुक्के चलाते रहें।\r\n\r\n< ! > पकड़ने वाली मुट्ठी से तेज़ी से आगे बढ़ें, हमलों से बचें या रफ़्तार बढ़ाकर आवेशित दस्ताने की क्षति में भारी इज़ाफ़ा करें!\r\n\r\n< ! > आवेशित दस्ताना दुश्मन से दूरी घटाने और पास के दुश्मनों पर ज़ोरदार अंतिम वार करने, दोनों के काम आता है।\r\n\r\n< ! > याद रखें, आप और आपकी सहयोगी Loader दोनों M551 स्तंभ पर अपना हुक लगा सकते हैं।</style>\r\n",
    "CROCO_DESCRIPTION": "Acrid पास और दूर, दोनों से लड़ता है। ताक़तवर ज़हर दुश्मनों की मज़बूत सेहत भी घुला देता है। <style=cSub>\r\n\r\n< ! > ज़हर समय के साथ बहुत भारी क्षति पहुँचाता है। इसे जितनी बार हो सके लगाएँ!\r\n\r\n< ! > ज़हर दुश्मनों का स्वास्थ्य 1 अंक पर छोड़ देता है। ऐसी वस्तुओं और ड्रोन को प्राथमिकता दें जो उनका काम तमाम कर दें।\r\n\r\n< ! > Acrid के पास प्राकृतिक बचाव नहीं हैं। वार करके पीछे हटने की रणनीति से आप जीवित रह सकते हैं।\r\n\r\n< ! > तंत्रिका विष का कम पुनर्प्रयोग समय ज़रूरत पड़ने पर Acrid को दूर से लड़ने में मदद करता है।\r\n</style>",
    "MERC_BODY_NAME": "Mercenary",
    "MERC_PRIMARY_NAME": "लेज़र तलवार",
    "MERC_PRIMARY_DESCRIPTION": "<style=cIsUtility>फुर्तीला</style>। सामने तलवार चलाकर <style=cIsDamage>130% क्षति</style> पहुँचाएँ। हर 3वें वार का दायरा बड़ा होता है और वह दुश्मनों को <style=cIsUtility>अरक्षित करता है</style>।",
    "MERC_SECONDARY_NAME": "बवंडर",
    "MERC_SECONDARY_DESCRIPTION": "तेज़ी से दो आड़े वार करें, जो <style=cIsDamage>2x200% क्षति</style> पहुँचाते हैं। हवा में हों तो ऊपर-नीचे वार करें।",
    "MERC_SECONDARY_ALT1_NAME": "उठता वज्र",
    "MERC_SECONDARY_ALT1_DESCRIPTION": "ऊपर की ओर तलवार चलाकर <style=cIsDamage>550% क्षति</style> पहुँचाएँ और हवा में उछलें।",
    "MERC_UTILITY_NAME": "चौंधियाता धावा",
    "MERC_UTILITY_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। आगे धावा बोलकर <style=cIsDamage>300% क्षति</style> पहुँचाएँ। अगर दुश्मन पर वार लगता है, तो <style=cIsDamage>फिर धावा बोल सकते हैं</style>। कुल <style=cIsDamage>3</style> बार तक।",
    "MERC_UTILITY_ALT1_NAME": "सधा हुआ धावा",
    "MERC_UTILITY_ALT1_DESCRIPTION": "<style=cIsDamage>स्तब्धकारी</style>। आगे धावा बोलें। <style=cIsDamage>700% क्षति</style> पहुँचती है और दुश्मन <style=cIsUtility>अरक्षित</style> हो जाते हैं, <style=cIsUtility>1 सेकंड</style> बाद।",
    "MERC_SPECIAL_NAME": "अंतड़ियाँ चीरें",
    "MERC_SPECIAL_DESCRIPTION": "सबसे नज़दीकी दुश्मन को निशाना बनाकर बार-बार वार करें। हर वार <style=cIsDamage>110% क्षति</style> पहुँचाता है। <style=cIsUtility>इस दौरान आप पर कोई वार नहीं लग सकता</style>।",
    "MERC_SPECIAL_ALT1_NAME": "काटती हवाएँ",
    "MERC_SPECIAL_ALT1_DESCRIPTION": "धारों की आँधी छोड़ें जो <style=cIsDamage>3</style> दुश्मनों तक पर हमला कर <style=cIsDamage>8x100% क्षति</style> पहुँचाती है। आख़िरी वार दुश्मनों को <style=cIsUtility>अरक्षित करता है</style>।",
    "MERC_PASSIVE_NAME": "साइबरनेटिक संवर्द्धन",
    "MERC_PASSIVE_DESCRIPTION": "Mercenary <style=cIsUtility>दो बार कूद सकता है</style>।",
    "MERC_SKIN_ALT1_NAME": "Oni",
    "MERC_SKIN_ALT2_NAME": "नाज़ुक",
    "MERC_SKIN_ALT4_NAME": "हत्या",
    "MERC_SKIN_ALT5_NAME": "राइज़ीन",
    "TREEBOT_BODY_NAME": "REX",
    "TREEBOT_PASSIVE_NAME": "प्राकृतिक विष",
    "TREEBOT_PASSIVE_DESCRIPTION": "कुछ हमले जिन दुश्मनों को लगते हैं, उन्हें <style=cIsDamage>कमज़ोर करते हैं</style>। इससे उनकी चाल, कवच और क्षति घटती है।",
    "TREEBOT_PRIMARY_NAME": "निर्देश: इंजेक्शन",
    "TREEBOT_PRIMARY_DESCRIPTION": "3 सिरिंज चलाएँ जो <style=cIsDamage>3x80% क्षति</style> पहुँचाती हैं। आख़िरी सिरिंज दुश्मन को <style=cIsDamage>कमज़ोर करती है</style> और <style=cIsHealing>पहुँचाई गई क्षति के 60% के बराबर स्वास्थ्य लौटाती है</style>।",
    "TREEBOT_SECONDARY_NAME": "बीजों की बौछार",
    "TREEBOT_SECONDARY_DESCRIPTION": "<style=cIsHealth>15% स्वास्थ्य</style>। आसमान में मोर्टार का गोला दागकर <style=cIsDamage>450% क्षति</style> पहुँचाएँ।",
    "TREEBOT_SECONDARY_ALT1_NAME": "निर्देश: वेधन",
    "TREEBOT_SECONDARY_ALT1_DESCRIPTION": "बीज-गोलियों की कतार आसमान में छोड़ें। वे बरसकर <style=cIsDamage>प्रति सेकंड 450% क्षति</style> पहुँचाती हैं।",
    "TREEBOT_UTILITY_NAME": "निर्देश: तितर-बितर",
    "TREEBOT_UTILITY_DESCRIPTION": "<style=cIsUtility>ध्वनि धमाका</style> छोड़ें, जो सभी प्रभावित दुश्मनों को <style=cIsDamage>कमज़ोर करता है</style>।",
    "TREEBOT_UTILITY_ALT1_NAME": "काँटों की बौछार",
    "TREEBOT_UTILITY_ALT1_DESCRIPTION": "<style=cIsHealth>20% स्वास्थ्य</style>। <style=cIsUtility>ध्वनि धमाका</style> छोड़ें जो दुश्मनों को <style=cIsDamage>ज़ख़्मी करता है</style> और <style=cIsDamage>550% क्षति</style> पहुँचाता है। <style=cIsHealing>हर प्रभावित लक्ष्य पर स्वास्थ्य लौटता है</style>।",
    "TREEBOT_UTILITY_ALT2_NAME": "प्रसार",
    "TREEBOT_UTILITY_ALT2_DESCRIPTION": "<style=cIsHealth>20% स्वास्थ्य</style>। एक फूल फेंकें जो गोली चलाकर <style=cIsDamage>200%</style> क्षति पहुँचाता है। फूल पर <style=cIsUtility>उपयोगिता कौशल</style> इस्तेमाल करने से उसके पास टेलीपोर्ट होते हैं, फूल खर्च होता है और <style=cIsHealing>20% स्वास्थ्य</style> वापस मिलता है। दो तक रख सकते हैं।",
    "TREEBOT_UTILITY_ALT2_2_NAME": "टेलीपोर्ट",
    "TREEBOT_UTILITY_ALT2_2_DESCRIPTION": "फूल के पास टेलीपोर्ट होकर उसे ख़र्च करें और <style=cIsHealing>20% स्वास्थ्य</style> वापस पाएँ।",
    "TREEBOT_SPECIAL_NAME": "उलझाती बेलें",
    "TREEBOT_SPECIAL_DESCRIPTION": "<style=cIsHealth>25% स्वास्थ्य</style>। एक फूल चलाएँ जो दुश्मनों को <style=cIsDamage>जकड़कर</style> <style=cIsDamage>200% क्षति</style> पहुँचाता है। <style=cIsHealing>हर प्रभावित लक्ष्य पर स्वास्थ्य लौटता है</style>।",
    "TREEBOT_SPECIAL_ALT1_NAME": "निर्देश: फ़सल काटें",
    "TREEBOT_SPECIAL_ALT1_DESCRIPTION": "एक गोला चलाएँ जो <style=cIsDamage>330% क्षति</style> पहुँचाकर दुश्मन को <style=cIsDamage>इंजेक्शन देता है</style>। मरने पर वह कई <style=cIsHealing>उपचारक फल</style> गिराता है, जो <style=cIsHealing>25% स्वास्थ्य</style> वापस देते हैं।",
    "TREEBOT_SKIN_ALT1_NAME": "स्मूदी",
    "TREEBOT_SKIN_ALT2_NAME": "हरा-भरा",
    "TREEBOT_SKIN_ALT3_NAME": "शाखा मिलाएँ",
    "TREEBOT_SKIN_ALT4_NAME": "कठोर",
    "MERC_DESCRIPTION": "Mercenary नज़दीक से लड़ने वाला उत्तरजीवी है जिसे बहुत कुशलता चाहिए। वह कई तरीकों से बचते हुए लड़ाई में आता-जाता है।<style=cSub>\r\n\r\n< ! > मुश्किल में, हवा में बवंडर का इस्तेमाल एक और छलाँग की तरह कर सकते हैं।\r\n\r\n< ! > चौंधियाते धावे की पुनर्प्रयोग अवधि बार-बार रीसेट करने से बचाव और क्षति, दोनों बढ़ते हैं। हर बार रीसेट करने की कोशिश ज़रूरी नहीं, क्योंकि इससे आपकी जान भी जा सकती है।\r\n\r\n< ! > याद रखें, साफ़ संकेत वाले हमलों से बचने के लिए अंतड़ियाँ चीरें बहुत कारगर है।\r\n\r\n< ! > लेज़र तलवार बड़े क्षेत्र में भारी क्षति पहुँचाती है, जो बुनियादी हमले के लिए अनोखी बात है।\r\n</style>\r\n",
    "TREEBOT_DESCRIPTION": "REX आधा रोबोट, आधा पौधा है और दूर से विनाशकारी कौशल चलाने के लिए स्वास्थ्य ख़र्च करता है। इस ग्रह पर पौधा या रोबोट अकेले जीवित नहीं रह सकता। अच्छी बात है कि वे एक-दूसरे के साथ हैं। <style=cSub>\r\n\r\n< ! > प्राकृतिक विष से ख़तरनाक दुश्मन कमज़ोर होते हैं, जिससे आपको और आपके सहयोगियों को फ़ायदा होता है।\r\n\r\n< ! > बीजों की बौछार किसी भी दूरी से चला सकते हैं और उसका पुनर्प्रयोग समय बहुत कम है। बस अपने स्वास्थ्य पर नज़र रखें!\r\n\r\n< ! > निर्देश: तितर-बितर से दुश्मनों को दूर धकेल सकते हैं। इससे उड़ते राक्षसों को दीवार पर पटककर मार भी सकते हैं।\r\n\r\n< ! > सही निशाने पर उलझाती बेलें लगें तो REX लड़ता रह सकता है। कई राक्षसों को जकड़ने से कौशल में ख़र्च हुआ शुरुआती स्वास्थ्य ज़रूर लौट आता है।</style>\r\n"
  }
}
