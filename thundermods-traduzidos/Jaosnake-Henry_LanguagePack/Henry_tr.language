{
    "tr": {
        "ROB_HENRY_BODY_NAME": "Henry",
        "ROB_HENRY_BODY_DESCRIPTION": "Henry, düşmanlarını alt etmek için geniş bir silah cephaneliği kullanan yetenekli bir savaşçıdır.<color=#CCD3E0>\n\n< ! > Kılıç çok yönlüdür; Boks Eldivenleri güçlü düşmanları dövmek için daha uygundur.\n\n< ! > Tabanca kısa bekleme süresi ve yüksek hasarıyla havadaki düşmanlara karşı etkilidir.\n\n< ! > Takla sonrasında zırh bonusu kısa süre kalır; bu sayede saldırgan biçimde kullanılabilir.\n\n< ! > Bomba ile düşman gruplarını kolayca temizleyebilirsin.</color>",
        "ROB_HENRY_BODY_SUBTITLE": "Seçilmiş Kişi",
        "ROB_HENRY_BODY_LORE": "örnek hikaye",
        "ROB_HENRY_BODY_OUTRO_FLAVOR": "..ve böylece ayrıldı, yeni bir kimlik arayışıyla.",
        "ROB_HENRY_BODY_OUTRO_FAILURE": "..ve böylece yok oldu, sonsuza dek boş bir sayfa.",
        "ROB_HENRY_BODY_DEFAULT_SKIN_NAME": "Varsayılan",
        "ROB_HENRY_BODY_MASTERY_SKIN_NAME": "Alternatif",
        "ROB_HENRY_BODY_TYPHOON_SKIN_NAME": "V1",
        "ROB_HENRY_BODY_DANTE_SKIN_NAME": "Dante",
        "ROB_HENRY_BODY_VERGIL_SKIN_NAME": "Vergil",
        "ROB_HENRY_BODY_SAMURAI_SKIN_NAME": "Samuray",
        "ROB_HENRY_BODY_SOLDIER_SKIN_NAME": "Şampiyon",
        "ROB_HENRY_BODY_ZOMBIE_SKIN_NAME": "Zombi",
        "ROB_HENRY_BODY_SKELETON_SKIN_NAME": "İskelet",
        "ROB_HENRY_BODY_PASSIVE_NAME": "Henry pasifi",
        "ROB_HENRY_BODY_PASSIVE_DESCRIPTION": "Örnek metin.",
        "ROB_HENRY_BODY_PRIMARY_SLASH_NAME": "Kılıç",
        "ROB_HENRY_BODY_PRIMARY_SLASH_DESCRIPTION": "<style=cIsUtility>Çevik.</style> İleri doğru savurarak <style=cIsDamage>%280 hasar</style> verir.",
        "ROB_HENRY_BODY_PRIMARY_PUNCH_NAME": "Boks Eldivenleri",
        "ROB_HENRY_BODY_PRIMARY_PUNCH_DESCRIPTION": "<style=cIsUtility>Çevik.</style> Hızlı yumruklarla <style=cIsDamage>240% hasar</style> ver. <style=cIsUtility>Zırhı yok sayar.</style>",
        "ROB_HENRY_BODY_PRIMARY_GUN_NAME": "Tabanca",
        "ROB_HENRY_BODY_PRIMARY_GUN_DESCRIPTION": "<style=cIsUtility>Çevik.</style> Küçük bir tabancayla <style=cIsDamage>90% hasar</style> ver.",
        "ROB_HENRY_BODY_SECONDARY_GUN_NAME": "Tabanca",
        "ROB_HENRY_BODY_SECONDARY_GUN_DESCRIPTION": "<style=cIsUtility>Çevik.</style> Bir tabanca ateşleyerek <style=cIsDamage>%420 hasar</style> verir.",
        "ROB_HENRY_BODY_SECONDARY_STINGER_NAME": "Stinger",
        "ROB_HENRY_BODY_SECONDARY_STINGER_DESCRIPTION": "<style=cIsUtility>Çevik.</style> Bir düşmana atılarak <style=cIsDamage>450% hasar</style> ver.",
        "ROB_HENRY_BODY_SECONDARY_UZI_NAME": "Uzi",
        "ROB_HENRY_BODY_SECONDARY_UZI_DESCRIPTION": "Uzi ile <style=cIsDamage>75% hasar</style> ver.",
        "ROB_HENRY_BODY_UTILITY_ROLL_NAME": "Takla",
        "ROB_HENRY_BODY_UTILITY_ROLL_DESCRIPTION": "Kısa bir mesafe yuvarlan, <style=cIsUtility>300 zırh</style> kazan. <style=cIsUtility>Takla sırasında vurulamazsın.</style>",
        "ROB_HENRY_BODY_UTILITY_SHOTGUN_NAME": "Shotgun",
        "ROB_HENRY_BODY_UTILITY_SHOTGUN_DESCRIPTION": "<style=cIsUtility>Shotgun</style> ateşleyerek <style=cIsDamage>14x140% hasar</style> ver ve geri tepme ile kendini fırlat.",
        "ROB_HENRY_BODY_SPECIAL_BOMB_NAME": "Bomba",
        "ROB_HENRY_BODY_SPECIAL_BOMB_DESCRIPTION": "Bir bomba fırlatarak <style=cIsDamage>%1600 hasar</style> verir.",
        "ROB_HENRY_BODY_SPECIAL_SCEPBOMB_NAME": "Daha Fazla Bomba!",
        "ROB_HENRY_BODY_SPECIAL_SCEPBOMB_DESCRIPTION": "<style=cIsDamage>1600% hasar</style> veren bir bomba at.\n<color=#d299ff>SCEPTER: 4 bombaya kadar tut. Bekleme süresi yarıya iner.</color>",
        "ROB_HENRY_BODY_SPECIAL_BAZOOKA_NAME": "Bazooka",
        "ROB_HENRY_BODY_SPECIAL_BAZOOKA_DESCRIPTION": "Roketleri şarj edip ateşle, <style=cIsDamage>600%-1600% hasar</style> ver.",
        "ROB_HENRY_BODY_PRIMARY_BAZOOKA_NAME": "Ateş Et",
        "ROB_HENRY_BODY_PRIMARY_BAZOOKA_DESCRIPTION": "Bir roket şarj edip ateşle, <style=cIsDamage>600%-1600% hasar</style> ver.",
        "ROB_HENRY_BODY_PRIMARY_BAZOOKAOUT_NAME": "İptal",
        "ROB_HENRY_BODY_PRIMARY_BAZOOKAOUT_DESCRIPTION": "<style=cIsDamage>Bazooka</style> silahını kaldır.",
        "ROB_HENRY_BODY_SPECIAL_SCEPBAZOOKA_NAME": "Armageddon",
        "ROB_HENRY_BODY_SPECIAL_SCEPBAZOOKA_DESCRIPTION": "Roketleri şarj edip ateşle, <style=cIsDamage>600%-1600% hasar</style> ver.\n<color=#d299ff>SCEPTER: aynı anda iki Bazooka tut.</color>",
        "ROB_HENRY_BODY_PRIMARY_SCEPBAZOOKA_NAME": "Ateş Et",
        "ROB_HENRY_BODY_PRIMARY_SCEPBAZOOKA_DESCRIPTION": "Bir roket şarj edip ateşle, <style=cIsDamage>600%-1600% hasar</style> ver.\n<color=#d299ff>SCEPTER: aynı anda iki Bazooka tut.</color>",
        "ROB_HENRY_BODY_SPECIAL_FRENZY_NAME": "Rampage",
        "ROB_HENRY_BODY_SPECIAL_FRENZY_DESCRIPTION": "Vuruşlarla <style=cIsHealth>Fury</style> biriktir. Tam dolunca <style=cIsUtility>10 saniye</style> boyunca <style=cIsDamage>çılgınlığa</style> gir. <style=cIsHealth>Düşük canda daha hızlı dolar.</style>",
        "ROB_HENRY_BODY_SPECIAL_SCEPFRENZY_NAME": "Super Saiyan",
        "ROB_HENRY_BODY_SPECIAL_SCEPFRENZY_DESCRIPTION": "Yakın mesafedeki birincil saldırı isabetleriyle veya herhangi bir yakın dövüş saldırısıyla <style=cIsHealth>Fury</style> biriktir. Tam dolduğunda kullanarak <style=cIsUtility>10 saniye</style> boyunca <style=cIsDamage>çılgınlığa</style> gir. <style=cIsHealth>Can azaldıkça daha hızlı dolar.</style>\n<color=#d299ff>SCEPTER: Özellik bonusları büyük ölçüde artar. Süre uzar.</color>",
        "ACHIEVEMENT_ROB_HENRY_BODY_UNLOCKABLE_ACHIEVEMENT_ID_NAME": "Prelude",
        "ACHIEVEMENT_ROB_HENRY_BODY_UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Titanic Plains’e gir.",
        "ACHIEVEMENT_ROB_HENRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Henry: Mastery",
        "ACHIEVEMENT_ROB_HENRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Henry olarak oyunu bitir veya Monsoon’da kendini yok et.",
        "ACHIEVEMENT_ROB_HENRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Henry: Grand Mastery",
        "ACHIEVEMENT_ROB_HENRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Henry olarak oyunu Typhoon ya da Eclipse’te bitir veya kendini yok et.\n<color=#8888>(Typhoon veya üzeri her zorluk sayılır)</color>",
        "ROB_HENRY_BODY_DANTEUNLOCKABLE_ACHIEVEMENT_NAME": "Henry: Jackpot",
        "ROB_HENRY_BODY_DANTEUNLOCKABLE_ACHIEVEMENT_DESC": "As Henry, defeat a Twisted Scavenger on Monsoon.",
        "ROB_HENRY_BODY_DANTEUNLOCKABLE_UNLOCKABLE_NAME": "Henry: Jackpot",
        "ROB_HENRY_BODY_VERGILUNLOCKABLE_ACHIEVEMENT_NAME": "Henry: 200% Motivated",
        "ROB_HENRY_BODY_VERGILUNLOCKABLE_ACHIEVEMENT_DESC": "As Henry, defeat the King of Nothing with no items.",
        "ROB_HENRY_BODY_VERGILUNLOCKABLE_UNLOCKABLE_NAME": "Henry: 200% Motivated",
        "ACHIEVEMENT_ROB_HENRY_MASTERYACHIEVEMENT_NAME": "Henry: Mastery",
        "ACHIEVEMENT_ROB_HENRY_MASTERYACHIEVEMENT_DESCRIPTION": "Henry olarak oyunu kazan ya da Muson'da yok ol.",
        "ROB_MRGREEN_BODY_NAME": "Mr. Green",
        "ROB_MRGREEN_BODY_DESCRIPTION": "Mr. Green<color=#CCD3E0>\n\n< ! > Kılıç her duruma uygundur; boks eldivenleri ise güçlü düşmanları alt etmekte daha etkilidir.\n\n< ! > Tabanca, yüksek hasarı ve kısa bekleme süresiyle havadaki düşmanlara karşı etkilidir.\n\n< ! > Yuvarlanmadan sonra zırh artışı bir süre devam eder ve saldırgan oynamayı kolaylaştırır.\n\n< ! > Bomba, düşman gruplarını kolayca temizler.</color>",
        "ROB_MRGREEN_BODY_SUBTITLE": "The",
        "ROB_MRGREEN_BODY_LORE": "örnek hikaye bölüm 2",
        "ROB_MRGREEN_BODY_OUTRO_FLAVOR": "..and so he left, bottom text.",
        "ROB_MRGREEN_BODY_DEFAULT_SKIN_NAME": "Varsayılan",
        "ROB_MRGREEN_BODY_PASSIVE_NAME": "Mr. Green pasifi",
        "ROB_MRGREEN_BODY_PASSIVE_DESCRIPTION": "Örnek metin.",
        "ROB_MRGREEN_BODY_PRIMARY_PUNCH_NAME": "Martial Arts",
        "ROB_MRGREEN_BODY_PRIMARY_PUNCH_DESCRIPTION": "Hızlı yumruk ve tekme kombosu yaparak <style=cIsDamage>90% hasar</style> ver.",
        "ROB_MRGREEN_BODY_SECONDARY_CLONETHROW_NAME": "Klon Fırlat",
        "ROB_MRGREEN_BODY_SECONDARY_CLONETHROW_DESCRIPTION": "Bir klon çağırıp ileri fırlat; yakındaki düşmanları yakalayarak yere çarpıp <style=cIsDamage>420% hasar</style> ver.",
        "ROB_MRGREEN_BODY_UTILITY_DASH_NAME": "People's Elbow",
        "ROB_MRGREEN_BODY_UTILITY_DASH_DESCRIPTION": "Kısa mesafe atıl. Bir <style=cIsUtility>klona</style> temas edince havaya sıçra ve güçlü bir <style=cIsUtility>dirsek darbesiyle</style> <style=cIsDamage>800% hasar</style> ver.",
        "ROB_MRGREEN_BODY_SPECIAL_RES_NAME": "Resurrection",
        "ROB_MRGREEN_BODY_SPECIAL_RES_DESCRIPTION": "Düşen tüm klonları diriltir.",
        "ROB_NEMRY_BODY_NAME": "Nemesis Henry",
        "ROB_NEMRY_BODY_DESCRIPTION": "Nemesis Henry, saldırılarını güçlendirmek için enerji depolayan özel bir kılıç kullanan tehlikeli bir savaşçıdır. Becerilerinin bekleme süresi yoktur, ancak enerjisini iyi yönetmelidir.<color=#CCD3E0>\n\n< ! > Sword Mode enerji biriktirir; Gun Mode ise güçlü saldırılar için enerji harcar.\n\n< ! > Daha fazla hasar vermek için Swordmaster becerisini şarj edebilirsin.\n\n< ! > Flash Step, saldırgan biçimde yaklaşırken enerji biriktirmeye yardımcı olur.\n\n< ! > İyileşmek için Hydra Bite, yüksek hasar vermek için Hyper Beam kullan.</color>",
        "ROB_NEMRY_BODY_SUBTITLE": "Düşmüş Olan",
        "ROB_NEMRY_BODY_LORE": "örnek hikaye",
        "ROB_NEMRY_BODY_OUTRO_FLAVOR": "..and so he left, having blown up the moon for no discernible reason.",
        "ROB_NEMRY_BODY_OUTRO_FAILURE": "..he tried so hard, and got so far. But in the end it doesn't even matter.",
        "ROB_NEMRY_BODY_DEFAULT_SKIN_NAME": "Nemesis",
        "ROB_NEMRY_BODY_MASTERY_SKIN_NAME": "Captive #001",
        "ROB_NEMRY_BODY_TYPHOON_SKIN_NAME": "FLLFFL",
        "ROB_NEMRY_BODY_PASSIVE_NAME": "Asidik Gunblade",
        "ROB_NEMRY_BODY_PASSIVE_DESCRIPTION": "Nemesis Henry, Sword Mode ile Gun Mode arasında geçiş yapabilen özel bir silah kullanır. Becerilerinin normal bekleme süresi yoktur; bunun yerine kılıcının <style=cIsHealing>Enerji</style> sistemine bağlıdır.",
        "ROB_NEMRY_BODY_PRIMARY_SPEAR_NAME": "Şişle",
        "ROB_NEMRY_BODY_PRIMARY_SPEAR_DESCRIPTION": "<style=cIsUtility>Çevik.</style> İleri saplayarak <style=cIsDamage>%160 hasar</style> ver. <style=cIsDamage>Uç kısmı iki kat hasar verir ve verilen hasarın <style=cIsHealing>%50</style> kadarıyla iyileştirir</style>.",
        "ROB_WEAPON_SWAP_SKILL": "Weapon Swap",
        "ROB_NEMRY_BODY_PRIMARY_SWORD_NAME": "Sword Mode",
        "ROB_NEMRY_BODY_PRIMARY_SWORD_DESCRIPTION": "Kılıcını ileri savurarak <style=cIsDamage>%280 hasar</style> ver. İsabet halinde <style=cIsHealing>%20 Enerji</style> üret.",
        "ROB_NEMRY_BODY_PRIMARY_GUN_NAME": "Gun Mode",
        "ROB_NEMRY_BODY_PRIMARY_GUN_DESCRIPTION": "<style=cIsHealing>%2,5 Enerji.</style> <style=cIsDamage>%240 hasar</style> veren delici bir <style=cIsHealing>Enerji</style> atışı yap.",
        "ROB_NEMRY_BODY_PRIMARY_SWORDCSS_NAME": "Sword Mode / Gun Mode",
        "ROB_NEMRY_BODY_PRIMARY_SWORDCSS_DESCRIPTION": "Kılıcını ileri savurarak <style=cIsDamage>%280 hasar</style> ver. İsabet halinde <style=cIsHealing>%20 Enerji</style> üret.\n<style=cIsHealing>%2,5 Enerji.</style> <style=cIsDamage>%240 hasar</style> veren delici bir <style=cIsHealing>Enerji</style> atışı yap.",
        "ROB_NEMRY_BODY_SECONDARY_BLAST_NAME": "Null Blast",
        "ROB_NEMRY_BODY_SECONDARY_BLAST_DESCRIPTION": "<style=cIsUtility>Çevik.</style> <style=cIsDamage>%200 hasar</style> veren bir <style=cIsHealth>gizemli enerji</style> küresi fırlat.",
        "ROB_NEMRY_BODY_SECONDARY_CHARGE_NAME": "Swordmaster",
        "ROB_NEMRY_BODY_SECONDARY_CHARGE_DESCRIPTION": "<style=cIsHealing>%10 Enerji.</style> Yakındaki bir düşmana atılarak <style=cIsDamage>%700 hasar</style> ver. Düşman yakın dövüş menzilindeyse bunun yerine bir kombo saldırısı yap.",
        "ROB_NEMRY_BODY_SECONDARY_TORRENT_NAME": "Gunslinger",
        "ROB_NEMRY_BODY_SECONDARY_TORRENT_DESCRIPTION": "<style=cIsHealing>%5 Enerji.</style> Art arda <style=cIsHealing>Enerji</style> atışları yap. Ateş etmeye devam etmek için basılı tut; her atış daha fazla <style=cIsHealing>Enerji</style> tüketir.",
        "ROB_NEMRY_BODY_SECONDARY_CHARGECSS_NAME": "Swordmaster / Gunslinger",
        "ROB_NEMRY_BODY_SECONDARY_CHARGECSS_DESCRIPTION": "<style=cIsHealing>%10 Enerji.</style> Yakındaki bir düşmana atılarak <style=cIsDamage>%700 hasar</style> ver. Düşman yakın dövüş menzilindeyse bunun yerine bir kombo saldırısı yap.\n<style=cIsHealing>%5 Enerji.</style> Art arda <style=cIsHealing>Enerji</style> atışları yap. Ateş etmeye devam etmek için basılı tut; her atış daha fazla <style=cIsHealing>Enerji</style> tüketir.",
        "ROB_NEMRY_BODY_UTILITY_DODGESLASH_NAME": "Hızlı Kesik",
        "ROB_NEMRY_BODY_UTILITY_DODGESLASH_DESCRIPTION": "Geri takla atarak yakındaki düşmanları kes ve <style=cIsDamage>%300 hasar</style> ver. <style=cIsUtility>Takla sırasında vurulamazsın.</style>",
        "ROB_NEMRY_BODY_UTILITY_BLINK_NAME": "Flash Step",
        "ROB_NEMRY_BODY_UTILITY_BLINK_DESCRIPTION": "<style=cIsHealing>%5 Enerji.</style> Yakındaki bir düşmana <style=cIsUtility>anında ışınlan</style>.",
        "ROB_NEMRY_BODY_UTILITY_BURST_NAME": "Enerji Patlaması",
        "ROB_NEMRY_BODY_UTILITY_BURST_DESCRIPTION": "<style=cIsHealing>%10 Enerji.</style> <style=cIsDamage>%400 hasar</style> veren bir <style=cIsHealing>Enerji</style> patlaması oluştur ve <style=cIsUtility>geri tepmeyle kendini fırlat</style>.",
        "ROB_NEMRY_BODY_UTILITY_BLINKCSS_NAME": "Flash Step / Enerji Patlaması",
        "ROB_NEMRY_BODY_UTILITY_BLINKCSS_DESCRIPTION": "<style=cIsHealing>%5 Enerji.</style> Yakındaki bir düşmana <style=cIsUtility>anında ışınlan</style>.\n<style=cIsHealing>%10 Enerji.</style> <style=cIsDamage>%400 hasar</style> veren bir <style=cIsHealing>Enerji</style> patlaması oluştur ve <style=cIsUtility>geri tepmeyle kendini fırlat</style>.",
        "ROB_NEMRY_BODY_SPECIAL_STAB_NAME": "Hydra Bite",
        "ROB_NEMRY_BODY_SPECIAL_STAB_DESCRIPTION": "<style=cIsHealing>%100 Enerji.</style> Kılıcını düşmana saplayarak <style=cIsDamage>%2800 hasar</style> ver ve güçlü bir zayıflatma uygula. <style=cIsHealing>Verilen hasarın %50 kadarıyla iyileş.</style>",
        "ROB_NEMRY_BODY_SPECIAL_BEAM_NAME": "Hyper Beam",
        "ROB_NEMRY_BODY_SPECIAL_BEAM_DESCRIPTION": "<style=cIsHealing>%100 Enerji.</style> <style=cIsDamage>10x%540 hasar</style> veren güçlü bir lazer yağmuru yükle.",
        "ROB_NEMRY_BODY_SPECIAL_STABCSS_NAME": "Hydra Bite / Hyper Beam",
        "ROB_NEMRY_BODY_SPECIAL_STABCSS_DESCRIPTION": "<style=cIsHealing>%100 Enerji.</style> Kılıcını düşmana saplayarak <style=cIsDamage>%2800 hasar</style> ver ve güçlü bir zayıflatma uygula. <style=cIsHealing>Verilen hasarın %50 kadarıyla iyileş.</style>\n<style=cIsHealing>%100 Enerji.</style> <style=cIsDamage>çok yüksek hasar</style> veren güçlü bir ışın yükle.",
        "ROB_NEMRY_BODY_UNLOCKABLE_ACHIEVEMENT_NAME": "???",
        "ROB_NEMRY_BODY_UNLOCKABLE_ACHIEVEMENT_DESC": "Defeat Henry's Vestige.",
        "ROB_NEMRY_BODY_UNLOCKABLE_UNLOCKABLE_NAME": "???",
        "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Nemesis Henry: Mastery",
        "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "As Nemesis Henry, beat the game or obliterate on Monsoon.",
        "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Nemesis Henry: Mastery",
        "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "Nemesis Henry: Grand Mastery",
        "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "As Nemesis Henry, beat the game or obliterate on Typhoon.",
        "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "Nemesis Henry: Grand Mastery"
    }
}
