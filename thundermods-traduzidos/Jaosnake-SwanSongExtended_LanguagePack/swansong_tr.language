    "EQUIPMENT_BROKENZAPINATOR_NAME": "Turuncu Zapinator",
    "EQUIPMENT_BROKENZAPINATOR_PICKUP": "<style=cIsUtility>Bunu oyunda bıraktığımıza inanamıyorum!</style>",
    "EQUIPMENT_BROKENZAPINATOR_DESCRIPTION": "Bir mermi ateşler.",
    "EQUIPMENT_NINJAGEAR_NAME": "Usta Ninja Ekipmanı",
    "EQUIPMENT_NINJAGEAR_PICKUP": "Gelen saldırılardan kaçınma şansı verir. Atılmak ve sis bombası bırakmak için etkinleştir.",
    "EQUIPMENT_NINJAGEAR_DESCRIPTION": "<style=cIsUtility>25m ileri atılmak</style> için etkinleştir ve gelen saldırılardan <style=cIsHealing>kaçınmak</style> için <style=cIsHealing>%20 şans</style> kazan. Atılmak ve kaçınmak, 13m içindeki düşmanları <style=cIsUtility>1 saniye</style> boyunca <style=cIsUtility>sersemleten</style> bir <style=cIsDamage>sis bombası</style> bırakır.",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_NAME": "Ölü Doğan Dua",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_PICKUP": "Tek bir dilek bahşeder...",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_DESCRIPTION": "Seçtiğin Sıra Dışı bir eşya verir.",
    "EQUIPMENT_THEMACHINE_NAME": "Makine",
    "EQUIPMENT_THEMACHINE_PICKUP": "Hiçbir şey yapmıyor. Güzelliği de burada!",
    "EQUIPMENT_THEMACHINE_DESCRIPTION": "Hiçbir şey yapmıyor. Güzelliği de burada!",
    "EQUIPMENT_TESLAEQUIPMENT_NAME": "Şaşırtıcı Derecede Kararlı Tesla Bobini",
    "EQUIPMENT_TESLAEQUIPMENT_PICKUP": "Yakındaki düşmanlara elektrik çarpar ve öldürmede Kalkanları yeniler.",
    "EQUIPMENT_TESLAEQUIPMENT_DESCRIPTION": "Kendini <style=cIsUtility>10.0 saniye</style> boyunca <style=cIsUtility>Elektriklendir</style>. <style=cIsUtility>Elektrikliyken</style> yapılan öldürmeler yakındaki <style=cIsDamage>4.0</style> düşmana <style=cIsDamage>%200 hasar</style> verir ve <style=cIsHealing>kalkanlarının %15'ini yeniler</style>. Pasif olarak <style=cIsHealing>maksimum canının %20'sine</style> eşit bir <style=cIsHealing>kalkan</style> kazan.",
    "EQUIPMENT_TESLAEQUIPMENT_LORE": "<style=cMono>Tesla Sunum Yazılımı v1.14\nAçılıyor...\n10...</style>\nKarşılama beyanı yayınlanıyor...\n<style=cMono>9...</style>\nHepiniz hoş geldiniz!\n<style=cMono>8...</style>\nLütfen yerlerinize oturun.\n<style=cMono>7...</style>\nArkanızdakilerin görebildiğinden emin olun.\n<style=cMono>6...</style>\nSunum birazdan başlayacaktır.\n<style=cMono>5...</style>\nGüvenliğiniz için lütfen personele uyun.\n<style=cMono>4...\nOda ortam aydınlatması başlatılıyor...\n3...</style>\nGörmeye hazır olun...\n<style=cMono>2...</style>\nMuhteşem harikalarını...\n<style=cMono>1...</style>\nElektriğin!\n<style=cMono>Güç anomalisi algılandı...\n10.0 içinde yeniden başlatma prosedürü başlatılıyor...</style>",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_NAME": "Chir’in Temposu",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_PICKUP": "Hızın bir sureti ol.",
