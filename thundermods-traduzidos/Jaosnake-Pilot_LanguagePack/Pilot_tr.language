        "MOFFEIN_PILOT_BODY_PRIMARY_SILENCER_NAME": "Bastırılmış Ateş",
        "MOFFEIN_PILOT_BODY_PRIMARY_SILENCER_DESCRIPTION": "<style=cIsDamage>Avcı</style>. Susturuculu tabancanızı ateşleyerek <style=cIsDamage>%100 hasar</style> verin.",
        "MOFFEIN_PILOT_BODY_SECONDARY_NAME": "Hedef kilitlendi!",
