    "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK povas kolekti <color=#FFFF00>Sxlosilkartojn U.C.</color> por malfermi <style=cIsDamage>armilujojn</style> kaj pligrandigi sian arsenalon.",
    "ROB_HUNK_BODY_PPASSIVE2_NAME": "Forgesita Soldato",
    "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "La unua <style=cIsHealth>cxefmalamiko</style>, kiu mortas en cxiu etapo, faligas <style=cIsDamage>provizpakon</style> enhavantan unu armilon aux akcesorajxon.",
    "ROB_HUNK_BODY_PASSIVE_NAME": "Kruela Lukto",
    "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Komencu kun <style=cIsDamage>LE 5</style> kaj <style=cIsDamage>flankarmilo</style>. Vi povas <style=cIsDamage>trasercxi</style> <style=cIsUtility>kestojn</style> por trovi municion.",
    "ROB_HUNK_BODY_PASSIVE2_NAME": "Proksimigxanta Teruro",
    "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "Komencu kun <style=cIsDamage>plena arsenalo</style>, <style=cIsHealth>SED</style> vi nun estas <style=cIsHealth>nekapabla akiri plian municion</style>.",
    "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "Nova Ludo+",
    "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Komencu kun <style=cIsDamage>LE 5</style> kaj <style=cIsDamage>flankarmilo</style>. Vi povas <style=cIsDamage>trasercxi</style> <style=cIsUtility>kestojn</style> por trovi municion. <style=cIsHealth>La enhavo de cxiuj armilujoj estas hazardigita.</style>",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Supera Auxtoritato",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "Komencu kun <style=cIsHealth>NUR</style> <style=cIsDamage>W-870</style>. Vi povas <style=cIsDamage>trasercxi</style> <style=cIsUtility>kestojn</style> por trovi municion.",
    "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Ultima Soldulo",
    "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Komencu kun <style=cIsHealth>NUR</style> <style=cIsDamage>plene plibonigita LE 5</style>. Vi povas <style=cIsDamage>trasercxi</style> <style=cIsUtility>kestojn</style> por trovi municion. <style=cIsDamage>Speciala</style> estas anstatauxigita de <color=#C80202>Tumulta Regximo</color>.",
    "ROB_HUNK_BODY_WPASSIVE_NAME": "Kompleta Tutmonda Saturo",
    "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "Komencu kun <style=cIsHealth>NUR</style> <style=cIsDamage>flankarmilo</style>. Vi povas <style=cIsDamage>trasercxi</style> <style=cIsUtility>kestojn</style> por trovi municion. <style=cIsDamage>Utila</style> estas anstatauxigita de <color=#C80202>Uroboros</color>.",
    "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Piromanio",
    "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "Komencu kun <style=cIsHealth>NUR</style> <style=cIsDamage>Kemia Flamjxetilo</style>. Vi povas <style=cIsDamage>trasercxi</style> <style=cIsUtility>kestojn</style> por trovi municion. <style=cIsHealth>Nur UNU armilujo aperas en cxiu etapo.</style>",
