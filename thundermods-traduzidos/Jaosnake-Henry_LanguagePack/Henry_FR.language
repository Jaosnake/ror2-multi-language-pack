{
  "FR": {
    "ROB_HENRY_BODY_NAME": "Henry",
    "ROB_HENRY_BODY_DESCRIPTION": "Henry est un combattant talentueux qui utilise un vaste arsenal d'armes pour abattre ses ennemis.<color=#CCD3E0>\n\n< ! > L'Épée est polyvalente, tandis que les Gants de Boxe sont meilleurs pour tabasser les ennemis plus puissants.\n\n< ! > Le Pistolet est un puissant antiaérien grâce à son court délai de récupération et ses dégâts élevés.\n\n< ! > La Roulade laisse un bonus d'armure persistant qui aide à l'utiliser de façon agressive.\n\n< ! > La Bombe permet de balayer des foules avec facilité.</color>",
    "ROB_HENRY_BODY_SUBTITLE": "L'Élu",
    "ROB_HENRY_BODY_LORE": "histoire d'exemple",
    "ROB_HENRY_BODY_OUTRO_FLAVOR": "..et ainsi il partit, à la recherche d'une nouvelle identité.",
    "ROB_HENRY_BODY_OUTRO_FAILURE": "..et ainsi il disparut, à jamais une page blanche.",
    "ROB_HENRY_BODY_DEFAULT_SKIN_NAME": "Par défaut",
    "ROB_HENRY_BODY_MASTERY_SKIN_NAME": "Alternatif",
    "ROB_HENRY_BODY_TYPHOON_SKIN_NAME": "V1",
    "ROB_HENRY_BODY_DANTE_SKIN_NAME": "Dante",
    "ROB_HENRY_BODY_VERGIL_SKIN_NAME": "Vergil",
    "ROB_HENRY_BODY_SAMURAI_SKIN_NAME": "Samouraï",
    "ROB_HENRY_BODY_SOLDIER_SKIN_NAME": "Champion",
    "ROB_HENRY_BODY_ZOMBIE_SKIN_NAME": "Zombie",
    "ROB_HENRY_BODY_SKELETON_SKIN_NAME": "Squelette",
    "ROB_HENRY_BODY_PASSIVE_NAME": "Passif d'Henry",
    "ROB_HENRY_BODY_PASSIVE_DESCRIPTION": "Texte d'exemple.",
    "ROB_HENRY_BODY_PRIMARY_SLASH_NAME": "Épée",
    "ROB_HENRY_BODY_PRIMARY_SLASH_DESCRIPTION": "<style=cIsUtility>Agile.</style> Frappez vers l'avant pour <style=cIsDamage>280% de dégâts</style>.",
    "ROB_HENRY_BODY_PRIMARY_PUNCH_NAME": "Gants de Boxe",
    "ROB_HENRY_BODY_PRIMARY_PUNCH_DESCRIPTION": "<style=cIsUtility>Agile.</style> Frappez rapidement pour <style=cIsDamage>240% de dégâts</style>. <style=cIsUtility>Ignore l'armure.</style>",
    "ROB_HENRY_BODY_PRIMARY_GUN_NAME": "Pistolet",
    "ROB_HENRY_BODY_PRIMARY_GUN_DESCRIPTION": "<style=cIsUtility>Agile.</style> Tirez avec un petit pistolet pour <style=cIsDamage>90% de dégâts</style>.",
    "ROB_HENRY_BODY_SECONDARY_GUN_NAME": "Arme de Poing",
    "ROB_HENRY_BODY_SECONDARY_GUN_DESCRIPTION": "<style=cIsUtility>Agile.</style> Tirez avec une arme de poing pour <style=cIsDamage>420% de dégâts</style>.",
    "ROB_HENRY_BODY_SECONDARY_STINGER_NAME": "Stinger",
    "ROB_HENRY_BODY_SECONDARY_STINGER_DESCRIPTION": "<style=cIsUtility>Agile.</style> Foncez sur un ennemi pour <style=cIsDamage>450% de dégâts</style>.",
    "ROB_HENRY_BODY_SECONDARY_UZI_NAME": "Uzi",
    "ROB_HENRY_BODY_SECONDARY_UZI_DESCRIPTION": "Tirez avec un Uzi pour <style=cIsDamage>75% de dégâts</style>.",
    "ROB_HENRY_BODY_UTILITY_ROLL_NAME": "Roulade",
    "ROB_HENRY_BODY_UTILITY_ROLL_DESCRIPTION": "Roulez sur une courte distance en gagnant <style=cIsUtility>300 d'armure</style>. <style=cIsUtility>Vous ne pouvez pas être touché pendant la roulade.</style>",
    "ROB_HENRY_BODY_UTILITY_SHOTGUN_NAME": "Fusil à Pompe",
    "ROB_HENRY_BODY_UTILITY_SHOTGUN_DESCRIPTION": "Tirez avec un <style=cIsUtility>fusil à pompe</style> pour <style=cIsDamage>14x140% de dégâts</style>, en vous propulsant avec le recul.",
    "ROB_HENRY_BODY_SPECIAL_BOMB_NAME": "Bombe",
    "ROB_HENRY_BODY_SPECIAL_BOMB_DESCRIPTION": "Lancez une bombe pour <style=cIsDamage>1600% de dégâts</style>.",
    "ROB_HENRY_BODY_SPECIAL_SCEPBOMB_NAME": "Plus de Bombes !",
    "ROB_HENRY_BODY_SPECIAL_SCEPBOMB_DESCRIPTION": "Lancez une bombe pour <style=cIsDamage>1600% de dégâts</style>.\n<color=#d299ff>SCEPTER : stockez jusqu'à 4 bombes. Le temps de recharge est réduit de moitié.</color>",
    "ROB_HENRY_BODY_SPECIAL_BAZOOKA_NAME": "Bazooka",
    "ROB_HENRY_BODY_SPECIAL_BAZOOKA_DESCRIPTION": "Chargez et tirez des roquettes pour <style=cIsDamage>600%-1600% de dégâts</style>.",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKA_NAME": "Tirer",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKA_DESCRIPTION": "Chargez et tirez une roquette pour <style=cIsDamage>600%-1600% de dégâts</style>.",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKAOUT_NAME": "Annuler",
    "ROB_HENRY_BODY_PRIMARY_BAZOOKAOUT_DESCRIPTION": "Rangez votre <style=cIsDamage>bazooka</style>.",
    "ROB_HENRY_BODY_SPECIAL_SCEPBAZOOKA_NAME": "Armageddon",
    "ROB_HENRY_BODY_SPECIAL_SCEPBAZOOKA_DESCRIPTION": "Chargez et tirez des roquettes pour <style=cIsDamage>600%-1600% de dégâts</style>.\n<color=#d299ff>SCEPTER : maniez deux Bazookas à la fois.</color>",
    "ROB_HENRY_BODY_PRIMARY_SCEPBAZOOKA_NAME": "Tirer",
    "ROB_HENRY_BODY_PRIMARY_SCEPBAZOOKA_DESCRIPTION": "Chargez et tirez une roquette pour <style=cIsDamage>600%-1600% de dégâts</style>.\n<color=#d299ff>SCEPTER : maniez deux Bazookas à la fois.</color>",
    "ROB_HENRY_BODY_SPECIAL_FRENZY_NAME": "Déchaînement",
    "ROB_HENRY_BODY_SPECIAL_FRENZY_DESCRIPTION": "Accumulez de la <style=cIsHealth>Fureur</style> en touchant. Utilisez-la à pleine charge pour entrer en <style=cIsDamage>frénésie</style> pendant <style=cIsUtility>10 secondes</style>. <style=cIsHealth>Se charge plus vite à faible santé.</style>",
    "ROB_HENRY_BODY_SPECIAL_SCEPFRENZY_NAME": "Super Saiyan",
    "ROB_HENRY_BODY_SPECIAL_SCEPFRENZY_DESCRIPTION": "Accumulez de la <style=cIsHealth>Fureur</style> avec vos attaques principales à courte portée ou toute attaque de mêlée. Utilisez-la à pleine charge pour entrer en <style=cIsDamage>frénésie</style> pendant <style=cIsUtility>10 secondes</style>. <style=cIsHealth>Se charge plus vite à faible santé.</style>\n<color=#d299ff>SCEPTER : bonus de statistiques massivement augmentés. Durée augmentée.</color>",
    "ACHIEVEMENT_ROB_HENRY_BODY_UNLOCKABLE_ACHIEVEMENT_ID_NAME": "Prélude",
    "ACHIEVEMENT_ROB_HENRY_BODY_UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "Entrez dans Titanic Plains.",
    "ACHIEVEMENT_ROB_HENRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Henry : Maîtrise",
    "ACHIEVEMENT_ROB_HENRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "En tant qu'Henry, terminez le jeu ou oblitérez-vous en Monsoon.",
    "ACHIEVEMENT_ROB_HENRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_NAME": "Henry : Grande Maîtrise",
    "ACHIEVEMENT_ROB_HENRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "En tant qu'Henry, terminez le jeu ou oblitérez-vous en Typhoon ou Eclipse.\n<color=#8888>(Compte toute difficulté Typhoon ou supérieure)</color>",
    "ROB_HENRY_BODY_DANTEUNLOCKABLE_ACHIEVEMENT_NAME": "Henry : Jackpot",
    "ROB_HENRY_BODY_DANTEUNLOCKABLE_ACHIEVEMENT_DESC": "En tant qu'Henry, terrassez un Twisted Scavenger en Monsoon.",
    "ROB_HENRY_BODY_DANTEUNLOCKABLE_UNLOCKABLE_NAME": "Henry : Jackpot",
    "ROB_HENRY_BODY_VERGILUNLOCKABLE_ACHIEVEMENT_NAME": "Henry : 200% Motivé",
    "ROB_HENRY_BODY_VERGILUNLOCKABLE_ACHIEVEMENT_DESC": "En tant qu'Henry, terrassez le King of Nothing sans aucun objet.",
    "ROB_HENRY_BODY_VERGILUNLOCKABLE_UNLOCKABLE_NAME": "Henry : 200% Motivé",
    "ROB_MRGREEN_BODY_NAME": "Mr. Green",
    "ROB_MRGREEN_BODY_DESCRIPTION": "Mr. Green<color=#CCD3E0>\n\n< ! > L'Épée est polyvalente, tandis que les Gants de Boxe sont meilleurs pour tabasser les ennemis plus puissants.\n\n< ! > Le Pistolet est un puissant antiaérien grâce à son court délai de récupération et ses dégâts élevés.\n\n< ! > La Roulade laisse un bonus d'armure persistant qui aide à l'utiliser de façon agressive.\n\n< ! > La Bombe permet de balayer des foules avec facilité.</color>",
    "ROB_MRGREEN_BODY_SUBTITLE": "Le",
    "ROB_MRGREEN_BODY_LORE": "histoire d'exemple partie 2",
    "ROB_MRGREEN_BODY_OUTRO_FLAVOR": "..et ainsi il partit, texte du bas.",
    "ROB_MRGREEN_BODY_DEFAULT_SKIN_NAME": "Par défaut",
    "ROB_MRGREEN_BODY_PASSIVE_NAME": "Passif de Mr. Green",
    "ROB_MRGREEN_BODY_PASSIVE_DESCRIPTION": "Texte d'exemple.",
    "ROB_MRGREEN_BODY_PRIMARY_PUNCH_NAME": "Arts Martiaux",
    "ROB_MRGREEN_BODY_PRIMARY_PUNCH_DESCRIPTION": "Effectuez un combo rapide de coups de poing et de pied pour <style=cIsDamage>90% de dégâts</style>.",
    "ROB_MRGREEN_BODY_SECONDARY_CLONETHROW_NAME": "Lancer de Clone",
    "ROB_MRGREEN_BODY_SECONDARY_CLONETHROW_DESCRIPTION": "Invoquez un clone et lancez-le vers l'avant, attrapant les ennemis proches et les écrasant au sol pour <style=cIsDamage>420% de dégâts</style>.",
    "ROB_MRGREEN_BODY_UTILITY_DASH_NAME": "People's Elbow",
    "ROB_MRGREEN_BODY_UTILITY_DASH_DESCRIPTION": "Foncez sur une courte distance. Au contact d'un <style=cIsUtility>clone</style>, bondissez dans les airs et retombez avec un puissant <style=cIsUtility>coup de coude</style> pour <style=cIsDamage>800% de dégâts</style>.",
    "ROB_MRGREEN_BODY_SPECIAL_RES_NAME": "Résurrection",
    "ROB_MRGREEN_BODY_SPECIAL_RES_DESCRIPTION": "Ressuscite tous les clones tombés.",
    "ROB_NEMRY_BODY_NAME": "Nemesis Henry",
    "ROB_NEMRY_BODY_DESCRIPTION": "Nemesis Henry est un épéiste instable qui manie une lame spéciale stockant de l'énergie pour renforcer ses attaques. Ses compétences n'ont pas de temps de recharge, mais il doit bien gérer son énergie.<color=#CCD3E0>\n\n< ! > Mode Épée accumule de l'énergie, tandis que Mode Arme la dépense pour des attaques puissantes.\n\n< ! > Swordmaster peut être chargé pour infliger plus de dégâts.\n\n< ! > Flash Step est un puissant outil agressif qui aide à accumuler de l'énergie.\n\n< ! > Utilisez Hydra Bite pour rester en bonne santé et Hyper Beam pour déchaîner une tonne de dégâts.</color>",
    "ROB_NEMRY_BODY_SUBTITLE": "Le Déchu",
    "ROB_NEMRY_BODY_LORE": "histoire d'exemple",
    "ROB_NEMRY_BODY_OUTRO_FLAVOR": "..et ainsi il partit, ayant fait exploser la lune sans raison apparente.",
    "ROB_NEMRY_BODY_OUTRO_FAILURE": "..il a tant essayé, et est allé si loin. Mais au final, cela n'a même plus d'importance.",
    "ROB_NEMRY_BODY_DEFAULT_SKIN_NAME": "Nemesis",
    "ROB_NEMRY_BODY_MASTERY_SKIN_NAME": "Captif #001",
    "ROB_NEMRY_BODY_TYPHOON_SKIN_NAME": "FLLFFL",
    "ROB_NEMRY_BODY_PASSIVE_NAME": "Gunblade Acide",
    "ROB_NEMRY_BODY_PASSIVE_DESCRIPTION": "Nemesis Henry manie une arme spéciale capable d'alterner entre Mode Épée et Mode Arme. De plus, ses compétences n'ont pas de temps de recharge normal, mais reposent sur le système d'<style=cIsHealing>Énergie</style> de son épée.",
    "ROB_NEMRY_BODY_PRIMARY_SPEAR_NAME": "Empaler",
    "ROB_NEMRY_BODY_PRIMARY_SPEAR_DESCRIPTION": "<style=cIsUtility>Agile.</style> Transpercez vers l'avant pour <style=cIsDamage>160% de dégâts</style>. <style=cIsDamage>Inflige le double de dégâts et soigne <style=cIsHealing>50%</style> des dégâts infligés à la pointe</style>.",
    "ROB_WEAPON_SWAP_SKILL": "Changement d'Arme",
    "ROB_NEMRY_BODY_PRIMARY_SWORD_NAME": "Mode Épée",
    "ROB_NEMRY_BODY_PRIMARY_SWORD_DESCRIPTION": "Frappez vers l'avant avec votre lame pour <style=cIsDamage>280% de dégâts</style>. Génère <style=cIsHealing>20% d'Énergie</style> à l'impact.",
    "ROB_NEMRY_BODY_PRIMARY_GUN_NAME": "Mode Arme",
    "ROB_NEMRY_BODY_PRIMARY_GUN_DESCRIPTION": "<style=cIsHealing>2,5% d'Énergie.</style> Tirez un projectile perforant d'<style=cIsHealing>Énergie</style> pour <style=cIsDamage>350% de dégâts</style>.",
    "ROB_NEMRY_BODY_PRIMARY_SWORDCSS_NAME": "Mode Épée / Mode Arme",
    "ROB_NEMRY_BODY_PRIMARY_SWORDCSS_DESCRIPTION": "Frappez avec votre lame pour <style=cIsDamage>280% de dégâts</style>. Génère <style=cIsHealing>20% d'Énergie</style> à l'impact.\n<style=cIsHealing>2,5% d'Énergie.</style> Tirez un projectile perforant d'<style=cIsHealing>Énergie</style> pour <style=cIsDamage>350% de dégâts</style>.",
    "ROB_NEMRY_BODY_SECONDARY_BLAST_NAME": "Null Blast",
    "ROB_NEMRY_BODY_SECONDARY_BLAST_DESCRIPTION": "<style=cIsUtility>Agile.</style> Lancez une sphère d'<style=cIsHealth>énergie mystérieuse</style> pour <style=cIsDamage>450% de dégâts</style>.",
    "ROB_NEMRY_BODY_SECONDARY_CHARGE_NAME": "Swordmaster",
    "ROB_NEMRY_BODY_SECONDARY_CHARGE_DESCRIPTION": "<style=cIsHealing>10% d'Énergie.</style> Foncez sur un ennemi proche pour <style=cIsDamage>600% de dégâts</style>. Effectue une attaque combo à la place si vous êtes à portée de mêlée.",
    "ROB_NEMRY_BODY_SECONDARY_TORRENT_NAME": "Gunslinger",
    "ROB_NEMRY_BODY_SECONDARY_TORRENT_DESCRIPTION": "<style=cIsHealing>5% d'Énergie.</style> Tirez une rafale de projectiles d'<style=cIsHealing>Énergie</style>. Maintenez pour continuer à tirer, consommant davantage d'<style=cIsHealing>Énergie</style> par tir.",
    "ROB_NEMRY_BODY_SECONDARY_CHARGECSS_NAME": "Swordmaster / Gunslinger",
    "ROB_NEMRY_BODY_SECONDARY_CHARGECSS_DESCRIPTION": "<style=cIsHealing>10% d'Énergie.</style> Foncez sur un ennemi proche pour <style=cIsDamage>600% de dégâts</style>.\n<style=cIsHealing>5% d'Énergie.</style> Tirez une rafale de projectiles d'<style=cIsHealing>Énergie</style>.",
    "ROB_NEMRY_BODY_UTILITY_DODGESLASH_NAME": "Entaille Rapide",
    "ROB_NEMRY_BODY_UTILITY_DODGESLASH_DESCRIPTION": "Faites un salto arrière en tranchant les ennemis proches pour <style=cIsDamage>300% de dégâts</style>. <style=cIsUtility>Vous ne pouvez pas être touché pendant le salto.</style>",
    "ROB_NEMRY_BODY_UTILITY_BLINK_NAME": "Flash Step",
    "ROB_NEMRY_BODY_UTILITY_BLINK_DESCRIPTION": "<style=cIsHealing>5% d'Énergie.</style> <style=cIsUtility>Téléportez-vous instantanément</style> vers un ennemi proche.",
    "ROB_NEMRY_BODY_UTILITY_BURST_NAME": "Décharge d'Énergie",
    "ROB_NEMRY_BODY_UTILITY_BURST_DESCRIPTION": "<style=cIsHealing>10% d'Énergie.</style> Libérez une explosion d'<style=cIsHealing>Énergie</style> pour <style=cIsDamage>400% de dégâts</style>, <style=cIsUtility>en vous propulsant avec le recul</style>.",
    "ROB_NEMRY_BODY_UTILITY_BLINKCSS_NAME": "Flash Step / Décharge d'Énergie",
    "ROB_NEMRY_BODY_UTILITY_BLINKCSS_DESCRIPTION": "<style=cIsHealing>5% d'Énergie.</style> <style=cIsUtility>Téléportez-vous instantanément</style> vers un ennemi proche.\n<style=cIsHealing>10% d'Énergie.</style> Libérez une explosion d'<style=cIsHealing>Énergie</style> pour <style=cIsDamage>400% de dégâts</style>.",
    "ROB_NEMRY_BODY_SPECIAL_STAB_NAME": "Hydra Bite",
    "ROB_NEMRY_BODY_SPECIAL_STAB_DESCRIPTION": "<style=cIsHealing>100% d'Énergie.</style> Plongez votre lame dans un ennemi pour <style=cIsDamage>2800% de dégâts</style>, infligeant un puissant malus. <style=cIsHealing>Soigne 50% des dégâts infligés.</style>",
    "ROB_NEMRY_BODY_SPECIAL_BEAM_NAME": "Hyper Beam",
    "ROB_NEMRY_BODY_SPECIAL_BEAM_DESCRIPTION": "<style=cIsHealing>100% d'Énergie.</style> Chargez une puissante salve de lasers infligeant <style=cIsDamage>10x420% de dégâts</style>.",
    "ROB_NEMRY_BODY_SPECIAL_STABCSS_NAME": "Hydra Bite / Hyper Beam",
    "ROB_NEMRY_BODY_SPECIAL_STABCSS_DESCRIPTION": "<style=cIsHealing>100% d'Énergie.</style> Plongez votre lame dans un ennemi pour <style=cIsDamage>2800% de dégâts</style>, infligeant un puissant malus. <style=cIsHealing>Soigne 50% des dégâts infligés.</style>\n<style=cIsHealing>100% d'Énergie.</style> Chargez un puissant rayon infligeant <style=cIsDamage>énormément de dégâts</style>.",
    "ROB_NEMRY_BODY_UNLOCKABLE_ACHIEVEMENT_NAME": "???",
    "ROB_NEMRY_BODY_UNLOCKABLE_ACHIEVEMENT_DESC": "Terrassez le Vestige d'Henry.",
    "ROB_NEMRY_BODY_UNLOCKABLE_UNLOCKABLE_NAME": "???",
    "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Nemesis Henry : Maîtrise",
    "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "En tant que Nemesis Henry, terminez le jeu ou oblitérez-vous en Monsoon.",
    "ROB_NEMRY_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Nemesis Henry : Maîtrise",
    "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "Nemesis Henry : Grande Maîtrise",
    "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "En tant que Nemesis Henry, terminez le jeu ou oblitérez-vous en Typhoon.",
    "ROB_NEMRY_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "Nemesis Henry : Grande Maîtrise"
  }
}
