    "KENKO_SUBMARINER_PASSIVE_DESCRIPTION": "Frapi malamikojn per <style=cIsDamage>proksimbatalaj atakoj</style> donas <style=cIsHealing>Restarigon de N'kuhana</style>.",
    "KENKO_SUBMARINER_PRIMARY_SWING_NAME": "AL811 Ankra Aparato",
