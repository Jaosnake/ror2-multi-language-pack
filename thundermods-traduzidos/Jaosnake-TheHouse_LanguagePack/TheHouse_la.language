        "JAVANGLE_HOUSE_7CLUBS_DESCRIPTION": "Onera <style=cIsUtility>3 Ictus Arcanos</style> in roulettam.\nPraeterea, <style=cIsUtility>Spondet</style> proximam glandem tuam Ictum Explosivum fore.",
        "JAVANGLE_HOUSE_7SPADES_NAME": "7 Hastarum",
        "JAVANGLE_HOUSE_7SPADES_DESCRIPTION": "Accipe <style=cIsUtility>Auctam Celeritatem Motus</style> necnon <style=cIsUtility>2 beneficia omnino fortuita</style> per 10 secundas\nPraeterea, <style=cIsUtility>Spondet</style> proximam glandem tuam Ictum Transfodientem fore.",
        "JAVANGLE_HOUSE_7DIAMONDS_NAME": "7 Quadratorum",
        "JAVANGLE_HOUSE_7DIAMONDS_DESCRIPTION": "<style=cShrine>Aurum Accipe</style> <style=cSub>(pro pretio arcarum crescit)</style>.",
        "JAVANGLE_HOUSE_7HEARTS_NAME": "7 Cordium",
        "JAVANGLE_HOUSE_7HEARTS_DESCRIPTION": "<style=cIsHealing>Sana 50% maximi HP tui</style> et <style=cIsUtility>Accipe usque ad 50% Obiecti</style> pro praesenti HP.",
        "JAVANGLE_HOUSE_JACKPOT_NAME": "Praemium Maximum",
        "JAVANGLE_HOUSE_JACKPOT_DESCRIPTION": "Fortuito effectus ''7 Trifoliorum'', ''7 Quadratorum'', ''7 Cordium'' vel ''7 Hastarum'' duplici vi excitat, 20% sorte <style=cIsUtility>omnia simul excitandi</style>.",
        "JAVANGLE_HOUSE_52_NAME": "Colligere 52",
        "JAVANGLE_HOUSE_52_DESCRIPTION": "Omnes reliquas chartas in aerem iacit et omnia in acervum trahendi remiscet; unaquaeque charta hostes petit et <style=cIsDamage>varias quantitates Damni infert</style>.",
        "JAVANGLE_HOUSE_SNAKE_NAME": "Oculi Serpentis",
        "JAVANGLE_HOUSE_SNAKE_DESCRIPTION": "<style=cArtifact>Onerat 2 Ictus Colubrinos</style> in roulettam.\nPraeterea, <style=cIsUtility>Spondet</style> proximam glandem tuam Ictum Colubrinum fore.\n<style=cIsUtility>Dat 1 cumulum 'Ante'</style>; quisque cumulus 'Ante' armaturam minuit, et celeritatem motus atque impetus auget",
        "JAVANGLE_HOUSE_BUST_NAME": "Ruinam",
        "JAVANGLE_HOUSE_BUST_DESCRIPTION": "Statim accipe <style=cDeath>35% maximae salutis tuae ut damnum</style>, et <style=cIsDamage>infer 100% maximae salutis tuae</style> ut damnum hostibus propinquis.",
        "JAVANGLE_HOUSE_SWORDS_NAME": "10 Gladiorum",
        "JAVANGLE_HOUSE_SWORDS_DESCRIPTION": "Potentes hostes circum te evoca.",
        "JAVANGLE_HOUSE_COINS_NAME": "5 Nummorum",
        "JAVANGLE_HOUSE_COINS_DESCRIPTION": "<style=cArtifact>Amitte 40% praesentis auri tui</style> et <style=cIsDamage>infer 400% auri amissi ut damnum</style> hostibus propinquis.",
        "JAVANGLE_HOUSE_TOWER_NAME": "Turris",
        "JAVANGLE_HOUSE_TOWER_DESCRIPTION": "<style=cArtifact>Discrimen</style>, <style=cDeath>Excidium</style>, <style=cArtifact>Catastropha</style>, <style=cDeath>Damna</style>, <style=cArtifact>Obices</style>, <style=cDeath>Instabile</style>.\n<style=cIsUtility>[Indestructibilis]</style>",
        "JAVANGLE_HOUSE_JOKER_NAME": "Scurra",
        "JAVANGLE_HOUSE_JOKER_DESCRIPTION": "Alium <style=cArtifact>Effectum Chartae Purpureae</style> fortuitum excitat, 20% sorte <style=cArtifact>omnes simul</style> excitandi.\n<style=cSub>(Turrim excitare non potest.)</style>",
        "JAVANGLE_HOUSE_7JACK_NAME": "Puer Quadratorum",
        "JAVANGLE_HOUSE_7JACK_DESCRIPTION": "Onera 6 ictus vulgares.\nSi in solo es: prorsum labitur.",
        "JAVANGLE_HOUSE_7QUEEN_NAME": "Regina Cordium",
        "JAVANGLE_HOUSE_7QUEEN_DESCRIPTION": "Ad tempus <style=cIsUtility>2 attributa fortuita auget</style>, sed <style=cArtifact>2 alia attributa fortuita minuit</style>.",
        "JAVANGLE_HOUSE_7KING_NAME": "Rex Trifoliorum",
        "JAVANGLE_HOUSE_7KING_DESCRIPTION": "Onerat Ictum Explosivum, Transfodientem, Grandinis, Colubrinum, Vacuum et Arcanum.",
        "JAVANGLE_HOUSE_7ACE_NAME": "As Hastarum",
        "JAVANGLE_HOUSE_7ACE_DESCRIPTION": "Nihil nisi 1 ictum singularem onerat qui <style=cIsDamage>2500% damni</style> post longam moram infert.",
        "JAVANGLE_HOUSE_WILDCARD_NAME": "Charta Fera",
        "JAVANGLE_HOUSE_WILDCARD_DESCRIPTION": "Aliquid improvisum agit. Bonum esse potest, malum esse potest, neutrum... fortasse utrumque?\n<style=cIsUtility>[Indestructibilis]</style>",
        "JAVANGLE_HOUSE_RROULETTE_NAME": "Rouletta Russica",
        "JAVANGLE_HOUSE_RROULETTE_DESCRIPTION": "1/6 sors <style=cDeath>moriendi</style>, 4/6 sors nihil agendi et maximos cumulos 'Ante' dandi, 1/6 sors <style=cIsDamage>omnia in tabula necandi</style>, <style=cIsUtility>res dandi</style> et <style=cIsUtility>omnes lusores mortuos revivificandi</style>.\n<style=cSub>(Raritas et numerus rerum acceptarum cum numero graduum confectorum crescunt)</style>\n<style=cSub>(Res Legendarias in ludo multorum lusorum accipere non potest)</style>\n<style=cIsUtility>[Indestructibilis]</style>",
        "JAVANGLE_HOUSE_FORTUNE_NAME": "Rota Fortunae",
        "JAVANGLE_HOUSE_FORTUNE_DESCRIPTION": "50% sors <style=cShrine>praesens aurum duplicandi</style>, 50% sors <style=cArtifact>omne aurum amittendi</style> et <style=cIsUtility>pro re fortuita sortem iaciendi</style> ex auro amisso.",
        "JAVANGLE_HOUSE_THREEOFAKIND_NAME": "Ternio",
        "JAVANGLE_HOUSE_THREEOFAKIND_DESCRIPTION": "Trahe et <style=cIsUtility>totam proximam manum lude</style> simul.",
        "JAVANGLE_HOUSE_GCLUBS_NAME": "Trifolia",
        "JAVANGLE_HOUSE_GCLUBS_DESCRIPTION": "Onera <style=cIsUtility>3 Ictus Positivos fortuitos</style> in roulettam.\nPraeterea, <style=cIsUtility>Spondet</style> proximam glandem tuam Ictum Explosivum fore.",
        "JAVANGLE_HOUSE_GSPADES_NAME": "Hastae",
        "JAVANGLE_HOUSE_GSPADES_DESCRIPTION": "Accipe <style=cIsUtility>Auctam Celeritatem Motus</style> per 10 secundas\nPraeterea, <style=cIsUtility>Spondet</style> proximam glandem tuam Ictum Transfodientem fore.",
        "JAVANGLE_HOUSE_GHEARTS_NAME": "Corda",
        "JAVANGLE_HOUSE_GHEARTS_DESCRIPTION": "<style=cIsHealing>Sana 50% maximi HP tui</style>",
        "JAVANGLE_HOUSE_GJACK_NAME": "Puer",
        "JAVANGLE_HOUSE_GJACK_DESCRIPTION": "Nihil agit.",
        "JAVANGLE_HOUSE_CRAZYCARD_NAME": "Charta Demens",
        "JAVANGLE_HOUSE_CRAZYCARD_DESCRIPTION": "Aliam chartam Distributionis Vulgaris fortuito excitat.",
        "JAVANGLE_HOUSE_CASHOUT_NAME": "Solutio",
        "JAVANGLE_HOUSE_CASHOUT_DESCRIPTION": "1/3 sors <style=cArtifact>omnem pecuniam amittendi</style>, 1/3 sors nihil agendi, 1/3 sors <style=cIsDamage>omni hosti in tabula damnum inferendi</style> et <style=cIsUtility>rem temporariam dandi</style>.\n<style=cSub>(Damnum et raritas rei cum pecunia periclitata crescunt)</style>",
        "JAVANGLE_HOUSE_THESUN_NAME": "Sol",
        "JAVANGLE_HOUSE_THESUN_DESCRIPTION": "<style=cIsUtility>Exemplar cuiusque alterius chartae in manu creat</style> easque in proximam manum trahit.\n<style=cSub>(In chartis 'Indestructibilibus' non operatur)</style>.\n<style=cSub>(Hic effectus ab aliis chartis excitari non potest)</style>.",
        "JAVANGLE_HOUSE_THEMOON_NAME": "Luna",
        "JAVANGLE_HOUSE_THEMOON_DESCRIPTION": "<style=cIsUtility>Quamque alteram chartam in manu delet</style>, eas ex fasciculo removens.\n<style=cSub>(In chartis 'Indestructibilibus' non operatur)</style>.\n<style=cSub>(Hic effectus ab aliis chartis excitari non potest)</style>.",
        "JAVANGLE_HOUSE_THESTAR_NAME": "Stella",
        "JAVANGLE_HOUSE_THESTAR_DESCRIPTION": "<style=cIsUtility>Tres chartas fortuitas creat easque statim trahit</style>; charta qua uteris servabitur, <style=cArtifact>alterae duae delebuntur.</style>\n<style=cSub>(Chartas 'Indestructibiles' creare non potest)</style>.\n<style=cSub>(Hic effectus ab aliis chartis excitari non potest)</style>.",
        "JAVANGLE_HOUSE_THEWORLD_NAME": "Mundus",
        "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION": "<style=cIsUtility>Omnes chartas 'Sol', 'Luna', 'Stella' et 'Mundus' delet</style> ex acervo trahendi, manu et acervo abiecto, eas ex fasciculo removens.\n<style=cSub>(Hic effectus ab aliis chartis excitari non potest)</style>.",
        "JAVANGLE_HOUSE_JUDGEMENT_NAME": "Iudicium",
        "JAVANGLE_HOUSE_JUDGEMENT_DESCRIPTION": "<style=cIsUtility>Fasciculum omnino versione originali substituit</style>, omnes mutationes ei factas irritas faciens. <style=cSub>(quasi renatus esses vel gradum mutavisses)</style>\n<style=cSub>(Hic effectus ab aliis chartis excitari non potest)</style>.\n<style=cIsUtility>[Indestructibilis]</style>",
        "JAVANGLE_HOUSE_KINGOFWANDS_NAME": "Rex Virgarum",
        "JAVANGLE_HOUSE_KINGOFWANDS_DESCRIPTION": "<style=cIsUtility>Usque ad 4 cumulos 'Ante' consumit</style>, et <style=cIsHealing>usque ad 70% sanationis praebet</style> pro quanto 'Ante' impensum sit.\n<style=cIsHealing>Omnes socii sub imperio tuo dimidia parte sanantur</style>.",
        "JAVANGLE_HOUSE_QUEENOFCUPS_NAME": "Regina Calicum",
        "JAVANGLE_HOUSE_QUEENOFCUPS_DESCRIPTION": "<style=cIsUtility>Usque ad 4 cumulos 'Ante' consumit</style>, et beneficium praebet quod House sinit <style=cIsUtility>ictus oneratos sine eorum consumptione emittere</style>.\nHoc beneficium usque ad 15 secundas durat, pro quanto 'Ante' impendatur.",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_NAME": "Eques Gladiorum",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_DESCRIPTION": "<style=cIsUtility>Usque ad 4 cumulos 'Ante' consumit</style>, et <style=cIsUtility>numerum glandium positivarum onerat</style> parem quantitati 'Ante' impensae.\nPraeterea, <style=cIsUtility>Spondet</style> proximam glandem tuam Ictum Explosivum fore.",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_NAME": "Puer Pentaculorum",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_DESCRIPTION": "<style=cIsUtility>Usque ad 15 cumulos 'Ante' consumit</style>, et Chimaeras Lunares ad pro te pugnandum evocat; quo plus 'Ante' impendis, eo maior copia evocata erit.\n15 cumulis impensis, haec charta superstitem fortuitum pro eis evocabit",
        "JAVANGLE_HOUSE_ANTEUP_NAME": "Auge Ante!",
        "JAVANGLE_HOUSE_ANTEUP_DESCRIPTION": "<style=cIsUtility>Dat 6 cumulos 'Ante'</style>.\nQuisque cumulus Ante armaturam minuit, et celeritatem motus atque impetus auget",
        "JAVANGLE_HOUSE_ANCIENTACE_NAME": "As Antiquus",
        "JAVANGLE_HOUSE_ANCIENTACE_DESCRIPTION": "Onera <style=cIsUtility>6 Ictus Arcanos</style> in roulettam.\nPraeterea, <style=cIsUtility>Unum ex his effectibus dat</style>.\n<style=cIsUtility>Biniones</style>: Quaeque charta quam ludis bis luditur\n<style=cIsUtility>Color</style>: Quotiens chartam ludis, reliquam manum tuam lude (omissis chartis negativis et fortuitis)\n<style=cIsUtility>Calices</style>: Roulettam emittere non amplius Munitionem constat\n<style=cIsUtility>[Indestructibilis]</style>",
        "ARTIFACT_OF_WILDROOM_NAME": "Artefactum Wildroom",
        "ARTIFACT_OF_WILDROOM_DESCRIPTION": "Wildroom initio cuiusque gradus evoca.\nWildroom non amplius se ipsum removere potest, et nunc etiam lusores non-House afficit.",
        "JAVANGLE_HOUSE_NULL_NAME": "Nullus",
        "JAVANGLE_HOUSE_NULL_DESCRIPTION": "Nihil agit, ne reonerat quidem.\nFecisti, omnia delevisti, omnia ad nihilum redegisti, et nunc nihil est totum quod superest... felixne es..?"
    }
}
