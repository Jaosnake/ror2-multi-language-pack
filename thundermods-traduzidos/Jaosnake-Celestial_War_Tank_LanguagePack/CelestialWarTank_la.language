    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "AURANTIUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "FUSCUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "CIVITATES FOEDERATAE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "GERMANIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "REGNUM UNITUM",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "RUSSIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "GALLIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "Hoc colorem corporis mutat.  Ludum non afficit.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "PRINCIPALIS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "FLAVUS SORDIDUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "VIRIDIS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "VIRIDIS SORDIDUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "CAERULEUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "CAERULEUS SORDIDUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "RUBER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "RUBER SORDIDUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "MAGISTERIUM",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Alveus Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Vis Machinae: </color>3000\n<color=#00FFFF>Celeritas: </color>10\nTraverse Celeritas: 0.8\n\n<color=#00FF00>Salus: </color>1000\n<color=#FF0000>Lorica: </color>75\n\n<color=#AA00FF>Vis Impulsus: </color>35\n<color=#ffc080>Copia Fomenti: </color>500\nPondus: 1000\n\nGenus Alvei: Currus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Alveus Griffon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Turri aptus</color>.\n\n<color=#FFFF00>Vis Machinae: </color>2300\n<color=#00FFFF>Celeritas: </color>11\nTraverse Celeritas: 1\n\n<color=#00FF00>Salus: </color>800\n<color=#FF0000>Lorica: </color>25\n\n<color=#AA00FF>Vis Impulsus: </color>40\n<color=#ffc080>Copia Fomenti: </color>500\nPondus: 800\n\nGenus Alvei: Raeda",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "Alveus TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Vis Machinae: </color>1200\n<color=#00FFFF>Celeritas: </color>12\nTraverse Celeritas: 2\n\n<color=#00FF00>Salus: </color>500\n<color=#FF0000>Lorica: </color>25\n\n<color=#AA00FF>Vis Impulsus: </color>40\n<color=#ffc080>Copia Fomenti: </color>300\nPondus: 450\n\nGenus Alvei: Currus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Alveus Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Vis Machinae: </color>3500\n<color=#00FFFF>Celeritas: </color>8\nTraverse Celeritas: 0.6\n\n<color=#00FF00>Salus: </color>1400\n<color=#FF0000>Lorica: </color>100\n\n<color=#AA00FF>Vis Impulsus: </color>34\n<color=#ffc080>Copia Fomenti: </color>750\nPondus: 1250\n\nGenus Alvei: Currus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Alveus Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Praebet maius <style=cIsUtility>imperium in aere</style>.\n\n\n<color=#FFFF00>Vis Machinae: </color>2000\n<color=#00FFFF>Celeritas: </color>13\nTraverse Celeritas: 1.4\n\n<color=#00FF00>Salus: </color>600\n<color=#FF0000>Lorica: </color>20\n\n<color=#AA00FF>Vis Impulsus: </color>40\n<color=#ffc080>Copia Fomenti: </color>450\nPondus: 750\n\nGenus Alvei: Raeda",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "Alveus AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>Celeritas pondere non afficitur</style>.\n\n<color=#FFFF00>Vis Machinae: </color>700\n<color=#00FFFF>Celeritas: </color>9\nTraverse Celeritas: 0.7\n\n<color=#00FF00>Salus: </color>900\n<color=#FF0000>Lorica: </color>50\n\n<color=#AA00FF>Vis Impulsus: </color>35\n<color=#ffc080>Copia Fomenti: </color>370\nPondus: 1100\n\nGenus Alvei: Currus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "Alveus TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Vis Machinae: </color>3700\n<color=#00FFFF>Celeritas: </color>8\nTraverse Celeritas: 0.5\n\n<color=#00FF00>Salus: </color>1150\n<color=#FF0000>Lorica: </color>60\n\n<color=#AA00FF>Vis Impulsus: </color>34\n<color=#ffc080>Copia Fomenti: </color>1000\nPondus: 1200\n\nGenus Alvei: Currus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Alveus Pigeon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Turri aptus</color>.\n\n<color=#FFFF00>Vis Machinae: </color>1500\n<color=#00FFFF>Celeritas: </color>7\nTraverse Celeritas: 1.4\n\n<color=#00FF00>Salus: </color>150\n<color=#FF0000>Lorica: </color>5\n\n<color=#AA00FF>Vis Impulsus: </color>40\n<color=#ffc080>Copia Fomenti: </color>300\nPondus: 100\n\nGenus Alvei: Raeda",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Alveus Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Muros scandere potest</style>. Saltus una secunda retardatur, et <color=#fc8080>damnum arietis 50% minuitur</color>.\n\n\n<color=#FFFF00>Vis Machinae: </color>2750\n<color=#00FFFF>Celeritas: </color>9\nTraverse Celeritas: 0.8\n\n<color=#00FF00>Salus: </color>1300\n<color=#FF0000>Lorica: </color>90\n\n<color=#AA00FF>Vis Impulsus: </color>31\n<color=#ffc080>Copia Fomenti: </color>550\nPondus: 1300\n\nGenus Alvei: Automaton",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "Alveus TANKDOZER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "Aratrum <style=cIsUtility>arcet</style> omne <style=cIsDamage>damnum adveniens</style>.\n\nModus Deletoris Curruum: <color=#fc8080>Turrim imponere non potest</color>.\n\n<color=#FFFF00>Vis Machinae: </color>2500\n<color=#00FFFF>Celeritas: </color>8.5\nTraverse Celeritas: 0.9\n\n<color=#00FF00>Salus: </color>1250\n<color=#FF0000>Lorica: </color>80\n\n<color=#AA00FF>Vis Impulsus: </color>34\n<color=#ffc080>Copia Fomenti: </color>500\nPondus: 1200\n\nGenus Alvei: Currus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Alveus Truck Kan",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "Damnum arietis augetur <color=#80fc80>100.0%</color>\n\n<color=#80fc80>Turri aptus</color>.\n<style=cIsUtility>Celeritas pondere non afficitur</style>.\n\n<color=#FFFF00>Vis Machinae: </color>1000\n<color=#00FFFF>Celeritas: </color>12\nTraverse Celeritas: 0.9\n\n<color=#00FF00>Salus: </color>450\n<color=#FF0000>Lorica: </color>15\n\n<color=#AA00FF>Vis Impulsus: </color>40\n<color=#ffc080>Copia Fomenti: </color>600\nPondus: 600\n\nGenus Alvei: Raeda",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Salus: </color>250\n<color=#FF0000>Lorica: </color>25\n\nRotation Celeritas: 7.5\n\nPondus: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Turris",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Salus: </color>100\n<color=#FF0000>Lorica: </color>10\n\nRotation Celeritas: 20\n\nPondus: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Salus: </color>100\n<color=#FF0000>Lorica: </color>15\n\nRotation Celeritas: 15\n\nPondus: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Salus: </color>400\n<color=#FF0000>Lorica: </color>50\n\nRotation Celeritas: 5\n\nPondus: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% damni</style>?  Codicem ubi damnum pro hac turri propria auget invenire non potui.\n- Auctor\n\n\n<color=#00FF00>Salus: </color>150\n<color=#FF0000>Lorica: </color>25\n\nRotation Celeritas: 13\nLimes Anguli: 60\n\nPondus: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Addit <style=cIsDamage>5 onera</style> facultati <style=cIsUtility>secundariae</style>.\n<style=cIsUtility>Replet omnia onera</style> post refectionem.\nDamnum tormenti minuitur 80%\n\n<color=#00FF00>Salus: </color>300\n<color=#FF0000>Lorica: </color>20\n\nRotation Celeritas: 7\n\nPondus: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Salus: </color>200\n<color=#FF0000>Lorica: </color>30\n\nRotation Celeritas: 9\n\nPondus: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Salus: </color>300\n<color=#FF0000>Lorica: </color>35\n\nRotation Celeritas: 7\n\nPondus: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Pondus Grave",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "Currus <style=cIsUtility>hostes obterere</style> potest, cum <style=cIsDamage>damno e celeritate pendente</style>.  Cadere cum gravi compositione facit ut pondus tuum <style=cIsUtility>undam concussionis</style> creet, hostes proximos laedens.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Nullus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Hanc facultatem removet.  Auget statisticas sequentes:\n\nCeleritas Impetus: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Nullus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Nullus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Hanc facultatem removet.  Auget statisticas sequentes:\n\nCeleritas: <color=#80fc80>+1</color> m/s\nVis Propulsorum: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Nullus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Hanc facultatem removet.  Auget loricam <color=#80fc80>30</color> et auget capacitatem fomenti <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Tormentum Parvum",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Parum certe jaculare pro <style=cIsDamage>200% damni.</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "PEM",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Accende scutum tuum, et crea pulsum electromagneticum pro <style=cIsDamage>2000% damni</style>, qui hostes fulminat!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "Tene copiam ingentem usque ad 22 missilium! Quodque infligit a <style=cIsDamage>1100% damni</style> usque ad <style=cIsDamage>1800% damni</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Tormentum Automaticum Rapax",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Jaculare glandes displosivas in hostes pro <style=cIsDamage>500% damni</style>. Singulis 4 secundis repleri debet.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Tormentum Potens",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Jaculare pro <style=cIsDamage>7500% damni</style>, hostes pellens.\n<style=cSub>[<style=cIsUtility>Refectio: 16s</style> | <style=cIsDamage>Radius Displosionis: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Tormentum Bellicum",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Tene ad collineandum</style>, et dimitte ad jaculandam glandem validam pro <style=cIsDamage>7000% damni</style>.  Damnum augetur quo longius volat usque ad <style=cIsDamage>14000% damni</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 16s</style> | <style=cIsDamage>Radius Displosionis: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Tormentum Gelidum",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Jaculare globum nivalem gigantem pro <color=#75EAFF>1500% damni</color> et congela hostes.\n<style=cSub>[<style=cIsUtility>Refectio: 5s</style> | <style=cIsDamage>Radius Displosionis: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Tormentum Geminum",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Jaculare pro <style=cIsDamage>5400% damni</style>. Tene ad jaculandas 2 glandes, quod <color=#fc8080>refectionem facultatis auget</color> postea. Duplicem ictum jaculari <color=#80fc80>valde minuit</color> proximum tempus onerationis per 2 secundas.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "Tormentum Britannicum",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Jaculare pro <style=cIsDamage>2400% damni</style>.  <color=#fc8080>Res excitare non potest</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Tormentum Magnum Saevum",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Jaculare pro <style=cIsDamage>2000% damni</style>.  <style=cIsUtility>Tene ad onerandum</style> et inflige usque ad <style=cIsDamage>11000% damni</style>.  Oneratio maxima tormentum ultro jaculatur pro addito <style=cIsDamage>5500% damni radialis</style> cum <style=cIsUtility>repulsu addito</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Experimentum Oppenheimer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Sine glandem tuam scutum tuum delere, et dele omnia pro <color=#ff4d76>9000% damni critici</color>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Propulsores Ignei",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Accende et consume <color=#ffc080>70 fomenti</color> per secundam, permittens currui magis ac magis celeritatem per tempus acquirere.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Cyclus Vis",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Activa ad mutandum inter 3 modos — Evadere, Impetus, aut Defensio: \n\n<style=cIsUtility>Evadere</style>: Minue celeritatem impetus 50% et auge refectionem 50% pro extraordinaria 50% celeritate, 10% vi impulsus, et 50% vi machinae!\n\n<color=#80fc80>Defensio</color>: Sacrifica 70% celeritatis et 100% vis impulsus pro 500 loricae.\n\n<style=cIsDamage>Impetus</style>: Omnia arma duplex damnum infligunt. Minue refectiones 33% et auge celeritatem impetus 33%, sed amitte OMNEM loricam et sanationem. Hunc modum activare currum tuum per 2 secundas fulminat.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Supra-Impulsus",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Sine celeritatem tuam scutum tuum delere, et violenter erumpe propulsores tuos pro <style=cIsDamage>6000% damni</style> te in aera mittens, <style=cIsUtility>damnum casus prohibens</style>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Scuta",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "Activa ut fias <style=cIsUtility>immunis a damno externo</style> per 4 secundas.  Sacrificari potest pro singulari <color=#03fcc2>Facultate Potenti</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Displosicularis",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Jaculare 4 tormenta, quorum quodque infligit <style=cIsDamage>1400% damni</style> in radio ingenti. Arma <color=#fc8080>aestu nimio afficiuntur</color> loco repletionis.\n<style=cSub>[<style=cIsDamage>Radius Displosionis: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Normale",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Experientia classica.\n\nCurrus movetur et vertitur secundum directionem itineris electam.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Alternativum",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Mutat modum quo hic currus luditur.\n\nCurrus movetur secundum directionem alvei, sed <color=#fc8080>non vertetur in directionem itineris</color>.  Hoc regitur <style=cIsUtility>vertendo manu</style>.\n\nDum volat, gubernatio ad Normale revertitur.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Modus Vis: <style=cIsUtility>Evadere</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Minue celeritatem impetus 50% et auge refectionem 50% pro extraordinaria 50% celeritate, 10% vi impulsus, et 50% vi machinae.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Modus Vis: <color=#80fc80>Defensio</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "Sacrifica 70% celeritatis et 100% vis impulsus pro 500 loricae.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Modus Vis: <style=cIsDamage>Impetus</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "Omnia arma duplex damnum infligunt. Minue refectiones 33% et auge celeritatem impetus 33%, sed amitte OMNEM loricam et sanationem. Hunc modum activare currum tuum per 2 secundas fulminat.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "Et putare Dedee tandem liberatum esse, \r\niterum ab UES captus est.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "Sine Turri",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "Turrim removet.  <style=cIsDamage>Auget omne damnum 30%</style>"
  }
}