    "ROB_HUNK_BODY_SHOOT_COLT_DESCRIPTION": "Dispara causando un <style=cIsDamage>2000% de daño</style>. <style=cIsUtility>Bonificación del 50% por tiro en la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_SPARKSHOT_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_SPARKSHOT_DESCRIPTION": "Dispara una aguja electrificada causando un <style=cIsDamage>1000% de daño</style>. <style=cIsUtility>Se propaga hasta a 3 enemigos infligiendo un <style=cIsDamage>2000% de daño</style>.</style>",
