        "NEMFORCER_NAME": "Nemesis Enforcer",
        "NEMFORCER_DESCRIPTION": "Nemesis Enforcer est incarnatio fortitudinis et roboris, species supernaturalis quae minime leviter habenda est.<color=#CCD3E0>\n\n< ! > Golden Hammer multos hostes simul ferire potest.\n\n< ! > Utere Dominance ex alto ad ingentem collapsionem peragendam.\n\n< ! > Motus obliquus cum Golden Minigun clavis est ad tyrannos potentes superandos.\n\n< ! > Scuta sunt ignavis.\n\n</color>",
        "NEMFORCER_SUBTITLE": "Umbra Incorruptibilis",
        "NEMFORCER_LORE": "\nheavy tf2\n\n",
        "NEMFORCER_OUTRO_FLAVOR": "..et ita discessit, novo robore ad honorandum praeditus.",
        "NEMFORCER_OUTRO_FAILURE": "..et ita rediit, inconcussum propugnaculum vere immortale factum.",
        "NEMFORCER_BOSS_NAME": "Ultra Nemesis Enforcer",
        "NEMFORCER_BOSS_SUBTITLE": "Finis Lineae",
        "DEDEDE_NAME": "King Dedede",
        "DEDEDE_BOSS_SUBTITLE": "Rex Terrae Somniorum",
        "ENFORCER_EVENT_NEMFORCERBOSS_START": "Vis innaturalis e vacuo emanat...",
        "ENFORCER_EVENT_NEMFORCERBOSS_END": "Influxus vacui marcescit...",
        "NEMFORCER_PASSIVE_NAME": "Colossus",
        "NEMFORCER_PASSIVE_DESCRIPTION": "Nemesis Enforcer <style=cIsHealing>sanationem valetudinis additam</style> adipiscitur, secundum suam <style=cIsHealth>valetudinem amissam</style>, usque ad <style=cIsHealth>2.5% maximae valetudinis</style>.",
        "NEMFORCER_PASSIVE_REWORK_DESCRIPTION": "Nemesis Enforcer <style=cIsHealing>2%</style> suae <style=cIsHealing>maximae valetudinis</style> per 3s regenerat cum hostes <style=cIsDamage>impetibus comminus</style> percutit.",
        "NEMFORCER_PRIMARY_HAMMER_NAME": "Golden Hammer",
        "NEMFORCER_PRIMARY_HAMMER_DESCRIPTION": "Malleum vibra pro <style=cIsDamage>500%</style> damno.",
        "NEMFORCER_PRIMARY_THROWHAMMER_NAME": "Throwing Hammer",
        "NEMFORCER_PRIMARY_THROWHAMMER_DESCRIPTION": "Malleum iace pro <style=cIsDamage>620%</style> damno.",
        "NEMFORCER_PRIMARY_MINIGUN_NAME": "Golden Minigun",
        "NEMFORCER_PRIMARY_MINIGUN_DESCRIPTION": "Incita et grandinem glandium emitte <style=cIsDamage>65% damnum</style> per glandem inferens. <style=cIsUtility>Ignis rapiditas tempore augetur.</style>",
        "KEYWORD_SLAM": "<style=cKeywordName>Downward Slam</style><style=cSub><style=cIsDamage>Stupefaciens.</style> Ferociter cum malleo <style=cIsHealth>deorsum concide</style>, inferens <style=cIsDamage>300%-2500% damnum</style> et additum <style=cIsDamage>30%</style> eiusdem ictu. <style=cIsUtility>Radius ictus cum celeritate crescit.</style></style>",
        "NEMFORCER_SECONDARY_BASH_NAME": "Dominance",
        "NEMFORCER_SECONDARY_BASH_DESCRIPTION": "<style=cIsUtility>Onera</style>, deinde antrorsum incurre et <style=cIsDamage>caestum ascendentem</style> emitte pro <style=cIsDamage>450%-2500% damno</style>. Utere dum <style=cIsUtility>cadens et deorsum spectans</style> ad <style=cIsUtility>Downward Slam</style> potius perficiendum.",
        "NEMFORCER_SECONDARY_SLAM_NAME": "Dominance (Minigun)",
        "NEMFORCER_SECONDARY_SLAM_DESCRIPTION": "<style=cIsDamage>Stupefaciens.</style> In statu minigun constitutus, violenter malleum <style=cIsHealth>deorsum concute</style>, inferens <style=cIsDamage>600% damnum</style> et hostes percussos <style=cIsDamage>repellens</style>. <style=cIsUtility>Proiectilia displodit.</style>",
        "NEMFORCER_UTILITY_GAS_NAME": "XM47 Grenade",
        "NEMFORCER_UTILITY_GAS_DESCRIPTION": "Pyrobolum iacta qui in nubem <style=cIsUtility>gasis corrosivi</style> displodit quae <style=cIsUtility>tardat</style> et <style=cIsDamage>200% damnum per secundam</style> infert et per <style=cIsDamage>16 secundas</style> durat.",
        "NEMFORCER_UTILITY_JUMP_NAME": "Super Dedede Jump",
        "NEMFORCER_UTILITY_JUMP_DESCRIPTION": "In aera sali, deinde deorsum concide pro <style=cIsDamage>3200% damno</style>. <style=cIsUtility>Extra centrum ictus damnum minutum infert.</style>",
        "KEYWORD_GRAPPLE": "<style=cKeywordName>Grappling</style><style=cSub>Applicat <style=cIsDamage>stupefactionem</style> et hostem propinquum <style=cIsUtility>arripere</style> conatur.</style>",
        "NEMFORCER_UTILITY_CRASH_NAME": "Heat Crash",
        "NEMFORCER_UTILITY_CRASH_DESCRIPTION": "<style=cIsUtility>Grappling.</style> In aera sali, deinde deorsum concide pro <style=cIsDamage>2400% damno</style>. <style=cIsUtility>Extra centrum ictus damnum minutum infert.</style>",
        "NEMFORCER_SPECIAL_MINIGUNUP_NAME": "Suppression Stance",
        "NEMFORCER_SPECIAL_MINIGUNUP_DESCRIPTION": "Statum offensivum sume, <style=cIsDamage>sclopetum minigun parans</style>. <style=cIsHealth>Cursum impedit</style>.",
        "NEMFORCERBODY_DEFAULT_SKIN_NAME": "Nemesis",
        "NEMFORCERBODY_ENFORCER_SKIN_NAME": "Enforcer",
        "NEMFORCERBODY_CLASSIC_SKIN_NAME": "Classicus",
