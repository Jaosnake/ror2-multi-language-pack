    "2R4R_INTERACTABLE_WISHBONECARCASS_NAME": "Omen",
    "2R4R_INTERACTABLE_WISHBONECARCASS_CONTEXT": "Omen brechen",
    "EQUIPMENT_BROKENZAPINATOR_NAME": "Oranger Zapinator",
    "EQUIPMENT_BROKENZAPINATOR_PICKUP": "<style=cIsUtility>Ich kann nicht glauben, dass wir das im Spiel gelassen haben!</style>",
    "EQUIPMENT_BROKENZAPINATOR_DESCRIPTION": "Feuert ein Projektil ab.",
    "EQUIPMENT_NINJAGEAR_NAME": "Meister-Ninja-Ausrüstung",
    "EQUIPMENT_NINJAGEAR_PICKUP": "Chance, eingehenden Angriffen auszuweichen. Aktivieren zum Vorpreschen und Abwerfen einer Rauchbombe.",
    "EQUIPMENT_NINJAGEAR_DESCRIPTION": "Aktivieren, um <style=cIsUtility>25m vorzupreschen</style>, und erhalte eine <style=cIsHealing>20% Chance</style>, eingehenden Angriffen <style=cIsHealing>auszuweichen</style>. Vorpreschen und Ausweichen lassen eine <style=cIsDamage>Rauchbombe</style> fallen, die Gegner innerhalb von 13m für <style=cIsUtility>1 Sekunde</style> <style=cIsUtility>betäubt</style>.",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_NAME": "Totgeborenes Gebet",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_PICKUP": "Gewährt einen einzigen Wunsch...",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_DESCRIPTION": "Gewährt einen ungewöhnlichen Gegenstand deiner Wahl.",
    "EQUIPMENT_THEMACHINE_NAME": "Die Maschine",
    "EQUIPMENT_THEMACHINE_PICKUP": "Sie tut gar nichts. Das ist das Schöne daran!",
    "EQUIPMENT_THEMACHINE_DESCRIPTION": "Sie tut gar nichts. Das ist das Schöne daran!",
    "EQUIPMENT_TESLAEQUIPMENT_NAME": "Bemerkenswert stabile Tesla-Spule",
    "EQUIPMENT_TESLAEQUIPMENT_PICKUP": "Schockt nahe Gegner und stellt bei Tötung Schilde wieder her.",
    "EQUIPMENT_TESLAEQUIPMENT_DESCRIPTION": "<style=cIsUtility>Elektrifiziere</style> dich selbst für <style=cIsUtility>10.0 Sekunden</style>. Tötungen während du <style=cIsUtility>elektrifiziert</style> bist, treffen <style=cIsDamage>4.0</style> nahe Gegner für <style=cIsDamage>200% Schaden</style> und <style=cIsHealing>stellen 15% deiner Schilde wieder her</style>. Erhalte passiv einen <style=cIsHealing>Schild</style> in Höhe von <style=cIsHealing>20% deiner maximalen Gesundheit</style>.",
    "EQUIPMENT_TESLAEQUIPMENT_LORE": "<style=cMono>Tesla-Präsentationssoftware v1.14\nWird eingeschaltet...\n10...</style>\nBegrüßungserklärung wird ausgegeben...\n<style=cMono>9...</style>\nWillkommen alle zusammen!\n<style=cMono>8...</style>\nBitte nehmen Sie Platz.\n<style=cMono>7...</style>\nStellen Sie sicher, dass die hinter Ihnen sehen können.\n<style=cMono>6...</style>\nDie Präsentation beginnt in Kürze.\n<style=cMono>5...</style>\nBitte gehorchen Sie dem Personal zu Ihrer eigenen Sicherheit.\n<style=cMono>4...\nRaum-Stimmungsbeleuchtung wird initiiert...\n3...</style>\nMachen Sie sich bereit zu bestaunen...\n<style=cMono>2...</style>\nDie wunderbaren Wunder...\n<style=cMono>1...</style>\nDer Elektrizität!\n<style=cMono>Stromanomalie erkannt...\nNeustartprozedur wird in 10.0 eingeleitet...</style>",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_NAME": "Chirs Tempo",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_PICKUP": "Werde ein Aspekt der Geschwindigkeit.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_DESCRIPTION": "Erhöht Bewegungs-, Angriffs- und Fähigkeitsaufladetempo.",
    "BORBO_ELITE_AFFIX_SPEED_MODIFIER": "Geheiligter {0}",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_NAME": "Gebrochener Glaube",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_PICKUP": "Werde ein Aspekt der Eitelkeit.",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_DESCRIPTION": "Werde ein Aspekt der Eitelkeit.",
    "BORBO_ELITE_MIRRORED_MODIFIER": "Gespiegelter {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_NAME": "N’Kuhanas Zugeständnis",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_PICKUP": "Werde ein Aspekt der Ewigkeit.",
    "BORBO_ELITE_AFFIX_LEECH_MODIFIER": "Schlangenhafter {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_NAME": "Abgründiger Blick",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_PICKUP": "Werde ein Aspekt des Simulacrums",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_DESCRIPTION": "Irgendwelche Werte hoch, keine Ahnung, lol",
    "BORBO_ELITE_AFFIX_SIMULATED_MODIFIER": "Simulierter {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_NAME": "Bavas Refrain",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_PICKUP": "Werde ein Aspekt der Kraft.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_DESCRIPTION": "Alle Angriffe sind explosiv. Feuert periodisch einen Mörser ab.",
    "BORBO_ELITE_AFFIX_EXPLOSIVE_MODIFIER": "Flüchtiger {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_NAME": "Eine schlummernde Kraft",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_PICKUP": "Werde ein Aspekt der Flut.",
    "BORBO_ELITE_AFFIX_FLOOD_MODIFIER": "Wogender {0}",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_NAME": "Verdrehter Blick",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_PICKUP": "Werde ein Aspekt der Böe.",
    "BORBO_ELITE_AFFIX_SQUALL_MODIFIER": "Heulender {0}",
    "ARTIFACT_AWESOMEPOT_NAME": "Artefakt der Flüchtigkeit",
    "ARTIFACT_AWESOMEPOT_DESCRIPTION": "Explosive Fässer und Töpfe sind Elite.",
    "ARTIFACT_FREELUNAR_NAME": "Artefakt des Zeloten",
    "ARTIFACT_FREELUNAR_DESCRIPTION": "Beginne jeden Lauf mit einem zufälligen Lunargegenstand. Am Ende jedes Abschnitts erscheint immer ein blaues Portal.",
    "ARTIFACT_QUICKSTART_NAME": "Artefakt des Totgeborenen",
    "ARTIFACT_QUICKSTART_DESCRIPTION": "Beginne deinen Lauf mit einem ungewöhnlichen Gegenstand deiner Wahl.",
    "ARTIFACT_RISKIERRAINSPIRIT_NAME": "Artefakt des Geistes",
    "ARTIFACT_RISKIERRAINSPIRIT_DESCRIPTION": "Charaktere laufen und greifen bei niedrigerer Gesundheit schneller an.",
    "ITEM_BARRIERONOVERHEAL_NAME": "Ägis",
    "ITEM_BARRIERONOVERHEAL_PICKUP": "Erhalte Barriere bei jeder Interaktion. Außerhalb der Gefahr hört die Barriere auf zu verfallen.",
    "ITEM_BARRIERONOVERHEAL_DESC": "Die Nutzung eines beliebigen interagierbaren Objekts gewährt eine <style=cIsHealing>temporäre Barriere</style> für <style=cIsHealing>40.0 Gesundheit</style> <style=cStack>(+40.0 pro Stapel)</style> plus zusätzliche <style=cIsHealing>10.0%</style> der <style=cIsHealing>maximalen Gesundheit</style>. Außerhalb der Gefahr <style=cIsUtility>verfällt die Barriere nicht</style>.",
    "ITEM_GOLDONHIT_NAME": "Versunkene Krone",
    "ITEM_GOLDONHIT_PICKUP": "Stiehl aus Truhen... <style=cIsHealth>auf Kosten der Gesundheit.</style>",
    "ITEM_GOLDONHIT_DESC": "Ermöglicht die Interaktion mit Truhen, ohne sie sich leisten zu können, und öffnet die Truhe, <style=cIsUtility>ohne JEGLICHES Geld auszugeben</style>. Das Stehlen aus Truhen kostet <style=cIsHealth>[ 25% / 50% / 80% ]</style> deiner <style=cIsHealth>maximalen Gesundheit</style>, abhängig von der Größe der Truhe. Kann bis zu 1 <style=cStack>(+1 pro Stapel)</style> Mal pro Abschnitt stehlen.",
    "ITEM_REGENERATINGSCRAP_NAME": "Chimären-Schrott",
    "ITEM_REGENERATINGSCRAP_PICKUP": "Wird bei Verwendung an <style=cIsHealth>JEDEM</style> 3D-Drucker priorisiert. Erzeugt zusätzliche Gegenstände niedrigerer Seltenheit.",
    "ITEM_REGENERATINGSCRAP_DESC": "Tut nichts. Wird bei Verwendung an <style=cIsHealth>JEDEM</style> 3D-Drucker priorisiert. Erzeugt <style=cStack>(</style> 10 <style=cStack>/</style> <style=cIsHealing>5</style> <style=cStack>/</style> <style=cIsHealth>2</style> <style=cStack>)</style> Gegenstände, <style=cIsUtility>abhängig von der Qualität des Druckers</style>.",
    "ITEM_GOLDONHURT_NAME": "Schokoladenmünzen",
    "ITEM_GOLDONHURT_PICKUP": "Gegner lassen eine Leckerei für Gold und Heilung fallen. Lädt sich mit der Zeit wieder auf.",
    "ITEM_GOLDONHURT_DESC": "Bei Treffer wird eine Schokoladenmünze fallen gelassen, die um <style=cIsHealing>5.0 Gesundheit</style> <style=cStack>(+5.0 pro Stapel)</style> plus <style=cIsUtility>1 Gold</style> <style=cStack>(+1 pro Stapel)</style> heilt. <style=cIsUtility>Skaliert mit der Zeit</style>. <style=cIsUtility>Lädt sich nach 5.0 Sekunden wieder auf.</style>",
    "ITEM_CRITDAMAGE_NAME": "Kampf-Teleskop",
    "ITEM_CRITDAMAGE_PICKUP": "Erhöht ‚Kritischer Treffer‘-Chance und -Schaden im Stillstand.",
    "ITEM_CRITDAMAGE_DESC": "<style=cIsDamage>Kritische Treffer</style> verursachen zusätzliche <style=cIsDamage>100% Schaden</style> <style=cStack>(+100% pro Stapel)</style>. Erhalte <style=cIsDamage>30% kritische Trefferchance</style>, nachdem du <style=cIsUtility>0.2</style> Sekunden stillgestanden hast.",
    "ITEM_REPEATHEAL_NAME": "Leichenblüte",
    "ITEM_REPEATHEAL_PICKUP": "Deine Gesundheit verfällt mit der Zeit. Erhalte Barriere und Glück bei niedriger Gesundheit.",
    "ITEM_REPEATHEAL_DESC": "Für jede fehlenden 12.5% Gesundheit erhältst du Fäulnis. Nachdem sich 3 Fäulnis angesammelt haben, wird der Basisschaden um 4 <style=cStack>(+2 pro Stapel)</style> erhöht. Nach 6 Fäulnis erhältst du 50% Barriere und erhöhst das Glück um 2 <style=cStack>(+2 pro Stapel)</style>. <style=cIsHealth>Verringert die Basis-Gesundheitsregeneration um -2 LP/s</style> <style=cStack>(-2 pro Stapel)</style>.",
    "ITEM_HEALINGPOTION_NAME": "Berserker-Gebräu",
    "ITEM_HEALINGPOTION_PICKUP": "Erhalte bei niedriger Gesundheit Barriere, reinige Debuffs und setze alle Abklingzeiten zurück. Einmal pro Abschnitt verwendbar.",
    "ITEM_HEALINGPOTION_DESC": "Das Erleiden von Schaden unter <style=cIsHealth>25% Gesundheit</style> <style=cIsUtility>verbraucht</style> diesen Gegenstand, gewährt sofort <style=cIsHealing>35%</style> der maximalen Gesundheit als <style=cIsHealing>Barriere</style> und <style=cIsUtility>setzt</style> alle Abklingzeiten zurück. Jede leere Flasche erhöht das Angriffstempo um <style=cIsDamage>15%</style>, das Bewegungstempo um <style=cIsDamage>14%</style> und verringert Abklingzeiten um <style=cIsDamage>6%</style>. Regeneriert sich zu Beginn jedes Abschnitts.",
    "EQUIPMENT_MULTISHOPCARD_NAME": "Vorstandskarte",
    "EQUIPMENT_MULTISHOPCARD_PICKUP": "Hacke ein anvisiertes interagierbares Objekt. Gehackte Multishops bleiben offen.",
    "EQUIPMENT_MULTISHOPCARD_DESC": "Visiere ein interagierbares Objekt an, um es zu <style=cIsUtility>hacken</style> und seinen Inhalt <style=cIsUtility>kostenlos</style> freizuschalten. Wenn das Ziel ein <style=cIsUtility>Multishop</style>-Terminal ist, <style=cIsUtility>bleiben</style> die anderen Terminals offen.",
    "ITEM_AUTOCASTEQUIPMENT_NAME": "Geste der Ertrunkenen",
    "ITEM_AUTOCASTEQUIPMENT_PICKUP": "Erhöht den Ausrüstungsvorrat stark... <style=cIsHealth>ABER erhöht die Ausrüstungs-Abklingzeit stark.</style> Ausrüstungen können während ihrer Abklingzeit aktiviert werden, <style=cIsHealth>mit einer Chance zu zerbrechen.</style>",
    "ITEM_AUTOCASTEQUIPMENT_DESC": "Halte <style=cIsUtility>4 zusätzliche Ausrüstungsladungen</style> <style=cStack>(+2 pro Stapel)</style>... <style=cIsHealth>ABER erhöht die Ausrüstungs-Abklingzeit um +100%</style> <style=cStack>(+50% pro Stapel)</style>. Das Verwenden deiner Ausrüstung ohne Ladungen <style=cIsUtility>unterwirkt</style> sie, wodurch sie <style=cIsHealth>mit einer Chance von 40.0% zu zerbrechen</style> genutzt werden kann. <style=cIsUtility>Unbeeinflusst von Glück.</style>",
    "ITEM_BONUSGOLDPACKONKILL_NAME": "Ghors Foliant",
    "ITEM_BONUSGOLDPACKONKILL_PICKUP": "Verwandelt Elite-Gegner bei Kontakt in Gold.",
    "ITEM_BONUSGOLDPACKONKILL_DESC": "Verursacht +100% Schaden an Vergoldeten Eliten. Das Berühren eines beliebigen Elite-Gegners verwandelt ihn sofort in einen Vergoldeten Elite-Gegner und löst alle Bei-Tötung-Effekte aus. Beeinflusst keine Boss-Gegner.",
    "ITEM_SEED_NAME": "Blutegelsamen",
    "ITEM_FLATHEALTH_NAME": "Frisches Fleisch",
    "ITEM_FLATHEALTH_PICKUP": "Erhalte pauschale LP. Regeneriere Gesundheit nach dem Töten eines Gegners.",
    "ITEM_FLATHEALTH_DESC": "Erhalte 25<style=cStack>(+25 pro Stapel)</style> Gesundheit. Erhöht die <style=cIsHealing>Basis-Gesundheitsregeneration</style> für <style=cIsUtility>3s</style> <style=cStack>(+3s pro Stapel)</style> nach dem Töten eines Gegners um <style=cIsHealing>+2 LP/s</style>.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_NAME": "Morgen-Mokka",
    "ITEM_ATTACKSPEEDANDMOVESPEED_PICKUP": "Erhalte zu Beginn eines Abschnitts einen temporären Temposchub.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_DESC": "Für <style=cIsUtility>80</style> Sekunden nach dem Betreten eines beliebigen Abschnitts werden <style=cIsDamage>Angriffs-</style> und <style=cIsDamage>Bewegungstempo</style> um <style=cIsDamage>20%</style> <style=cStack>(+20% pro Stapel)</style> erhöht und <style=cIsUtility>Fähigkeiten-Abklingzeiten</style> um <style=cIsUtility>-12%</style> <style=cStack>(-12% pro Stapel)</style> verringert. Das Aktivieren eines interagierbaren Objekts verlängert den Buff um <style=cIsUtility>20 Sekunden</style>.",
    "ITEM_EXTRASTATSONLEVELUP_NAME": "Gebetskette",
    "ITEM_EXTRASTATSONLEVELUP_PICKUP": "Wird bei Verwendung an <style=cIsHealing>Ungewöhnlichen</style> 3D-Druckern priorisiert. Erhöht nach Entfernung dauerhaft ALLE Werte.",
    "ITEM_EXTRASTATSONLEVELUP_DESC": "Wird bei Verwendung an <style=cIsHealing>Ungewöhnlichen</style> 3D-Druckern priorisiert. Gewährt nach Entfernung dauerhaft eine Erhöhung um 7% für <style=cIsUtility>Erfahrungsgewinn</style>, <style=cIsHealing>Gesundheit</style>, <style=cIsHealing>Schild</style>, <style=cIsHealing>Regeneration</style> und <style=cIsDamage>Schaden</style>.",
    "ITEM_THORNS_NAME": "Rasierdraht",
    "ITEM_THORNS_PICKUP": "Schlägt bei erlittenem Schaden mit einer Salve blutender Klingen zurück. Lädt sich mit der Zeit wieder auf.",
    "ITEM_THORNS_DESC": "Getroffen zu werden lässt dich in einer Salve von Klingen explodieren, die bis zu <style=cIsDamage>5.0</style> <style=cStack>(+2.0 pro Stapel)</style> nahe Gegner für <style=cIsDamage>400%</style> Basisschaden pro ausgestoßener <style=cIsDamage>Klingenladung</style> <style=cIsDamage>bluten</style> lassen. Du kannst bis zu 2 <style=cStack>(+1 pro Stapel)</style> Klingenladungen halten, die alle über <style=cIsUtility>5.0</style> Sekunden nachladen.",
    "ITEM_INCREASEHEALING_NAME": "Verjüngungsgestell",
    "ITEM_INCREASEHEALING_PICKUP": "Speichert Überheilung für später.",
    "ITEM_INCREASEHEALING_DESC": "Heilung über das Maximum hinaus <style=cIsHealing>speichert den Überschuss</style> in einer <style=cIsHealing>Heilungsreserve</style> mit <style=cIsHealing>50%</style> <style=cStack>(+50% pro Stapel)</style> Effizienz, bis zu <style=cIsHealing>30%</style> <style=cStack>(+0% pro Stapel)</style> deiner maximalen Gesundheit. Bei Verletzung heilst du für <style=cIsHealing>10%</style> deiner <style=cIsHealing>Gesundheit pro Sekunde</style> aus der <style=cIsHealing>Heilungsreserve</style>, bis sie leer ist.",
    "ITEM_LASERTURBINE_NAME": "Resonanzscheibe",
    "ITEM_LASERTURBINE_PICKUP": "Erhalte eine Resonanzscheibe, die durch das Töten von Gegnern aufgeladen wird. Feuert automatisch, wenn sie voll geladen ist.",
    "ITEM_LASERTURBINE_DESC": "Das Töten von Gegnern lädt die Resonanzscheibe auf. Die Scheibe schießt sich selbst auf ein Ziel zu für <style=cIsDamage>300%</style> Basisschaden <style=cStack>(+300% pro Stapel)</style>, durchdringt alle Gegner, die sie nicht tötet, und explodiert dann für <style=cIsDamage>1000%</style> Basisschaden <style=cStack>(+1000% pro Stapel)</style>. Kehrt dann zum Benutzer zurück und trifft alle Gegner auf dem Weg für <style=cIsDamage>300%</style> Basisschaden <style=cStack>(+300% pro Stapel)</style>.",
    "ITEM_SQUIDTURRET_NAME": "Tintenfischpolyp",
    "ITEM_PARENTEGG_NAME": "Planula",
    "ITEM_PARENTEGG_PICKUP": "DIE UNERREICHTE KRAFT DER SONNE!",
    "ITEM_PARENTEGG_DESC": "Nach Beginn des Teleporter-Ereignisses <style=cIsDamage>beschwörst du eine Sonne über deinem Kopf</style>, die <style=cIsDamage>10.0</style> Sekunden <style=cStack>(+5.0 pro Stapel)</style> anhält. <style=cIsHealth>Alle Gegner und Verbündeten brennen in der Nähe der Sonne</style>.",
    "ITEM_FOCUSEDCONVERGENCE_NAME": "Fokussierte Konvergenz",
    "ITEM_FOCUSEDCONVERGENCE_DESC": "Haltezonen laden <style=cIsUtility>100% <style=cStack>(+100% pro Stapel)</style> schneller</style> auf, sind aber <style=cIsHealth>50% kleiner</style> <style=cStack>(-50% pro Stapel)</style>. Max. 5.",
    "ITEM_GHOSTONKILL_NAME": "Glücklichste Maske",
    "ITEM_GHOSTONKILL_PICKUP": "Verfolge nahe Gegner und markiere sie zur Hinrichtung. Das Hinrichten von Gegnern beschwört einen Geist.",
    "ITEM_GHOSTONKILL_DESC": "<style=cIsDamage>Verfolge</style> einen zufälligen Nicht-Boss-Gegner und markiere ihn unter <style=cIsHealth>25%</style> Gesundheit zur Hinrichtung. Die Hinrichtung <style=cIsDamage>beschwört einen Geist</style> des getöteten Gegners mit <style=cIsDamage>1500%</style> Schaden, der <style=cIsDamage>6.66s</style> <style=cStack>(+6.66s pro Stapel)</style> anhält <style=cIsUtility>(doppelt für verfolgte Gegner)</style>.",
    "ITEM_MOVESPEEDONKILL_NAME": "Harpune des Jägers",
    "ITEM_MOVESPEEDONKILL_DESC": "Das Töten eines Gegners erhöht das <style=cIsUtility>Bewegungstempo</style> um <style=cIsUtility>125%</style> für <style=cIsUtility>1</style> <style=cStack>(+1 pro Stapel)</style> Sekunden. Aufeinanderfolgende Tötungen erhöhen die Buff-Dauer auf bis zu 25 Sekunden.",
    "ITEM_STRENGTHENBURN_PICKUP": "Deine Entzündungseffekte verursachen dreifachen Schaden.",
    "ITEM_STRENGTHENBURN_DESC": "Erhalte <style=cIsDamage>15% Entzündungschance</style>. Alle Entzündungseffekte verursachen <style=cIsDamage>+200%</style> <style=cStack>(+200% pro Stapel)</style> mehr Schaden und halten <style=cIsUtility>+200%</style> <style=cStack>(+200% pro Stapel)</style> länger an.",
    "DIFFICULTYSWANSONG_NAME": "Auslöschung",
    "DIFFICULTYSWANSONG_DESC": "Nur für die Entschlossenen und wahrhaft Masochistischen.\nDer Planet lebt und windet sich vor unaussprechlichem Hass für das, was ihm angetan wurde. Du, das Ziel seines Zorns, wirst in Stücke gerissen und unkenntlich gemacht werden. <style=cStack>\n\n>Spieler-Gesundheitsregeneration: <style=cArtifact>-40%</style></style> <style=cStack>\n>Schwierigkeitsskalierung: <style=cArtifact>+100%</style><style=cStack>\n>Startschwierigkeit: <style=cArtifact>Sehr schwer</style></style>\n>Seltene Eliten: <style=cArtifact>Abschnitt 4</style>\n>Teleporter-Effekte: <style=cArtifact>AUS</style>\n>Gegner erhalten <style=cArtifact>verstärkte Skalierung</style>\n>Gegner erhalten <style=cArtifact>verdreifachte Projektile</style></style>",
    "EXPANSION2R4R_NAME": "Swan Song",
