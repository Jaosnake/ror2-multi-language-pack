    "ARTIFACT_MONSTERTEAMGAINSITEMS_NAME": "विकास का पुरावशेष",
    "ARTIFACT_MONSTERTEAMGAINSITEMS_DESCRIPTION": "चरणों के बीच राक्षसों को वस्तुएँ मिलती हैं।",
    "ARTIFACT_FRIENDLYFIRE_NAME": "अराजकता का पुरावशेष",
    "ARTIFACT_FRIENDLYFIRE_DESCRIPTION": "उत्तरजीवी और राक्षस, दोनों के हमलों से उनके अपने सहयोगी भी घायल हो सकते हैं।",
    "ARTIFACT_NONE_NAME": "पुरावशेष बंद करें",
    "ARTIFACT_NONE_DESCRIPTION": "चुना हुआ पुरावशेष बंद हो जाता है।",
    "DIFFICULTY_BAR_0": "बहुत आसान",
    "DIFFICULTY_BAR_1": "आसान",
    "DIFFICULTY_BAR_2": "मध्यम",
