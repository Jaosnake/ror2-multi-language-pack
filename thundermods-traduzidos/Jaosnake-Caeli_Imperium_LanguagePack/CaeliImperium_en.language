{
  "en": {
    "CI_EXPANSION_NAME": "Caeli Imperium",
    "CI_EXPANSION_DESC": "Adds content from the 'Caeli Imperium' expansion to the game.",
    "CI_HEALRECEIVEDDAMAGE_NAME": "Emergency Medical Treatment",
    "CI_HEALRECEIVEDDAMAGE_PICKUP": "Heal received damage over the time course.",
    "CI_HEALRECEIVEDDAMAGE_DESC": "Upon <style=cIsDamage>taking damage</style>, <style=cIsHealing>heal</style> for 20% <style=cStack>(+5% per stack)</style> of the <style=cIsDamage>damage taken</style> over the course of 15 seconds <style=cStack>(-15% per stack)</style>.",
    "CI_HEALRECEIVEDDAMAGE_LORE": "",
    "CI_INFINITESECONDARYSKILLCHARGES_NAME": "Infinite Magazine",
    "CI_INFINITESECONDARYSKILLCHARGES_PICKUP": "Increase damage of your Secondary skill and gain infinite charges. Convert excessive charges into extra Secondary skill damage.",
    "CI_INFINITESECONDARYSKILLCHARGES_DESC": "Use <style=cIsUtility>Secondary skill</style> without minimal charge requirement. Consume all <style=cIsUtility>Secondary skill</style> charges on skill execution, increasing <style=cIsUtility>Secondary skill</style> <style=cIsDamage>damage</style> by <style=cIsDamage>100%</style> for each consumed charge. Extra <style=cIsUtility>Secondary skill</style> <style=cIsDamage>damage</style> <style=cDeath>disappears</style> on dealing any <style=cIsUtility>Secondary skill</style> <style=cIsDamage>damage</style>. Increase <style=cIsUtility>Secondary skill</style> <style=cIsDamage>damage</style> by <style=cIsDamage>100%</style> <style=cStack>(+100% per stack)</style>.",
    "CI_INFINITESECONDARYSKILLCHARGES_LORE": "",
    "CI_DRAWSPEEDPATH_NAME": "Chalk",
    "CI_DRAWSPEEDPATH_PICKUP": "Draw a path as you move that increases movement speed and grants flight.",
    "CI_DRAWSPEEDPATH_DESC": "Draw a path as you move. While on this path, increase <style=cIsUtility>movement speed</style> by <style=cIsUtility>50%</style> <style=cStack>(+50% per stack)</style> and <style=cIsUtility>gain flight</style>. Max path length: 512  <style=cStack>(+128 per stack)</style>.",
    "CI_DRAWSPEEDPATH_LORE": "",
    "CI_BRIBEENEMIESANDBUFFMINIONS_NAME": "Majestic Hand",
    "CI_BRIBEENEMIESANDBUFFMINIONS_PICKUP": "Bribe enemies when close. Buff all minions.",
    "CI_BRIBEENEMIESANDBUFFMINIONS_DESC": "Enemies in the interaction range can be bribed. .",
    "CI_BRIBEENEMIESANDBUFFMINIONS_LORE": "",
    "CI_BOMBERWISP_BODY_NAME": "Bomber Wisp",
    "CI_MONSTERCHEST_POPUP_TEXT": "<b>Monster Chest</b>\n<i>Feed me</i>",
    "CI_MONSTERCHEST_SPEW": "Spew Boss Item",
    "CI_MONSTERCHEST_TITLE": "Monster Chest",
    "CI_MONSTERCHEST_CONTEXT": "Feed it",
    "CI_MONSTERCHEST_DESC": "Allows survivors to sacrifice items in exchange for a boss item.",
    "CI_MONSTERCHEST_CANSPEW": "Boss item can be spewed",
    "CI_GAMBIT_NAME": "Gambit",
    "CI_GAMBIT_MESSAGE_FIRSTEXTRACTORCALL1": "Scanners are located several huge deposits of liquid rich materials. To extract it, utilise a refinery for you to set up. To build pipelines, press Interaction button near the end pipeline point to create a placement hologram. Press Interaction button again to either build pipeline if the hologram is green, or cancel placement if the hologram is red. Locate the wells, set up pipelines and pump it all back to refinery. The more pipelines you will setup the bigger your paycheck will be",
    "CI_GAMBIT_MESSAGE_FIRSTEXTRACTORCALL2": "You setup targets on several deep wells of rich materials. I am sending a mobile refinery for you to fill. To extract it, Utilise a refinery for you to set up. To build pipelines, press Interaction button near the end pipeline point to create a placement hologram. Press Interaction button again to either build pipeline if the hologram is green, or cancel placement if the hologram is red. Set the whole thing up, get it cranking and let's pump those deposits dry. Time to build some pipelines, survivors",
    "CI_REFINERY_OBJECTIVE_COMPLETED": "<style=cHumanObjective>On Site Refinery</style> has been completed. Claim your prize on site",
    "CI_REFINERY_OBJECTIVE_SABOTAGE": "{0} pipes need to be repaired!",
    "CI_REFINERY_OBJECTIVE_RUNNING": "Wait for <style=cHumanObjective>On Site Refinery</style> to finish ({0}%)",
    "CI_REFINERY_OBJECTIVE_BUILDING_FIRST": "Build pipelines. Atleast {2} pipelines needs to be built to start <style=cHumanObjective>On Site Refinery</style> ({0}/{1})",
    "CI_REFINERY_OBJECTIVE_BUILDING": "Build pipelines. <style=cHumanObjective>On Site Refinery</style> can be started ({0}/{1})",
    "CI_REFINERY_OBJECTIVE_READY": "<style=cHumanObjective>On Site Refinery</style> is ready to start",
    "CI_REFINERY_TITLE": "On Site Refinery",
    "CI_REFINERY_DESC": "Gambit equipment to extract planets valuable materials. Call extractors onto resource wells, build and connect pipelines to extractors, start refinery, repair pipes and claim your item reward.",
    "CI_REFINERY_CONTEXT": "Start On Site Refinery",
    "CI_PIPELINE_BUILD_CONTEXT": "Build",
    "CI_PIPELINE_REPAIR_CONTEXT": "Repair",
    "CI_PIPELINE_CANCEL_CONTEXT": "Cancel Building",
    "CI_RESOURCEWELL_CONTEXT": "Call Extractor",
    "CI_PIPELINEVEHICLE_EXIT": "Slide off",
    "CI_BUILDER_ANGLE": "Angle:",
    "CI_BUILDER_DISTANCE": "Distance:",
    "CI_BUILDER_ERROR": "ERROR",
    "CI_BUILDER_COLLISION": "Collision",
    "CI_BUILDER_COLLIDES_VALID": "No",
    "CI_BUILDER_COLLIDES_INVALID": "Yes",
    "CI_BISHOP_SPEAR_THROW": "Throw",
    "CI_BISHOP_SPEAR_SLAM": "Slam",
    "CI_BISHOP_SPEAR_CHAIN": "WIP",
    "CI_DIFFICULTY_HURTMEPLENTY_NAME": "Hurt Me Plenty",
    "CI_DIFFICULTY_HURTMEPLENTY_DESC": "This is the way the game is meant to be played as Doomguy! Beat The Main Final Boss as Doomguy to unlock this difficulty for all survivors and unlock the rest of the difficulties for Doomguy (right now this feature is not implemented yet).<style=cStack>\n\nMonsters Projectile Speed: <style=cIsHealing>-35%</style>\nMonsters Flight Height: <style=cIsHealing>8m</style>\nElites: <style=cIsHealing>Gone</style>\nKnockback: <style=cIsDamage>Gone</style>\nDrones, Items And Equipments: <style=cIsDamage>Repooled</style>. <style=cIsHealth>-75% damage. Cannot stun, shock, immobilize and freeze</style>\nMonsters: <style=cIsHealth>Do not target minions</style>\nHeavy Monsters Health: <style=cIsHealth>+60%</style>\nBoss Monsters Health: <style=cIsHealth>+120%</style>\nPrinters And Scrappers: <style=cIsHealth>Gone</style>\nVoid And Lunar Items: <style=cIsHealth>Gone</style>\nWeak Monsters: <style=cIsHealth>Gone</style>\nHitstuns: <style=cIsHealth>Gone</style></style>",
    "CI_DOOMGUY_BODY_NAME": "Doomguy",
    "CI_DOOMGUY_BODY_SUBTITLE": "Doomed guy or dooming guy or something idk",
    "CI_DOOMGUY_NAME": "Doomguy",
    "CI_DOOMGUY_DESC": "He is da doomguy!",
    "CI_DOOMGUY_SHOTGUN_NAME": "Combat Shotgun",
    "CI_DOOMGUY_SHOTGUN_DESC": "Shoot pellets for <style=cIsDamage>5x120% damage</style>",
    "CI_DOOMGUY_SPEAR_NAME": "Spear Swing",
    "CI_DOOMGUY_SPEAR_DESC": "Swing spear for <style=cIsDamage>200% damage</style>. <style=cIsUtility>Parry</style> incoming <style=cIsHealing>parriable</style> attacks and projectiles. Gain <style=cDeath>empowerement</style> and <style=cIsUtility>reduce cooldown</style> of your Utility skill on <style=cIsHealing>successful parry</style>",
    "CI_DOOMGUY_ACCELERATOR_NAME": "Plasma Accelerator",
    "CI_DOOMGUY_ACCELERATOR_DESC": "Shoot plasma projectile for <style=cIsDamage>50% damage</style>. Continious fire will supercharge acceletrator and increase plasma projectile damage to <style=cIsDamage>125% damage</style>. Release supercharge on trigger exit and deal <style=cIsDamage>500% damage</style>",
    "CI_DOOMGUY_DASH_NAME": "Dash",
    "CI_DOOMGUY_DASH_DESC": "<style=cIsUtility>Dash</style> to move direction",
    "CI_DOOMGUY_SPEARSPECIAL_NAME": "Spear Empowerement",
    "CI_DOOMGUY_SPEARSPECIAL_DESC": "Prepare spear for <style=cDeath>empowerement</style>. Consume 5 <style=cDeath>empowerement</style> on use.\n\nPrimary: Throw spear for <style=cIsDamage>2000% damage</style>. <style=cIsDamage>Crits</style> and <style=cIsDamage>super stuns</style> on headshot.\n\nSecondary: WIP\n\nUtility: Leap downwards dealing <style=cIsDamage>700% damage</style> in <style=cIsUtility>24 meters radius</style>",
    "CI_DOOMGUY_PUNCH_NAME": "Punch",
    "CI_DOOMGUY_PUNCH_DESC": "Punch target for <style=cIsDamage>800% damage</style>. If target is <style=cDeath>staggered</style> charge is not consumed and heal for <style=cIsHealing>3.125%/12.5%/25%</style> max health and <style=cIsHealing>10%/25%/50%</style> reserve heal based on target class and gain <style=cDeath>empowerement</style>"
  }
}