    "ROB_HUNK_BODY_SHOOT_AR_NAME": "Fire",
    "ROB_HUNK_BODY_SHOOT_AR_DESCRIPTION": "Shoot for <style=cIsDamage>385% damage</style>. <style=cIsUtility>50% headshot bonus.</style>",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_NAME": "Fire",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Shoot for <style=cIsDamage>2x250% damage</style>. <style=cIsUtility>Damage scales with attack speed.</style>",
    "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Steady Aim",
    "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Take aim, <style=cIsUtility>exposing enemy weak points</style>. <style=cIsDamage>Using primary while aiming fires your held gun.</style>",
    "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Quickstep",
    "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Dash</style> a short distance. If used preemptively to <style=cIsUtility>avoid an attack</style>, perform a <style=cIsDamage>Perfect Dodge</style>.",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Dash</style> a short distance. If used preemptively to <style=cIsUtility>avoid an attack</style>, perform a <style=cIsDamage>Perfect Dodge</style>.\n<color=#d299ff>SCEPTER: The power of Uroboros flows through you.</color>",
    "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Parry",
    "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Block</style> an attack, <style=cIsDamage>negating</style> damage and <style=cIsUtility>refunding the cooldown</style>. If used preemptively, perform a <style=cIsDamage>Perfect Parry</style>.",
    "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Shoulder Bash",
    "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Bash</style> nearby enemies, <style=cIsUtility>stunning them</style> for <style=cIsDamage>400% damage</style>. If used preemptively to <style=cIsUtility>cancel an attack</style>, perform a <style=cIsDamage>Perfect Bash</style>.",
    "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Legion",
    "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Swap</style> to a different <style=cIsDamage>gun</style>. Tap to swap to your <style=cIsUtility>last held gun</style>.",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Combat Knife",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "A standard military-grade knife. Sure to come in handy in a pinch.",
    "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "Combat Knife EX",
    "ROB_HUNK_BODY_KNIFE_INFINITE_DESCRIPTION": "A specially-treated military-grade knife that's been hardened to an unbelievable degree. They say it's been made to really last.",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_NAME": "Hidden Blade",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_DESCRIPTION": "A low profile retractable blade hidden in the sleeve. Ideal for stealth operations.",
    "ROB_HUNK_BODY_KNIFE_WESKER_NAME": "Customized Knife",
    "ROB_HUNK_BODY_KNIFE_WESKER_DESCRIPTION": "A vicious blade with a serrated edge to aid in tearing up your opponents.",
    "ROB_HUNK_BODY_KNIFE_MACHETE_NAME": "Machete",
    "ROB_HUNK_BODY_KNIFE_MACHETE_DESCRIPTION": "A huge blade meant primarily for guerrilla tactics.",
    "ROB_HUNK_BODY_KNIFE_RE4_NAME": "Primal Knife",
    "ROB_HUNK_BODY_KNIFE_RE4_DESCRIPTION": "A knife forged with infinite possibilities.",
    "ROB_HUNK_BODY_KNIFE_BLOODY_NAME": "Soiled Blade",
    "ROB_HUNK_BODY_KNIFE_BLOODY_DESCRIPTION": "A bloodied blade with a serrated edge that has torn up many opponents.",
    "ROB_HUNK_BODY_KNIFE_HOTDOGGER_NAME": "HOT DOGGER",
    "ROB_HUNK_BODY_KNIFE_HOTDOGGER_DESCRIPTION": "As its name implies, this Umbrella-developed anti-bioweapon knife is used by those who like to show off.",
    "ROB_HUNK_BODY_KNIFE_STUNROD_NAME": "Stun Rod",
    "ROB_HUNK_BODY_KNIFE_STUNROD_DESCRIPTION": "DISCLAIMER: Does not actually stun.",
    "ROB_HUNK_BODY_KNIFE_KITCHEN_NAME": "Kitchen Knife",
    "ROB_HUNK_BODY_KNIFE_KITCHEN_DESCRIPTION": "A knife made for cooking. Its edge chips easily.",
    "ACHIEVEMENT_ROB_HUNK_COMPLETION_UNLOCKABLE_ACHIEVEMENT_ID_NAME": "HUNK: Grim Reaper",
    "ACHIEVEMENT_ROB_HUNK_COMPLETION_UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "As HUNK, beat the game or obliterate.",
    "ACHIEVEMENT_ROB_HUNK_MONSOON_UNLOCKABLE_ACHIEVEMENT_ID_NAME": "HUNK: Mastery",
    "ACHIEVEMENT_ROB_HUNK_MONSOON_UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "As HUNK, beat the game or obliterate on Monsoon.",
    "ACHIEVEMENT_ROB_HUNK_TYPHOON_UNLOCKABLE_ACHIEVEMENT_ID_NAME": "HUNK: Grand Mastery",
    "ACHIEVEMENT_ROB_HUNK_TYPHOON_UNLOCKABLE_ACHIEVEMENT_ID_DESCRIPTION": "As HUNK, beat the game or obliterate on Typhoon or Eclipse.\n<color=#8888>(Counts any difficulty Typhoon or higher)</color>",
    "ACHIEVEMENT_ROB_HUNK_SUPPORTER_ACHIEVEMENT_ID_NAME": "HUNK: Early Supporter",
    "ACHIEVEMENT_ROB_HUNK_SUPPORTER_ACHIEVEMENT_ID_DESCRIPTION": "Play HUNK before his official release.",
    "ACHIEVEMENT_ROB_HUNK_LIGHTWEIGHT_ACHIEVEMENT_ID_NAME": "HUNK: Minimalist",
    "ACHIEVEMENT_ROB_HUNK_LIGHTWEIGHT_ACHIEVEMENT_ID_DESCRIPTION": "As HUNK, clear stage 1 with no items.\n<color=#8888>(Guns and tools are not counted against you)</color>",
    "ACHIEVEMENT_ROB_HUNK_GUERRILLA_ACHIEVEMENT_ID_NAME": "HUNK: Locked and Loaded",
    "ACHIEVEMENT_ROB_HUNK_GUERRILLA_ACHIEVEMENT_ID_DESCRIPTION": "As HUNK, obtain a full arsenal.",
    "ACHIEVEMENT_ROB_HUNK_ROOKIE_ACHIEVEMENT_ID_NAME": "HUNK: First Day on the Job",
    "ACHIEVEMENT_ROB_HUNK_ROOKIE_ACHIEVEMENT_ID_DESCRIPTION": "As HUNK, obtain a new weapon.",
    "ACHIEVEMENT_ROB_HUNK_SWAT_ACHIEVEMENT_ID_NAME": "HUNK: Keeper of Peace",
