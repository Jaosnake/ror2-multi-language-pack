    "EQUIPMENT_AFFIXPOISON_NAME": "ردّ N'kuhana",
    "EQUIPMENT_AFFIXPOISON_PICKUP": "تحوّل إلى تجسيد للفساد.",
    "EQUIPMENT_AFFIXPOISON_DESC": "???",
    "EQUIPMENT_AFFIXHAUNTED_NAME": "الإكليل الطيفي",
    "EQUIPMENT_AFFIXHAUNTED_PICKUP": "تحوّل إلى تجسيد للاجسدية.",
