{
    "ja": {
        "JAVANGLE_HOUSE_BODY_NAME": "House",
        "JAVANGLE_HOUSE_BODY_DESCRIPTION": "",
        "JAVANGLE_HOUSE_BODY_SUBTITLE": "狂気のギャンブラー",
        "JAVANGLE_HOUSE_BODY_LORE": "スロットマシンといえば、宇宙船の娯楽ロビーに新しいのが設置されたんだが、みんなあのイカレた機械が生きてるとかなんとか噂しててな……おい、今なんてものを設置したって？！",
        "JAVANGLE_HOUSE_BODY_OUTRO_FLAVOR": "まあ、最初の景品がこのアーティファクトじゃなかったら、あのスロットマシンからあんなに引き出せなかっただろうし、あれを札束印刷機にしちまったから店主は激怒、追い出されて以来ずっとあのスロットマシンに追われてるんだ",
        "JAVANGLE_HOUSE_BODY_OUTRO_FAILURE": "おいおい待て待て！落ち着けって、虚空のカジノだって？スロットマシンに殺されかけた？……つまり、そこでそのアーティファクトを手に入れたってわけか？",
        "JAVANGLE_HOUSE_BODY_DEFAULT_SKIN_NAME": "House",
        "JAVANGLE_HOUSE_BODY_MASTERY_SKIN_NAME": "Mansion",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "House：マスタリー",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Houseとして、Monsoonでゲームをクリアするか消滅する。",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "House：マスタリー",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "House：グランドマスタリー",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "Houseとして、Typhoonでゲームをクリアするか消灭する。",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "House：グランドマスタリー",
        "JAVANGLE_HOUSE_PASSIVE_NAME": "ザ・ゲーム",
        "JAVANGLE_HOUSE_PASSIVE_DESCRIPTION": "Houseは<style=cIsUtility>スキル</style>の代わりに<style=cIsUtility>カード</style>を使用し、各カードは固有の効果を持ちます。カードを使用するとそのスロットがクールダウンに入り、手札を捨てて新しいカードを3枚引きます。",
        "JAVANGLE_HOUSE_STANDARDSPREAD_NAME": "デッキ：スタンダードスプレッド",
        "JAVANGLE_HOUSE_STANDARDSPREAD_DESCRIPTION": "使いやすさを重視して設計されたシンプルなデッキ。<style=cSub>[このデッキに含まれるカードは「カード」タブで確認できます]</style>",
        "JAVANGLE_HOUSE_FULLHOUSE_NAME": "デッキ：Full House",
        "JAVANGLE_HOUSE_FULLHOUSE_DESCRIPTION": "クラシックなHouseの真骨頂。<style=cSub>[このデッキに含まれるカードは「カード」タブで確認できます]</style>",
        "JAVANGLE_HOUSE_DIVINATION_NAME": "デッキ：ディビネーション",
        "JAVANGLE_HOUSE_DIVINATION_DESCRIPTION": "カードの構成をコントロールできる高度なデッキ。<style=cSub>[このデッキに含まれるカードは「カード」タブで確認できます]</style>",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_NAME": "バレットアーツ：エンプティ",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_DESCRIPTION": "装填された弾丸をランダムに1発発射します。弾丸が残っていない場合：何もしません。",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_NAME": "バレットアーツ：クイックドロー",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_DESCRIPTION": "発射速度が上昇しますが、<style=cArtifact>すべての弾丸のダメージが低下します</style>。弾丸が残っていない場合：何もしません。",
        "JAVANGLE_HOUSE_RELOADSTANDARD_NAME": "リロードアーツ：スタンダード",
        "JAVANGLE_HOUSE_RELOADSTANDARD_DESCRIPTION": "任意のカードを使用するとルーレットをリロードします。使用したカードの種類に応じて、50%/25%の確率で1/2発のランダムな特殊弾を獲得します（赤 = 貫通/散弾/爆発、紫 = 空砲/スネーク、灰/緑 = 過去のいずれか）。<style=cSub>[弾丸とその効果は「カード」タブで確認できます]</style>",
        "JAVANGLE_HOUSE_RELOADALLIN_NAME": "リロードアーツ：オールイン",
        "JAVANGLE_HOUSE_RELOADALLIN_DESCRIPTION": "任意のカードを使用するとルーレットをリロードします。貫通/散弾/爆発弾を0〜6発装填し、<style=cArtifact>残りの弾丸はすべてスネーク弾になります</style>。<style=cSub>[弾丸とその効果は「カード」タブで確認できます]</style>",
        "JAVANGLE_HOUSE_CARDARTSHOP_NAME": "カードアーツ：ホップ",
        "JAVANGLE_HOUSE_CARDARTSHOP_DESCRIPTION": "任意のカードを使用時：現在の移動方向に跳躍します。",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_NAME": "カードアーツ：スウィープ",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_DESCRIPTION": "任意のカードを使用時：前方にカードを振り払い、近接範囲の敵に<style=cIsDamage>{0}%のダメージ</style>を与え、命中した敵1体につき<style=cIsUtility>最大体力の{1}%に相当するバリアを獲得します</style>。",
        "JAVANGLE_HOUSE_SHUFFLEART_NAME": "シャッフルアーツ：リシャッフル",
        "JAVANGLE_HOUSE_SHUFFLEART_DESCRIPTION": "カードが尽きた時：捨て札を山札に戻して再びシャッフルします。",
        "JAVANGLE_HOUSE_STANDARDSHOT_NAME": "通常弾",
        "JAVANGLE_HOUSE_STANDARDSHOT_DESCRIPTION": "標準的な弾丸を1発発射し、<style=cIsDamage>{0}%のダメージ</style>を与えます。",
        "JAVANGLE_HOUSE_PIERCINGSHOT_NAME": "貫通弾",
        "JAVANGLE_HOUSE_PIERCINGSHOT_DESCRIPTION": "ターゲットを貫通する特殊な弾丸を発射し、敵ごとに<style=cIsDamage>{0}%のダメージ</style>を与えます",
        "JAVANGLE_HOUSE_BUCKSHOT_NAME": "散弾",
        "JAVANGLE_HOUSE_BUCKSHOT_DESCRIPTION": "ショットガンの一斉射撃を行い、<style=cIsDamage>{0}% x {1}のダメージ</style>を与えます。",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_NAME": "爆発弾",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_DESCRIPTION": "爆発する弾丸を発射し、範囲内の敵に<style=cIsDamage>{0}%のダメージ</style>を与えます。",
        "JAVANGLE_HOUSE_SNAKESHOT_NAME": "スネーク弾",
        "JAVANGLE_HOUSE_SNAKESHOT_DESCRIPTION": "発射を試みるも<style=cSub>失敗し</style>、<style=cDeath>最大体力の{0}%に相当する自傷ダメージ</style>を受けます",
        "JAVANGLE_HOUSE_BLANKSHOT_NAME": "空砲弾",
        "JAVANGLE_HOUSE_BLANKSHOT_DESCRIPTION": "発射を試みますが、カチリと音が鳴るだけで……<style=cSub>何も起こりません</style>。",
        "JAVANGLE_HOUSE_MYSTERYSHOT_NAME": "ミステリー弾",
        "JAVANGLE_HOUSE_MYSTERYSHOT_DESCRIPTION": "ランダムに装填された特殊弾を発射します。",
        "JAVANGLE_HOUSE_ACESHOT_NAME": "エースショット",
        "JAVANGLE_HOUSE_ACESHOT_DESCRIPTION": "前方のすべての敵に<style=cIsDamage>{0}%のダメージ</style>を与える巨大な弾丸をチャージして放ちます。全射程に届き、壁をも貫通します",
        "JAVANGLE_HOUSE_7CLUBS_NAME": "クラブの7",
        "JAVANGLE_HOUSE_7CLUBS_DESCRIPTION": "ルーレットに<style=cIsUtility>ミステリー弾を3発</style>装填します。\nさらに、次の弾丸が爆発弾になることを<style=cIsUtility>保証</style>します。",
        "JAVANGLE_HOUSE_7SPADES_NAME": "スペードの7",
        "JAVANGLE_HOUSE_7SPADES_DESCRIPTION": "{0}秒間、<style=cIsUtility>移動速度上昇</style>と<style=cIsUtility>完全にランダムな2種類のバフ</style>を獲得します。\nさらに、次の弾丸が貫通弾になることを<style=cIsUtility>保証</style>します。",
        "JAVANGLE_HOUSE_7DIAMONDS_NAME": "ダイヤの7",
        "JAVANGLE_HOUSE_7DIAMONDS_DESCRIPTION": "<style=cShrine>ゴールドを獲得</style> <style=cSub>（チェストのコストに応じてスケール）</style>。",
        "JAVANGLE_HOUSE_7HEARTS_NAME": "ハートの7",
        "JAVANGLE_HOUSE_7HEARTS_DESCRIPTION": "<style=cIsHealing>最大体力の50%を回復</style>し、現在の体力に応じて<style=cIsUtility>最大50%のバリアを獲得</style>します。",
        "JAVANGLE_HOUSE_JACKPOT_NAME": "ジャックポット！",
        "JAVANGLE_HOUSE_JACKPOT_DESCRIPTION": "「クラブの7」「ダイヤの7」「ハートの7」「スペードの7」の効果を2倍の威力でランダムに発動し、20%の確率で<style=cIsUtility>すべて同時に発動します</style>。",
        "JAVANGLE_HOUSE_52_NAME": "ピックアップ52",
        "JAVANGLE_HOUSE_52_DESCRIPTION": "残りの全カードを空中に投げ上げ、すべてを山札に戻してシャッフルします。各カードは敵を追尾し、<style=cIsDamage>ランダムな量のダメージを与えます</style>。",
        "JAVANGLE_HOUSE_SNAKE_NAME": "スネークアイズ",
        "JAVANGLE_HOUSE_SNAKE_DESCRIPTION": "デッキを<style=cArtifact>リロール</style>します。\n<style=cDeath>スネーク弾を6発装填</style>します。\n<style=cArtifact>危機</style>、<style=cDeath>破壊</style>、<style=cArtifact>破滅</style>、<style=cDeath>喪失</style>。\n<style=cIsUtility>[破壊不能]</style>",
        "JAVANGLE_HOUSE_BUST_NAME": "バースト！",
        "JAVANGLE_HOUSE_BUST_DESCRIPTION": "即座に<style=cDeath>最大体力の{0}%に相当するダメージ</style>を受け、周囲の敵に<style=cIsDamage>最大体力の{1}%</style>のダメージを与えます。",
        "JAVANGLE_HOUSE_SWORDS_NAME": "スート・オブ・ソード",
        "JAVANGLE_HOUSE_SWORDS_DESCRIPTION": "貫通弾を1発装填し、次の手札にランダムな攻撃カードを1枚引きます。",
        "JAVANGLE_HOUSE_COINS_NAME": "スート・オブ・コイン",
        "JAVANGLE_HOUSE_COINS_DESCRIPTION": "<style=cArtifact>現在所持ゴールドの{0}%を失い</style>、失ったゴールドの<style=cIsDamage>{1}%に相当するダメージ</style>を周囲の敵に与えます。",
        "JAVANGLE_HOUSE_TOWER_NAME": "ザ・タワー",
        "JAVANGLE_HOUSE_TOWER_DESCRIPTION": "<style=cArtifact>危機</style>、<style=cDeath>破壊</style>、<style=cArtifact>破滅</style>、<style=cDeath>喪失</style>、<style=cArtifact>障害</style>、<style=cDeath>激変</style>。\n<style=cIsUtility>[破壊不能]</style>",
        "JAVANGLE_HOUSE_JOKER_NAME": "ザ・ジョーカー",
        "JAVANGLE_HOUSE_JOKER_DESCRIPTION": "ランダムな他の<style=cArtifact>紫カード効果</style>を発動し、20%の確率で<style=cArtifact>すべてを同時に発動</style>します。\n<style=cSub>（タワーは発動できません）</style>",
        "JAVANGLE_HOUSE_7JACK_NAME": "ダイヤのジャック",
        "JAVANGLE_HOUSE_7JACK_DESCRIPTION": "通常弾を6発装填します。\n接地時：前方へスライドします。",
        "JAVANGLE_HOUSE_7QUEEN_NAME": "スペードのクイーン",
        "JAVANGLE_HOUSE_7QUEEN_DESCRIPTION": "一時的に<style=cIsUtility>ランダムな2つのステータスを強化</style>しますが、<style=cArtifact>別のランダムな2つのステータスを弱体化</style>させます。",
        "JAVANGLE_HOUSE_7KING_NAME": "クラブのキング",
        "JAVANGLE_HOUSE_7KING_DESCRIPTION": "爆発弾、貫通弾、散弾、スネーク弾、空砲弾、ミステリー弾を各1発装填します。",
        "JAVANGLE_HOUSE_7ACE_NAME": "スペードのエース",
        "JAVANGLE_HOUSE_7ACE_DESCRIPTION": "長い遅延の後に<style=cIsDamage>{0}%のダメージ</style>を与える唯一無二の弾丸を1発だけ装填します。",
        "JAVANGLE_HOUSE_WILDCARD_NAME": "ワイルドカード",
        "JAVANGLE_HOUSE_WILDCARD_DESCRIPTION": "予測不能な何かが起こります。良いことか、悪いことか、どちらでもないか……あるいは両方か？\n<style=cIsUtility>[破壊不能]</style>",
        "JAVANGLE_HOUSE_RROULETTE_NAME": "ロシアンルーレット",
        "JAVANGLE_HOUSE_RROULETTE_DESCRIPTION": "1/6の確率で死亡、4/6でアンテ最大スタック、1/6で全敵殲滅。<style=cIsUtility>移動速度上昇</style> {0}秒、次の弾丸が貫通弾になることを<style=cIsUtility>保証</style>。",
        "JAVANGLE_HOUSE_FORTUNE_NAME": "運命の輪",
        "JAVANGLE_HOUSE_FORTUNE_DESCRIPTION": "<style=cShrine>運命の輪を回す</style>：<style=cArtifact>強力な変動</style>を起こし、<style=cIsUtility>ランダムなプラスのタロット効果を発動します</style>。",
        "JAVANGLE_HOUSE_THREEOFAKIND_NAME": "スリー・オブ・ア・カインド",
        "JAVANGLE_HOUSE_THREEOFAKIND_DESCRIPTION": "次の手札をすべて引き、<style=cIsUtility>一気に使用します</style>。",
        "JAVANGLE_HOUSE_GCLUBS_NAME": "黄金のクラブ7",
        "JAVANGLE_HOUSE_GCLUBS_DESCRIPTION": "ルーレットに<style=cIsUtility>ランダムなプラス効果の弾丸を3発</style>装填します。\nさらに、次の弾丸が爆発弾になることを<style=cIsUtility>保証</style>します。",
        "JAVANGLE_HOUSE_GSPADES_NAME": "黄金のスペード7",
        "JAVANGLE_HOUSE_GSPADES_DESCRIPTION": "{0}秒間、<style=cIsUtility>移動速度上昇</style>を獲得します。\nさらに、次の弾丸が貫通弾になることを<style=cIsUtility>保証</style>します。",
        "JAVANGLE_HOUSE_GHEARTS_NAME": "黄金のハート7",
        "JAVANGLE_HOUSE_GHEARTS_DESCRIPTION": "<style=cIsHealing>最大体力の100%を回復し、100%のバリアを獲得します</style>。",
        "JAVANGLE_HOUSE_GJACK_NAME": "黄金のダイヤのジャック",
        "JAVANGLE_HOUSE_GJACK_DESCRIPTION": "前方へスライドし、進路上のあらゆるものに 1000% のダメージを与えます。",
        "JAVANGLE_HOUSE_CRAZYCARD_NAME": "愚者",
        "JAVANGLE_HOUSE_CRAZYCARD_DESCRIPTION": "完全にランダムで予測不能な、時に非常に奇妙なカードを3枚引きます。",
        "JAVANGLE_HOUSE_CASHOUT_NAME": "キャッシュアウト！",
        "JAVANGLE_HOUSE_CASHOUT_DESCRIPTION": "1/3の確率で<style=cArtifact>全ゴールドを喪失</style>、1/3の確率で何も起こらず、1/3の確率で<style=cIsDamage>マップ上の全敵にダメージを与え</style><style=cIsUtility>一時的なアイテムを獲得</style>します。\n<style=cSub>（ダメージとアイテムのレア度は賭けたゴールド額に応じてスケールします）</style>",
        "JAVANGLE_HOUSE_THESUN_NAME": "太陽",
        "JAVANGLE_HOUSE_THESUN_DESCRIPTION": "<style=cIsUtility>手札にある他の全カードの複製を作成</style>し、次の手札として引き入れます。\n<style=cSub>（「破壊不能」カードには無効）</style>。\n<style=cSub>（この効果は他のカードによって誘発できません）</style>。",
        "JAVANGLE_HOUSE_THEMOON_NAME": "月",
        "JAVANGLE_HOUSE_THEMOON_DESCRIPTION": "<style=cIsUtility>手札にある他の全カードを破壊</style>し、デッキから完全に除外します。\n<style=cSub>（「破壊不能」カードには無効）</style>。\n<style=cSub>（この効果は他のカードによって誘発できません）</style>。",
        "JAVANGLE_HOUSE_THESTAR_NAME": "星",
        "JAVANGLE_HOUSE_THESTAR_DESCRIPTION": "山札、手札、捨て札にある<style=cIsUtility>すべての「太陽」「月」「星」「世界」カードを破壊</style>し、デッキから完全に除外します。<style=cSub>（この効果は他のカードによって誘発できません）</style>。",
        "JAVANGLE_HOUSE_THEWORLD_NAME": "世界",
        "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION": "山札、手札、捨て札にある<style=cIsUtility>すべての「太陽」「月」「星」「世界」カードを破壊</style>し、デッキから完全に除外します。\n<style=cSub>（この効果は他のカードによって誘发できません）</style>。",
        "JAVANGLE_HOUSE_JUDGEMENT_NAME": "審判",
        "JAVANGLE_HOUSE_JUDGEMENT_DESCRIPTION": "デッキに加えられたすべての変更を取り消し、<style=cIsUtility>初期状態のデッキへと完全に復元します</style>。<style=cSub>（リスポーン時やステージ移行時と同様）</style>\n<style=cSub>（この効果は他のカードによって誘発できません）</style>。\n<style=cIsUtility>[破壊不能]</style>",
        "JAVANGLE_HOUSE_KINGOFWANDS_NAME": "ワンドのキング",
        "JAVANGLE_HOUSE_KINGOFWANDS_DESCRIPTION": "<style=cIsUtility>「アンテ」のスタックを消費</style>し、消費量に応じて<style=cIsHealing>回復を提供します</style>。\n<style=cIsHealing>すべての従属味方はその半分の量を回復します</style>。",
        "JAVANGLE_HOUSE_QUEENOFCUPS_NAME": "カップのクイーン",
        "JAVANGLE_HOUSE_QUEENOFCUPS_DESCRIPTION": "<style=cIsUtility>「アンテ」のスタックを消費</style>し、装填された弾丸を<style=cIsUtility>消費せずに発射可能になる</style>バフをHouseに付与します。\nこのバフの持続時間は消費した「アンテ」の量に応じて決まります。",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_NAME": "ソードのナイト",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_DESCRIPTION": "<style=cIsUtility>「アンテ」のスタックを消費</style>し、消費した量と同数の<style=cIsUtility>プラス弾丸を装填します</style>。\nさらに、次の弾丸が爆発弾になることを<style=cIsUtility>保証</style>します。",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_NAME": "ペンタクルのペイジ",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_DESCRIPTION": "<style=cIsUtility>「アンテ」のスタックを消費</style>し、味方として戦うルナ・キメラを召喚します。消費した「アンテ」が多いほど、より強力な軍勢が召喚されます。\n最大スタック消費時、代わりにランダムなサバイバーを1人召喚します。",
        "JAVANGLE_HOUSE_ANTEUP_NAME": "アンテ・アップ！",
        "JAVANGLE_HOUSE_ANTEUP_DESCRIPTION": "<style=cIsUtility>「アンテ」のスタックを獲得します</style>。\nアンテのスタックごとに装甲が減少しますが、移動速度と攻撃速度が上昇します。",
        "JAVANGLE_HOUSE_ANCIENTACE_NAME": "エンシェント・エース",
        "JAVANGLE_HOUSE_ANCIENTACE_DESCRIPTION": "ルーレットに<style=cIsUtility>ミステリー弾を6発</style>装填します。\nさらに、<style=cIsUtility>以下の効果のうち1つを付与します</style>。\n<style=cIsUtility>Dueces</style>：使用するすべてのカードが2回発動する\n<style=cIsUtility>Flush</style>：カードを使用するたび、残りの手札をすべて使用する（マイナスカードおよびランダムカードを除く）\n<style=cIsUtility>Cups</style>：ルーレットの射撃に弾丸を消費しなくなる\n<style=cIsUtility>[破壊不能]</style>",
        "ARTIFACT_OF_WILDROOM_NAME": "ワイルドルームのアーティファクト",
        "ARTIFACT_OF_WILDROOM_DESCRIPTION": "各ステージ開始時にワイルドルーム（Wildroom）を召喚します。\nWildroomは自身を解除できなくなり、House以外のプレイヤーにも影響を及ぼします。",
        "JAVANGLE_HOUSE_NULL_NAME": "虚無",
        "JAVANGLE_HOUSE_NULL_DESCRIPTION": "何もしません。リロードすら行いません。\nやってくれたな。すべてを破壊し、無へと帰した。そして今や何も残っていない……これで満足か……？"
    }
}