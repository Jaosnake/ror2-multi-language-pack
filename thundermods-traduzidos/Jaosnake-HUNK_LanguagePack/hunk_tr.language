        "ROB_HUNK_BODY_PPASSIVE_NAME": "OSP (Yerinde Tedarik)",
        "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK, <style=cIsDamage>silah çantalarını</style> açıp cephaneliğini genişletmek için <color=#FFFF00>U.C. Anahtar Kartları</color> toplayabilir.",
        "ROB_HUNK_BODY_PPASSIVE2_NAME": "Unutulmuş Asker",
        "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "Her aşamada ölen ilk <style=cIsHealth>patron</style>, bir silah veya eklenti içeren bir <style=cIsDamage>ikmal paketi</style> düşürür.",
        "ROB_HUNK_BODY_PASSIVE_NAME": "Acımasız Mücadele",
        "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Bir <style=cIsDamage>LE 5</style> ve <style=cIsDamage>yan silah</style> ile başla. Mermi bulmak için <style=cIsUtility>sandıkları</style> <style=cIsDamage>karıştırabilirsin</style>.",
        "ROB_HUNK_BODY_PASSIVE2_NAME": "Yaklaşan Dehşet",
        "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "<style=cIsDamage>Tam bir cephanelikle</style> başla, <style=cIsHealth>ANCAK</style> artık <style=cIsHealth>hiç mermi kazanamazsın</style>.",
        "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "Yeni Oyun+",
        "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Bir <style=cIsDamage>LE 5</style> ve <style=cIsDamage>yan silah</style> ile başla. Mermi bulmak için <style=cIsUtility>sandıkları</style> <style=cIsDamage>karıştırabilirsin</style>. <style=cIsHealth>Tüm silah çantası içerikleri rastgeledir.</style>",
        "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Mutlak Otorite",
        "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "<style=cIsHealth>YALNIZCA</style> bir <style=cIsDamage>W-870</style> ile başla. Mermi bulmak için <style=cIsUtility>sandıkları</style> <style=cIsDamage>karıştırabilirsin</style>.",
        "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Nihai Paralı Asker",
        "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "<style=cIsHealth>YALNIZCA</style> <style=cIsDamage>tamamen geliştirilmiş bir LE 5</style> ile başla. Mermi bulmak için <style=cIsUtility>sandıkları</style> <style=cIsDamage>karıştırabilirsin</style>. <style=cIsDamage>Özel</style> yeteneğin yerini <color=#C80202>Kargaşa Modu</color> alır.",
        "ROB_HUNK_BODY_WPASSIVE_NAME": "Tam Küresel Doygunluk",
        "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "<style=cIsHealth>YALNIZCA</style> bir <style=cIsDamage>yan silah</style> ile başla. Mermi bulmak için <style=cIsUtility>sandıkları</style> <style=cIsDamage>karıştırabilirsin</style>. <style=cIsDamage>İşlevsel</style> yeteneğin yerini <color=#C80202>Uroboros</color> alır.",
        "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Piromani",
        "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "<style=cIsHealth>YALNIZCA</style> bir <style=cIsDamage>Kimyasal Alev Makinesi</style> ile başla. Mermi bulmak için <style=cIsUtility>sandıkları</style> <style=cIsDamage>karıştırabilirsin</style>. <style=cIsHealth>Her aşamada yalnızca BİR silah çantası ortaya çıkar.</style>",
        "ROB_HUNK_BODY_CONFIRM_NAME": "Onayla",
        "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "Mevcut yetenekle devam et.",
        "ROB_HUNK_BODY_CANCEL_NAME": "İptal",
        "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "Mevcut yeteneği iptal et.",
        "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Savaş Bıçağı",
        "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Yağmalama.</style> Yakın mesafedeki düşmanları <style=cIsDamage>%200 hasar</style> vererek <style=cIsDamage>kes</style> ve <style=cIsHealth>Parçalanmış</style> etkisi uygula.",
        "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Yakın Mesafe Çatışması)",
        "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Yağmalama.</style> <style=cIsDamage>%200 ve %250 hasar</style> veren <style=cIsDamage>iki tekme savur</style>. <style=cIsUtility>İkinci tekme</style> isabet ederse devamında bir <style=cIsDamage>Karşı Saldırı</style> yap.",
        "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Tara",
        "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "<style=cIsUtility>Açılmamış silah çantalarını</style> bulmak için tarama yap.",
        "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Kanca At",
        "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "<style=cIsUtility>Uzak bir noktaya</style> kanca fırlat, ardından <style=cIsUtility>kendini oraya çek</style>. <style=cIsDamage>Yere indikten sonra karşı saldırı yapabilirsin.</style>",
