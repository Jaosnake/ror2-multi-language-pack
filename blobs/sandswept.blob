		public static float poolRadius;

		[ConfigField("Pool Base Damage", "Decimal.", 7.5f)]
		public static float poolBaseDamage;

		[ConfigField("Pool Stack Damage", "Decimal.", 7.5f)]
		public static float poolStackDamage;

