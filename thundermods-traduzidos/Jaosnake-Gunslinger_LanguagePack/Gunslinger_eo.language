    "GUNSLINGER_GAUNTLET_ITEM_NAME": "Senfina Gantlego",
    "GUNSLINGER_GAUNTLET_ITEM_DESC": "<style=cIsDamage>Mortigas 50%</style> de <style=cIsHealth>cxiuj</style> vivaj estajxoj hazarde. Resxargigxas cxiujn <style=cIsUtility>60s</style>.",
    "GUNSLINGER_GAUNTLET_ITEM_PICKUP": "Forigu duonon de cxiu vivo hazarde.",
    "GUNSLINGER_GAUNTLET_ITEM_LORE": "\"Mi scias, kio estas perdi. Senti tiel senespere, ke vi pravas, tamen malsukcesi malgraux tio. Gxi estas timiga, tremigas la krurojn.\"",
    "GUNSLINGER_NAME": "Gunslinger",
    "GUNSLINGER_SUBTITLE": "Pacgardanto",
    "GUNSLINGER_PASSIVE_NAME": "Fantoma Formo",
    "GUNSLINGER_PASSIVE_DESCRIPTION": "Gunslinger farigxas pli forta proksime de malamikaj entoj.               <style=cKeywordName>Fantoma Formo</style><style=cSub></style>",
    "GUNSLINGER_VENDETTA": "Vendetta",
    "GUNSLINGER_VENDETTA_DESCRIPTION": "Gunslinger pafas Vendetta por 280% da damagxo per cxiu kuglo, portas gxis ses kuglojn kaj resxargas post la lasta. Cxiu sesa kuglo kritike trafas por plia 25% da damagxo.",
    "GUNSLINGER_UNLOAD": "Malsxargxi",
    "GUNSLINGER_UNLOAD_DESCRIPTION": "Pafu Vendetta por 200% da damagxo. Por cxiu sukcesa pafo kontraux malamiko, la damagxo kaj kritika sxanco de Malsxargxi pligrandigxas, gxis +150% da damagxo kaj 40% da kritika sxanco. Maltrafitaj pafoj (cxiela fono ne kalkuligxas) restarigas la stakojn de Malsxargxi.",
    "GUNSLINGER_ACCURSEDARM": "Malbenita Brako",
    "GUNSLINGER_ACCURSEDARM_DESCRIPTION": "Gunslinger sxargas potencan malbenon, kiu faras 400% da damagxo, trapikante malamikojn en linio. Trafataj malamikoj estas malfortigitaj.",
    "GUNSLINGER_ORB": "Malbenita Globo",
    "GUNSLINGER_ORB_DESCRIPTION": "Gunslinger jxetas potencan malbenan sferon, kiu sxokas proksimajn malamikojn por 10% da damagxo kaj eksplodas cxe trafo en largxa areo por 320% da damagxo. Malamikoj trafitaj de la eksplodo estas malfortigitaj.",
    "GUNSLINGER_WRAITHSTEP": "Fantoma Pasxo",
    "GUNSLINGER_WRAITHSTEP_DESCRIPTION": "Gunslinger rapidiras je mallonga distanco. Stokas gxis kvin sxargojn.",
    "GUNSLINGER_WRAITHFRENZY": "Fantoma Frenezo",
    "GUNSLINGER_WRAITHFRENZY_DESCRIPTION": "Gunslinger eniras frenezan staton, akirante 50% da Movigxrapido kaj 20% da Vivsxtelo. Dauras 3 sekundojn.",
    "GUNSLINGER_SOULPIERCER": "Anmotrapikilo",
    "GUNSLINGER_SOULPIERCER_DESCRIPTION": "Gunslinger pafas ekeston de fantomaj kugloj, farante 180% da damagxo per kuglo. La nombro de kugloj pligrandigxas per ataka rapido. Trapikas malamikojn. Faras kroman damagxon laux la perdita sano de la malamiko.",
    "GUNSLINGER_DEADEYE": "Pafadkapablo",
    "GUNSLINGER_DEADEYE_DESCRIPTION": "Precize celu celon. Pafu gxis 3 potencajn kuglojn, kiuj eksplodas cxe kontakto, farante 300% da damagxo en malgranda areo. Trafataj malamikoj estas malrapidigitaj. <style=cKeywordName>Sxvebi</style><style=cSub></style>",
    "GUNSLINGER_DEADEYE_KEYWORD": "<style=cKeywordName>Sxvebi</style><style=cSub> Gunslinger sxvebas en la aero kaj estas senmovigita dum la dauxro. Estante en la aero, pafu 3 kuglojn en rapida sinsekvo, farante 200% da damagxo cxiu.</style>",
    "GUNSLINGER_DEADEYE_PRIMARY": "Pafadkapablo",
    "GUNSLINGER_DEADEYE_PRIMARY_DESCRIPTION": "Gunslinger sxvebas en la aero kaj precize celas celon. Pafu gxis 3 potencajn kuglojn, kiuj eksplodas cxe kontakto, farante 300% da damagxo en malgranda areo. Malamikoj trafitaj estas malrapidigitaj.",
    "GUNSLINGER_DESCRIPTION": "La plej rapida pafisto en la okcidento.<color=#CCD3E0></color>",
    "GUNSLINGER_OUTRO": "..kaj tiel li foriris, kantante Take Me Home.",
    "GUNSLINGER_FAIL": "..kaj tiel li malaperis, malproksime en la spacon.",
    "GUNSLINGER_RING_ITEM_LORE": "Kiel la lasta restanta Malvirta Ringo, mi atendas konsiderindan sumon."
  }
