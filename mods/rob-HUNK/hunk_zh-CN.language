        "ROB_NEMESIS_BODY_PASSIVE_NAME": "究极生命体",
        "ROB_NEMESIS_BODY_PASSIVE_DESCRIPTION": "<style=cIsDamage>造成伤害</style>可积蓄<style=cIsHealth>生物质</style>，蓄满时提升你的<style=cIsDamage>伤害</style>。跳跃可以<style=cIsDamage>蓄力</style>，发动<style=cIsUtility>强力飞跃</style>。",
        "ROB_NEMESIS_BODY_PASSIVE2_NAME": "生物兵器",
        "ROB_NEMESIS_BODY_PASSIVE2_DESCRIPTION": "Nemesis T-Type 可通过吞噬<style=cIsDamage>重要目标</style>来<style=cIsHealth>变异</style>，从而获得<style=cIsDamage>全新且强化的能力</style>。",
        "ROB_NEMESIS_BODY_PASSIVE22_NAME": "肌量增幅",
