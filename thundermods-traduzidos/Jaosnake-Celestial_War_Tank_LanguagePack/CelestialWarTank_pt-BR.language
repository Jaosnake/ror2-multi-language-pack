        "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>Vida: </color>20\n<color=#FF0000>Armadura: </color>7\n\nRotation Velocidade: 50\n\nPeso: 27\n",
        "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
        "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% de Velocidade de ataque</color>\n <color=#fc8080>-15% de Regeneração de vida</color>\n <color=#fc8080>+5% de Tempo de recarga total</color>\n\n<color=#00FF00>Vida: </color>20\n<color=#FF0000>Armadura: </color>2\n\nRotation Velocidade: 40\n\nPeso: 20\n",
        "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
        "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Vida: </color>10\n<color=#FF0000>Armadura: </color>0\n\nRotation Velocidade: 55\n\nPeso: 5\n",
        "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
        "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Vida: </color>100\n<color=#FF0000>Armadura: </color>20\n\nRotation Velocidade: 33\n\nPeso: 120\n",
        "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
        "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% de Tempo de recarga do Especial</color>\n <color=#fc8080>+15% de Tempo de recarga da Secundária</color>\n <color=#fc8080>-10% de Velocidade de ataque</color>\n\n<color=#00FF00>Vida: </color>120\n<color=#FF0000>Armadura: </color>23\n\nRotation Velocidade: 29\n\nPeso: 143\n",
        "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
        "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% de Dano</color>\n <color=#fc8080>+10% de Tempo de recarga total</color>\n\n<color=#00FF00>Vida: </color>160\n<color=#FF0000>Armadura: </color>0\n\nRotation Velocidade: 25\nLimite de Ângulo: 90\n\nPeso: 160\n",
        "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
        "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Vida: </color>45\n<color=#FF0000>Armadura: </color>4\n\nRotation Velocidade: 25\n\nPeso: 25\n",
        "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
        "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Vida: </color>35\n<color=#FF0000>Armadura: </color>15\n\nRotation Velocidade: 35\n\nPeso: 50\n",
        "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
        "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% de Tempo de recarga da Primária</color>\n <color=#fc8080>+8% de Tempo de recarga da Secundária</color>\n <color=#fc8080>+8% de Tempo de recarga do Utilitário</color>\n <color=#fc8080>+8% de Tempo de recarga do Especial</color>\n <color=#fc8080>-15% de Velocidade de ataque</color>\n\n<color=#00FF00>Vida: </color>35\n<color=#FF0000>Armadura: </color>3\n\nRotation Velocidade: 30\n\nPeso: 25\n",
        "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
        "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% de Dano</color>\n\n<color=#00FF00>Vida: </color>5\n<color=#FF0000>Armadura: </color>1\n\nRotation Velocidade: 40\nLimite de Ângulo: 30\n\nPeso: 6\n",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ORIGINAL",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "VERMELHO",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "VERMELHO CLARO",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "VERDE",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "VERDE ESCURO",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "AZUL",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "CIANO",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "ROSA",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "ROSA CHOQUE",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "MAGENTA",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "AMARELO",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "AMARELO NEON",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "ROXO NEON",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "LARANJA",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "BRANCO",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "PRETO",
        "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Isso muda a parte 'brilhante' do veículo para uma cor diferente.  Não afeta a jogabilidade.",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Sujo",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Limpo",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Camuflagem_Serrilhada",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Camuflagem_Pixelada",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Camuflagem_Papel",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Chapa_Xadrez",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Chapa_Parafusada",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Conjunto_Procedural",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Mistura_Colorida",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Degradê_Arco-Íris",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Monocromático",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Galáxia_Fluida",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Espaço",
        "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
        "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Sistemas de Motor",
        "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Utilitários e propulsão consomem combustível. A recarga é afetada pela <style=cIsUtility>velocidade de ataque</style>; capacidade por <style=cIsUtility>pós-combustores</style> e <style=cIsUtility>itens de pulo</style>. Pode <style=cIsUtility>correr em qualquer direção</style> e planar. No entanto, <color=#fc8080>não pula normalmente</color>.",
        "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Super Arsenal",
        "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "As escolhas de casco e torreta afetam vida, armadura, velocidade, propulsão e massa. <style=cIsUtility>Uma massa maior ajuda a empurrar inimigos mais pesados</style>; caso contrário, ficará mais propenso a <color=#ffff80>repulsão</color>.\n\nArmadura ou velocidade podem ajudar a amenizar a <color=#fc8080>péssima regeneração de vida</color> do tanque.",
        "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Instabilidade Celestial",
        "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "O tanque não consegue se reequilibrar no ar, <color=#ffff80>ficando propenso a perder o controle</color>. Aterrissar de cabeça para baixo deixa você <color=#fc8080>imobilizado e vulnerável por um curto período</color>.",
        "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Propulsores de Voo",
        "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Segure <style=cIsUtility>Pular</style> para iniciar o voo. A direção do voo depende do ângulo do seu tanque. <style=cIsUtility>O voo mais versátil</style>, mas pode ser difícil de usar.",
        "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Propulsores de Pulso",
        "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Permite que o tanque <style=cIsUtility>pule</style> normalmente como outros sobreviventes. A inclinação do tanque pode ser ativada no 2º pulo. Cada pulo consome <color=#ffc080>25</color> de combustível.",
        "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Propulsores de Flutuação",
        "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Permite que o tanque flutue acima do chão. Segure <style=cIsUtility>Pular</style> para subir; segure <style=cIsUtility>LeftAlt</style> para descer. Subir consome mais combustível.",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Metralhadoras",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Dispare constantemente causando <style=cIsDamage>2x40% de dano</style>.\n<style=cSub>[Peso: 5]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Escopeta",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Dispare causando <style=cIsDamage>12x75% de dano</style>.  <color=#ffc080>Queime combustível</color> para <style=cIsUtility>ganhar cargas extras</style>; <color=#80fc80>acerte uma manobra</color> para ganhar temporariamente um disparo potente de <style=cIsDamage>18x150% de dano</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 1s</style> | Peso: 9]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Lança-Granadas",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Dispare projéteis imprecisos causando <style=cIsDamage>4x250% de dano</style>.  Os projéteis são explosivos e pesados.\n<style=cSub>[<style=cIsUtility>Recarga: 4s</style> | <style=cIsDamage>Raio: 5m</style> | Peso: 15]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Lança-Mísseis",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Dispare mísseis precisos causando <style=cIsDamage>1000% de dano</style>. <style=cIsDamage>O dano aumenta conforme viaja</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 3s</style> | <style=cIsDamage>Raio: 8m</style> | Peso: 18]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Lança-Chamas",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Cuspa fogo causando <color=#E85E31>25% de dano de queimadura</color> a cada <color=#ffc080>15 de combustível por segundo</color>.  O dano aumenta com acúmulos; <style=cIsUtility>a velocidade de ataque aumenta o alcance</style>.\n<style=cSub>[<color=#ffc080>Movido a Combustível</color> | Peso: 12]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ultrantena",
        "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Eletrocute a si mesmo</color> e <style=cIsUtility>ative itens de abate</style>.  <style=cIsUtility>Tocar nos inimigos também os eletrocuta</style>, e eles recebem <style=cIsDamage>250% de dano</style> por item de <style=cIsUtility>abate</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 7s</style> | <style=cIsDamage>Raio: 5m</style> | Peso: 1]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Canhão Crítico",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Dispare causando <color=#ff4d76>1200% de dano crítico</color>. A chance crítica aumenta o dano do canhão.\n<style=cSub>[<style=cIsUtility>Recarga: 7s</style> | <style=cIsDamage>Raio: 10m</style> | Peso: 50]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Canhão Obuseiro",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Carregue para disparar causando um estrondoso <style=cIsDamage>7000% de dano</style>. <style=cIsUtility>Pode lançar o tanque se estiver no ar.</style>\n<style=cSub>[<style=cIsUtility>Recarga: 16s</style> | <style=cIsDamage>Raio: 15m</style> | Peso: 75]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Canhão de Impacto",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Dispare de forma imprecisa causando <style=cIsDamage>1700% de dano</style>. <style=cIsDamage>O dano diminui conforme viaja</style>; <style=cIsDamage>Itens de ativação aumentam o dano em vez disso</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 3s</style> | <style=cIsDamage>Raio: 5m</style> | Peso: 25]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Canhão Perfurante",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Dispare causando <style=cIsDamage>2500% de dano</style>.  Segure para calibrar e causar <style=cIsDamage>3500% de dano</style>, capaz de <style=cIsUtility>acertar pontos fracos</style>.  Quando calibrado, <color=#fc8080>mover-se piora a precisão</color>.\n<style=cSub>[<style=cIsUtility>Recarga: 5s</style> | <style=cIsDamage>Raio: 2m</style> | Peso: 45]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Canhão Francês",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Dispare causando míseros <style=cIsDamage>550% de dano</style>. Por algum motivo, <style=cIsUtility>tem ativação demais</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 1s</style> | Peso: 10]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Minigun",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Dispare rajadas causando <style=cIsDamage>50% de dano</style>. Com 75% de superaquecimento aplica <color=#E85E31>fogo</color>; <color=#fc8080>o superaquecimento trava a arma</color>. <style=cIsUtility>Itens de tempo de recarga aumentam a taxa de resfriamento</style>; <style=cIsUtility>Pentes reserva evitam o superaquecimento</style>.\n<style=cSub>[Peso: 45]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Canhão Básico",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Dispare um projétil veloz causando <style=cIsDamage>5400% de dano</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 12s</style> | <style=cIsDamage>Raio: 7m</style> | Peso: 65]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Canhão AA",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Dispare causando <style=cIsDamage>300% de dano</style>.  O projétil detona perto de alvos aéreos, causando <style=cIsDamage>2.5x de dano</style>.  <color=#fc8080>O tanque desacelera para disparar</color>.\n<style=cSub>[<style=cIsDamage>Raio: 5.5m</style> | Peso: 40]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Canhão de Dispersão",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Dispare causando <style=cIsDamage>2200% de dano</style> em um <style=cIsUtility>grande arco</style>, espalhando <style=cIsDamage>10x5% do dano total</style>.  O dano aumenta quanto mais longe viaja, até <style=cIsDamage>5500% de dano</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 10s</style> | <style=cIsDamage>Raio: 16m</style> | Peso: 55]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Canhão Celestial",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Consuma <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> de combustível para causar <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>de dano</color>.  Lasers carregados perfuram; <color=#fc8080>combustível insuficiente desativa a arma.</color>\n<style=cSub>[<color=#ffc080>Movido a Combustível</color> | Peso: 35]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Canhão Obliterador",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Carregue para disparar automaticamente um <color=#E85E31>projétil ativador de abate</color> causando <style=cIsDamage>12000% de dano</style>.  Depois disso, <color=#fc8080>as habilidades ficam desativadas por 4 segundos.  O projétil pode ferir aliados</color>.\n<style=cSub>[<style=cIsUtility>Recarga: 21s</style> | <style=cIsDamage>Raio: 5m</style> | Peso: 100]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Canhão Automático",
        "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Dispare até 4 projéteis que causam <style=cIsDamage>2000% de dano</style> cada. O último projétil causa <style=cIsDamage>2x de dano</style> em um ponto fixo.\n<style=cSub>[<style=cIsUtility>Recarga: 14s</style> | <style=cIsDamage>Raio: 7m</style> | Peso: 35]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Arado",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Avance uma curta distância</style> por <color=#ffc080>50</color> de combustível. Pode repelir <style=cIsUtility>qualquer inimigo</style> causando <style=cIsDamage>1000% de dano</style> e restaurar <color=#ffc080>40</color> de combustível.\n<style=cSub>[<style=cIsUtility>Recarga: 2s</style> | Peso: 20]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Espinhos",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Avance uma grande distância</style> por <color=#ffc080>50</color> de combustível. Atropele inimigos causando <color=#AA2B2A>550% de dano de sangramento</color>.  <style=cIsUtility>Não tem tempo de recarga</style>.\n<style=cSub>[Peso: 15]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Turbo",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Dispare em alta velocidade</style> e consuma <color=#ffc080>30</color> de combustível por segundo.  Pode atropelar causando <style=cIsDamage>250% de dano</style>. Atropelar adiciona <color=#ffc080>20</color> de combustível.\n<style=cSub>[<style=cIsUtility>Recarga: 1s</style> | Peso: 10]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Super Pulo",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Lance-se para cima por <color=#ffc080>50</color> de combustível.  Ao correr, lance-se para frente por <color=#ffc080>75</color> de combustível e gire seu tanque descontroladamente causando <style=cIsDamage>2500% de dano</style>.  O peso do tanque aumenta o dano.",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Trator",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Impulsione</style> e consuma <color=#ffc080>20</color> de combustível por segundo.  Pode atropelar <style=cIsUtility>qualquer inimigo</style> causando <style=cIsDamage>200% de dano</style> constante.  Causa <style=cIsDamage>350% de dano</style> no impacto.\n<style=cSub>[<style=cIsUtility>Recarga: 1s</style> | Peso: 30]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Ripdozer",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Carregue para <style=cIsUtility>avançar a maior distância</style> por <color=#ffc080>100</color> de combustível.  <style=cIsUtility>Atrevessa multidões</style> causando <color=#AA2B2A>4000% de dano de sangramento</color> e <style=cIsUtility>prolonga o avanço</style>; vire para encerrar o avanço; <color=#80fc80>acerte uma manobra</color> para <style=cIsUtility>pular o carregamento</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 7s</style> | Peso: 25]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Escavador",
        "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Segure para escavar</style>, consumindo <color=#ffc080>20</color> de combustível por segundo, <style=cIsUtility>protegendo seu tanque enquanto estiver sob a terra</style>.  Solte para emergir e causar <style=cIsDamage>900% de dano</style> aos inimigos próximos.  Não pode atacar enquanto estiver sob a terra.\n<style=cSub>[<style=cIsDamage>Raio: 10m</style> | Peso: 40]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Mina Real",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Solte uma mina terrestre que causa <style=cIsDamage>3000% de dano</style>.  <style=cIsDamage>Itens de ativação aumentam o dano em vez disso</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 10s</style> | <style=cIsDamage>Raio: 10m</style> | Peso: 25]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Minas em Miniatura",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Mire e gaste todas as minas terrestres em miniatura que causam <style=cIsDamage>750% de dano</style> cada.  Itens de carga e de interagíveis aumentam o máximo de minas.  <color=#ffc080>Queime combustível</color> para <style=cIsUtility>ganhar cargas extras</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 3s</style> | <style=cIsDamage>Raio: 10m</style> | Peso: 10]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Lançamento de Barril",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Lance um barril por <color=#ffc080>25</color> de combustível que explode na colisão causando <style=cIsDamage>6500% de dano</style> e deixa uma <color=#E85E31>poça em chamas</color>.  <color=#80fc80>Acertar uma manobra</color> faz com que esta habilidade fique temporariamente <color=#fc8080>instável</color>, o que <style=cIsUtility>lança seu tanque descontroladamente</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 14s</style> | <style=cIsDamage>Raio: 18m</style> | <style=cIsDamage>Zona: 8</style> | Peso: 40]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Autodestruição",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Aniquile <color=#d40000>TUDO</color> em 35m causando <style=cIsDamage>100000% de dano</style>.  Comece com um <color=#80fc80>Dio's Best Friend</color> em uma nova partida.\n<style=cSub>[<style=cIsDamage>Raio: 35m</style> | Peso: 90]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "DOMÍNIO",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Desacelere e carregue para disparar uma barragem de mísseis.  O dano aumenta quanto mais longe viaja, até <style=cIsDamage>12x3000% de dano.</style>\n<style=cSub>[<style=cIsUtility>Recarga: 30s</style> | <style=cIsDamage>Raio: 10m</style> | Peso: 70]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Evasão",
        "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Emita fumaça, atordoando inimigos próximos causando <style=cIsDamage>150% de dano</style> e ocultando-se.  <style=cIsUtility>Torne-se imune</style> a dano por 1 segundo.\n<style=cSub>[<style=cIsUtility>Recarga: 12s</style> | <style=cIsDamage>Raio: 10m</style> | Peso: 5]</style>",
        "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Passiva: Frenesi",
        "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Remove esta habilidade. Aumenta a <style=cIsDamage>velocidade de ataque base em 0.5</style> e reduz o <style=cIsUtility>tempo de recarga em 10%</style>.",
        "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Passiva: Motores",
        "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Remove esta habilidade. Aumenta a <style=cIsUtility>velocidade base em 1m/s</style> e a <style=cIsUtility>potência de propulsão em 10%</style>.",
        "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Passiva: Armadura",
        "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Remove esta habilidade. Aumenta a <style=cIsUtility>armadura base em 30</style>.",
        "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Maestria",
        "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Como Celestial War Tank, vença o jogo ou oblitere-se no Monsoon.",
        "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Maestria",
        "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Canhão Celestial",
        "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Como Celestial War Tank, vá para casa",
        "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Canhão Celestial",
        "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Obliterador",
        "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Como Celestial War Tank, cause mais de 1,000,000 de dano em um único disparo.",
        "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Obliterador",
        "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Ripdozer",
        "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Como Celestial War Tank, vença o jogo ou oblitere-se no Monsoon.",
        "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Ripdozer",
        "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Blindado",
        "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Como Celestial War Tank, obtenha 10000 de Vida.",
        "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Blindado",
        "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "O tanque supremo da destruição. Resista a todos os tipos de inimigos, atropelando e esmagando-os com seu peso e armas colossais!\n\n<style=cSub>< ! > O tanque é enorme e extremamente lento, tornando você suscetível a qualquer forma de dano. Jogar de forma extremamente defensiva ou agressiva ajudará a mitigar a quantidade de dano que você receberá. Saiba que o tanque não possui cura.\n\n< ! > O chassi do tanque pode ser usado para causar dano — atropele seus inimigos ou use seu peso para esmagar todos eles!\n\n< ! > Quando o tanque capota, ele é mais pesado e demora um pouco para se levantar, ficando suscetível a mais dano de queda. O tanque não pode fazer manobras.\n\n< ! > Os fatores de cura são mitigados — o tanque tem vida demais!\n\n< ! > Pressione 'T' para buzinar.  Configurável nas opções do mod.\n\n</style>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Entidade Estrangeira",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Após mais pesquisas, descobrimos alguma origem para esses tanques — as mãos dos necrófagos. Construídos com peças de sucata de qualidade e itens da UES, eles criaram com sucesso esses tanques de guerra.\n\nNo entanto, isso leva a conclusões perigosas. Depois de obter uma das antenas inimigas, alertamos esse tanque de proporções colossais. Ele é do tamanho de guardas-besouro!\n\nÉ claro que, após uma longa batalha, finalmente o derrubamos. Esperamos realizar mais pesquisas e alterar sua mente, na esperança de obter respostas melhores. Será uma tarefa difícil, pois É tecnologia alienígena.\n\nUma observação gigantesca a se registrar é que, ao ser derrotado, ele invocou um portal de emergência. O maior e mais violento portal que já vimos. Por mais que isso possa nos levar direto a respostas, não acho que será um passeio no parque. Um tanque comum já é mortal demais, e não tenho certeza de quais outras invenções feitas pelos necrófagos existem por aí.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ORIGINAL",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "BRANCO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "PRETO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "VERMELHO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "VERMELHO ESCURO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "VERDE",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "AZUL",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "CIANO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "AMARELO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "AMARELO NEON",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "MAGENTA",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "ROXO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "LARANJA",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "MARROM",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "ESTADOS UNIDOS",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "ALEMANHA",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "REINO UNIDO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "RÚSSIA",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "FRANÇA",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "Isso muda a cor do chassi.  Não afeta a jogabilidade.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "PRINCIPAL",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "AMARELO SUJO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "VERDE",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "VERDE SUJO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "AZUL",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "AZUL SUJO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "VERMELHO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "VERMELHO SUJO",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "MAESTRIA",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Casco Rogue",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Potência do Motor: </color>3000\n<color=#00FFFF>Velocidade: </color>10\nTraverse Velocidade: 0.8\n\n<color=#00FF00>Vida: </color>1000\n<color=#FF0000>Armadura: </color>75\n\n<color=#AA00FF>Potência de Propulsão: </color>35\n<color=#ffc080>Quantidade de Combustível: </color>500\nPeso: 1000\n\nTipo de Casco: Tanque",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Casco Griffon",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Compatível com torreta</color>.\n\n<color=#FFFF00>Potência do Motor: </color>2300\n<color=#00FFFF>Velocidade: </color>11\nTraverse Velocidade: 1\n\n<color=#00FF00>Vida: </color>800\n<color=#FF0000>Armadura: </color>25\n\n<color=#AA00FF>Potência de Propulsão: </color>40\n<color=#ffc080>Quantidade de Combustível: </color>500\nPeso: 800\n\nTipo de Casco: Carro",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "Casco TONK",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Potência do Motor: </color>1200\n<color=#00FFFF>Velocidade: </color>12\nTraverse Velocidade: 2\n\n<color=#00FF00>Vida: </color>500\n<color=#FF0000>Armadura: </color>25\n\n<color=#AA00FF>Potência de Propulsão: </color>40\n<color=#ffc080>Quantidade de Combustível: </color>300\nPeso: 450\n\nTipo de Casco: Tanque",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Casco Type 5 Heavy",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Potência do Motor: </color>3500\n<color=#00FFFF>Velocidade: </color>8\nTraverse Velocidade: 0.6\n\n<color=#00FF00>Vida: </color>1400\n<color=#FF0000>Armadura: </color>100\n\n<color=#AA00FF>Potência de Propulsão: </color>34\n<color=#ffc080>Quantidade de Combustível: </color>750\nPeso: 1250\n\nTipo de Casco: Tanque",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Casco Bigfoot",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Fornece mais <style=cIsUtility>controle aéreo</style>.\n\n\n<color=#FFFF00>Potência do Motor: </color>2000\n<color=#00FFFF>Velocidade: </color>13\nTraverse Velocidade: 1.4\n\n<color=#00FF00>Vida: </color>600\n<color=#FF0000>Armadura: </color>20\n\n<color=#AA00FF>Potência de Propulsão: </color>40\n<color=#ffc080>Quantidade de Combustível: </color>450\nPeso: 750\n\nTipo de Casco: Carro",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "Casco AMX50B",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>A velocidade não é afetada pelo peso</style>.\n\n<color=#FFFF00>Potência do Motor: </color>700\n<color=#00FFFF>Velocidade: </color>9\nTraverse Velocidade: 0.7\n\n<color=#00FF00>Vida: </color>900\n<color=#FF0000>Armadura: </color>50\n\n<color=#AA00FF>Potência de Propulsão: </color>35\n<color=#ffc080>Quantidade de Combustível: </color>370\nPeso: 1100\n\nTipo de Casco: Tanque",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "Casco TOG II",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Potência do Motor: </color>3700\n<color=#00FFFF>Velocidade: </color>8\nTraverse Velocidade: 0.5\n\n<color=#00FF00>Vida: </color>1150\n<color=#FF0000>Armadura: </color>60\n\n<color=#AA00FF>Potência de Propulsão: </color>34\n<color=#ffc080>Quantidade de Combustível: </color>1000\nPeso: 1200\n\nTipo de Casco: Tanque",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Casco Pigeon",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Compatível com torreta</color>.\n\n<color=#FFFF00>Potência do Motor: </color>1500\n<color=#00FFFF>Velocidade: </color>7\nTraverse Velocidade: 1.4\n\n<color=#00FF00>Vida: </color>150\n<color=#FF0000>Armadura: </color>5\n\n<color=#AA00FF>Potência de Propulsão: </color>40\n<color=#ffc080>Quantidade de Combustível: </color>300\nPeso: 100\n\nTipo de Casco: Carro",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Casco Pontera AC",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Pode escalar paredes</style>. O pulo tem atraso de um segundo e o <color=#fc8080>dano de investida é reduzido em 50%</color>.\n\n\n<color=#FFFF00>Potência do Motor: </color>2750\n<color=#00FFFF>Velocidade: </color>9\nTraverse Velocidade: 0.8\n\n<color=#00FF00>Vida: </color>1300\n<color=#FF0000>Armadura: </color>90\n\n<color=#AA00FF>Potência de Propulsão: </color>31\n<color=#ffc080>Quantidade de Combustível: </color>550\nPeso: 1300\n\nTipo de Casco: Mecha",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "Casco TANKDOZER",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "O arado <style=cIsUtility>bloqueia</style> todo o <style=cIsDamage>dano recebido</style>.\n\nModo Caça-Tanques: <color=#fc8080>Não pode montar torreta</color>.\n\n<color=#FFFF00>Potência do Motor: </color>2500\n<color=#00FFFF>Velocidade: </color>8.5\nTraverse Velocidade: 0.9\n\n<color=#00FF00>Vida: </color>1250\n<color=#FF0000>Armadura: </color>80\n\n<color=#AA00FF>Potência de Propulsão: </color>34\n<color=#ffc080>Quantidade de Combustível: </color>500\nPeso: 1200\n\nTipo de Casco: Tanque",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Casco Truck Kan",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "O dano de investida é aumentado em <color=#80fc80>100.0%</color>\n\n<color=#80fc80>Compatível com torreta</color>.\n<style=cIsUtility>A velocidade não é afetada pelo peso</style>.\n\n<color=#FFFF00>Potência do Motor: </color>1000\n<color=#00FFFF>Velocidade: </color>12\nTraverse Velocidade: 0.9\n\n<color=#00FF00>Vida: </color>450\n<color=#FF0000>Armadura: </color>15\n\n<color=#AA00FF>Potência de Propulsão: </color>40\n<color=#ffc080>Quantidade de Combustível: </color>600\nPeso: 600\n\nTipo de Casco: Carro",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Vida: </color>250\n<color=#FF0000>Armadura: </color>25\n\nRotation Velocidade: 7.5\n\nPeso: 250\n",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Torreta",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Vida: </color>100\n<color=#FF0000>Armadura: </color>10\n\nRotation Velocidade: 20\n\nPeso: 50\n",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Vida: </color>100\n<color=#FF0000>Armadura: </color>15\n\nRotation Velocidade: 15\n\nPeso: 100\n",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Vida: </color>400\n<color=#FF0000>Armadura: </color>50\n\nRotation Velocidade: 5\n\nPeso: 500\n",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% de dano</style>?  Não consegui encontrar o código onde aumenta o dano para esta torreta específica.\n- Desenvolvedor\n\n\n<color=#00FF00>Vida: </color>150\n<color=#FF0000>Armadura: </color>25\n\nRotation Velocidade: 13\nLimite de Ângulo: 60\n\nPeso: 100\n",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Adiciona <style=cIsDamage>5 cargas</style> à habilidade <style=cIsUtility>secundária</style>.\n<style=cIsUtility>Restaura todas as cargas</style> após o tempo de recarga.\nO dano do canhão diminui em 80%\n\n<color=#00FF00>Vida: </color>300\n<color=#FF0000>Armadura: </color>20\n\nRotation Velocidade: 7\n\nPeso: 350\n",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Vida: </color>200\n<color=#FF0000>Armadura: </color>30\n\nRotation Velocidade: 9\n\nPeso: 200\n",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
        "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Vida: </color>300\n<color=#FF0000>Armadura: </color>35\n\nRotation Velocidade: 7\n\nPeso: 350\n",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Peso Pesado",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "O tanque pode <style=cIsUtility>atropelar inimigos</style>, com <style=cIsDamage>dano dependente da velocidade</style>.  Cair com uma configuração pesada faz com que seu peso crie uma <style=cIsUtility>onda de choque</style>, ferindo inimigos próximos.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Nenhum",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Remove esta habilidade.  Aumenta os seguintes atributos:\n\nVelocidade de Ataque: <color=#80fc80>+0.5</color>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Nenhum",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Nenhum",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Remove esta habilidade.  Aumenta os seguintes atributos:\n\nVelocidade: <color=#80fc80>+1</color> m/s\nPotência de Propulsão: <color=#80fc80>+10%</color>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Nenhum",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Remove esta habilidade.  Aumenta a armadura em <color=#80fc80>30</color> e aumenta a capacidade de combustível em <color=#80fc80>200</color>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Mini Canhão",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Dispare de forma imprecisa causando <style=cIsDamage>200% de dano.</style>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "PEM",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Incendeie seu escudo e crie um PEM causando <style=cIsDamage>2000% de dano</style>, que eletrocuta os inimigos!",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "Armazene um estoque massivo de até 22 mísseis! Cada um causando de <style=cIsDamage>1100% de dano</style> até <style=cIsDamage>1800% de dano</style>.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Canhão Automático Rápido",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Dispare projéteis explosivos nos inimigos causando <style=cIsDamage>500% de dano</style>. Deve recarregar a cada 4 segundos.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Canhão Poderoso",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Dispare causando <style=cIsDamage>7500% de dano</style>, repelindo inimigos.\n<style=cSub>[<style=cIsUtility>Recarga: 16s</style> | <style=cIsDamage>Raio: 12.5m</style>]</style>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Canhão de Artilharia",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Segure para mirar</style> e solte para disparar um projétil poderoso causando <style=cIsDamage>7000% de dano</style>.  O dano aumenta quanto mais longe viaja, até <style=cIsDamage>14000% de dano</style>.\n<style=cSub>[<style=cIsUtility>Recarga: 16s</style> | <style=cIsDamage>Raio: 12.5m</style>]</style>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Canhão Criogênico",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Dispare uma bola de neve gigante causando <color=#75EAFF>1500% de dano</color> e congele os inimigos.\n<style=cSub>[<style=cIsUtility>Recarga: 5s</style> | <style=cIsDamage>Raio: 10m</style>]</style>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Canhão Duplo",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Dispare causando <style=cIsDamage>5400% de dano</style>. Segure para disparar 2 projéteis, o que <color=#fc8080>aumenta o tempo de recarga da habilidade</color> depois. Disparar um tiro duplo <color=#80fc80>reduz muito</color> o próximo tempo de carregamento por 2 segundos.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "Canhão Britânico",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Dispare causando <style=cIsDamage>2400% de dano</style>.  <color=#fc8080>Não pode ativar itens</color>.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Canhão Gigante Malvado",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Dispare causando <style=cIsDamage>2000% de dano</style>.  <style=cIsUtility>Segure para carregar</style> e causar até <style=cIsDamage>11000% de dano</style>.  A carga máxima dispara o canhão automaticamente causando <style=cIsDamage>5500% de dano de laser</style> adicional com <style=cIsUtility>repulsão adicional</style>.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Experimental de Oppenheimer",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Deixe seu projétil destruir seu escudo e aniquile causando <color=#ff4d76>9000% de dano crítico</color>!",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Jatos",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Acione e consuma <color=#ffc080>70 de combustível</color> por segundo, permitindo que o tanque ganhe cada vez mais velocidade ao longo do tempo.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Ciclo de Energia",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Ative para alternar entre 3 modos — Evasão, Ataque ou Defesa: \n\n<style=cIsUtility>Evasão</style>: Reduz a velocidade de ataque em 50% e aumenta o tempo de recarga em 50% para ganhar 50% de velocidade extra, 10% de potência de propulsão e 50% de potência do motor!\n\n<color=#80fc80>Defesa</color>: Sacrifica 70% de velocidade e 100% de potência de propulsão por 500 de armadura.\n\n<style=cIsDamage>Ataque</style>: Todas as armas causam o dobro de dano. Reduz os tempos de recarga em 33% e aumenta a velocidade de ataque em 33%, mas perde TODA a armadura e cura. Ativar este modo eletrocuta seu tanque por 2 segundos.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Overclock",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Deixe sua velocidade destruir seu escudo e exploda violentamente seus propulsores causando <style=cIsDamage>6000% de dano</style>, lançando-se no ar e <style=cIsUtility>prevenindo dano de queda</style>!",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Escudos",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "Ative para se tornar <style=cIsUtility>imune a dano externo</style> por 4 segundos.  Pode ser sacrificado por uma <color=#03fcc2>Habilidade Poderosa</color> de uso único.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Explosicular",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Dispare 4 canhões, cada um causando <style=cIsDamage>1400% de dano</style> em um raio enorme. As armas <color=#fc8080>superaquecem</color> em vez de recarregar.\n<style=cSub>[<style=cIsDamage>Raio: 10m</style>]</style>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Padrão",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Experiência padrão.\n\nO tanque se move e gira com base na direção de movimento escolhida.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Alternativo",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Muda a forma como este tanque é jogado.\n\nO tanque se move com base na direção do casco, mas <color=#fc8080>não girará na direção do movimento</color>.  Isso é feito <style=cIsUtility>girando manualmente</style>.\n\nEnquanto voa, os controles voltam ao Padrão.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Modo de Energia: <style=cIsUtility>Evasão</style>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Reduz a velocidade de ataque em 50% e aumenta o tempo de recarga em 50% para ganhar 50% de velocidade extra, 10% de potência de propulsão e 50% de potência do motor.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Modo de Energia: <color=#80fc80>Defesa</color>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "Sacrifica 70% de velocidade e 100% de potência de propulsão por 500 de armadura.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Modo de Energia: <style=cIsDamage>Ataque</style>",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "Todas as armas causam o dobro de dano. Reduz os tempos de recarga em 33% e aumenta a velocidade de ataque em 33%, mas perde TODA a armadura e cura. Ativar este modo eletrocuta seu tanque por 2 segundos.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "E pensar que Dedee finalmente havia sido libertado, \r\nele foi mais uma vez capturado pela UES.",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "Sem Torreta",
        "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "Remove a torreta.  <style=cIsDamage>Aumenta todo o dano em 30%</style>"
    }
}