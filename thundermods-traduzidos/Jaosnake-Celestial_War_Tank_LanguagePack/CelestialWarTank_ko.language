    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "옐로우",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "네온 옐로우",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "마젠타",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "퍼플",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "오렌지",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "브라운",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "미국",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "독일",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "영국",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "러시아",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "프랑스",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "차체 색상을 변경합니다. 게임플레이에는 영향을 주지 않습니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "메인",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "더티 옐로우",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "그린",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "더티 그린",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "블루",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "더티 블루",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "레드",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "더티 레드",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "마스터리",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Rogue 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>엔진 출력: </color>3000\n<color=#00FFFF>속도: </color>10\nTraverse 속도: 0.8\n\n<color=#00FF00>체력: </color>1000\n<color=#FF0000>방어력: </color>75\n\n<color=#AA00FF>추진력: </color>35\n<color=#ffc080>연료량: </color>500\n무게: 1000\n\n차체 유형: 전차",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Griffon 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>포탑 호환 가능</color>.\n\n<color=#FFFF00>엔진 출력: </color>2300\n<color=#00FFFF>속도: </color>11\nTraverse 속도: 1\n\n<color=#00FF00>체력: </color>800\n<color=#FF0000>방어력: </color>25\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>500\n무게: 800\n\n차체 유형: 차량",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "TONK 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>엔진 출력: </color>1200\n<color=#00FFFF>속도: </color>12\nTraverse 속도: 2\n\n<color=#00FF00>체력: </color>500\n<color=#FF0000>방어력: </color>25\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>300\n무게: 450\n\n차체 유형: 전차",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Type 5 Heavy 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>엔진 출력: </color>3500\n<color=#00FFFF>속도: </color>8\nTraverse 속도: 0.6\n\n<color=#00FF00>체력: </color>1400\n<color=#FF0000>방어력: </color>100\n\n<color=#AA00FF>추진력: </color>34\n<color=#ffc080>연료량: </color>750\n무게: 1250\n\n차체 유형: 전차",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Bigfoot 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "더 높은 <style=cIsUtility>공중 제어력</style>을 제공합니다.\n\n\n<color=#FFFF00>엔진 출력: </color>2000\n<color=#00FFFF>속도: </color>13\nTraverse 속도: 1.4\n\n<color=#00FF00>체력: </color>600\n<color=#FF0000>방어력: </color>20\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>450\n무게: 750\n\n차체 유형: 차량",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "AMX50B 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>속도가 무게의 영향을 받지 않습니다</style>.\n\n<color=#FFFF00>엔진 출력: </color>700\n<color=#00FFFF>속도: </color>9\nTraverse 속도: 0.7\n\n<color=#00FF00>체력: </color>900\n<color=#FF0000>방어력: </color>50\n\n<color=#AA00FF>추진력: </color>35\n<color=#ffc080>연료량: </color>370\n무게: 1100\n\n차체 유형: 전차",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "TOG II 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>엔진 출력: </color>3700\n<color=#00FFFF>속도: </color>8\nTraverse 속도: 0.5\n\n<color=#00FF00>체력: </color>1150\n<color=#FF0000>방어력: </color>60\n\n<color=#AA00FF>추진력: </color>34\n<color=#ffc080>연료량: </color>1000\n무게: 1200\n\n차체 유형: 전차",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Pigeon 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>포탑 호환 가능</color>.\n\n<color=#FFFF00>엔진 출력: </color>1500\n<color=#00FFFF>속도: </color>7\nTraverse 속도: 1.4\n\n<color=#00FF00>체력: </color>150\n<color=#FF0000>방어력: </color>5\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>300\n무게: 100\n\n차체 유형: 차량",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Pontera AC 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>벽을 오를 수 있습니다</style>. 점프가 1초 지연되며, <color=#fc8080>충돌 피해가 50% 감소합니다</color>.\n\n\n<color=#FFFF00>엔진 출력: </color>2750\n<color=#00FFFF>속도: </color>9\nTraverse 속도: 0.8\n\n<color=#00FF00>체력: </color>1300\n<color=#FF0000>방어력: </color>90\n\n<color=#AA00FF>추진력: </color>31\n<color=#ffc080>연료량: </color>550\n무게: 1300\n\n차체 유형: 메카",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "TANKDOZER 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "삽날이 모든 <style=cIsDamage>받는 피해</style>를 <style=cIsUtility>차단</style>합니다.\n\n구축전차 모드: <color=#fc8080>포탑을 장착할 수 없습니다</color>.\n\n<color=#FFFF00>엔진 출력: </color>2500\n<color=#00FFFF>속도: </color>8.5\nTraverse 속도: 0.9\n\n<color=#00FF00>체력: </color>1250\n<color=#FF0000>방어력: </color>80\n\n<color=#AA00FF>추진력: </color>34\n<color=#ffc080>연료량: </color>500\n무게: 1200\n\n차체 유형: 전차",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Truck Kan 차체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "충돌 피해가 <color=#80fc80>100.0%</color> 증가합니다\n\n<color=#80fc80>포탑 호환 가능</color>.\n<style=cIsUtility>속도가 무게의 영향을 받지 않습니다</style>.\n\n<color=#FFFF00>엔진 출력: </color>1000\n<color=#00FFFF>속도: </color>12\nTraverse 속도: 0.9\n\n<color=#00FF00>체력: </color>450\n<color=#FF0000>방어력: </color>15\n\n<color=#AA00FF>추진력: </color>40\n<color=#ffc080>연료량: </color>600\n무게: 600\n\n차체 유형: 차량",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>체력: </color>250\n<color=#FF0000>방어력: </color>25\n\nRotation 속도: 7.5\n\n무게: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "포탑",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>체력: </color>100\n<color=#FF0000>방어력: </color>10\n\nRotation 속도: 20\n\n무게: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>체력: </color>100\n<color=#FF0000>방어력: </color>15\n\nRotation 속도: 15\n\n무게: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>체력: </color>400\n<color=#FF0000>방어력: </color>50\n\nRotation 속도: 5\n\n무게: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% 피해량</style>? 이 특정 포탑의 피해량을 증가시키는 코드를 찾을 수 없었습니다.\n- 개발자\n\n\n<color=#00FF00>체력: </color>150\n<color=#FF0000>방어력: </color>25\n\nRotation 속도: 13\n각도 제한: 60\n\n무게: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "<style=cIsUtility>보조</style> 스킬에 <style=cIsDamage>충전 5회</style>를 추가합니다.\n재사용 대기시간 후 <style=cIsUtility>모든 충전을 보충</style>합니다.\n대포 피해량이 80% 감소합니다\n\n<color=#00FF00>체력: </color>300\n<color=#FF0000>방어력: </color>20\n\nRotation 속도: 7\n\n무게: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>체력: </color>200\n<color=#FF0000>방어력: </color>30\n\nRotation 속도: 9\n\n무게: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>체력: </color>300\n<color=#FF0000>방어력: </color>35\n\nRotation 속도: 7\n\n무게: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "헤비급 중량",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "전차는 <style=cIsUtility>적을 치어버릴 수 있으며</style>, <style=cIsDamage>속도에 비례한 피해</style>를 입힙니다. 무거운 구성으로 낙하하면 무게로 인해 <style=cIsUtility>충격파</style>가 발생하여 주변의 적들에게 피해를 줍니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "없음",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "이 스킬을 제거합니다. 다음 능력치가 증가합니다:\n\n공격 속도: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "없음",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "없음",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "이 스킬을 제거합니다. 다음 능력치가 증가합니다:\n\n속도: <color=#80fc80>+1</color> m/s\n추진기 출력: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "없음",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "이 스킬을 제거합니다. 방어력이 <color=#80fc80>30</color> 증가하고 연료 용량이 <color=#80fc80>200</color> 증가합니다",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "미니 대포",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "부정확하게 발사하여 <style=cIsDamage>200% 피해</style>를 입힙니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "EMP",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "보호막을 점화하여 적을 감전시키는 <style=cIsDamage>2000% 피해</style>의 EMP를 생성합니다!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "최대 22발의 엄청난 미사일 비축량을 보유합니다! 미사일마다 <style=cIsDamage>1100% 피해</style>에서 최대 <style=cIsDamage>1800% 피해</style>를 입힙니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "속사 기관포",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "적에게 폭발성 포탄을 발사하여 <style=cIsDamage>500% 피해</style>를 입힙니다. 4초마다 재장전해야 합니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "강력한 대포",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "발사하여 <style=cIsDamage>7500% 피해</style>를 입히고 적을 밀쳐냅니다.\n<style=cSub>[<style=cIsUtility>재사용 대기시간: 16초</style> | <style=cIsDamage>폭발 반경: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "야포",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>길게 눌러 조준</style>하고, 떼면 강력한 포탄을 발사하여 <style=cIsDamage>7000% 피해</style>를 입힙니다. 멀리 날아갈수록 피해량이 증가하여 최대 <style=cIsDamage>14000% 피해</style>를 입힙니다.\n<style=cSub>[<style=cIsUtility>재사용 대기시간: 16초</style> | <style=cIsDamage>폭발 반경: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "냉기 대포",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "거대한 눈덩이를 발사하여 <color=#75EAFF>1500% 피해</color>를 입히고 적을 얼립니다.\n<style=cSub>[<style=cIsUtility>재사용 대기시간: 5초</style> | <style=cIsDamage>폭발 반경: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "이연장 대포",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "발사하여 <style=cIsDamage>5400% 피해</style>를 입힙니다. 길게 누르면 포탄 2발을 발사하지만, 이후 <color=#fc8080>스킬 재사용 대기시간이 증가합니다</color>. 2연발 사격 시 2초 동안 다음 충전 시간이 <color=#80fc80>대폭 감소합니다</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "영국식 대포",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "발사하여 <style=cIsDamage>2400% 피해</style>를 입힙니다. <color=#fc8080>아이템 효과를 발동시킬 수 없습니다</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "거대 흉포 대포",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "발사하여 <style=cIsDamage>2000% 피해</style>를 입힙니다. <style=cIsUtility>길게 눌러 충전</style>하면 최대 <style=cIsDamage>11000% 피해</style>를 입힙니다. 최대 충전 시 대포가 자동 발사되어 <style=cIsUtility>추가 넉백</style>과 함께 추가 <style=cIsDamage>5500% 레이저 피해</style>를 입힙니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Oppenheimer의 실험작",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "포탄으로 자신의 보호막을 파괴하고, <color=#ff4d76>9000% 치명타 피해</color>로 모든 것을 전멸시키세요!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "제트 추진기",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "점화하여 초당 <color=#ffc080>70의 연료</color>를 소모하며, 시간이 지날수록 전차가 점점 더 빠른 속도를 얻게 합니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "동력 순환",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "활성화하여 회피, 공격, 방어의 3가지 모드 간에 전환합니다:\n\n<style=cIsUtility>회피</style>: 공격 속도를 50% 감소시키고 재사용 대기시간을 50% 증가시키는 대신, 추가 속도 50%, 추진력 10%, 엔진 출력 50%를 얻습니다!\n\n<color=#80fc80>방어</color>: 속도 70%와 추진력 100%를 희생하여 방어력 500을 얻습니다.\n\n<style=cIsDamage>공격</style>: 모든 무기가 2배의 피해를 입힙니다. 재사용 대기시간이 33% 감소하고 공격 속도가 33% 증가하지만, 모든 방어력과 치유를 잃습니다. 이 모드를 활성화하면 2초 동안 전차가 감전됩니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "오버클럭",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "속도로 자신의 보호막을 파괴하고 추진기를 격렬하게 폭발시켜 <style=cIsDamage>6000% 피해</style>를 입히며 공중으로 솟구쳐 오르고, <style=cIsUtility>낙하 피해를 방지</style>합니다!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "보호막",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "활성화하면 4초 동안 <style=cIsUtility>외부 피해에 면역</style>이 됩니다. 보호막을 희생하여 일회성 <color=#03fcc2>강력한 능력</color>을 사용할 수 있습니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "사연장 폭격",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "거대한 반경에 각각 <style=cIsDamage>1400% 피해</style>를 입히는 대포 4문을 발사합니다. 무기가 재장전 대신 <color=#fc8080>과열</color>됩니다.\n<style=cSub>[<style=cIsDamage>폭발 반경: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "표준",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "기본 조작 방식입니다.\n\n선택한 이동 방향에 따라 전차가 이동하고 선회합니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "대체",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "전차의 조작 방식을 변경합니다.\n\n전차가 차체 방향을 기준으로 이동하지만, <color=#fc8080>이동 방향으로 자동 선회하지 않습니다</color>. 선회는 <style=cIsUtility>수동 선회</style>로 조작합니다.\n\n비행 중에는 조작이 표준으로 돌아갑니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "동력 모드: <style=cIsUtility>회피</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "공격 속도를 50% 감소시키고 재사용 대기시간을 50% 증가시키는 대신, 추가 속도 50%, 추진력 10%, 엔진 출력 50%를 얻습니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "동력 모드: <color=#80fc80>방어</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "속도 70%와 추진력 100%를 희생하여 방어력 500을 얻습니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "동력 모드: <style=cIsDamage>공격</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "모든 무기가 2배의 피해를 입힙니다. 재사용 대기시간이 33% 감소하고 공격 속도가 33% 증가하지만, 모든 방어력과 치유를 잃습니다. 이 모드를 활성화하면 2초 동안 전차가 감전됩니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "Dedee가 마침내 자유를 되찾았다고 생각했지만,\r\n또다시 UES에게 붙잡히고 말았습니다.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "무포탑",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "포탑을 제거합니다. <style=cIsDamage>모든 피해량이 30% 증가합니다</style>"
  }
}