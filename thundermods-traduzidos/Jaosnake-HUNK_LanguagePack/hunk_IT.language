    "ROB_HUNK_BODY_SHOOT_SSG_DESCRIPTION": "Spara per <style=cIsDamage>16x200% di danno</style>. <style=cIsUtility>50% bonus colpo alla testa.</style>",
    "ROB_HUNK_BODY_SHOOT_STREETSWEEPER_NAME": "Spara",
    "ROB_HUNK_BODY_SHOOT_STREETSWEEPER_DESCRIPTION": "Spara per <style=cIsDamage>14x24% di danno</style>. <style=cIsUtility>25% bonus colpo alla testa.</style>",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_NAME": "Spara",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_DESCRIPTION": "Spara per <style=cIsDamage>3000% di danno</style>. <style=cIsUtility>50% bonus colpo alla testa.</style>",
    "ROB_HUNK_BODY_SHOOT_SMG_NAME": "Spara",
    "ROB_HUNK_BODY_SHOOT_SMG_DESCRIPTION": "Spara per <style=cIsDamage>110% di danno</style>. <style=cIsUtility>25% bonus colpo alla testa.</style>",
    "ROB_HUNK_BODY_SHOOT_AR_NAME": "Spara",
    "ROB_HUNK_BODY_SHOOT_AR_DESCRIPTION": "Spara per <style=cIsDamage>385% di danno</style>. <style=cIsUtility>50% bonus colpo alla testa.</style>",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_NAME": "Spara",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Spara per <style=cIsDamage>2x250% di danno</style>. <style=cIsUtility>Il danno scala con la velocità d'attacco.</style>",
    "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Mira Salda",
    "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Prendi la mira, <style=cIsUtility>esponendo i punti deboli dei nemici</style>. <style=cIsDamage>Usare la primaria mentre miri fa fuoco con l'arma impugnata.</style>",
    "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Passo Rapido",
    "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Scatta</style> per una breve distanza. Se usato tempestivamente per <style=cIsUtility>evitare un attacco</style>, esegui una <style=cIsDamage>Schivata Perfetta</style>.",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Scatta</style> per una breve distanza. Se usato tempestivamente per <style=cIsUtility>evitare un attacco</style>, esegui una <style=cIsDamage>Schivata Perfetta</style>.\n<color=#d299ff>SCEPTER: Il potere di Uroboros scorre dentro di te.</color>",
    "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Parata",
    "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Blocca</style> un attacco, <style=cIsDamage>annullando</style> il danno e <style=cIsUtility>rimborsando il tempo di ricarica</style>. Se usato tempestivamente, esegui una <style=cIsDamage>Parata Perfetta</style>.",
    "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Spallata",
    "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Colpisci</style> i nemici vicini, <style=cIsUtility>stordendoli</style> per <style=cIsDamage>400% di danno</style>. Se usato tempestivamente per <style=cIsUtility>annullare un attacco</style>, esegui una <style=cIsDamage>Spallata Perfetta</style>.",
    "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Legione",
    "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Cambia</style> passando a un'altra <style=cIsDamage>arma da fuoco</style>. Premi brevemente per passare all'<style=cIsUtility>ultima arma impugnata</style>.",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Coltello da Combattimento",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "Un coltello militare standard. Torna sempre utile nei momenti critici.",
    "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "Coltello da Combattimento EX",
    "ROB_HUNK_BODY_KNIFE_INFINITE_DESCRIPTION": "Un coltello militare sottoposto a trattamento speciale e temprato a un livello incredibile. Dicono sia stato fatto per durare davvero a lungo.",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_NAME": "Lama Celata",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_DESCRIPTION": "Una lama retrattile discreta nascosta nella manica. Ideale per operazioni furtive.",
    "ROB_HUNK_BODY_KNIFE_WESKER_NAME": "Coltello Personalizzato",
