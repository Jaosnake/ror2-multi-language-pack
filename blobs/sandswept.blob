		public static T ElementAt<T>(this Stack<T> collection, int index)
		{
			index = collection.Count - index - 1;
			foreach (T item in collection)
			{
				if (index == 0)
				{
					return item;
				}
				index--;
			}
			throw new ArgumentOutOfRangeException("index");
		}
	}
