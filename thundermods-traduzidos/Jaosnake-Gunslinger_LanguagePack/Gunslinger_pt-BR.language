    "GUNSLINGER_GAMBLE_UNLOCKABLE_ACHIEVEMENT_DESC": "Como Gunslinger, tenha sucesso em um Shrine of Chance 7 vezes seguidas em uma única partida.",
    "GUNSLINGER_GAUNTLET_ITEM_NAME": "Manopla do Infinito",
    "GUNSLINGER_GAUNTLET_ITEM_DESC": "<style=cIsDamage>Elimina 50%</style> de <style=cIsHealth>todos</style> os seres vivos aleatoriamente. Recarrega a cada <style=cIsUtility>60s</style>.",
    "GUNSLINGER_GAUNTLET_ITEM_PICKUP": "Elimine metade de toda a vida aleatoriamente.",
    "GUNSLINGER_GAUNTLET_ITEM_LORE": "\"Eu sei o que é perder. Sentir tão desesperadamente que você está certo, e ainda assim falhar. É aterrorizante, faz as pernas virarem gelatina.\"",
    "GUNSLINGER_NAME": "Gunslinger",
    "GUNSLINGER_SUBTITLE": "Pacificador",
    "GUNSLINGER_PASSIVE_NAME": "Forma Espectral",
    "GUNSLINGER_PASSIVE_DESCRIPTION": "Gunslinger fica mais forte perto de entidades hostis.               <style=cKeywordName>Forma Espectral</style><style=cSub></style>",
    "GUNSLINGER_VENDETTA": "Vendetta",
    "GUNSLINGER_VENDETTA_DESCRIPTION": "Gunslinger dispara Vendetta causando 280% de dano por projétil, comporta até seis balas e recarrega após disparar a última. Cada sexta bala causa um acerto crítico com 25% de dano adicional.",
    "GUNSLINGER_UNLOAD": "Descarregar",
    "GUNSLINGER_UNLOAD_DESCRIPTION": "Dispare Vendetta causando 200% de dano. Para cada tiro acertado em um inimigo, o dano e a chance crítica de Descarregar aumentam, até um limite de +150% de dano e 40% de chance crítica. Errar disparos (o cenário celeste não conta) redefine os acúmulos de Descarregar.",
    "GUNSLINGER_ACCURSEDARM": "Braço Maldito",
    "GUNSLINGER_ACCURSEDARM_DESCRIPTION": "Gunslinger canaliza uma maldição poderosa que causa 400% de dano, perfurando inimigos em linha reta. Inimigos atingidos ficam enfraquecidos.",
    "GUNSLINGER_ORB": "Orbe Maldito",
    "GUNSLINGER_ORB_DESCRIPTION": "Gunslinger lança uma esfera de maldição poderosa que eletrocuta inimigos próximos causando 10% de dano e explode ao impacto em uma ampla área causando 320% de dano. Inimigos atingidos pela explosão ficam enfraquecidos.",
    "GUNSLINGER_WRAITHSTEP": "Passo Espectral",
    "GUNSLINGER_WRAITHSTEP_DESCRIPTION": "Gunslinger avança em disparada por uma curta distância. Armazena até cinco cargas.",
    "GUNSLINGER_WRAITHFRENZY": "Frenesi Espectral",
    "GUNSLINGER_WRAITHFRENZY_DESCRIPTION": "Gunslinger entra em estado de frenesi, recebendo 50% de velocidade de movimento e 20% de roubo de vida. Dura 3 segundos.",
    "GUNSLINGER_SOULPIERCER": "Perfurador de Almas",
    "GUNSLINGER_SOULPIERCER_DESCRIPTION": "Gunslinger dispara uma rajada de projéteis espectrais, causando 180% de dano por disparo. O número de projéteis aumenta com a velocidade de ataque. Perfura inimigos. Causa dano adicional com base na vida perdida do inimigo.",
    "GUNSLINGER_DEADEYE": "Tiro Certeiro",
    "GUNSLINGER_DEADEYE_DESCRIPTION": "Mire precisamente em um alvo. Dispare até 3 projéteis poderosos que explodem ao contato, causando 300% de dano em uma pequena área. Inimigos atingidos são desacelerados. <style=cKeywordName>Pairar</style><style=cSub></style>",
    "GUNSLINGER_DEADEYE_KEYWORD": "<style=cKeywordName>Pairar</style><style=cSub> Gunslinger paira no ar e fica imobilizado durante a duração. Enquanto estiver no ar, dispara 3 projéteis em rápida sucessão, causando 200% de dano cada.</style>",
    "GUNSLINGER_DEADEYE_PRIMARY": "Tiro Certeiro",
    "GUNSLINGER_DEADEYE_PRIMARY_DESCRIPTION": "Gunslinger paira no ar e mira precisamente em um alvo. Dispare até 3 projéteis poderosos que explodem ao contato, causando 300% de dano em uma pequena área. Inimigos atingidos são desacelerados.",
    "GUNSLINGER_DESCRIPTION": "O esqueleto mais rápido do oeste.<color=#CCD3E0></color>",
    "GUNSLINGER_OUTRO": "..e assim ele partiu, cantando Take Me Home.",
    "GUNSLINGER_FAIL": "..e assim ele desapareceu, nos confins do espaço.",
    "GUNSLINGER_RING_ITEM_LORE": "Como o último Anel Perverso restante, espero uma quantia substancial."
  }
