	public class FlawlessDesignUnlock : BaseAchievement
	{
		public static List<ItemDef> requiredScrap = new List<ItemDef>();

		public static List<GameEndingDef> acceptableEndings = new List<GameEndingDef>();

		public override void OnInstall()
		{
			((BaseAchievement)this).OnInstall();
			acceptableEndings.Add(GameEndings.MainEnding);
			acceptableEndings.Add(GameEndings.LimboEnding);
			acceptableEndings.Add(GameEndings.ObliterationEnding);
			acceptableEndings.Add(GameEndings.VoidEnding);
			acceptableEndings.Add(GameEndings.RebirthEndingDef);
			requiredScrap.Add(Items.ScrapWhite);
			requiredScrap.Add(Items.ScrapRed);
			requiredScrap.Add(Items.ScrapYellow);
			Run.onClientGameOverGlobal += OnClientGameOverGlobal;
		}

		public void OnClientGameOverGlobal(Run run, RunReport report)
		{
			if (ShouldGrant(report))
			{
				((BaseAchievement)this).Grant();
			}
		}

		public bool ShouldGrant(RunReport runReport)
		{
			CharacterBody cachedBody = ((BaseAchievement)this).localUser.cachedBody;
			if (acceptableEndings.Contains(runReport.gameEnding) && Object.op_Implicit((Object)(object)cachedBody))
			{
				Inventory inventory = cachedBody.inventory;
				if (Object.op_Implicit((Object)(object)inventory))
				{
					bool flag = true;
					foreach (ItemDef item in requiredScrap)
					{
						if (inventory.GetItemCount(item) <= 0)
						{
							flag = false;
						}
					}
					bool flag2 = inventory.GetItemCount(Items.ScrapGreen) > 0 || inventory.GetItemCount(Items.RegeneratingScrap) > 0;
					if (!flag2)
					{
					}
					return flag && flag2;
				}
			}
			return false;
		}

		public override void OnUninstall()
		{
			Run.onClientGameOverGlobal -= OnClientGameOverGlobal;
			((BaseAchievement)this).OnUninstall();
		}
	}
