    "CHEESEWITHHOLES_BASICTANK_TURRET_T62_DESCRIPTION": " <color=#80fc80>-20% 次要技能冷却时间</color>\n <color=#fc8080>-12% 攻击速度</color>\n <color=#fc8080>+8% 主要技能冷却时间</color>\n <color=#fc8080>+8% 辅助技能冷却时间</color>\n <color=#fc8080>+8% 特殊技能冷却时间</color>\n\n<color=#00FF00>生命值：</color>80\n<color=#FF0000>护甲：</color>11\n\nRotation 速度：38\n\n重量：91\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_NAME": "Somua S35",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_DESCRIPTION": " <color=#80fc80>+15 暴击率</color>\n <color=#fc8080>-5% 伤害</color>\n\n<color=#00FF00>生命值：</color>30\n<color=#FF0000>护甲：</color>8\n\nRotation 速度：45\n\n重量：33\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_NAME": "Churchill",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_DESCRIPTION": "每 <style=cIsUtility>5</style> 秒获得 <color=#fcdf03>+3 金币</color> <color=#7a7a7a>（每级 +2）</color>\n\n<color=#00FF00>生命值：</color>85\n<color=#FF0000>护甲：</color>12\n\nRotation 速度：34\n\n重量：97\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_NAME": "Maus",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_DESCRIPTION": "\n<color=#00FF00>生命值：</color>150\n<color=#FF0000>护甲：</color>30\n\nRotation 速度：30\n\n重量：180\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_NAME": "Tetrarch",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>生命值：</color>20\n<color=#FF0000>护甲：</color>7\n\nRotation 速度：50\n\n重量：27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% 攻击速度</color>\n <color=#fc8080>-15% 生命再生</color>\n <color=#fc8080>+5% 总冷却时间</color>\n\n<color=#00FF00>生命值：</color>20\n<color=#FF0000>护甲：</color>2\n\nRotation 速度：40\n\n重量：20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>生命值：</color>10\n<color=#FF0000>护甲：</color>0\n\nRotation 速度：55\n\n重量：5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>生命值：</color>100\n<color=#FF0000>护甲：</color>20\n\nRotation 速度：33\n\n重量：120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% 特殊技能冷却时间</color>\n <color=#fc8080>+15% 次要技能冷却时间</color>\n <color=#fc8080>-10% 攻击速度</color>\n\n<color=#00FF00>生命值：</color>120\n<color=#FF0000>护甲：</color>23\n\nRotation 速度：29\n\n重量：143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% 伤害</color>\n <color=#fc8080>+10% 总冷却时间</color>\n\n<color=#00FF00>生命值：</color>160\n<color=#FF0000>护甲：</color>0\n\nRotation 速度：25\n角度限制：90\n\n重量：160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>生命值：</color>45\n<color=#FF0000>护甲：</color>4\n\nRotation 速度：25\n\n重量：25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>生命值：</color>35\n<color=#FF0000>护甲：</color>15\n\nRotation 速度：35\n\n重量：50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% 主要技能冷却时间</color>\n <color=#fc8080>+8% 次要技能冷却时间</color>\n <color=#fc8080>+8% 辅助技能冷却时间</color>\n <color=#fc8080>+8% 特殊技能冷却时间</color>\n <color=#fc8080>-15% 攻击速度</color>\n\n<color=#00FF00>生命值：</color>35\n<color=#FF0000>护甲：</color>3\n\nRotation 速度：30\n\n重量：25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% 伤害</color>\n\n<color=#00FF00>生命值：</color>5\n<color=#FF0000>护甲：</color>1\n\nRotation 速度：40\n角度限制：30\n\n重量：6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "原版",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "红色",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "浅红",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "绿色",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "深绿",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "蓝色",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "青色",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "粉色",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "亮粉",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "品红",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "黄色",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "霓虹黄",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "霓虹紫",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "橙色",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "白色",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "黑色",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "将载具的“发光”部分更改为不同的颜色。不影响游戏玩法。",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "战损",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "崭新",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "锯齿迷彩",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "像素迷彩",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "纸质迷彩",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "菱形钢板",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "螺栓钢板",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "程序生成",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "多彩混合",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "渐变彩虹",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "单色",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "流体星系",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "星空",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "引擎系统",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "辅助技能和推进会消耗燃料。燃料恢复受<style=cIsUtility>攻击速度</style>影响；燃料容量受<style=cIsUtility>加力燃烧室</style>和<style=cIsUtility>跳跃类物品</style>影响。坦克可以<style=cIsUtility>向任意方向冲刺</style>。 推进器让你在空中拥有灵活的控制力。然而，<color=#fc8080>坦克无法正常跳跃</color>。",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "超级军械库",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "车体和炮塔的选择会影响生命值、护甲、速度、推进力和质量。<style=cIsUtility>更大的质量有助于推开更重的敌人</style>；否则更容易受到<color=#ffff80>击退</color>。\n\n护甲或速度有助于缓解坦克<color=#fc8080>极差的生命再生</color>。",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "天界不稳定性",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "坦克无法在空中自我保持平衡，<color=#ffff80>容易失去控制</color>。底朝天着陆会让你<color=#fc8080>在短时间内无法移动且脆弱不堪</color>。",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "飞行推进器",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "按住<style=cIsUtility>跳跃键</style>开始飞行。飞行方向取决于坦克的倾角。<style=cIsUtility>最灵活的飞行方式</style>，但可能较难掌握。",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "脉冲推进器",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "允许坦克像其他幸存者一样正常<style=cIsUtility>跳跃</style>。可在二段跳时激活坦克倾斜。每次跳跃消耗<color=#ffc080>25</color>燃料。",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "悬浮推进器",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "允许坦克悬浮在地面上方。按住<style=cIsUtility>跳跃键</style>上升；按住<style=cIsUtility>LeftAlt</style>下降。上升会消耗更多燃料。",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "机枪",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "持续射击，造成<style=cIsDamage>2x40%伤害</style>。\n<style=cSub>[重量：5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "霰弹枪",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "开火造成<style=cIsDamage>12x75%伤害</style>。<color=#ffc080>消耗燃料</color>以<style=cIsUtility>获得额外充能</style>；<color=#80fc80>成功完成特技着陆</color>可暂时获得强力射击，造成<style=cIsDamage>18x150%伤害</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：1秒</style> | 重量：9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "榴弹发射器",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "发射不精准的炮弹，造成<style=cIsDamage>4x250%伤害</style>。炮弹具有爆炸性且较为沉重。\n<style=cSub>[<style=cIsUtility>冷却时间：4秒</style> | <style=cIsDamage>爆炸半径：5m</style> | 重量：15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "导弹发射器",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "发射精准导弹，造成<style=cIsDamage>1000%伤害</style>。<style=cIsDamage>伤害随飞行距离增加</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：3秒</style> | <style=cIsDamage>爆炸半径：8m</style> | 重量：18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "火焰喷射器",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "<color=#ffc080>每秒消耗15燃料</color>喷射火焰，造成<color=#E85E31>25%燃烧伤害</color>。伤害随层数增加；<style=cIsUtility>攻击速度会增加射程</style>。\n<style=cSub>[<color=#ffc080>燃料驱动</color> | 重量：12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "超级天线",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>电击你自己</color>并<style=cIsUtility>触发击杀类物品</style>。<style=cIsUtility>触碰敌人也会电击他们</style>，且每件<style=cIsUtility>击杀触发</style>物品会对他们造成<style=cIsDamage>250%伤害</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：7秒</style> | <style=cIsDamage>爆炸半径：5m</style> | 重量：1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "暴击火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "开火造成<color=#ff4d76>1200%暴击伤害</color>。暴击率会提高火炮的伤害。\n<style=cSub>[<style=cIsUtility>冷却时间：7秒</style> | <style=cIsDamage>爆炸半径：10m</style> | 重量：50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "榴弹炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "蓄力发射，造成大范围溅射的<style=cIsDamage>7000%伤害</style>。<style=cIsUtility>若在空中开火可击飞坦克。</style>\n<style=cSub>[<style=cIsUtility>冷却时间：16秒</style> | <style=cIsDamage>爆炸半径：15m</style> | 重量：75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "重击火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "进行不精准的射击，造成<style=cIsDamage>1700%伤害</style>。<style=cIsDamage>伤害随飞行距离衰减</style>；<style=cIsDamage>触发类物品改为提高伤害</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：3秒</style> | <style=cIsDamage>爆炸半径：5m</style> | 重量：25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "穿甲火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "开火造成<style=cIsDamage>2500%伤害</style>。按住进行校准并造成<style=cIsDamage>3500%伤害</style>，能够<style=cIsUtility>命中弱点</style>。校准后，<color=#fc8080>移动会降低精准度</color>。\n<style=cSub>[<style=cIsUtility>冷却时间：5秒</style> | <style=cIsDamage>爆炸半径：2m</style> | 重量：45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "法兰西火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "开火造成微不足道的<style=cIsDamage>550%伤害</style>。不知为何，<style=cIsUtility>具有极高的触发系数</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：1秒</style> | 重量：10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "转管机枪",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "倾泻火力造成<style=cIsDamage>50%伤害</style>。达到75%过热时附带<color=#E85E31>点燃</color>；<color=#fc8080>完全过热会锁死枪管</color>。<style=cIsUtility>冷却缩减物品会提高冷却速率</style>；<style=cIsUtility>备用弹匣可延缓过热</style>。\n<style=cSub>[重量：45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "基础火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "发射高速炮弹，造成<style=cIsDamage>5400%伤害</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：12秒</style> | <style=cIsDamage>爆炸半径：7m</style> | 重量：65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "防空炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "开火造成<style=cIsDamage>300%伤害</style>。弹药在空中目标附近引爆，造成<style=cIsDamage>2.5x伤害</style>。<color=#fc8080>坦克在开火时会减速</color>。\n<style=cSub>[<style=cIsDamage>爆炸半径：5.5m</style> | 重量：40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "溅射火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "以<style=cIsUtility>高抛弧线</style>开火造成<style=cIsDamage>2200%伤害</style>，并向四周溅射<style=cIsDamage>10x5%总伤害</style>。飞行距离越远伤害越高，最高可达<style=cIsDamage>5500%伤害</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：10秒</style> | <style=cIsDamage>爆炸半径：16m</style> | 重量：55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "天界火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "消耗 <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> 燃料，造成 <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>伤害</color>。蓄力激光具有穿透效果；<color=#fc8080>燃料不足会使武器熄火。</color>\n<style=cSub>[<color=#ffc080>燃料驱动</color> | 重量：35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "湮灭火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "蓄力自动发射一枚<color=#E85E31>触发击杀效果的炮弹</color>，造成<style=cIsDamage>12000%伤害</style>。发射后，<color=#fc8080>所有技能禁用4秒。炮弹可能会伤害友军</color>。\n<style=cSub>[<style=cIsUtility>冷却时间：21秒</style> | <style=cIsDamage>爆炸半径：5m</style> | 重量：100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "机炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "发射最多4发炮弹，每发造成<style=cIsDamage>2000%伤害</style>。最后一发炮弹在固定位置造成<style=cIsDamage>2x伤害</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：14秒</style> | <style=cIsDamage>爆炸半径：7m</style> | 重量：35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "铲刀",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "消耗<color=#ffc080>50</color>燃料<style=cIsUtility>向前冲刺一小段距离</style>。可以击退<style=cIsUtility>任何敌人</style>，造成<style=cIsDamage>1000%伤害</style>并恢复<color=#ffc080>40</color>燃料。\n<style=cSub>[<style=cIsUtility>冷却时间：2秒</style> | 重量：20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "尖刺",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "消耗<color=#ffc080>50</color>燃料<style=cIsUtility>冲刺一大段距离</style>。冲撞敌人造成<color=#AA2B2A>550%流血伤害</color>。<style=cIsUtility>无冷却时间</style>。\n<style=cSub>[重量：15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "涡轮增压",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>疾驰</style>并每秒消耗<color=#ffc080>30</color>燃料。可冲撞造成<style=cIsDamage>250%伤害</style>。冲撞命中会恢复<color=#ffc080>20</color>燃料。\n<style=cSub>[<style=cIsUtility>冷却时间：1秒</style> | 重量：10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "超级跳跃",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "消耗<color=#ffc080>50</color>燃料向上弹射。冲刺时改为消耗<color=#ffc080>75</color>燃料向前弹射，并让坦克翻滚乱舞造成<style=cIsDamage>2500%伤害</style>。坦克重量会提高伤害。",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "推土机",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>推进</style>并每秒消耗<color=#ffc080>20</color>燃料。可以推平<style=cIsUtility>任何敌人</style>，造成持续的<style=cIsDamage>200%伤害</style>。撞击时造成<style=cIsDamage>350%伤害</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：1秒</style> | 重量：30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "蓄力并消耗<color=#ffc080>100</color>燃料<style=cIsUtility>冲刺最远距离</style>。<style=cIsUtility>穿透敌群</style>造成<color=#AA2B2A>4000%流血伤害</color>并<style=cIsUtility>延长冲刺时间</style>；转向可提前结束冲刺；<color=#80fc80>完成特技着陆</color>可<style=cIsUtility>跳过蓄力</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：7秒</style> | 重量：25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "掘地机",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>按住钻入地下</style>，每秒消耗<color=#ffc080>20</color>燃料，<style=cIsUtility>在地下时保护你的坦克</style>。松开按键破土而出，对附近敌人造成<style=cIsDamage>900%伤害</style>。在地下时无法攻击。\n<style=cSub>[<style=cIsDamage>爆炸半径：10m</style> | 重量：40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "巨型地雷",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "投下一枚造成<style=cIsDamage>3000%伤害</style>的地雷。<style=cIsDamage>触发类物品改为提高伤害</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：10秒</style> | <style=cIsDamage>爆炸半径：10m</style> | 重量：25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "微型地雷",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "瞄准并投出所有微型地雷，每枚造成<style=cIsDamage>750%伤害</style>。充能类与交互触发类物品会增加最大地雷数。<color=#ffc080>消耗燃料</color>以<style=cIsUtility>获得额外充能</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：3秒</style> | <style=cIsDamage>爆炸半径：10m</style> | 重量：10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "炸药桶投射",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "消耗<color=#ffc080>25</color>燃料发射一个炸药桶，碰撞时引爆造成<style=cIsDamage>6500%伤害</style>，并留下一片<color=#E85E31>燃烧火池</color>。<color=#80fc80>完成特技着陆</color>会使该技能暂时变得<color=#fc8080>不稳定</color>，从而<style=cIsUtility>将你的坦克猛烈弹飞</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：14秒</style> | <style=cIsDamage>爆炸半径：18m</style> | <style=cIsDamage>区域半径：8</style> | 重量：40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "自毁",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "湮灭35m内的<color=#d40000>一切</color>，造成<style=cIsDamage>100000%伤害</style>。新局开始时自带一个<color=#80fc80>Dio's Best Friend</color>。\n<style=cSub>[<style=cIsDamage>爆炸半径：35m</style> | 重量：90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "主宰弹幕",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "减速并蓄力以发射导弹齐射。飞行距离越远伤害越高，最高可达<style=cIsDamage>12x3000%伤害。</style>\n<style=cSub>[<style=cIsUtility>冷却时间：30秒</style> | <style=cIsDamage>爆炸半径：10m</style> | 重量：70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "烟幕规避",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "释放烟雾，眩晕附近敌人造成<style=cIsDamage>150%伤害</style>并隐身。在1秒内<style=cIsUtility>免疫</style>所有伤害。\n<style=cSub>[<style=cIsUtility>冷却时间：12秒</style> | <style=cIsDamage>爆炸半径：10m</style> | 重量：5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "被动：狂暴",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "移除此技能。<style=cIsDamage>基础攻击速度提高0.5</style>，<style=cIsUtility>冷却时间缩短10%</style>。",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "被动：引擎",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "移除此技能。<style=cIsUtility>基础速度提高1m/s</style>，<style=cIsUtility>推进力提高10%</style>。",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "被动：护甲",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "移除此技能。<style=cIsUtility>基础护甲提高30</style>。",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank：精通",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "作为 Celestial War Tank，在 Monsoon 难度下通关游戏或抹消自己。",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank：精通",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank：天界火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "作为 Celestial War Tank，回家吧",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank：天界火炮",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank：湮灭者",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "作为 Celestial War Tank，单次射击造成超过 1,000,000 点伤害。",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank：湮灭者",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank：Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "作为 Celestial War Tank，在 Monsoon 难度下通关游戏或抹消自己。",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank：Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank：重装壁垒",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "作为 Celestial War Tank，达到 10000 点生命值。",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank：重装壁垒",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "终极毁灭战车。抵御各类敌人的进攻，用它那庞大无比的重量和武器将敌人尽数碾碎！\n\n<style=cSub>< ! > 这辆坦克体型巨大且极其缓慢，容易受到各种伤害。采取极端防守或极端激进的打法有助于减少受到的伤害。请注意该坦克没有基础生命恢复。\n\n< ! > 坦克的车体本身就是武器——直接碾过你的敌人，或者利用自身重量把他们统统压扁！\n\n< ! > 当坦克翻车时，由于重量更大，需要更长时间才能翻正，并会受到更多坠落伤害。该坦克无法做空中特技。\n\n< ! > 治疗效果会受到削减——因为坦克的生命值实在太高了！\n\n< ! > 按“T”键鸣笛。可在模组设置中配置。\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "外来实体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "经过进一步研究，我们发现了这些坦克的来源——拾荒者之手。他们利用优质废料零件和来自UES的物品，成功制造出了这些战争坦克。\n\n然而，这引出了危险的结论。在获取了一根敌方天线后，我们惊动了这台巨兽级别的坦克。它的体型足足有甲虫守卫那么大！\n\n当然，经过一场旷日持久的激战，我们终于将它击倒。我们希望进行更深入的研究并重塑它的心智，以期获得更好的答案。这将是一项艰巨的任务，因为它确实属于外星科技。\n\n有一个极其重要的发现需要注意：在它被击败时，它召唤了一个紧急传送门。那是我们见过的最大、最狂暴的传送门。尽管它可能直接带我们找到答案，但我认为那绝不会是一场轻松的郊游。一辆普通坦克就已经足够致命了，我真不敢确定外面还有多少由拾荒者制造的其他发明。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "原版",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "白色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "黑色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "红色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "深红",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "绿色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "蓝色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "青色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "黄色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "霓虹黄",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "品红",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "紫色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "橙色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "棕色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "美国",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "德国",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "英国",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "俄罗斯",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "法国",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "更改车体颜色。不影响游戏玩法。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "主色调",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "旧黄色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "绿色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "旧绿色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "蓝色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "旧蓝色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "红色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "旧红色",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "精通",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Rogue 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>引擎功率：</color>3000\n<color=#00FFFF>速度：</color>10\nTraverse 速度：0.8\n\n<color=#00FF00>生命值：</color>1000\n<color=#FF0000>护甲：</color>75\n\n<color=#AA00FF>推进力：</color>35\n<color=#ffc080>燃料量：</color>500\n重量：1000\n\n车体类型：坦克",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Griffon 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>兼容炮塔</color>。\n\n<color=#FFFF00>引擎功率：</color>2300\n<color=#00FFFF>速度：</color>11\nTraverse 速度：1\n\n<color=#00FF00>生命值：</color>800\n<color=#FF0000>护甲：</color>25\n\n<color=#AA00FF>推进力：</color>40\n<color=#ffc080>燃料量：</color>500\n重量：800\n\n车体类型：汽车",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "TONK 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>引擎功率：</color>1200\n<color=#00FFFF>速度：</color>12\nTraverse 速度：2\n\n<color=#00FF00>生命值：</color>500\n<color=#FF0000>护甲：</color>25\n\n<color=#AA00FF>推进力：</color>40\n<color=#ffc080>燃料量：</color>300\n重量：450\n\n车体类型：坦克",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Type 5 Heavy 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>引擎功率：</color>3500\n<color=#00FFFF>速度：</color>8\nTraverse 速度：0.6\n\n<color=#00FF00>生命值：</color>1400\n<color=#FF0000>护甲：</color>100\n\n<color=#AA00FF>推进力：</color>34\n<color=#ffc080>燃料量：</color>750\n重量：1250\n\n车体类型：坦克",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Bigfoot 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "提供更强的<style=cIsUtility>空中控制</style>。\n\n\n<color=#FFFF00>引擎功率：</color>2000\n<color=#00FFFF>速度：</color>13\nTraverse 速度：1.4\n\n<color=#00FF00>生命值：</color>600\n<color=#FF0000>护甲：</color>20\n\n<color=#AA00FF>推进力：</color>40\n<color=#ffc080>燃料量：</color>450\n重量：750\n\n车体类型：汽车",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "AMX50B 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>速度不受重量影响</style>。\n\n<color=#FFFF00>引擎功率：</color>700\n<color=#00FFFF>速度：</color>9\nTraverse 速度：0.7\n\n<color=#00FF00>生命值：</color>900\n<color=#FF0000>护甲：</color>50\n\n<color=#AA00FF>推进力：</color>35\n<color=#ffc080>燃料量：</color>370\n重量：1100\n\n车体类型：坦克",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "TOG II 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>引擎功率：</color>3700\n<color=#00FFFF>速度：</color>8\nTraverse 速度：0.5\n\n<color=#00FF00>生命值：</color>1150\n<color=#FF0000>护甲：</color>60\n\n<color=#AA00FF>推进力：</color>34\n<color=#ffc080>燃料量：</color>1000\n重量：1200\n\n车体类型：坦克",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Pigeon 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>兼容炮塔</color>。\n\n<color=#FFFF00>引擎功率：</color>1500\n<color=#00FFFF>速度：</color>7\nTraverse 速度：1.4\n\n<color=#00FF00>生命值：</color>150\n<color=#FF0000>护甲：</color>5\n\n<color=#AA00FF>推进力：</color>40\n<color=#ffc080>燃料量：</color>300\n重量：100\n\n车体类型：汽车",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Pontera AC 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>可以爬墙</style>。跳跃延迟1秒，且<color=#fc8080>冲撞伤害降低50%</color>。\n\n\n<color=#FFFF00>引擎功率：</color>2750\n<color=#00FFFF>速度：</color>9\nTraverse 速度：0.8\n\n<color=#00FF00>生命值：</color>1300\n<color=#FF0000>护甲：</color>90\n\n<color=#AA00FF>推进力：</color>31\n<color=#ffc080>燃料量：</color>550\n重量：1300\n\n车体类型：机甲",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "TANKDOZER 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "铲刀可<style=cIsUtility>格挡</style>所有<style=cIsDamage>受到的伤害</style>。\n\n坦歼模式：<color=#fc8080>无法安装炮塔</color>。\n\n<color=#FFFF00>引擎功率：</color>2500\n<color=#00FFFF>速度：</color>8.5\nTraverse 速度：0.9\n\n<color=#00FF00>生命值：</color>1250\n<color=#FF0000>护甲：</color>80\n\n<color=#AA00FF>推进力：</color>34\n<color=#ffc080>燃料量：</color>500\n重量：1200\n\n车体类型：坦克",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Truck Kan 车体",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "冲撞伤害提高 <color=#80fc80>100.0%</color>\n\n<color=#80fc80>兼容炮塔</color>。\n<style=cIsUtility>速度不受重量影响</style>。\n\n<color=#FFFF00>引擎功率：</color>1000\n<color=#00FFFF>速度：</color>12\nTraverse 速度：0.9\n\n<color=#00FF00>生命值：</color>450\n<color=#FF0000>护甲：</color>15\n\n<color=#AA00FF>推进力：</color>40\n<color=#ffc080>燃料量：</color>600\n重量：600\n\n车体类型：汽车",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>生命值：</color>250\n<color=#FF0000>护甲：</color>25\n\nRotation 速度：7.5\n\n重量：250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "炮塔",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>生命值：</color>100\n<color=#FF0000>护甲：</color>10\n\nRotation 速度：20\n\n重量：50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>生命值：</color>100\n<color=#FF0000>护甲：</color>15\n\nRotation 速度：15\n\n重量：100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>生命值：</color>400\n<color=#FF0000>护甲：</color>50\n\nRotation 速度：5\n\n重量：500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200%伤害</style>？我找不到为这个特定炮塔增加伤害的代码。\n- 开发者\n\n\n<color=#00FF00>生命值：</color>150\n<color=#FF0000>护甲：</color>25\n\nRotation 速度：13\n角度限制：60\n\n重量：100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "为<style=cIsUtility>次要</style>技能增加<style=cIsDamage>5次充能</style>。\n冷却结束后<style=cIsUtility>恢复所有充能</style>。\n火炮伤害降低80%\n\n<color=#00FF00>生命值：</color>300\n<color=#FF0000>护甲：</color>20\n\nRotation 速度：7\n\n重量：350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>生命值：</color>200\n<color=#FF0000>护甲：</color>30\n\nRotation 速度：9\n\n重量：200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>生命值：</color>300\n<color=#FF0000>护甲：</color>35\n\nRotation 速度：7\n\n重量：350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "超重吨位",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "坦克可以<style=cIsUtility>碾压敌人</style>，<style=cIsDamage>伤害取决于移动速度</style>。在重型配装下坠落时，你的重量会产生一道<style=cIsUtility>冲击波</style>，伤害附近的敌人。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "无",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "移除此技能。提高以下属性：\n\n攻击速度：<color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "无",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "无",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "移除此技能。提高以下属性：\n\n速度：<color=#80fc80>+1</color> m/s\n推进器功率：<color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "无",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "移除此技能。护甲提高 <color=#80fc80>30</color>，燃料容量提高 <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "迷你火炮",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "进行不精准的射击，造成<style=cIsDamage>200%伤害。</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "电磁脉冲",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "引燃你的护盾，释放造成<style=cIsDamage>2000%伤害</style>的电磁脉冲并电击敌人！",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "拥有多达22枚导弹的巨量储备！每枚造成<style=cIsDamage>1100%伤害</style>至<style=cIsDamage>1800%伤害</style>。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "速射机炮",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "向敌人发射高爆炮弹，造成<style=cIsDamage>500%伤害</style>。每4秒必须重新装填。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "强力火炮",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "开火造成<style=cIsDamage>7500%伤害</style>并击退敌人。\n<style=cSub>[<style=cIsUtility>冷却时间：16秒</style> | <style=cIsDamage>爆炸半径：12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "重型火炮",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>按住瞄准</style>，松开以发射强力炮弹，造成<style=cIsDamage>7000%伤害</style>。飞行距离越远伤害越高，最高可达<style=cIsDamage>14000%伤害</style>。\n<style=cSub>[<style=cIsUtility>冷却时间：16秒</style> | <style=cIsDamage>爆炸半径：12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "冰冻火炮",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "发射巨大雪球，造成<color=#75EAFF>1500%伤害</color>并冻结敌人。\n<style=cSub>[<style=cIsUtility>冷却时间：5秒</style> | <style=cIsDamage>爆炸半径：10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "双联火炮",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "开火造成<style=cIsDamage>5400%伤害</style>。按住可连射2发炮弹，但随后会<color=#fc8080>增加技能冷却时间</color>。发射双连射会在2秒内<color=#80fc80>大幅缩短</color>下一次蓄力时间。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "不列颠火炮",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "开火造成<style=cIsDamage>2400%伤害</style>。<color=#fc8080>无法触发物品效果</color>。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "凶恶巨炮",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "开火造成<style=cIsDamage>2000%伤害</style>。<style=cIsUtility>按住蓄力</style>最高可造成<style=cIsDamage>11000%伤害</style>。蓄满后会自动发射火炮，额外造成<style=cIsDamage>5500%激光伤害</style>与<style=cIsUtility>额外击退</style>。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Oppenheimer的实验品",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "让炮弹摧毁你的护盾，以<color=#ff4d76>9000%暴击伤害</color>湮灭一切！",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "喷气引擎",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "点火并每秒消耗<color=#ffc080>70燃料</color>，使坦克随时间推移获得越来越快的速度。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "动力循环",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "激活以在3种模式间切换——规避、进攻或防御：\n\n<style=cIsUtility>规避</style>：攻击速度降低50%，冷却时间增加50%，换取额外50%速度、10%推进力和50%引擎功率！\n\n<color=#80fc80>防御</color>：牺牲70%速度和100%推进力，换取500护甲。\n\n<style=cIsDamage>进攻</style>：所有武器造成双倍伤害。冷却时间缩短33%，攻击速度提高33%，但失去所有护甲与治疗。激活此模式会使坦克触电2秒。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "超频",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "让高速摧毁你的护盾，猛烈引爆推进器造成<style=cIsDamage>6000%伤害</style>并将自己抛向空中，同时<style=cIsUtility>免疫坠落伤害</style>！",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "护盾",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "激活后在4秒内<style=cIsUtility>免疫外部伤害</style>。可以牺牲护盾来释放一次性的<color=#03fcc2>强力技能</color>。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "四联轰击",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "发射4门火炮，每门在巨大半径内造成<style=cIsDamage>1400%伤害</style>。武器会<color=#fc8080>过热</color>而非装填。\n<style=cSub>[<style=cIsDamage>爆炸半径：10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "标准",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "原版体验。\n\n坦克根据你选择的行进方向移动和转向。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "替代",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "改变这辆坦克的操控方式。\n\n坦克根据车体朝向移动，但<color=#fc8080>不会自动转向行进方向</color>。需要通过<style=cIsUtility>手动转向</style>来控制。\n\n飞行时，控制方式会恢复为“标准”。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "动力模式：<style=cIsUtility>规避</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "攻击速度降低50%，冷却时间增加50%，换取额外50%速度、10%推进力和50%引擎功率。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "动力模式：<color=#80fc80>防御</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "牺牲70%速度和100%推进力，换取500护甲。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "动力模式：<style=cIsDamage>进攻</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "所有武器造成双倍伤害。冷却时间缩短33%，攻击速度提高33%，但失去所有护甲与治疗。激活此模式会使坦克触电2秒。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "本以为Dedee终于重获自由，\r\n它却再一次被UES捕获了。",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "无炮塔",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "移除炮塔。<style=cIsDamage>所有伤害提高30%</style>"
  }
}