    "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Pafu por <style=cIsDamage>2x250% da damagxo</style>. <style=cIsUtility>Damagxo skalas laux atakrapideco.</style>",
    "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Firma Celo",
    "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Celu, <style=cIsUtility>malkovrante malfortajn punktojn de malamikoj</style>. <style=cIsDamage>Uzi cxefan kapablon dum celado pafas vian tenatan pafilon.</style>",
    "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Rapidpasxo",
    "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Impetu</style> mallongan distancon. Se uzate antauxzorge por <style=cIsUtility>eviti atakon</style>, faru <style=cIsDamage>Perfektan Eviton</style>.",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Impetu</style> mallongan distancon. Se uzate antauxzorge por <style=cIsUtility>eviti atakon</style>, faru <style=cIsDamage>Perfektan Eviton</style>.\n<color=#d299ff>SCEPTER: La potenco de Uroboros fluas tra vi.</color>",
    "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Parado",
    "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Bloku</style> atakon, <style=cIsDamage>nuligante</style> damagxon kaj <style=cIsUtility>repagante la resxargtempon</style>. Se uzate antauxzorge, faru <style=cIsDamage>Perfektan Paradon</style>.",
    "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Sxultrobato",
    "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Frapu</style> proksimajn malamikojn, <style=cIsUtility>svenigante ilin</style> por <style=cIsDamage>400% da damagxo</style>. Se uzate antauxzorge por <style=cIsUtility>nuligi atakon</style>, faru <style=cIsDamage>Perfektan Sxultrobaton</style>.",
    "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Legio",
    "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Sxangxu</style> al alia <style=cIsDamage>pafilo</style>. Frapetu por sxangxi al via <style=cIsUtility>laste tenata pafilo</style>.",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Bataltrancxilo",
