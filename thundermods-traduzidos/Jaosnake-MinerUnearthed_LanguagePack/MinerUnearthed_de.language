        "MINER_UNLOCKABLE_ACHIEVEMENT_DESC": "Öffne eine legendäre Truhe.",
        "MINER_ALTUNLOCKABLE_ACHIEVEMENT_NAME": "Forged in Flames",
        "MINER_ALTUNLOCKABLE_UNLOCKABLE_NAME": "In Flammen geschmiedet",
        "MINER_ALTUNLOCKABLE_ACHIEVEMENT_DESC": "Besiege den einzigartigen Wächter der Abyssal Depths.",
        "MINER_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Grand Mastery",
        "MINER_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "Bergmann: Große Meisterschaft",
        "MINER_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "Schlage als Miner das Spiel oder vernichte Taifun oder Eclipse.\n<color=#8888>(Typhoon-Schwierigkeit erfordert Starstorm 2)</color>",
        "MINER_MONSOONUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Mastery",
        "MINER_MONSOONUNLOCKABLE_UNLOCKABLE_NAME": "Bergmann: Meisterschaft",
        "MINER_MONSOONUNLOCKABLE_ACHIEVEMENT_DESC": "Schlagen Sie als Miner das Spiel oder vernichten Sie Monsun.",
        "MINER_CRUSHUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Pillaged Gold",
        "MINER_CRUSHUNLOCKABLE_UNLOCKABLE_NAME": "Bergmann: Geplündertes Gold",
        "MINER_CRUSHUNLOCKABLE_ACHIEVEMENT_DESC": "Wende als Bergmann 12 Stapel Spaltung auf den einzigartigen Wächter der Gilded Coast an.",
        "MINER_CRACKUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Junkie",
        "MINER_CRACKUNLOCKABLE_UNLOCKABLE_NAME": "Bergmann: Junkie",
        "MINER_CRACKUNLOCKABLE_ACHIEVEMENT_DESC": "Erhalte als Bergmann 50 Stapel Adrenalin.",
        "MINER_CAVEINUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Compacted",
        "MINER_CAVEINUNLOCKABLE_UNLOCKABLE_NAME": "Bergmann: Verdichtet",
        "MINER_CAVEINUNLOCKABLE_ACHIEVEMENT_DESC": "Triff als Miner 20 Feinde mit einem Backblast.",
        "MINER_PUPLEUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: The Five Keys",
        "MINER_PUPLEUNLOCKABLE_UNLOCKABLE_NAME": "Bergmann: Die fünf Schlüssel",
        "MINER_PUPLEUNLOCKABLE_ACHIEVEMENT_DESC": "Entdecken Sie als Miner das Debugging-Geheimnis von G-N-O-M-E.",
        "MINER_TUNDRAUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Frozen",
        "MINER_TUNDRAUNLOCKABLE_UNLOCKABLE_NAME": "Bergmann: Gefroren",
        "MINER_TUNDRAUNLOCKABLE_ACHIEVEMENT_DESC": "Erreiche als Miner den Rallypoint Delta in weniger als 8 Minuten.",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Tempered",
        "MINER_BLACKSMITHUNLOCKABLE_UNLOCKABLE_NAME": "Bergmann: Gehärtet",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_DESC": "Finden Sie als Bergmann ein Schmiedewerkzeug auf dem Planeten.",
        "FATACRID_BODY_NAME": "Perro Grande",
        "FATACRID_BODY_SUBTITLE": "(Forma Gigante)",
        "DIGGERPLUGIN_DIRESEEKER_BODY_NAME": "Direseker",
        "DIGGERPLUGIN_DIRESEEKER_BODY_SUBTITLE": "Verfolgen und töten",
        "DIGGERPLUGIN_DIRESEEKER_BODY_LORE": "Legenden erzählen von einem monströsen Biest, das einst die unterirdischen Kasernen von Petrichor V.\n\n durchstreifte. Von den tapfersten Überlebenden und den gemeinsten Monstern gefürchtet, war das riesige Biest konkurrenzlos. Es trug blutrote Schuppen, die vom Höllenfeuer gemildert wurden. Es hatte brennend gelbe Augen, deren Glanz so intensiv war, dass selbst die größten Kreaturen abrupt stehen blieben. Es hatte einen glimmenden Atem, der heiß genug war, um Metall in einem Augenblick zu schmelzen.\n\nErst als es von einem Überlebenden angehalten wurde, der stark genug war, Providence selbst zu töten, glaubte man, dass das Biest endlich seinen Gegner gefunden hatte.\n\n<style=cIsHealth>Bis es erneut sein schreckliches Gesicht zeigte.</style>",
        "DIGGERPLUGIN_DIRESEEKER_BODY_OUTRO_FLAVOR": "..und so ging es los, auf der Suche nach neuer Beute.",
        "DIGGERPLUGIN_DIRESEEKER_BODY_DEFAULT_SKIN_NAME": "Standard"
    }
}