        "ROB_BELMONT_TREASURECHEST_CONTEXT": "Usar llave y abrir",
        "ROB_BELMONTKEYCOST": "Llave Maestra",
        "ROB_BELMONT_KEYFRAGMENT_NAME": "Fragmento de Llave",
        "ROB_BELMONT_KEYFRAGMENT_DESC": "Pieza fracturada de una llave. Recoge 3 para formar una llave completa.",
        "ROB_BELMONT_KEYFRAGMENT_PICKUP": "Pieza fracturada de una llave. Recoge 3 para formar una llave completa.",
        "ROB_BELMONT_KEYFRAGMENT_LORE": "",
        "ROB_BELMONT_KEY_NAME": "Llave Maestra",
        "ROB_BELMONT_KEY_DESC": "Se usa para abrir un <color=#FFFF00>Cofre del Tesoro</color>. Estos cofres contienen una <color=#FF0033>reliquia sagrada</color> y aparecen cada <style=cIsUtility>cuarta</style> etapa en una <style=cIsDamage>ubicación fija</style>.",
        "ROB_BELMONT_KEY_PICKUP": "Se usa para abrir un Cofre del Tesoro. Brilla al estar cerca.",
        "ROB_BELMONT_KEY_LORE": "",
        "ROB_BELMONT_MORNINGSTAR_NAME": "Estrella Matutina",
        "ROB_BELMONT_MORNINGSTAR_DESC": "Cada golpe de látigo desencadena una <style=cIsUtility>explosión secundaria</style> para <style=cIsDamage>600% de daño</style>.",
        "ROB_BELMONT_MORNINGSTAR_PICKUP": "El látigo que destruirá a todos los relacionados con la estirpe de la noche.",
        "ROB_BELMONT_MORNINGSTAR_LORE": "",
        "ROB_BELMONT_CRISSAEGRIM_NAME": "Crissaegrim",
        "ROB_BELMONT_CRISSAEGRIM_DESC": "Cada golpe de espada ataca <style=cIsUtility>3 veces adicionales</style> para <style=cIsDamage>300% de daño</style> cada uno.",
        "ROB_BELMONT_CRISSAEGRIM_PICKUP": "Innumerables hojas rebanan al enemigo.",
        "ROB_BELMONT_CRISSAEGRIM_LORE": "",
        "ROB_BELMONT_WINGEDBOOTS_NAME": "Botas de Pegaso",
        "ROB_BELMONT_WINGEDBOOTS_DESC": "Tras <style=cIsUtility>1</style> segundo de esprintar en el <style=cIsUtility>suelo</style>, obtén <style=cIsDamage>12 de velocidad de movimiento</style>. Golpear a un enemigo con <style=cIsDamage>Rush</style> hace que lo patees <style=cIsUtility>por el aire</style> y luego lo alejes, para <style=cIsDamage>4x200%</style> y <style=cIsDamage>300%</style> de daño.",
        "ROB_BELMONT_WINGEDBOOTS_PICKUP": "Botas que mejoran tu habilidad secundaria y te permiten correr como el viento.",
        "ROB_BELMONT_WINGEDBOOTS_LORE": "",
        "ROB_BELMONT_HOLYCROSS_NAME": "Bufanda del Salvador",
        "ROB_BELMONT_HOLYCROSS_DESC": "Cada <style=cIsUtility>3</style> minutos, reemplaza tu <style=cIsDamage>habilidad especial</style> con <color=#FF0033>Llama Sagrada</color>.",
        "ROB_BELMONT_HOLYCROSS_PICKUP": "Obtén acceso a un poderoso ataque definitivo.",
        "ROB_BELMONT_HOLYCROSS_LORE": "",
        "ROB_BELMONT_BROTHERSOUL_NAME": "Alma del Rey",
        "ROB_BELMONT_BROTHERSOUL_DESC": "Cada <style=cIsUtility>chasquido de látigo</style> genera un <style=cIsDamage>pilar de llama lunar</style>, cada <style=cIsUtility>golpe de espada</style> genera un <style=cIsDamage>fragmento lunar</style>, cada <style=cIsUtility>azotada de látigo</style> desata <style=cIsDamage>ondas de choque terrestres</style> y cada <style=cIsUtility>carrera rápida</style> genera <style=cIsHealing>20% de barrera</style>.",
        "ROB_BELMONT_BROTHERSOUL_PICKUP": "Empuña el poder del Rey de la Nada como propio.",
        "ROB_BELMONT_BROTHERSOUL_LORE": "",
