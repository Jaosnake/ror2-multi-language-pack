        "ACHIEVEMENT_ROB_HUNK_SURVIVALKIT_ACHIEVEMENT_ID_DESCRIPTION": "Como HUNK, fique sem munição no início.",
        "ACHIEVEMENT_ROB_HUNK_JUMPPACK_ACHIEVEMENT_ID_DESCRIPTION": "Como HUNK, seja vítima de um acidente de paraquedismo.",
        "ROB_NEMESIS_BODY_DESCRIPTION": "O Nemesis T-Type é uma arma biológica imparável construída para suportar qualquer quantidade de punição e neutralizar seus alvos com facilidade.<color=#CCD3E0>\n\n< ! > Carregue os saltos para alcançar distâncias maiores.\n\n< ! > Consumir inimigos deixa você vulnerável; encontre um lugar seguro antes de fazê-lo.\n\n< ! > A Biomassa aumenta seu dano quando está cheia.</color>",
        "ROB_NEMESIS_BODY_OUTRO_FLAVOR": "..e então ele partiu, tudo bem.",
        "ROB_NEMESIS_BODY_OUTRO_FAILURE": "..e então ele desapareceu, a unidade humana agora neutralizada.",
        "ROB_NEMESIS_BODY_CLASSIC_SKIN_NAME": "Clássico",
        "ROB_NEMESIS_BODY_VENOM_SKIN_NAME": "Simbionte",
        "ROB_NEMESIS_BODY_SUPER_SKIN_NAME": "<color=#FFFF00>Apoiador inicial</color>",
        "ROB_NEMESIS_BODY_MAHORAGA_SKIN_NAME": "Grande Raga O Opp Stoppa",
        "ROB_NEMESIS_BODY_MINOS_SKIN_NAME": "Rei dos Homens",
        "ROB_NEMESIS_BODY_PASSIVE2_NAME": "Armamento Biológico",
        "ROB_NEMESIS_BODY_PASSIVE2_DESCRIPTION": "O Nemesis T-Type pode <style=cIsHealth>mutar</style> consumindo <style=cIsDamage>pessoas de interesse</style>, ganhando <style=cIsDamage>habilidades novas e aprimoradas</style>.",
        "ROB_NEMESIS_BODY_PASSIVE22_NAME": "Aumento de massa muscular",
        "ROB_NEMESIS_BODY_PASSIVE22_DESCRIPTION": "<style=cIsUtility>Ataques corpo a corpo</style> causam <style=cIsDamage>20%</style> mais dano, <style=cIsHealth>MAS aliados podem sofrer dano</style>.",
        "ROB_NEMESIS_BODY_MELEE_NAME": "Agressão brutal",
        "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Dê um soco que causa <style=cIsDamage>350% de dano</style>. Use enquanto estiver <style=cIsUtility>parado</style> para pisar, causando <style=cIsDamage>800% de dano</style>. Use enquanto estiver <style=cIsUtility>correndo</style> para atingir com o ombro, causando <style=cIsDamage>600% de dano</style>.",
        "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Agarre um inimigo. Use a habilidade primária para consumi-lo e recuperar 10% da saúde máxima, ou carregue a secundária para arremessá-lo e causar até 2.400% de dano.",
        "ROB_NEMESIS_BODY_DASH_NAME": "Corrida de risco biológico",
        "ROB_NEMESIS_BODY_DASH_DESCRIPTION": "Use <style=cIsUtility>no ar</style> para avançar pelo ar <style=cIsDamage>uma vez</style>.",
        "ROB_NEMESIS_BODY_ULTIMATE_NAME": "Massa Crítica",
        "ROB_NEMESIS_BODY_ULTIMATE_DESCRIPTION": "Segure para consumir lentamente <style=cIsHealth>Biomassa</style>, restaurando até <style=cIsHealing>100% da saúde máxima</style>.",
        "ROB_NEMESIS_ITEM_EFFECT_TITLE": "Efeito bônus",
        "ROB_NEMESIS_ITEM_EFFECT_BANDOLIER": "Pacotes de munição restauram <style=cIsHealth>10% da biomassa</style>.",
        "ROB_NEMESIS_ITEM_EFFECT_ALIENHEAD": "Aumenta a <style=cIsHealth>Biomassa</style> obtida de <style=cIsDamage>consumindo</style> inimigos.",
        "ROB_NEMESIS_ITEM_EFFECT_BRAINSTALKS": "Enquanto ativo, <style=cIsHealth>Biomassa</style> é <style=cIsUtility>unlimited</style>.",
        "ROB_NEMESIS_ITEM_EFFECT_PURITY": "Aumenta <style=cIsHealth>Biomassa</style> ganha <style=cIsDamage> ao acertar</style>.",
        "ROB_ARTIFACT_PURSUER_DESC": "Os jogadores começam a corrida com um S.T.A.R.S. Distintivo.",
        "ROB_ARTIFACT_CONTAMINATION_DESC": "Cada jogador recebe um evento de vírus aleatório em cada fase.",
        "ROB_ARTIFACT_STRIKETEAM_DESC": "Os jogadores ocasionalmente receberão equipes de ataque para neutralizá-los.",
