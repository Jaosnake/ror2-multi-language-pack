    "HABIBI_CHRONO_SECONDARY_BOMB_NAME": "I.V.A.N. Chrono",
    "HABIBI_CHRONO_SECONDARY_BOMB_DESCRIPTION": "Fija una bomba de pulso a un enemigo. Tras 3 segundos, la bomba explota e inflige <style=cIsDamage>500% de daño</style>.",
    "HABIBI_CHRONO_UTILITY_CHRONOSPHERE_NAME": "Cronosfera",
