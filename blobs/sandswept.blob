		private float projectileDeletionRadius;

		private bool someThingThatIsSupposedToRunOnce = false;

		public void Start()
		{
			projectileDeletionRadius = GalvanicCellShield.grazeRadius + base.body.radius;
		}

		private void CleanBuffsServer()
		{
			if (NetworkServer.active)
			{
				if (base.body.HasBuff(BuffBase<ParryActivatedBuff>.instance.BuffDef))
				{
					base.body.RemoveBuff(BuffBase<ParryActivatedBuff>.instance.BuffDef);
				}
				if (base.body.HasBuff(BuffBase<ParryBuff>.instance.BuffDef))
				{
					base.body.RemoveBuff(BuffBase<ParryBuff>.instance.BuffDef);
				}
			}
		}

		private void FixedUpdate()
		{
			if (!activated)
			{
				return;
			}
			if (!someThingThatIsSupposedToRunOnce)
			{
				CleanBuffsServer();
				if (!base.body.HasBuff(BuffBase<ParryBuff>.instance.BuffDef))
				{
					base.body.AddBuff(BuffBase<ParryBuff>.instance.BuffDef);
				}
				someThingThatIsSupposedToRunOnce = true;
			}
			if (base.body.HasBuff(BuffBase<ParryBuff>.instance.BuffDef) || base.body.HasBuff(BuffBase<ParryActivatedBuff>.instance.BuffDef))
			{
				timer += Time.fixedDeltaTime;
				if (damageInfo != null && !hasFired)
				{
					DoAttack();
				}
			}
			if (timer >= GalvanicCellShield.activationTime)
			{
				Reset();
			}
		}

		private void Reset()
		{
			damageInfo = null;
			activated = false;
			hasFired = false;
			timer = 0f;
			someThingThatIsSupposedToRunOnce = false;
			CleanBuffsServer();
		}

