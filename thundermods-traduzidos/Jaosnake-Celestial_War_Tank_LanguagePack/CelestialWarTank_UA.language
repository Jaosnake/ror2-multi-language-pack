    "CHEESEWITHHOLES_BASICTANK_BODY_PROTOTYPE_DESCRIPTION": "<color=#FFFF00>Потужність двигуна: </color>800\n<color=#00FFFF>Швидкість: </color>11.75\nШвидкість повороту: 3.5\n\n<color=#00FF00>Здоров'я: </color>120\n<color=#FF0000>Броня: </color>0\n\n<color=#AA00FF>Сила тяги: </color>39.5\n<color=#ffc080>Запас палива: </color>100\nВага: 110\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_SCORPION_NAME": "Корпус Scorpion",
    "CHEESEWITHHOLES_BASICTANK_BODY_SCORPION_DESCRIPTION": "<color=#FFFF00>Потужність двигуна: </color>1200\n<color=#00FFFF>Швидкість: </color>8\nШвидкість повороту: 4\n\n<color=#00FF00>Здоров'я: </color>45\n<color=#FF0000>Броня: </color>2\n\n<color=#AA00FF>Сила тяги: </color>42\n<color=#ffc080>Запас палива: </color>110\nВага: 47\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BRUISER_NAME": "Bruiser",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BRUISER_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>75\n<color=#FF0000>Броня: </color>15\n\nШвидкість обертання: 40\n\nВага: 88\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TIGER_I_NAME": "Tiger I",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TIGER_I_DESCRIPTION": " <color=#80fc80>+7% до шкоди</color>\n <color=#fc8080>+10% до загальної перезарядки</color>\n <color=#fc8080>-7% до швидкості атаки</color>\n\n<color=#00FF00>Здоров'я: </color>90\n<color=#FF0000>Броня: </color>18\n\nШвидкість обертання: 35\n\nВага: 108\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CROMWELL_NAME": "Cromwell",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CROMWELL_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>50\n<color=#FF0000>Броня: </color>11\n\nШвидкість обертання: 50\n\nВага: 55\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T62_NAME": "T62",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T62_DESCRIPTION": " <color=#80fc80>-20% до перезарядки втор. навички</color>\n <color=#fc8080>-12% до швидкості атаки</color>\n <color=#fc8080>+8% до перезарядки осн. навички</color>\n <color=#fc8080>+8% до перезарядки допоміжної навички</color>\n <color=#fc8080>+8% до перезарядки особливої навички</color>\n\n<color=#00FF00>Здоров'я: </color>80\n<color=#FF0000>Броня: </color>11\n\nШвидкість обертання: 38\n\nВага: 91\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_NAME": "Somua S35",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SOMUA_S35_DESCRIPTION": " <color=#80fc80>+15 до шансу крит. удару</color>\n <color=#fc8080>-5% до шкоди</color>\n\n<color=#00FF00>Здоров'я: </color>30\n<color=#FF0000>Броня: </color>8\n\nШвидкість обертання: 45\n\nВага: 33\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_NAME": "Churchill",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_DESCRIPTION": "<color=#fcdf03>+3 монети</color> кожні <style=cIsUtility>5</style> сек. <color=#7a7a7a>(+2 за рівень)</color>\n\n<color=#00FF00>Здоров'я: </color>85\n<color=#FF0000>Броня: </color>12\n\nШвидкість обертання: 34\n\nВага: 97\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_NAME": "Maus",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>150\n<color=#FF0000>Броня: </color>30\n\nШвидкість обертання: 30\n\nВага: 180\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_NAME": "Tetrarch",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>20\n<color=#FF0000>Броня: </color>7\n\nШвидкість обертання: 50\n\nВага: 27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% до швидкості атаки</color>\n <color=#fc8080>-15% до регенерації здоров'я</color>\n <color=#fc8080>+5% до загальної перезарядки</color>\n\n<color=#00FF00>Здоров'я: </color>20\n<color=#FF0000>Броня: </color>2\n\nШвидкість обертання: 40\n\nВага: 20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>10\n<color=#FF0000>Броня: </color>0\n\nШвидкість обертання: 55\n\nВага: 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>100\n<color=#FF0000>Броня: </color>20\n\nШвидкість обертання: 33\n\nВага: 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% до перезарядки особливої навички</color>\n <color=#fc8080>+15% до перезарядки втор. навички</color>\n <color=#fc8080>-10% до швидкості атаки</color>\n\n<color=#00FF00>Здоров'я: </color>120\n<color=#FF0000>Броня: </color>23\n\nШвидкість обертання: 29\n\nВага: 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% до шкоди</color>\n <color=#fc8080>+10% до загальної перезарядки</color>\n\n<color=#00FF00>Здоров'я: </color>160\n<color=#FF0000>Броня: </color>0\n\nШвидкість обертання: 25\nОбмеження кута: 90\n\nВага: 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>45\n<color=#FF0000>Броня: </color>4\n\nШвидкість обертання: 25\n\nВага: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>35\n<color=#FF0000>Броня: </color>15\n\nШвидкість обертання: 35\n\nВага: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% до перезарядки осн. навички</color>\n <color=#fc8080>+8% до перезарядки втор. навички</color>\n <color=#fc8080>+8% до перезарядки допоміжної навички</color>\n <color=#fc8080>+8% до перезарядки особливої навички</color>\n <color=#fc8080>-15% до швидкості атаки</color>\n\n<color=#00FF00>Здоров'я: </color>35\n<color=#FF0000>Броня: </color>3\n\nШвидкість обертання: 30\n\nВага: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% до шкоди</color>\n\n<color=#00FF00>Здоров'я: </color>5\n<color=#FF0000>Броня: </color>1\n\nШвидкість обертання: 40\nОбмеження кута: 30\n\nВага: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ОРИГІНАЛ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "ЧЕРВОНИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "СВІТЛО-ЧЕРВОНИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "ЗЕЛЕНИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "ТЕМНО-ЗЕЛЕНИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "СИНІЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "БЛАКИТНИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "РОЖЕВИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "ЯСКРАВО-РОЖЕВИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "ПУРПУРОВИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "ЖОВТИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "НЕОНОВО-ЖОВТИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "НЕОНОВО-ФІОЛЕТОВИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "ПОМАРАНЧЕВИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "БІЛИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "ЧОРНИЙ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Змінює колір світних частин машини.  Не впливає на ігровий процес.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Брудний",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Чистий",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Ламаний_камуфляж",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Піксельний_камуфляж",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Паперовий_камуфляж",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Рифлена_сталь",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Клепана_плита",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Процедурний_набір",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Барвиста_суміш",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Райдужний_градієнт",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Монохром",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Рідка_галактика",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Космос",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Системи двигуна",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Допоміжні навички та тяга витрачають паливо. Відновлення палива залежить від <style=cIsUtility>швидкості атаки</style>; запас палива залежить від <style=cIsUtility>форсажних камер</style> та <style=cIsUtility>предметів для стрибків</style>. Танк може <style=cIsUtility>бігти в будь-якому напрямку</style>. Тяга дає гнучкий контроль у повітрі. Однак <color=#fc8080>танк не може нормально стрибати</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Суперарсенал",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "Вибір корпусу та башти впливає на здоров'я, броню, швидкість, тягу та масу. <style=cIsUtility>Більша маса допомагає штовхати важких ворогів</style>; інакше ви будете сильніше схильні до <color=#ffff80>відкидання</color>.\n\nБроня або швидкість допоможуть компенсувати <color=#fc8080>жахливу регенерацію здоров'я</color> танка.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Небесна нестабільність",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "Танк не може вирівнюватися в повітрі, <color=#ffff80>легко втрачаючи керування</color>. Приземлення на дах робить вас <color=#fc8080>знерухомленим і вразливим на короткий час</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Політні двигуни",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Утримуйте <style=cIsUtility>Стрибок</style> для польоту. Напрямок польоту залежить від нахилу танка. <style=cIsUtility>Найбільш універсальний політ</style>, але може бути складним у використанні.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Імпульсні двигуни",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Дозволяє танку нормально <style=cIsUtility>стрибати</style>, як іншим уцілілим. Нахил танка активується з 2-го стрибка. Кожен стрибок витрачає <color=#ffc080>25</color> од. палива.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Ширяючі двигуни",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Дозволяє танку ширяти над землею. Утримуйте <style=cIsUtility>Стрибок</style> для підйому; утримуйте <style=cIsUtility>Лівий Alt</style> для зниження. Підйом витрачає більше палива.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Кулемети",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Безперервно стріляйте, завдаючи <style=cIsDamage>2x40% шкоди</style>.\n<style=cSub>[Вага: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Дробовик",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Вистріліть на <style=cIsDamage>12x75% шкоди</style>.  <color=#ffc080>Спалюйте паливо</color>, щоб <style=cIsUtility>отримувати додаткові заряди</style>; <color=#80fc80>виконайте трюк</color>, щоб тимчасово отримати потужний постріл на <style=cIsDamage>18x150% шкоди</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 1с</style> | Вага: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Гранатомет",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Випускайте неточні снаряди, що завдають <style=cIsDamage>4x250% шкоди</style>.  Снаряди вибухові та важкі.\n<style=cSub>[<style=cIsUtility>Перезарядка: 4с</style> | <style=cIsDamage>Радіус вибуху: 5м</style> | Вага: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Ракетниця",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Випускайте точні ракети, що завдають <style=cIsDamage>1000% шкоди</style>. <style=cIsDamage>Шкода збільшується в міру польоту</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 3с</style> | <style=cIsDamage>Радіус вибуху: 8м</style> | Вага: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Вогнемет",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Вивергайте полум'я, завдаючи <color=#E85E31>25% шкоди від горіння</color> та витрачаючи <color=#ffc080>15 од. палива на секунду</color>.  Шкода зростає зі стаками; <style=cIsUtility>швидкість атаки збільшує дальність</style>.\n<style=cSub>[<color=#ffc080>Працює на паливі</color> | Вага: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ультраантена",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Вдарте себе струмом</color> та <style=cIsUtility>активуйте предмети, що спрацьовують при вбивстві</style>.  <style=cIsUtility>Дотик до ворогів також б'є їх струмом</style>, завдаючи <style=cIsDamage>250% шкоди</style> за кожен предмет з ефектом <style=cIsUtility>при вбивстві</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 7с</style> | <style=cIsDamage>Радіус вибуху: 5м</style> | Вага: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Критична гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Вистріліть, завдаючи <color=#ff4d76>1200% критичної шкоди</color>. Шанс критичного удару збільшує шкоду гармати.\n<style=cSub>[<style=cIsUtility>Перезарядка: 7с</style> | <style=cIsDamage>Радіус вибуху: 10м</style> | Вага: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Гаубиця",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Зарядіть постріл, що завдає потужних <style=cIsDamage>7000% шкоди по площі</style>. <style=cIsUtility>Може відкинути танк, якщо вистрілити в повітрі.</style>\n<style=cSub>[<style=cIsUtility>Перезарядка: 16с</style> | <style=cIsDamage>Радіус вибуху: 15м</style> | Вага: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Відбійна гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Неточний постріл на <style=cIsDamage>1700% шкоди</style>. <style=cIsDamage>Шкода зменшується з відстанню</style>; <style=cIsDamage>предмети зі спрацьовуванням натомість збільшують шкоду</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 3с</style> | <style=cIsDamage>Радіус вибуху: 5м</style> | Вага: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Пробивна гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Вистріліть на <style=cIsDamage>2500% шкоди</style>.  Утримуйте для калібрування, щоб завдати <style=cIsDamage>3500% шкоди</style> з можливістю <style=cIsUtility>вражати слабкі місця</style>.  Під час калібрування <color=#fc8080>рух погіршує влучність</color>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 5с</style> | <style=cIsDamage>Радіус вибуху: 2м</style> | Вага: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Французька гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Вистріліть на мізерні <style=cIsDamage>550% шкоди</style>. Чомусь має <style=cIsUtility>надто високий коефіцієнт спрацьовування</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 1с</style> | Вага: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Мініган",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Стріляйте чергами по <style=cIsDamage>50% шкоди</style>. При 75% перегріву підпалює <color=#E85E31>вогнем</color>; <color=#fc8080>перегрів блокує гармату</color>. <style=cIsUtility>Предмети на перезарядку пришвидшують охолодження</style>; <style=cIsUtility>Запасні магазини запобігають перегріву</style>.\n<style=cSub>[Вага: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Базова гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Випустіть швидкий снаряд, що завдає <style=cIsDamage>5400% шкоди</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 12с</style> | <style=cIsDamage>Радіус вибуху: 7м</style> | Вага: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Зенітна гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Вистріліть на <style=cIsDamage>300% шкоди</style>.  Снаряд детонує поруч із повітряними цілями, завдаючи <style=cIsDamage>2.5x шкоди</style>.  <color=#fc8080>Під час стрільби танк сповільнюється</color>.\n<style=cSub>[<style=cIsDamage>Радіус вибуху: 5.5м</style> | Вага: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Осколкова гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Вистріліть на <style=cIsDamage>2200% шкоди</style> по <style=cIsUtility>великій дузі</style>, розкидаючи осколки на <style=cIsDamage>10x5% загальної шкоди</style>.  Шкода зростає з відстанню аж до <style=cIsDamage>5500% шкоди</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 10с</style> | <style=cIsDamage>Радіус вибуху: 16м</style> | Вага: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Небесна гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Витрачає <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> од. палива, завдаючи <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>шкоди</color>.  Заряджені лазери пробивають наскрізь; <color=#fc8080>нестача палива виводить зброю з ладу.</color>\n<style=cSub>[<color=#ffc080>Працює на паливі</color> | Вага: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Гармата-Облітератор",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Зарядіть для автоматичного пострілу <color=#E85E31>снарядом, що активує ефекти вбивства</color>, на <style=cIsDamage>12000% шкоди</style>.  Після пострілу <color=#fc8080>здібності вимикаються на 4 секунди.  Снаряд може поранити союзників</color>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 21с</style> | <style=cIsDamage>Радіус вибуху: 5м</style> | Вага: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Автогармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Випустіть до 4 снарядів, кожен із яких завдає <style=cIsDamage>2000% шкоди</style>. Останній снаряд завдає <style=cIsDamage>2x шкоди</style> у фіксованій точці.\n<style=cSub>[<style=cIsUtility>Перезарядка: 14с</style> | <style=cIsDamage>Радіус вибуху: 7м</style> | Вага: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Відвал",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Ривок на невелику відстань</style> за <color=#ffc080>50</color> од. палива. Відкидає <style=cIsUtility>будь-якого ворога</style>, завдаючи <style=cIsDamage>1000% шкоди</style> та відновлюючи <color=#ffc080>40</color> од. палива.\n<style=cSub>[<style=cIsUtility>Перезарядка: 2с</style> | Вага: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Шипи",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Ривок на велику відстань</style> за <color=#ffc080>50</color> од. палива. Тараньте ворогів, завдаючи <color=#AA2B2A>550% шкоди від кровотечі</color>.  <style=cIsUtility>Не має перезарядки</style>.\n<style=cSub>[Вага: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Турбо",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Пришвидшіться</style>, витрачаючи <color=#ffc080>30</color> од. палива на секунду.  Таран завдає <style=cIsDamage>250% шкоди</style> та відновлює <color=#ffc080>20</color> од. палива.\n<style=cSub>[<style=cIsUtility>Перезарядка: 1с</style> | Вага: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Суперстрибок",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Підстрибніть угору за <color=#ffc080>50</color> од. палива.  Під час бігу натомість здійсніть ривок уперед за <color=#ffc080>75</color> од. палива, крутячи танком і завдаючи <style=cIsDamage>2500% шкоди</style>.  Вага танка збільшує шкоду.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Бульдозер",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Пришвидшіться</style>, витрачаючи <color=#ffc080>20</color> од. палива на секунду.  Дозволяє таранити <style=cIsUtility>будь-якого ворога</style>, завдаючи постійних <style=cIsDamage>200% шкоди</style>.  Завдає <style=cIsDamage>350% шкоди</style> при зіткненні.\n<style=cSub>[<style=cIsUtility>Перезарядка: 1с</style> | Вага: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Розривач",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Зарядіть для <style=cIsUtility>ривка на максимальну дистанцію</style> за <color=#ffc080>100</color> од. палива.  <style=cIsUtility>Проривайтеся крізь натовпи</style>, завдаючи <color=#AA2B2A>4000% шкоди від кровотечі</color> та <style=cIsUtility>подовжуючи ривок</style>; поверніть, щоб перервати ривок; <color=#80fc80>виконайте трюк</color>, щоб <style=cIsUtility>пропустити заряджання</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 7с</style> | Вага: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Траншеєкопач",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Утримуйте, щоб закопатися</style>, витрачаючи <color=#ffc080>20</color> од. палива на секунду та <style=cIsUtility>захищаючи танк під землею</style>.  Відпустіть, щоб випірнути й завдати <style=cIsDamage>900% шкоди</style> ворогам поблизу.  Під землею не можна атакувати.\n<style=cSub>[<style=cIsDamage>Радіус вибуху: 10м</style> | Вага: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Цар-міна",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Встановіть міну, що завдає <style=cIsDamage>3000% шкоди</style>.  <style=cIsDamage>Предмети зі спрацьовуванням натомість збільшують шкоду</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 10с</style> | <style=cIsDamage>Радіус вибуху: 10м</style> | Вага: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Міні-міни",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Прицільтеся та випустіть усі міні-міни, кожна з яких завдає <style=cIsDamage>750% шкоди</style>.  Предмети на заряди та інтерактивні об'єкти збільшують максимум мін.  <color=#ffc080>Спалюйте паливо</color>, щоб <style=cIsUtility>отримувати додаткові заряди</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 3с</style> | <style=cIsDamage>Радіус вибуху: 10м</style> | Вага: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Бочкомет",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Запустіть бочку за <color=#ffc080>25</color> од. палива, яка вибухає при зіткненні, завдаючи <style=cIsDamage>6500% шкоди</style>, і залишає <color=#E85E31>палаючу калюжу</color>.  <color=#80fc80>Виконання трюку</color> робить цю здібність тимчасово <color=#fc8080>нестабільною</color>, через що <style=cIsUtility>ваш танк жбурляє в повітря</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 14с</style> | <style=cIsDamage>Радіус вибуху: 18м</style> | <style=cIsDamage>Радіус зони: 8</style> | Вага: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Самознищення",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Анігілюйте <color=#d40000>ВСЕ</color> в радіусі 35м, завдаючи <style=cIsDamage>100000% шкоди</style>.  На початку нового забігу дає <color=#80fc80>Dio's Best Friend</color>.\n<style=cSub>[<style=cIsDamage>Радіус вибуху: 35м</style> | Вага: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "ПАНУВАННЯ",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Сповільніться та зарядіть залп ракет.  Шкода зростає з відстанню аж до <style=cIsDamage>12x3000% шкоди.</style>\n<style=cSub>[<style=cIsUtility>Перезарядка: 30с</style> | <style=cIsDamage>Радіус вибуху: 10м</style> | Вага: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Ухилення",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Випустіть димову завісу, приголомшуючи ворогів поблизу на <style=cIsDamage>150% шкоди</style> та ховаючись із поля зору.  <style=cIsUtility>Дає невразливість</style> до шкоди на 1 секунду.\n<style=cSub>[<style=cIsUtility>Перезарядка: 12с</style> | <style=cIsDamage>Радіус вибуху: 10м</style> | Вага: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Пасивно: Берсерк",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Прибирає цю навичку. Збільшує <style=cIsDamage>базову швидкість атаки на 0.5</style> і скорочує <style=cIsUtility>перезарядку на 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Пасивно: Двигуни",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Прибирає цю навичку. Збільшує <style=cIsUtility>базову швидкість на 1м/с</style> і <style=cIsUtility>силу тяги на 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Пасивно: Броня",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Прибирає цю навичку. Збільшує <style=cIsUtility>базову броню на 30</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Майстерність",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Граючи за Celestial War Tank, пройдіть гру або знищтеся на складності Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Майстерність",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Небесна гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Граючи за Celestial War Tank, поверніться додому",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Небесна гармата",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Облітератор",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Граючи за Celestial War Tank, завдайте понад 1 000 000 од. шкоди одним пострілом.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Облітератор",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Розривач",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Граючи за Celestial War Tank, пройдіть гру або знищтеся на складності Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Розривач",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Живучий",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Граючи за Celestial War Tank, отримайте 10000 ОЗ.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Живучий",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "Досконалий танк руйнування. Протистійте будь-яким ворогам, чавіть і трощіть їх своєю велетенською вагою та потужною зброєю!\n\n<style=cSub>< ! > Танк величезний і вкрай повільний, що робить вас вразливим до будь-якої шкоди. Грайте або гранично оборонно, або вкрай агресивно, щоб зменшити отримувану шкоду. Пам'ятайте, що танк не має лікування.\n\n< ! > Корпус танка можна використовувати для завдання шкоди — чавіть ворогів гусеницями або розплющуйте їх своєю вагою!\n\n< ! > При перекиданні важкому танку потрібен час, щоб перевернутися назад, і він отримує більше шкоди від падіння. Танк не може виконувати трюки.\n\n< ! > Ефекти зцілення послаблені — у танка занадто багато здоров'я!\n\n< ! > Натисніть 'T', щоб посигналити.  Налаштовується в параметрах мода.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Чужорідний об'єкт",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Під час подальших досліджень ми з'ясували походження цих танків — це справа рук сміттярів. Використовуючи якісний металобрухт і предмети з корабля UES, вони зуміли створити ці бойові машини.\n\nОднак це наштовхує на небезпечні висновки. Здобувши одну з ворожих антен, ми привернули увагу цього велетенського танка. Він завбільшки з жуків-охоронців!\n\nЗвісно, після затяжного бою ми все ж таки здолали його. Ми сподіваємося продовжити дослідження та перепрограмувати його розум, щоб отримати відповіді. Завдання не з легких, адже це ІНОПЛАНЕТНА технологія.\n\nОсобливо варто зазначити, що перед поразкою він відкрив аварійний портал. Найбільший і найбурхливіший портал з усіх, що ми бачили. І хоча він може привести нас просто до розгадки, легкої прогулянки чекати не варто. Навіть звичайний танк смертельно небезпечний, і страшно уявити, які ще винаходи сміттярів чатують на нас там.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ОРИГІНАЛ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "БІЛИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "ЧОРНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "ЧЕРВОНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "ТЕМНО-ЧЕРВОНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "ЗЕЛЕНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "СИНІЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "БЛАКИТНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "ЖОВТИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "НЕОНОВО-ЖОВТИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "ПУРПУРОВИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "ФІОЛЕТОВИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "ПОМАРАНЧЕВИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "КОРИЧНЕВИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "США",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "НІМЕЧЧИНА",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "ВЕЛИКА БРИТАНІЯ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "РОСІЯ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "ФРАНЦІЯ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "Змінює колір корпусу.  Не впливає на ігровий процес.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "ОСНОВНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "БРУДНО-ЖОВТИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "ЗЕЛЕНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "БРУДНО-ЗЕЛЕНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "СИНІЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "БРУДНО-СИНІЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "ЧЕРВОНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "БРУДНО-ЧЕРВОНИЙ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "МАЙСТЕРНІСТЬ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Корпус Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Потужність двигуна: </color>3000\n<color=#00FFFF>Швидкість: </color>10\nШвидкість повороту: 0.8\n\n<color=#00FF00>Здоров'я: </color>1000\n<color=#FF0000>Броня: </color>75\n\n<color=#AA00FF>Сила тяги: </color>35\n<color=#ffc080>Запас палива: </color>500\nВага: 1000\n\nТип корпусу: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Корпус Griffon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Сумісний з баштою</color>.\n\n<color=#FFFF00>Потужність двигуна: </color>2300\n<color=#00FFFF>Швидкість: </color>11\nШвидкість повороту: 1\n\n<color=#00FF00>Здоров'я: </color>800\n<color=#FF0000>Броня: </color>25\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас палива: </color>500\nВага: 800\n\nТип корпусу: Автомобіль",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "Корпус TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Потужність двигуна: </color>1200\n<color=#00FFFF>Швидкість: </color>12\nШвидкість повороту: 2\n\n<color=#00FF00>Здоров'я: </color>500\n<color=#FF0000>Броня: </color>25\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас палива: </color>300\nВага: 450\n\nТип корпусу: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Корпус Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Потужність двигуна: </color>3500\n<color=#00FFFF>Швидкість: </color>8\nШвидкість повороту: 0.6\n\n<color=#00FF00>Здоров'я: </color>1400\n<color=#FF0000>Броня: </color>100\n\n<color=#AA00FF>Сила тяги: </color>34\n<color=#ffc080>Запас палива: </color>750\nВага: 1250\n\nТип корпусу: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Корпус Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Забезпечує кращий <style=cIsUtility>контроль у повітрі</style>.\n\n\n<color=#FFFF00>Потужність двигуна: </color>2000\n<color=#00FFFF>Швидкість: </color>13\nШвидкість повороту: 1.4\n\n<color=#00FF00>Здоров'я: </color>600\n<color=#FF0000>Броня: </color>20\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас палива: </color>450\nВага: 750\n\nТип корпусу: Автомобіль",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "Корпус AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>Вага не впливає на швидкість</style>.\n\n<color=#FFFF00>Потужність двигуна: </color>700\n<color=#00FFFF>Швидкість: </color>9\nШвидкість повороту: 0.7\n\n<color=#00FF00>Здоров'я: </color>900\n<color=#FF0000>Броня: </color>50\n\n<color=#AA00FF>Сила тяги: </color>35\n<color=#ffc080>Запас палива: </color>370\nВага: 1100\n\nТип корпусу: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "Корпус TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Потужність двигуна: </color>3700\n<color=#00FFFF>Швидкість: </color>8\nШвидкість повороту: 0.5\n\n<color=#00FF00>Здоров'я: </color>1150\n<color=#FF0000>Броня: </color>60\n\n<color=#AA00FF>Сила тяги: </color>34\n<color=#ffc080>Запас палива: </color>1000\nВага: 1200\n\nТип корпусу: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Корпус Pigeon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Сумісний з баштою</color>.\n\n<color=#FFFF00>Потужність двигуна: </color>1500\n<color=#00FFFF>Швидкість: </color>7\nШвидкість повороту: 1.4\n\n<color=#00FF00>Здоров'я: </color>150\n<color=#FF0000>Броня: </color>5\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас палива: </color>300\nВага: 100\n\nТип корпусу: Автомобіль",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Корпус Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Може дертися по стінах</style>. Стрибок затримується на секунду, а <color=#fc8080>шкода від тарана зменшена на 50%</color>.\n\n\n<color=#FFFF00>Потужність двигуна: </color>2750\n<color=#00FFFF>Швидкість: </color>9\nШвидкість повороту: 0.8\n\n<color=#00FF00>Здоров'я: </color>1300\n<color=#FF0000>Броня: </color>90\n\n<color=#AA00FF>Сила тяги: </color>31\n<color=#ffc080>Запас палива: </color>550\nВага: 1300\n\nТип корпусу: Мех",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "Корпус TANKDOZER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "Відвал <style=cIsUtility>блокує</style> всю <style=cIsDamage>вхідну шкоду</style>.\n\nРежим ПТ-САУ: <color=#fc8080>Неможливо встановити башту</color>.\n\n<color=#FFFF00>Потужність двигуна: </color>2500\n<color=#00FFFF>Швидкість: </color>8.5\nШвидкість повороту: 0.9\n\n<color=#00FF00>Здоров'я: </color>1250\n<color=#FF0000>Броня: </color>80\n\n<color=#AA00FF>Сила тяги: </color>34\n<color=#ffc080>Запас палива: </color>500\nВага: 1200\n\nТип корпусу: Танк",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Корпус Truck Kan",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "Шкоду від тарана збільшено на <color=#80fc80>100.0%</color>\n\n<color=#80fc80>Сумісний з баштою</color>.\n<style=cIsUtility>Вага не впливає на швидкість</style>.\n\n<color=#FFFF00>Потужність двигуна: </color>1000\n<color=#00FFFF>Швидкість: </color>12\nШвидкість повороту: 0.9\n\n<color=#00FF00>Здоров'я: </color>450\n<color=#FF0000>Броня: </color>15\n\n<color=#AA00FF>Сила тяги: </color>40\n<color=#ffc080>Запас палива: </color>600\nВага: 600\n\nТип корпусу: Автомобіль",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>250\n<color=#FF0000>Броня: </color>25\n\nШвидкість обертання: 7.5\n\nВага: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Башта",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>100\n<color=#FF0000>Броня: </color>10\n\nШвидкість обертання: 20\n\nВага: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>100\n<color=#FF0000>Броня: </color>15\n\nШвидкість обертання: 15\n\nВага: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>400\n<color=#FF0000>Броня: </color>50\n\nШвидкість обертання: 5\n\nВага: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% шкоди</style>?  Я не зміг знайти в коді місце, де збільшується шкода для цієї конкретної башти.\n- Розробник\n\n\n<color=#00FF00>Здоров'я: </color>150\n<color=#FF0000>Броня: </color>25\n\nШвидкість обертання: 13\nОбмеження кута: 60\n\nВага: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Додає <style=cIsDamage>5 зарядів</style> <style=cIsUtility>вторинній</style> навичці.\n<style=cIsUtility>Відновлює всі заряди</style> після перезарядки.\nШкода гармати зменшується на 80%\n\n<color=#00FF00>Здоров'я: </color>300\n<color=#FF0000>Броня: </color>20\n\nШвидкість обертання: 7\n\nВага: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>200\n<color=#FF0000>Броня: </color>30\n\nШвидкість обертання: 9\n\nВага: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Здоров'я: </color>300\n<color=#FF0000>Броня: </color>35\n\nШвидкість обертання: 7\n\nВага: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Важка вага",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "Танк може <style=cIsUtility>чавити ворогів</style>, причому <style=cIsDamage>шкода залежить від швидкості</style>.  При падінні у важкій комплектації ваша вага створює <style=cIsUtility>ударну хвилю</style>, що завдає шкоди ворогам поблизу.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Немає",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Прибирає цю навичку.  Збільшує такі характеристики:\n\nШвидкість атаки: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Немає",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Немає",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Прибирає цю навичку.  Збільшує такі характеристики:\n\nШвидкість: <color=#80fc80>+1</color> м/с\nПотужність тяги: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Немає",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Прибирає цю навичку.  Збільшує броню на <color=#80fc80>30</color> та збільшує запас палива на <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Міні-гармата",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Неточна стрільба на <style=cIsDamage>200% шкоди.</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "ЕМІ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Запаліть свій щит і створіть ЕМІ на <style=cIsDamage>2000% шкоди</style>, що вражає ворогів струмом!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "Вміщує величезний запас до 22 ракет! Кожна завдає від <style=cIsDamage>1100% шкоди</style> до <style=cIsDamage>1800% шкоди</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Скорострільна автогармата",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Стріляйте по ворогах розривними снарядами, завдаючи <style=cIsDamage>500% шкоди</style>. Потрібна перезарядка кожні 4 секунди.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Могутня гармата",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Вистріліть на <style=cIsDamage>7500% шкоди</style>, відкидаючи ворогів.\n<style=cSub>[<style=cIsUtility>Перезарядка: 16с</style> | <style=cIsDamage>Радіус вибуху: 12.5м</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Артилерійська гармата",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Утримуйте для прицілювання</style> та відпустіть, щоб випустити потужний снаряд на <style=cIsDamage>7000% шкоди</style>.  Шкода зростає з відстанню аж до <style=cIsDamage>14000% шкоди</style>.\n<style=cSub>[<style=cIsUtility>Перезарядка: 16с</style> | <style=cIsDamage>Радіус вибуху: 12.5м</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Кріогармата",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Випустіть гігантську сніжку, що завдає <color=#75EAFF>1500% шкоди</color> та заморожує ворогів.\n<style=cSub>[<style=cIsUtility>Перезарядка: 5с</style> | <style=cIsDamage>Радіус вибуху: 10м</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Двоствольна гармата",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Вистріліть на <style=cIsDamage>5400% шкоди</style>. Утримуйте, щоб випустити 2 снаряди, що потім <color=#fc8080>збільшує час перезарядки навички</color>. Подвійний постріл <color=#80fc80>значно скорочує</color> час наступного заряджання протягом 2 секунд.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "Британська гармата",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Вистріліть на <style=cIsDamage>2400% шкоди</style>.  <color=#fc8080>Не активує ефекти предметів</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Велика грізна гармата",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Вистріліть на <style=cIsDamage>2000% шкоди</style>.  <style=cIsUtility>Утримуйте для заряджання</style>, щоб завдати до <style=cIsDamage>11000% шкоди</style>.  При максимальному заряді гармата автоматично вистрілює, завдаючи додатково <style=cIsDamage>5500% шкоди лазером</style> із <style=cIsUtility>додатковим відкиданням</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Експеримент Oppenheimer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Дозвольте снаряду зруйнувати ваш щит і анігілюйте ворогів, завдаючи <color=#ff4d76>9000% критичної шкоди</color>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Реактивні сопла",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Увімкніть запалювання, витрачаючи <color=#ffc080>70 од. палива</color> на секунду й дозволяючи танку з часом набирати все більшу швидкість.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Цикл живлення",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Активуйте для перемикання між 3 режимами — Ухилення, Атака або Захист: \n\n<style=cIsUtility>Ухилення</style>: зменшує швидкість атаки на 50% і збільшує перезарядку на 50% взамін на додаткові 50% швидкості, 10% сили тяги та 50% потужності двигуна!\n\n<color=#80fc80>Захист</color>: жертвує 70% швидкості та 100% сили тяги заради 500 од. броні.\n\n<style=cIsDamage>Атака</style>: уся зброя завдає подвійної шкоди. Скорочує перезарядку на 33% і збільшує швидкість атаки на 33%, але позбавляє ВСІЄЇ броні та зцілення. Активація цього режиму б'є танк струмом на 2 секунди.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Розгін",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Дозвольте швидкості зруйнувати ваш щит і викличте потужний вибух двигунів на <style=cIsDamage>6000% шкоди</style>, що підкидає вас у повітря та <style=cIsUtility>запобігає шкоді від падіння</style>!",
