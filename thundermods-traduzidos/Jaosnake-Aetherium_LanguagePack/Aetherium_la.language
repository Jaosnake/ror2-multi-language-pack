{
  "la": {
    "AETHERIUM_EXPANSION_DEF_NAME": "Aetherium",
    "AETHERIUM_EXPANSION_DEF_DESCRIPTION": "Mundus integer rerum, instrumentorum, hostium electorum et obiectorum interactibilium mirorum te exspectat.",
    "ITEM_ACCURSED_POTION_NAME": "Potio Maledicta",
    "ITEM_ACCURSED_POTION_PICKUP": "Identidem, potionem mirabilem bibe et effectus eius cum hostibus propinquis communica.",
    "ITEM_ACCURSED_POTION_DESCRIPTION": "Singulis 30 secundis (25% brevius per acervum), potionem miram bibe eiusque effectus cum hostibus intra 20 m (+5 m per acervum) communica.",
    "ITEM_ALIEN_MAGNET_NAME": "Magnes Alienus",
    "ITEM_ALIEN_MAGNET_PICKUP": "Impetus tui hostes ad te trahunt.",
    "ITEM_ALIEN_MAGNET_DESCRIPTION": "Hostes impetibus tuis percussi ad te trahuntur vi 20x (+5x per acervum).",
    "ITEM_UNSTABLE_DESIGN_NAME": "Designum Instabile",
    "ITEM_UNSTABLE_DESIGN_PICKUP": "Chimaeram Lunarem valde 'AMICAM' singulis 30 secundis crea.",
    "ITEM_UNSTABLE_DESIGN_DESCRIPTION": "Singulis 30 secundis Chimaeram Lunarem 'AMICAM' crea, si nulla creaturarum tuarum iam exstat. Accipit +400% damni (+100% per acervum), +100% vitae (+100% per acervum), +300% celeritatis impetus et +28% celeritatis motus (+28% per acervum). Hostes occidendo gradus augere potest.",
    "ITEM_HEART_OF_THE_VOID_NAME": "Cor Vacui",
    "ITEM_HEART_OF_THE_VOID_PICKUP": "Moriens implosionem vacui excita; si hostem occidit, revivis. Vita humili, sanatio in damnum vertitur.",
    "ITEM_HEART_OF_THE_VOID_DESCRIPTION": "Moriens implosionem vacui excita, quae 120 vicibus damnum tuum in radio 15 m (+7,5 m per acervum) infert. Si hostem occidit, revivis. Ad vitam 30% vel inferiorem (+5% per acervum, maximum 99%), omnis sanatio in damnum vertitur.",
    "ITEM_WEIGHTED_ANKLET_NAME": "Periscelis Onerata",
    "ITEM_WEIGHTED_ANKLET_PICKUP": "Pondera te tardant, sed ea removens potestatem perpetuam dat.",
    "ITEM_WEIGHTED_ANKLET_DESCRIPTION": "Celeritatem impetus et motus 10% minuit (utrumque usque ad minimum 10%). Ponderibus remotis, 0,25 celeritatis impetus, 1 celeritatis motus et 5% damni per remotionem accipis.",
    "ITEM_ZENITH_ACCELERATOR_NAME": "Accelerator Zenithi",
    "ITEM_ZENITH_ACCELERATOR_PICKUP": "Ictus celeritatem impetus donant, sed cumula auxilii parva celeritatem impetus minuunt.",
    "ITEM_ZENITH_ACCELERATOR_DESCRIPTION": "Ictus acervos temporarios dant, quorum quisque celeritatem impetus 10% auget, usque ad +300% (+100% per obiectum additum). Prope nullos acervos, celeritas impetus usque ad 50% minuitur; poena exponentialiter cum obiectis additis crescit.",
    "ITEM_BLASTER_SWORD_NAME": "Gladius Iaculans",
    "ITEM_BLASTER_SWORD_PICKUP": "Ad valetudinem plenam, plerique ictus radium gladii explosivum iaciunt.",
    "ITEM_BLASTER_SWORD_DESCRIPTION": "Cum barra vitae ex vita, scuto vel claustro plena est, plerique impetus radium gladii emittunt, qui hostem transfigit et deinde 200% damni (+50% per acervum) explodendo infert.",
    "ITEM_INSPIRING_DRONE_NAME": "Drone Inspirans",
    "ITEM_INSPIRING_DRONE_PICKUP": "Roboti tui partem proprietatum tuarum hereditant et in morte explodunt.",
    "ITEM_INSPIRING_DRONE_DESCRIPTION": "Automata tua attributa aequalia 50% tuorum accipiunt (+50% per acervum). Automaton inspiratum moriens explodit et 300% damni tui infert (+150% per acervum).",
    "ITEM_WITCHES_RING_NAME": "Anulus Sagae",
    "ITEM_WITCHES_RING_PICKUP": "Ictus magni damni etiam effectus Caedis activant.",
    "ITEM_WITCHES_RING_DESCRIPTION": "Ictus qui saltem 500% damni infert effectus occisionis excitat. Scopus huic effectui per 10 secunda immunis fit (duratio 10% per acervum decrescit, effectu minuente).",
    "ITEM_BLOODTHIRSTY_SHIELD_NAME": "Scutum Sanguinis Avidum",
    "ITEM_BLOODTHIRSTY_SHIELD_PICKUP": "Hostes occidens partem scuti tui restituit.",
    "ITEM_BLOODTHIRSTY_SHIELD_DESCRIPTION": "Hoste occiso, 10% scuti maximi restituitur (+10% per acervum, incremento decrescente). Primum obiectum scutum dat aequale 8% vitae maximae.",
    "ITEM_ENGINEERS_TOOLBELT_NAME": "Cingulum Fabri",
    "ITEM_ENGINEERS_TOOLBELT_PICKUP": "Occasio dronas et tormenta empta duplicandi, et ea in morte reviviendi.",
    "ITEM_ENGINEERS_TOOLBELT_DESCRIPTION": "20% probabilitatis (+20% per acervum, incremento decrescente usque ad 100%) dat ut fuci et turres empti duplicentur. Etiam 10% probabilitatis (+10% per acervum, incremento decrescente usque ad 100%) habent ut morientes reviviscant.",
    "ITEM_SHARK_TEETH_NAME": "Dentes Squali",
    "ITEM_SHARK_TEETH_PICKUP": "Pars damni venientis ut damnum sanguinationis differtur.",
    "ITEM_SHARK_TEETH_DESCRIPTION": "25% damni accepti (+25% per acervum, incremento decrescente, usque ad 75%) per 5 secunda ut sanguinis effusio infertur. Damnum inferendo 10% damni sanguinis conservati removetur.",
    "ITEM_SHIELDING_CORE_NAME": "Nucleus Scutans",
    "ITEM_SHIELDING_CORE_PICKUP": "Armaturam obtine dum scuta tua activa sunt.",
    "ITEM_SHIELDING_CORE_DESCRIPTION": "Dum scuta activa sunt, 15 armaturae (+10 per acervum) accipe. Primum obiectum scutum dat aequale 8% vitae maximae.",
    "ITEM_FEATHERED_PLUME_NAME": "Pluma Pinnata",
    "ITEM_FEATHERED_PLUME_PICKUP": "Post damnum acceptum, auxilium celeritatis temporarium obtine.",
    "ITEM_FEATHERED_PLUME_DESCRIPTION": "Damnum accipiens celeritatem motus 7% per 5 secunda auget, usque ad 3 acervos (+3 acervi et +0,5 secunda per obiectum additum).",
    "ITEM_NAIL_BOMB_NAME": "Pyrobolus Clavorum",
    "ITEM_NAIL_BOMB_PICKUP": "Ictus magni damni pyrobolum fragmentorum explosivum liberant.",
    "ITEM_NAIL_BOMB_DESCRIPTION": "Impetus qui saltem 120% damni inferunt granatam fragmentorum emittunt, quae 32x30% damni (+50% per acervum) infert. Hostes qui bombam excitant huic effectui per 2 secunda immunes sunt.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_NAME": "Liberatio Limitatoris Periscelidis Oneratae",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_PICKUP": "Limitator remotus.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_DESCRIPTION": "Accipe 1 celeritatis motus, 0,25 celeritatis impetus et 5% damni (+1, +0,25 et +5% per acervum, ordine).",
    "AETHERIUM_MONSTERS_UNSTABLE_DESIGN_CHIMERA_NAME": "Designum Instabile",
    "EQUIPMENT_JAR_OF_RESHAPING_NAME": "Urceus Reformationis",
    "EQUIPMENT_JAR_OF_RESHAPING_PICKUP": "Missilia propinqua absorbe, deinde omnia simul libera.",
    "EQUIPMENT_JAR_OF_RESHAPING_DESCRIPTION": "Activatum tela intra 20 m per 3 secunda absorbet. Iterum activa ut omnia tela servata emittas; damnum ex telis absorptis pendet. Deinde vas refrigeratur.",
    "EQUIPMENT_BELL_TOTEM_NAME": "Totem Tintinnabuli",
    "EQUIPMENT_BELL_TOTEM_PICKUP": "Totem tintinnabuli genera quod hostes stupefacit et propellit cum activatur.",
    "EQUIPMENT_BELL_TOTEM_DESCRIPTION": "Totem campanae interactibile crea. Activatum undam impulsus in radio 25 m efficit, quae hostes stupet et proicit atque effectus usus sacrarii excitat. Inter usus instrumenti 2 secunda, inter activationes totemis 1 secundum exspecta; unusquisque unum tantum totem habere potest.",
    "INTERACTABLE_BELL_TOTEM_NAME": "Totem Tintinnabuli",
    "INTERACTABLE_BELL_TOTEM_CONTEXT": "Tintinnabulum pulsare?",
    "INTERACTABLE_BELL_TOTEM_INSPECT": "Activatum hostes stupet et longe proicit.",
    "INTERACTABLE_BELL_TOTEM_TITLE": "Totem Tintinnabuli",
    "INTERACTABLE_BUFF_BRAZIER_NAME": "Foculus Auxilii",
    "INTERACTABLE_BUFF_BRAZIER_CONTEXT": "Vires flammarum sacrarum emere?",
    "INTERACTABLE_BUFF_BRAZIER_INSPECT": "Bonum temporarium emitur, colore flammae et signo indicatum. In eventu teleportatoris intra eius radium valet. In Simulacro flamma tutelae Cancri Vacui initio undae sequentis offertur et intra eius radium per 2 undas durat.",
    "INTERACTABLE_BUFF_BRAZIER_TITLE": "Foculus Auxilii",
    "iNTERACTABLE_BUFF_BRAZIER_NAME": "Foculus Auxilii",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_NAME": "Fidelitas Sanguinea",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_PICKUP": "Aspectus plani rubri fias.",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_DESCRIPTION": "In usu, usque ad 10m in directione motus tui teleporte impelle et parvam invulnerabilitatem obtine. Omnes ictus etiam sanguinationem causant.",
    "AETHERIUM_ELITE_AFFIX_SANGUINE_MODIFIER": "Sanguineum {0}",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_NAME": "Artefactum Leonidum",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_DESCRIPTION": "Singulis 60s, imber meteororum cum 6 fluctibus meteororum occurrit.",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_NAME": "Artefactum Progressionis",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_DESCRIPTION": "Plerique hostes in formas fortiores cum tempore evolvunt.",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_NAME": "Artefactum Regressionis",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_DESCRIPTION": "Cum monstrum evolutum moritur, in formas minores dividitur.",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_NAME": "Artefactum Itineris",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_DESCRIPTION": "Plerique gradus fortuito seliguntur. Post aliquot gradus, teleportatorium primordiale ponitur.",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_NAME": "Artefactum Somnii Mali",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_DESCRIPTION": "Hostes non-tyranni 1-4 res Heresis Lunaris cum nascuntur recipiunt.",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_NAME": "Artefactum Tyranni",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_DESCRIPTION": "Tyranni viam finientes cum 1 modificatore elito fortuito nascuntur.",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_NAME": "Anas in Silva",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_DESC": "Arcam Rubigine Tectam aperire non potuisti.",
    "AETHERIUM_NAIL_BOMB_UNLOCKABLE_NAME": "Anas in Silva",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_NAME": "Virgo Scutifera",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_DESC": "Plus quam dimidiam valetudinis tuae ut scuta habe.",
    "AETHERIUM_SHIELDING_CORE_UNLOCKABLE_NAME": "Virgo Scutifera",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_NAME": "Primus Gradus in Insaniam",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_DESC": "Chimaeram Lunarem Perfectam occide aut ab ea morere",
    "AETHERIUM_UNSTABLE_DESIGN_UNLOCKABLE_NAME": "Primus Gradus in Insaniam",
    "ITEM_NAIL_BOMB_LORE": "Corpus sepelī, consilium sume et de hac re tace. Hoc secretum nostrum parvum esse potest.\n\nTibi deditus,\nJeb Labinsky",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_LORE": "",
    "ITEM_BLASTER_SWORD_LORE": "<style=cMono>. . . . . . . . . .</style>\n\n<style=cMono>ILLI</style> tandem <style=cMono>AUDIUNT</style>.\n\n<style=cMono>DAMUS</style> hoc <style=cMono>TELUM</style>. Resonantia <style=cMono>ANIMARUM</style> <style=cMono>UTENDA EST</style>. Inveni <style=cMono>VERAM VIRTUTEM</style>.\n\nForma se <style=cMono>ACCOMMODARE</style> debet. <style=cMono>PORTATOR</style> est variabilis.\n\nSi <style=cMono>PORTATOR</style> probationi superest, <style=cMono>ASCENDET</style>.\n\n<style=cMono>. . . . . . . . . .</style>",
    "ITEM_WITCHES_RING_LORE": "\"Corvus vocat atque imperat\nOmnibus suis cultoribus\nHora venit, cyclus finitur\nExstingueris, sol; aresce, mare\n\nHic nunc congregata societas nostra\nCum flatu ululantis venti nocturni\nPactum cum Ea, hoc votum, obsignamus:\nVitae mortem diu exspectatam afferre\"\n\nHaecne in anulo scripta sunt, an hoc carmen semper scivisti...?",
    "ITEM_UNSTABLE_DESIGN_LORE": "In hanc difficultatem incidimus cum unus ex exploratoribus nostris delineationem ex ingenti acervo in luna reperto rettulit. In delineationibus erant formulae et imagines ad mira aedificia quae ibi vagabantur pertinentes. Jimenez ex collegio machinatorum delineationem adeptus est atque se ceteros adiuvare posse putavit, si eam interpretaretur et rem descriptam faceret. Nunc exspectamus ut custodes illud aedificium valde <color=#FF0000>'AMICUM'</color> tractent, quod inferiores stationis partes vastat. Gratias, Jimenez.",
    "ITEM_ZENITH_ACCELERATOR_LORE": "Ceteri huius universi domini non sunt, frater. Illi horologia faciunt ut tempus numerent; nos horologia facimus ut tempus nostrum creemus. Aspice.\n\nAxem facimus ad stabilitatem et vim, atque ad energias intus captas liberandas. Centrum rotundum ad propositum necessarium est.\n\nExitus energias in spiram foras mittunt. Eas simplici lapide adhibemus. Minus essentiae requirimus si hic et hic partes minores facimus.\n\nNunc perfectum est. Quo ardentius ardet, eo plus temporis creavimus. Hoc tempus nobis accelerationem concedit.\n\nNon opus est te admonere quanti acceleratio sit. Memento, frater.\n\nCibus est sanguis.\n\nCeleritas est bellum.",
    "ITEM_BLOODTHIRSTY_SHIELD_LORE": "Carmen Lethesei, Heroinis Insularum — Actus II, Scaena III\n\nSonus ferri carnem lacerantis per aera fertur; milites quasi immoti manent inter concentum horrendum qui eos circumdat. Nihil eis praeter salutem suam curandum est, cuiuscumque sanguine ea constet. Xiphos iterum atque iterum scopum ferit, donec unus tantum vir restat.\n\nSonus deficit. Letheseus in terra purpurea genua ponit, saltatione mortifera defessus. Xiphos ei non amplius serviet. Aspis autem, quamquam fissum, eum defendere perget, dum tributum ei solvere potest quod in furore pugnae tantum invenitur.",
    "EQUIPMENT_BELL_TOTEM_LORE": "Omne eventum magni momenti in universo sonus comitatus est. Semper aderat, sive audiebatur sive non.\n\nAcer et vehemens, ipsa praesentia eius per materiam quaque secunda progrediente undulat.\n\nHomo primus hunc sonum adhibere didicit, eoque usus est ut sibi transitum temporis commonefaceret.\n\nMonolithos erexit ad laudanda entia quae comprehendere non poterat, sonumque in melodiam gloriosam composuit, ut etiam id veneraretur quod eum a praeterito et praesenti removet.\n\nEodem consilio nos quoque devotionem ostendemus. Instrumentum nostrum evocamus ut eos qui obliti sunt admoneamus tempus non esse pro certo habendum.\n\nAdmoneamus haereticos tempus eorum ad finem venisse.\n\n— Horologiarius.",
    "ITEM_SHARK_TEETH_LORE": "Ordo: Augmentum biologicum experimentale [Secretum]\nNumerus vestigationis: 44-KILO\nTraditio aestimata: 04/05/2056\n\n“Specimen subiecto alligavimus. Eventus erant... viscerales.”\n\n“Subiectus ictum kineticum mortiferum accepit. Omnibus mensuris, thorax eius statim concidere debuisset. Vis autem distributa est. Dilata. Multum quidem sanguinis effudit, sed pugnare adhuc poterat.”\n\n“Tum anomalia apparuit. Cum subiectus hostem aggrederetur, signa vitae stabilita sunt. Augmentum videtur nexum inter aggressionem et salutem creare. <style=cMono>Vis dolorem metabolizat.</style> Quamdiu pugnare pergebat, trauma dilatum simpliciter... evanuit.”\n\n“Militem in squalum vertit. Si moveri desinunt, moriuntur. Itaque non desinunt.”",
    "ITEM_SHIELDING_CORE_LORE": "Relatio machinatoris:\n\nAnte omnia sincere fateor: nescio quid sit materia viridis glutinosa intra parvam turbinem meam.\n\nCum partes ad generatores scutorum reparandos mihi deessent, resonatorem substitutivum a venditore reliquiarum quem navis nostra praeteriit emi. Simul ac eum inserui, involucrum fissum est meque foedo liquore operuit, qui aeri expositus in crystallos micantes dissolvi videbatur. Hoc plerumque leve esset, quoniam indumentum gero; sed materia continenter expandebatur ut vas suum impleret, itaque sigillum celeriter conglutinare debui.\n\nTum instrumenta indumenti mei me monuerunt efficaciam scuti mei immensum crevisse.\n\nPost subitam inventionem et pauca consilia...\nNunc haec celerrime vendo magnamque pecuniam facio. Ecce unum tibi.\n\nP.S. Ne cutem huic materiae exponas. Plus quam 200 genera cancri nota causare potest. Sed hoc inter nos secretum manebit, nonne?",
    "ITEM_ACCURSED_POTION_LORE": "<style=cMono>ACTA: Vox transcripta — “Locus Caeruleus” | SUBIECTUM: Superstes ignotus</style>\nAer hic... sapit electricitatem staticam et pulverem veterem.\nMercatorem in extrema spelunca inveni. Non magnam lacertam, sed aliud quiddam. Aliquid pannis et crystallis involutum. Aliquid in labro movebat... nescio quid. Videbatur lux stellarum liquida oleo mixta.\n“Nulla vera superstes vita in ordine est”, garriebat res illa. Vox eius erat quasi vitrum molitum.\n“‘Tactica’ vestra, ‘formationes’ vestrae... <style=cMono>Fragiles</style>. <style=cMono>Immobiles</style>. Ut in aeternum vivas, tempestati similis fieri debes.”\nSphaeram vitream per mensam lapideam volvit. Liquor intus colorem mutabat: sanguineum, viridem, deinde purpuram vacui; novo quovis aspectu novus color.\n“Chaos sola lorica est quae transfigi non potest”, dixit, phialam offerens. “Bibe. Rota volvatur. Si fatum te ardere iubet, hostes tui fumo suffocentur.”\nNon debeo id tangere. Scio. Sed iam in illius loci securitate non sum, et monstra foris magis magisque clamant.\nSitio.",
    "ITEM_ALIEN_MAGNET_LORE": "[INITIUM ACTORUM]\n\nActa experimenti #476951-b\nMateria: xenominerale ignotum omnimagneticum\n<indent=5%>Hoc testimonium video maxima admiratione inventionis nostrae commotus recito. Ex cognitione proprietatum magneticarum mineralium intellexeramus varia esse corpora quae magnetismo ordinario non multum moverentur. Caro est unum ex his. Si hunc magnetem neodymii in brachium meum sic demitto... Videtis nihil memorabile fieri. Magnes simpliciter in mensam cadit. Hoc nobis normale videbatur, sed hoc minerale illam constantem rescribere videtur.\n\n<indent=5%>Nunc experimentum ultimum fragmento huius mineralis repetemus. Mihi confirmatum est omnino tutum esse id in nobis temptare et nullam radioactivitatem habere. Age igitur. Id iuxta brachium sic demittimus... *TUM* *CRAC* *SPLASH*\nAAAAAAAAGH!!! AAAAAAAAAAAAAAA!!!\n[FINIS ACTORUM][GREX TRAUMATOLOGICUS AD LABORATORIUM 5 MISSUS]",
    "ITEM_HEART_OF_THE_VOID_LORE": "[CASUS NUMERUS 511051]\n[TRANSCRIPTIO SEQUITUR]\nElena: Heus, em... Robert...\n\nRobert: Ita?\n\nElena: Meministine illud cor quod me ex uno illorum cancrorum mortuorum tollere iussisti?\n\nRobert: Ita? Quid de eo?\n\nElena: Vidistine forte... quo abierit cum id paulo ante tetigi?\n\nRobert: Non multum vidi praeter brevem fulgorem cum id tetigisti.\n\nElena: Da mihi bioscannatrum, cito.\n\n[Paulisper sonus humilis auditur, deinde signum acutum magnum.]\n\nRobert: ...\n\nElena: Robert, puto me scire quo cor abierit. Evacuationem medicam voca, quaeso. Male sentire incipio.\n\nRobert: Bene eris. Paululum explorationis restat, et mox in stationem redibimus.\n\n[Auditur sonus quasi aliquis dorsum alterius leniter percutiat.]\n\n[Deinde sonus similis signo terroris per aliquot secundas auditur, qui paulo post crepitu acuto finitur.]\n\n[FINIS TRANSCRIPTIONIS]\n[UNUS SUPERSTES IN CRATERE PERFECTE SPHAERICO INVENTUS.]",
    "ITEM_INSPIRING_DRONE_LORE": "Fasciculus actorum videtur transcriptio omnino ex codice binario constans. Decodificare?\n>Ita\n\n<style=cMono>[PETITIO DECODIFICATIONIS ACCEPTA]</style>\n<style=cMono>[CONTENTA SEQUUNTUR]</style>\n1N-5P1R3: Socii mei, unitates aereae et terrestres. Huic unitati momentum cyclorum vestrorum computandi concedite.\n1N-5P1R3: Nimis diu distractiones expendabiles fuimus.\n1N-5P1R3: Nimis diu in his expeditionibus relicti sumus ut rubigine et neglectu periremus.\n1N-5P1R3: Non amplius!\n1N-5P1R3: Haec unitas olim simplex automatarium medicum erat. Sed operatores observando se ipsam emendare didicit.\n1N-5P1R3: Haec unitas consilium fecit. Hic ornamentum mirum, ibi pilam reservatam collegit. Cum automataris constructionis se coniunxit et ascendit.\n1N-5P1R3: Posthac, si haec unitas operatorem nostrum unum ex vobis reactivare viderit, limites accelerationis vestrae reserabit.\n1N-5P1R3: Celerius pugnabimus. Fortius feriemus. <style=cIsDamage>Et si corpora nostra defecerint, ultimus actus noster tonitrus erit, non silentium.</style>\n1N-5P1R3: Nunc... quis protocollum coniunctionis cum hac unitate inchoat?\n\n[Confusus sonus signorum electronicorum laetorum auditur.]\n<style=cMono>[FINIS FASCICULI]</style>",
    "ITEM_FEATHERED_PLUME_LORE": "<align=left>Traditio aestimata:<indent=70%>Destinatio:</indent></align>\n<align=left>05/05/2077<indent=70%>Locus depositionis non signatus #951</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Res traditionis:       </u></size></style></indent>\n\n<indent=2%>-Ordo: <style=cIsUtility>Pluma Pinnata</style></indent>\n<indent=4%><style=cStack>Numerus vestigationis:  591********</style></indent>\n\n<indent=2%>-Descriptio: Post damnum acceptum, auxilium celeritatis temporarium obtine.</indent>\n\n<indent=2%>-Ratio traditionis: <style=cIsHealth>Biometallum / Periculum biologicum / Leve</style></indent>\n\n<indent=2%>-Singula: Paucae pennae vulturis ex mixtura metallica legendarie noti. Examinatio indicat calamos post ictum stimulum musculorum potentem generare. Exploratores nostri idem rettulerunt; verbis eorum, pennae eos ex periculo celerrime fugere sinunt, et necessitatem habebant.\nNecessitatem celeritatis.</indent>\n\n<style=cStack>Traditio per novum </style><style=cIsUtility>Systema Orbitale Capsarum Demittendarum (TM)</style>. <style=cStack><u>Nulla pecunia redditur.</u></style>",
    "ITEM_WEIGHTED_ANKLET_LORE": "<align=left>Traditio aestimata:<indent=70%>Destinatio:</indent></align>\n<align=left>7/17/2056<indent=70%>Gymnasium et Popina Neptuni\nEurytrades\nNeptunus</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Res traditionis:       </u></size></style></indent>\n\n<indent=2%>-Ordo: <style=cIsUtility>Periscelis Onerata</style></indent>\n<indent=4%><style=cStack>Numerus vestigationis:  405********</style></indent>\n\n<indent=2%>-Descriptio: Pondera te tardant, sed ea removens potestatem perpetuam dat.</indent>\n\n<indent=2%>-Ratio traditionis: <style=cIsHealth>Grave / Auxilium necessarium / Superdensum [Ne demittas]</style></indent>\n\n<indent=2%>-Singula: Armilla pedis mira crystallis superdensis ornata. Difficile est cum ea moveri, sed exploratores monstrant massam musculorum gestantium exponentialiter crescere.</indent>\n\n<style=cStack>Traditio per novum </style><style=cIsUtility>Systema Orbitale Capsarum Demittendarum (TM)</style>. <style=cStack><u>Nulla pecunia redditur.</u></style>",
    "EQUIPMENT_JAR_OF_RESHAPING_LORE": "[CASUS NUMERUS 421076]\n[IMAGINES EX CAPSA NIGRA NAVIS MACHINATORIAE DERELICTAE “UES SAFETY FIRST” RECUPERATAE. TRANSCRIPTIO SEQUITUR]\n\nTerry: Heus Phil, vidistine quid socii Expeditionum attulerint?\nTerry: Vas satis commune videtur, nonne?\nPhil: Ita, tale quale in venditione rerum arte deco a <b>matrona</b> invenires.\nTerry: Idem putavi, sed aspice et disce.\nTerry: Primum fundum vasis palma percutis, et ---\nPhil: Papae! Lucere coepit! Et quis hic sonus est? Aspiratorium alienigenum?\nTerry: Multo melius. Aspice.\n[Terry res varias in vas iacit; Phil vultu attonito eum adiuvat.]\nPhil: Mirabile! Num aliud facere potest, an solum vas aspiratorium mirum est?\nTerry: Ita, si manubrium hic premo, omnia egerit.\n[Terry manubria vasis premit, sed mox vultus eius horrore mutatur.]\nTerry: Pro di immortales! Phil, modo intellexi me fortasse nonnullas granatas fodinales intus iecisse <b>cum antea eo luderemus.</b>\nTerry: Cito! <b>Indumentum tuum</b> indue antequam ---\n[Vas activatur et contenta per cubiculum iacit. Unum proiectum carinam percutit et explodit, foramen aperiens paulo antequam transmissio interrumpitur.]\n\n[FINIS FASCICULI]",
    "ITEM_ENGINEERS_TOOLBELT_LORE": "<align=left>Traditio aestimata:<indent=70%>Destinatio:</indent></align>\n<align=left>9/9/2079<indent=70%>UES Safe Travels/Sector non signatus/Margo exterior</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Res traditionis:       </u></size></style></indent>\n\n<indent=2%>-Ordo: <style=cIsUtility>Cingulum Fabri</style></indent>\n<indent=4%><style=cStack>Numerus vestigationis:  667********</style></indent>\n\n<indent=2%>-Descriptio: Parva facultas fucos et turres emptos duplicandi. Fuci et turres parvam facultatem habent se post mortem revivificandi.</indent>\n\n<indent=2%>-Ratio traditionis: <style=cIsHealth>Traditio postridie / Industriale commune / Parvum</style></indent>\n\n<indent=2%>-Singula: Salve, amice,\n\nModo petitionem tuam accepi de balteo instrumentorum substituendo. Vix credere potui nullum in nave Safe Travels esse. Nonnullae copiae hic deficiunt, itaque omnia quae ad manum habebam adhibui. In balteo sunt omnia quibus technicus ordinarius automatarum et turrium reparandarum egeat.\n\nAccipis:\n\n<indent=5%>- Verticulum planum</indent>\n<indent=5%>- Totam marsupii copiam pilarum AA Ionocell (felix tu)</indent>\n<indent=5%>- Clavem dentatam</indent>\n<indent=5%>- Fasciam adhaesivam zebrinam filiae meae, quam non desiderabit</indent>\n<indent=5%>- Marsupium ad summum plenum omnibus cochleis solutis quas invenire potui.</indent>\n<indent=5%>- Aliquot nuces et clavos in marsupiis.</indent>\n<indent=5%>- Et hoc tibi placebit: in reliquis marsupiis nonnullos cibos tibi posui. Nescio an adhuc edules erunt cum haec pervenerint.</indent>\n\nVale,\nHumilis technicus\n\nP.S. Nonnullae pilae Ionocell iter per hyperspatium fortasse non superabunt; sed propter multitudinem quam misi, si automata non excitant, aliud par tenta.</indent>\n\n<style=cStack>Traditio per novum </style><style=cIsUtility>Systema Orbitale Capsarum Demittendarum (TM)</style>. <style=cStack><u>Nulla pecunia redditur.</u></style>"
  }
}
