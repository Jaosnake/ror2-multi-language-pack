{
  "pt-BR": {
    "GNOMECHEF_NAME": "CHEF",
    "GNOMECHEF_SUBTITLE": "O Cozinheiro",
    "GNOMECHEF_DESCRIPTION": "CHEF é um robô cozinheiro capaz de servir generosas porções até mesmo para as maiores multidões.<style=cSub>\n\n< ! > Cutelos podem acertar clientes no retorno.\n\n< ! > Use Cristalizar para circular rapidamente pela cozinha e evitar esbarrar em clientes.\n\n< ! > Combine Cristalizar com Chamuscar para cozinhar grandes lotes com eficiência.\n\n< ! > Sirva diferentes habilidades com Segundo Prato para satisfazer o gosto da sua clientela.</style>",
    "KEYWORD_GNOMECHEF_BOOST_DICE": "<style=cKeywordName>Picar</style><style=cSub>Arremesse 16 cutelos em uma esfera, causando <style=cIsDamage>16x120% de dano</style>.</style>",
    "KEYWORD_GNOMECHEF_BOOST_SEAR": "<style=cKeywordName>Flambar</style><style=cSub>Chamusque clientes em fogo alto, causando <style=cIsDamage>420%</style>. Clientes Cristalizados sofrem o dobro de dano e entram em combustão, causando <style=cIsDamage>5x200% de dano</style>.</style>",
    "KEYWORD_GNOMECHEF_BOOST_GLAZE": "<style=cKeywordName>Marinar</style><style=cSub>Deixe um rastro de óleo mais longo.</style>",
    "KEYWORD_GNOMECHEF_BOOST_SLICE": "<style=cKeywordName>Despedaçar</style><style=cSub>Golpeie 16 vezes. O número de golpes aumenta com a velocidade de ataque.</style>",
    "GNOMECHEF_PRIMARY_NAME": "Cortar",
    "GNOMECHEF_PRIMARY_DESCRIPTION": "<style=cIsUtility>Ágil.</style> Arremesse um cutelo contra clientes, causando <style=cIsDamage>150% de dano</style>. Volta como bumerangue.",
