    "ROB_NEMESIS_BODY_MELEE_NAME": "Asalto Brutal",
    "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Golpea infligiendo <style=cIsDamage>350% de daño</style>. Úsalo estando <style=cIsUtility>quieto</style> para dar un pisotón de <style=cIsDamage>800% de daño</style>. Úsalo mientras <style=cIsUtility>corres</style> para embestir por <style=cIsDamage>600% de daño</style>.",
    "ROB_NEMESIS_BODY_GRAB_NAME": "Alcance Mortal",
    "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Agarra a un enemigo. Usa Primaria para consumirlo y curar 10% de salud máxima, o Secundaria para cargar un lanzamiento de hasta 2400% de daño.",
    "ROB_NEMESIS_BODY_DASH_NAME": "Embestida Biológica",
