        "ENFORCER_PROC_SKATEBOARD": "Kaykay",
        "NEMFORCER_NAME": "Nemesis İnfazcısı",
        "NEMFORCER_DESCRIPTION": "Nemesis Enforcer, yiğitliğin ve gücün vücut bulmuş halidir; kimsenin hafife alamayacağı doğaüstü bir türdür.<color=#CCD3E0>\n\n< ! >Altın Çekiç aynı anda birçok düşmanı vurabilir.\n\n< ! >Yıkıcı bir darbe gerçekleştirmek için yukarıdan Hakimiyet'i kullanın.\n\n< ! >Altın Minigun ile saldırı yapmak, güçlü patronları devirmenin anahtarıdır.\n\n< ! >Kalkanlar amcıklar içindir.\n\n</color>",
        "NEMFORCER_SUBTITLE": "Bozulmaz Gölge",
        "NEMFORCER_LORE": "\nağır tf2\n\n",
        "NEMFORCER_OUTRO_FLAVOR": "..ve böylece onu onurlandıracak yeni bir kudretle ayrıldı.",
        "NEMFORCER_OUTRO_FAILURE": "..ve böylece geri döndü, yanılmaz kale gerçekten ölümsüzleşmişti.",
        "NEMFORCER_BOSS_NAME": "Ultra Nemesis İnfazcısı",
        "NEMFORCER_BOSS_SUBTITLE": "Hattın Sonu",
        "DEDEDE_NAME": "Kral Dede",
        "DEDEDE_BOSS_SUBTITLE": "Rüya Ülkesinin Kralı",
        "ENFORCER_EVENT_NEMFORCERBOSS_START": "Boşluktan doğal olmayan bir güç yayılıyor...",
        "ENFORCER_EVENT_NEMFORCERBOSS_END": "Boşluğun etkisi kaybolur...",
        "NEMFORCER_PASSIVE_NAME": "Devasa",
        "NEMFORCER_PASSIVE_DESCRIPTION": "Nemesis Enforcer'ın kazanımları<style=cIsHealing>bonus sağlık yenilenmesi</style>şu anki durumuna göre<style=cIsHealth>eksik sağlık</style>, kadar<style=cIsHealth>%2,5 maksimum sağlık</style>.",
        "NEMFORCER_PASSIVE_REWORK_DESCRIPTION": "Nemesis Enforcer yenileniyor<style=cIsHealing>%2</style>onun<style=cIsHealing>maksimum sağlık</style>düşmanlara saldırırken 3 saniyeden fazla<style=cIsDamage>yakın dövüş saldırıları</style>.",
        "NEMFORCER_PRIMARY_HAMMER_NAME": "Altın Çekiç",
        "NEMFORCER_PRIMARY_HAMMER_DESCRIPTION": "Çekicini salla<style=cIsDamage>%500</style>zarar.",
        "NEMFORCER_PRIMARY_THROWHAMMER_NAME": "Çekiç Fırlatma",
        "NEMFORCER_PRIMARY_THROWHAMMER_DESCRIPTION": "için bir çekiç atın<style=cIsDamage>%620</style>zarar.",
        "NEMFORCER_PRIMARY_MINIGUN_NAME": "Altın Minigun",
        "NEMFORCER_PRIMARY_MINIGUN_DESCRIPTION": "Hızınızı artırın ve bir sürü mermi ateşleyin<style=cIsDamage>%65 hasar</style>mermi başına.<style=cIsUtility>Ateş ederken hareketinizi yavaşlatır.</style>",
        "KEYWORD_SLAM": "<style=cKeywordName>Aşağıya doğru çarpma</style><style=cSub><style=cIsDamage>Çekici.</style>acımasızca<style=cIsHealth>çökmek</style>çekicinle uğraşırken<style=cIsDamage>%300-%2500 hasar</style>ve fazladan bir işlem yapıyorum<style=cIsDamage>%30</style>bunun etkisi üzerinde.<style=cIsUtility>Darbe yarıçapı hıza göre ölçeklenir.</style></style>",
        "NEMFORCER_SECONDARY_BASH_NAME": "Hakimiyet",
        "NEMFORCER_SECONDARY_BASH_DESCRIPTION": "<style=cIsUtility>Şarj edin</style>, sonra ileri doğru hamle yapın ve bir<style=cIsDamage>yükselen aparkat</style>için<style=cIsDamage>%450-%2500 hasar</style>. Süreyi kullan<style=cIsUtility>Düşmek ve aşağı bakmak</style>gerçekleştirmek için<style=cIsUtility>Aşağıya doğru çarpma</style>yerine.",
        "NEMFORCER_SECONDARY_SLAM_NAME": "Hakimiyet (Minigun)",
        "NEMFORCER_SECONDARY_SLAM_DESCRIPTION": "<style=cIsDamage>Çekici.</style>Minigun duruşundayken, şiddetle<style=cIsHealth>çarpmak</style>çekicini indir, uğraş<style=cIsDamage>%600 hasar</style>Ve<style=cIsDamage>geri vurmak</style>düşmanlar çarptı.<style=cIsUtility>Mermileri patlatır.</style>",
        "NEMFORCER_UTILITY_GAS_NAME": "XM47 Bombası",
        "NEMFORCER_UTILITY_GAS_DESCRIPTION": "Bir bulutun içine patlayan bir el bombası atın<style=cIsUtility>aşındırıcı gaz</style>O<style=cIsUtility>yavaşlar</style>ve fırsatlar<style=cIsDamage>Saniyede %200 hasar</style>ve sürer<style=cIsDamage>16 saniye</style>.",
        "NEMFORCER_UTILITY_JUMP_NAME": "Süper Dedede Atlama",
        "NEMFORCER_UTILITY_JUMP_DESCRIPTION": "Havaya atla, sonra yere çarp<style=cIsDamage>%3200 hasar</style>. <style=cIsUtility>Çarpma merkezinin dışında daha az hasar verir.</style>",
        "KEYWORD_GRAPPLE": "<style=cKeywordName>boğuşma</style><style=cSub>Geçerli<style=cIsDamage>sersemletmek</style>ve girişiminde bulunur<style=cIsUtility>yakalamak</style>yakındaki bir düşman.</style>",
        "NEMFORCER_UTILITY_CRASH_NAME": "Isı Çarpması",
        "NEMFORCER_UTILITY_CRASH_DESCRIPTION": "<style=cIsUtility>Boğuşmak.</style>Havaya atla, sonra yere çarp<style=cIsDamage>%2400 hasar</style>. <style=cIsUtility>Çarpma merkezinin dışında daha az hasar verir.</style>",
        "NEMFORCER_SPECIAL_MINIGUNUP_NAME": "Bastırma Duruşu",
        "NEMFORCER_SPECIAL_MINIGUNUP_DESCRIPTION": "Saldırgan bir duruş sergileyin,<style=cIsDamage>minigununuzu hazırlıyoruz</style>. <style=cIsHealth>Sprint yapmayı önler</style>.",
        "NEMFORCERBODY_DEFAULT_SKIN_NAME": "Düşman",
