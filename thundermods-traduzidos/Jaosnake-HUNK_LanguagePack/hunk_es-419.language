    "ROB_HUNK_BODY_PPASSIVE_NAME": "OSP (Aprovisionamiento en el Sitio)",
    "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK puede recolectar <color=#FFFF00>Tarjetas Llave U.C.</color> para abrir <style=cIsDamage>estuches de armas</style> y ampliar su arsenal.",
    "ROB_HUNK_BODY_PPASSIVE2_NAME": "Soldado Olvidado",
    "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "El primer <style=cIsHealth>jefe</style> que muera en cada escenario suelta un <style=cIsDamage>paquete de suministros</style> que contiene un arma o un accesorio.",
    "ROB_HUNK_BODY_PASSIVE_NAME": "Lucha Sombría",
    "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Comienzas con un <style=cIsDamage>LE 5</style> y un <style=cIsDamage>arma secundaria</style>. Puedes <style=cIsDamage>rebuscar</style> en <style=cIsUtility>cofres</style> para encontrar munición.",
    "ROB_HUNK_BODY_PASSIVE2_NAME": "Terror Inminente",
    "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "Comienzas con un <style=cIsDamage>arsenal completo</style>, <style=cIsHealth>PERO</style> ya <style=cIsHealth>no podrás obtener más munición</style>.",
    "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "Nueva Partida+",
    "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Comienzas con un <style=cIsDamage>LE 5</style> y un <style=cIsDamage>arma secundaria</style>. Puedes <style=cIsDamage>rebuscar</style> en <style=cIsUtility>cofres</style> para encontrar munición. <style=cIsHealth>El contenido de todos los estuches de armas es aleatorio.</style>",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Autoridad Suprema",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "Comienzas <style=cIsHealth>SOLO</style> con una <style=cIsDamage>W-870</style>. Puedes <style=cIsDamage>rebuscar</style> en <style=cIsUtility>cofres</style> para encontrar munición.",
    "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Mercenario Definitivo",
    "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Comienzas <style=cIsHealth>SOLO</style> con un <style=cIsDamage>LE 5 totalmente mejorado</style>. Puedes <style=cIsDamage>rebuscar</style> en <style=cIsUtility>cofres</style> para encontrar munición. <style=cIsDamage>Especial</style> se reemplaza por <color=#C80202>Modo Estragos</color>.",
    "ROB_HUNK_BODY_WPASSIVE_NAME": "Saturación Global Completa",
    "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "Comienzas <style=cIsHealth>SOLO</style> con un <style=cIsDamage>arma secundaria</style>. Puedes <style=cIsDamage>rebuscar</style> en <style=cIsUtility>cofres</style> para encontrar munición. <style=cIsDamage>Utilidad</style> se reemplaza por <color=#C80202>Uroboros</color>.",
    "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Piromanía",
    "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "Comienzas <style=cIsHealth>SOLO</style> con un <style=cIsDamage>Lanzallamas Químico</style>. Puedes <style=cIsDamage>rebuscar</style> en <style=cIsUtility>cofres</style> para encontrar munición. <style=cIsHealth>Solo aparece UN estuche de armas por escenario.</style>",
    "ROB_HUNK_BODY_CONFIRM_NAME": "Confirmar",
    "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "Continúa con la habilidad actual.",
    "ROB_HUNK_BODY_CANCEL_NAME": "Cancelar",
    "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "Cancela la habilidad actual.",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Cuchillo de Combate",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Saqueo.</style> <style=cIsDamage>Corta</style> a los combatientes cercanos para infligir <style=cIsDamage>200% de daño</style> y aplicar <style=cIsHealth>Mutilado</style>.",
    "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Combate Cuerpo a Cuerpo)",
    "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Saqueo.</style> <style=cIsDamage>Patea dos veces</style> infligiendo <style=cIsDamage>200% y 250% de daño</style>. Si la <style=cIsUtility>segunda patada</style> conecta, encadena un <style=cIsDamage>Contraataque</style>.",
    "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Escanear",
    "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Escanea en busca de <style=cIsUtility>estuches de armas sin abrir</style>.",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Gancho",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Dispara un gancho a un <style=cIsUtility>punto distante</style> y luego <style=cIsUtility>impúlsate hacia allí</style>. <style=cIsDamage>Puedes contraatacar tras aterrizar.</style>",
    "ROB_HUNK_BODY_SHOOT_ATM_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_ATM_DESCRIPTION": "Dispara causando <style=cIsDamage>8000% de daño</style>. <style=cIsUtility>Inflige mayor daño en impactos directos.</style>",
    "ROB_HUNK_BODY_SHOOT_ATM2_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_ATM2_DESCRIPTION": "Dispara causando <style=cIsDamage>8000% de daño</style>. <style=cIsUtility>Inflige mayor daño en impactos directos.</style>",
    "ROB_HUNK_BODY_SHOOT_RPG_NAME": "Disparar",
