        "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Sabit Nişan",
        "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Nişan alarak <style=cIsUtility>düşmanların zayıf noktalarını açığa çıkar</style>. <style=cIsDamage>Nişan alırken birincil yeteneği kullanmak elindeki silahı ateşler.</style>",
        "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Hızlı Adım",
        "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "Kısa bir mesafeye <style=cIsUtility>atıl</style>. <style=cIsUtility>Bir saldırıdan kaçınmak</style> için zamanında kullanılırsa <style=cIsDamage>Kusursuz Kaçınma</style> gerçekleştirir.",
        "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
        "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "Kısa bir mesafeye <style=cIsUtility>atıl</style>. <style=cIsUtility>Bir saldırıdan kaçınmak</style> için zamanında kullanılırsa <style=cIsDamage>Kusursuz Kaçınma</style> gerçekleştirir.\n<color=#d299ff>SCEPTER: Uroboros'un gücü içinden akıyor.</color>",
        "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Savuşturma",
        "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "Bir saldırıyı <style=cIsUtility>engelle</style>, hasarı <style=cIsDamage>etkisiz hale getir</style> ve <style=cIsUtility>bekleme süresini iade et</style>. Zamanında kullanılırsa <style=cIsDamage>Kusursuz Savuşturma</style> gerçekleştirir.",
        "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Omuz Darbesi",
        "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "Yakındaki düşmanlara <style=cIsUtility>omuz at</style> ve <style=cIsDamage>%400 hasar</style> vererek <style=cIsUtility>onları sersemlet</style>. <style=cIsUtility>Bir saldırıyı kesmek</style> için zamanında kullanılırsa <style=cIsDamage>Kusursuz Darbe</style> gerçekleştirir.",
        "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Lejyon",
