        "ENFORCER_PROC_SKATEBOARD": "Rultabulo",
        "NEMFORCER_NAME": "Nemesis Enforcer",
        "NEMFORCER_DESCRIPTION": "Nemesis Enforcer estas enkarnigxo de kuragxo kaj forto, supernatura speco kiun neniu devus subtaksi.<color=#CCD3E0>\n\n< ! > Golden Hammer povas trafi multajn malamikojn samtempe.\n\n< ! > Uzu Dominance de alte por fari ruinigan frapon.\n\n< ! > Flankpasxado kun Golden Minigun estas sxlosilo por venki potencajn estrojn.\n\n< ! > Sxildoj estas por malkuragxuloj.\n\n</color>",
        "NEMFORCER_SUBTITLE": "Nekoruptebla Ombro",
        "NEMFORCER_LORE": "\nheavy tf2\n\n",
        "NEMFORCER_OUTRO_FLAVOR": "..kaj tiel li foriris, kun novtrovita potenco honorinda.",
        "NEMFORCER_OUTRO_FAILURE": "..kaj tiel li revenis, senerara bastiono vere eternigita.",
        "NEMFORCER_BOSS_NAME": "Ultra Nemesis Enforcer",
        "NEMFORCER_BOSS_SUBTITLE": "Fino de la Linio",
        "DEDEDE_NAME": "King Dedede",
        "DEDEDE_BOSS_SUBTITLE": "Regxo de Songxlando",
        "ENFORCER_EVENT_NEMFORCERBOSS_START": "Nenatura forto elradias el la Void...",
        "ENFORCER_EVENT_NEMFORCERBOSS_END": "La influo de la Void forvelkas...",
        "NEMFORCER_PASSIVE_NAME": "Koloso",
        "NEMFORCER_PASSIVE_DESCRIPTION": "Nemesis Enforcer akiras <style=cIsHealing>bonusan sanregeneradon</style>, bazitan sur sia nuna <style=cIsHealth>mankanta sano</style>, gxis <style=cIsHealth>2.5% de maksimuma sano</style>.",
        "NEMFORCER_PASSIVE_REWORK_DESCRIPTION": "Nemesis Enforcer regeneras <style=cIsHealing>2%</style> de sia <style=cIsHealing>maksimuma sano</style> dum 3s kiam li trafas malamikojn per <style=cIsDamage>manbatalaj atakoj</style>.",
        "NEMFORCER_PRIMARY_HAMMER_NAME": "Ora Martelo",
        "NEMFORCER_PRIMARY_HAMMER_DESCRIPTION": "Svingu vian martelon por <style=cIsDamage>500%</style> da damagxo.",
        "NEMFORCER_PRIMARY_THROWHAMMER_NAME": "Jxetmartelo",
        "NEMFORCER_PRIMARY_THROWHAMMER_DESCRIPTION": "Jxetu martelon por <style=cIsDamage>620%</style> da damagxo.",
        "NEMFORCER_PRIMARY_MINIGUN_NAME": "Ora Minipafilo",
        "NEMFORCER_PRIMARY_MINIGUN_DESCRIPTION": "Akcelu kaj pafu hajlon de kugloj kauxzantajn <style=cIsDamage>65% da damagxo</style> po kuglo. <style=cIsUtility>Malrapidigas vian movigxon dum pafado.</style>",
        "KEYWORD_SLAM": "<style=cKeywordName>Malsupra Frapo</style><style=cSub><style=cIsDamage>Stuliga.</style> Kruele <style=cIsHealth>koliziu malsupren</style> per via martelo, kauxzante <style=cIsDamage>300%-2500% da damagxo</style> kaj kauxzante kroman <style=cIsDamage>30%</style> de tio cxe frapo. <style=cIsUtility>Frap-radiuso skaligxas kun rapideco.</style></style>",
        "NEMFORCER_SECONDARY_BASH_NAME": "Dominance",
        "NEMFORCER_SECONDARY_BASH_DESCRIPTION": "<style=cIsUtility>Sxargu</style>, poste impetu antauxen kaj liberigu <style=cIsDamage>levigxantan suprenbaton</style> por <style=cIsDamage>450%-2500% da damagxo</style>. Uzu dum <style=cIsUtility>falado kaj rigardante malsupren</style> por fari <style=cIsUtility>Malsupran Frapon</style> anstataux tio.",
        "NEMFORCER_SECONDARY_SLAM_NAME": "Dominance (Minipafilo)",
        "NEMFORCER_SECONDARY_SLAM_DESCRIPTION": "<style=cIsDamage>Stuliga.</style> Dum en minipafila pozicio, perforte <style=cIsHealth>frapu</style> malsupren vian martelon, kauxzante <style=cIsDamage>600% da damagxo</style> kaj <style=cIsDamage>retrobante</style> trafitajn malamikojn. <style=cIsUtility>Eksplodigas pafajxojn.</style>",
        "NEMFORCER_UTILITY_GAS_NAME": "XM47 Granato",
        "NEMFORCER_UTILITY_GAS_DESCRIPTION": "Jxetu granaton, kiu eksplodas en nubon de <style=cIsUtility>koroda gaso</style>, kiu <style=cIsUtility>malrapidigas</style> kaj kauxzas <style=cIsDamage>200% da damagxo po sekundo</style> kaj dauxras dum <style=cIsDamage>16 sekundoj</style>.",
        "NEMFORCER_UTILITY_JUMP_NAME": "Super Dedede Jump",
        "NEMFORCER_UTILITY_JUMP_DESCRIPTION": "Saltu en la aeron, poste frapu malsupren por <style=cIsDamage>3200% da damagxo</style>. <style=cIsUtility>Kauxzas reduktitan damagxon ekster la centro de la frapo.</style>",
        "KEYWORD_GRAPPLE": "<style=cKeywordName>Kaptado</style><style=cSub>Aplikas <style=cIsDamage>stuligon</style> kaj provas <style=cIsUtility>kapti</style> proksiman malamikon.</style>",
        "NEMFORCER_UTILITY_CRASH_NAME": "Heat Crash",
        "NEMFORCER_UTILITY_CRASH_DESCRIPTION": "<style=cIsUtility>Kaptado.</style> Saltu en la aeron, poste frapu malsupren por <style=cIsDamage>2400% da damagxo</style>. <style=cIsUtility>Kauxzas reduktitan damagxon ekster la centro de la frapo.</style>",
        "NEMFORCER_SPECIAL_MINIGUNUP_NAME": "Subprema Pozicio",
        "NEMFORCER_SPECIAL_MINIGUNUP_DESCRIPTION": "Prenu ofensivan pozicion, <style=cIsDamage>pretigante vian minipafilon</style>. <style=cIsHealth>Malhelpas sprinton</style>.",
        "NEMFORCERBODY_DEFAULT_SKIN_NAME": "Nemesis",
        "NEMFORCERBODY_ENFORCER_SKIN_NAME": "Enforcer",
        "NEMFORCERBODY_CLASSIC_SKIN_NAME": "Klasika",
        "NEMFORCERBODY_TYPHOON_SKIN_NAME": "Cxampiono",
        "NEMFORCERBODY_DRIP_SKIN_NAME": "Dripforcer",
        "NEMFORCERBODY_DEDEDE_SKIN_NAME": "King Dedede",
        "NEMFORCERBODY_MINECRAFT_SKIN_NAME": "Minecraft",
        "NEMFORCERBODY_FEM_SKIN_NAME": "Pikilhava",
