{
    "es-ES": {
        "ACHIEVEMENT_KENKO_SEAMSTRESS_MASTERYACHIEVEMENT_NAME": "Seamstress: Mastery",
        "ACHIEVEMENT_KENKO_SEAMSTRESS_TYPHOONMASTERYACHIEVEMENT_NAME": "Raven: Unlocked",
        "KENKO_SEAMSTRESS_NAME": "Seamstress",
        "KENKO_SEAMSTRESS_DESCRIPTION": "Seamstress es una superviviente móvil que utiliza su salud para causar daños. Obtiene menos daño base por nivel, así que apila elementos de salud para aprovechar su conversión de salud a daño.<color=#CCD3E0>\n\n< ! > Usa Corte con tantas agujas como puedas. Puede aplicar sangrado rápidamente durante Insaciable.\n\n< ! > Brutalizar aumenta mucho tu daño, pero vigila tu salud.</color>",
        "KENKO_SEAMSTRESS_SUBTITLE": "La doncella andrajosa",
        "KENKO_SEAMSTRESS_LORE": "Piel pálida y fatiga. Signos de una enfermedad que se propaga entre los hijos del tribunal superior. Qué desgraciados son.\n\nLa enfermedad se puede curar con un corazón artificial pero la operación no se puede realizar en quienes no han llegado a la edad adulta. Sólo unos pocos tienen la suerte de caer dentro de ese plazo.\n\nAunque un corazón artificial cura la enfermedad, el día a día sigue siendo el mismo. Con un mantenimiento frecuente y riesgos de mal funcionamiento, aventurarse lejos de casa podría significar la muerte. Muchos adoptan pasatiempos más lentos como hornear y coser, pero no todos están contentos con sus vidas.\n\nA muchos de los que huyen se les da una prueba de la realidad. La galaxia fuera del tribunal superior no es el país de las maravillas descrito en los libros. Es más parecido a un cuento de hadas trágico.",
        "KENKO_SEAMSTRESS_OUTRO_FLAVOR": "..y así se fue, anhelando coser algo más que tela.",
        "KENKO_SEAMSTRESS_OUTRO_FAILURE": "..y así desapareció, con las costuras descosidas.",
        "KENKO_SEAMSTRESS_MASTERY_SKIN_NAME": "Alternativo",
        "KENKO_SEAMSTRESS_MASTERY_SKIN_NAME2": "Alternativo2",
        "KENKO_SEAMSTRESS_MASTERY_SKIN_NAME3": "Cuervo",
        "KENKO_SEAMSTRESS_MASTERY_SKIN_NAME4": "Cuervo alternativo",
        "KENKO_SEAMSTRESS_PASSIVE_NAME": "tiene hambre",
        "KENKO_SEAMSTRESS_PASSIVE_DESCRIPTION": "Obtiene <style=cIsDamage>daño base</style> y <style=cIsHealing>curación</style> según <style=cIsHealth>salud faltante</style>.",
        "KENKO_SEAMSTRESS_NEEDLE_NAME": "Corazón Tocado por el Diablillo",
        "KENKO_SEAMSTRESS_NEEDLE_DESCRIPTION": "Consume <color=#9B3737>Agujas</color> al saltar en el aire para <color=#9B3737>teletransportarte</color> y disparar un proyectil que inflige <style=cIsDamage>40% de daño</style>.",
        "KENKO_SEAMSTRESS_PRIMARY_TRIM_NAME": "Recortar",
        "KENKO_SEAMSTRESS_PRIMARY_TRIM_DESCRIPTION": "<color=#9B3737>Despiadado</color>. Corta al frente para <style=cIsDamage>120% + 200% de daño</style>. Cada tercer golpe causa <style=cIsDamage>150% + 200% de daño</style>.",
        "KENKO_SEAMSTRESS_PRIMARY_FLURRY_NAME": "Ráfaga",
        "KENKO_SEAMSTRESS_PRIMARY_FLURRY_DESCRIPTION": "<color=#9B3737>Despiadado</color>. Corta al frente para <style=cIsDamage>140% + 200% de daño</style>.",
        "KENKO_SEAMSTRESS_SECONDARY_CLIP_NAME": "Corte",
        "KENKO_SEAMSTRESS_SECONDARY_CLIP_DESCRIPTION": "Corta e inflige <style=cIsDamage>2x70% de daño</style>. Realiza un corte adicional por cada <color=#9B3737>Aguja</color>.",
        "KENKO_SEAMSTRESS_SECONDARY_PLANMAN_NAME": "Manipulación Planar",
        "KENKO_SEAMSTRESS_SECONDARY_PLANMAN_DESCRIPTION": "<color=#9B3737>Aplastar</color>. Mantén presionado para agarrar enemigos. Golpear al enemigo causa <style=cIsDamage>200% - 1000% de daño</style> en un área según el conteo de <color=#9B3737>Aguja</color>. <style=cIsUtility>6 segundos de enfriamiento</style> en el mismo objetivo.",
        "KENKO_SEAMSTRESS_UTILITY_HEARTDASH_NAME": "Brutalizar",
        "KENKO_SEAMSTRESS_UTILITY_HEARTDASH_DESCRIPTION": "Avanza e inflige <style=cIsDamage>250% de daño</style> y obtén <color=#9B3737>Insaciable</color>. Reactiva la habilidad para explotar, convertir la <style=cIsHealing>barrera</style> en <style=cIsHealth>vida</style> e infligir entre <style=cIsDamage>300% y 1200% de daño</style> a tu alrededor según la cantidad convertida.",
        "KENKO_SEAMSTRESS_UTILITY_PARRY_NAME": "Tomar represalias",
        "KENKO_SEAMSTRESS_UTILITY_PARRY_DESCRIPTION": "Prepara una <style=cIsUtility>parada</style>. Si tiene éxito, avanza e inflige <style=cIsDamage>400% de daño</style> y obtén <color=#9B3737>Insaciable</color>.",
        "KENKO_SEAMSTRESS_SPECIAL_FIRE_NAME": "Atravesar",
        "KENKO_SEAMSTRESS_SPECIAL_FIRE_DESCRIPTION": "<style=cIsHealth>15% de vida</style>. Dispara unas tijeras <color=#9B3737>Simbióticas</color> que infligen <style=cIsDamage>400% de daño</style>. Recoge las tijeras <color=#9B3737>Simbióticas</color> para cortar e infligir <style=cIsDamage>200% de daño</style>.",
        "KENKO_SEAMSTRESS_SPECIAL_SCEPTER_NAME": "Alboroto",
        "KENKO_SEAMSTRESS_SPECIAL_SCEPTER_DESCRIPTION": "<style=cIsHealth>15% de vida</style>. Dispara unas tijeras <color=#9B3737>Simbióticas</color> que infligen <style=cIsDamage>400% de daño</style>. Recoge las tijeras <color=#9B3737>Simbióticas</color> para cortar e infligir <style=cIsDamage>200% de daño</style>.\n<color=#d299ff>CETRO: Tu arma <color=#9B3737>Simbiótica</color> solo tarda <style=cIsUtility>1,5 segundos en poder recogerse</style>.</color>",
        "ACHIEVEMENT_KENKO_SEAMSTRESS_MASTERYACHIEVEMENT_DESCRIPTION": "Como Seamstress, completa el juego o elimínate en Monsoon.",
        "ACHIEVEMENT_KENKO_SEAMSTRESS_TYPHOONMASTERYACHIEVEMENT_DESCRIPTION": "Como Seamstress, completa el juego o elimínate en Eclipse o una dificultad superior."
    }
}
