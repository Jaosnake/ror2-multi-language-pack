        "ACHIEVEMENT_ROB_HUNK_FLAMER_ACHIEVEMENT_ID_DESCRIPTION": "Играя за HUNK, полностью модернизируйте химический огнемет.",
        "ACHIEVEMENT_ROB_HUNK_SURVIVALKIT_ACHIEVEMENT_ID_NAME": "HUNK: No Luck At All",
        "ACHIEVEMENT_ROB_HUNK_SURVIVALKIT_ACHIEVEMENT_ID_DESCRIPTION": "Играя за HUNK, в начале игры у вас кончились патроны.",
        "ACHIEVEMENT_ROB_HUNK_JUMPPACK_ACHIEVEMENT_ID_NAME": "HUNK: Nowhere to Go But Up",
        "ACHIEVEMENT_ROB_HUNK_JUMPPACK_ACHIEVEMENT_ID_DESCRIPTION": "Играя за HUNK, станьте жертвой несчастного случая при прыжке с парашютом.",
        "ROB_NEMESIS_BODY_NAME": "Nemesis T-Type",
        "ROB_NEMESIS_BODY_DESCRIPTION": "Nemesis T-Type — это неудержимое биологическое оружие, созданное для того, чтобы выдерживать любые наказания и с легкостью нейтрализовать свои цели.<color=#CCD3E0>\n\n< ! > Заряжайте прыжки, чтобы преодолевать большее расстояние.\n\n< ! > Поглощая врагов, вы становитесь уязвимы; сначала найдите безопасное место.\n\n< ! > Заполненная биомасса увеличивает ваш урон.</color>",
        "ROB_NEMESIS_BODY_SUBTITLE": "Неостановимое Биологическое Оружие",
        "ROB_NEMESIS_BODY_OUTRO_FLAVOR": "..и затем он ушёл, всё в порядке.",
        "ROB_NEMESIS_BODY_OUTRO_FAILURE": "..и затем он исчез, человеческая единица теперь нейтрализована.",
        "ROB_NEMESIS_BODY_DEFAULT_SKIN_NAME": "Обычный",
        "ROB_NEMESIS_BODY_CLASSIC_SKIN_NAME": "Классический",
        "ROB_NEMESIS_BODY_VENOM_SKIN_NAME": "Симбиот",
        "ROB_NEMESIS_BODY_SUPER_SKIN_NAME": "<color=#FFFF00>Ранний сторонник</color>",
        "ROB_NEMESIS_BODY_MAHORAGA_SKIN_NAME": "Большая Рага Оппп Стоппа",
        "ROB_NEMESIS_BODY_MINOS_SKIN_NAME": "Король мужчин",
        "ROB_NEMESIS_BODY_PASSIVE_NAME": "Совершенная форма жизни",
        "ROB_NEMESIS_BODY_PASSIVE_DESCRIPTION": "<style=cIsDamage>Нанесение урона</style> накапливает <style=cIsHealth>Биомассу</style>, которая увеличивает ваш <style=cIsDamage>урон</style> при полном заполнении. Прыжки можно <style=cIsDamage>заряжать</style> для <style=cIsUtility>мощных скачков</style>.",
        "ROB_NEMESIS_BODY_PASSIVE2_NAME": "Биологическое Вооружение",
        "ROB_NEMESIS_BODY_PASSIVE2_DESCRIPTION": "Nemesis T-Type может <style=cIsHealth>мутировать</style>, поглощая <style=cIsDamage>лиц, представляющих интерес</style>, получая <style=cIsDamage>новые и улучшенные способности</style>.",
        "ROB_NEMESIS_BODY_PASSIVE22_NAME": "Увеличение Мышечной Массы",
        "ROB_NEMESIS_BODY_PASSIVE22_DESCRIPTION": "<style=cIsUtility>Атаки ближнего боя</style> наносят <style=cIsDamage>20%</style> больше урона, <style=cIsHealth>НО союзники могут получить урон</style>.",
        "ROB_NEMESIS_BODY_MELEE_NAME": "Жестокая Агрессия",
        "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Удар на <style=cIsDamage>350% урона</style>. Используйте <style=cIsUtility>стоя на месте</style> для топота на <style=cIsDamage>800% урона</style>. Используйте <style=cIsUtility>бегом</style> для толчка плечом на <style=cIsDamage>600% урона</style>.",
        "ROB_NEMESIS_BODY_GRAB_NAME": "Смертельная Хватка",
        "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Схватите врага. Используйте Основное, чтобы поглотить и вылечить 10% макс. здоровья, или Вторичное, чтобы зарядить бросок до 2.400% урона.",
        "ROB_NEMESIS_BODY_DASH_NAME": "Биоопасный Рывок",
        "ROB_NEMESIS_BODY_DASH_DESCRIPTION": "Используйте <style=cIsUtility>в воздухе</style> для рывка в воздухе <style=cIsDamage>один раз</style>.",
        "ROB_NEMESIS_BODY_ULTIMATE_NAME": "Критическая Масса",
        "ROB_NEMESIS_BODY_ULTIMATE_DESCRIPTION": "Удерживайте, чтобы медленно поглощать <style=cIsHealth>Биомассу</style>, восстанавливая до <style=cIsHealing>100% макс. здоровья</style>.",
        "ROB_NEMESIS_ITEM_EFFECT_TITLE": "Бонусный Эффект",
        "ROB_NEMESIS_ITEM_EFFECT_BANDOLIER": "Пачки патронов восстанавливают <style=cIsHealth>10% Биомассы</style>.",
        "ROB_NEMESIS_ITEM_EFFECT_ALIENHEAD": "Увеличивает <style=cIsHealth>Биомассу</style>, получаемую при <style=cIsDamage>поглощении</style> врагов.",
        "ROB_NEMESIS_ITEM_EFFECT_BRAINSTALKS": "Пока активно, <style=cIsHealth>Биомасса</style> <style=cIsUtility>неограничена</style>.",
        "ROB_NEMESIS_ITEM_EFFECT_PURITY": "Увеличивает <style=cIsHealth>Биомассу</style>, получаемую <style=cIsDamage>при попадании</style>.",
        "ROB_ARTIFACT_PURSUER_NAME": "Артефакт Преследователя",
