    "ROB_HUNK_BODY_SHOOT_AR_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_AR_DESCRIPTION": "Dispare causando <style=cIsDamage>385% de dano</style>. <style=cIsUtility>50% de bônus por tiro na cabeça.</style>",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Dispare causando <style=cIsDamage>2x250% de dano</style>. <style=cIsUtility>O dano escala com a velocidade de ataque.</style>",
    "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Mira Firme",
    "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Mire, <style=cIsUtility>expondo os pontos fracos dos inimigos</style>. <style=cIsDamage>Usar a primária enquanto mira dispara a arma equipada.</style>",
    "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Passo Rápido",
    "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Avance</style> por uma curta distância. Se usado preventivamente para <style=cIsUtility>evitar um ataque</style>, realiza uma <style=cIsDamage>Esquiva Perfeita</style>.",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Avance</style> por uma curta distância. Se usado preventivamente para <style=cIsUtility>evitar um ataque</style>, realiza uma <style=cIsDamage>Esquiva Perfeita</style>.\n<color=#d299ff>CETRO: O poder de Uroboros flui através de você.</color>",
    "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Aparar",
    "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Bloqueie</style> um ataque, <style=cIsDamage>anulando</style> o dano e <style=cIsUtility>reembolsando o tempo de recarga</style>. Se usado preventivamente, realiza uma <style=cIsDamage>Aparada Perfeita</style>.",
    "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Ombrada",
    "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Atinja com o ombro</style> inimigos próximos, <style=cIsUtility>atordoando-os</style> e causando <style=cIsDamage>400% de dano</style>. Se usado preventivamente para <style=cIsUtility>cancelar um ataque</style>, realiza uma <style=cIsDamage>Ombrada Perfeita</style>.",
    "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Legião",
    "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Troque</style> para outra <style=cIsDamage>arma</style>. Pressione rapidamente para alternar para sua <style=cIsUtility>última arma usada</style>.",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Faca de Combate",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "Uma faca militar padrão. Com certeza será útil em um aperto.",
    "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "Faca de Combate EX",
    "ROB_HUNK_BODY_KNIFE_INFINITE_DESCRIPTION": "Uma faca militar com tratamento especial, temperada a um nível inacreditável. Dizem que foi feita para durar de verdade.",
    "ROB_HUNK_BODY_KNIFE_HIDDEN_NAME": "Lâmina Oculta",
