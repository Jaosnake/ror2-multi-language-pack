    "ROB_NEMESIS_BODY_PASSIVE22_DESCRIPTION": "<style=cIsUtility>Ataques corpo a corpo</style> causam <style=cIsDamage>20%</style> a mais de dano, <style=cIsHealth>MAS aliados podem sofrer dano</style>.",
    "ROB_NEMESIS_BODY_MELEE_NAME": "Ataque Brutal",
    "ROB_NEMESIS_BODY_MELEE_DESCRIPTION": "Dê um soco causando <style=cIsDamage>350% de dano</style>. Use <style=cIsUtility>parado</style> para dar um pisão causando <style=cIsDamage>800% de dano</style>. Use <style=cIsUtility>correndo</style> para investir causando <style=cIsDamage>600% de dano</style>.",
    "ROB_NEMESIS_BODY_GRAB_NAME": "Alcance Mortal",
    "ROB_NEMESIS_BODY_GRAB_DESCRIPTION": "Agarre um inimigo. Use a Primária para consumi-lo e curar 10% da vida máxima, ou a Secundária para carregar um arremesso causando até 2400% de dano.",
    "ROB_NEMESIS_BODY_DASH_NAME": "Avanço Biológico",
    "ROB_NEMESIS_BODY_DASH_DESCRIPTION": "Use enquanto estiver <style=cIsUtility>no ar</style> para dar um impulso aéreo <style=cIsDamage>uma vez</style>.",
    "ROB_NEMESIS_BODY_ULTIMATE_NAME": "Massa Crítica",
    "ROB_NEMESIS_BODY_ULTIMATE_DESCRIPTION": "Segure para consumir <style=cIsHealth>Biomassa</style> lentamente, restaurando até <style=cIsHealing>100% da vida máxima</style>.",
