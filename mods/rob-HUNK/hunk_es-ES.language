    "ROB_HUNK_CRYSTALSKULL_DESC": "Un tesoro poco frecuente. Puede introducirse en cualquier <style=cIsUtility>Caldero</style> para recibir un objeto.",
    "ROB_HUNK_STARSBADGE_NAME": "Insignia S.T.A.R.S.",
    "ROB_HUNK_STARSBADGE2_NAME": "Llave Electrónica USB",
    "ROB_HUNK_STARSBADGE_DESC": "Una insignia especial de la división de fuerzas especiales del R.P.D., <color=#F20443>S.T.A.R.S.</color> <style=cIsHealth>¿Será que recogerla ha sido una mala idea?</style>",
    "ROB_HUNK_STARSBADGE_DESCFULL": "En cada fase aparece una caja especial de <color=#F20443>S.T.A.R.S.</color> que únicamente puede abrirse con esta insignia. Sin embargo, el <style=cIsHealth>Nemesis T-Type</style> te perseguirá sin tregua.",
    "ROB_HUNK_STARSBADGE2_DESC": "Sirve para acceder a un <style=cIsUtility>cofre especial</style> en cada fase.",
    "ROB_HUNK_STARSBADGE2_DESCFULL": "En cada fase aparece una caja especial de <color=#F20443>S.T.A.R.S.</color> que únicamente puede abrirse con esta insignia. Sin embargo, el <style=cIsHealth>Nemesis T-Type</style> te perseguirá sin tregua.",
    "ROB_HUNK_G_VIRUS_SAMPLE_NAME": "Muestra de G-Virus",
