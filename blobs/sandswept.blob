	public class UpdateAlphaBoostToPlating : MonoBehaviour
	{
		public float timer;

		public float interval = 0.2f;

		public MeshRenderer targetMeshRenderer;

		public Light targetLight;

		public TemporaryVisualEffect temporaryVisualEffect;

		public MakeshiftPlate.PlatingManager platingManager;

		public float alphaBoostMinimum = 0.5f;

		public float lightIntensityMinimum = 2f;

		public void Start()
		{
			Transform val = ((Component)this).transform.Find("MeshHolder/ShieldMesh");
			targetMeshRenderer = ((Component)val).GetComponent<MeshRenderer>();
			targetLight = ((Component)val).GetComponent<Light>();
			temporaryVisualEffect = ((Component)this).GetComponent<TemporaryVisualEffect>();
			Transform parentTransform = temporaryVisualEffect.parentTransform;
			if (!Object.op_Implicit((Object)(object)parentTransform))
			{
				return;
			}
			Transform root = parentTransform.root;
			CharacterModel component = ((Component)root).GetComponent<CharacterModel>();
			if (Object.op_Implicit((Object)(object)component))
			{
				CharacterBody body = component.body;
				if (Object.op_Implicit((Object)(object)body))
				{
					platingManager = ((Component)body).GetComponent<MakeshiftPlate.PlatingManager>();
				}
			}
		}

		public void FixedUpdate()
		{
			//IL_0037: Unknown result type (might be due to invalid IL or missing references)
			//IL_003d: Expected O, but got Unknown
			timer += Time.fixedDeltaTime;
			if (!(timer <= interval) && !((Object)(object)platingManager == (Object)null))
			{
				MaterialPropertyBlock val = new MaterialPropertyBlock();
				float num = platingManager.CurrentPlating / platingManager.MaxPlating;
				val.SetFloat("_AlphaBoost", Mathf.Max(alphaBoostMinimum, num * 7f));
				((Renderer)targetMeshRenderer).SetPropertyBlock(val);
				targetLight.intensity = Mathf.Max(lightIntensityMinimum, num * 10f);
				timer = 0f;
			}
		}
	}
	public class AdjustShieldMeshLocalScale : MonoBehaviour
	{
		public TemporaryVisualEffect temporaryVisualEffect;

		public void Start()
		{
			//IL_003e: Unknown result type (might be due to invalid IL or missing references)
			temporaryVisualEffect = ((Component)((Component)this).transform.root).GetComponent<TemporaryVisualEffect>();
			float radius = temporaryVisualEffect.radius;
			((Component)this).transform.localScale = new Vector3(radius * 0.1373f, radius * 0.1373f, radius * 0.9615f);
			((Component)this).GetComponent<Light>().range = radius * 2.7472f;
		}
	}
	[ConfigSection("Items :: Nuclear Salvo")]
	public class NuclearSalvo : ItemBase<NuclearSalvo>
	{
		public GameObject SalvoPrefab;

		public GameObject SalvoMissile;

		[ConfigField("Interval", "", 5f)]
		public static float interval;

		[ConfigField("Base Missile Count", "", 2)]
		public static int baseMissileCount;

		[ConfigField("Stack Missile Count", "", 2)]
		public static int stackMissileCount;

		[ConfigField("Base Missile Damage", "Decimal.", 1f)]
		public static float baseMissileDamage;

		[ConfigField("Missile Proc Coefficient", "", 0.33f)]
		public static float missileProcCoefficient;

		[ConfigField("Missile Explosion Radius", "", 8f)]
		public static float missileExplosionRadius;

		public static List<string> stageBlacklist = new List<string>(2) { "bazaar", "computationalexchange" };

		public static bool salvoAllowedToFire = true;

		public static GameObject orbEffect;

		public static GameObject explosionEffect;

		public override string ItemName => "Nuclear Salvo";

		public override string ItemLangTokenName => "NUCLEAR_SALVO";

		public override string ItemPickupDesc => "Mechanical allies fire nuclear warheads periodically.";

		public override string ItemFullDescription => $"Every $sd{interval}$se seconds, all mechanical allies fire $sd{baseMissileCount}$se $ss(+{stackMissileCount} per stack)$se $sdnuclear missiles$se that deal $sd{baseMissileDamage * 100f}%$se base damage each in a $sd{missileExplosionRadius}m$se radius.".AutoFormat();

		public override string ItemLore => "<style=cMono>\n//--AUTO-TRANSCRIPTION FROM LOADING BAY 4 OF THE UES [Redacted] --//\n</style>\n\"That's everything, right?\"\n\n\"Not quite. We're supposed to load those mean-looking missile salvos over there, too.\"\n\n\"Wait, what? Why would a shipping vessel like the Contact Light need these?\"\n\n\"I have no idea, but I've gotten word from high up that they need to be on board, in shipping chests. And when I say high up, I mean REALLY high up.\"\n\n\"There's so many. I have a bad feeling about this...especially after everything else going on with this shipment.\"\n\n\"Like it or not, it's part of the job. The suits at the top of UES are always pulling secret stunts like this. If we don't follow orders, we're outta here.\"";

		public override ItemTier Tier => (ItemTier)1;

		public override GameObject ItemModel => Main.hifuSandswept.LoadAsset<GameObject>("NuclearSalvoHolder.prefab");

		public override Sprite ItemIcon => Main.hifuSandswept.LoadAsset<Sprite>("texNuclearSalvo3.png");

		public override ItemTag[] ItemTags
		{
			get
			{
				ItemTag[] array = new ItemTag[5];
				RuntimeHelpers.InitializeArray(array, (RuntimeFieldHandle)/*OpCode not supported: LdMemberToken*/);
				return (ItemTag[])(object)array;
			}
		}

		public override float modelPanelParametersMinDistance => 7f;

		public override float modelPanelParametersMaxDistance => 15f;

		public override void Init()
		{
			base.Init();
			SetUpVFX();
			SceneManager.activeSceneChanged += OnSceneChange;
		}

		private void OnSceneChange(Scene arg0, Scene arg1)
		{
			//IL_0006: Unknown result type (might be due to invalid IL or missing references)
			//IL_000b: Unknown result type (might be due to invalid IL or missing references)
			List<string> list = stageBlacklist;
			Scene activeScene = SceneManager.GetActiveScene();
			salvoAllowedToFire = !list.Contains(((Scene)(ref activeScene)).name);
		}

		public override object GetItemStatsDef()
		{
			//IL_0001: Unknown result type (might be due to invalid IL or missing references)
			//IL_0007: Expected O, but got Unknown
			ItemStatsDef val = new ItemStatsDef();
			val.descriptions.Add("Missile Count: ");
			val.valueTypes.Add((ValueType)1);
			val.measurementUnits.Add((MeasurementUnits)4);
			val.descriptions.Add("Maximum Missile Count: ");
			val.valueTypes.Add((ValueType)1);
			val.measurementUnits.Add((MeasurementUnits)4);
			val.calculateValues = delegate(CharacterMaster master, int stack)
			{
				int num = 1;
				Inventory inventory = master.inventory;
				if (Object.op_Implicit((Object)(object)inventory) && inventory.GetItemCountEffective(Items.MoreMissile) > 0)
				{
					num = 3;
				}
				return new List<float>
				{
					(baseMissileCount + stackMissileCount * (stack - 1)) * num,
					interval / (1f / 60f)
				};
			};
			return val;
		}

