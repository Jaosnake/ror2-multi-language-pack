    "CI_REFINERY_OBJECTIVE_RUNNING": "<style=cHumanObjective>Saha Rafinerisi</style> işleminin bitmesini bekle (%{0})",
    "CI_REFINERY_OBJECTIVE_BUILDING_FIRST": "Boru hatları inşa et. <style=cHumanObjective>Saha Rafinerisi</style> işlemini başlatmak için en az {2} boru hattı inşa edilmelidir ({0}/{1})",
    "CI_REFINERY_OBJECTIVE_BUILDING": "Boru hatları inşa et. <style=cHumanObjective>Saha Rafinerisi</style> başlatılabilir ({0}/{1})",
