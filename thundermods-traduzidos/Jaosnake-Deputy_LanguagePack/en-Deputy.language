{
    "en": {
        "BOG_DEPUTY_BODY_NAME": "Deputy",
        "BOG_DEPUTY_BODY_DESCRIPTION": "Deputy is a high-octane, hyper-aggressive speed demon who dispenses justice with her twin revolvers and lethal kicks.<color=#CCD3E0>\n\n< ! > Trigger Tap has perfect accuracy and no damage falloff, but its maximum range is limited compared with most other guns.\n\n< ! > The revolvers thrown by Gun Sling always prioritize the nearest enemy.\n\n< ! > Aim upwards to angle Shooting Star slightly upward.\n\n< ! > Crashing Comet can deal devastating burst damage at high movement speed. Build stacks of Hot Pursuit with your guns, then attack.</color>",
        "BOG_DEPUTY_BODY_SUBTITLE": "Dashing Beauty",
        "BOG_DEPUTY_BODY_OUTRO_FLAVOR": "..and so she left, to the sound of thunderous applause.",
        "BOG_DEPUTY_BODY_OUTRO_FAILURE": "..and so she vanished, her performance finally at an end.",
        "BOG_DEPUTY_BODY_DEFAULT_SKIN_NAME": "Default",
        "BOG_DEPUTY_BODY_MASTERY_SKIN_NAME": "Mastery",
        "BOG_DEPUTY_BODY_PASSIVE_NAME": "Hot Pursuit",
        "BOG_DEPUTY_BODY_PASSIVE_DESCRIPTION": "Deputy can sprint in any direction. Hitting enemies with her skills grants a stackable <style=cIsUtility>movement speed</style> buff.",
        "BOG_DEPUTY_BODY_PRIMARY_SHOOT_NAME": "Trigger Tap",
        "BOG_DEPUTY_BODY_PRIMARY_SHOOT_DESCRIPTION": "<style=cIsUtility>Agile</style>. Shoot with medium-range revolvers for <style=cIsDamage>150% damage</style>.",
        "BOG_DEPUTY_BODY_SECONDARY_SLING_NAME": "Gun Sling",
        "BOG_DEPUTY_BODY_SECONDARY_SLING_DESCRIPTION": "<style=cIsUtility>Agile</style>. Toss two revolvers. Each revolver will shoot a nearby enemy for <style=cIsDamage>6x100% damage</style>, then explode for <style=cIsDamage>300% damage</style>.",
        "BOG_DEPUTY_BODY_UTILITY_SHOOTINGSTAR_NAME": "Shooting Star",
        "BOG_DEPUTY_BODY_UTILITY_SHOOTINGSTAR_DESCRIPTION": "<style=cIsDamage>Stunning</style>. Leap forward and shoot an enemy below you for <style=cIsDamage>4x150% damage</style>.",
        "BOG_DEPUTY_BODY_SPECIAL_SKULLBREAKER_NAME": "Crashing Comet",
        "BOG_DEPUTY_BODY_SPECIAL_SKULLBREAKER_DESCRIPTION": "<style=cIsUtility>Heavy</style>. <style=cIsUtility>Lunge</style> and ricochet off an enemy, dealing <style=cIsDamage>800% damage</style>. <style=cIsUtility>Kills reset your utility skill cooldown</style>.",
        "BOG_DEPUTY_BODY_SPECIAL_BULLETHEAVEN_NAME": "Bullet Heaven",
        "BOG_DEPUTY_BODY_SPECIAL_BULLETHEAVEN_DESCRIPTION": "Leap high into the air and furiously fire bullets downward, each dealing <style=cIsDamage>150% damage</style>. The number of shots scales with attack speed.",
        "BOG_DEPUTY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Deputy: Mastery",
        "BOG_DEPUTY_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "As Deputy, beat the game or obliterate on Monsoon.",
        "BOG_DEPUTY_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Deputy: Mastery",
        "BOG_DEPUTY_BODY_LORE": ""
