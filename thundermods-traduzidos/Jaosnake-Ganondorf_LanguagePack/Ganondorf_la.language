{
  "la": {
    "ETHA10_GANONDORF_BODY_NAME": "Ganondorf",
    "ETHA10_GANONDORF_BODY_DESCRIPTION": "Ganondorf, Magnus Rex Mali, advenit! <color=#CCD3E0>\n\n< ! > Infer pugnum simplicem ut hostes in aera mittas, aut per hostes irrumpe.\n\n< ! > Utere calcibus ut hostes aerios celeriter conficias.\n\n< ! > Utere Suffocatione Flammae ut plures hostes in ordine prehendas et debilitatos reddas.\n\n< ! > Pes Magi est optimum instrumentum mobilitatis et via ad hostes in aera mittendos.\n\n< ! > Pugnus Venefici pugnum displosivum vastantem emittit.\n\n< ! > Auge Trivim Potestatis tuam hostes feriendo aut occidendo, loricam, impetum, et vim Utilitatis atque Specialis augens.\n\n</color>",
    "ETHA10_GANONDORF_BODY_SUBTITLE": "Magnus Rex Mali",
    "ETHA10_GANONDORF_BODY_LORE": "??",
    "ETHA10_GANONDORF_BODY_OUTRO_FLAVOR": "..et sic abiit, malitiam post se spargens.",
    "ETHA10_GANONDORF_BODY_OUTRO_FAILURE": "..et sic evanuit, in aeternum obsignatus...",
    "ETHA10_GANONDORF_BODY_DEFAULT_SKIN_NAME": "Classicus",
    "ETHA10_GANONDORF_BODY_MASTERY_SKIN_NAME": "Regalis",
    "ETHA10_GANONDORF_BODY_OLD_SKIN_NAME": "Sapiens",
    "ETHA10_GANONDORF_BODY_BRAWL_SKIN_NAME": "Regius",
    "ETHA10_GANONDORF_BODY_BLAST_SKIN_NAME": "Flatus Praeteriti",
    "ETHA10_GANONDORF_BODY_SKIN1_NAME": "Classicus Saturatus",
    "ETHA10_GANONDORF_BODY_SKIN2_NAME": "Purpureus",
    "ETHA10_GANONDORF_BODY_SKIN3_NAME": "Viridis",
    "ETHA10_GANONDORF_BODY_SKIN5_NAME": "Malitia Immanis",
    "ETHA10_GANONDORF_BODY_SKIN7_NAME": "Fuscus",
    "ETHA10_GANONDORF_BODY_PASSIVE_NAME": "Trivis Potestatis",
    "ETHA10_GANONDORF_BODY_PASSIVE_DESCRIPTION": "Omnis ictus felix et caedes acervos augent qui loricam et damnum base Ganondorf augent. Acervi post 2 secunda sine incremento minuuntur. Omnes acervi consumentur ad ictum felicem Specialis tuae corroborandum, damnum usque ad <style=cIsDamage>1000%</style> in maximo numero acervorum augentes.",
    "ETHA10_GANONDORF_BODY_PRIMARY_PUNCH_NAME": "Comminus",
    "ETHA10_GANONDORF_BODY_PRIMARY_PUNCH_DESCRIPTION": "In terra, pugno prorsum feri pro <style=cIsDamage>200% damni</style>.\n<style=cIsUtility>obstupefaciens.</style> Cum curris, prorsum irrumpe, hostes proterens pro <style=cIsDamage>400% damni</style>.\nIn aere, bis calcitra pro <style=cIsDamage>90% damni</style> et <style=cIsDamage>250% damni</style>.\nIn aere et deorsum spectans, pedes deorsum impelle, brevi spatio sursum resiliens pro <style=cIsDamage>250% damni</style>.",
    "ETHA10_GANONDORF_BODY_PRIMARY_SWORD_NAME": "Findere",
    "ETHA10_GANONDORF_BODY_PRIMARY_SWORD_DESCRIPTION": "Finde agmina hostium pro <style=cIsDamage>220%</style> damni.\nIn <style=cIsDamage>40 acervis Trivitis</style>, manifesta et emitte radium lucis qui per hostes transit pro <style=cIsDamage>200%</style> damni.",
    "ETHA10_GANONDORF_BODY_SECONDARY_KICK_NAME": "Pes Magi",
    "ETHA10_GANONDORF_BODY_SECONDARY_KICK_DESCRIPTION": "<style=cIsUtility>Gravis.</style> Proice te prorsum hostes leves repellens pro <style=cIsDamage>300% damni</style>.",
    "ETHA10_GANONDORF_BODY_SECONDARY_GRAB_NAME": "Suffocatio Flammae",
    "ETHA10_GANONDORF_BODY_SECONDARY_GRAB_DESCRIPTION": "Prorsum irrumpe hostes in ordine prehendens et in terram elidens pro <style=cIsDamage>550% damni</style>.",
    "ETHA10_GANONDORF_BODY_SECONDARY_SWORD_CHARGE_NAME": "Turbo Serratus",
    "ETHA10_GANONDORF_BODY_SECONDARY_SWORD_CHARGE_DESCRIPTION": "Tene depressum ut gladium tuum usque ad 4s oneres, et dimitte ut gladium prorsum iacias, <style=cIsDamage>500%</style> sine onere per ictum inferens. Pleno onere, damnum per <style=cIsDamage>5x</style> augetur. Ganondorf impetibus suis comminus uti potest dum gladius eius iactus est.",
    "ETHA10_GANONDORF_BODY_UTILITY_GRAB_NAME": "Suffocatio Flammae",
    "ETHA10_GANONDORF_BODY_UTILITY_GRAB_DESCRIPTION": "Prorsum irrumpe hostes in ordine prehendens et in terram elidens pro <style=cIsDamage>700% damni</style>. Consumit 30 acervos in ictu felici pro <style=cIsDamage>300% pluris damni</style>.",
    "ETHA10_GANONDORF_BODY_UTILITY_KICK_NAME": "Pes Magi",
    "ETHA10_GANONDORF_BODY_UTILITY_KICK_DESCRIPTION": "<style=cIsUtility>Gravis.</style> Proice te prorsum hostes leves repellens pro <style=cIsDamage>700% damni</style>. Consumit 30 acervos in ictu felici pro <style=cIsDamage>300% pluris damni</style>.",
    "ETHA10_GANONDORF_BODY_UTILITY_AERIAL_GRAB_NAME": "Mersio Tenebrosa",
    "ETHA10_GANONDORF_BODY_UTILITY_AERIAL_GRAB_DESCRIPTION": "Sursum saliens hostes in via prehende et in frusta displode, primum 5 parvas displosiones pro <style=cIsDamage>65% damni</style> inferens ac tandem magnam displosionem pro <style=cIsDamage>650% damni</style> emittens. Numerus parvarum displosionum cum celeritate impetus crescit. Bullam depressam tenere ante finem motus Ganondorf celeriter cadere faciet. Consumit 30 acervos in ictu felici pro <style=cIsDamage>300% pluris damni</style>.",
    "ETHA10_GANONDORF_BODY_SECONDARY_AERIAL_GRAB_NAME": "Mersio Tenebrosa",
    "ETHA10_GANONDORF_BODY_SECONDARY_AERIAL_GRAB_DESCRIPTION": "Sursum saliens hostes in via prehende et in frusta displode, primum 5 parvas displosiones pro <style=cIsDamage>45% damni</style> inferens ac tandem magnam displosionem pro <style=cIsDamage>450% damni</style> emittens. Numerus parvarum displosionum cum celeritate impetus crescit. Bullam depressam tenere ante finem motus Ganondorf celeriter cadere faciet.",
    "ETHA10_GANONDORF_BODY_SPECIAL_PUNCH_NAME": "Pugnus Venefici",
    "ETHA10_GANONDORF_BODY_SPECIAL_PUNCH_DESCRIPTION": "Onera pugnum validum dum brevem Super Loricam accipis, <style=cIsDamage>1000% damni</style> in hostes propinquos emittens.\nConsume 50 acervos ad motum per <style=cIsDamage>333%</style> damni augendum. Consume 100 acervos ad motum per <style=cIsDamage>1000%</style> damni augendum.",
    "ETHA10_GANONDORF_BODY_INFERNO_KICK_NAME": "Securis Infernales",
    "ETHA10_GANONDORF_BODY_INFERNO_KICK_DESCRIPTION": "Trahe hostes in exitium, pedem deorsum incutiens et <style=cIsDamage>1100% damni</style> in radio circum te inferens.<color=#D2042D> Sine Super Lorica.</color>\nConsume 50 acervos ad motum per <style=cIsDamage>333%</style> damni augendum. Consume 100 acervos ad motum per <style=cIsDamage>1000%</style> damni augendum.",
    "ETHA10_GANONDORF_BODY_OBLITERATE_SWORD_NAME": "Obliterare",
    "ETHA10_GANONDORF_BODY_OBLITERATE_SWORD_DESCRIPTION": "Tolle gladium alte, usque ad <style=cIsDamage>5s</style> onerans ad damnum et spatium augendum. Dimitte ut gladium deorsum iacias, displosiones in partem quam spectas mittens. In basi, displosiones <style=cIsDamage>600%</style> damni inferunt, et usque ad summum <style=cIsDamage>5x</style> per displosionem crescere possunt.",
    "ETHA10_GANONDORF_BODY_SCEPTERSPECIAL_NAME": "Verus Pugnus Venefici",
    "ETHA10_GANONDORF_BODY_SCEPTERSPECIAL_DESCRIPTION": "Onera pugnum validum <style=cIsDamage>1000% damni</style> in hostes propinquos emittens. Incrementum Pugni Venefici nunc fortius est, usque ad summum <style=cIsDamage>2000% damni</style>.",
    "ETHA10_GANONDORF_BODY_SCEPTER_SPECIAL_KICK_NAME": "Vera Securis Infernales",
    "ETHA10_GANONDORF_BODY_SCEPTER_SPECIAL_KICK_DESCRIPTION": "Trahe hostes in exitium, pedem deorsum incutiens et <style=cIsDamage>1100% damni</style> in radio circum te inferens.<color=#D2042D> Sine Super Lorica.</color> Incrementum Securis Infernales nunc fortius est, usque ad summum <style=cIsDamage>2000% damni</style>.",
    "ETHA10_GANONDORF_BODY_SCEPTER_OBLITERATE_SWORD_NAME": "Vera Obliteratio",
    "ETHA10_GANONDORF_BODY_SCEPTER_OBLITERATE_SWORD_DESCRIPTION": "Tolle gladium alte, usque ad <style=cIsDamage>5s</style> onerans ad damnum et spatium augendum. Dimitte ut gladium deorsum iacias, displosiones in partem quam spectas mittens. In basi, displosiones <style=cIsDamage>600%</style> damni inferunt, et usque ad summum <style=cIsDamage>5x</style> per displosionem crescere possunt. Incrementum Obliterandi nunc fortius est, usque ad summum <style=cIsDamage>2000% damni</style>.",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Ganondorf: Peritia",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESCRIPTION": "Ut Ganondorf, vince ludum in Monsoon.",
    "ETHA10_GANONDORF_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Ganondorf: Peritia",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_EIGHTLUNAR_ACHIEVEMENT_NAME": "Ganondorf: Rationes Vetitae",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_EIGHTLUNAR_ACHIEVEMENT_DESCRIPTION": "Ut Ganondorf, collige 8 Res Lunares in uno cursu.",
    "ETHA10_GANONDORF_BODY_EIGHTLUNAR_UNLOCKABLE_NAME": "Ganondorf: Rationes Vetitae",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_TENGRAB_ACHIEVEMENT_NAME": "Ganondorf: Manus Iniecta",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_TENGRAB_ACHIEVEMENT_DESCRIPTION": "Ut Ganondorf, prehende 15 aut plures hostes uno prensu.",
    "ETHA10_GANONDORF_BODY_TENGRAB_UNLOCKABLE_NAME": "Ganondorf: Manus Iniecta",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_HEAVYDAMAGE_ACHIEVEMENT_NAME": "Ganondorf: \"Pugnus\" Gravis Poenae",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_HEAVYDAMAGE_ACHIEVEMENT_DESCRIPTION": "Ut Ganondorf, perfice motum qui plus quam 7,500 damni uno ictu infert.",
    "ETHA10_GANONDORF_BODY_HEAVYDAMAGE_UNLOCKABLE_NAME": "Ganondorf: \"Pugnus\" Gravis Poenae",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_ITEMGATHERER_ACHIEVEMENT_NAME": "Ganondorf: Paratus ad Experimenta",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_ITEMGATHERER_ACHIEVEMENT_DESCRIPTION": "Ut Ganondorf, tene unum fragmentum cuiusque ordinis rerum.",
    "ETHA10_GANONDORF_BODY_ITEMGATHERER_UNLOCKABLE_NAME": "Ganondorf: Paratus ad Experimenta",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASSACRE_ACHIEVEMENT_NAME": "Ganondorf: Lator Malitiae",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASSACRE_ACHIEVEMENT_DESCRIPTION": "Ut Ganondorf: Occide 50 Lemurians, Wisps, Jellyfishes, Beetles, Mini Mushrums et Imps in uno cursu.",
    "ETHA10_GANONDORF_BODY_MASSACRE_UNLOCKABLE_NAME": "Ganondorf: Lator Malitiae",
    "KRONONCONSPIRATOR_SKIN_GANONSPACE_NAME": "Ganondorf"
  }
}