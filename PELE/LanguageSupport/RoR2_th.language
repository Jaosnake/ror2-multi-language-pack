    "EQUIPMENT_AFFIXEARTH_DESC": "???",
    "EQUIPMENT_AFFIXSECRETSPEED_NAME": "เหนือขีดจำกัด",
    "EQUIPMENT_AFFIXSECRETSPEED_PICKUP": "กลายเป็นร่างอวตารแห่งความเร็ว",
