{
    "es-ES": {
        "JAVANGLE_HOUSE_BODY_NAME": "House",
        "JAVANGLE_HOUSE_BODY_DESCRIPTION": "House es un jugador insensato que confía en su suerte para superar situaciones difíciles, usando dos misteriosos artefactos del destino: un revólver de 6 disparos llamado \"Ruleta\" y una baraja de cartas aparentemente maldita.",
        "JAVANGLE_HOUSE_BODY_SUBTITLE": "El Jugador Demente",
        "JAVANGLE_HOUSE_BODY_LORE": "Hablando de tragaperras, acaban de instalar una nueva en el vestíbulo de entretenimiento de la nave, la gente ha estado diciendo que la maldita cosa está viva o algo así, locura de m-... ¡¿Instalaron qué ahora?!",
        "JAVANGLE_HOUSE_BODY_OUTRO_FLAVOR": "Bueno, si no fuera porque mi primer premio fueron estos artefactos, tal vez no habría tirado tanto de esa máquina tragaperras, convirtiendo la maldita cosa en una impresora de dinero, el anfitrión no quedó muy contento, me echaron a patadas, y he estado siendo perseguido por esa misma máquina desde entonces",
        "JAVANGLE_HOUSE_BODY_OUTRO_FAILURE": "¡Vaya, vaya, vaya! Tranquilo ahí, ve despacio ahora, ¿un casino en el vacío? ¿Una máquina tragaperras casi te mata?... Supongo que de ahí sacaste esos artefactos, ¿eh?",
        "JAVANGLE_HOUSE_BODY_DEFAULT_SKIN_NAME": "House",
        "JAVANGLE_HOUSE_BODY_MASTERY_SKIN_NAME": "Mansion",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "House: Maestría",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Como House, completa la partida o desintégrate en Monsoon.",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "House: Maestría",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "House: Gran Maestría",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "Como House, completa la partida o desintégrate en Typhoon.",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "House: Gran Maestría",
        "JAVANGLE_HOUSE_PASSIVE_NAME": "El Juego",
        "JAVANGLE_HOUSE_PASSIVE_DESCRIPTION": "En lugar de <style=cIsUtility>Habilidades</style>, The House usa <style=cIsUtility>Cartas</style>, cada carta tiene un efecto único. Cuando se usa una carta, su ranura entra en recarga, descartas tu mano y robas 3 cartas nuevas.",
        "JAVANGLE_HOUSE_STANDARDSPREAD_NAME": "Mazo: Distribución Estándar",
        "JAVANGLE_HOUSE_STANDARDSPREAD_DESCRIPTION": "Dirige un casino en el vacío, solo Dios sabe cómo consigue clientes allí abajo, lo único que puedo decirte es que definitivamente NO les gusta que dichos clientes salgan con más de lo que entraron, una máquina tragaperras casi me mata. Un mazo simplificado, diseñado para ser fácil de usar.<style=cSub>[Consulta la pestaña Cartas para ver las cartas de este mazo]</style>",
        "JAVANGLE_HOUSE_FULLHOUSE_NAME": "Mazo: Full House",
        "JAVANGLE_HOUSE_FULLHOUSE_DESCRIPTION": "¿Qué dices ahora? La experiencia clásica de House.<style=cSub>[Consulta la pestaña Cartas para ver las cartas de este mazo]</style>",
        "JAVANGLE_HOUSE_DIVINATION_NAME": "Mazo: Adivinación",
        "JAVANGLE_HOUSE_DIVINATION_DESCRIPTION": "Bueno, tuve un encontronazo con ella. Un mazo complejo que te permite controlar la composición de las cartas.<style=cSub>[Consulta la pestaña Cartas para ver las cartas de este mazo]</style>",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_NAME": "BulletArts: Vacío",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_DESCRIPTION": "Je, hablas como si la hubieras conocido. Dispara un tiro cargado al azar. Cuando no te queden disparos: no hace nada.",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_NAME": "BulletArts: Desenfundado Rápido",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_DESCRIPTION": "Dispara <style=cIsUtility>más rápido</style>, pero <style=cArtifact>todos los disparos causan menos daño</style>. Cuando no te queden disparos: no hace nada.",
        "JAVANGLE_HOUSE_RELOADSTANDARD_NAME": "ReloadArts: Estándar",
        "JAVANGLE_HOUSE_RELOADSTANDARD_DESCRIPTION": "Jugar cualquier carta recarga la ruleta.\n50%/25% de probabilidad de obtener 1/2 municiones especiales aleatorias según el tipo de carta usada (rojo = Perforante/Perdigón/Explosivo, morado = Vacío/Serpiente, gris/verde = cualquiera de las anteriores).\n<style=cSub>[Consulta la pestaña Cartas para ver los disparos y sus efectos]</style>",
        "JAVANGLE_HOUSE_RELOADALLIN_NAME": "ReloadArts: All-In",
        "JAVANGLE_HOUSE_RELOADALLIN_DESCRIPTION": "... ¡vaya por Dios! Las cartas parecen tener un inmenso poder y producen efectos extraños, y por más que lo intente, nunca puedo robar más hasta que uso una. Jugar cualquier carta recarga la ruleta. Carga de 0 a 6 disparos Perforante/Postas/Explosivo, <style=cArtifact>todos los disparos restantes son Serpiente</style>.<style=cSub>[Consulta la pestaña Cartas para ver los Disparos y sus efectos]</style>",
        "JAVANGLE_HOUSE_CARDARTSHOP_NAME": "CardArts: Salto",
        "JAVANGLE_HOUSE_CARDARTSHOP_DESCRIPTION": "Jugar cualquier carta mientras estás en el aire te impulsará hacia adelante.",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_NAME": "CardArts: Barrido",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_DESCRIPTION": "Jugar cualquier carta: lanza la carta hacia adelante, infligiendo <style=cIsDamage>{0}% de daño</style> a los enemigos en alcance cuerpo a cuerpo y <style=cIsUtility>obtiene una barrera igual al {1}% de tu salud máxima</style> por cada enemigo golpeado.",
        "JAVANGLE_HOUSE_SHUFFLEART_NAME": "ShuffleArts: Ouroboros",
        "JAVANGLE_HOUSE_SHUFFLEART_DESCRIPTION": "Descarta tu mano actual y roba 3 cartas nuevas.",
        "JAVANGLE_HOUSE_STANDARDSHOT_NAME": "Disparo Estándar",
        "JAVANGLE_HOUSE_STANDARDSHOT_DESCRIPTION": "Dispara un proyectil estándar que inflige <style=cIsDamage>{0}% de daño</style>.",
        "JAVANGLE_HOUSE_PIERCINGSHOT_NAME": "Disparo Perforante",
        "JAVANGLE_HOUSE_PIERCINGSHOT_DESCRIPTION": "Dispara un proyectil especial que atraviesa objetivos infligiendo <style=cIsDamage>{0}% de daño</style> a cada uno.",
        "JAVANGLE_HOUSE_BUCKSHOT_NAME": "Disparo de Postas",
        "JAVANGLE_HOUSE_BUCKSHOT_DESCRIPTION": "Dispara una ráfaga de escopeta infligiendo <style=cIsDamage>{0}% x {1} de daño</style>.",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_NAME": "Disparo Explosivo",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_DESCRIPTION": "Dispara un proyectil explosivo que inflige <style=cIsDamage>{0}% de daño</style> en área de efecto.",
        "JAVANGLE_HOUSE_SNAKESHOT_NAME": "Disparo Serpiente",
        "JAVANGLE_HOUSE_SNAKESHOT_DESCRIPTION": "Intenta disparar, <style=cSub>falla</style> y recibes <style=cDeath>{0}% de tu salud máxima como daño</style>.",
        "JAVANGLE_HOUSE_BLANKSHOT_NAME": "Disparo en Falso",
        "JAVANGLE_HOUSE_BLANKSHOT_DESCRIPTION": "Intenta disparar, <style=cSub>falla</style> y haces el ridículo.",
        "JAVANGLE_HOUSE_MYSTERYSHOT_NAME": "Disparo Misterioso",
        "JAVANGLE_HOUSE_MYSTERYSHOT_DESCRIPTION": "Dispara un tiro especial aleatorio (excepto Disparo Serpiente).",
        "JAVANGLE_HOUSE_ACESHOT_NAME": "Disparo de As",
        "JAVANGLE_HOUSE_ACESHOT_DESCRIPTION": "Carga un disparo gigantesco que inflige <style=cIsDamage>{0}% de daño</style> a todos los enemigos frente a ti, alcanzando a cualquier distancia e incluso a través de paredes.",
        "JAVANGLE_HOUSE_7CLUBS_NAME": "7 de Tréboles",
        "JAVANGLE_HOUSE_7CLUBS_DESCRIPTION": "Carga <style=cIsUtility>3 Disparos Misteriosos</style> en la ruleta.\nAdemás, <style=cIsUtility>Garantiza</style> que tu próximo disparo será un Disparo Explosivo.",
        "JAVANGLE_HOUSE_7SPADES_NAME": "7 de Picas",
        "JAVANGLE_HOUSE_7SPADES_DESCRIPTION": "Obtén <style=cIsUtility>Velocidad de Movimiento Aumentada</style> así como <style=cIsUtility>2 mejoras completamente aleatorias</style> durante {0} segundos.\nAdemás, <style=cIsUtility>Garantiza</style> que tu próximo disparo será un Disparo Explosivo.",
        "JAVANGLE_HOUSE_7DIAMONDS_NAME": "7 de Diamantes",
        "JAVANGLE_HOUSE_7DIAMONDS_DESCRIPTION": "<style=cShrine>Obtén Oro</style> <style=cSub>(escala con los costes de los cofres)</style>.",
        "JAVANGLE_HOUSE_7HEARTS_NAME": "7 de Corazones",
        "JAVANGLE_HOUSE_7HEARTS_DESCRIPTION": "<style=cIsHealing>Cura un 25% de tu salud máxima</style>.\nAdemás, <style=cIsUtility>Garantiza</style> que tu próximo disparo será un Disparo Perforante.",
        "JAVANGLE_HOUSE_JACKPOT_NAME": "Bote",
        "JAVANGLE_HOUSE_JACKPOT_DESCRIPTION": "Activa aleatoriamente los efectos de ''7 de Tréboles'', ''7 de Diamantes'', ''7 de Corazones'' o ''7 de Picas'' con el doble de efecto, 20% de probabilidad de <style=cIsUtility>activarlos todos a la vez</style>.",
        "JAVANGLE_HOUSE_52_NAME": "Recoge 52",
        "JAVANGLE_HOUSE_52_DESCRIPTION": "Lanza cartas en todas direcciones infligiendo <style=cIsDamage>daño a todos los enemigos cercanos</style>.",
        "JAVANGLE_HOUSE_SNAKE_NAME": "Ojos de Serpiente",
        "JAVANGLE_HOUSE_SNAKE_DESCRIPTION": "<style=cArtifact>Carga 2 Disparos Serpiente</style> en la ruleta o recibe <style=cDeath>daño</style>.\n<style=cArtifact>Si la ruleta está llena</style>, recibe <style=cDeath>daño masivo</style>.\n<style=cArtifact>Si la ruleta no contiene Disparos Serpiente</style>, recibe <style=cDeath>daño letal</style>.\n<style=cIsUtility>Otorga oro proporcional al riesgo</style>.",
        "JAVANGLE_HOUSE_BUST_NAME": "Pasarse",
        "JAVANGLE_HOUSE_BUST_DESCRIPTION": "<style=cDeath>Pierde {0} de salud</style>, inflige <style=cIsDamage>{1}% de daño</style> a los enemigos cercanos.",
        "JAVANGLE_HOUSE_SWORDS_NAME": "10 de Espadas",
        "JAVANGLE_HOUSE_SWORDS_DESCRIPTION": "Dispara 10 proyectiles de espada hacia adelante, empalando a los enemigos e infligiendo sangrado.",
        "JAVANGLE_HOUSE_COINS_NAME": "5 de Monedas",
        "JAVANGLE_HOUSE_COINS_DESCRIPTION": "<style=cArtifact>Obtén {0} moneda(s)</style>, inflige <style=cIsDamage>{1}% de daño</style> a los enemigos cercanos.",
        "JAVANGLE_HOUSE_TOWER_NAME": "La Torre",
        "JAVANGLE_HOUSE_TOWER_DESCRIPTION": "<style=cArtifact>Carga 3 Disparos Serpiente</style> en la ruleta o recibe <style=cDeath>daño</style>.\n<style=cArtifact>Si la ruleta está llena</style>, recibe <style=cDeath>daño masivo</style>.\n<style=cArtifact>Si la ruleta no contiene Disparos Serpiente</style>, recibe <style=cDeath>daño letal</style>.\n<style=cIsUtility>Otorga daño y armadura adicionales</style>.",
        "JAVANGLE_HOUSE_JOKER_NAME": "Comodín",
        "JAVANGLE_HOUSE_JOKER_DESCRIPTION": "1/6 de probabilidad de <style=cArtifact>morir</style>, 4/6 de probabilidad de no hacer nada y otorgar el máximo de acumulaciones de 'Apuesta', 1/6 de probabilidad de <style=cArtifact>aniquilar todo en el mapa</style>, otorgar objetos y revivir jugadores muertos.\n<style=cSub>(La rareza y cantidad de objetos aumenta con el número de fases completadas)</style>",
        "JAVANGLE_HOUSE_7JACK_NAME": "Sota de Diamantes",
        "JAVANGLE_HOUSE_7JACK_DESCRIPTION": "Carga 6 disparos estándar.\nSi estás en el suelo: se desliza hacia adelante.",
        "JAVANGLE_HOUSE_7QUEEN_NAME": "Reina de Corazones",
        "JAVANGLE_HOUSE_7QUEEN_DESCRIPTION": "Temporalmente <style=cIsUtility>mejora 2 estadísticas aleatorias</style>, pero <style=cArtifact>reduce otras 2 estadísticas aleatorias</style>.",
        "JAVANGLE_HOUSE_7KING_NAME": "Rey de Tréboles",
        "JAVANGLE_HOUSE_7KING_DESCRIPTION": "Carga un Disparo Explosivo, Perforante, de Postas, Serpiente, en Falso y Misterioso.",
        "JAVANGLE_HOUSE_7ACE_NAME": "As de Picas",
        "JAVANGLE_HOUSE_7ACE_DESCRIPTION": "No carga nada excepto 1 disparo único que inflige <style=cIsDamage>{0}% de daño</style> tras un largo retraso.",
        "JAVANGLE_HOUSE_WILDCARD_NAME": "Carta Comodín",
        "JAVANGLE_HOUSE_WILDCARD_DESCRIPTION": "Hace algo impredecible. Podría ser bueno, podría ser malo, podría no ser ninguno... ¿quizás ambos?\n<style=cIsUtility>[Indestructible]</style>",
        "JAVANGLE_HOUSE_RROULETTE_NAME": "Ruleta Rusa",
        "JAVANGLE_HOUSE_RROULETTE_DESCRIPTION": "Dispara proyectiles cargados de la ruleta en rápida sucesión.\nAdemás, <style=cIsUtility>Transforma aleatoriamente</style> hasta {0} disparos en la ruleta en <style=cIsUtility>munición especial positiva</style>.",
        "JAVANGLE_HOUSE_FORTUNE_NAME": "Ruleta de la Fortuna",
        "JAVANGLE_HOUSE_FORTUNE_DESCRIPTION": "50% de probabilidad de <style=cShrine>duplicar el oro actual</style>, 50% de probabilidad de <style=cArtifact>perder todo el oro</style> y <style=cIsUtility>tirar por un objeto aleatorio</style> según el oro perdido.",
        "JAVANGLE_HOUSE_THREEOFAKIND_NAME": "Trío",
        "JAVANGLE_HOUSE_THREEOFAKIND_DESCRIPTION": "Roba y <style=cIsUtility>juega toda la mano siguiente</style> de una sola vez.",
        "JAVANGLE_HOUSE_GCLUBS_NAME": "Tréboles",
        "JAVANGLE_HOUSE_GCLUBS_DESCRIPTION": "Carga <style=cIsUtility>3 Disparos Positivos aleatorios</style> en la ruleta.\nAdemás, <style=cIsUtility>Garantiza</style> que tu próximo disparo será un Disparo Explosivo.",
        "JAVANGLE_HOUSE_GSPADES_NAME": "Picas",
        "JAVANGLE_HOUSE_GSPADES_DESCRIPTION": "Obtén <style=cIsUtility>Velocidad de Movimiento Aumentada</style> durante {0} segundos\nAdemás, <style=cIsUtility>Garantiza</style> que tu próximo disparo será un Disparo Perforante.",
        "JAVANGLE_HOUSE_GHEARTS_NAME": "Corazones",
        "JAVANGLE_HOUSE_GHEARTS_DESCRIPTION": "<style=cIsHealing>Cura un 50% de tu salud máxima</style>",
        "JAVANGLE_HOUSE_GJACK_NAME": "Sota",
        "JAVANGLE_HOUSE_GJACK_DESCRIPTION": "No hace nada.",
        "JAVANGLE_HOUSE_CRAZYCARD_NAME": "Carta Loca",
        "JAVANGLE_HOUSE_CRAZYCARD_DESCRIPTION": "Activa otra carta del Mazo Estándar al azar.",
        "JAVANGLE_HOUSE_CASHOUT_NAME": "Retirada",
        "JAVANGLE_HOUSE_CASHOUT_DESCRIPTION": "1/3 de probabilidad de <style=cArtifact>perder todo el dinero</style>, 1/3 de probabilidad de no hacer nada, 1/3 de probabilidad de <style=cIsDamage>dañar a todos los enemigos en el mapa</style> y <style=cIsUtility>otorgar un objeto temporal</style>.\n<style=cSub>(El daño y la rareza del objeto escalan con el dinero arriesgado)</style>",
        "JAVANGLE_HOUSE_THESUN_NAME": "El Sol",
        "JAVANGLE_HOUSE_THESUN_DESCRIPTION": "<style=cIsUtility>Crea un duplicado de cada una de las demás cartas de la mano</style> y las roba en la siguiente mano.\n<style=cSub>(No funciona en cartas 'Indestructibles')</style>.\n<style=cSub>(Este efecto no puede ser activado por otras cartas)</style>.",
        "JAVANGLE_HOUSE_THEMOON_NAME": "La Luna",
        "JAVANGLE_HOUSE_THEMOON_DESCRIPTION": "<style=cIsUtility>Destruye cada una de las demás cartas de la mano</style>, eliminándolas del mazo.\n<style=cSub>(No funciona en cartas 'Indestructibles')</style>.\n<style=cSub>(Este efecto no puede ser activado por otras cartas)</style>.",
        "JAVANGLE_HOUSE_THESTAR_NAME": "La Estrella",
        "JAVANGLE_HOUSE_THESTAR_DESCRIPTION": "<style=cIsUtility>Destruye todas las cartas 'El Sol', 'La Luna', 'La Estrella' y 'El Mundo'</style> de la pila de robo, la mano y la pila de descarte, eliminándolas del mazo.<style=cSub>(Este efecto no puede ser activado por otras cartas)</style>.",
        "JAVANGLE_HOUSE_THEWORLD_NAME": "El Mundo",
        "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION": "<style=cIsUtility>Destruye todas las cartas 'El Sol', 'La Luna', 'La Estrella' y 'El Mundo'</style> de la pila de robo, la mano y la pila de descarte, eliminándolas del mazo.\n<style=cSub>(Este efecto no puede ser activado por otras cartas)</style>.",
        "JAVANGLE_HOUSE_JUDGEMENT_NAME": "Juicio",
        "JAVANGLE_HOUSE_JUDGEMENT_DESCRIPTION": "<style=cIsUtility>Reemplaza completamente el mazo por la versión original</style>, deshaciendo cualquier cambio que se le haya hecho. <style=cSub>(como si hubieras reaparecido o cambiado de fase)</style>\n<style=cSub>(Este efecto no puede ser activado por otras cartas)</style>.\n<style=cIsUtility>[Indestructible]</style>",
        "JAVANGLE_HOUSE_KINGOFWANDS_NAME": "Rey de Bastos",
        "JAVANGLE_HOUSE_KINGOFWANDS_DESCRIPTION": "<style=cIsUtility>Consume hasta acumulaciones de 'Apuesta'</style>, y <style=cIsHealing>proporciona hasta % de curación</style> según la cantidad de 'Apuesta' gastada.\n<style=cIsHealing>Todos los aliados controlados se curan la mitad de esa cantidad</style>.",
        "JAVANGLE_HOUSE_QUEENOFCUPS_NAME": "Reina de Copas",
        "JAVANGLE_HOUSE_QUEENOFCUPS_DESCRIPTION": "<style=cIsUtility>Consume hasta acumulaciones de 'Apuesta'</style>, y proporciona una mejora que permite a House <style=cIsUtility>disparar proyectiles cargados sin gastarlos</style>.\nEsta mejora dura hasta segundos, según la cantidad de 'Apuesta' gastada.",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_NAME": "Caballero de Espadas",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_DESCRIPTION": "<style=cIsUtility>Consume hasta acumulaciones de 'Apuesta'</style>, y <style=cIsUtility>carga una cantidad de disparos positivos</style> igual a la cantidad de 'Apuesta' gastada.\nAdemás, <style=cIsUtility>Garantiza</style> que tu próximo disparo será un Disparo Explosivo.",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_NAME": "Sota de Oros",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_DESCRIPTION": "<style=cIsUtility>Consume hasta acumulaciones de 'Apuesta'</style>, e invoca Quimeras Lunares para luchar por ti; cuanta más 'Apuesta' gastes, mayor será la fuerza invocada.\nCon acumulaciones gastadas, esta carta invocará a un superviviente aleatorio en su lugar",
        "JAVANGLE_HOUSE_ANTEUP_NAME": "¡Sube la Apuesta!",
        "JAVANGLE_HOUSE_ANTEUP_DESCRIPTION": "<style=cIsUtility>Otorga acumulaciones de 'Apuesta'</style>.\nCada acumulación de Apuesta reduce la armadura y aumenta la velocidad de movimiento y de ataque",
        "JAVANGLE_HOUSE_ANCIENTACE_NAME": "As Ancestral",
        "JAVANGLE_HOUSE_ANCIENTACE_DESCRIPTION": "Carga <style=cIsUtility>6 Disparos Misteriosos</style> en la ruleta.\nAdemás, <style=cIsUtility>Otorga uno de los siguientes efectos</style>.\n<style=cIsUtility>Parejas</style>: Cada carta que juegues se activa dos veces\n<style=cIsUtility>Color</style>: Cada vez que juegues una carta, juega el resto de tu mano (omitiendo cartas negativas y aleatorias)\n<style=cIsUtility>Copas</style>: Disparar la Ruleta ya no cuesta Munición\n<style=cIsUtility>[Indestructible]</style>",
        "ARTIFACT_OF_WILDROOM_NAME": "Artifact of Wildroom",
        "ARTIFACT_OF_WILDROOM_DESCRIPTION": "Invoca un Wildroom al comienzo de cada fase.\nWildroom ya no puede eliminarse y ahora afecta a los jugadores que no juegan con House.",
        "JAVANGLE_HOUSE_NULL_NAME": "Nulo",
        "JAVANGLE_HOUSE_NULL_DESCRIPTION": "No hace nada, ni siquiera recarga.\nLo lograste, lo destruiste todo, lo redujiste a la nada, y ahora la nada es todo lo que queda... ¿eres feliz..?"
    }
}