    "ROB_NEMESIS_BODY_PASSIVE_NAME": "Ultimative Lebensform",
    "ROB_NEMESIS_BODY_PASSIVE_DESCRIPTION": "<style=cIsDamage>Schaden zu verursachen</style> speichert <style=cIsHealth>Biomasse</style> und verstärkt deinen <style=cIsDamage>Schaden</style>, wenn sie voll ist. Sprünge können für <style=cIsUtility>gewaltige Sätze</style> <style=cIsDamage>aufgeladen</style> werden.",
    "ROB_NEMESIS_BODY_PASSIVE2_NAME": "Biologische Bewaffnung",
    "ROB_NEMESIS_BODY_PASSIVE2_DESCRIPTION": "Der Nemesis T-Type kann <style=cIsHealth>mutieren</style>, indem er <style=cIsDamage>Zielpersonen</style> verschlingt, und erhält so <style=cIsDamage>neue und verbesserte Fertigkeiten</style>.",
    "ROB_NEMESIS_BODY_PASSIVE22_NAME": "Muskelmasse-Schub",
