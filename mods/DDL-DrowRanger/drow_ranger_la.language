{
    "la": {
        "DROWRANGER_NAME": "Drow Ranger",
        "DROWRANGER_SUBTITLE": "Sagittaria Gelida",
        "DROWRANGER_SKIN_DEFAULT_NAME": "Drow Ranger",
        "DROWRANGER_SKIN_ARCANA_NAME": "Ultio Formidolosa",
        "DROWRANGER_DESCRIPTION": "Drow Ranger spatio moderando et munitionibus hostium sagittis mortiferis perrumpendis excellit.<style=cSub>\n\n< ! >Hostes eminus retine ut Peritiam Sagittandi optime adhibeas. Sagittae eius lente volant, ergo accurate intende ut scopos remotos ferias.\n\n< ! >Sagittae Gelidae hostes periculosos retardant. Hypothermia turbas in catenatas explosiones vertit.\n\n< ! >Flatus spatium ad recedendum creat, dum Glacies speculam temporariam praebet.\n\n< ! >Elige reliquiam singularem ad spatium sagittarum, salutem vel ictus criticos augendos.</style>",
        "DROWRANGER_OUTRO_FLAVOR": "Traxex deserta congelata post se relinquit.",
        "DROWRANGER_OUTRO_FAILURE": "Gelu alteram venatricem vindicat.",
        "DROWRANGER_RELIC_TITLE": "Reliquia Singularis",
        "DROWRANGER_PIKE_NAME": "Hurricane Pike",
        "DROWRANGER_PIKE_DESC": "Sagittae primariae plenum vulnus intra <style=cIsUtility>50m</style> infligunt, <style=cIsDamage>75%</style> ultra <style=cIsUtility>100m</style> retinentes. Ictus <style=cIsUtility>respellunt</style> hostes non-custodes intra <style=cIsUtility>12m</style>. Omnia missilia sagittarum <style=cIsUtility>50% celerius</style> volant.",
        "DROWRANGER_BUTTERFLY_NAME": "Butterfly",
        "DROWRANGER_BUTTERFLY_DESC": "Celeritatem impetus per <style=cIsDamage>20%</style> auget. Concedit <style=cIsHealing>30% facultatem arcendi vulneris</style>. Cum Temporibus Difficilioribus cum reditibus decrescentibus cumulatur.",
        "DROWRANGER_DAEDALUS_NAME": "Daedalus",
        "DROWRANGER_DAEDALUS_DESC": "Concedit <style=cIsDamage>30% facultatem ictus critici</style>. Ictus critici <style=cIsDamage>225% vulneris</style> infligunt, ante alia additamenta ictus critici.",
        "DROWRANGER_PRIMARY_NAME": "Sagittae Gelidae",
        "DROWRANGER_PRIMARY_DESC": "<style=cIsUtility>Gelu</style>. Iace sagittam pro <style=cIsDamage>260% vulneris</style>.",
        "DROWRANGER_HYPOTHERMIA_NAME": "Hypothermia",
        "DROWRANGER_HYPOTHERMIA_DESC": "<style=cIsDamage>Hypothermia</style>. Iace sagittam pro <style=cIsDamage>260% vulneris</style>. Hostes affecti morientes explodunt.",
        "DROWRANGER_SECONDARY_NAME": "Multisagittatio",
        "DROWRANGER_SECONDARY_DESC": "Iace <style=cIsDamage>3 undas</style> sagittarum penetrantium pro <style=cIsDamage>3x360% vulneris</style>. Quaeque unda effectum sagittae selectae adhibet. Celeritas impetus tempus canalizandi dimidia efficacitate minuit.",
        "DROWRANGER_UTILITY_NAME": "Flatus",
        "DROWRANGER_UTILITY_DESC": "<style=cIsDamage>Stupefaciens</style>. Emitte flatum qui <style=cIsUtility>hostes respellit</style> et <style=cIsUtility>3 acervos</style> effectus sagittae tuae adhibet. Concede <style=cIsUtility>50% celeritatem motus</style> pro <style=cIsUtility>4s</style>, et retrorsum desili si non curris.",
        "DROWRANGER_GLACIER_NAME": "Glacies",
        "DROWRANGER_GLACIER_DESC": "Attolle excelsam <style=cIsUtility>glaciem</style> sub te pro <style=cIsUtility>8s</style>, te ad summum levans et <style=cIsUtility>hostes propinquos respellens</style>.",
        "DROWRANGER_SPECIAL_NAME": "Peritia Sagittandi",
        "DROWRANGER_SPECIAL_DESC": "<style=cIsUtility>Passivum</style>: Nullis hostibus intra <style=cIsUtility>15m</style> existentibus, sagittae primariae <style=cIsDamage>30%</style> facultatem habent fiendi <style=cIsDamage>sagittae loricam penetrantes</style> pro <style=cIsDamage>390% vulneris</style>.\n<style=cIsUtility>Activa</style>: Hanc facultatem ad <style=cIsDamage>100%</style> pro <style=cIsUtility>5s</style> auge, vel ad <style=cIsDamage>50%</style> cum hostibus propinquis.",
        "DROWRANGER_WINTER_NAME": "Ictus Hiemalis",
        "DROWRANGER_WINTER_DESC": "Arcum breviter intende, deinde emitte <style=cIsDamage>sagittam loricam penetrantem</style> pro <style=cIsDamage>1600% vulneris</style>, usque ad <style=cIsDamage>5 hostes</style> perforans et <style=cIsUtility>10 acervos</style> effectus sagittae tuae adhibens. Intentio voluntarie revocari non potest.",
        "DROWRANGER_KEYWORD_FROST": "<style=cKeywordName>Gelu</style><style=cSub>Celeritatem motus residuam per 15% pro acervo per 3s minuit. Usque ad 10 vices cumulatur. Ictus omnes acervos renovant. Hostes omnino non congelat.</style>",
        "DROWRANGER_KEYWORD_HYPOTHERMIA": "<style=cKeywordName>Hypothermia</style><style=cSub>Usque ad 10 vices per 7s cumulatur. In morte, explodet pro 150%–600% vulneris intra radium 2–12m secundum acervos. Explosiones Hypothermiam spargunt et catenatim propagari possunt. Hostes non retardat.</style>",
        "DROWRANGER_KEYWORD_RANGE": "<style=cKeywordName>Sagittae distantia</style><style=cSub>Vulnus sagittae primariae ultra 40m decrescit, 60% ad 80m retinens. Hurricane Pike hoc spatium extendit.</style>",
        "DROWRANGER_KEYWORD_ARMOR": "<style=cKeywordName>Loricam penetrans</style><style=cSub>Loricam positivam ignorat. Ictum criticum inferre potest et effectum sagittae selectae retinet.</style>"
    }
}