{
  "es-419": {
    "CI_EXPANSION_NAME": "Caeli Imperium",
    "CI_EXPANSION_DESC": "Agrega contenido de la expansión 'Caeli Imperium' al juego.",
    "CI_HEALRECEIVEDDAMAGE_NAME": "Tratamiento Médico de Emergencia",
    "CI_HEALRECEIVEDDAMAGE_PICKUP": "Cura el daño recibido a lo largo del tiempo.",
    "CI_HEALRECEIVEDDAMAGE_DESC": "Al <style=cIsDamage>recibir daño</style>, <style=cIsHealing>cúrate</style> un 20% <style=cStack>(+5% por acumulación)</style> del <style=cIsDamage>daño recibido</style> a lo largo de 15 segundos <style=cStack>(-15% por acumulación)</style>.",
    "CI_HEALRECEIVEDDAMAGE_LORE": "",
    "CI_INFINITESECONDARYSKILLCHARGES_NAME": "Cargador Infinito",
    "CI_INFINITESECONDARYSKILLCHARGES_PICKUP": "Aumenta el daño de tu habilidad Secundaria y obtén cargas infinitas. Convierte el exceso de cargas en daño adicional de la habilidad Secundaria.",
    "CI_INFINITESECONDARYSKILLCHARGES_DESC": "Usa la <style=cIsUtility>habilidad Secundaria</style> sin requisito mínimo de cargas. Consume todas las cargas de la <style=cIsUtility>habilidad Secundaria</style> al ejecutarla, aumentando el <style=cIsDamage>daño</style> de la <style=cIsUtility>habilidad Secundaria</style> en un <style=cIsDamage>100%</style> por cada carga consumida. El <style=cIsDamage>daño</style> adicional de la <style=cIsUtility>habilidad Secundaria</style> <style=cDeath>desaparece</style> al infligir cualquier <style=cIsDamage>daño</style> con la <style=cIsUtility>habilidad Secundaria</style>. Aumenta el <style=cIsDamage>daño</style> de la <style=cIsUtility>habilidad Secundaria</style> en un <style=cIsDamage>100%</style> <style=cStack>(+100% por acumulación)</style>.",
    "CI_INFINITESECONDARYSKILLCHARGES_LORE": "",
    "CI_DRAWSPEEDPATH_NAME": "Tiza",
    "CI_DRAWSPEEDPATH_PICKUP": "Dibuja un camino al moverte que aumenta la velocidad de movimiento y otorga vuelo.",
    "CI_DRAWSPEEDPATH_DESC": "Dibuja un camino al moverte. Mientras estés en este camino, aumenta la <style=cIsUtility>velocidad de movimiento</style> en un <style=cIsUtility>50%</style> <style=cStack>(+50% por acumulación)</style> y <style=cIsUtility>obtén vuelo</style>. Longitud máx. del camino: 512  <style=cStack>(+128 por acumulación)</style>.",
    "CI_DRAWSPEEDPATH_LORE": "",
    "CI_BRIBEENEMIESANDBUFFMINIONS_NAME": "Mano Majestuosa",
    "CI_BRIBEENEMIESANDBUFFMINIONS_PICKUP": "Soborna a los enemigos cercanos. Potencia a todos los esbirros.",
    "CI_BRIBEENEMIESANDBUFFMINIONS_DESC": "Los enemigos dentro del alcance de interacción pueden ser sobornados. .",
    "CI_BRIBEENEMIESANDBUFFMINIONS_LORE": "",
    "CI_BOMBERWISP_BODY_NAME": "Fuego Fatuo Bombardero",
    "CI_MONSTERCHEST_POPUP_TEXT": "<b>Cofre Monstruo</b>\n<i>Aliméntame</i>",
    "CI_MONSTERCHEST_SPEW": "Escupir objeto de jefe",
    "CI_MONSTERCHEST_TITLE": "Cofre Monstruo",
    "CI_MONSTERCHEST_CONTEXT": "Alimentarlo",
    "CI_MONSTERCHEST_DESC": "Permite a los sobrevivientes sacrificar objetos a cambio de un objeto de jefe.",
    "CI_MONSTERCHEST_CANSPEW": "El objeto de jefe puede ser escupido",
    "CI_GAMBIT_NAME": "Gambito",
    "CI_GAMBIT_MESSAGE_FIRSTEXTRACTORCALL1": "Los escáneres localizaron varios depósitos enormes de materiales ricos en líquidos. Para extraerlos, utiliza una refinería que puedas instalar. Para construir tuberías, presiona el botón de Interacción cerca del punto final de la tubería para crear un holograma de colocación. Presiona el botón de Interacción de nuevo para construir la tubería si el holograma es verde, o cancelar la colocación si el holograma es rojo. Localiza los pozos, instala las tuberías y bombea todo de vuelta a la refinería. Cuantas más tuberías instales, mayor será tu paga",
    "CI_GAMBIT_MESSAGE_FIRSTEXTRACTORCALL2": "Marcaste objetivos en varios pozos profundos de materiales ricos. Te envío una refinería móvil para que la llenes. Para extraerlos, utiliza una refinería que puedas instalar. Para construir tuberías, presiona el botón de Interacción cerca del punto final de la tubería para crear un holograma de colocación. Presiona el botón de Interacción de nuevo para construir la tubería si el holograma es verde, o cancelar la colocación si el holograma es rojo. Instala todo el sistema, ponlo en marcha y vaciemos esos depósitos. Es hora de construir algunas tuberías, sobrevivientes",
    "CI_REFINERY_OBJECTIVE_COMPLETED": "La <style=cHumanObjective>Refinería Local</style> se ha completado. Reclama tu premio en el sitio",
    "CI_REFINERY_OBJECTIVE_SABOTAGE": "¡{0} tuberías necesitan reparación!",
    "CI_REFINERY_OBJECTIVE_RUNNING": "Espera a que la <style=cHumanObjective>Refinería Local</style> termine ({0}%)",
    "CI_REFINERY_OBJECTIVE_BUILDING_FIRST": "Construye tuberías. Se deben construir al menos {2} tuberías para iniciar la <style=cHumanObjective>Refinería Local</style> ({0}/{1})",
    "CI_REFINERY_OBJECTIVE_BUILDING": "Construye tuberías. La <style=cHumanObjective>Refinería Local</style> se puede iniciar ({0}/{1})",
    "CI_REFINERY_OBJECTIVE_READY": "La <style=cHumanObjective>Refinería Local</style> está lista para iniciar",
    "CI_REFINERY_TITLE": "Refinería Local",
    "CI_REFINERY_DESC": "Equipo de Gambito para extraer materiales valiosos del planeta. Llama a los extractores en los pozos de recursos, construye y conecta tuberías a los extractores, inicia la refinería, repara las tuberías y reclama tu recompensa de objeto.",
    "CI_REFINERY_CONTEXT": "Iniciar Refinería Local",
    "CI_PIPELINE_BUILD_CONTEXT": "Construir",
    "CI_PIPELINE_REPAIR_CONTEXT": "Reparar",
    "CI_PIPELINE_CANCEL_CONTEXT": "Cancelar Construcción",
    "CI_RESOURCEWELL_CONTEXT": "Llamar Extractor",
    "CI_PIPELINEVEHICLE_EXIT": "Deslizarse hacia afuera",
    "CI_BUILDER_ANGLE": "Ángulo:",
    "CI_BUILDER_DISTANCE": "Distancia:",
    "CI_BUILDER_ERROR": "ERROR",
    "CI_BUILDER_COLLISION": "Colisión",
    "CI_BUILDER_COLLIDES_VALID": "No",
    "CI_BUILDER_COLLIDES_INVALID": "Sí",
    "CI_BISHOP_SPEAR_THROW": "Lanzar",
    "CI_BISHOP_SPEAR_SLAM": "Golpe brusco",
    "CI_BISHOP_SPEAR_CHAIN": "WIP",
    "CI_DIFFICULTY_HURTMEPLENTY_NAME": "Hurt Me Plenty",
    "CI_DIFFICULTY_HURTMEPLENTY_DESC": "¡Así es como se debe jugar como Doomguy! Derrota al Jefe Final Principal como Doomguy para desbloquear esta dificultad para todos los sobrevivientes y desbloquear el resto de las dificultades para Doomguy (por ahora esta función aún no está implementada).<style=cStack>\n\nVelocidad de proyectiles de monstruos: <style=cIsHealing>-35%</style>\nAltura de vuelo de monstruos: <style=cIsHealing>8m</style>\nÉlites: <style=cIsHealing>Eliminados</style>\nRetroceso: <style=cIsDamage>Eliminado</style>\nDrones, objetos y equipamiento: <style=cIsDamage>Reorganizados</style>. <style=cIsHealth>-75% de daño. No pueden aturdir, electrocutar, inmovilizar ni congelar</style>\nMonstruos: <style=cIsHealth>No atacan a los esbirros</style>\nSalud de monstruos pesados: <style=cIsHealth>+60%</style>\nSalud de monstruos jefes: <style=cIsHealth>+120%</style>\nImpresoras y desguazadoras: <style=cIsHealth>Eliminadas</style>\nObjetos del Vacío y Lunares: <style=cIsHealth>Eliminados</style>\nMonstruos débiles: <style=cIsHealth>Eliminados</style>\nAturdimiento por golpe: <style=cIsHealth>Eliminado</style></style>",
    "CI_DOOMGUY_BODY_NAME": "Doomguy",
    "CI_DOOMGUY_BODY_SUBTITLE": "Tipo condenado o tipo de la perdición o algo así no sé",
    "CI_DOOMGUY_NAME": "Doomguy",
    "CI_DOOMGUY_DESC": "¡Él es el Doomguy!",
    "CI_DOOMGUY_SHOTGUN_NAME": "Escopeta de Combate",
    "CI_DOOMGUY_SHOTGUN_DESC": "Dispara perdigones que infligen <style=cIsDamage>5x120% de daño</style>",
    "CI_DOOMGUY_SPEAR_NAME": "Tajo de Lanza",
    "CI_DOOMGUY_SPEAR_DESC": "Blande la lanza para infligir un <style=cIsDamage>200% de daño</style>. <style=cIsUtility>Bloquea</style> ataques y proyectiles entrantes <style=cIsHealing>bloqueables</style>. Obtén <style=cDeath>potenciación</style> y <style=cIsUtility>reduce el enfriamiento</style> de tu habilidad de Utilidad al lograr un <style=cIsHealing>bloqueo exitoso</style>",
    "CI_DOOMGUY_ACCELERATOR_NAME": "Acelerador de Plasma",
    "CI_DOOMGUY_ACCELERATOR_DESC": "Dispara un proyectil de plasma que inflige un <style=cIsDamage>50% de daño</style>. El fuego continuo sobrecargará el acelerador y aumentará el daño del proyectil de plasma a un <style=cIsDamage>125% de daño</style>. Libera la sobrecarga al soltar el gatillo e inflige un <style=cIsDamage>500% de daño</style>",
    "CI_DOOMGUY_DASH_NAME": "Impulso",
    "CI_DOOMGUY_DASH_DESC": "<style=cIsUtility>Impúlsate</style> hacia la dirección de movimiento",
    "CI_DOOMGUY_SPEARSPECIAL_NAME": "Potenciación de Lanza",
    "CI_DOOMGUY_SPEARSPECIAL_DESC": "Prepara la lanza para su <style=cDeath>potenciación</style>. Consume 5 de <style=cDeath>potenciación</style> al usarse.\n\nPrimaria: Lanza la lanza para infligir un <style=cIsDamage>2000% de daño</style>. Inflige <style=cIsDamage>golpe crítico</style> y <style=cIsDamage>superaturdimiento</style> con tiros a la cabeza.\n\nSecundaria: WIP\n\nUtilidad: Salta hacia abajo infligiendo un <style=cIsDamage>700% de daño</style> en un <style=cIsUtility>radio de 24 metros</style>",
    "CI_DOOMGUY_PUNCH_NAME": "Puñetazo",
    "CI_DOOMGUY_PUNCH_DESC": "Golpea al objetivo para infligir un <style=cIsDamage>800% de daño</style>. Si el objetivo está <style=cDeath>tambaleándose</style>, no se consume la carga y te curas un <style=cIsHealing>3.125%/12.5%/25%</style> de la salud máxima y un <style=cIsHealing>10%/25%/50%</style> de curación de reserva según la clase del objetivo, además de obtener <style=cDeath>potenciación</style>"
  }
}
