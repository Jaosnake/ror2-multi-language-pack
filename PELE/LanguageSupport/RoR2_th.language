    "CAPTAIN_SKILL_DISCONNECT_NAME": "การเชื่อมต่อขาดหาย",
    "CAPTAIN_SKILL_DISCONNECT_DESCRIPTION": "คุณขาดการเชื่อมต่อกับ UES Safe Travels...",
    "CAPTAIN_SKIN_ALT1_NAME": "พลเรือเอก",
    "CHEF_BODY_SUBTITLE": "ผู้เชี่ยวชาญการปรุงอาหาร",
    "CHEF_PASSIVE_NAME": "จุมพิตเชฟ",
    "CHEF_PASSIVE_DESCRIPTION": "สังหารศัตรูด้วยสกิล 2 อย่างขึ้นไปเพื่อปรุงพวกมันและดรอปอาหาร<style=cIsHealing>ฟื้นฟูพลังชีวิต</style>",
    "CHEF_PRIMARY_NAME": "หั่นเต๋า",
    "CHEF_PRIMARY_DESCRIPTION": "<style=cIsUtility>รวดเร็ว</style> ขว้างมีดปังตอ<style=cIsDamage>เจาะทะลุ</style>ใส่ศัตรูสร้างความเสียหาย <style=cIsDamage>200%</style> กดโจมตีค้างไว้เพื่อ<style=cIsDamage>เพิ่มความเสียหายขากลับเป็นสองเท่า</style>",
    "CHEF_PRIMARY_BOOST_DESCRIPTION_SKILL": "ขว้างมีดปังตอไปทุกทิศทาง สร้าง<style=cIsDamage>ความเสียหาย 400%</style>",
    "CHEF_SECONDARY_NAME": "ย่างไฟ",
    "CHEF_SECONDARY_DESCRIPTION": "<style=cIsDamage>จุดไฟ</style> เผาศัตรูใกล้เคียงสร้าง<style=cIsDamage>ความเสียหาย 600%</style>",
    "CHEF_SECONDARY_BOOST_DESCRIPTION_SKILL": "เผาศัตรูใกล้เคียงและยิงลูกไฟสามลูกสร้าง<style=cIsDamage>ความเสียหาย 700%</style> ก้อนน้ำมันติดไฟจะทิ้งแอ่งน้ำมันติดไฟไว้เมื่อกระทบ",
    "CHEF_SECONDARY_ALT_NAME": "กล่องน้ำแข็ง",
    "CHEF_SECONDARY_ALT_DESCRIPTION": "<style=cIsUtility>ความเย็นจัด</style> ยิงก้อนน้ำแข็งสร้าง<style=cIsDamage>ความเสียหาย 3x150%</style>",
    "CHEF_UTILITY_NAME": "กลิ้ง",
    "CHEF_UTILITY_DESCRIPTION": "<style=cIsDamage>ทำให้มึนงง</style> ชาร์จไม้นวดแป้งเพื่อ<style=cIsUtility>พุ่ง</style>ไปข้างหน้า สร้าง<style=cIsDamage>ความเสียหาย 300%-600%</style>",
    "CHEF_UTILITY_BOOST_DESCRIPTION_SKILL": "<style=cIsHealth>เลือดไหล</style> พุ่งไปข้างหน้าพร้อมหมุนเครื่องครัว สร้างความเสียหายเพิ่มเติม <style=cIsDamage>200%</style> แก่ศัตรูใกล้เคียงทั้งหมด",
    "CHEF_UTILITY_ALT_NAME": "น้ำมันหก",
    "CHEF_UTILITY_ALT_DESCRIPTION": "หมุนตัวขึ้นก่อนกระแทกลงมา ระเบิด<style=cIsUtility>น้ำมัน</style>สร้าง<style=cIsDamage>ความเสียหาย 200%</style> <style=cIsDamage>พุ่งขึ้นอีกครั้ง</style>โดยใช้สกิลซ้ำก่อนลงพื้นได้สูงสุดรวม <style=cIsDamage>4</style> ครั้ง",
    "CHEF_UTILITY_ALT_BOOST_DESCRIPTION_SKILL": "หมุนตัวขึ้นก่อนกระแทกลงมา ระเบิด<style=cIsUtility>น้ำมัน</style>สร้าง<style=cIsDamage>ความเสียหาย 200%</style> <style=cIsDamage>พุ่งขึ้นอีกครั้ง</style>โดยใช้สกิลซ้ำก่อนลงพื้นได้สูงสุดรวม <style=cIsDamage>4</style> ครั้ง",
    "CHEF_SPECIAL_NAME": "เคลือบซอส",
    "CHEF_SPECIAL_DESCRIPTION": "ยิงก้อน<style=cIsUtility>น้ำมัน</style>ต่อเนื่องอย่างรวดเร็ว สร้าง<style=cIsDamage>ความเสียหาย 7x250%</style>",
    "CHEF_SPECIAL_ALT1_NAME": "รับทราบ CHEF!",
    "CHEF_SPECIAL_ALT1_DESCRIPTION": "ปล่อยแรงระเบิดสร้างความเสียหาย <style=cIsDamage>400%</style> และทำให้เกิด<style=cIsDamage>ไฟไหม้</style>หรือ<style=cIsUtility>ความเย็นจัด</style> <style=cIsUtility>เสริมพลัง</style>สกิลถัดไปที่ใช้",
    "DRIFTER_BODY_SUBTITLE": "นักสะสมไร้ขีดจำกัด",
    "DRIFTER_PASSIVE_NAME": "ขยะกลายเป็นสมบัติ",
    "DRIFTER_PASSIVE_DESCRIPTION": "<style=cIsUtility>รีไซเคิล</style> รับบัฟที่สะสมได้เมื่อพก<style=cIsUtility>เศษไอเทม</style>",
    "DRIFTER_PRIMARY_NAME": "แรงกระแทก",
    "DRIFTER_PRIMARY_DESCRIPTION": "ฟาดศัตรูสร้าง<style=cIsDamage>ความเสียหาย 170%</style> การโจมตีครั้งที่สามสร้างความเสียหาย <style=cIsDamage>350%</style> และ<style=cIsUtility>ทำให้ศัตรูมึนงง</style> มีโอกาสดรอป<style=cIsUtility>ขยะ</style>",
    "DRIFTER_SECONDARY_NAME": "เก็บกวาด",
    "DRIFTER_SECONDARY_DESCRIPTION": "ขว้างเศษซากเป็นชุดสร้าง<style=cIsDamage>ความเสียหาย 4x100%</style> พร้อม<style=cIsUtility>กระสุนสุ่ม</style>ในถุง ใช้<style=cIsUtility>ขยะ 2 ชิ้น</style>เพื่อข้ามเวลาคูลดาวน์ได้",
    "DRIFTER_SECONDARY_ALT_NAME": "ลูกบาศก์ขยะ",
    "DRIFTER_SECONDARY_ALT_DESCRIPTION": "ทุบลูกบาศก์ขยะลงพื้นสร้าง<style=cIsDamage>ความเสียหาย 400%</style> การตีลูกบาศก์จะส่งมันพุ่งชนศัตรูสร้าง<style=cIsDamage>ความเสียหาย 400%</style>ได้สูงสุด 3 ครั้ง ก่อนระเบิดสร้างความเสียหาย <style=cIsDamage>800%</style> ใช้<style=cIsUtility>ขยะ 4 ชิ้น</style>เพื่อข้ามเวลาคูลดาวน์ได้",
    "DRIFTER_SECONDARY_A_NAME": "สุ่มใหม่",
    "DRIFTER_SECONDARY_A_DESCRIPTION": "กดเพื่อสุ่มกระสุนที่ถืออยู่ใหม่",
    "DRIFTER_SECONDARY_B_NAME": "เทออก",
    "DRIFTER_SECONDARY_B_DESCRIPTION": "กดค้างเพื่อขว้างกระสุนซ้ำต่อเนื่องตราบเท่าที่พร้อมใช้งาน",
    "DRIFTER_SPECIAL_NAME": "กู้ของ",
    "DRIFTER_SPECIAL_DESCRIPTION": "ใช้<style=cIsUtility>ขยะ 8 ชิ้น</style>เพื่อสร้าง<style=cIsTemporary>ไอเทมชั่วคราว 4 ชิ้น</style>",
    "DRIFTER_SPECIAL_ALT_NAME": "ดัดแปลง",
    "DRIFTER_SPECIAL_ALT_DESCRIPTION": "<style=cIsUtility>ทำให้มึนงง</style> ใช้<style=cIsUtility>ขยะ 8 ชิ้น</style>เพื่อปล่อยคลื่นกระแทกสร้าง<style=cIsDamage>ความเสียหาย 100%</style> ซึ่งมอบ<style=cIsUtility>ดีบัฟแบบสุ่ม</style>และ<style=cIsUtility>ดัดแปลง</style>ไอเทมที่เก็บได้และวัตถุโต้ตอบที่มีไอเทม <style=cIsUtility>ผลแตกต่างกันตามเป้าหมาย</style>",
    "DRIFTER_UTILITY_NAME": "ยึดคืน",
    "DRIFTER_UTILITY_DESCRIPTION": "กระโดดไปข้างหน้าแล้วจับ<style=cIsDamage>ศัตรู</style>หรือ<style=cIsUtility>วัตถุโต้ตอบ</style>ใส่ถุง ใช้อีกครั้งเพื่อขว้างสิ่งที่อยู่ในถุง วัตถุที่จับได้จะถูก<style=cIsDamage>ทุบตี</style>",
    "DRIFTER_UTILITY_B_NAME": "ทิ้ง",
    "DRIFTER_UTILITY_B_DESCRIPTION": "ขว้างวัตถุที่ถืออยู่จากถุง <style=cIsUtility>ทำให้มึนงง</style>เมื่อกระทบและสร้าง<style=cIsDamage>ความเสียหาย 280%</style>ซึ่งเพิ่มตามมวลของวัตถุ ดรอป<style=cIsUtility>ขยะ</style>",
    "DRIFTER_UTILITY_C_NAME": "ทุบตี",
    "DRIFTER_UTILITY_C_DESCRIPTION": "ใช้วัตถุในถุงฟาดศัตรูสร้าง<style=cIsDamage>ความเสียหาย 280%</style>ซึ่งเพิ่มตามมวลของวัตถุ ดรอป<style=cIsUtility>ขยะ</style>และทำให้วัตถุเสียหายทุกครั้งที่โจมตี มอนสเตอร์จะหลุดออกหลังถูกตีสามครั้ง",
    "FALSESON_BODY_SUBTITLE": "ทายาทผู้แตกสลาย",
    "FALSESON_PASSIVE_NAME": "การดัดแปลงจันทรา",
    "FALSESON_PASSIVE_DESCRIPTION": "หนามจันทราที่ยังไม่ได้ใช้มอบ<style=cIsUtility>ความเร็วโจมตี +5%</style>และ<style=cIsUtility>เกราะ +2.5</style> หนามที่ใช้แล้วมอบ<style=cIsUtility>ความเร็วเคลื่อนที่ +5%</style>และ<style=cIshealing>การฟื้นฟูพลังชีวิต +2.5</style>",
    "FALSESON_PRIMARY_NAME": "กระบองแห่งผู้ถูกทอดทิ้ง",
    "FALSESON_PRIMARY_DESCRIPTION": "เหวี่ยงโจมตีสร้าง<style=cIsDamage>ความเสียหาย 450%</style> กดสกิลหลักและรองค้างไว้เพื่อชาร์จโจมตีทุบพื้นสร้าง<style=cIsDamage>ความเสียหาย 1000%</style>",
    "FALSESON_SECONDARY_NAME": "หนามจันทรา",
    "FALSESON_SECONDARY_DESCRIPTION": "<style=cIsUtility>ความพินาศจันทรา</style> <style=cIsUtility>คล่องตัว</style> ขว้างหนามจันทราสร้าง<style=cIsDamage>ความเสียหาย 200%</style> รับหนามจันทราเพิ่มด้วย<style=cIsHealing>การเติบโต</style>",
    "FALSESON_SECONDARY_ALT1_NAME": "หอกจันทรา",
    "FALSESON_SECONDARY_ALT1_DESCRIPTION": "<style=cIsUtility>ความพินาศจันทรา</style> ยิงหอกจันทรา<style=cIsDamage>เจาะทะลุ</style>ที่อาบ<style=cIsDamage>สายฟ้า</style> สร้าง<style=cIsDamage>ความเสียหาย 300%</style> รับหอกเพิ่มด้วย<style=cIsHealing>การเติบโต</style> นับเป็นหนามจันทรา <style=cIsUtility>2</style> อัน",
    "FALSESON_UTILITY_NAME": "ย่างก้าวแห่งพี่น้อง",
    "FALSESON_UTILITY_DESCRIPTION": "พุ่งเป็นระยะสั้น สร้างระเบิด<style=cIsDamage>ความเสียหาย 200%</style>ต่อศัตรูแต่ละตัวที่โดน <style=cIsUtility>ใช้ได้สองครั้ง</style>",
    "FALSESON_UTILITY_ALT1_NAME": "เจตจำนงแห่ง Meridian",
    "FALSESON_UTILITY_ALT1_DESCRIPTION": "<style=cIsDamage>ทำให้มึนงง</style> <style=cIsUtility>เทเลพอร์ต</style>และระเบิดสร้าง<style=cIsDamage>ความเสียหาย 150%</style>พร้อม<style=cIsUtility>ดึง</style>ศัตรู เพิ่มผลของสกิลติดตัวเป็นสามเท่าเป็นเวลา <style=cIsUtility>4s</style> <style=cIsHealing>การเติบโต</style>เพิ่มระยะเวลานี้",
    "FALSESON_SPECIAL_NAME": "เลเซอร์แห่งบิดา",
    "FALSESON_SPECIAL_DESCRIPTION": "<style=cIsUtility>ชาร์จ</style>เลเซอร์ที่โจมตีถี่ สร้าง<style=cIsDamage>ความเสียหาย 240%-1400%</style>เป็นเวลา <style=cIsUtility>4s</style> และ<style=cIsUtility>เติม</style>หนามจันทรา <style=cIsUtility>ระยะเวลา</style>เพิ่มขึ้นด้วย<style=cIsHealing>การเติบโต</style>",
    "FALSESON_SPECIAL_ALT1_NAME": "เลเซอร์ระเบิด",
    "FALSESON_SPECIAL_ALT1_DESCRIPTION": "ยิงเลเซอร์เจาะทะลุสร้าง<style=cIsDamage>ความเสียหาย 1250%</style> และเติมหนามจันทรา <style=cIsUtility>50%</style> <style=cIsHealing>การเติบโต</style>เพิ่มจำนวนชาร์จ",
    "RAILGUNNER_BODY_SUBTITLE": "ผู้พเนจรที่ถูกลืม",
    "RAILGUNNER_PASSIVE_NAME": "เครื่องเร่งแม่เหล็ก",
    "RAILGUNNER_PASSIVE_DESCRIPTION": "<style=cIsDamage>โอกาสโจมตีคริติคอล</style> ทั้งหมดจะเปลี่ยนเป็น <style=cIsDamage>ความเสียหายคริติคอล</style>",
    "RAILGUNNER_PRIMARY_NAME": "ระบบกระสุนนำวิถี XQR",
    "RAILGUNNER_PRIMARY_DESCRIPTION": "ยิงกระสุนนำวิถีไล่ตามศัตรู สร้าง<style=cIsDamage>ความเสียหาย 100%</style>",
    "RAILGUNNER_SECONDARY_NAME": "ปืนซุ่มยิง M99",
