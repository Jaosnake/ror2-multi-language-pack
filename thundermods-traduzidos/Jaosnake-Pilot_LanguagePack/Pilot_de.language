{
    "de": {
        "MOFFEIN_PILOT_BODY_NAME": "Pilot",
        "MOFFEIN_PILOT_BODY_SUBTITLE": "Luftlande-Ass",
        "MOFFEIN_PILOT_BODY_LORE": "United Enterprise Shipping lädt Piloten aus dem gesamten bekannten Universum ein, sich für unser Preferred Pilot Enhanced Commissions-Programm zu bewerben! Zu den Vorteilen gehören der Zugang zu kybernetischen Wirkungserweiterungen für einfachere Landungen, Zertifizierungsprogramme für Waffen und Sicherheit sowie luxuriöse Urlaubsmöglichkeiten! (Bewerber müssen sich voraussichtlich 5 Jahre vor Flugbetrieb bewerben. Kybernetik ist nicht für alle Programmteilnehmer garantiert. Waffen- und Sicherheitszertifikate sind nur bei UES-Beschäftigung gültig. Alle Möglichkeiten werden unverändert aufgeführt und es sind keine weiteren Trinkgelder, Chancen oder Vorteile anzunehmen, unabhängig von Aktualisierungen des Weltraumseerechts auf teilnehmenden Planeten.",
        "MOFFEIN_PILOT_BODY_DESCRIPTION": "Pilot ist ein Luftkämpfer, der von oben großen Schaden verursacht.<style=cSub>\n\n< ! >Pilot kann Gefahren vermeiden, indem er in der Luft bleibt. Durch den geschickten Einsatz seiner Fähigkeiten können Sie Ihre Flugzeit maximieren.\n\n< ! >Ziel erfasst kann verwendet werden, um Ihren Sturz abzufangen.\n\n< ! >Schnelle Bereitstellung bewegt sich nach oben, wenn er am Boden verwendet wird, und nach vorne, wenn er in der Luft verwendet wird.\n\n< ! >Wirf Feinde mit \"Luftangriff\" in die Luft und kombiniere dies dann mit \"Zielerfassung\", um sie in der Luft zu jonglieren.",
        "MOFFEIN_PILOT_BODY_OUTRO_FLAVOR": "..und so ging er, seine Träume vom Himmel unten.",
        "MOFFEIN_PILOT_BODY_MAIN_ENDING_ESCAPE_FAILURE_FLAVOR": "..und so verschwand er, der Himmel war für immer außer Reichweite.",
        "MOFFEIN_PILOT_BODY_OUTRO_FAILURE": "..und so verschwand er, der Himmel war für immer außer Reichweite.",
        "MOFFEIN_PILOT_BODY_PRIMARY_NAME": "Clusterfeuer",
        "MOFFEIN_PILOT_BODY_PRIMARY_DESCRIPTION": "Feuere deine Waffe für <style=cIsDamage>160 % Schaden</style> ab. Jeder dritte Treffer <style=cIsDamage>explodiert</style> und verursacht <style=cIsDamage>320 % Schaden</style>.",
        "MOFFEIN_PILOT_BODY_PRIMARY_RETURNS_DESCRIPTION": "Feuere deine Waffe für <style=cIsDamage>160 % Schaden</style> ab. Jeder dritte Treffer verursacht <style=cIsDamage>320 % Schaden</style> und <style=cIsDamage>durchschlägt</style> Gegner.",
        "MOFFEIN_PILOT_BODY_PRIMARY_ALT_NAME": "Schnellfeuer",
        "MOFFEIN_PILOT_BODY_PRIMARY_ALT_DESCRIPTION": "<style=cIsUtility>Agil</style>. Feuere deine Waffe schnell ab und verursache <style=cIsDamage>140 % Schaden</style>.",
        "MOFFEIN_PILOT_BODY_PRIMARY_SILENCER_NAME": "Unterdrücktes Feuer",
        "MOFFEIN_PILOT_BODY_PRIMARY_SILENCER_DESCRIPTION": "<style=cIsDamage>Jäger</style>. Feuere deine schallgedämpfte Pistole ab und verursache <style=cIsDamage>100 % Schaden</style>.",
        "MOFFEIN_PILOT_BODY_SECONDARY_NAME": "Ziel erfasst!",
        "MOFFEIN_PILOT_BODY_SECONDARY_DESCRIPTION": "Verwandle deine Waffe in eine <style=cIsDamage>durchschlagende Smartgun</style>, die <style=cIsDamage>3x160 % Schaden</style> verursacht. Gegen <style=cIsUtility>fliegende</style> Ziele verursacht sie <style=cIsDamage>50 %</style> mehr Schaden. Bis zu 2 Ladungen.",
        "MOFFEIN_PILOT_BODY_SECONDARY_ALT_NAME": "Bomben weg!",
        "MOFFEIN_PILOT_BODY_SECONDARY_ALT_DESCRIPTION": "Verwandle deine Waffe in einen <style=cIsDamage>Energiegranatwerfer</style>, der <style=cIsDamage>480 % Schaden</style> verursacht. In der <style=cIsUtility>Luft</style> verursacht er stattdessen <style=cIsDamage>3x220 % Schaden</style>. Bis zu 2 Ladungen.",
        "MOFFEIN_PILOT_BODY_UTILITY_NAME": "Schnelle Bereitstellung",
        "MOFFEIN_PILOT_BODY_UTILITY_DESCRIPTION": "<style=cIsDamage>Betäubend</style>. Springe in die Luft und <style=cIsUtility>aktiviere deinen Fallschirm</style>. In der Luft wird der <style=cIsHealth>Auftrieb verringert</style>, dafür erhältst du mehr <style=cIsUtility>Vorwärtsschub</style>.",
        "MOFFEIN_PILOT_BODY_UTILITY_ALT_NAME": "Kunstflug",
        "MOFFEIN_PILOT_BODY_UTILITY_ALT_DESCRIPTION": "<style=cIsUtility>Stürme vorwärts</style> und <style=cIsUtility>halte dich an einer Wand fest</style>. Erhalte <style=cIsDamage>30 % Angriffsgeschwindigkeit</style>. Beim <style=cIsUtility>Absprung von der Wand</style> wirst du vorwärts geschleudert.",
        "MOFFEIN_PILOT_BODY_SPECIAL_NAME": "Luftangriff",
        "MOFFEIN_PILOT_BODY_SPECIAL_DESCRIPTION": "<style=cIsUtility>Stürme vorwärts</style> und lege <style=cIsDamage>zu deinen Füßen</style> eine Bombe, die Gegner <style=cIsDamage>in die Luft schleudert</style> und <style=cIsDamage>600 % Schaden</style> verursacht. Kann <style=cIsDamage>3</style> Mal ausgelöst werden. Bis zu 2 Ladungen.",
        "MOFFEIN_PILOT_BODY_SPECIAL_SCEPTER_NAME": "Luftangriff",
        "MOFFEIN_PILOT_BODY_SPECIAL_SCEPTER_DESCRIPTION": "<style=cIsUtility>Stürme vorwärts</style> und lege <style=cIsDamage>zu deinen Füßen</style> eine Bombe, die Gegner <style=cIsDamage>in die Luft schleudert</style> und <style=cIsDamage>800 % Schaden</style> verursacht. Kann <style=cIsDamage>6</style> Mal ausgelöst werden. Bis zu 2 Ladungen.",
        "MOFFEIN_PILOT_BODY_SPECIAL_ALT_NAME": "Luftunterstützung",
