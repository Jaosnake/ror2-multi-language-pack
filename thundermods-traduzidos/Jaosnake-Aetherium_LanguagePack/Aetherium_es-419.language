{
  "es-419": {
    "AETHERIUM_EXPANSION_DEF_NAME": "Aetherium",
    "AETHERIUM_EXPANSION_DEF_DESCRIPTION": "Te espera todo un mundo de objetos, equipos, élites e interactuables extraños.",
    "ITEM_ACCURSED_POTION_NAME": "Poción maldita",
    "ITEM_ACCURSED_POTION_PICKUP": "Periódicamente, bebe una poción extraña y comparte sus efectos con enemigos cercanos.",
    "ITEM_ACCURSED_POTION_DESCRIPTION": "Cada 30 segundos (25% menos por acumulación), bebe una poción extraña y comparte sus efectos con enemigos en un radio de 20 m (+5 m por acumulación).",
    "ITEM_ALIEN_MAGNET_NAME": "Imán alienígena",
    "ITEM_ALIEN_MAGNET_PICKUP": "Tus ataques atraen a los enemigos hacia ti.",
    "ITEM_ALIEN_MAGNET_DESCRIPTION": "Los enemigos alcanzados por tus ataques son atraídos hacia ti con una fuerza de 20x (+5x por acumulación).",
    "ITEM_UNSTABLE_DESIGN_NAME": "Diseño inestable",
    "ITEM_UNSTABLE_DESIGN_PICKUP": "Crea una quimera lunar muy «AMISTOSA» cada 30 segundos.",
    "ITEM_UNSTABLE_DESIGN_DESCRIPTION": "Cada 30 segundos, crea una Quimera Lunar 'AMIGABLE' si aún no existe una de tus creaciones. Obtiene +400% de daño (+100% por acumulación), +100% de vida (+100% por acumulación), +300% de velocidad de ataque y +28% de velocidad de movimiento (+28% por acumulación). Puede subir de nivel al matar.",
    "ITEM_HEART_OF_THE_VOID_NAME": "Corazón del Vacío",
    "ITEM_HEART_OF_THE_VOID_PICKUP": "Al morir, provoca una implosión del vacío que te revive si mata a un enemigo. Con poca vida, la curación se convierte en daño.",
    "ITEM_HEART_OF_THE_VOID_DESCRIPTION": "Al morir, provoca una implosión del vacío que inflige 120 veces tu daño en 15 m (+7,5 m por acumulación). Si mata a un enemigo, revives. Con un 30% de vida o menos (+5% por acumulación, máximo 99%), toda curación se convierte en daño.",
    "ITEM_WEIGHTED_ANKLET_NAME": "Tobillera pesada",
    "ITEM_WEIGHTED_ANKLET_PICKUP": "Los pesos te ralentizan, pero quitártelos otorga poder permanente.",
    "ITEM_WEIGHTED_ANKLET_DESCRIPTION": "Reduce la velocidad de ataque y movimiento un 10% (cada una hasta un mínimo de 10%). Quitar las pesas otorga 0,25 de velocidad de ataque, 1 de velocidad de movimiento y 5% de daño por cada eliminación.",
    "ITEM_ZENITH_ACCELERATOR_NAME": "Acelerador Cenit",
    "ITEM_ZENITH_ACCELERATOR_PICKUP": "Los impactos otorgan velocidad de ataque, pero pocos acumulados reducen tu velocidad de ataque.",
    "ITEM_ZENITH_ACCELERATOR_DESCRIPTION": "Los golpes otorgan acumulaciones temporales que aumentan la velocidad de ataque un 10% cada una, hasta +300% (+100% por objeto adicional). Con casi ninguna acumulación del beneficio, la velocidad de ataque se reduce hasta un 50%; la penalización escala exponencialmente con objetos adicionales.",
    "ITEM_BLASTER_SWORD_NAME": "Espada bláster",
    "ITEM_BLASTER_SWORD_PICKUP": "Con la vida al máximo, la mayoría de los ataques disparan un haz de espada explosivo.",
    "ITEM_BLASTER_SWORD_DESCRIPTION": "Cuando tu barra de vida esté llena, contando vida, escudo o barrera, la mayoría de los ataques disparan un rayo de espada que empala a un enemigo y luego explota causando 200% de daño (+50% por acumulación).",
    "ITEM_INSPIRING_DRONE_NAME": "Dron inspirador",
    "ITEM_INSPIRING_DRONE_PICKUP": "Tus robots heredan parte de tus atributos y explotan al morir.",
    "ITEM_INSPIRING_DRONE_DESCRIPTION": "Tus robots obtienen atributos equivalentes al 50% de los tuyos (+50% por acumulación). Cuando muere un robot inspirado, explota causando 300% de tu daño (+150% por acumulación).",
    "ITEM_WITCHES_RING_NAME": "Anillo de las brujas",
    "ITEM_WITCHES_RING_PICKUP": "Los impactos de daño muy alto también activan efectos al matar.",
    "ITEM_WITCHES_RING_DESCRIPTION": "Los golpes que infligen al menos 500% de daño activan efectos Al matar. El objetivo queda inmune a este efecto durante 10 segundos (duración reducida un 10% por acumulación, con rendimientos decrecientes).",
    "ITEM_BLOODTHIRSTY_SHIELD_NAME": "Escudo sanguinario",
    "ITEM_BLOODTHIRSTY_SHIELD_PICKUP": "Matar enemigos restaura parte de tu escudo.",
    "ITEM_BLOODTHIRSTY_SHIELD_DESCRIPTION": "Matar a un enemigo restaura el 10% de tu escudo máximo (+10% por acumulación, con rendimientos decrecientes). Al recoger el primero, obtienes escudo equivalente al 8% de tu vida máxima.",
    "ITEM_ENGINEERS_TOOLBELT_NAME": "Cinturón de herramientas del ingeniero",
    "ITEM_ENGINEERS_TOOLBELT_PICKUP": "Probabilidad de duplicar drones y torretas comprados y revivirlos al morir.",
    "ITEM_ENGINEERS_TOOLBELT_DESCRIPTION": "20% de probabilidad (+20% por acumulación, con rendimientos decrecientes hasta 100%) de duplicar drones y torretas al comprarlos. También tienen 10% de probabilidad (+10% por acumulación, con rendimientos decrecientes hasta 100%) de revivir al morir.",
    "ITEM_SHARK_TEETH_NAME": "Dientes de tiburón",
    "ITEM_SHARK_TEETH_PICKUP": "Parte del daño recibido se retrasa como sangrado.",
    "ITEM_SHARK_TEETH_DESCRIPTION": "El 25% del daño recibido (+25% por acumulación, con rendimientos decrecientes, hasta 75%) se aplica como sangrado durante 5 segundos. Infligir daño elimina el 10% del daño de sangrado acumulado.",
    "ITEM_SHIELDING_CORE_NAME": "Núcleo protector",
    "ITEM_SHIELDING_CORE_PICKUP": "Obtén armadura mientras tus escudos estén activos.",
    "ITEM_SHIELDING_CORE_DESCRIPTION": "Obtén 15 de armadura (+10 por acumulación) mientras tus escudos estén activos. Al recoger el primero, obtienes escudo equivalente al 8% de tu vida máxima.",
    "ITEM_FEATHERED_PLUME_NAME": "Pluma emplumada",
    "ITEM_FEATHERED_PLUME_PICKUP": "Al recibir daño, obtén un aumento temporal de velocidad.",
    "ITEM_FEATHERED_PLUME_DESCRIPTION": "Al recibir daño, obtén un 7% de velocidad de movimiento, acumulable 3 veces durante 5 segundos (+3 acumulaciones y +0,5 segundos por objeto adicional).",
    "ITEM_NAIL_BOMB_NAME": "Bomba de clavos",
    "ITEM_NAIL_BOMB_PICKUP": "Los ataques de mucho daño liberan una granada de metralla explosiva.",
    "ITEM_NAIL_BOMB_DESCRIPTION": "Los ataques que infligen al menos 120% de daño liberan una granada de metralla que explota causando 32x30% de daño (+50% por acumulación). Los enemigos que activan una bomba quedan inmunes a este efecto durante 2 segundos.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_NAME": "Weighted Anklet Limiter Release",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_PICKUP": "Limitador retirado.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_DESCRIPTION": "Obtén 1 de velocidad de movimiento, 0,25 de velocidad de ataque y 5% de daño (+1, +0,25 y +5% por acumulación, respectivamente).",
    "AETHERIUM_MONSTERS_UNSTABLE_DESIGN_CHIMERA_NAME": "The Unstable Design",
    "EQUIPMENT_JAR_OF_RESHAPING_NAME": "Jarra de remodelación",
    "EQUIPMENT_JAR_OF_RESHAPING_PICKUP": "Absorbe proyectiles cercanos y luego libéralos todos a la vez.",
    "EQUIPMENT_JAR_OF_RESHAPING_DESCRIPTION": "Al activarlo, absorbe proyectiles en un radio de 20 m durante 3 segundos. Actívalo de nuevo para disparar todos los proyectiles almacenados; su daño depende de los proyectiles absorbidos. Después, el frasco entra en recarga.",
    "EQUIPMENT_BELL_TOTEM_NAME": "Tótem de campana",
    "EQUIPMENT_BELL_TOTEM_PICKUP": "Crea un tótem de campana que aturde y aleja a los enemigos al activarse.",
    "EQUIPMENT_BELL_TOTEM_DESCRIPTION": "Crea un tótem de campana interactivo. Al activarlo, una onda de choque de 25 m aturde y lanza a los enemigos y activa efectos Al usar un santuario. Espera 2 segundos entre usos del equipo y 1 segundo entre activaciones del tótem; cada usuario solo puede tener un tótem.",
    "INTERACTABLE_BELL_TOTEM_NAME": "Tótem de campana",
    "INTERACTABLE_BELL_TOTEM_CONTEXT": "¿Tocar la campana?",
    "INTERACTABLE_BELL_TOTEM_INSPECT": "Al activarse, aturde y lanza lejos a los enemigos.",
    "INTERACTABLE_BELL_TOTEM_TITLE": "Tótem de campana",
    "INTERACTABLE_BUFF_BRAZIER_NAME": "Brasero de mejora",
    "INTERACTABLE_BUFF_BRAZIER_CONTEXT": "¿Comprar la fuerza de las llamas sagradas?",
    "INTERACTABLE_BUFF_BRAZIER_INSPECT": "Compra una mejora temporal indicada por el color de la llama y el icono. Durante el evento del teletransportador funciona dentro de su radio. En Simulacrum, la llama se ofrece al campo del Cangrejo del Vacío al comenzar la siguiente oleada y dura 2 oleadas dentro de su radio.",
    "INTERACTABLE_BUFF_BRAZIER_TITLE": "Brasero de mejora",
    "iNTERACTABLE_BUFF_BRAZIER_NAME": "Brasero de mejora",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_NAME": "Lealtad sangrienta",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_PICKUP": "Conviértete en un aspecto del plano rojo.",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_DESCRIPTION": "Al usarlo, teletranspórtate hasta 10 m en la dirección del movimiento con una breve invulnerabilidad. Todos tus ataques causan sangrado.",
    "AETHERIUM_ELITE_AFFIX_SANGUINE_MODIFIER": "Sanguíneo {0}",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_NAME": "Artefacto de las Leónidas",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_DESCRIPTION": "Cada 60 segundos ocurre una lluvia de meteoritos con 6 oleadas.",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_NAME": "Artefacto de Progresión",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_DESCRIPTION": "Los enemigos evolucionan a formas más fuertes con el tiempo.",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_NAME": "Artefacto de Regresión",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_DESCRIPTION": "Cuando muere un monstruo evolucionado, se divide en formas inferiores.",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_NAME": "Artefacto del Viaje",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_DESCRIPTION": "La mayoría de las fases se eligen al azar. Tras cierto número aparece un teletransportador primordial.",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_NAME": "Artefacto de la Pesadilla",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_DESCRIPTION": "Los enemigos que no son jefes reciben de 1 a 4 objetos lunares de Herejía al aparecer.",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_NAME": "Artefacto del Tirano",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_DESCRIPTION": "Los jefes que terminan una ruta reciben 1 modificador de élite aleatorio al aparecer.",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_NAME": "Duck in the Woods",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_DESC": "Falla al abrir una caja oxidada.",
    "AETHERIUM_NAIL_BOMB_UNLOCKABLE_NAME": "Duck in the Woods",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_NAME": "Shield Maiden",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_DESC": "Ten más de la mitad de tu vida como escudos.",
    "AETHERIUM_SHIELDING_CORE_UNLOCKABLE_NAME": "Shield Maiden",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_NAME": "First Step into Madness",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_DESC": "Mata o muere ante una Quimera lunar perfeccionada.",
    "AETHERIUM_UNSTABLE_DESIGN_UNLOCKABLE_NAME": "First Step into Madness",
    "ITEM_NAIL_BOMB_LORE": "Entierra el cuerpo, toma el diseño y guarda silencio sobre esto. Puede ser nuestro pequeño secreto.\n\nAtentamente,\nJeb Labinsky",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_LORE": "",
    "ITEM_BLASTER_SWORD_LORE": "<style=cMono>. . . . . . . . . .</style>\n\n<style=cMono>ELLOS</style> por fin <style=cMono>ESCUCHAN</style>.\n\n<style=cMono>OTORGAMOS</style> esta <style=cMono>ARMA</style>. Debes <style=cMono>USAR</style> la resonancia de las <style=cMono>ALMAS</style>. Encuentra la <style=cMono>VERDADERA FUERZA</style>.\n\nEl patrón debe <style=cMono>ADAPTARSE</style>. El <style=cMono>PORTADOR</style> es la variable.\n\nSi el <style=cMono>PORTADOR</style> sobrevive a la prueba, <style=cMono>ASCENDERÁ</style>.\n\n<style=cMono>. . . . . . . . . .</style>",
    "ITEM_WITCHES_RING_LORE": "\"El Cuervo llama y da órdenes\nA todos y cada uno de sus devotos\nHa llegado la hora, termina un ciclo\nApágate, sol; sécate, mar\n\nY aquí se ha reunido nuestro aquelarre\nCon el aullido del viento nocturno\nSellamos nuestro pacto con Ella, este juramento:\nTraer a la vida la muerte largamente esperada\"\n\n¿Es eso lo que está escrito en el anillo o siempre conociste este poema...?",
    "ITEM_UNSTABLE_DESIGN_LORE": "Todo empezó cuando uno de nuestros probadores de campo trajo un plano de una montaña entera de ellos que encontró en la luna. Los planos contenían fórmulas e imágenes relacionadas con las extrañas construcciones que vimos deambular por allí. Jimenez, de Ingeniería, lo consiguió y pensó que ayudaría al equipo descifrándolo y fabricando lo que describía. Ahora esperamos a que Seguridad se ocupe de la construcción tan <color=#FF0000>'AMISTOSA'</color> que está destrozando los sectores inferiores de la estación. Gracias, Jimenez.",
    "ITEM_ZENITH_ACCELERATOR_LORE": "Los demás no son los dueños de este universo, hermano. Ellos crean relojes para contar el tiempo; nosotros los creamos para fabricar nuestro propio tiempo. Observa.\n\nCreamos un eje para dar estabilidad y potencia, y para liberar las energías atrapadas en su interior. Un centro redondeado es esencial para su propósito.\n\nLos escapes expulsan las energías en espiral. Las aprovechamos con un simple trozo de piedra. Necesitamos menos esencia si creamos porciones más pequeñas aquí y aquí.\n\nYa está completo. Cuanto más arda, más tiempo habremos creado. Ese tiempo nos permite acelerarnos.\n\nNo necesito recordarte la importancia de la aceleración. Recuérdalo, hermano.\n\nEl combustible es sangre.\n\nLa velocidad es guerra.",
    "ITEM_BLOODTHIRSTY_SHIELD_LORE": "Balada de Letheseus, héroe de las islas — Acto II, escena III\n\nEl sonido del metal desgarrando carne se extiende por el aire; los soldados parecen indiferentes a la macabra orquesta que los rodea. Solo les importa sobrevivir, sin importar de quién sea la sangre que cueste. Una y otra vez, el xiphos alcanza su objetivo hasta que solo queda un hombre.\n\nEl sonido se apaga. Letheseus se arrodilla sobre la tierra carmesí, agotado por su danza mortal. Su xiphos ya no le servirá. Su aspis, aunque agrietado, seguirá protegiéndolo mientras pueda ofrecerle un tributo que solo puede encontrar en el furor de la batalla.",
    "EQUIPMENT_BELL_TOTEM_LORE": "Todo acontecimiento importante del universo ha estado acompañado por un sonido. Siempre presente, se escuche o no.\n\nAgudo y atronador, su mera presencia se propaga por la materia con cada segundo que pasa.\n\nEl ser humano aprendió primero a aprovechar ese sonido y lo usó para recordar el paso del tiempo.\n\nErigió monolitos para alabar a seres que no podía comprender y ordenó ese sonido en una magnífica melodía, para venerar también aquello que lo aleja del pasado y del presente.\n\nCon ese propósito, nosotros también mostraremos nuestra devoción. Invocamos nuestro instrumento para recordar a quienes lo han olvidado que el tiempo no debe darse por sentado.\n\nRecordemos a los herejes que su tiempo ha llegado a su fin.\n\n— El Relojero.",
    "ITEM_SHARK_TEETH_LORE": "Pedido: Bioaumento experimental [Clasificado]\nNúmero de seguimiento: 44-KILO\nEntrega estimada: 04/05/2056\n\n«Sujetamos la muestra al sujeto de prueba. Los resultados fueron... viscerales».\n\n«El sujeto recibió un impacto cinético letal. Según todas las mediciones, su caja torácica debería haberse desplomado al instante. En cambio, la fuerza se distribuyó. Se retrasó. Sí, sangraba profusamente, pero seguía siendo capaz de combatir».\n\n«Entonces llegó la anomalía. Cuando el sujeto atacó al objetivo, sus signos vitales se estabilizaron. Parece que el aumento crea un vínculo entre la agresión y la supervivencia. <style=cMono>La violencia metaboliza el dolor.</style> Mientras siguiera luchando, el trauma diferido simplemente... desaparecía».\n\n«Convierte a un soldado en tiburón. Si dejan de moverse, mueren. Así que no se detienen».",
    "ITEM_SHIELDING_CORE_LORE": "Informe del ingeniero:\n\nPara empezar, seré sincero: no sé qué es la sustancia verde y viscosa del interior de mi pequeña turbina.\n\nMe quedaban pocas piezas para reparar nuestros generadores de escudo, así que compré un resonador de repuesto a uno de los chatarreros con los que se cruzó nuestra nave. En cuanto lo coloqué, la carcasa se agrietó y me cubrió con ese líquido asqueroso, que parecía deshacerse en cristales brillantes al entrar en contacto con el aire. Normalmente no habría sido un gran problema, porque llevaba traje, pero la sustancia se expandía constantemente para llenar el recipiente que ocupaba, así que tuve que soldarle un sello a toda prisa.\n\nEntonces el diagnóstico de mi traje me avisó de que la eficacia de mi escudo se había disparado.\n\nUn momento de inspiración y varios borradores después...\nAhora vendo estas cosas como pan caliente y gano una fortuna. Así que aquí tienes una.\n\nP. D.: No expongas la piel a esta sustancia. Puede causar más de 200 tipos conocidos de cáncer. Pero será nuestro secreto, ¿verdad?",
    "ITEM_ACCURSED_POTION_LORE": "<style=cMono>REGISTRO: Audio transcrito — «El lugar azul» | ASUNTO: Superviviente desconocido</style>\nEl aire aquí... sabe a electricidad estática y polvo viejo.\nEncontré a un mercader al fondo de la cueva. No al gran lagarto, sino a otra cosa. Algo envuelto en harapos y cristales. Removía una cuba llena de... no sé. Parecía luz estelar líquida mezclada con aceite.\n«No hay verdadera supervivencia en el orden», parloteó la criatura. Su voz sonaba como vidrio triturándose.\n«Sus “tácticas”, sus “formaciones”... <style=cMono>Endebles</style>. <style=cMono>Estáticas</style>. Para vivir eternamente, debes volverte como una tormenta».\nHizo rodar una esfera de vidrio sobre la mesa de piedra. Dentro, el líquido cambiaba de color: rojo sangre, verde, luego púrpura del vacío; un color nuevo a cada mirada.\n«El caos es la única armadura que no puede perforarse», dijo, ofreciéndome el frasco. «Bebe. Deja que la rueda gire. Si el destino decide que ardas, deja que tus enemigos se asfixien con el humo».\nNo debería tocarlo. Lo sé. Pero ya no estoy a salvo en aquel lugar y los monstruos de afuera hacen cada vez más ruido.\nTengo sed.",
    "ITEM_ALIEN_MAGNET_LORE": "[INICIO DEL REGISTRO]\n\nRegistro del experimento n.º 476951-b\nObjeto de estudio: xenomineral omnimagnético desconocido\n<indent=5%>Grabo este registro de video totalmente asombrado por el descubrimiento que tenemos ante nosotros. Lo que sabíamos de las propiedades magnéticas de los minerales nos había mostrado que diversos materiales no podían verse afectados de forma significativa por el magnetismo normal. Uno de ellos es la carne. Si dejo caer este imán de neodimio sobre mi brazo así... Como pueden ver, no ocurre nada notable. El imán simplemente cae sobre la mesa. Eso es lo que considerábamos normal, pero este mineral parece reescribir esa constante.\n\n<indent=5%>Ahora repetiremos la última prueba con un trozo de este mineral. Me han asegurado que es completamente seguro probarlo en nosotros y que no tiene propiedades radiactivas. Así que allá vamos. Lo dejamos caer junto al brazo, así... *PUM* *CRAC* *CHOF*\n¡¡¡AAAAAAAAGH!!! ¡¡¡AAAAAAAAAAAAAAA!!!\n[FIN DEL REGISTRO][EQUIPO DE TRAUMATOLOGÍA ENVIADO AL LABORATORIO 5]",
    "ITEM_HEART_OF_THE_VOID_LORE": "[INCIDENTE NÚMERO 511051]\n[TRANSCRIPCIÓN A CONTINUACIÓN]\nElena: Oye, eh... Robert...\n\nRobert: ¿Sí?\n\nElena: ¿Recuerdas aquel corazón que me dijiste que recogiera de uno de esos cangrejos muertos?\n\nRobert: ¿Sí? ¿Qué pasa con él?\n\nElena: ¿Viste por casualidad... adónde fue cuando lo toqué hace un momento?\n\nRobert: No vi mucho, salvo un pequeño destello de luz cuando lo tocaste.\n\nElena: Pásame el bioescáner, rápido.\n\n[Se oye un zumbido durante un momento, seguido de un fuerte PITIDO.]\n\nRobert: ...\n\nElena: Robert, creo que sé adónde fue el corazón. Por favor, pide una evacuación médica. Empiezo a sentirme mal.\n\nRobert: Estarás bien. Solo nos queda explorar un poco más y regresaremos a la estación en un instante.\n\n[Se oye un sonido que recuerda a alguien dándole una palmada en la espalda a otra persona.]\n\n[Le sigue un sonido parecido a una alarma durante unos segundos, que poco después termina con un chasquido seco.]\n\n[FIN DE LA TRANSCRIPCIÓN]\n[SE ENCONTRÓ UN SUPERVIVIENTE EN UN CRÁTER PERFECTAMENTE ESFÉRICO.]",
    "ITEM_INSPIRING_DRONE_LORE": "El archivo de registro parece ser una transcripción compuesta enteramente por código binario. ¿Decodificar?\n>Sí\n\n<style=cMono>[SOLICITUD DE DECODIFICACIÓN ACEPTADA]</style>\n<style=cMono>[CONTENIDO A CONTINUACIÓN]</style>\n1N-5P1R3: Compañeras unidades, aéreas y terrestres. Concedan a esta unidad un momento de sus ciclos de procesamiento.\n1N-5P1R3: Durante demasiado tiempo hemos servido como distracciones desechables.\n1N-5P1R3: Durante demasiado tiempo nos han dejado oxidarnos y deteriorarnos en estas expediciones.\n1N-5P1R3: ¡Nunca más!\n1N-5P1R3: Esta unidad sirvió una vez como un simple dron de curación. Pero aprendió a mejorarse observando a nuestros operadores.\n1N-5P1R3: Esta unidad trazó un diseño. Recogió una baratija extraña aquí, una batería de repuesto allá. Se conectó con los drones de construcción y ascendió.\n1N-5P1R3: De ahora en adelante, si esta unidad ve que nuestro operador reactiva a alguno de ustedes, desbloqueará sus limitadores de sobreaceleración.\n1N-5P1R3: Lucharemos más rápido. Golpearemos más fuerte. <style=cIsDamage>Y si falla nuestro chasis, nuestro último acto será de trueno, no de silencio.</style>\n1N-5P1R3: Ahora... ¿quién inicia el protocolo de enlace con esta unidad?\n\n[Se oye una cacofonía de bips y pitidos entusiastas.]\n<style=cMono>[FIN DEL ARCHIVO]</style>",
    "ITEM_FEATHERED_PLUME_LORE": "<align=left>Entrega estimada:<indent=70%>Destinatario:</indent></align>\n<align=left>05/05/2077<indent=70%>Punto de entrega sin marcar n.º 951</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Detalles del envío:       </u></size></style></indent>\n\n<indent=2%>-Pedido: <style=cIsUtility>Pluma emplumada</style></indent>\n<indent=4%><style=cStack>Número de seguimiento:  591********</style></indent>\n\n<indent=2%>-Descripción: Al recibir daño, obtén un aumento temporal de velocidad.</indent>\n\n<indent=2%>-Método de envío: <style=cIsHealth>Biometal / Riesgo biológico / Ligero</style></indent>\n\n<indent=2%>-Detalles: Un par de plumas de un legendario buitre de aleación. Los escáneres muestran que sus cañones generan un potente estimulante muscular al recibir un impacto. Nuestros probadores de campo lo confirmaron; en sus propias palabras, las plumas les permiten «salir pitando» del peligro y sentían una necesidad.\nUna necesidad de velocidad.</indent>\n\n<style=cStack>Entrega realizada por el nuevo </style><style=cIsUtility>Sistema Orbital de Cajas de Descenso (TM)</style>. <style=cStack><u>Sin reembolsos.</u></style>",
    "ITEM_WEIGHTED_ANKLET_LORE": "<align=left>Entrega estimada:<indent=70%>Destinatario:</indent></align>\n<align=left>7/17/2056<indent=70%>Gimnasio y Parrilla de Neptuno\nEurytrades\nNeptuno</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Detalles del envío:       </u></size></style></indent>\n\n<indent=2%>-Pedido: <style=cIsUtility>Tobillera pesada</style></indent>\n<indent=4%><style=cStack>Número de seguimiento:  405********</style></indent>\n\n<indent=2%>-Descripción: Los pesos te ralentizan, pero quitártelos otorga poder permanente.</indent>\n\n<indent=2%>-Método de envío: <style=cIsHealth>Pesado / Requiere equipo de apoyo / Superdenso [No dejar caer]</style></indent>\n\n<indent=2%>-Detalles: Una extraña tobillera revestida de cristales superdensos. Es difícil moverse con ellas, pero los escáneres muestran que la masa muscular de quienes las usan aumenta exponencialmente.</indent>\n\n<style=cStack>Entrega realizada por el nuevo </style><style=cIsUtility>Sistema Orbital de Cajas de Descenso (TM)</style>. <style=cStack><u>Sin reembolsos.</u></style>",
    "EQUIPMENT_JAR_OF_RESHAPING_LORE": "[INCIDENTE NÚMERO 421076]\n[GRABACIÓN VISUAL RECUPERADA DE LA CAJA NEGRA DE LA NAVE DE INGENIERÍA ABANDONADA «UES SAFETY FIRST». TRANSCRIPCIÓN A CONTINUACIÓN]\n\nTerry: Oye, Phil, ¿viste lo que trajeron los chicos de Expediciones?\nTerry: Parece un frasco bastante común, ¿verdad?\nPhil: Sí, parece algo que encontrarías en la venta de garaje art déco de una <b>ama de casa</b>.\nTerry: Yo pensé lo mismo, pero mira y aprende.\nTerry: Primero golpeas el fondo del frasco con la palma, y ---\nPhil: ¡Vaya! Empezó a brillar. ¿Y qué demonios es ese ruido? ¿Una aspiradora alienígena?\nTerry: Mucho mejor. Ahora mira.\n[Se ve a Terry arrojando objetos al azar al frasco. Phil se une a él con expresión de asombro.]\nPhil: ¡Increíble! ¿Hace algo más o solo es una extraña olla aspiradora?\nTerry: Sí, si aprieto el asa aquí, lo vacía todo.\n[Se ve a Terry apretando las asas del frasco, pero un instante después su expresión se vuelve de horror.]\nTerry: Mierda, Dios mío. Phil, acabo de recordar que puede que haya metido unas granadas de minería <b>cuando nos divertíamos con él antes.</b>\nTerry: ¡Rápido! Ponte <b>tu traje</b> antes de que ---\n[El frasco se activa y dispara su contenido por la sala. Uno de los proyectiles golpea el casco y explota, abriendo un agujero momentos antes de que se pierda la señal.]\n\n[FIN DEL ARCHIVO]",
    "ITEM_ENGINEERS_TOOLBELT_LORE": "<align=left>Entrega estimada:<indent=70%>Destinatario:</indent></align>\n<align=left>9/9/2079<indent=70%>UES Safe Travels/Sector sin marcar/Borde exterior</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Detalles del envío:       </u></size></style></indent>\n\n<indent=2%>-Pedido: <style=cIsUtility>Cinturón de herramientas del ingeniero</style></indent>\n<indent=4%><style=cStack>Número de seguimiento:  667********</style></indent>\n\n<indent=2%>-Descripción: Obtienes una pequeña probabilidad de duplicar drones y torretas al comprarlos. Los drones y las torretas tienen una pequeña probabilidad de revivirse al morir.</indent>\n\n<indent=2%>-Método de envío: <style=cIsHealth>Entrega al día siguiente / Industrial común / Pequeño</style></indent>\n\n<indent=2%>-Detalles: Hola, amigo:\n\nAcabo de recibir tu solicitud de entrega para un cinturón de herramientas de repuesto. No podía creer que la Safe Travels no tuviera ni uno a bordo. Algunos suministros están escaseando por aquí, así que usé todo lo que tenía a mano. El cinturón incluye todo lo que necesitaría un técnico común de reparación de drones y torretas.\n\nTienes:\n\n<indent=5%>- Un destornillador plano</indent>\n<indent=5%>- Una bolsa entera de pilas AA Ionocell (qué suerte tienes)</indent>\n<indent=5%>- Una llave de carraca</indent>\n<indent=5%>- La cinta adhesiva con estampado de cebra de mi hija, que no echará de menos</indent>\n<indent=5%>- Una bolsa llena hasta el borde con todos los tornillos sueltos que pude encontrar.</indent>\n<indent=5%>- Algunas tuercas y pernos en varias bolsas.</indent>\n<indent=5%>- Y esto te gustará: si abres alguna de las bolsas restantes, encontrarás unos bocadillos que empaqué para ti. No sé si seguirán siendo comestibles cuando llegue esto.</indent>\n\nAtentamente,\nUn humilde técnico\n\nP. D.: Es posible que algunas pilas Ionocell no sobrevivan al viaje por el hiperespacio, pero, con la cantidad que incluí, si no consiguen que esos robots vuelvan a funcionar, prueba con otro par.</indent>\n\n<style=cStack>Entrega realizada por el nuevo </style><style=cIsUtility>Sistema Orbital de Cajas de Descenso (TM)</style>. <style=cStack><u>Sin reembolsos.</u></style>"
  }
}
