        "ROB_HUNK_WEAPON_ADDON_MUP_NAME": "枪托（MUP）",
        "ROB_HUNK_WEAPON_ADDON_MUP_DESC": "MUP 的定制配件，每次扣动扳机可连射 3 发子弹。",
        "ROB_HUNK_WEAPON_ADDON2_MUP_NAME": "红点瞄准镜（MUP）",
