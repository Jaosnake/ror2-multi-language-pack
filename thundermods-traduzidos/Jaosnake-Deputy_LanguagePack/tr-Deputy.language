        "BOG_DEPUTY_BODY_PRIMARY_SHOOT_NAME": "Tetik Dokunuşu",
        "BOG_DEPUTY_BODY_PRIMARY_SHOOT_DESCRIPTION": "<style=cIsUtility>Çevik</style>. <style=cIsDamage>%150 hasar</style> için orta menzilli tabancalarla ateş edin.",
        "BOG_DEPUTY_BODY_SECONDARY_SLING_NAME": "Tabanca Fırlatma",
