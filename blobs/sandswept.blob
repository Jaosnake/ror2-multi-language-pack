			{
				return;
			}
			HealthComponent victim = report.victim;
			if (!Object.op_Implicit((Object)(object)victim))
			{
				return;
			}
			int count = GetCount(attackerBody);
			if (count > 0 && Util.CheckRoll(chance * damageInfo.procCoefficient, attackerBody.master))
			{
				float num = Util.OnHitProcDamage(damageInfo.damage, attackerBody.damage, totalDamage);
				InflictDotInfo val = default(InflictDotInfo);
				val.attackerObject = ((Component)attackerBody).gameObject;
				val.victimObject = ((Component)victim).gameObject;
				val.totalDamage = num;
				val.damageMultiplier = num / 25f;
				val.dotIndex = (DotIndex)1;
				val.maxStacksFromAttacker = uint.MaxValue;
				InflictDotInfo val2 = val;
				if (Object.op_Implicit((Object)(object)attackerBody.inventory))
				{
					StrengthenBurnUtils.CheckDotForUpgrade(attackerBody.inventory, ref val2);
				}
				DotController.InflictDot(ref val2);
			}
		}

		public void ApplyArmourChange(CharacterBody sender, StatHookEventArgs args)
		{
			SmoulderingDocumentController smoulderingDocumentController = default(SmoulderingDocumentController);
			if (sender.HasBuff(SmoulderingDocumentDebuff) && ((Component)sender).TryGetComponent<SmoulderingDocumentController>(ref smoulderingDocumentController))
			{
				float num = Util.ConvertAmplificationPercentageIntoReductionPercentage(burdenBaseDamageReduction * 100f + burdenStackDamageReduction * 100f * (float)(smoulderingDocumentController.stacks - 1)) * -0.01f;
				args.damageMultAdd += num;
				args.attackSpeedMultAdd -= burdenBaseAttackSpeedReduction + burdenStackAttackSpeedReduction * (float)(smoulderingDocumentController.stacks - 1);
			}
		}

