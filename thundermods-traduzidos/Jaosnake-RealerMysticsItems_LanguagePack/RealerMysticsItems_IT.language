    "OBJECTIVE_MYSTICSITEMS_RIFTLENS_FLAVOUR": "Faglie Instabili Rilevate!",
    "OBJECTIVE_MYSTICSITEMS_RIFTLENS_CLOSE_RIFTS": "Chiudi tutte le <color=#66ADFF>Faglie Instabili</color>! ({0}/{1})",
    "SKILL_MYSTICSITEMS_CRYSTALLIZED_NAME": "Cristallizzato",
    "SKILL_MYSTICSITEMS_CRYSTALLIZED_DESCRIPTION": "<color=#FF7F7F>Impossibile usare abilità.</color>",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_0_2P": "Tempo scaduto!",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_0": "{0} ha esaurito il tempo a disposizione!",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_1_2P": "Non sei riuscito a sopportare la pressione.",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_1": "{0} non è riuscito a sopportare la pressione.",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_2_2P": "Il tuo corpo è stato violentemente deformato dalla faglia.",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_2": "Il corpo di {0} è stato violentemente deformato dalla faglia.",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_3_2P": "I poteri ultraterreni ti sopraffanno.",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_3": "I poteri ultraterreni sopraffanno {0}.",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_4_2P": "La tua avidità è stata la tua rovina.",
