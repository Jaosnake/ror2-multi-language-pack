    "GUNSLINGER_GAUNTLET_UNLOCKABLE_NAME": "구원",
    "GUNSLINGER_GAUNTLET_UNLOCKABLE_ACHIEVEMENT_NAME": "구원",
    "GUNSLINGER_GAUNTLET_UNLOCKABLE_ACHIEVEMENT_DESC": "존재의 여섯 가지 양상을 모두 획득하세요.",
