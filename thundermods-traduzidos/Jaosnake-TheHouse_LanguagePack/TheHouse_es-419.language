{
    "es-419": {
        "JAVANGLE_HOUSE_BODY_NAME": "House",
        "JAVANGLE_HOUSE_BODY_DESCRIPTION": "",
        "JAVANGLE_HOUSE_BODY_SUBTITLE": "El jugador loco",
        "JAVANGLE_HOUSE_BODY_LORE": "Hablando de máquinas tragamonedas, acaban de instalar una nueva en la sala de entretenimiento de la nave, la gente ha estado diciendo que la maldita cosa está viva o algo así, locos de m-... ¡¿Que instalaron qué ahora?!",
        "JAVANGLE_HOUSE_BODY_OUTRO_FLAVOR": "..y así se fue, jugando una mala pasada al destino una vez más.",
        "JAVANGLE_HOUSE_BODY_OUTRO_FAILURE": "..y así desapareció, finalmente se le acabó la suerte.",
        "JAVANGLE_HOUSE_BODY_DEFAULT_SKIN_NAME": "House",
        "JAVANGLE_HOUSE_BODY_MASTERY_SKIN_NAME": "Mansion",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "House: Maestría",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Como House, completa el juego o elimínate en Monsoon.",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "House: Maestría",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "House: Gran Maestría",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "Como House, completa el juego o elimínate en Typhoon.",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "House: Gran Maestría",
        "JAVANGLE_HOUSE_PASSIVE_NAME": "El Juego",
        "JAVANGLE_HOUSE_PASSIVE_DESCRIPTION": "En lugar de <style=cIsUtility>Habilidades</style>, House usa <style=cIsUtility>Cartas</style>; cada carta tiene un efecto único. Cuando se usa una carta, su ranura entra en recarga, descartas tu mano y robas 3 cartas nuevas.",
        "JAVANGLE_HOUSE_STANDARDSPREAD_NAME": "Mazo: Distribución estándar",
        "JAVANGLE_HOUSE_STANDARDSPREAD_DESCRIPTION": "Un mazo simplificado, diseñado para ser fácil de usar.\n<style=cSub>[Consulta la pestaña Cartas para ver las cartas de este mazo]</style>",
        "JAVANGLE_HOUSE_FULLHOUSE_NAME": "Mazo: Full House",
        "JAVANGLE_HOUSE_FULLHOUSE_DESCRIPTION": "La experiencia clásica de House.\n<style=cSub>[Consulta la pestaña Cartas para ver las cartas de este mazo]</style>",
        "JAVANGLE_HOUSE_DIVINATION_NAME": "Baraja: Adivinación",
        "JAVANGLE_HOUSE_DIVINATION_DESCRIPTION": "Un mazo complejo que te permite controlar la composición de las cartas.\n<style=cSub>[Consulta la pestaña Cartas para ver las cartas de este mazo]</style>",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_NAME": "BulletArts: Vacío",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_DESCRIPTION": "Dispara un tiro cargado al azar.\nCuando no tienes tiros: no hace nada.",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_NAME": "BulletArts: Disparo rápido",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_DESCRIPTION": "Dispara rápidamente <style=cIsUtility>Disparos estándar</style>.\nCuando no hay disparos: no hace nada.",
        "JAVANGLE_HOUSE_RELOADSTANDARD_NAME": "ReloadArts: Estándar",
        "JAVANGLE_HOUSE_RELOADSTANDARD_DESCRIPTION": "Jugar cualquier carta recarga la ruleta.\n50%/25% de probabilidad de obtener 1/2 municiones especiales aleatorias según el tipo de carta usada (rojo = Perforante/Perdigón/Explosivo, morado = Vacío/Serpiente, gris/verde = cualquiera de las anteriores).\n<style=cSub>[Consulta la pestaña Cartas para ver los disparos y sus efectos]</style>",
        "JAVANGLE_HOUSE_RELOADALLIN_NAME": "ReloadArts: todo incluido",
        "JAVANGLE_HOUSE_RELOADALLIN_DESCRIPTION": "Jugar cualquier carta recarga la rueda.\nCarga 0-6 disparos perforantes/de plomo/explosivos, <style=cArtifact>todos los disparos restantes son Cobra</style>.",
        "JAVANGLE_HOUSE_CARDARTSHOP_NAME": "CardArts: Salto",
        "JAVANGLE_HOUSE_CARDARTSHOP_DESCRIPTION": "Jugar cualquier carta en el aire: te impulsa hacia adelante.",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_NAME": "CardArts: Escanear",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_DESCRIPTION": "Al jugar cualquier carta: lanza la carta hacia adelante, infligiendo <style=cIsDamage>{0}% de daño</style> a los enemigos a corta distancia y <style=cIsUtility>obteniendo una barrera igual al {1}% de tu salud máxima</style> por cada enemigo golpeado.",
        "JAVANGLE_HOUSE_SHUFFLEART_NAME": "ShuffleArts: Ouroboros",
        "JAVANGLE_HOUSE_SHUFFLEART_DESCRIPTION": "Siempre que te quedes sin cartas: vuelve a barajar el mazo y colócalo en la pila de robo.",
        "JAVANGLE_HOUSE_STANDARDSHOT_NAME": "Tiro estándar",
        "JAVANGLE_HOUSE_STANDARDSHOT_DESCRIPTION": "Dispara una bala estándar que inflige <style=cIsDamage>{0}% de daño</style>.",
        "JAVANGLE_HOUSE_PIERCINGSHOT_NAME": "Tiro penetrante",
        "JAVANGLE_HOUSE_PIERCINGSHOT_DESCRIPTION": "Dispara un tiro especial que atraviesa objetivos causando <style=cIsDamage>{0}% de daño</style> a cada uno",
        "JAVANGLE_HOUSE_BUCKSHOT_NAME": "Tiro de plomo",
        "JAVANGLE_HOUSE_BUCKSHOT_DESCRIPTION": "Dispara una ráfaga de escopeta que inflige <style=cIsDamage>{0}% x {1} de daño</style>.",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_NAME": "Disparo explosivo",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_DESCRIPTION": "Dispara un proyectil explosivo que inflige <style=cIsDamage>{0}% de daño</style> en área.",
        "JAVANGLE_HOUSE_SNAKESHOT_NAME": "Tiro de serpiente",
        "JAVANGLE_HOUSE_SNAKESHOT_DESCRIPTION": "Intenta disparar, <style=cSub>falla</style> y procede a recibir <style=cDeath>{0}% de tu salud máxima como daño</style>",
        "JAVANGLE_HOUSE_BLANKSHOT_NAME": "Tiro vacío",
        "JAVANGLE_HOUSE_BLANKSHOT_DESCRIPTION": "Intenta disparar, <style=cSub> falla </style> y parece mareado.",
        "JAVANGLE_HOUSE_MYSTERYSHOT_NAME": "Disparo misterioso",
        "JAVANGLE_HOUSE_MYSTERYSHOT_DESCRIPTION": "Dispara un proyectil completamente aleatorio. Puede ser literalmente cualquier cosa.",
        "JAVANGLE_HOUSE_ACESHOT_NAME": "Disparo",
        "JAVANGLE_HOUSE_ACESHOT_DESCRIPTION": "Carga un disparo gigante que inflige <style=cIsDamage>{0}% de daño</style> a todos los enemigos frente a ti, golpeando a cualquier distancia e incluso a través de paredes",
        "JAVANGLE_HOUSE_7CLUBS_NAME": "7 de Bastos",
        "JAVANGLE_HOUSE_7CLUBS_DESCRIPTION": "Carga <style=cIsUtility>3 Mystery Shots</style> en la rueda de la ruleta. \nE <style=cIsUtility>garantiza</style> que tu próxima bala es <style=cIsUtility>Positiva</style>.",
        "JAVANGLE_HOUSE_7SPADES_NAME": "7 de espadas",
        "JAVANGLE_HOUSE_7SPADES_DESCRIPTION": "Obtén <style=cIsUtility>velocidad de movimiento aumentada</style> y <style=cIsUtility>2 mejoras completamente aleatorias</style> durante {0} segundos.\nAdemás, <style=cIsUtility>garantiza</style> que tu siguiente bala sea un Disparo Perforante.",
        "JAVANGLE_HOUSE_7DIAMONDS_NAME": "7 de Oros",
        "JAVANGLE_HOUSE_7DIAMONDS_DESCRIPTION": "<style=cShrine>Gana oro</style> <style=cSub>(escalas con el costo de los cofres)</style>.",
        "JAVANGLE_HOUSE_7HEARTS_NAME": "7 de Copas",
        "JAVANGLE_HOUSE_7HEARTS_DESCRIPTION": "<style=cIsHealing>Cura el 50% de tu salud máxima</style> y <style=cIsUtility>gana hasta un 50% de Barrera</style> dependiendo de la salud actual.",
        "JAVANGLE_HOUSE_JACKPOT_NAME": "Bote",
        "JAVANGLE_HOUSE_JACKPOT_DESCRIPTION": "Activa aleatoriamente los efectos de ''7 de Tréboles'', ''7 de Diamantes'', ''7 de Corazones'' o ''7 de Picas'' con el doble de efecto, con un 20% de probabilidad de <style=cIsUtility>activarlos todos a la vez</style>.",
        "JAVANGLE_HOUSE_52_NAME": "Captura 52",
        "JAVANGLE_HOUSE_52_DESCRIPTION": "Lanza todas las cartas restantes al aire y vuelve a barajar todo en la pila de robo; cada carta persigue a los enemigos y <style=cIsDamage>inflige cantidades variables de daño</style>.",
        "JAVANGLE_HOUSE_SNAKE_NAME": "ojos de serpiente",
