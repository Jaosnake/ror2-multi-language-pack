    "ROB_HUNK_WEAPON_ADDON3_SG09_DESC": "Ein Spezialteil für die SG-09 R. Fügt ein Visier hinzu, das ihre Wirksamkeit auf große Entfernung und bei Schwachstellentreffern erhöht.",
    "ROB_HUNK_WEAPON_BROOMHC_NAME": "Broom HC",
    "ROB_HUNK_WEAPON_BROOMHC_DESC": "Eine kompakte Hochleistungspistole.",
    "ROB_HUNK_WEAPON_MAGNUM_NAME": "Lightning Hawk",
    "ROB_HUNK_WEAPON_MAGNUM_DESC": "Eine leicht zu führende Magnum mit hoher Durchschlagskraft.",
    "ROB_HUNK_WEAPON_ADDON_MAGNUM_NAME": "Langer Lauf (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON_MAGNUM_DESC": "Ein Spezialteil für die Lightning Hawk, das ihren Schaden auf 3000% erhöht.",
    "ROB_HUNK_WEAPON_ADDON2_MAGNUM_NAME": "Laservisier (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON2_MAGNUM_DESC": "Ein Spezialteil für die Lightning Hawk. Fügt ein Visier hinzu, das ihre Wirksamkeit bei Schwachstellentreffern erhöht.",
    "ROB_HUNK_WEAPON_ADDON3_MAGNUM_NAME": "Ersatzmunition (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON3_MAGNUM_DESC": "Ein Spezialteil für die Lightning Hawk, das die Menge aufgesammelter MAG-Munition deutlich erhöht.",
    "ROB_HUNK_WEAPON_SHOTGUN_NAME": "W-870",
    "ROB_HUNK_WEAPON_SHOTGUN_DESC": "Eine Vorderschaftrepetierflinte im Kaliber 12.",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_NAME": "Drachenatem-Patronen (Schrotflinte)",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_DESC": "Ein Spezialteil für alle Schrotflinten. Ersetzt Schrotpatronen durch Brandmunition, die mehr Schaden verursacht und entzündet.",
    "ROB_HUNK_WEAPON_SLUGGER_NAME": "Slugger",
    "ROB_HUNK_WEAPON_SLUGGER_DESC": "Vorderschaftrepetierflinte im Kaliber 12 mit 4 Schuss Kapazität, die schwere Flintenlaufgeschosse abfeuert.",
    "ROB_HUNK_WEAPON_M3_NAME": "M3",
    "ROB_HUNK_WEAPON_M3_DESC": "Eine halbautomatische Schrotflinte.",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_NAME": "Street Sweeper",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_DESC": "Eine vollautomatische Schrotflinte.",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_NAME": "Panzerabwehrrakete",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_DESC": "Ein Raketenwerfer von verheerender Durchschlagskraft.",
    "ROB_HUNK_WEAPON_ATM_NAME": "ATM-4",
    "ROB_HUNK_WEAPON_ATM_DESC": "Ein rückstoßfreier Raketenwerfer mit unbegrenzter Munition. Leicht, handlich und extrem schlagkräftig.",
    "ROB_HUNK_WEAPON_ATM2_NAME": "ATM-4-Prototyp",
    "ROB_HUNK_WEAPON_ATM2_DESC": "Ein rückstoßfreier Raketenwerfer für 84mm-Geschosse. Die Durchschlagskraft der Rakete richtet mehr Schaden an als die Explosion.",
    "ROB_HUNK_WEAPON_RPG_NAME": "RPG",
    "ROB_HUNK_WEAPON_RPG_DESC": "Ein Raketenwerfer von verheerender Durchschlagskraft.",
    "ROB_HUNK_WEAPON_REVOLVER_NAME": "Quickdraw Army",
    "ROB_HUNK_WEAPON_REVOLVER_DESC": "Ein klassischer Revolver, der Magnum-Patronen verwendet.",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_NAME": "Schnelllader (Quickdraw Army)",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_DESC": "Ein Spezialteil für den Quickdraw Army, mit dem du die Trommel schneller nachladen kannst, wenn sie leer ist.",
    "ROB_HUNK_WEAPON_FLAMETHROWER_NAME": "Chemischer Flammenwerfer",
    "ROB_HUNK_WEAPON_FLAMETHROWER_DESC": "Eine von Umbrella gefertigte Waffe, die mithilfe von Druckgas glühend heiße Flammen erzeugt. Tragbar und nachfüllbar, stets bereit für lange Einsätze.",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_NAME": "Regler (Chemischer Flammenwerfer)",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_DESC": "Ein Spezialteil für den Flammenwerfer. Drosselt den Verbrauch von Flüssigbrennstoff und Druckgas und erlaubt so deutlich längeres Feuern.",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_NAME": "Hochleistungs-Brennstofftank (Chemischer Flammenwerfer)",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_DESC": "Ein Spezialteil für den Flammenwerfer. Steigert die Kraft der Flammen und hinterlässt Feuerspuren auf dem Boden.",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_NAME": "GM-79",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_DESC": "Ein einschüssiger Kipplauf-Granatwerfer, der Brandgranaten abfeuern kann.",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_NAME": "Schulterstütze (GM-79)",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_DESC": "Ein Spezialteil für den GM-79, das den Rückstoß stark mindert und jedem Schuss eine stabilere Flugbahn verleiht.",
    "ROB_HUNK_WEAPON_MGL_NAME": "MGL",
    "ROB_HUNK_WEAPON_MGL_DESC": "Ein Prototyp eines halbautomatischen Granatwerfers für Sprenggranaten.",
    "ROB_HUNK_WEAPON_ADDON_MGL_NAME": "Instandgesetzte Trommel (MGL)",
    "ROB_HUNK_WEAPON_ADDON_MGL_DESC": "Ein Spezialteil für den MGL. Ersetzt die defekte Trommel durch eine funktionstüchtige und ermöglicht halbautomatisches Feuer.",
    "ROB_HUNK_WEAPON_GOLDGUN_NAME": "Goldene Pistole",
    "ROB_HUNK_WEAPON_GOLDGUN_DESC": "Einschüssige Pistole, die alles mit nur 1 Schuss töten kann.",
    "ROB_HUNK_WEAPON_BLUEROSE_NAME": "Blue Rose",
    "ROB_HUNK_WEAPON_BLUEROSE_DESC": "Ein Sechsschuss-Revolver, der zwei Schüsse gleichzeitig abfeuert? Welcher Verrückte denkt sich denn sowas aus?",
    "ROB_HUNK_WEAPON_AR_NAME": "CQBR",
    "ROB_HUNK_WEAPON_AR_DESC": "Ein Sturmgewehr für vollautomatisches Feuer.",
    "ROB_HUNK_WEAPON_ADDON_AR_NAME": "Bajonett (CQBR)",
    "ROB_HUNK_WEAPON_ADDON_AR_DESC": "Ein Spezialteil für das CQBR, das dein Kampfmesser ersetzt und 600% Schaden verursacht.",
    "ROB_HUNK_WEAPON_RAILGUN_NAME": "Ferromagnetische Infanterie-Railgun der Nächsten Generation",
    "ROB_HUNK_WEAPON_RAILGUN_DESC": "Eine tragbare Schienenkanone, entwickelt von Cornell Garner und dem US-Militär zur Vernichtung von Biowaffen im Falle eines Ausbruchs.",
    "ROB_HUNK_WEAPON_MINIGUN_NAME": "Minigun",
    "ROB_HUNK_WEAPON_MINIGUN_DESC": "Eine motorisierte sechsläufige Minigun für 7.62mm-NATO-Munition. Unglaublich hohe Feuerrate und enormer Schaden.",
    "ROB_HUNK_WEAPON_COLT_NAME": "Colt Single Action Army",
    "ROB_HUNK_WEAPON_COLT_DESC": "Die großartigste Handfeuerwaffe aller Zeiten.",
    "ROB_HUNK_WEAPON_ADDON_COLT_NAME": "Langer Lauf (Colt)",
    "ROB_HUNK_WEAPON_ADDON_COLT_DESC": "Ein Spezialteil für den Colt, das seinen Schaden auf 4800% erhöht.",
    "ROB_HUNK_WEAPON_SPARKSHOT_NAME": "Spark Shot",
    "ROB_HUNK_WEAPON_SPARKSHOT_DESC": "Eine Hochspannungswaffe für den Einsatz an Versuchstieren. Das Aufladen dauert eine Weile und die Drähte der Nadeln reißen leicht, aber sie hat ordentlich Wumms.",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_NAME": "Hochspannungskondensator (Spark Shot)",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_DESC": "Ein Spezialteil für die Spark Shot. Ermöglicht das Speichern großer Mengen Hochspannungselektrizität und verkürzt die Zeit zwischen den Schüssen.",
    "ROB_HUNK_WEAPON_SSG_NAME": "SSG",
    "ROB_HUNK_WEAPON_SSG_DESC": "Eine kompakte Kipplauf-Schrotflinte mit starker Streuung.",
    "ROB_HUNK_WEAPON_SHIELD_NAME": "Einsatzschild",
    "ROB_HUNK_WEAPON_SHIELD_DESC": "Blockt diesen beschissenen Mistlaser.",
    "ROB_HUNK_WEAPON_SCANNER_NAME": "EMF-Scanner",
    "ROB_HUNK_WEAPON_SCANNER_DESC": "Ein Gerät, mit dem sich bestimmte elektronische Geräte orten lassen.",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_NAME": "Enterhakenwerfer",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_DESC": "Verschießt einen Enterhaken an einer Seilrutsche, mit dem du dich an jeden gewünschten Ort ziehen kannst.",
    "ROB_HUNK_WEAPON_FRAG_NAME": "Splittergranate",
    "ROB_HUNK_WEAPON_FRAG_DESC": "",
    "ROB_HUNK_WEAPON_FLASHBANG_NAME": "Blendgranate",
    "ROB_HUNK_WEAPON_FLASHBANG_DESC": "",
    "ROB_HUNK_WEAPON_STICKYBOMB_NAME": "Haftbombe",
    "ROB_HUNK_WEAPON_STICKYBOMB_DESC": "",
    "ROB_HUNK_WEAPON_BEHEMOTH_NAME": "Strahlender Behemoth",
    "ROB_HUNK_WEAPON_BEHEMOTH_DESC": "",
    "ROB_HUNK_WEAPON_ATM4_NAME": "ATM-4",
    "ROB_HUNK_WEAPON_ATM4_DESC": "Ein rückstoßfreier Raketenwerfer für 84mm-Geschosse. Die Durchschlagskraft der Rakete richtet mehr Schaden an als die Explosion.",
