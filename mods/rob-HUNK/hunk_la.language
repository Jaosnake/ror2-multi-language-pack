    "ACHIEVEMENT_ROB_HUNK_LIGHTWEIGHT_ACHIEVEMENT_ID_DESCRIPTION": "Ut HUNK, gradum 1 sine ullis rebus absolve.\n<color=#8888>(Sclopeta et instrumenta contra te non computantur)</color>",
    "ACHIEVEMENT_ROB_HUNK_GUERRILLA_ACHIEVEMENT_ID_NAME": "HUNK: Oneratus et Paratus",
