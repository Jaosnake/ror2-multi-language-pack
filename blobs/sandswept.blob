			//IL_003d: Unknown result type (might be due to invalid IL or missing references)
			//IL_0040: Unknown result type (might be due to invalid IL or missing references)
			//IL_006a: Expected I4, but got Unknown
			PickupDef pickupDef = PickupCatalog.GetPickupDef(index);
			float num = baseHealthCost;
			if (Object.op_Implicit((Object)(object)EquipmentCatalog.GetEquipmentDef(pickupDef.equipmentIndex)))
			{
				num *= equipmentCostMultiplier;
				return (int)num;
			}
			ItemTier itemTier = pickupDef.itemTier;
			ItemTier val = itemTier;
			switch (val - 1)
			{
			case 0:
			case 6:
				num *= greenAndVoidGreenCostMultiplier;
				break;
			case 1:
			case 7:
				num *= redAndVoidRedCostMultiplier;
				break;
			case 3:
			case 8:
				num *= yellowAndVoidYellowCostMultiplier;
				break;
			case 2:
				num *= lunarCostMultiplier;
				break;
			}
			return (int)num;
		}
	}
