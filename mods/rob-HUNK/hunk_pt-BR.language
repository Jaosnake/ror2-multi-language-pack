    "ROB_HUNK_WEAPON_SHOTGUN_NAME": "W-870",
    "ROB_HUNK_WEAPON_SHOTGUN_DESC": "Uma espingarda calibre 12 de ação por bombeamento.",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_NAME": "Cartuchos Sopro do Dragão (Espingarda)",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_DESC": "Uma peça personalizada para todas as Espingardas. Substitui os cartuchos por munição incendiária que causa mais dano e incendeia.",
    "ROB_HUNK_WEAPON_SLUGGER_NAME": "Slugger",
    "ROB_HUNK_WEAPON_SLUGGER_DESC": "Espingarda calibre 12 de ação por bombeamento com capacidade para 4 cartuchos que dispara balotes pesados.",
    "ROB_HUNK_WEAPON_M3_NAME": "M3",
    "ROB_HUNK_WEAPON_M3_DESC": "Uma espingarda semiautomática.",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_NAME": "Street Sweeper",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_DESC": "Uma espingarda totalmente automática.",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_NAME": "Foguete Antitanque",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_DESC": "Um lança-foguetes com poder devastador.",
    "ROB_HUNK_WEAPON_ATM_NAME": "ATM-4",
    "ROB_HUNK_WEAPON_ATM_DESC": "Um lança-foguetes sem recuo com munição ilimitada. Leve e fácil de manusear, esta arma possui um grande poder de fogo.",
    "ROB_HUNK_WEAPON_ATM2_NAME": "Protótipo ATM-4",
    "ROB_HUNK_WEAPON_ATM2_DESC": "Um lança-foguetes sem recuo que dispara projéteis de 84mm. O poder perfurante do foguete causa mais dano do que a explosão.",
    "ROB_HUNK_WEAPON_RPG_NAME": "RPG",
    "ROB_HUNK_WEAPON_RPG_DESC": "Um lança-foguetes com poder devastador.",
    "ROB_HUNK_WEAPON_REVOLVER_NAME": "Quickdraw Army",
    "ROB_HUNK_WEAPON_REVOLVER_DESC": "Um revólver antiquado que usa munição magnum.",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_NAME": "Carregador Rápido (Quickdraw Army)",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_DESC": "Uma peça personalizada para a Quickdraw Army que permite preencher o tambor mais rapidamente quando vazio.",
    "ROB_HUNK_WEAPON_FLAMETHROWER_NAME": "Lança-Chamas Químico",
    "ROB_HUNK_WEAPON_FLAMETHROWER_DESC": "Uma arma fabricada pela Umbrella que usa gás pressurizado para produzir chamas incandescentes. Portátil e recarregável, está sempre pronta para longas missões.",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_NAME": "Regulador (Lança-Chamas Químico)",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_DESC": "Uma peça personalizada para o lança-chamas. Restringe o consumo de combustível líquido e gás comprimido, permitindo disparar por muito mais tempo.",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_NAME": "Tanque de Combustível de Alta Qualidade (Lança-Chamas Químico)",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_DESC": "Uma peça personalizada para o lança-chamas. Aumenta a potência das chamas, deixando rastros de fogo no chão.",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_NAME": "GM-79",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_DESC": "Um lança-granadas de tiro único e cano basculante capaz de disparar granadas incendiárias.",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_NAME": "Coronha (GM-79)",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_DESC": "Uma peça personalizada para o GM-79 que reduz drasticamente o recuo e dá a cada disparo uma trajetória mais estável.",
    "ROB_HUNK_WEAPON_MGL_NAME": "MGL",
    "ROB_HUNK_WEAPON_MGL_DESC": "Um protótipo de lança-granadas semiautomático capaz de disparar projéteis explosivos.",
    "ROB_HUNK_WEAPON_ADDON_MGL_NAME": "Tambor Reformado (MGL)",
    "ROB_HUNK_WEAPON_ADDON_MGL_DESC": "Uma peça personalizada para o MGL. Substitui o tambor quebrado por um funcional, permitindo disparos semiautomáticos.",
    "ROB_HUNK_WEAPON_GOLDGUN_NAME": "Arma Dourada",
    "ROB_HUNK_WEAPON_GOLDGUN_DESC": "Pistola com capacidade de 1 projétil capaz de matar qualquer coisa com apenas um tiro.",
    "ROB_HUNK_WEAPON_BLUEROSE_NAME": "Blue Rose",
    "ROB_HUNK_WEAPON_BLUEROSE_DESC": "Um revólver de seis câmaras que dispara dois tiros de uma vez? Que tipo de maluco inventa algo assim?",
    "ROB_HUNK_WEAPON_AR_NAME": "CQBR",
    "ROB_HUNK_WEAPON_AR_DESC": "Um fuzil capaz de disparo totalmente automático.",
    "ROB_HUNK_WEAPON_ADDON_AR_NAME": "Baioneta (CQBR)",
    "ROB_HUNK_WEAPON_ADDON_AR_DESC": "Uma peça personalizada para o CQBR que substitui sua Faca de Combate e causa 600% de dano.",
    "ROB_HUNK_WEAPON_RAILGUN_NAME": "Canhão Elétrico Ferromagnético de Nova Geração para Infantaria",
    "ROB_HUNK_WEAPON_RAILGUN_DESC": "Um canhão elétrico portátil desenvolvido por Cornell Garner e pelo exército dos EUA para eliminar armas biológicas em caso de surto.",
    "ROB_HUNK_WEAPON_MINIGUN_NAME": "Minigun",
    "ROB_HUNK_WEAPON_MINIGUN_DESC": "Uma metralhadora giratória motorizada de seis canos que dispara munição 7.62mm OTAN. Cadência de tiro incrivelmente rápida e causa muito dano.",
    "ROB_HUNK_WEAPON_COLT_NAME": "Colt Single Action Army",
    "ROB_HUNK_WEAPON_COLT_DESC": "A maior pistola já feita.",
    "ROB_HUNK_WEAPON_ADDON_COLT_NAME": "Cano Longo (Colt)",
    "ROB_HUNK_WEAPON_ADDON_COLT_DESC": "Uma peça personalizada para a Colt que aumenta seu dano para 4800%.",
    "ROB_HUNK_WEAPON_SPARKSHOT_NAME": "Spark Shot",
    "ROB_HUNK_WEAPON_SPARKSHOT_DESC": "Uma arma de alta voltagem para uso em cobaias. Carregar leva um tempo e os fios das agulhas arrebentam facilmente, mas ela também dá um baita tranco.",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_NAME": "Condensador de Alta Voltagem (Spark Shot)",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_DESC": "Uma peça personalizada para o Spark Shot. Permite armazenar uma grande quantidade de eletricidade de alta voltagem, reduzindo o tempo entre disparos.",
    "ROB_HUNK_WEAPON_SSG_NAME": "SSG",
    "ROB_HUNK_WEAPON_SSG_DESC": "Uma espingarda compacta de cano basculante com alta dispersão.",
    "ROB_HUNK_WEAPON_SHIELD_NAME": "Escudo Antimotim",
    "ROB_HUNK_WEAPON_SHIELD_DESC": "Bloqueia a porcaria daquele laser desgraçado.",
    "ROB_HUNK_WEAPON_SCANNER_NAME": "Scanner EMF",
    "ROB_HUNK_WEAPON_SCANNER_DESC": "Um dispositivo capaz de localizar certos componentes eletrônicos.",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_NAME": "Hookshot",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_DESC": "Dispara um gancho preso a uma tirolesa que permite impulsionar-se até qualquer local desejado.",
    "ROB_HUNK_WEAPON_FRAG_NAME": "Granada de Fragmentação",
    "ROB_HUNK_WEAPON_FRAG_DESC": "",
