{
    "eo": {
        "ENFORCER_NAME": "Enforcer",
        "ENFORCER_DESCRIPTION": "La Enforcer estas defenda koloso, kiu povas elteni kaj doni baton.<color=#CCD3E0>\n\n< ! > Riot Shotgun povas trapiki tra multaj malamikoj samtempe.\n\n< ! > Forbato de malamikoj per Shield Bash certigas, ke vi tenos malamikojn je sekura distanco.\n\n< ! > Uzu Tear Gas por malfortigi grandajn arojn de malamikoj, poste alproksimigxu kaj dispremu ilin.\n\n< ! > Kiam vi povas, uzu Protect and Serve kontraux muroj por malebligi, ke malamikoj flankatakas vin.\n\n</color>",
        "ENFORCER_SUBTITLE": "Neskuebla Bastiono",
        "ENFORCER_LORE": "\n<style=cMono>\"Vi ne devas fari cxi tion.\"</style>\n\nLa vortoj resonis en lia kapo, tamen li pusxis antauxen. La kapsulo estis nur kelkajn pasxojn for -- li havis sxancon foriri -- sed io en lia kerno tenis lin movigxanta. Li ne sciis kio gxi estis, sed li ne pridemandis gxin. Gxi estis natura forto: la sama forto, kiu cxiam pelis lin sekvi ordonojn.\n\nCxi-foje, tamen, gxi ne sxajnis tiel natura. Ne estis ordonoj. La peza ellasilo kaj gxia ritma tondro estis liaj -- kaj nur liaj.",
        "ENFORCER_OUTRO_FLAVOR": "..kaj tiel li foriris, necerta pri sia titolo kiel protektanto.",
        "ENFORCER_OUTRO_FAILURE": "..kaj tiel li malaperis, la malplimultoj de la planedo finfine en paco.",
        "ENFORCER_PRIMARY_SHOTGUN_NAME": "Tumultpafilo",
        "ENFORCER_PRIMARY_SHOTGUN_DESCRIPTION": "Pafu mallongdistancan eksplodon, kiu <style=cIsUtility>trapikas</style> por <style=cIsDamage>6x60% da damagxo.</style>",
        "ENFORCER_PRIMARY_SUPERSHOTGUN_NAME": "Super-Pafilo",
        "ENFORCER_PRIMARY_SUPERSHOTGUN_DESCRIPTION": "Pafu gxis 2 pafilbatojn por <style=cIsDamage>8x80% da damagxo</style>.\nDum uzado de <style=cIsUtility>Protect and Serve</style>, pafu <style=cIsDamage>ambaux tubojn samtempe.</style>",
        "ENFORCER_PRIMARY_RIFLE_NAME": "Peza Mitralo",
        "ENFORCER_PRIMARY_RIFLE_DESCRIPTION": "Elpafu salvon da kugloj por <style=cIsDamage>130% da damagxo</style>.\nDum uzado de <style=cIsUtility>Protect and Serve</style>, havas <style=cIsDamage>pli grandan precizecon</style>, sed <style=cIsHealth>pli malrapidan movrapidecon</style>.",
        "ENFORCER_PRIMARY_HAMMER_NAME": "Romp-Martelo",
        "ENFORCER_PRIMARY_HAMMER_DESCRIPTION": "Svingu vian martelon por <style=cIsDamage>500% da damagxo</style>.\nDum uzado de Protect and Serve, svingu en <style=cIsUtility>pli granda areo</style>, por <style=cIsDamage>1000% da damagxo</style> anstataux tio.",
        "KEYWORD_BASH": "<style=cKeywordName>Bato</style><style=cSub>Aplikas <style=cIsDamage>stuligon</style> kaj <style=cIsUtility>pezan retrobaton</style>.</style>",
        "KEYWORD_SPRINTBASH": "<style=cKeywordName>Sxultra Bato</style><style=cSub><style=cIsDamage>Stuliga.</style> Mallonga impeto, kiu kauxzas <style=cIsDamage>450% da damagxo</style>.\nTrafi <style=cIsDamage>pli pezajn malamikojn</style> kauxzas <style=cIsDamage>700% da damagxo</style>.</style>",
        "ENFORCER_SECONDARY_BASH_NAME": "Sxildbato",
        "ENFORCER_SECONDARY_BASH_DESCRIPTION": "<style=cIsDamage>Stuliga</style>. Forbatu malamikojn por <style=cIsDamage>350% da damagxo</style> kaj <style=cIsUtility>deflektu pafajxojn</style>.\nDum <style=cIsUtility>sprintado</style>, faru <style=cIsDamage>Sxultran Baton</style> anstataux tio.",
        "KEYWORD_BLINDED": "<style=cKeywordName>Difektita</style><style=cSub>Malpliigas movrapidecon je <style=cIsDamage>75%</style>, atakarapidecon je <style=cIsDamage>25%</style> kaj kirason je <style=cIsDamage>30</style>.</style>",
        "ENFORCER_UTILITY_TEARGAS_NAME": "Larmiga Gaso",
        "ENFORCER_UTILITY_TEARGAS_DESCRIPTION": "Jxetu granaton, kiu kovras areon per <style=cIsDamage>Difektiga</style> gaso.",
        "ENFORCER_UTILITY_STUNGRENADE_NAME": "Stuliga Granato",
        "ENFORCER_UTILITY_STUNGRENADE_DESCRIPTION": "<style=cIsDamage>Stuliga</style>. Lancxu granaton, kiu kontuzas malamikojn por <style=cIsDamage>540% da damagxo</style>. Tenu gxis 3.",
        "ENFORCER_UTILITY_TEARGASSCEPTER_NAME": "Mustarda Gaso",
        "ENFORCER_UTILITY_TEARGASSCEPTER_DESCRIPTION": "Jxetu granaton, kiu kovras areon per <style=cIsDamage>Difektiga</style> gaso, sufokante malamikojn por <style=cIsDamage>200% da damagxo po sekundo</style>.",
        "ENFORCER_UTILITY_SHOCKGRENADE_NAME": "Sxokgranato",
        "ENFORCER_UTILITY_SHOCKGRENADE_DESCRIPTION": "<style=cIsDamage>Sxoka</style>. Lancxu granaton, kiu elektrobumas malamikojn por <style=cIsDamage>720% da damagxo</style>. Tenu gxis 3.",
        "ENFORCER_SPECIAL_SHIELDUP_NAME": "Protekti kaj Servi",
        "ENFORCER_SPECIAL_SHIELDUP_DESCRIPTION": "Prenu defendan pozicion, <style=cIsUtility>blokante cxian damagxon de antauxe</style>. <style=cIsUtility>Plibonigas primaran pafadon</style>, sed <style=cIsHealth>malhelpas sprinton kaj salton</style>.",
        "ENFORCER_SPECIAL_SHIELDDOWN_NAME": "Protekti kaj Servi",
        "ENFORCER_SPECIAL_SHIELDDOWN_DESCRIPTION": "Prenu defendan pozicion, <style=cIsUtility>blokante cxian damagxon de antauxe</style>. <style=cIsDamage>Pliigas atakarapidecon</style>, sed <style=cIsHealth>malhelpas sprinton kaj salton</style>.",
        "ENFORCER_SPECIAL_SHIELDON_NAME": "Projekti kaj Flankigxi",
        "ENFORCER_SPECIAL_SHIELDON_DESCRIPTION": "Prenu defendan pozicion, <style=cIsUtility>projektante Energian Sxildon antaux vi</style>. <style=cIsDamage>Pliigas vian pafrapidecon</style>, sed <style=cIsUtility>malhelpas sprinton kaj salton</style>.",
        "ENFORCER_SPECIAL_SHIELDOFF_NAME": "Projekti kaj Flankigxi",
        "ENFORCER_SPECIAL_SHIELDOFF_DESCRIPTION": "Prenu defendan pozicion, <style=cIsUtility>projektante Energian Sxildon antaux vi</style>. <style=cIsDamage>Pliigas vian pafrapidecon</style>, sed <style=cIsUtility>malhelpas sprinton kaj salton</style>.",
        "ENFORCER_SPECIAL_BOARDUP_NAME": "Rultabulo",
