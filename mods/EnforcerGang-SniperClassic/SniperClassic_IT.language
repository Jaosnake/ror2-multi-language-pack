{
  "IT": {
    "SNIPERCLASSIC_BODY_NAME": "Sniper",
    "SNIPERCLASSIC_BODY_SUBTITLE": "Occhio d'aquila",
    "SNIPERCLASSIC_OUTRO_FLAVOR": "..e così partirono, il suono ancora rimbombante in orecchie sorde.",
    "SNIPERCLASSIC_MAIN_ENDING_ESCAPE_FAILURE_FLAVOR": "..e così svanirono, senza che nessuno ne sentisse la mancanza.",
    "SNIPERCLASSIC_PRIMARY_NAME": "Tiro di precisione",
    "SNIPERCLASSIC_PRIMARY_DESCRIPTION": "Spara un colpo perforante per <style=cIsDamage>430% di danno</style>.\nDopo aver sparato, <style=cIsDamage>ricarica</style> per ottenere fino a <style=cIsDamage>1.5x</style> danni extra se sincronizzato correttamente.",
    "SNIPERCLASSIC_RELOAD_NAME": "Ricarica",
    "SNIPERCLASSIC_RELOAD_DESCRIPTION": "Ricarica la tua arma.",
    "SNIPERCLASSIC_PRIMARY_ALT_NAME": "Marcatura",
    "SNIPERCLASSIC_PRIMARY_ALT_DESCRIPTION": "Spara un caricatore di <style=cIsDamage>5</style> colpi perforanti per <style=cIsDamage>360% di danno</style>.\nSuccessivamente, <style=cIsDamage>ricarica</style> e <style=cIsUtility>riduci il tempo di ricarica del tuo Spotter</style> se sincronizzato correttamente.",
    "SNIPERCLASSIC_PRIMARY_ALT2_NAME": "Impatto pesante",
    "SNIPERCLASSIC_PRIMARY_ALT2_DESCRIPTION": "Spara un proiettile da <style=cIsDamage>Mortaio</style> per <style=cIsDamage>540% di danno</style>.\nDopo aver sparato, <style=cIsDamage>ricarica</style> per ottenere fino a <style=cIsDamage>1.5x</style> danni extra se sincronizzato correttamente.",
    "SNIPERCLASSIC_SECONDARY_NAME": "Mira stabile",
    "SNIPERCLASSIC_SECONDARY_DESCRIPTION": "Attiva il tuo <style=cIsUtility>mirino</style> e <style=cIsDamage>carica</style> la tua arma per infliggere fino a <style=cIsDamage>3x danni</style>. Può mirare ai <style=cIsDamage>Punti deboli</style> a <style=cIsDamage>carica completa</style>.",
    "SNIPERCLASSIC_UTILITY_NAME": "Addestramento al combattimento",
    "SNIPERCLASSIC_UTILITY_DESCRIPTION": "Diventa <style=cIsUtility>invisibile</style>. Esegui una <style=cIsUtility>capriola</style> per una breve distanza e <style=cIsDamage>ricarica</style> la tua arma.",
    "SNIPERCLASSIC_UTILITY_BACKFLIP_NAME": "Addestramento militare",
    "SNIPERCLASSIC_UTILITY_BACKFLIP_DESCRIPTION": "<style=cIsDamage>Stordente</style>. Esegui un <style=cIsUtility>salto mortale all'indietro</style> in aria e <style=cIsDamage>ricarica</style> la tua arma.",
    "SNIPERCLASSIC_SPECIAL_NAME": "Spotter: FEEDBACK",
    "SNIPERCLASSIC_SPECIAL_DESCRIPTION": "<style=cIsDamage>Analizza un nemico</style>. Colpiscilo con un attacco con il mirino completamente carico o che infligge almeno <style=cIsDamage>il 1000% dei tuoi danni</style> per folgorare i nemici vicini, infliggendo <style=cIsDamage>il 50% dei danni del colpo che attiva l’effetto</style>. Poi <style=cIsHealth>lo Spotter dovrà ricaricarsi</style>.",
    "SNIPERCLASSIC_SPECIAL_SCEPTER_NAME": "Spotter: SOVRACCARICO",
    "SNIPERCLASSIC_SPECIAL_SCEPTER_DESCRIPTION": "<style=cIsDamage>Analizza un nemico</style>. Colpiscilo con un attacco con il mirino completamente carico o che infligge almeno <style=cIsDamage>il 1000% dei tuoi danni</style> per folgorare i nemici vicini, infliggendo <style=cIsDamage>il 100% dei danni del colpo che attiva l’effetto</style>. Poi <style=cIsHealth>lo Spotter dovrà ricaricarsi</style>.",
    "SNIPERCLASSIC_SPECIAL_ALT_NAME": "Spotter: DISTURBO",
    "SNIPERCLASSIC_SPECIAL_ALT_DESCRIPTION": "<style=cIsDamage>Stordente</style>. <style=cIsDamage>Analizza un nemico</style> per 7 secondi, <style=cIsUtility>distraendo</style> i nemici vicini mentre infligge <style=cIsDamage>7x100% di danno</style>.",
    "SNIPERCLASSIC_SPECIAL_ALT_SCEPTER_NAME": "Spotter: DEFLAGRAZIONE",
    "SNIPERCLASSIC_SPECIAL_ALT_SCEPTER_DESCRIPTION": "<style=cIsDamage>Elettrizzante</style>. <style=cIsDamage>Analizza un nemico</style> per 7 secondi, <style=cIsUtility>distraendo</style> i nemici vicini mentre infligge <style=cIsDamage>7x200% di danno</style>.",
    "KEYWORD_SNIPERCLASSIC_OVERCHARGE": "<style=cKeywordName>Sovraccarico</style><style=cSub>Le cariche extra della <style=cIsUtility>competenza secondaria</style> ti consentono di caricare oltre la carica massima per infliggere danni ancora maggiori.</style>",
    "KEYWORD_SNIPERCLASSIC_WEAKPOINT": "<style=cKeywordName>Punto debole</style><style=cSub>Alcune parti dei nemici sono identificate come contenenti <style=cIsDamage>Punti deboli</style>. Colpire un <style=cIsDamage>Punto debole</style> infligge il <style=cIsDamage>50%</style> di danni in più.</style>",
    "KEYWORD_SNIPERCLASSIC_ANALYZED": "<style=cKeywordName>Analizzato</style><style=cSub>Riduce la velocità di movimento del <style=cIsDamage>40%</style> e riduce l'armatura di <style=cIsDamage>30</style>.</style>",
    "KEYWORD_SNIPERCLASSIC_MORTAR": "<style=cKeywordName>Mortaio</style><style=cSub>Un proiettile esplosivo che guadagna <style=cIsDamage>raggio di esplosione extra</style> con la distanza percorsa.</style>",
    "SNIPERCLASSIC_DESCRIPTION": "Lo Sniper è un sopravvissuto a lungo raggio che opera insieme al suo drone Spotter per infliggere ingenti danni ai bersagli da lontano.<style=cSub>\n\n< ! > Tiro di precisione deve essere ricaricato dopo ogni colpo. Impara i tempi per massimizzare i danni inflitti!\n\n< ! > La velocità d'attacco aumenta la finestra di ricarica perfetta di Tiro di precisione e velocizza la ricarica del tuo Spotter.\n\n< ! > Usa Addestramento militare per fuggire dai nemici mentre carichi Mira stabile.\n\n< ! > Mira stabile combinata con Spotter: FEEDBACK e un colpo di Tiro di precisione perfettamente ricaricato possono spazzare via ondate di nemici!</style>",
    "SNIPERCLASSIC_BODY_LORE": "bio: lo sniper è nato con un potere speciale ed era più forte di tutti i suoi compagni di squadra sulla UES Contact Light. ha prestato servizio nell'esercito di Risk of Rain combattendo contro Providence e nella battaglia finale contro Providence stavano combattendo e Providence lo ha trascinato nell'oscurità e lo sniper si è rivoltato contro HAN-D e lo ha ucciso impedendogli di essere nel seguito. ha ucciso il suo drone Spotter nella battaglia, motivo per cui non è qui, per favore smettetela di mandarmi PM chiedendomi il perché, ecco perché. e poi i mantelli sono una figata, vaffanculo space_cowboy226 tutti sanno che sei un frocio che ruba gli oggetti rossi\n\n<style=cIsHealing>gli piace: cecchinare, fare il duro (stile gearbox), piedi di porco, the reaper (da deadbolt), uccidere, la morte, dubstep, salti mortali all'indietro, razer chroma key, cacciatrici sexy con grandi tette che si vestono da troie, esche, il mietitore (dalla vita reale), cannoni a rotaia, mantelli (quelli fighi, non quelli da checca)</style>\n\n<style=cIsHealth>non gli piacciono: droni Spotter, fuochi fatui, élite frenetici, l'Enforcer della UES -vaffanculo Enforcer smetti di mostrare a tutti i miei log di deviantart pezzo di merda-, Mithrix, piantine da scrivania, space_cowboy226 (mega culo-frocio), pioggia, vita, il Capitano, vermi sovraccarichi</style>\n\n<color=#FF0000>@risk_of_rainin_blood</color>",
    "SNIPERCLASSIC_MASTERY_SKIN_NAME": "Operativo",
    "SNIPERCLASSIC_GRANDMASTERY_SKIN_NAME": "Spedizione",
    "SNIPERCLASSIC_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Sniper: Maestria",
    "SNIPERCLASSIC_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni di Sniper, completa il gioco o annientati a difficoltà Monsoon.",
    "SNIPERCLASSIC_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Sniper: Maestria",
    "SNIPERCLASSIC_GRANDMASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Sniper: Grande Maestria",
    "SNIPERCLASSIC_GRANDMASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni di Sniper, completa il gioco o annientati a difficoltà Typhoon o Eclipse.\n<color=#8888>(La difficoltà Typhoon richiede Starstorm 2)</color>",
