    "ROB_HUNK_BODY_PPASSIVE_NAME": "OSP (On-Site Procurement)",
    "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK can collect <color=#FFFF00>U.C. Keycards</color> to open <style=cIsDamage>weapon cases</style> and expand his arsenal.",
    "ROB_HUNK_BODY_PPASSIVE2_NAME": "Forgotten Soldier",
    "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "The first <style=cIsHealth>boss</style> to die on every stage drops a <style=cIsDamage>supply pack</style> containing one weapon or attachment.",
    "ROB_HUNK_BODY_PASSIVE_NAME": "Grim Struggle",
    "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Start with a <style=cIsDamage>LE 5</style> and <style=cIsDamage>sidearm</style>. You can <style=cIsDamage>rummage</style> through <style=cIsUtility>chests</style> for ammo.",
    "ROB_HUNK_BODY_PASSIVE2_NAME": "Looming Dread",
    "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "Start with a <style=cIsDamage>full arsenal</style>, <style=cIsHealth>BUT</style> you are now <style=cIsHealth>unable to gain any more ammo</style>.",
    "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "New Game+",
    "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Start with a <style=cIsDamage>LE 5</style> and <style=cIsDamage>sidearm</style>. You can <style=cIsDamage>rummage</style> through <style=cIsUtility>chests</style> for ammo. <style=cIsHealth>All weapon case contents are randomized.</style>",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Supreme Authority",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "Start with <style=cIsHealth>ONLY</style> a <style=cIsDamage>W-870</style>. You can <style=cIsDamage>rummage</style> through <style=cIsUtility>chests</style> for ammo.",
    "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Ultimate Mercenary",
    "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Start with <style=cIsHealth>ONLY</style> a <style=cIsDamage>fully upgraded LE 5</style>. You can <style=cIsDamage>rummage</style> through <style=cIsUtility>chests</style> for ammo. <style=cIsDamage>Special</style> is replaced with <color=#C80202>Mayhem Mode</color>.",
    "ROB_HUNK_BODY_WPASSIVE_NAME": "Complete Global Saturation",
    "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "Start with <style=cIsHealth>ONLY</style> a <style=cIsDamage>sidearm</style>. You can <style=cIsDamage>rummage</style> through <style=cIsUtility>chests</style> for ammo. <style=cIsDamage>Utility</style> is replaced with <color=#C80202>Uroboros</color>.",
    "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Pyromania",
    "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "Start with <style=cIsHealth>ONLY</style> a <style=cIsDamage>Chemical Flamethrower</style>. You can <style=cIsDamage>rummage</style> through <style=cIsUtility>chests</style> for ammo. <style=cIsHealth>Only ONE weapon case spawns per stage.</style>",
    "ROB_HUNK_BODY_CONFIRM_NAME": "Confirm",
    "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "Proceed with the current skill.",
    "ROB_HUNK_BODY_CANCEL_NAME": "Cancel",
    "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "Cancel the current skill.",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Combat Knife",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Looting.</style> <style=cIsDamage>Slash</style> close-range combatants for <style=cIsDamage>200% damage</style>, inflicting <style=cIsHealth>Mangled</style>.",
    "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Close-Quarters Combat)",
    "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Looting.</style> <style=cIsDamage>Kick twice</style> for <style=cIsDamage>200% and 250% damage</style>. If the <style=cIsUtility>second kick</style> connects, follow up with a <style=cIsDamage>Counterattack</style>.",
    "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Scan",
    "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Scan for <style=cIsUtility>unopened weapon cases</style>.",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Grapple",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Shoot a hook to a <style=cIsUtility>distant point</style>, then <style=cIsUtility>reel yourself in</style>. <style=cIsDamage>You can counterattack after landing.</style>",
    "ROB_HUNK_BODY_SHOOT_ATM_NAME": "Fire",
