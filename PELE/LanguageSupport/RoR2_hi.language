    "QUEST_COMPULSION_LEMURIANPOLYMORPH": "{0} के रूप में जीवित रहें। {1:N0} सेकंड",
    "QUEST_COMPULSION_NOHITRUN": "बिना प्रहार झेले {0:N0} दुश्मनों को मारें। ({1:N0}/{0:N0})",
    "QUEST_COMPULSION_SCRAPORPRINTITEMS": "{0:N0} वस्तुओं को स्क्रैप करें। ({1:N0}/{0:N0})",
    "QUEST_COMPULSION_REVIVE": "समय समाप्त होने से पहले पुनर्जीवित करें। {2:N0} सेकंड ({1:N0}/{0:N0})",
    "QUEST_COMPULSION_ORDER": "{0:N0} बार क्रमबद्ध करें। ({1:N0}/{0:N0})",
    "QUEST_COMPULSION_CLOAKEDCHEST": "एक {0} खोलें",
    "QUEST_COMPULSION_REACHAREA": "स्थान बदलने से पहले क्षेत्र तक पहुँचें! {0:N0} सेकंड",
    "QUEST_COMPULSION_METEORSHOWER": "{0:N0} सेकंड तक क्षति न झेलें",
