    "ROB_HUNK_BODY_PPASSIVE_NAME": "OSP (Approvvigionamento sul campo)",
    "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK può raccogliere <color=#FFFF00>Tessere U.C.</color> per aprire <style=cIsDamage>valigette d'armi</style> ed espandere il proprio arsenale.",
    "ROB_HUNK_BODY_PPASSIVE2_NAME": "Soldato Dimenticato",
    "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "Il primo <style=cIsHealth>boss</style> ucciso in ogni livello lascia cadere un <style=cIsDamage>pacchetto di rifornimenti</style> contenente un'arma o un accessorio.",
    "ROB_HUNK_BODY_PASSIVE_NAME": "Lotta Disperata",
    "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "Inizia con un <style=cIsDamage>LE 5</style> e un'<style=cIsDamage>arma secondaria</style>. Puoi <style=cIsDamage>frugare</style> nei <style=cIsUtility>forzieri</style> per trovare munizioni.",
    "ROB_HUNK_BODY_PASSIVE2_NAME": "Terrore Incombente",
    "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "Inizia con un <style=cIsDamage>arsenale completo</style>, <style=cIsHealth>MA</style> ora sei <style=cIsHealth>incapace di ottenere altre munizioni</style>.",
    "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "Nuova Partita+",
    "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "Inizia con un <style=cIsDamage>LE 5</style> e un'<style=cIsDamage>arma secondaria</style>. Puoi <style=cIsDamage>frugare</style> nei <style=cIsUtility>forzieri</style> per trovare munizioni. <style=cIsHealth>Il contenuto di tutte le valigette d'armi è casuale.</style>",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "Autorità Suprema",
    "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "Inizia con <style=cIsHealth>SOLO</style> un <style=cIsDamage>W-870</style>. Puoi <style=cIsDamage>frugare</style> nei <style=cIsUtility>forzieri</style> per trovare munizioni.",
    "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Mercenario Definitivo",
    "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Inizia con <style=cIsHealth>SOLO</style> un <style=cIsDamage>LE 5 completamente potenziato</style>. Puoi <style=cIsDamage>frugare</style> nei <style=cIsUtility>forzieri</style> per trovare munizioni. <style=cIsDamage>Speciale</style> è sostituita da <color=#C80202>Modalità Massacro</color>.",
    "ROB_HUNK_BODY_WPASSIVE_NAME": "Saturazione Globale Completa",
    "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "Inizia con <style=cIsHealth>SOLO</style> un'<style=cIsDamage>arma secondaria</style>. Puoi <style=cIsDamage>frugare</style> nei <style=cIsUtility>forzieri</style> per trovare munizioni. <style=cIsDamage>Utilità</style> è sostituita da <color=#C80202>Uroboros</color>.",
    "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "Piromania",
    "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "Inizia con <style=cIsHealth>SOLO</style> un <style=cIsDamage>Lanciafiamme Chimico</style>. Puoi <style=cIsDamage>frugare</style> nei <style=cIsUtility>forzieri</style> per trovare munizioni. <style=cIsHealth>Appare UNA sola valigetta d'armi per livello.</style>",
    "ROB_HUNK_BODY_CONFIRM_NAME": "Conferma",
    "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "Procedi con l'abilità attuale.",
    "ROB_HUNK_BODY_CANCEL_NAME": "Annulla",
    "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "Annulla l'abilità attuale.",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Coltello da Combattimento",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Saccheggio.</style> <style=cIsDamage>Colpisci di taglio</style> i combattenti ravvicinati per <style=cIsDamage>200% di danno</style>, infliggendo <style=cIsHealth>Dilaniato</style>.",
    "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Combattimento Ravvicinato)",
    "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Saccheggio.</style> <style=cIsDamage>Sferra due calci</style> per <style=cIsDamage>200% e 250% di danno</style>. Se il <style=cIsUtility>secondo calcio</style> va a segno, prosegui con un <style=cIsDamage>Contrattacco</style>.",
    "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Scansiona",
    "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Scansiona per individuare le <style=cIsUtility>valigette d'armi non aperte</style>.",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Rampino",
    "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Spara un gancio verso un <style=cIsUtility>punto lontano</style>, poi <style=cIsUtility>trascinati fino ad esso</style>. <style=cIsDamage>Puoi contrattaccare dopo l'atterraggio.</style>",
    "ROB_HUNK_BODY_SHOOT_ATM_NAME": "Spara",
    "ROB_HUNK_BODY_SHOOT_ATM_DESCRIPTION": "Spara per <style=cIsDamage>8000% di danno</style>. <style=cIsUtility>Infligge la maggior parte dei danni con colpi diretti.</style>",
    "ROB_HUNK_BODY_SHOOT_ATM2_NAME": "Spara",
    "ROB_HUNK_BODY_SHOOT_ATM2_DESCRIPTION": "Spara per <style=cIsDamage>8000% di danno</style>. <style=cIsUtility>Infligge la maggior parte dei danni con colpi diretti.</style>",
    "ROB_HUNK_BODY_SHOOT_RPG_NAME": "Spara",
