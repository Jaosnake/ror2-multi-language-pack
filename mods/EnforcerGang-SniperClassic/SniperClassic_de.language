{
  "de": {
    "SNIPERCLASSIC_BODY_NAME": "Sniper",
    "SNIPERCLASSIC_BODY_SUBTITLE": "Adlerauge",
    "SNIPERCLASSIC_OUTRO_FLAVOR": "..und so zogen sie davon, das Klingeln noch in tauben Ohren.",
    "SNIPERCLASSIC_MAIN_ENDING_ESCAPE_FAILURE_FLAVOR": "..und so verschwand er, von niemandem vermisst.",
    "SNIPERCLASSIC_PRIMARY_NAME": "Snipe",
    "SNIPERCLASSIC_PRIMARY_DESCRIPTION": "Feuere einen durchdringenden Schuss für <style=cIsDamage>430% Schaden</style> ab.\nLade nach dem Schuss <style=cIsDamage>nach</style>, um bei korrektem Timing bis zu <style=cIsDamage>1,5x</style> Bonusschaden zu erhalten.",
    "SNIPERCLASSIC_RELOAD_NAME": "Nachladen",
    "SNIPERCLASSIC_RELOAD_DESCRIPTION": "Lade deine Waffe nach.",
    "SNIPERCLASSIC_PRIMARY_ALT_NAME": "Markierung",
    "SNIPERCLASSIC_PRIMARY_ALT_DESCRIPTION": "Feuere ein Magazin mit <style=cIsDamage>5</style> durchdringenden Schüssen für <style=cIsDamage>360% Schaden</style> ab.\nLade danach <style=cIsDamage>nach</style>, um bei korrektem Timing <style=cIsUtility>die Abklingzeit deines Spotters zu verringern</style>.",
    "SNIPERCLASSIC_PRIMARY_ALT2_NAME": "Schwerer Einschlag",
    "SNIPERCLASSIC_PRIMARY_ALT2_DESCRIPTION": "Feuere ein <style=cIsDamage>Mörser</style>-Projektil für <style=cIsDamage>540% Schaden</style> ab.\nLade nach dem Schuss <style=cIsDamage>nach</style>, um bei korrektem Timing bis zu <style=cIsDamage>1,5x</style> Bonusschaden zu erhalten.",
    "SNIPERCLASSIC_SECONDARY_NAME": "Zielsicher",
    "SNIPERCLASSIC_SECONDARY_DESCRIPTION": "Aktiviere dein <style=cIsUtility>Zielfernrohr</style> und <style=cIsDamage>lade</style> deine Waffe für bis zu <style=cIsDamage>3x Schaden</style> auf. Kann bei <style=cIsDamage>voller Ladung</style> <style=cIsDamage>Schwachpunkte</style> treffen.",
    "SNIPERCLASSIC_UTILITY_NAME": "Kampftraining",
    "SNIPERCLASSIC_UTILITY_DESCRIPTION": "Werde <style=cIsUtility>unsichtbar</style>. <style=cIsUtility>Rolle</style> eine kurze Distanz und <style=cIsDamage>lade deine Waffe nach</style>.",
    "SNIPERCLASSIC_UTILITY_BACKFLIP_NAME": "Militärausbildung",
    "SNIPERCLASSIC_UTILITY_BACKFLIP_DESCRIPTION": "<style=cIsDamage>Betäubend</style>. Mache einen <style=cIsUtility>Rückwärtssalto</style> in die Luft und <style=cIsDamage>lade deine Waffe nach</style>.",
    "SNIPERCLASSIC_SPECIAL_NAME": "Spotter: RÜCKMELDUNG",
    "SNIPERCLASSIC_SPECIAL_DESCRIPTION": "<style=cIsDamage>Analysiere einen Gegner</style>. Triff ihn mit einem Angriff mit voll aufgeladenem Zielfernrohr oder mit mindestens <style=cIsDamage>1000% deines Schadens</style>, um Gegner in der Nähe mit <style=cIsDamage>50% des auslösenden Schadens</style> zu schocken. Danach <style=cIsHealth>muss sich dein Spotter aufladen</style>.",
    "SNIPERCLASSIC_SPECIAL_SCEPTER_NAME": "Spotter: ÜBERLADUNG",
    "SNIPERCLASSIC_SPECIAL_SCEPTER_DESCRIPTION": "<style=cIsDamage>Analysiere einen Gegner</style>. Triff ihn mit einem Angriff mit voll aufgeladenem Zielfernrohr oder mit mindestens <style=cIsDamage>1000% deines Schadens</style>, um Gegner in der Nähe mit <style=cIsDamage>100% des auslösenden Schadens</style> zu schocken. Danach <style=cIsHealth>muss sich dein Spotter aufladen</style>.",
    "SNIPERCLASSIC_SPECIAL_ALT_NAME": "Spotter: STÖRUNG",
    "SNIPERCLASSIC_SPECIAL_ALT_DESCRIPTION": "<style=cIsDamage>Betäubend</style>. <style=cIsDamage>Analysiere einen Gegner</style> für 7 Sekunden, was nahe Gegner <style=cIsUtility>ablenkt</style> und <style=cIsDamage>7x100% Schaden</style> verursacht.",
    "SNIPERCLASSIC_SPECIAL_ALT_SCEPTER_NAME": "Spotter: AUSBRUCH",
    "SNIPERCLASSIC_SPECIAL_ALT_SCEPTER_DESCRIPTION": "<style=cIsDamage>Schockend</style>. <style=cIsDamage>Analysiere einen Gegner</style> für 7 Sekunden, was nahe Gegner <style=cIsUtility>ablenkt</style> und <style=cIsDamage>7x200% Schaden</style> verursacht.",
    "KEYWORD_SNIPERCLASSIC_OVERCHARGE": "<style=cKeywordName>Überladung</style><style=cSub>Zusätzliche <style=cIsUtility>sekundäre Vorräte</style> erlauben dir, über die volle Ladung hinaus aufzuladen, um noch mehr Schaden zu verursachen.</style>",
    "KEYWORD_SNIPERCLASSIC_WEAKPOINT": "<style=cKeywordName>Schwachpunkt</style><style=cSub>Körperteile von Gegnern werden als <style=cIsDamage>Schwachpunkte</style> identifiziert. Das Treffen eines <style=cIsDamage>Schwachpunkts</style> verursacht <style=cIsDamage>50%</style> mehr Schaden.</style>",
    "KEYWORD_SNIPERCLASSIC_ANALYZED": "<style=cKeywordName>Analysiert</style><style=cSub>Verringert die Bewegungsgeschwindigkeit um <style=cIsDamage>40%</style> und verringert die Rüstung um <style=cIsDamage>30</style>.</style>",
    "KEYWORD_SNIPERCLASSIC_MORTAR": "<style=cKeywordName>Mörser</style><style=cSub>Ein explosives Projektil, das mit zurückgelegter Distanz einen <style=cIsDamage>größeren Explosionsradius</style> erhält.</style>",
    "SNIPERCLASSIC_DESCRIPTION": "Der Sniper ist ein Fernkampf-Überlebender, der mit seiner Spotter-Drohne zusammenarbeitet, um Zielen aus der Ferne massiven Schaden zuzufügen.<style=cSub>\n\n< ! > Snipe muss nach jedem Schuss nachgeladen werden. Verinnerliche das Timing, um deinen Schaden zu maximieren!\n\n< ! > Angriffsgeschwindigkeit vergrößert das Zeitfenster für perfektes Nachladen und beschleunigt das Aufladen des Spotters.\n\n< ! > Nutze Militärausbildung, um Gegnern auszuweichen, während du Zielsicher auflädst.\n\n< ! > Zielsicher in Kombination mit Spotter: RÜCKMELDUNG und einem perfekt nachgeladenen Snipe kann ganze Horden von Gegnern auslöschen!</style>",
    "SNIPERCLASSIC_BODY_LORE": "bio: sniper wurde mit einer einzigartigen fähigkeit geboren er war stärker als all seine kameraden auf der ues contact light. er diente im militär von risk of rain und kämpfte gegen providence und im letzten kampf gegen providence haben sie gekämpft und providence hat ihn auf die dunkle seite gebracht und sniper fiel HAN-D in den rücken und hat ihn umgebracht weshalb er nicht im sequel ist. er hat seinen eigenen spotter getötet und deswegen ist sie nicht hier bitte hört auf mich zu PM'n und zu fragen warum denn das ist der grund. und capes sind cool fick dich space_cowboy226 jeder weiß dass du ein rotes-item stehlender faggot bist\n\n<style=cIsHealing>mag: snipen, cool sein (gearbox style), brecheisen, den reaper (aus deadbolt), töten, tod, dubstep, rückwärtssaltos, razor chroma key, heiße jägerinnen mit großen titten die es mögen sich wie schlampen anzuziehen, köder, den reaper (im echten leben), railguns, capes (die coolen capes nicht die schwulen capes)</style>\n\n<style=cIsHealth>mag nicht: spotter-drohnen, irrlichter, rasende elites, den enforcer von der ues fick dich enforcer hör auf jedem meine deviantart logs zu zeigen du stück scheiße, mithrix, tischpflanzen, space_cowboy226 (mega arsch-faggot), regen, leben, den captain, überladene würmer</style>\n\n<color=#FF0000>@risk_of_rainin_blood</color>",
    "SNIPERCLASSIC_MASTERY_SKIN_NAME": "Operativ",
    "SNIPERCLASSIC_GRANDMASTERY_SKIN_NAME": "Expedition",
    "SNIPERCLASSIC_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Sniper: Meisterschaft",
    "SNIPERCLASSIC_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Gewinne als Sniper das Spiel oder lösche dich auf Monsoon aus.",
    "SNIPERCLASSIC_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Sniper: Meisterschaft",
    "SNIPERCLASSIC_GRANDMASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Sniper: Grand Mastery",
    "SNIPERCLASSIC_GRANDMASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Gewinne als Sniper das Spiel oder lösche dich auf Typhoon oder Eclipse aus.\n<color=#8888>(Die Schwierigkeit Typhoon erfordert Starstorm 2)</color>",
