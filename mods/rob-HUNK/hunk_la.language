    "ROB_HUNK_BODY_SMGPASSIVE_NAME": "Mercenarius Ultimus",
    "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "Incipe cum <style=cIsHealth>TANTUM</style> <style=cIsDamage>LE 5 plene amplificato</style>. <style=cIsUtility>Arcas</style> <style=cIsDamage>perscrutari</style> potes pro munitione. <style=cIsDamage>Specialis</style> substituitur a <color=#C80202>Modo Cladis</color>.",
