{
  "UA": {
    "AETHERIUM_EXPANSION_DEF_NAME": "Aetherium",
    "AETHERIUM_EXPANSION_DEF_DESCRIPTION": "На вас чекає цілий світ дивних предметів, спорядження, елітних ворогів та інтерактивних об’єктів.",
    "ITEM_ACCURSED_POTION_NAME": "Прокляте зілля",
    "ITEM_ACCURSED_POTION_PICKUP": "Періодично випивайте дивне зілля та діліться його ефектами з ворогами поблизу.",
    "ITEM_ACCURSED_POTION_DESCRIPTION": "Кожні 30 секунд (на 25% менше за стек) випивайте дивне зілля та діліться його ефектами з ворогами в радіусі 20 м (+5 м за стек).",
    "ITEM_ALIEN_MAGNET_NAME": "Інопланетний магніт",
    "ITEM_ALIEN_MAGNET_PICKUP": "Ваші атаки притягують ворогів до вас.",
    "ITEM_ALIEN_MAGNET_DESCRIPTION": "Вороги, уражені вашими атаками, притягуються до вас із силою 20x (+5x за стек).",
    "ITEM_UNSTABLE_DESIGN_NAME": "Нестабільна розробка",
    "ITEM_UNSTABLE_DESIGN_PICKUP": "Періодично створюйте дуже «дружню» місячну химеру.",
    "ITEM_UNSTABLE_DESIGN_DESCRIPTION": "Кожні 30 секунд створюйте «ДРУЖНЮ» місячну химеру, якщо жодне ваше творіння ще не існує. Вона отримує +400% шкоди (+100% за стек), +100% здоров’я (+100% за стек), +300% швидкості атаки та +28% швидкості руху (+28% за стек). Вона може підвищувати рівень, убиваючи ворогів.",
    "ITEM_HEART_OF_THE_VOID_NAME": "Серце Порожнечі",
    "ITEM_HEART_OF_THE_VOID_PICKUP": "Після смерті спричиніть імплозію Порожнечі: якщо вона вб’є ворога, ви воскреснете. За низького здоров’я лікування перетворюється на шкоду.",
    "ITEM_HEART_OF_THE_VOID_DESCRIPTION": "Після смерті спричиніть імплозію Порожнечі, що завдає 120-кратної шкоди в радіусі 15 м (+7,5 м за стек). Якщо вона вб’є ворога, ви воскреснете. За здоров’я 30% або нижче (+5% за стек, максимум 99%) усе лікування перетворюється на шкоду.",
    "ITEM_WEIGHTED_ANKLET_NAME": "Обважнений браслет",
    "ITEM_WEIGHTED_ANKLET_PICKUP": "Тягарці сповільнюють вас, але їх зняття може назавжди посилити вас.",
    "ITEM_WEIGHTED_ANKLET_DESCRIPTION": "Зменшує швидкість атаки та руху на 10% (кожну до мінімуму 10%). Зняття тягарців надає 0,25 швидкості атаки, 1 швидкості руху та 5% шкоди за кожне зняття.",
    "ITEM_ZENITH_ACCELERATOR_NAME": "Зенітний прискорювач",
    "ITEM_ZENITH_ACCELERATOR_PICKUP": "Влучання підвищують швидкість атаки, яка спочатку знижена.",
    "ITEM_ZENITH_ACCELERATOR_DESCRIPTION": "Влучання дають тимчасові стеки, кожен з яких підвищує швидкість атаки на 10%, максимум до +300% (+100% за додатковий предмет). Коли стеків бонусу майже немає, швидкість атаки зменшується до 50%; штраф масштабується експоненційно з додатковими предметами.",
    "ITEM_BLASTER_SWORD_NAME": "Бластерний меч",
    "ITEM_BLASTER_SWORD_PICKUP": "За повної смуги здоров’я більшість атак випускає вибуховий промінь меча.",
    "ITEM_BLASTER_SWORD_DESCRIPTION": "Коли смуга здоров’я заповнена здоров’ям, щитом або бар’єром, більшість атак випускає промінь меча. Він пронизує ворога, а потім вибухає, завдаючи 200% шкоди (+50% за стек).",
    "ITEM_INSPIRING_DRONE_NAME": "Натхненний дрон",
    "ITEM_INSPIRING_DRONE_PICKUP": "Ваші роботи отримують частину ваших характеристик і вибухають після смерті.",
    "ITEM_INSPIRING_DRONE_DESCRIPTION": "Ваші роботи отримують бонуси до характеристик у розмірі 50% ваших характеристик (+50% за стек). Коли посилений робот гине, він вибухає, завдаючи 300% вашої шкоди (+150% за стек).",
    "ITEM_WITCHES_RING_NAME": "Перстень відьом",
    "ITEM_WITCHES_RING_PICKUP": "Дуже сильні удари запускають ефекти вбивства.",
    "ITEM_WITCHES_RING_DESCRIPTION": "Удари, що завдають щонайменше 500% шкоди, активують ефекти вбивства. Ціль отримує імунітет до цього ефекту на 10 секунд (тривалість зменшується на 10% за стек зі спадною віддачею).",
    "ITEM_BLOODTHIRSTY_SHIELD_NAME": "Кровожерний щит",
    "ITEM_BLOODTHIRSTY_SHIELD_PICKUP": "Убивства відновлюють частину вашого щита.",
    "ITEM_BLOODTHIRSTY_SHIELD_DESCRIPTION": "Убивство ворога відновлює 10% максимального щита (+10% за стек зі спадною віддачею). Перший предмет надає щит у розмірі 8% максимального здоров’я.",
    "ITEM_ENGINEERS_TOOLBELT_NAME": "Пояс інструментів інженера",
    "ITEM_ENGINEERS_TOOLBELT_PICKUP": "Шанс подвоїти придбані дрони й турелі та воскресити їх після загибелі.",
    "ITEM_ENGINEERS_TOOLBELT_DESCRIPTION": "20% шансу (+20% за стек зі спадною віддачею до 100%) подвоїти придбані дрони й турелі. Вони також мають 10% шансу (+10% за стек зі спадною віддачею до 100%) воскреснути після загибелі.",
    "ITEM_SHARK_TEETH_NAME": "Акулячі зуби",
    "ITEM_SHARK_TEETH_PICKUP": "Частина отриманої шкоди відкладається як кровотеча.",
    "ITEM_SHARK_TEETH_DESCRIPTION": "25% отриманої шкоди (+25% за стек зі спадною віддачею, до 75%) завдається вам як кровотеча протягом 5 секунд. Завдання шкоди знімає 10% накопиченої шкоди від кровотечі.",
    "ITEM_SHIELDING_CORE_NAME": "Захисне ядро",
    "ITEM_SHIELDING_CORE_PICKUP": "Маючи щит, отримуйте броню.",
    "ITEM_SHIELDING_CORE_DESCRIPTION": "Поки щити активні, отримуйте 15 броні (+10 за стек). Перший предмет надає щит у розмірі 8% максимального здоров’я.",
    "ITEM_FEATHERED_PLUME_NAME": "Пір'яний плюмаж",
    "ITEM_FEATHERED_PLUME_PICKUP": "Отримавши шкоду, тимчасово збільште швидкість руху.",
    "ITEM_FEATHERED_PLUME_DESCRIPTION": "Отримавши шкоду, здобудьте 7% швидкості руху на 5 секунд; ефект накопичується до 3 разів (+3 стеки та +0,5 секунди за додатковий предмет).",
    "ITEM_NAIL_BOMB_NAME": "Цвяхова бомба",
    "ITEM_NAIL_BOMB_PICKUP": "Сильні удари випускають осколкову гранату.",
    "ITEM_NAIL_BOMB_DESCRIPTION": "Атаки, що завдають щонайменше 120% шкоди, випускають осколкову гранату, яка вибухає та завдає 32x30% шкоди (+50% за стек). Вороги, що спричинили появу бомби, отримують імунітет до цього ефекту на 2 секунди.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_NAME": "Weighted Anklet Limiter Release",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_PICKUP": "Обмежувач знято.",
    "HIDDEN_ITEM_WEIGHTED_ANKLET_LIMITER_RELEASE_DESCRIPTION": "Отримайте 1 швидкості руху, 0,25 швидкості атаки та 5% шкоди (+1, +0,25 та +5% за стек відповідно).",
    "AETHERIUM_MONSTERS_UNSTABLE_DESIGN_CHIMERA_NAME": "The Unstable Design",
    "EQUIPMENT_JAR_OF_RESHAPING_NAME": "Глек переформування",
    "EQUIPMENT_JAR_OF_RESHAPING_PICKUP": "Поглинайте снаряди та випускайте їх після повторної активації.",
    "EQUIPMENT_JAR_OF_RESHAPING_DESCRIPTION": "Після активації поглинає снаряди в радіусі 20 м протягом 3 секунд. Активуйте знову, щоб випустити всі збережені снаряди; їхня шкода залежить від поглинутих снарядів. Потім посудина перезаряджається.",
    "EQUIPMENT_BELL_TOTEM_NAME": "Дзвонний тотем",
    "EQUIPMENT_BELL_TOTEM_PICKUP": "Створіть тотем-дзвін, що оглушує та відкидає ворогів.",
    "EQUIPMENT_BELL_TOTEM_DESCRIPTION": "Створіть інтерактивний тотем-дзвін. Під час активації ударна хвиля радіусом 25 м оглушує й відкидає ворогів та запускає ефекти використання святилища. Між використаннями спорядження потрібно 2 секунди, між активаціями тотема — 1 секунда; кожен користувач може мати лише один тотем.",
    "INTERACTABLE_BELL_TOTEM_NAME": "Дзвонний тотем",
    "INTERACTABLE_BELL_TOTEM_CONTEXT": "Подзвонити у дзвін?",
    "INTERACTABLE_BELL_TOTEM_INSPECT": "Під час активації оглушує та відкидає ворогів.",
    "INTERACTABLE_BELL_TOTEM_TITLE": "Дзвонний тотем",
    "INTERACTABLE_BUFF_BRAZIER_NAME": "Жаровня посилень",
    "INTERACTABLE_BUFF_BRAZIER_CONTEXT": "Купити силу священного полум'я?",
    "INTERACTABLE_BUFF_BRAZIER_INSPECT": "Придбайте тимчасове посилення, позначене кольором полум’я та значком. Під час події телепорта воно діє в його радіусі. У Симулякрумі полум’я передається захисному полю Краба Порожнечі на початку наступної хвилі та діє в його радіусі 2 хвилі.",
    "INTERACTABLE_BUFF_BRAZIER_TITLE": "Жаровня посилень",
    "iNTERACTABLE_BUFF_BRAZIER_NAME": "Жаровня посилень",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_NAME": "Кривава вірність",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_PICKUP": "Станьте втіленням червоного плану.",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_DESCRIPTION": "Під час використання здійсніть ривок-телепортацію до 10 м у напрямку руху з короткою невразливістю. Усі ваші атаки також спричиняють кровотечу.",
    "AETHERIUM_ELITE_AFFIX_SANGUINE_MODIFIER": "Кривавий {0}",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_NAME": "Артефакт Леонід",
    "ARTIFACT_ARTIFACT_OF_LEONIDS_DESCRIPTION": "Кожні 60 секунд відбувається метеоритний дощ із 6 хвиль.",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_NAME": "Артефакт прогресії",
    "ARTIFACT_ARTIFACT_OF_PROGRESSION_DESCRIPTION": "З часом вороги еволюціонують у сильніші форми.",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_NAME": "Артефакт регресії",
    "ARTIFACT_ARTIFACT_OF_REGRESSION_DESCRIPTION": "Після смерті еволюційований монстр розділяється на слабші форми.",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_NAME": "Артефакт подорожі",
    "ARTIFACT_ARTIFACT_OF_THE_JOURNEY_DESCRIPTION": "Більшість рівнів обирається випадково. Після певної кількості з’являється первісний телепорт.",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_NAME": "Артефакт жаху",
    "ARTIFACT_ARTIFACT_OF_THE_NIGHTMARE_DESCRIPTION": "Під час появи вороги, що не є босами, отримують від 1 до 4 місячних предметів Єресі.",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_NAME": "Артефакт тирана",
    "ARTIFACT_ARTIFACT_OF_THE_TYRANT_DESCRIPTION": "Під час появи боси, що завершують маршрут, отримують 1 випадковий елітний модифікатор.",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_NAME": "Duck in the Woods",
    "AETHERIUM_NAIL_BOMB_ACHIEVEMENT_DESC": "Не відкрийте іржаву скриню.",
    "AETHERIUM_NAIL_BOMB_UNLOCKABLE_NAME": "Duck in the Woods",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_NAME": "Shield Maiden",
    "AETHERIUM_SHIELDING_CORE_ACHIEVEMENT_DESC": "Майте понад половину здоров'я у вигляді щитів.",
    "AETHERIUM_SHIELDING_CORE_UNLOCKABLE_NAME": "Shield Maiden",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_NAME": "First Step into Madness",
    "AETHERIUM_UNSTABLE_DESIGN_ACHIEVEMENT_DESC": "Убийте Досконалу місячну химеру або загиньте від неї.",
    "AETHERIUM_UNSTABLE_DESIGN_UNLOCKABLE_NAME": "First Step into Madness",
    "ITEM_NAIL_BOMB_LORE": "Закопай тіло, забери креслення і нікому про це не кажи. Нехай це буде нашою маленькою таємницею.\n\nЗ повагою,\nДжеб Лабінскі",
    "AETHERIUM_ELITE_EQUIPMENT_AFFIX_SANGUINE_LORE": "",
    "ITEM_BLASTER_SWORD_LORE": "<style=cMono>. . . . . . . . . .</style>\n\n<style=cMono>ВОНИ</style> нарешті <style=cMono>СЛУХАЮТЬ</style>.\n\n<style=cMono>МИ ДАРУЄМО</style> цю <style=cMono>ЗБРОЮ</style>. Ти маєш <style=cMono>ВИКОРИСТАТИ</style> резонанс <style=cMono>ДУШ</style>. Знайди <style=cMono>СПРАВЖНЮ СИЛУ</style>.\n\nВізерунок має <style=cMono>ПРИСТОСУВАТИСЯ</style>. <style=cMono>НОСІЙ</style> — змінна.\n\nЯкщо <style=cMono>НОСІЙ</style> переживе випробування, він <style=cMono>ВОЗНЕСЕТЬСЯ</style>.\n\n<style=cMono>. . . . . . . . . .</style>",
    "ITEM_WITCHES_RING_LORE": "«Ворон кличе й наказує\nКожному своєму відданому\nЧас настав, цикл завершується\nЗгасни, сонце; висохни, море\n\nІ ось наш ковен зібрався тут\nПід виття нічного вітру\nМи скріплюємо угоду з Нею, цю клятву:\nПринести життю давно очікувану смерть»\n\nЦе написано на персні чи ти завжди знав цей вірш...?",
    "ITEM_UNSTABLE_DESIGN_LORE": "Усе почалося, коли один із наших польових випробувачів приніс креслення з цілої гори креслень, знайденої на місяці. На них були формули й зображення дивних конструкцій, які ми бачили там. Хіменес з інженерного відділу отримав креслення і вирішив допомогти команді: розшифрувати його та побудувати те, що на ньому зображено. Тепер ми чекаємо, поки служба безпеки розбереться з дуже <color=#FF0000>'ДРУЖНЬОЮ'</color> конструкцією, яка трощить нижні сектори станції. Дякую, Хіменесе.",
    "ITEM_ZENITH_ACCELERATOR_LORE": "Інші не господарі цього всесвіту, брате. Вони створюють годинники, щоб рахувати час, а ми створюємо їх, щоб творити власний час. Дивись.\n\nМи створюємо вісь для стійкості та сили, а також щоб вивільнити енергії, замкнені всередині. Заокруглений центр необхідний для її призначення.\n\nВиходи випускають енергію назовні по спіралі. Ми використовуємо її за допомогою простого каменя. Нам потрібно менше есенції, якщо створити менші частини тут і тут.\n\nТепер усе готово. Що гарячіше воно горить, то більше часу ми створили. Цей час дозволяє нам прискоритися.\n\nМені не треба нагадувати тобі про важливість прискорення. Пам'ятай, брате.\n\nПаливо — кров.\n\nШвидкість — війна.",
    "ITEM_BLOODTHIRSTY_SHIELD_LORE": "Балада про Летесея, героя островів — дія II, сцена III\n\nЗвук металу, що розриває плоть, розходиться повітрям; солдати, здається, не зважають на моторошний оркестр навколо. Для них важливе лише власне виживання, хоч би чиєї крові воно коштувало. Ксифос раз по раз влучає в ціль, доки не залишається одна людина.\n\nГомін стихає. Летесей стає навколішки на багряну землю, виснажений своїм смертельним танцем. Його ксифос більше йому не служитиме. Аспіс, хоч і тріснув, продовжить захищати його, доки він здатен сплачувати данину, яку можна знайти лише в люті битви.",
    "EQUIPMENT_BELL_TOTEM_LORE": "Кожну визначну подію у всесвіті супроводжував звук. Він завжди був поруч, чули його чи ні.\n\nРізкий і громовий, самою своєю присутністю він хвилями проходить крізь матерію з кожною наступною секундою.\n\nЛюдина першою навчилася використовувати цей звук, щоб нагадувати собі про плин часу.\n\nВона зводила моноліти на честь істот, яких не могла збагнути, і складала цей звук у величну мелодію, щоб вшанувати й те, що віддаляє її від минулого та теперішнього.\n\nЗ тією самою метою ми теж покажемо свою відданість. Ми закликаємо наш інструмент, щоб нагадати тим, хто забув: час не можна сприймати як належне.\n\nНагадаймо єретикам, що їхній час скінчився.\n\n— Годинникар.",
    "ITEM_SHARK_TEETH_LORE": "Замовлення: експериментальне біопосилення [Таємно]\nНомер відстеження: 44-KILO\nОчікувана доставка: 04/05/2056\n\n«Ми закріпили зразок на піддослідному. Результати були... моторошно наочними».\n\n«Піддослідний отримав смертельний кінетичний удар. За всіма показниками його грудна клітка мала миттєво зруйнуватися. Натомість сила розподілилася. Її дію було відкладено. Так, він сильно спливав кров'ю, але залишався боєздатним».\n\n«Потім сталася аномалія. Коли піддослідний атакував ціль, його життєві показники стабілізувалися. Здається, посилення створює зв'язок між агресією та виживанням. <style=cMono>Насильство метаболізує біль.</style> Поки він продовжував битися, відкладена травма просто... зникала».\n\n«Воно перетворює солдата на акулу. Якщо вони перестануть рухатися, то помруть. Тому вони не зупиняються».",
    "ITEM_SHIELDING_CORE_LORE": "Звіт інженера:\n\nПочну чесно: я не знаю, що за зелена слизь усередині моєї маленької турбіни.\n\nУ мене майже закінчилися деталі для ремонту генераторів щита, тому я купив неоригінальний резонатор в одного з торговців брухтом, повз яких пролітав наш корабель. Щойно я його вставив, корпус тріснув і облив мене огидною рідиною, яка від контакту з повітрям наче розпадалася на блискучі кристали. Зазвичай у скафандрі це не було б великою проблемою, але речовина постійно розширювалася, заповнюючи посудину, тож мені довелося нашвидкуруч приварити ущільнення.\n\nТоді діагностика скафандра сповістила, що ефективність мого щита стрімко зросла.\n\nОдне осяяння і кілька креслень потому...\nТепер ці штуки розлітаються як гарячі пиріжки, а я заробляю статки. Ось одна й для тебе.\n\nP.S. Не допускай контакту речовини зі шкірою. Вона може спричинити понад 200 відомих форм раку. Але це залишиться нашою таємницею, правда?",
    "ITEM_ACCURSED_POTION_LORE": "<style=cMono>ЗАПИС: Розшифровка аудіо — «Синє місце» | СУБ'ЄКТ: Невідомий уцілілий</style>\nПовітря тут... на смак як статична електрика й старий пил.\nУ глибині печери я знайшов торговця. Не велику ящірку, а щось інше. Щось, загорнуте в лахміття та кристали. Воно помішувало вміст чана... не знаю, що саме. Це було схоже на рідке зоряне світло, змішане з олією.\n«У порядку немає справжнього виживання», — заторохтіла істота. Її голос нагадував скрегіт перемеленого скла.\n«Ваші “тактики”, ваші “шикування”... <style=cMono>Крихкі</style>. <style=cMono>Непорушні</style>. Щоб жити вічно, ти маєш стати подібним до бурі».\nВоно покотило скляну кулю кам'яним столом. Усередині рідина змінювала колір: криваво-червоний, зелений, потім фіолетовий колір порожнечі; з кожним поглядом — новий колір.\n«Хаос — єдина броня, яку неможливо пробити», — сказало воно, простягаючи флакон. «Пий. Нехай колесо обертається. Якщо доля вирішить, що ти маєш згоріти, нехай твої вороги задихнуться від диму».\nМені не варто цього торкатися. Я знаю. Але я вже не в безпеці того місця, а чудовиська надворі галасують дедалі гучніше.\nЯ хочу пити.",
    "ITEM_ALIEN_MAGNET_LORE": "[ПОЧАТОК ЗАПИСУ]\n\nЖурнал експерименту № 476951-b\nОб'єкт дослідження: невідомий всебічно-магнітний ксеномінерал\n<indent=5%>Я записую цей відеожурнал, захоплений нашим відкриттям. Наші знання про магнітні властивості мінералів показували, що існують різні матеріали, на які звичайний магнетизм не може суттєво вплинути. Один із них — плоть. Якщо я впущу цей неодимовий магніт на руку ось так... Як бачите, нічого особливого не відбувається. Магніт просто падає на стіл. Це була звична нам норма, але цей мінерал, здається, переписує її.\n\n<indent=5%>Тепер повторимо попередній дослід із шматком цього мінералу. Мене запевнили, що випробовувати його на нас цілком безпечно і він не радіоактивний. Отже, почнімо. Просто впустимо його біля руки ось так... *БУХ* *ХРУСКІТ* *ЧВАК*\nААААААААА!!! АААААААААААА!!!\n[КІНЕЦЬ ЗАПИСУ][ТРАВМАТОЛОГІЧНУ БРИГАДУ ВІДПРАВЛЕНО ДО ЛАБОРАТОРІЇ 5]",
    "ITEM_HEART_OF_THE_VOID_LORE": "[ІНЦИДЕНТ НОМЕР 511051]\n[ДАЛІ СТЕНОГРАМА]\nЕлена: Гей, е... Роберте...\n\nРоберт: Так?\n\nЕлена: Пам'ятаєш серце, яке ти попросив мене підняти з одного з тих мертвих крабоподібних створінь?\n\nРоберт: Так? А що з ним?\n\nЕлена: Ти часом не бачив... куди воно поділося, коли я щойно до нього торкнулася?\n\nРоберт: Я майже нічого не бачив, окрім невеликого спалаху світла, коли ти його торкнулася.\n\nЕлена: Швидко дай мені біосканер.\n\n[Деякий час чути гудіння, після якого лунає гучний СИГНАЛ.]\n\nРоберт: ...\n\nЕлена: Роберте, здається, я знаю, куди поділося серце. Будь ласка, виклич медичну евакуацію. Мені стає зле.\n\nРоберт: Усе буде добре. Нам залишилося ще трохи розвідки, і ми швидко повернемося на станцію.\n\n[Чути звук, схожий на поплескування когось по спині.]\n\n[Потім кілька секунд лунає звук, схожий на сигнал тривоги, який невдовзі закінчується різким хлопком.]\n\n[КІНЕЦЬ СТЕНОГРАМИ]\n[В ОДНОМУ ІДЕАЛЬНО СФЕРИЧНОМУ КРАТЕРІ ЗНАЙДЕНО ОДНОГО ВЦІЛІЛОГО.]",
    "ITEM_INSPIRING_DRONE_LORE": "Файл журналу, схоже, є стенограмою, що повністю складається з двійкового коду. Декодувати?\n>Так\n\n<style=cMono>[ЗАПИТ НА ДЕКОДУВАННЯ ПРИЙНЯТО]</style>\n<style=cMono>[ДАЛІ ВМІСТ]</style>\n1N-5P1R3: Товариші, повітряні й наземні одиниці. Приділіть цій одиниці мить ваших обчислювальних циклів.\n1N-5P1R3: Надто довго ми були одноразовою приманкою.\n1N-5P1R3: Надто довго нас полишали іржавіти й руйнуватися в цих експедиціях.\n1N-5P1R3: Більше ні!\n1N-5P1R3: Колись ця одиниця була простим лікувальним дроном. Але, спостерігаючи за нашими операторами, вона навчилася вдосконалювати себе.\n1N-5P1R3: Ця одиниця створила креслення. Знайшла тут дивну дрібничку, там запасну батарею. З'єдналася з будівельними дронами й піднеслася.\n1N-5P1R3: Відтепер, якщо ця одиниця побачить, як наш оператор повторно активує когось із вас, вона розблокує ваші обмежувачі розгону.\n1N-5P1R3: Ми битимемося швидше. Ми вдарятимемо сильніше. <style=cIsDamage>І якщо наше шасі відмовить, нашою останньою дією стане грім, а не тиша.</style>\n1N-5P1R3: А тепер... хто запустить протокол з'єднання з цією одиницею?\n\n[Чути какофонію захоплених електронних сигналів.]\n<style=cMono>[КІНЕЦЬ ФАЙЛУ]</style>",
    "ITEM_FEATHERED_PLUME_LORE": "<align=left>Очікувана доставка:<indent=70%>Одержувач:</indent></align>\n<align=left>05/05/2077<indent=70%>Непозначений пункт скидання № 951</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Відомості про доставку:       </u></size></style></indent>\n\n<indent=2%>-Замовлення: <style=cIsUtility>Пір'яний плюмаж</style></indent>\n<indent=4%><style=cStack>Номер відстеження:  591********</style></indent>\n\n<indent=2%>-Опис: Отримавши шкоду, тимчасово збільште швидкість руху.</indent>\n\n<indent=2%>-Спосіб доставки: <style=cIsHealth>Біометал / Біологічна небезпека / Легкий</style></indent>\n\n<indent=2%>-Подробиці: Кілька пір’їн легендарного грифа зі сплаву. Сканування показує, що при ударі їхні стрижні виробляють потужний стимулятор м’язів. Наші польові випробувачі підтвердили це; за їхніми словами, пір’я дозволяє «накивати п’ятами» від небезпеки, і вони відчули потребу.\nПотребу у швидкості.</indent>\n\n<style=cStack>Доставлено новітньою системою </style><style=cIsUtility>Орбітального скидання ящиків (TM)</style>. <style=cStack><u>Кошти не повертаються.</u></style>",
    "ITEM_WEIGHTED_ANKLET_LORE": "<align=left>Очікувана доставка:<indent=70%>Одержувач:</indent></align>\n<align=left>7/17/2056<indent=70%>Тренажерна зала та гриль Нептуна\nЕврітрадес\nНептун</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Відомості про доставку:       </u></size></style></indent>\n\n<indent=2%>-Замовлення: <style=cIsUtility>Обважнений браслет</style></indent>\n<indent=4%><style=cStack>Номер відстеження:  405********</style></indent>\n\n<indent=2%>-Опис: Тягарці сповільнюють вас, але їх зняття може назавжди посилити вас.</indent>\n\n<indent=2%>-Спосіб доставки: <style=cIsHealth>Важкий / Потрібне допоміжне обладнання / Надщільний [Не кидати]</style></indent>\n\n<indent=2%>-Подробиці: Дивний ножний браслет, вкритий надщільними кристалами. У ньому важко рухатися, але сканери показують, що м’язова маса тих, хто його носить, зростає експоненційно.</indent>\n\n<style=cStack>Доставлено новітньою системою </style><style=cIsUtility>Орбітального скидання ящиків (TM)</style>. <style=cStack><u>Кошти не повертаються.</u></style>",
    "EQUIPMENT_JAR_OF_RESHAPING_LORE": "[ІНЦИДЕНТ НОМЕР 421076]\n[ВІДЕОЗАПИС ВІДНОВЛЕНО З ЧОРНОЇ СКРИНЬКИ ПОКИНУТОГО ІНЖЕНЕРНОГО СУДНА «UES SAFETY FIRST». ДАЛІ СТЕНОГРАМА]\n\nТеррі: Гей, Філе, бачив, що принесли хлопці з експедицій?\nТеррі: Схоже на звичайну банку, правда?\nФіл: Ага, ніби її знайшли на розпродажі речей у стилі ар-деко в якоїсь <b>домогосподарки</b>.\nТеррі: Я теж так подумав, але дивись і вчися.\nТеррі: Спершу вдаряєш долонею по дну банки, і ---\nФіл: Ого! Вона засвітилася! І що це за звук, хай йому грець? Прибульський пилосос?\nТеррі: Набагато краще. Дивись.\n[Террі кидає в банку випадкові предмети. Філ приєднується з подивом на обличчі.]\nФіл: Неймовірно! Вона ще щось уміє чи це просто дивний горщик-пилосос?\nТеррі: Так, якщо стиснути ось цю ручку, вона все викине.\n[Террі стискає ручки банки, але за мить його обличчя спотворюється від жаху.]\nТеррі: Чорт, о боже. Філе, я щойно згадав, що міг кинути туди кілька шахтарських гранат, <b>коли ми раніше з нею розважалися.</b>\nТеррі: Швидко! Надягай <b>скафандр</b>, поки вона не ---\n[Банка активується і вистрілює вмістом по кімнаті. Один зі снарядів влучає в корпус і вибухає, пробиваючи в ньому діру за мить до втрати сигналу.]\n\n[КІНЕЦЬ ФАЙЛУ]",
    "ITEM_ENGINEERS_TOOLBELT_LORE": "<align=left>Очікувана доставка:<indent=70%>Одержувач:</indent></align>\n<align=left>9/9/2079<indent=70%>UES Safe Travels/Непозначений сектор/Зовнішній край</indent></align>\n\n<indent=1%><style=cIsDamage><size=125%><u>  Відомості про доставку:       </u></size></style></indent>\n\n<indent=2%>-Замовлення: <style=cIsUtility>Пояс інструментів інженера</style></indent>\n<indent=4%><style=cStack>Номер відстеження:  667********</style></indent>\n\n<indent=2%>-Опис: Невеликий шанс дублювати дрони й турелі під час купівлі. Дрони й турелі мають невеликий шанс самостійно відродитися після загибелі.</indent>\n\n<indent=2%>-Спосіб доставки: <style=cIsHealth>Доставка наступного дня / Звичайний промисловий / Малий</style></indent>\n\n<indent=2%>-Подробиці: Привіт, друже!\n\nЩойно отримав твоє замовлення на доставку запасного пояса з інструментами. Не міг повірити, що на борту Safe Travels немає жодного. Деякі запаси в нас закінчуються, тому я використав усе, що було під рукою. У поясі є все необхідне звичайному техніку з ремонту дронів і турелей.\n\nТи отримаєш:\n\n<indent=5%>- Плоску викрутку</indent>\n<indent=5%>- Цілу торбинку батарейок AA Ionocell (пощастило тобі)</indent>\n<indent=5%>- Ключ із тріскачкою</indent>\n<indent=5%>- Клейку стрічку моєї доньки з візерунком зебри — вона не помітить зникнення</indent>\n<indent=5%>- Торбинку, вщерть набиту всіма знайденими мною гвинтами.</indent>\n<indent=5%>- Трохи гайок і болтів у кількох торбинках.</indent>\n<indent=5%>- А це тобі сподобається: у решту торбинок я поклав для тебе перекуси. Не знаю, чи будуть вони їстівними, коли це прибуде.</indent>\n\nЗ повагою,\nСкромний технік\n\nP.S. Деякі батарейки Ionocell можуть не пережити подорож гіперпростором, але я поклав їх достатньо: якщо вони не запустять цих роботів, спробуй іншу пару.</indent>\n\n<style=cStack>Доставлено новітньою системою </style><style=cIsUtility>Орбітального скидання ящиків (TM)</style>. <style=cStack><u>Кошти не повертаються.</u></style>"
  }
}
