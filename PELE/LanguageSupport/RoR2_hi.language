    "COST_HOLLOWCOST_FORMAT": "{0} अंतर्दृष्टि",
    "ITEM_HOLLOW_NAME": "अंतर्दृष्टि का बीज",
    "ITEM_HOLLOW_PICKUP": "किसी दूसरी दुनिया की एक झलक। आपको विभिन्न यातनाओं के अधीन करता है। तीव्रता अंतर्दृष्टि के साथ बढ़ती है।",
    "ITEM_HOLLOW_DESCRIPTION": "किसी भी स्रोत से पहली बार अंतर्दृष्टि प्राप्त करने पर मिलता है। इसे हटाया नहीं जा सकता। उसकी अवधारणाओं के लोक में अंतर्दृष्टि और इसके विपरीत, आप पर उसके ध्यान का प्रतिनिधित्व करता है। इस वस्तु को धारण करने पर, आप विभिन्न यातनाओं के अधीन होते हैं, जो अंतर्दृष्टि के साथ बढ़ती हैं।",
    "ITEM_HOLLOW_LORE": "कथा निर्माणाधीन",
    "TOOLTIP_ITEM_DISABLED": "{0}\n\n<style=cStack>निष्क्रिय।</style> कोई भी लाभ लागू नहीं होता है।",
    "INSPECT_ITEM_DISABLED": "{0}\n\nयह वस्तु <style=cStack>निष्क्रिय</style> है। कोई भी लाभ लागू नहीं होता है।",
    "NOTIFICATION_ITEM_DISABLED": "यह वस्तु <style=cStack>निष्क्रिय</style> कर दी गई है। कोई भी प्रभाव लागू नहीं होता है।",
    "INSPECT_ITEM_MAGNIFIED": "{0}\n\n<style=cIsHealing>आवर्धित</style>। वस्तु के प्रभावों को इस प्रकार गुणा करता है मानो आपके पास इसकी और अधिक प्रतियाँ हों।",
    "RULE_HEADER_KEYITEMS": "मुख्य वस्तुएँ",
    "RULE_HEADER_KEYITEMS_SUBTITLE": "दुनिया में प्रकट हो सकने वाली मुख्य वस्तुओं को बंद और चालू करें।",
    "RULE_HEADER_KEYITEMS_EDIT": "मुख्य वस्तुओं को सक्षम और अक्षम करें।",
    "RULE_KEYITEM_ON_DESCRIPTION": "इस मुख्य वस्तु को दुनिया में प्रकट होने के लिए सक्षम करता है।",
    "RULE_KEYITEM_OFF_DESCRIPTION": "इस मुख्य वस्तु को दुनिया में प्रकट होने से अक्षम करता है।",
