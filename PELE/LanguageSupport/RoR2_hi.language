    "ITEM_SYRINGE_DESC": "<style=cIsDamage>हमले की गति</style> में <style=cIsDamage>15% <style=cStack>(हर अतिरिक्त प्रति पर +15%)</style></style> की वृद्धि।",
    "ITEM_BEAR_NAME": "और कठिन दिन",
    "ITEM_BEAR_PICKUP": "मिलने वाली क्षति रोकने का मौका।",
    "ITEM_BEAR_DESC": "<style=cIsHealing>15%</style> <style=cStack>(हर अतिरिक्त प्रति पर +15%)</style> संभावना है कि मिलने वाली क्षति <style=cIsHealing>रुक जाए</style>। <style=cIsUtility>भाग्य का इस पर असर नहीं पड़ता</style>।",
