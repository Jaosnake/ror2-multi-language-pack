    "OBJECTIVE_SHELTER": "Найдите <style=cDeath>укрытие <sprite name=\"TP\" tint=1></style> от бури!",
    "OBJECTIVE_WISHBONE": "Соберите <style=cIsDamage>Вилочки</style>",
    "OBJECTIVE_METEORDEFAULT_2R4R": "Надвигается метеоритный шторм",
    "OBJECTIVE_LIGHTNING_2R4R": "Надвигается гроза",
    "OBJECTIVE_FIRE_2R4R": "Надвигается огненная буря",
    "OBJECTIVE_COLD_2R4R": "Надвигается метель",
    "SHRINE_LUNARGALLERY_USE_MESSAGE_2P": "<style=cShrine>Вы призвали <style=cIsLunar>{1}</style> в битву.</color>",
    "SHRINE_LUNARGALLERY_USE_MESSAGE": "<style=cShrine>{0} призвал <style=cIsLunar>{1}</style> в битву.</color>",
    "SHRINE_CONVERGE_USE_MESSAGE": "Вы приняли испытание Схождения..",
    "SHRINE_CONVERGE_USE_MESSAGE_2P": "{0} принял испытание Схождения..",
    "SHRINE_CONVERGE_BEGIN_MESSAGE": "Да начнётся испытание... Схождения!",
    "ITEM_DISCOUNTCARDUSED_NAME": "Купон (Использован)",
    "ITEM_DISCOUNTCARDUSED_PICKUP": "Терминалы магазинов возвращают часть денег и остаются открытыми. Осталось одно использование.",
    "ITEM_DISCOUNTCARDUSED_DESCRIPTION": "При покупке в <style=cIsUtility>мульти-магазине</style> остальные терминалы <style=cIsUtility>остаются открытыми</style>, возвращая <style=cIsUtility>$20</style>. Осталось одно использование.",
    "ITEM_DISCOUNTCARDSPENT_NAME": "Купон (Потрачен)",
    "ITEM_DISCOUNTCARDSPENT_PICKUP": "Это просто кусок бумаги с кучей дырок.",
    "ITEM_DISCOUNTCARDSPENT_DESCRIPTION": "Это просто кусок бумаги с кучей дырок.",
    "ITEM_BROKENSCALPEL_NAME": "Сломанный скальпель",
    "ITEM_BROKENSCALPEL_PICKUP": "Лезвие разлетелось на бесчисленные осколки.",
    "ITEM_BROKENSCALPEL_DESCRIPTION": "Больше не пригоден к использованию.",
    "ITEM_GAMMAKNIFESTATBOOST_NAME": "Масло ложной души",
    "ITEM_GAMMAKNIFESTATBOOST_PICKUP": "Разрежь кожу и изогни истину...",
    "ITEM_BROKENWISH_NAME": "Кость",
    "ITEM_BROKENWISH_PICKUP": "Обычная половина сломанной вилочки. Повезёт в следующий раз.",
    "ITEM_BROKENWISH_DESCRIPTION": "Обычная половина сломанной вилочки. Повезёт в следующий раз.",
    "ITEM_REGENERATINGSCRAPCONSUMED_NAME": "Лом химеры (Использован)",
    "ITEM_REGENERATINGSCRAPCONSUMED_PICKUP": "Вы думали, он вернётся?",
    "ITEM_REGENERATINGSCRAPCONSUMED_DESC": "Вы думали, он вернётся?",
    "ITEM_HEALINGPOTIONCONSUMED_NAME": "Отвар берсерка (Выпит...?)",
    "ITEM_HEALINGPOTIONCONSUMED_PICKUP": "Вы чувствуете лёгкость.",
