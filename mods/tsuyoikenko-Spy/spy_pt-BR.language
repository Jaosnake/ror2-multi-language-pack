    "KEYWORD_BACKSTAB": "<style=cKeywordName>Golpe pelas Costas</style><style=cSub>Atingir um inimigo pelas costas causa um acerto crítico instantâneo. Inimigos mais fracos são executados instantaneamente.</style>",
    "KEYWORD_ESPIONAGE": "<style=cKeywordName>Espionagem</style><style=cSub>Consumir um acúmulo de Espionagem garante um acerto crítico no próximo disparo de revólver.</style>",
