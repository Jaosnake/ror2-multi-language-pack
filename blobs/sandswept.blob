		}

		private void RecalculateStatsAPI_GetStatCoefficients(CharacterBody sender, StatHookEventArgs args)
		{
			int count = GetCount(sender);
			if (count > 0 && sender.hasCloakBuff)
			{
				args.critAdd += baseCritChanceGain;
				args.critDamageMultAdd += baseCritDamageGain + stackCritDamageGain * (float)(count - 1);
			}
		}

