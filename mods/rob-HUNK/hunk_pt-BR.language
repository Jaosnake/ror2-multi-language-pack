    "ROB_HUNK_WEAPON_ADDON_SMG_DESC": "Uma peça personalizada para a LE 5 que aumenta sua eficácia a longa distância e ao atingir pontos fracos.",
    "ROB_HUNK_WEAPON_ADDON2_SMG_NAME": "Carregador Estendido (LE 5)",
