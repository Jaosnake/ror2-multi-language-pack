    "KENKO_SCOUT_PRIMARY_BONK_NAME": "Elephants Foot",
    "KENKO_SCOUT_PRIMARY_BONK_DESCRIPTION": "<style=cIsUtility>민첩</style>. 방망이를 휘둘러 <style=cIsDamage>{0}% 피해</style>를 입힙니다.",
    "KENKO_SCOUT_SECONDARY_CLEAVER_NAME": "Toxic Cleaver",
    "KENKO_SCOUT_SECONDARY_CLEAVER_DESCRIPTION": "<style=cIsUtility>민첩</style>. 식칼을 던져 <style=cIsDamage>황폐</style>를 유발하고 <style=cIsDamage>{0}% 피해</style>를 입힙니다. <style=cIsDamage>기절</style>한 적에게는 <style=cIsDamage>치명타</style>가 발생하며 <style=cIsHealing>중독</style>시킵니다.",
    "KENKO_SCOUT_SECONDARY_SPIKEDBALL_NAME": "Spike Ball",
    "KENKO_SCOUT_SECONDARY_SPIKEDBALL_DESCRIPTION": "<style=cIsUtility>민첩</style>. 야구공을 쳐서 적을 <style=cIsDamage>기절</style>시키고 <style=cIsDamage>{0}% 피해</style>를 입힙니다. <style=cIsDamage>기절</style> 지속 시간은 날아간 거리에 비례하여 증가합니다.",
    "KENKO_SCOUT_UTILITY_ATOMICBLAST_NAME": "Atomic Blast",
    "KENKO_SCOUT_UTILITY_ATOMICBLAST_DESCRIPTION": "<style=cHumanObjective>Atomic Core</style>를 소모하여 <style=cIsDamage>원자 치명타</style>, <style=cIsDamage>공격 속도</style>, <style=cIsUtility>이동 속도</style>를 얻습니다. 충전량에 따라 주변에 <style=cIsDamage>{0}% - {1}% 피해</style>를 입힙니다.",
    "KENKO_SCOUT_SPECIAL_SWAP_NAME": "교체",
