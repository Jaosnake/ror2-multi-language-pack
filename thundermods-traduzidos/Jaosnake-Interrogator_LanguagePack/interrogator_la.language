{
    "la": {
        "KENKO_INTERROGATOR_NAME": "Interrogator",
        "KENKO_INTERROGATOR_SUBTITLE": "Peritus Tormentorum",
        "KENKO_INTERROGATOR_PASSIVE_NAME": "Tormenta",
        "KENKO_INTERROGATOR_PASSIVE_DESCRIPTION": "Interrogator socios et hostes ferire potest atque ab eis feriri. Impugnatores qui Interrogator feriunt rei notantur.",
        "KENKO_INTERROGATOR_PRIMARY_SWING_DESCRIPTION": "Baculum tuum ante te vibra, <style=cIsDamage>320% damnum</style> faciens. Si impetus fallit, tu ipse <style=cIsDamage>damnum</style> pateris.",
        "KENKO_INTERROGATOR_SECONDARY_AFFRAY_DESCRIPTION": "Cultrum iace qui <style=cIsDamage>450% damnum</style> facit. <style=cIsDamage>Interfector.</style> Si culter scopum necat, Haemorrhagiam et Pressuram in omnes in area applicat.",
        "KENKO_INTERROGATOR_UTILITY_FALSIFY_DESCRIPTION": "Ante te impelle <style=cIsDamage>390% damnum</style> faciens et Reatum in scopos ictus applicans.",
        "KENKO_INTERROGATOR_SPECIAL_CONVICT_NAME": "Damnare",
        "KENKO_INTERROGATOR_SPECIAL_CONVICT_DESCRIPTION": "Reum hostem per 10 secundas duella. Ictus tuus primarius te iam non ferit et in ictu cumulatum Reatus dat. Per duellum, damnum externum tibi negatur, sed damnum aliis hostibus praeter scopum etiam negatur.",
        "KENKO_INTERROGATOR_SPECIAL_SCEPTER_CONVICT_NAME": "Puni",
        "KENKO_INTERROGATOR_SPECIAL_SCEPTER_CONVICT_DESCRIPTION": "Reum hostem per 10 secundas duella. Ictus tuus primarius te iam non ferit et in ictu cumulatum Reatus dat. Per duellum, damnum externum tibi negatur, sed damnum aliis hostibus praeter scopum etiam negatur.\n<color=#d299ff>SCEPTER: Convict hostes etiam sine culpa eligere potest. Damnum quod infers iam non tollitur, sed 75% minuitur.</color>",
        "MASTERY_SKIN_NAME": "Interrogator: Peritus",
        "<style=cKeywordName>Slayer</style><style=cSub>Deals up to <style=cIsDamage>3x</style> damage against low health enemies.</style>": "<style=cKeywordName>Interfector</style><style=cSub>Hostibus parum vitae habentibus usque ad <style=cIsDamage>triplum</style> damnum infert.</style>",
        "KENKO_INTERROGATOR_DESCRIPTION": "Interrogator in dolore aliorum gaudet. Ne nimium gaudeas socios laedendo... vel gaude.<color=#CCD3E0>\n\n< ! > Ab hostibus, sociis atque etiam a te ipso ferire ut attributa augeas. Nemo tutus est.\n\n< ! > Si res habes quae ictu accepto excitantur, Affray utere ut tibi Haemorrhagiam inferas. Sine dolore nihil lucri.\n\n< ! > Falsify hostes reos notare potest. Ineptum moribus? Quid dicis?\n\n< ! > Convict in reum adhibe ut puniatur. Reus est donec innocens probetur.</color>",
        "<style=cKeywordName>Guilty</style><style=cSub>Grants <color=#FFBF66>Interrogator</color> <style=cIsDamage>attack speed</style>, <style=cIsHealing>health regen</style>, and <style=cIsDamage>damage</style> for each <color=#FFBF66>Guilty</color> target.</style>": "<style=cKeywordName>Reus</style><style=cSub>Quisque reus Interrogator celeritatem oppugnandi, regenerationem vitae et damnum auget.</style>",
        "<style=cKeywordName>Ally Damage</style><style=cSub>Allies take and deal less damage to each other and <color=#FFBF66>Guilty</color> expires from them after 10 seconds.</style>": "<style=cKeywordName>Damnum sociorum</style><style=cSub>Socii minus damni inter se inferunt et accipiunt; culpa eorum post 10 secunda evanescit.</style>",
        "<style=cKeywordName>Hemorrhage</style><style=cSub>Deal <style=cIsDamage>2000%</style> base damage over 15s. <i>Hemorrhage</i> can stack.</style>": "<style=cKeywordName>Haemorrhagia</style><style=cSub>Per 15 secunda 2000% damni fundamentalis infert. Haemorrhagia cumulari potest.</style>",
        "<style=cKeywordName>Pressured</style><style=cSub>Boost <style=cIsDamage>attack speed</style> and <style=cIsUtility>move speed</style> but lowers <style=cIsHealing>armor</style> and <style=cIsDamage>damage</style>.</style>": "<style=cKeywordName>Pressus</style><style=cSub>Celeritatem oppugnandi et movendi auget, sed armaturam et damnum minuit.</style>"
    }
}
