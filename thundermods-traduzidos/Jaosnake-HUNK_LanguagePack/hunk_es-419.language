    "ROB_HUNK_STARSBADGE_NAME": "Placa S.T.A.R.S.",
    "ROB_HUNK_STARSBADGE2_NAME": "Llave USB",
    "ROB_HUNK_STARSBADGE_DESC": "Una placa especial de la división de fuerzas especiales del R.P.D., <color=#F20443>S.T.A.R.S.</color> <style=cIsHealth>¿Quizá recoger esto fue una mala idea?</style>",
    "ROB_HUNK_STARSBADGE_DESCFULL": "En cada escenario aparece una caja especial de <color=#F20443>S.T.A.R.S.</color> que solo puede abrirse con esta placa. Sin embargo, el <style=cIsHealth>Nemesis T-Type</style> te cazará sin descanso.",
    "ROB_HUNK_STARSBADGE2_DESC": "Se usa para acceder a un <style=cIsUtility>cofre especial</style> en cada escenario.",
    "ROB_HUNK_STARSBADGE2_DESCFULL": "En cada escenario aparece una caja especial de <color=#F20443>S.T.A.R.S.</color> que solo puede abrirse con esta placa. Sin embargo, el <style=cIsHealth>Nemesis T-Type</style> te cazará sin descanso.",
