    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>Salute: </color>20\n<color=#FF0000>Armatura: </color>7\n\nRotation Velocità: 50\n\nPeso: 27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% di Velocità d'attacco</color>\n <color=#fc8080>-15% di Rigenerazione salute</color>\n <color=#fc8080>+5% di Ricarica totale</color>\n\n<color=#00FF00>Salute: </color>20\n<color=#FF0000>Armatura: </color>2\n\nRotation Velocità: 40\n\nPeso: 20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Salute: </color>10\n<color=#FF0000>Armatura: </color>0\n\nRotation Velocità: 55\n\nPeso: 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Salute: </color>100\n<color=#FF0000>Armatura: </color>20\n\nRotation Velocità: 33\n\nPeso: 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% di Ricarica speciale</color>\n <color=#fc8080>+15% di Ricarica secondaria</color>\n <color=#fc8080>-10% di Velocità d'attacco</color>\n\n<color=#00FF00>Salute: </color>120\n<color=#FF0000>Armatura: </color>23\n\nRotation Velocità: 29\n\nPeso: 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% di Danni</color>\n <color=#fc8080>+10% di Ricarica totale</color>\n\n<color=#00FF00>Salute: </color>160\n<color=#FF0000>Armatura: </color>0\n\nRotation Velocità: 25\nLimite d'Angolo: 90\n\nPeso: 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Salute: </color>45\n<color=#FF0000>Armatura: </color>4\n\nRotation Velocità: 25\n\nPeso: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Salute: </color>35\n<color=#FF0000>Armatura: </color>15\n\nRotation Velocità: 35\n\nPeso: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% di Ricarica primaria</color>\n <color=#fc8080>+8% di Ricarica secondaria</color>\n <color=#fc8080>+8% di Ricarica utilità</color>\n <color=#fc8080>+8% di Ricarica speciale</color>\n <color=#fc8080>-15% di Velocità d'attacco</color>\n\n<color=#00FF00>Salute: </color>35\n<color=#FF0000>Armatura: </color>3\n\nRotation Velocità: 30\n\nPeso: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% di Danni</color>\n\n<color=#00FF00>Salute: </color>5\n<color=#FF0000>Armatura: </color>1\n\nRotation Velocità: 40\nLimite d'Angolo: 30\n\nPeso: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ORIGINALE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "ROSSO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "ROSSO CHIARO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "VERDE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "VERDE SCURO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "BLU",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "CIANO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "ROSA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "ROSA ACCESO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "MAGENTA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "GIALLO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "GIALLO NEON",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "VIOLA NEON",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "ARANCIONE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "BIANCO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "NERO",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Cambia la parte 'luminosa' del veicolo in un colore diverso.  Non influisce sul gameplay.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Sporco",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Pulito",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Mimetica_Frastagliata",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Mimetica_Pixel",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Mimetica_Carta",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Lamiera_Mandorlata",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Piastra_Imbullonata",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Set_Procedurale",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Miscela_Colorata",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Gradiente_Arcobaleno",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Monocromatico",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Galassia_Fluida",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Spazio",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Sistemi del Motore",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Le abilità di utilità e la spinta consumano carburante. Il rifornimento di carburante è influenzato dalla <style=cIsUtility>velocità d'attacco</style>; la capacità di carburante è influenzata dai <style=cIsUtility>postbruciatori</style> e dagli <style=cIsUtility>oggetti di salto</style>. Il carro armato può <style=cIsUtility>scattare in qualsiasi direzione</style>. La spinta consente un controllo versatile in aria. Tuttavia, <color=#fc8080>il carro armato non può saltare normalmente</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Super Armeria",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "La scelta dello scafo e della torretta influenza salute, armatura, velocità, spinta e massa. <style=cIsUtility>Una massa maggiore aiuta a spingere i nemici più pesanti</style>; altrimenti sarai più soggetto al <color=#ffff80>rinculo</color>.\n\nL'armatura o la velocità possono aiutare a compensare la <color=#fc8080>pessima rigenerazione della salute</color> del carro armato.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Instabilità Celestiale",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "Il carro armato non può riequilibrarsi in aria, <color=#ffff80>essendo incline a perdere il controllo</color>. Atterrare sulla testa ti lascia <color=#fc8080>immobilizzato e vulnerabile per un breve periodo</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Propulsori di Volo",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Tieni premuto <style=cIsUtility>Salto</style> per iniziare il volo. La direzione del volo dipende dall'angolo del tuo carro armato. <style=cIsUtility>Il volo più versatile</style>, ma può essere difficile da usare.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Propulsori a Impulso",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Permette al carro armato di <style=cIsUtility>saltare</style> normalmente come gli altri sopravvissuti. L'inclinazione del carro può essere attivata al 2° salto. Ogni salto consuma <color=#ffc080>25</color> di carburante.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Propulsori a Levitazione",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Permette al carro armato di levitare da terra. Tieni premuto <style=cIsUtility>Salto</style> per salire; tieni premuto <style=cIsUtility>LeftAlt</style> per scendere. Salire consuma più carburante.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Mitragliatrici",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Spara costantemente per <style=cIsDamage>2x40% di danni</style>.\n<style=cSub>[Peso: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Fucile a Pompa",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Spara per <style=cIsDamage>12x75% di danni</style>.  <color=#ffc080>Brucia carburante</color> per <style=cIsUtility>ottenere cariche extra</style>; <color=#80fc80>esegui un'acrobazia</color> per ottenere temporaneamente un colpo potente da <style=cIsDamage>18x150% di danni</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 1s</style> | Peso: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Lanciagranate",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Spara proiettili imprecisi per <style=cIsDamage>4x250% di danni</style>.  I proiettili sono esplosivi e pesanti.\n<style=cSub>[<style=cIsUtility>Ricarica: 4s</style> | <style=cIsDamage>Raggio d'Esplosione: 5m</style> | Peso: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Lanciamissili",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Spara missili precisi per il <style=cIsDamage>1000% di danni</style>. <style=cIsDamage>I danni aumentano con la distanza</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 3s</style> | <style=cIsDamage>Raggio d'Esplosione: 8m</style> | Peso: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Lanciafiamme",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Sputa fuoco per il <color=#E85E31>25% di danni da bruciatura</color> ogni <color=#ffc080>15 di carburante al secondo</color>.  I danni aumentano con gli accumuli; <style=cIsUtility>la velocità d'attacco aumenta la portata</style>.\n<style=cSub>[<color=#ffc080>Alimentato a Carburante</color> | Peso: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ultrantenna",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Folgorati</color> e <style=cIsUtility>attiva gli oggetti all'uccisione</style>.  <style=cIsUtility>Toccare i nemici li folgora a sua volta</style>, e subiscono il <style=cIsDamage>250% di danni</style> per ogni oggetto <style=cIsUtility>all'uccisione</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 7s</style> | <style=cIsDamage>Raggio d'Esplosione: 5m</style> | Peso: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Cannone Critico",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Spara per il <color=#ff4d76>1200% di danni critici</color>. La probabilità di critico aumenta i danni del cannone.\n<style=cSub>[<style=cIsUtility>Ricarica: 7s</style> | <style=cIsDamage>Raggio d'Esplosione: 10m</style> | Peso: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Cannone Obice",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Carica per sparare un esplosivo <style=cIsDamage>7000% di danni</style>. <style=cIsUtility>Può lanciare il carro armato se si trova in aria.</style>\n<style=cSub>[<style=cIsUtility>Ricarica: 16s</style> | <style=cIsDamage>Raggio d'Esplosione: 15m</style> | Peso: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Cannone d'Urto",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Spara in modo impreciso per il <style=cIsDamage>1700% di danni</style>. <style=cIsDamage>I danni diminuiscono con la distanza</style>; <style=cIsDamage>gli oggetti ad attivazione aumentano invece i danni</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 3s</style> | <style=cIsDamage>Raggio d'Esplosione: 5m</style> | Peso: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Cannone Perforante",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Spara per il <style=cIsDamage>2500% di danni</style>.  Tieni premuto per calibrare e infliggere il <style=cIsDamage>3500% di danni</style>, capace di <style=cIsUtility>colpire i punti deboli</style>.  Quando è calibrato, <color=#fc8080>muoversi peggiora la precisione</color>.\n<style=cSub>[<style=cIsUtility>Ricarica: 5s</style> | <style=cIsDamage>Raggio d'Esplosione: 2m</style> | Peso: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Cannone Francese",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Spara per un misero <style=cIsDamage>550% di danni</style>. Per qualche motivo, <style=cIsUtility>ha troppa attivazione</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 1s</style> | Peso: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Minigun",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Spara raffiche per il <style=cIsDamage>50% di danni</style>. Al 75% di surriscaldamento infligge <color=#E85E31>fuoco</color>; <color=#fc8080>il surriscaldamento blocca l'arma</color>. <style=cIsUtility>Gli oggetti di ricarica aumentano la velocità di raffreddamento</style>; <style=cIsUtility>i caricatori di riserva prevengono il surriscaldamento</style>.\n<style=cSub>[Peso: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Cannone Base",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Spara un proiettile veloce per il <style=cIsDamage>5400% di danni</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 12s</style> | <style=cIsDamage>Raggio d'Esplosione: 7m</style> | Peso: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Cannone AA",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Spara per il <style=cIsDamage>300% di danni</style>.  Il proiettile detona vicino ai bersagli aerei, infliggendo <style=cIsDamage>2.5x di danni</style>.  <color=#fc8080>Il carro armato rallenta per sparare</color>.\n<style=cSub>[<style=cIsDamage>Raggio d'Esplosione: 5.5m</style> | Peso: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Cannone a Dispersione",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Spara per il <style=cIsDamage>2200% di danni</style> in un <style=cIsUtility>grande arco</style>, spargendo colpi per <style=cIsDamage>10x5% dei danni totali</style>.  I danni aumentano più lontano viaggia, fino al <style=cIsDamage>5500% di danni</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 10s</style> | <style=cIsDamage>Raggio d'Esplosione: 16m</style> | Peso: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Cannone Celestiale",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Consuma <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> di carburante per il <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>di danni</color>.  I laser caricati perforano; <color=#fc8080>il carburante insufficiente disattiva l'arma.</color>\n<style=cSub>[<color=#ffc080>Alimentato a Carburante</color> | Peso: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Cannone Obliteratore",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Carica per sparare automaticamente un <color=#E85E31>proiettile che attiva gli effetti all'uccisione</color> per il <style=cIsDamage>12000% di danni</style>.  Successivamente, <color=#fc8080>le abilità sono disattivate per 4 secondi.  Il proiettile può ferire gli alleati</color>.\n<style=cSub>[<style=cIsUtility>Ricarica: 21s</style> | <style=cIsDamage>Raggio d'Esplosione: 5m</style> | Peso: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Cannone Automatico",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Spara fino a 4 proiettili che infliggono il <style=cIsDamage>2000% di danni</style> ciascuno. L'ultimo proiettile infligge <style=cIsDamage>2x di danni</style> in un punto fisso.\n<style=cSub>[<style=cIsUtility>Ricarica: 14s</style> | <style=cIsDamage>Raggio d'Esplosione: 7m</style> | Peso: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Spazzaneve",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Scatta per una breve distanza</style> per <color=#ffc080>50</color> di carburante. Può respingere <style=cIsUtility>qualsiasi nemico</style> per il <style=cIsDamage>1000% di danni</style> e ripristinare <color=#ffc080>40</color> di carburante.\n<style=cSub>[<style=cIsUtility>Ricarica: 2s</style> | Peso: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Spuntoni",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Scatta per una grande distanza</style> per <color=#ffc080>50</color> di carburante. Sperona i nemici per il <color=#AA2B2A>550% di danni da sanguinamento</color>.  <style=cIsUtility>Non ha tempo di ricarica</style>.\n<style=cSub>[Peso: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Turbo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Sfreccia</style> e consuma <color=#ffc080>30</color> di carburante al secondo.  Può speronare per il <style=cIsDamage>250% di danni</style>. Speronare aggiunge <color=#ffc080>20</color> di carburante.\n<style=cSub>[<style=cIsUtility>Ricarica: 1s</style> | Peso: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Super Salto",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Lanciati in alto per <color=#ffc080>50</color> di carburante.  Mentre scatti, lanciati invece in avanti per <color=#ffc080>75</color> di carburante e fai roteare il carro armato per il <style=cIsDamage>2500% di danni</style>.  Il peso del carro aumenta i danni.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Bulldozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Accelera</style> e consuma <color=#ffc080>20</color> di carburante al secondo.  Può travolgere <style=cIsUtility>qualsiasi nemico</style> per il <style=cIsDamage>200% di danni</style> costanti.  Infligge il <style=cIsDamage>350% di danni</style> all'impatto.\n<style=cSub>[<style=cIsUtility>Ricarica: 1s</style> | Peso: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Carica per <style=cIsUtility>scattare per la massima distanza</style> per <color=#ffc080>100</color> di carburante.  <style=cIsUtility>Travolgi le folle</style> per il <color=#AA2B2A>4000% di danni da sanguinamento</color> e <style=cIsUtility>prolunga lo scatto</style>; gira per terminare lo scatto; <color=#80fc80>esegui un'acrobazia</color> per <style=cIsUtility>saltare la carica</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 7s</style> | Peso: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Scavatrincee",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Tieni premuto per scavare</style>, consumando <color=#ffc080>20</color> di carburante al secondo, <style=cIsUtility>proteggendo il tuo carro armato sottoterra</style>.  Rilascia per emergere e infliggere il <style=cIsDamage>900% di danni</style> ai nemici vicini.  Non puoi attaccare mentre sei sottoterra.\n<style=cSub>[<style=cIsDamage>Raggio d'Esplosione: 10m</style> | Peso: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Mina Reale",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Piazza una mina terrestre che infligge il <style=cIsDamage>3000% di danni</style>.  <style=cIsDamage>Gli oggetti ad attivazione aumentano invece i danni</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 10s</style> | <style=cIsDamage>Raggio d'Esplosione: 10m</style> | Peso: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Mini Mine",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Mira e spargi tutte le mine terrestri in miniatura che infliggono il <style=cIsDamage>750% di danni</style> ciascuna.  Gli oggetti di cariche e interagibili aumentano il massimo di mine.  <color=#ffc080>Brucia carburante</color> per <style=cIsUtility>ottenere cariche extra</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 3s</style> | <style=cIsDamage>Raggio d'Esplosione: 10m</style> | Peso: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Barile Esplosivo",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Lancia un barile per <color=#ffc080>25</color> di carburante che prende fuoco all'impatto per il <style=cIsDamage>6500% di danni</style>, e lascia una <color=#E85E31>pozza infuocata</color>.  <color=#80fc80>Eseguire un'acrobazia</color> rende questa abilità temporaneamente <color=#fc8080>instabile</color>, il che <style=cIsUtility>fa roteare il tuo carro armato all'impazzata</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 14s</style> | <style=cIsDamage>Raggio d'Esplosione: 18m</style> | <style=cIsDamage>Raggio della Zona: 8</style> | Peso: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Autodistruzione",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Annienta <color=#d40000>TUTTI</color> entro 35m per il <style=cIsDamage>100000% di danni</style>.  Inizia con un <color=#80fc80>Dio's Best Friend</color> a ogni nuova partita.\n<style=cSub>[<style=cIsDamage>Raggio d'Esplosione: 35m</style> | Peso: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "REGNO",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Rallenta e carica per sparare una raffica di missili.  I danni aumentano più lontano viaggia, fino a <style=cIsDamage>12x3000% di danni.</style>\n<style=cSub>[<style=cIsUtility>Ricarica: 30s</style> | <style=cIsDamage>Raggio d'Esplosione: 10m</style> | Peso: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Elusione",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Emetti fumo, stordendo i nemici vicini per il <style=cIsDamage>150% di danni</style> e nasconditi.  <style=cIsUtility>Diventa immune</style> ai danni per 1 secondo.\n<style=cSub>[<style=cIsUtility>Ricarica: 12s</style> | <style=cIsDamage>Raggio d'Esplosione: 10m</style> | Peso: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Passiva: Berserk",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Rimuove questa abilità. Aumenta la <style=cIsDamage>velocità d'attacco base di 0.5</style> e riduce il <style=cIsUtility>tempo di ricarica del 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Passiva: Motori",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Rimuove questa abilità. Aumenta la <style=cIsUtility>velocità base di 1m/s</style> e la <style=cIsUtility>potenza di spinta del 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Passiva: Armatura",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Rimuove questa abilità. Aumenta l'<style=cIsUtility>armatura base di 30</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Maestria",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Come Celestial War Tank, batti il gioco o obliterati in Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Maestria",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Cannone Celestiale",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Come Celestial War Tank, torna a casa",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Cannone Celestiale",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Obliteratore",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Come Celestial War Tank, infliggi più di 1,000,000 di danni in un solo colpo.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Obliteratore",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Come Celestial War Tank, batti il gioco o obliterati in Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Corazzato",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Come Celestial War Tank, ottieni 10000 PS.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Corazzato",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "Il carro armato definitivo della distruzione. Resisti a ogni tipo di nemico, travolgendoli e schiacciandoli con il suo peso e le sue armi micidiali!\n\n<style=cSub>< ! > Il carro armato è enorme ed estremamente lento, rendendoti suscettibile a qualsiasi forma di danno. Giocare in modo estremamente difensivo o aggressivo aiuterà a mitigare la quantità di danni che subirai. Sappi che il carro armato non ha cure.\n\n< ! > Lo scafo del carro armato può essere usato per infliggere danni: investi i tuoi nemici o usa il tuo peso per schiacciarli tutti!\n\n< ! > Quando il carro armato si schianta, è più pesante e impiega un po' a rialzarsi, diventando suscettibile a maggiori danni da caduta. Il carro armato non può fare acrobazie.\n\n< ! > I fattori di guarigione sono mitigati: il carro armato ha troppa salute!\n\n< ! > Premi 'T' per suonare il clacson.  Configurabile nelle impostazioni della mod.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Entità Straniera",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Dopo ulteriori ricerche, abbiamo scoperto l'origine di questi carri armati: le mani degli spazzini. Costruiti con rottami di qualità e oggetti della UES, erano riusciti a creare con successo questi carri armati da guerra.\n\nTuttavia, questo porta a conclusioni pericolose. Dopo aver ottenuto una delle antenne nemiche, abbiamo allertato questo colosso di carro armato. È grande quanto le guardie scarabeo!\n\nNaturalmente, dopo una lunga battaglia, siamo finalmente riusciti ad abbatterlo. Speriamo di fare ulteriori ricerche e riprogrammare la sua mente, nella speranza di ottenere risposte migliori. Sarà un compito arduo, poiché È tecnologia aliena.\n\nUna nota gigantesca da tenere a mente è che, una volta sconfitto, ha evocato un portale d'emergenza. Il portale più grande e violento che abbiamo mai visto. Per quanto possa condurci dritti alle risposte, non credo che sarà una passeggiata nel parco. Un carro armato normale è già fin troppo letale, e non sono sicuro di quali altre invenzioni create dagli spazzini ci siano là fuori.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ORIGINALE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "BIANCO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "NERO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "ROSSO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "ROSSO SCURO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "VERDE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "BLU",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "CIANO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "GIALLO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "GIALLO NEON",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "MAGENTA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "VIOLA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "ARANCIONE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "MARRONE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "STATI UNITI",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "GERMANIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "REGNO UNITO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "RUSSIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "FRANCIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "Cambia il colore dello scafo.  Non influisce sul gameplay.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "PRINCIPALE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "GIALLO SPORCO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "VERDE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "VERDE SPORCO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "BLU",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "BLU SPORCO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "ROSSO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "ROSSO SPORCO",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "MAESTRIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Scafo Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Potenza del Motore: </color>3000\n<color=#00FFFF>Velocità: </color>10\nTraverse Velocità: 0.8\n\n<color=#00FF00>Salute: </color>1000\n<color=#FF0000>Armatura: </color>75\n\n<color=#AA00FF>Potenza di Spinta: </color>35\n<color=#ffc080>Quantità di Carburante: </color>500\nPeso: 1000\n\nTipo di Scafo: Carro armato",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Scafo Griffon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Compatibile con torretta</color>.\n\n<color=#FFFF00>Potenza del Motore: </color>2300\n<color=#00FFFF>Velocità: </color>11\nTraverse Velocità: 1\n\n<color=#00FF00>Salute: </color>800\n<color=#FF0000>Armatura: </color>25\n\n<color=#AA00FF>Potenza di Spinta: </color>40\n<color=#ffc080>Quantità di Carburante: </color>500\nPeso: 800\n\nTipo di Scafo: Auto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "Scafo TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Potenza del Motore: </color>1200\n<color=#00FFFF>Velocità: </color>12\nTraverse Velocità: 2\n\n<color=#00FF00>Salute: </color>500\n<color=#FF0000>Armatura: </color>25\n\n<color=#AA00FF>Potenza di Spinta: </color>40\n<color=#ffc080>Quantità di Carburante: </color>300\nPeso: 450\n\nTipo di Scafo: Carro armato",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Scafo Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Potenza del Motore: </color>3500\n<color=#00FFFF>Velocità: </color>8\nTraverse Velocità: 0.6\n\n<color=#00FF00>Salute: </color>1400\n<color=#FF0000>Armatura: </color>100\n\n<color=#AA00FF>Potenza di Spinta: </color>34\n<color=#ffc080>Quantità di Carburante: </color>750\nPeso: 1250\n\nTipo di Scafo: Carro armato",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Scafo Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Fornisce un maggiore <style=cIsUtility>controllo in aria</style>.\n\n\n<color=#FFFF00>Potenza del Motore: </color>2000\n<color=#00FFFF>Velocità: </color>13\nTraverse Velocità: 1.4\n\n<color=#00FF00>Salute: </color>600\n<color=#FF0000>Armatura: </color>20\n\n<color=#AA00FF>Potenza di Spinta: </color>40\n<color=#ffc080>Quantità di Carburante: </color>450\nPeso: 750\n\nTipo di Scafo: Auto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "Scafo AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>La velocità non è influenzata dal peso</style>.\n\n<color=#FFFF00>Potenza del Motore: </color>700\n<color=#00FFFF>Velocità: </color>9\nTraverse Velocità: 0.7\n\n<color=#00FF00>Salute: </color>900\n<color=#FF0000>Armatura: </color>50\n\n<color=#AA00FF>Potenza di Spinta: </color>35\n<color=#ffc080>Quantità di Carburante: </color>370\nPeso: 1100\n\nTipo di Scafo: Carro armato",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "Scafo TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Potenza del Motore: </color>3700\n<color=#00FFFF>Velocità: </color>8\nTraverse Velocità: 0.5\n\n<color=#00FF00>Salute: </color>1150\n<color=#FF0000>Armatura: </color>60\n\n<color=#AA00FF>Potenza di Spinta: </color>34\n<color=#ffc080>Quantità di Carburante: </color>1000\nPeso: 1200\n\nTipo di Scafo: Carro armato",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Scafo Pigeon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Compatibile con torretta</color>.\n\n<color=#FFFF00>Potenza del Motore: </color>1500\n<color=#00FFFF>Velocità: </color>7\nTraverse Velocità: 1.4\n\n<color=#00FF00>Salute: </color>150\n<color=#FF0000>Armatura: </color>5\n\n<color=#AA00FF>Potenza di Spinta: </color>40\n<color=#ffc080>Quantità di Carburante: </color>300\nPeso: 100\n\nTipo di Scafo: Auto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Scafo Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Può scalare le pareti</style>. Il salto è ritardato di un secondo e i <color=#fc8080>danni da speronamento sono ridotti del 50%</color>.\n\n\n<color=#FFFF00>Potenza del Motore: </color>2750\n<color=#00FFFF>Velocità: </color>9\nTraverse Velocità: 0.8\n\n<color=#00FF00>Salute: </color>1300\n<color=#FF0000>Armatura: </color>90\n\n<color=#AA00FF>Potenza di Spinta: </color>31\n<color=#ffc080>Quantità di Carburante: </color>550\nPeso: 1300\n\nTipo di Scafo: Mech",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "Scafo TANKDOZER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "Lo spazzaneve <style=cIsUtility>blocca</style> tutti i <style=cIsDamage>danni in arrivo</style>.\n\nModalità Cacciacarri: <color=#fc8080>Non può montare la torretta</color>.\n\n<color=#FFFF00>Potenza del Motore: </color>2500\n<color=#00FFFF>Velocità: </color>8.5\nTraverse Velocità: 0.9\n\n<color=#00FF00>Salute: </color>1250\n<color=#FF0000>Armatura: </color>80\n\n<color=#AA00FF>Potenza di Spinta: </color>34\n<color=#ffc080>Quantità di Carburante: </color>500\nPeso: 1200\n\nTipo di Scafo: Carro armato",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Scafo Truck Kan",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "I danni da speronamento sono aumentati del <color=#80fc80>100.0%</color>\n\n<color=#80fc80>Compatibile con torretta</color>.\n<style=cIsUtility>La velocità non è influenzata dal peso</style>.\n\n<color=#FFFF00>Potenza del Motore: </color>1000\n<color=#00FFFF>Velocità: </color>12\nTraverse Velocità: 0.9\n\n<color=#00FF00>Salute: </color>450\n<color=#FF0000>Armatura: </color>15\n\n<color=#AA00FF>Potenza di Spinta: </color>40\n<color=#ffc080>Quantità di Carburante: </color>600\nPeso: 600\n\nTipo di Scafo: Auto",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Salute: </color>250\n<color=#FF0000>Armatura: </color>25\n\nRotation Velocità: 7.5\n\nPeso: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Torretta",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Salute: </color>100\n<color=#FF0000>Armatura: </color>10\n\nRotation Velocità: 20\n\nPeso: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Salute: </color>100\n<color=#FF0000>Armatura: </color>15\n\nRotation Velocità: 15\n\nPeso: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Salute: </color>400\n<color=#FF0000>Armatura: </color>50\n\nRotation Velocità: 5\n\nPeso: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% di danni</style>?  Non sono riuscito a trovare il codice dove aumenta i danni per questa specifica torretta.\n- Sviluppatore\n\n\n<color=#00FF00>Salute: </color>150\n<color=#FF0000>Armatura: </color>25\n\nRotation Velocità: 13\nLimite d'Angolo: 60\n\nPeso: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Aggiunge <style=cIsDamage>5 cariche</style> all'abilità <style=cIsUtility>secondaria</style>.\n<style=cIsUtility>Ripristina tutte le cariche</style> dopo la ricarica.\nI danni del cannone diminuiscono dell'80%\n\n<color=#00FF00>Salute: </color>300\n<color=#FF0000>Armatura: </color>20\n\nRotation Velocità: 7\n\nPeso: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Salute: </color>200\n<color=#FF0000>Armatura: </color>30\n\nRotation Velocità: 9\n\nPeso: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Salute: </color>300\n<color=#FF0000>Armatura: </color>35\n\nRotation Velocità: 7\n\nPeso: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Peso Massimo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "Il carro armato può <style=cIsUtility>investire i nemici</style>, con <style=cIsDamage>danni dipendenti dalla velocità</style>.  Cadere con una configurazione pesante fa sì che il tuo peso crei un'<style=cIsUtility>onda d'urto</style>, ferendo i nemici vicini.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "Nessuno",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Rimuove questa abilità.  Aumenta le seguenti statistiche:\n\nVelocità d'Attacco: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "Nessuno",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "Nessuno",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Rimuove questa abilità.  Aumenta le seguenti statistiche:\n\nVelocità: <color=#80fc80>+1</color> m/s\nPotenza Propulsori: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "Nessuno",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Rimuove questa abilità.  Aumenta l'armatura di <color=#80fc80>30</color> e aumenta la capacità di carburante di <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Mini Cannone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Spara in modo impreciso per il <style=cIsDamage>200% di danni.</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "EMP",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Incendia il tuo scudo e crea un impulso elettromagnetico per il <style=cIsDamage>2000% di danni</style>, che folgora i nemici!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "Conserva una scorta massiccia fino a 22 missili! Ciascuno infligge dal <style=cIsDamage>1100% di danni</style> fino al <style=cIsDamage>1800% di danni</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Cannone Automatico Rapido",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Spara proiettili esplosivi contro i nemici per il <style=cIsDamage>500% di danni</style>. Deve ricaricare ogni 4 secondi.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Cannone Possente",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Spara per il <style=cIsDamage>7500% di danni</style>, respingendo i nemici.\n<style=cSub>[<style=cIsUtility>Ricarica: 16s</style> | <style=cIsDamage>Raggio d'Esplosione: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Cannone d'Artiglieria",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Tieni premuto per mirare</style>, e rilascia per sparare un potente proiettile per il <style=cIsDamage>7000% di danni</style>.  I danni aumentano più lontano viaggia fino al <style=cIsDamage>14000% di danni</style>.\n<style=cSub>[<style=cIsUtility>Ricarica: 16s</style> | <style=cIsDamage>Raggio d'Esplosione: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Crio-Cannone",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Spara una palla di neve gigante per il <color=#75EAFF>1500% di danni</color> e congela i nemici.\n<style=cSub>[<style=cIsUtility>Ricarica: 5s</style> | <style=cIsDamage>Raggio d'Esplosione: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Cannone Duo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Spara per il <style=cIsDamage>5400% di danni</style>. Tieni premuto per sparare 2 proiettili, il che <color=#fc8080>aumenta la ricarica dell'abilità</color> successivamente. Sparare una doppietta <color=#80fc80>riduce notevolmente</color> il tempo di carica successivo per 2 secondi.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "Cannone Britannico",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Spara per il <style=cIsDamage>2400% di danni</style>.  <color=#fc8080>Non può attivare gli oggetti</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Grande Cannone Cattivo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Spara per il <style=cIsDamage>2000% di danni</style>.  <style=cIsUtility>Tieni premuto per caricare</style> e infliggere fino all'<style=cIsDamage>11000% di danni</style>.  La carica massima fa sparare automaticamente il cannone per un <style=cIsDamage>5500% di danni laser</style> aggiuntivo con <style=cIsUtility>rinculo aggiuntivo</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Sperimentale di Oppenheimer",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Lascia che il tuo proiettile distrugga il tuo scudo e annienta tutto per il <color=#ff4d76>9000% di danni critici</color>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Reattori",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Accendi e consuma <color=#ffc080>70 di carburante</color> al secondo, permettendo al carro armato di guadagnare sempre più velocità nel tempo.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Ciclo Energetico",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Attiva per alternare tra 3 modalità — Elusione, Attacco o Difesa: \n\n<style=cIsUtility>Elusione</style>: Riduce la velocità d'attacco del 50% e aumenta la ricarica del 50% per un 50% di velocità extra, 10% di potenza di spinta e 50% di potenza del motore!\n\n<color=#80fc80>Difesa</color>: Sacrifica il 70% di velocità e il 100% di potenza di spinta per 500 di armatura.\n\n<style=cIsDamage>Attacco</style>: Tutte le armi infliggono danni doppi. Riduce i tempi di ricarica del 33% e aumenta la velocità d'attacco del 33%, ma perde TUTTA l'armatura e le cure. Attivare questa modalità folgora il tuo carro armato per 2 secondi.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Overclock",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Lascia che la tua velocità distrugga il tuo scudo e fai esplodere violentemente i tuoi propulsori per il <style=cIsDamage>6000% di danni</style> lanciandoti in aria e <style=cIsUtility>prevenendo i danni da caduta</style>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Scudi",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "Attiva per diventare <style=cIsUtility>immune ai danni esterni</style> per 4 secondi.  Può essere sacrificato per un'<color=#03fcc2>Abilità Potente</color> monouso.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Esplosicolare",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Spara con 4 cannoni, ciascuno dei quali infligge il <style=cIsDamage>1400% di danni</style> in un raggio enorme. Le armi si <color=#fc8080>surriscaldano</color> invece di ricaricare.\n<style=cSub>[<style=cIsDamage>Raggio d'Esplosione: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Standard",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Esperienza classica.\n\nIl carro armato si muove e gira in base alla direzione di marcia scelta.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Alternativo",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Cambia il modo in cui si gioca con questo carro armato.\n\nIl carro armato si muove in base alla direzione dello scafo, ma <color=#fc8080>non girerà nella direzione di marcia</color>.  Questo viene gestito <style=cIsUtility>girando manualmente</style>.\n\nIn volo, i comandi tornano su Standard.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Modalità Energetica: <style=cIsUtility>Elusione</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Riduce la velocità d'attacco del 50% e aumenta la ricarica del 50% per un 50% di velocità extra, 10% di potenza di spinta e 50% di potenza del motore.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Modalità Energetica: <color=#80fc80>Difesa</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "Sacrifica il 70% di velocità e il 100% di potenza di spinta per 500 di armatura.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Modalità Energetica: <style=cIsDamage>Attacco</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "Tutte le armi infliggono danni doppi. Riduce i tempi di ricarica del 33% e aumenta la velocità d'attacco del 33%, ma perde TUTTA l'armatura e le cure. Attivare questa modalità folgora il tuo carro armato per 2 secondi.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "E pensare che Dedee era finalmente libero, \r\nè stato ancora una volta catturato dalla UES.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FAILURE": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_NAME": "Senza Torretta",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_TURRETLESS_DESCRIPTION": "Rimuove la torretta.  <style=cIsDamage>Aumenta tutti i danni del 30%</style>"
  }
}