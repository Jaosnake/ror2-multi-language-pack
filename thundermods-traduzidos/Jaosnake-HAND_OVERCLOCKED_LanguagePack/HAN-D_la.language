    "la": {
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDCLEARGAMEMONSOON_DESCRIPTION": "Ut HAN-D, ludum perfice aut te dele in Monsoon.",
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDCLEARGAMEMONSOON_NAME": "HAN-D: Mastery",
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDCLEARGAMETYPHOON_DESCRIPTION": "Ut HAN-D, ludum perfice aut te dele in Typhoon vel Eclipse.\n<color=#8888>(Computat quamlibet difficultatem Typhoon aut superiorem)</color>",
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDCLEARGAMETYPHOON_NAME": "HAN-D: Grand Mastery",
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDHAMMERPRIMARYUNLOCK_DESCRIPTION": "Ultimum dominum complana.",
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDHAMMERPRIMARYUNLOCK_NAME": "HAN-D: Bonk!",
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDNEMESISFOCUSUNLOCK_DESCRIPTION": "OVERCLOCK activum tene plus quam XLV secundis.",
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDNEMESISFOCUSUNLOCK_NAME": "HAN-D: Beatdown",
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDSURVIVORUNLOCK_DESCRIPTION": "Robotum custodem in Rallypoint Delta refice utens Fuel Array capsulae Escape Pod.",
        "ACHIEVEMENT_MOFFEINHANDOVERCLOCKEDSURVIVORUNLOCK_NAME": "Handyman",
        "KEYWORD_MOFFEINHANDOVERCLOCKED_BOOST": "<style=cKeywordName>Impetus</style><style=cSub>Ars mature irrita fieri potest ut sursum impellaris.</style>",
        "MOFFEIN_HAND_BODY_DESCRIPTION": "HAN-D est robotus custos robustus cuius validae oppugnationes proximae certam confusionem relinquunt! <style=cSub>\n\n< ! > LAEDE maiorem repulsionem contra hostes aereos habet. Utere RECOMPOSITIO_COACTA ut hostes in aerem mittas, deinde LAEDE ad eos volare facias!\n\n< ! > OVERCLOCK durat quamdiu hostes ferire potes.\n\n< ! > OVERCLOCK irritum facere te sursum impellet et hostes volantes attingere sinet.\n\n< ! > Utere DRONES ut saneris et in proelio maneas.\n\n",
        "MOFFEIN_HAND_BODY_GRANDMASTERY_SKIN_NAME": "RE-TRN",
        "MOFFEIN_HAND_BODY_HOPOO_SKIN_NAME": "HO-POO",
        "MOFFEIN_HAND_BODY_LORE": "<style=cMono>\n//--TRANSCRIPTIO AUTOMATICA EX DEPARTAMENTO UES [REDACTUM]--//</style>\n\n<i>*haurit <color=#327FFF>Spinel Tonic</color>*</i>\n\nNum ludere sine artefacto <color=#6955A6>Command</color> est ultima forma cornuti esse?\n\nNihil magis cornutum cogitare aut intellegere possum quam sine <color=#6955A6>Command</color> ludere. Sincere, rem ratione considera. Iaculas, curris atque salis per circiter sexaginta minuta tantum ut damnatum <color=#77FF16>Squid Polyp</color> accipias. Totus ille labor quem in cursum tuum posuisti — lasers <style=cIsHealth>Stone Golem</style> vitando, sex milibus <style=cIsHealth>Lesser Wisps</color> supra caput tuum apparentibus vexatus, <color=#E5C962>Shrines of the Mountain</color> activando — ad unum tantum exitum ducit: inventarium tuum <color=#FFFFFF>Warbanners</color> et monilia <color=#FFFFFF>Monster Tooth</color> impletur, rebus pecunia emptis.\n\nIn cursu divino? Optime. Multa instrumenta misera et inutilia, quae nihil cursui tuo conferunt, ex <color=#E5C962>Chests</color> quas emis proveniunt. Eae fructum capiunt ex pecunia labore parta, quae ex necandis <style=cIsHealth>Lemurians</style> venit.\n\nUt vir qui hoc ludum ludit, <style=cIsHealth>LITTERALITER</style> duas horas vitae tuae capsas aperiendo et precando consumis, ne alia <color=#77FF16>Chronobauble</color> sit. Haec est absoluta et ultima conditio cornuti. De hoc logice cogita.\n<style=cMono>\nTranscriptio perfecta.\n</style>\n \n\n",
        "MOFFEIN_HAND_BODY_MASTERY_SKIN_NAME": "WOO-D",
        "MOFFEIN_HAND_BODY_NAME": "HAN-D",
        "MOFFEIN_HAND_BODY_OUTRO_FAILURE": "..ita evanuit, nullum praemium pro omnibus laboribus accipiens.",
        "MOFFEIN_HAND_BODY_OUTRO_FLAVOR": "..ita discessit, servomechanismis nova vita pulsantibus.",
        "MOFFEIN_HAND_BODY_PASSIVE_DESC": "<style=cIsDamage>Damnum acceptum minue</style> per <style=cIsDamage>0.3%</style> salutis maximae tuae pro quolibet <style=cIsUtility>drone</style> possesso.",
        "MOFFEIN_HAND_BODY_PASSIVE_NAME": "ARMATURA_TURMAE",
        "MOFFEIN_HAND_BODY_PRIMARY_DESC": "Vim omnibus pugnantibus infer pro <style=cIsDamage>390% damno</style>. <style=cIsDamage>Obstupescere facit</style> dum <style=cIsDamage>OVERCLOCK</style> activum est.",
        "MOFFEIN_HAND_BODY_PRIMARY_HAMMER_DESC": "<style=cIsHealth>Lentus fies</style> et omnes pugnantis contere pro <style=cIsDamage>600% damno</style>. <style=cIsDamage>Obstupescere facit</style> dum <style=cIsDamage>OVERCLOCK</style> activum est.",
        "MOFFEIN_HAND_BODY_PRIMARY_HAMMER_NAME": "CONTERE",
        "MOFFEIN_HAND_BODY_PRIMARY_NAME": "LAEDE",
        "MOFFEIN_HAND_BODY_SECONDARY_DESC": "<style=cIsDamage>Obstupefaciens</style>. Accumula vim et magnam potentiam omnibus pugnantibus infer pro <style=cIsDamage>600%-1500% damno</style>.",
        "MOFFEIN_HAND_BODY_SECONDARY_NAME": "RECOMPOSITIO_COACTA",
        "MOFFEIN_HAND_BODY_SECONDARY_SCEPTER_DESC": "<style=cIsDamage>Obstupefaciens</style>. Accumula et <style=cIsHealth>OPPRESSIVAM</style> vim infer pro <style=cIsDamage>900%-2250% damno</style>.",
        "MOFFEIN_HAND_BODY_SECONDARY_SCEPTER_NAME": "RECOMPOSITIO_INIQUA",
        "MOFFEIN_HAND_BODY_SPECIAL_DESC": "Emitte drone quae <style=cIsDamage>270% damni</style> infert et <style=cIsHealing>40% damni sanando reddit</style>. Neces et ictus propinqui <style=cIsUtility>refrigerium minuunt</style>.",
        "MOFFEIN_HAND_BODY_SPECIAL_NAME": "DRONE - CURATIO",
        "MOFFEIN_HAND_BODY_SPECIAL_SPEED_DESC": "Emitte drone quae <style=cIsDamage>270% damni</style> infert et <style=cIsDamage>celeritatem impetus ad tempus dat</style>. Neces et ictus propinqui <style=cIsUtility>refrigerium minuunt</style>.",
        "MOFFEIN_HAND_BODY_SPECIAL_SPEED_NAME": "DRONE - CELERITAS",
        "MOFFEIN_HAND_BODY_SUBTITLE": "Custos Non Solutus",
        "MOFFEIN_HAND_BODY_UTILITY_CANCEL_DESC": "<style=cIsUtility>Sursum impellere</style>.",
        "MOFFEIN_HAND_BODY_UTILITY_CANCEL_NAME": "IRRITUM",
        "MOFFEIN_HAND_BODY_UTILITY_DESC": "<style=cIsUtility>Impetus</style>. Auge <style=cIsUtility>celeritatem motus</style> et <style=cIsDamage>celeritatem impetus</style> per <style=cIsDamage>40%</style>. Hostes feri ut <style=cIsUtility>durationem augeas</style>.",
