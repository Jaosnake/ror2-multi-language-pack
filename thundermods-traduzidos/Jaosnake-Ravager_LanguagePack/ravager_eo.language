{
    "eo": {
        "ROB_RAVAGER_BODY_NAME": "Ravager",
        "ROB_RAVAGER_BODY_DESCRIPTION": "Ravager estas agila proksimbatalanto kiu resanigxas de venkitaj malamikoj por resti en la batalo.<color=#CCD3E0>\r\n\r\n< ! > Sxargxataj mursaltoj estas tre utilaj kontraux flugantaj malamikoj.\r\n\r\n< ! > Fendi helpas interrompi fortajn atakojn kaj dauxrigi vian damagxon.\r\n\r\n< ! > Koaguli helpas kiam vi ne certas, cxu vi povas plenigi la Sangoputo; vi ankaux povas uzi gxin pasive por konservi vian sanon.\r\n\r\n< ! > Brutaligi resanigas kiam necesas: kaptu kaj konsumu malamikon se via sano malaltas.</color>",
        "ROB_RAVAGER_BODY_SUBTITLE": "Malkompata Usurpanto",
        "ROB_RAVAGER_BODY_LORE": "La Ravager ne naskigxis kun speciala povo...\n\n...anstatauxe, li naskigxis kun Malbenita Sangoversxita Katano sed iun tagon li iris al la Feka Dimensio kaj renkontis malican povon.....\n\nFinfine eskapis el la Feka Dimensio kaj posedante cxi tiun teruran malican povon mem li venis al la Petrichor V por detrui la universon.",
        "ROB_RAVAGER_BODY_OUTRO_FLAVOR": "..kaj do li foriris, sercxante novajn terojn por profani.",
        "ROB_RAVAGER_BODY_OUTRO_FAILURE": "..kaj do li malaperis, lia ridinda violento fine finigxinte.",
        "ROB_RAVAGER_BODY_DEFAULT_SKIN_NAME": "Defauxlta",
        "ROB_RAVAGER_BODY_MONSOON_SKIN_NAME": "Tusxita de la Malpleno",
        "ROB_RAVAGER_BODY_MONSOON_ALTERNATE_SKIN_NAME": "Tusxita de la Malpleno EX",
        "ROB_RAVAGER_BODY_TYPHOON_SKIN_NAME": "[DATUMOJ FORIGITAJ]",
        "ROB_RAVAGER_BODY_VOID_SKIN_NAME": "Naskita de la Malpleno",
        "ROB_RAVAGER_BODY_MANGUY_SKIN_NAME": "Rabisto",
        "ROB_RAVAGER_BODY_COMMANDO_SKIN_NAME": "Commando",
        "ROB_RAVAGER_BODY_SELLSWORD_SKIN_NAME": "Dungita skermisto",
        "ROB_RAVAGER_BODY_GUERRILLA_SKIN_NAME": "Gerilano",
        "ROB_RAVAGER_BODY_MAHORAGA_SKIN_NAME": "Dia",
        "ROB_RAVAGER_BODY_MINECRAFT_SKIN_NAME": "Minecraft",
        "ROB_RAVAGER_BODY_BLOODWELL_NAME": "Sangoputo",
        "ROB_RAVAGER_BODY_BLOODWELL_DESCRIPTION": "Ravager amasigas <style=cIsHealth>sangon</style> per siaj frapoj. Kiam la rezervujo plenigxas, gxi malplenigxas por resanigi <style=cIsHealing>75% de via mankanta sano</style> kaj provizore <style=cIsDamage>plifortigi viajn kapablojn</style>.",
        "ROB_RAVAGER_BODY_BLOODWELL2_NAME": "Ihxorujo",
        "ROB_RAVAGER_BODY_BLOODWELL2_DESCRIPTION": "Ravager amasigas <style=cIsHealth>sangon</style> per siaj frapoj. Kiam la rezervujo plenigxas, gxi malplenigxas por resanigi <style=cIsHealing>100% de via maksimuma sano</style> kaj provizore <style=cIsDamage>plifortigi viajn kapablojn</style>. <style=cIsHealth>Gxi malplenigxas pli rapide dum atakado.</style>",
        "ROB_RAVAGER_BODY_PARASITE_NAME": "La Parazito",
        "ROB_RAVAGER_BODY_PARASITE_DESCRIPTION": "<style=cIsHealth>Gxi malsatas....</style>",
        "ROB_RAVAGER_BODY_PASSIVE_NAME": "Korpa Kapablo",
        "ROB_RAVAGER_BODY_PASSIVE_DESCRIPTION": "Ravager povas desaltigi sin de <style=cIsUtility>muroj</style> kaj <style=cIsHealth>malamikoj</style>. Uzu la <style=cIsUtility>primaran kapablon</style> dum sxargado por eniri <style=cIsDamage>atendan pozicion</style>.",
        "ROB_RAVAGER_BODY_PASSIVE2_NAME": "Tordita Mutacio",
        "ROB_RAVAGER_BODY_PASSIVE2_DESCRIPTION": "<style=cIsHealth>Kostas 10% de maksimumaj sano kaj sxildo je plena sxargxo; la kosto varias kun la sxargxo</style>. Saltu en la aero por sxargxi <style=cIsUtility>teleporton antauxen</style>, unufoje po salto. <style=cIsDamage>Proksimaj atakoj</style> kiuj trafas reaktivigas la kapablon.",
        "ROB_RAVAGER_BODY_PASSIVE3_NAME": "Tordita Mutacio (malnova)",
        "ROB_RAVAGER_BODY_PASSIVE3_DESCRIPTION": "<style=cIsHealth>Kostas 5% de la nuna sano.</style> Saltu en la aero por <style=cIsUtility>teleportigxi antauxen</style>, unufoje po salto. <style=cIsDamage>Proksimaj atakoj</style> kiuj trafas reaktivigas la kapablon.",
        "ROB_RAVAGER_BODY_CONFIRM_NAME": "Konfirmi",
        "ROB_RAVAGER_BODY_CONFIRM_DESCRIPTION": "Dauxrigu kun la nuna kapablo.",
        "ROB_RAVAGER_BODY_CANCEL_NAME": "Nuligi",
        "ROB_RAVAGER_BODY_CANCEL_DESCRIPTION": "Nuligu la nunan kapablon.",
        "ROB_RAVAGER_BODY_PRIMARY_SLASH_NAME": "Haki",
        "ROB_RAVAGER_BODY_PRIMARY_SLASH_DESCRIPTION": "Svingu antauxen por <style=cIsDamage>230% damagxo</style>. <style=cIsHealth>Svingas pli rapide ju pli malalta via sano estas.</style>",
        "ROB_RAVAGER_BODY_PRIMARY_SLASHCOMBO_NAME": "Dismeti",
        "ROB_RAVAGER_BODY_PRIMARY_SLASHCOMBO_DESCRIPTION": "Svingu antauxen por <style=cIsDamage>180% da damagxo</style>. Cxiu tria frapo <style=cIsUtility>stuporigas</style> kaj faras <style=cIsDamage>390% da damagxo</style>.",
        "ROB_RAVAGER_BODY_SECONDARY_SPINSLASH_NAME": "Fendi",
        "ROB_RAVAGER_BODY_SECONDARY_SPINSLASH_DESCRIPTION": "Impetu antauxen kaj faru largxan <style=cIsUtility>stuporigan</style> trancon por <style=cIsDamage>500% da damagxo</style>.",
        "ROB_RAVAGER_BODY_UTILITY_HEAL_NAME": "Koaguli",
        "ROB_RAVAGER_BODY_UTILITY_HEAL_DESCRIPTION": "Tuj malplenigu la <style=cIsHealth>Sangoputo</style>, <style=cIsHealing>sanigante vin</style> per la konsumita sango.",
        "ROB_RAVAGER_BODY_UTILITY_BEAM_NAME": "Nuligi",
        "ROB_RAVAGER_BODY_UTILITY_BEAM_DESCRIPTION": "<style=cIsHealth>Absorbu</style> venantajn <style=cIsUtility>projektilojn</style> por sxargxi detruigan eksplodon kiu faras gxis <style=cIsDamage>5000% damagxo</style> kiam plene sxargxita.",
        "ROB_RAVAGER_BODY_UTILITY_SWAP_NAME": "Boogie Woogie",
        "ROB_RAVAGER_BODY_UTILITY_SWAP_DESCRIPTION": "Sxangxu lokon kun <style=cIsUtility>iu ajn ento</style>.",
        "ROB_RAVAGER_BODY_UTILITY_SNATCH_NAME": "Kapti",
        "ROB_RAVAGER_BODY_UTILITY_SNATCH_DESCRIPTION": "Sendu antauxen vian <style=cIsDamage>brakon de diabloteto</style> kaj kaptu malproksiman malamikon per gxia ungego, <style=cIsUtility>tirante vin al tio, kion gxi trafas</style>.",
        "ROB_RAVAGER_BODY_SPECIAL_GRAB_NAME": "Brutaligi",
        "ROB_RAVAGER_BODY_SPECIAL_GRAB_DESCRIPTION": "Impetu kaj <style=cIsUtility>kaptu</style> proksimajn malamikojn, tiam frapu malsupren por <style=cIsDamage>1000% damagxo</style>. Se cxi tio mortigas, <style=cIsHealth>konsumu</style> ilin por restarigi <style=cIsHealing>10% maksimuma sano</style>.",
        "ROB_RAVAGER_BODY_SPECIAL_GRAB_SCEPTER_NAME": "Detrui",
        "ROB_RAVAGER_BODY_SPECIAL_GRAB_SCEPTER_DESCRIPTION": "Impetu kaj <style=cIsUtility>kaptu</style> proksimajn malamikojn, tiam frapu malsupren por <style=cIsDamage>1000% damagxo</style>. Se cxi tio mortigas, <style=cIsHealth>konsumu</style> ilin por restarigi <style=cIsHealing>10% maksimuma sano</style>.\n<color=#d299ff>SCEPTER: Pli granda frapradiuso; premu Salti dum trenado por teleportigxi supren.</color>",
        "ROB_RAVAGER_BODY_SPECIAL_PUNCH_NAME": "Pugnbati",
        "ROB_RAVAGER_BODY_SPECIAL_PUNCH_DESCRIPTION": "Impetu kaj <style=cIsUtility>pugnfrapu</style>, farante <style=cIsDamage>1000% damagxon</style> kun <style=cIsUtility>sxokondo</style> tra ili por la sama damagxo. Se cxi tio mortigas, <style=cIsHealth>konsumu</style> ilin por restarigi <style=cIsHealing>10% maksimuma sano</style>.",
        "ROB_RAVAGER_BODY_SPECIAL_THROW_NAME": "Jxeti",
        "ROB_RAVAGER_BODY_SPECIAL_THROW_DESCRIPTION": "Impetu kaj <style=cIsUtility>kaptu</style> proksimajn malamikojn, tiam jxetu ilin por <style=cIsDamage>1000% damagxo</style> sur impakto. Se cxi tio mortigas, <style=cIsHealth>konsumu</style> ilin por restarigi <style=cIsHealing>10% maksimuma sano</style>.",
        "KEYWORD_REDGUY_M12": "<style=cKeywordName>Atenda pozicio</style><style=cSub>Dum sxargado de mursalto, eniru <style=cIsUtility>atendan pozicion</style>. Liberigu por svingi kaj kauxzi gxis <style=cIsDamage>5x da damagxo</style> depende de la rapideco.</style>",
        "KEYWORD_REDGUY_M1": "<style=cKeywordName>Plifortigita efiko</style><style=cSub>Svingas pli rapide.</style>",
        "KEYWORD_REDGUY_M2": "<style=cKeywordName>Plifortigita efiko (surtere)</style><style=cSub>Sukcesaj frapoj <style=cIsUtility>impetegas pli malproksimen</style> kaj <style=cIsDamage>auxmentas damagxon per 50%</style>, stakigxante.</style>",
        "KEYWORD_REDGUY_M2B": "<style=cKeywordName>Plifortigita efiko (en la aero)</style><style=cSub>Faras pli da damagxo al <style=cIsUtility>malamikoj kun malmulta sano</style> kaj impetegas pli malproksimen.</style>",
        "KEYWORD_REDGUY_HEAL": "<style=cKeywordName>Plifortigita efiko</style><style=cSub>Eksplodas por <style=cIsDamage>2400% damagxo</style>.</style>",
        "KEYWORD_REDGUY_BEAM": "<style=cKeywordName>Plifortigita efiko</style><style=cSub>Sxargxas multe pli rapide.</style>",
        "KEYWORD_REDGUY_GRAB": "<style=cKeywordName>Plifortigita efiko</style><style=cSub>Povas kapti estrojn. Tiras malamikojn lauxgrunde, farante damagxon lauxtempe.</style>",
        "KEYWORD_REDGUY_GRAB2": "<style=cKeywordName>Estroj</style><style=cSub>Contraux estrojn, <style=cIsDamage>alkrocxu</style> al ili anstatauxe kaj eniru koboldan regximon.</style>",
        "KEYWORD_REDGUY_PUNCH": "<style=cKeywordName>Plifortigita efiko</style><style=cSub>Lancxas baron de pugnoj, farante pezan damagxon.</style>",
