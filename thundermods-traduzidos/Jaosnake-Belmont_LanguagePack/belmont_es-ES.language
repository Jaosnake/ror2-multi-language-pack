        "ROB_GREAT_GARGOYLE_NAME": "Colmillos Azules",
        "KEYWORD_WHIP_SLAM": "<style=cKeywordName>Azotada de Látigo</style><style=cSub>Pulsa dos veces mientras tienes fijado a un enemigo <style=cIsUtility>en el aire</style> para <style=cIsDamage>estamparlo</style> contra el suelo infligiendo <style=cIsDamage>1800% de daño</style>.</style>"
