        "JAVANGLE_HOUSE_COINS_NAME": "5 der Münzen",
        "JAVANGLE_HOUSE_COINS_DESCRIPTION": "<style=cArtifact>Verliere 40% deines aktuellen Goldes</style> und <style=cIsDamage>verursache 400% des verlorenen Goldes als Schaden</style> an nahen Gegnern.",
        "JAVANGLE_HOUSE_TOWER_NAME": "Der Turm",
        "JAVANGLE_HOUSE_TOWER_DESCRIPTION": "<style=cArtifact>Krise</style>, <style=cDeath>Zerstörung</style>, <style=cArtifact>Katastrophe</style>, <style=cDeath>Verluste</style>, <style=cArtifact>Hindernisse</style>, <style=cDeath>Unbeständig</style>.\n<style=cIsUtility>[Unzerstörbar]</style>",
        "JAVANGLE_HOUSE_JOKER_NAME": "Joker",
        "JAVANGLE_HOUSE_JOKER_DESCRIPTION": "Aktiviert einen anderen zufälligen <style=cArtifact>Lila Karteneffekt</style>, 20% Chance, <style=cArtifact>alle auf einmal zu aktivieren</style>.\n<style=cSub>(Kann Der Turm nicht aktivieren.)</style>",
        "JAVANGLE_HOUSE_7JACK_NAME": "Karo Bube",
        "JAVANGLE_HOUSE_7JACK_DESCRIPTION": "Lädt 6 Standardschüsse.\nAm Boden: rutscht nach vorne.",
        "JAVANGLE_HOUSE_7QUEEN_NAME": "Herz Dame",
        "JAVANGLE_HOUSE_7QUEEN_DESCRIPTION": "<style=cIsUtility>Verstärkt vorübergehend 2 zufällige Werte</style>, aber <style=cArtifact>schwächt 2 andere zufällige Werte</style>.",
        "JAVANGLE_HOUSE_7KING_NAME": "Kreuz König",
        "JAVANGLE_HOUSE_7KING_DESCRIPTION": "Lädt einen Explosiv-, Durchschlag-, Schrot-, Schlangen-, Platzpatronen- und Mysteriumsschuss.",
        "JAVANGLE_HOUSE_7ACE_NAME": "Pik Ass",
        "JAVANGLE_HOUSE_7ACE_DESCRIPTION": "Lädt nichts außer 1 einzigartigen Schuss, der nach einer langen Verzögerung <style=cIsDamage>2500% Schaden</style> verursacht.",
        "JAVANGLE_HOUSE_WILDCARD_NAME": "Wildcard",
        "JAVANGLE_HOUSE_WILDCARD_DESCRIPTION": "Tut etwas Unvorhersehbares. Könnte gut sein, könnte schlecht sein, könnte keins von beidem sein... vielleicht beides?\n<style=cIsUtility>[Unzerstörbar]</style>",
        "JAVANGLE_HOUSE_RROULETTE_NAME": "Russisches Roulette",
        "JAVANGLE_HOUSE_RROULETTE_DESCRIPTION": "1/6 Chance <style=cDeath>zu sterben</style>, 4/6 Chance nichts zu tun und maximale Stapel 'Ante' zu gewähren, 1/6 Chance <style=cIsDamage>alles auf der Karte zu töten</style>, <style=cIsUtility>Gegenstände zu gewähren</style> und <style=cIsUtility>alle toten Spieler wiederzubeleben</style>.\n<style=cSub>(Die Seltenheit und Menge der erhaltenen Gegenstände steigt mit der Anzahl abgeschlossener Level)</style>\n<style=cSub>(Kann im Mehrspieler keine Legendären Gegenstände gewähren)</style>\n<style=cIsUtility>[Unzerstörbar]</style>",
        "JAVANGLE_HOUSE_FORTUNE_NAME": "Glücksrad",
        "JAVANGLE_HOUSE_FORTUNE_DESCRIPTION": "50% Chance, <style=cShrine>aktuelles Gold zu verdoppeln</style>, 50% Chance, <style=cArtifact>alles Gold zu verlieren</style> und <style=cIsUtility>um einen zufälligen Gegenstand zu würfeln</style>, basierend auf dem verlorenen Gold.",
        "JAVANGLE_HOUSE_THREEOFAKIND_NAME": "Drilling",
        "JAVANGLE_HOUSE_THREEOFAKIND_DESCRIPTION": "Ziehe und <style=cIsUtility>spiele die gesamte nächste Hand</style> auf einmal.",
        "JAVANGLE_HOUSE_GCLUBS_NAME": "Kreuz",
        "JAVANGLE_HOUSE_GCLUBS_DESCRIPTION": "Lädt <style=cIsUtility>3 zufällige Positive Schüsse</style> ins Roulette.\nZusätzlich <style=cIsUtility>Garantiert</style> es, dass deine nächste Kugel ein Explosivschuss ist.",
        "JAVANGLE_HOUSE_GSPADES_NAME": "Pik",
        "JAVANGLE_HOUSE_GSPADES_DESCRIPTION": "Erhalte <style=cIsUtility>Erhöhtes Bewegungstempo</style> für 10 Sekunden\nZusätzlich <style=cIsUtility>Garantiert</style> es, dass deine nächste Kugel ein Durchschlagschuss ist.",
        "JAVANGLE_HOUSE_GHEARTS_NAME": "Herz",
        "JAVANGLE_HOUSE_GHEARTS_DESCRIPTION": "<style=cIsHealing>Heilt 50% deiner max. LP</style>",
        "JAVANGLE_HOUSE_GJACK_NAME": "Bube",
        "JAVANGLE_HOUSE_GJACK_DESCRIPTION": "Tut nichts.",
        "JAVANGLE_HOUSE_CRAZYCARD_NAME": "Verrückte Karte",
        "JAVANGLE_HOUSE_CRAZYCARD_DESCRIPTION": "Aktiviert zufällig eine andere Karte aus dem Standard-Blatt.",
        "JAVANGLE_HOUSE_CASHOUT_NAME": "Auszahlung",
        "JAVANGLE_HOUSE_CASHOUT_DESCRIPTION": "1/3 Chance, <style=cArtifact>alles Geld zu verlieren</style>, 1/3 Chance nichts zu tun, 1/3 Chance, <style=cIsDamage>jedem Gegner auf der Karte Schaden zuzufügen</style> und <style=cIsUtility>einen temporären Gegenstand zu gewähren</style>.\n<style=cSub>(Schaden und Gegenstandsseltenheit skalieren mit dem riskierten Geld)</style>",
        "JAVANGLE_HOUSE_THESUN_NAME": "Die Sonne",
        "JAVANGLE_HOUSE_THESUN_DESCRIPTION": "<style=cIsUtility>Erstellt ein Duplikat jeder anderen Karte auf der Hand</style> und zieht sie in die nächste Hand.\n<style=cSub>(Funktioniert nicht bei 'Unzerstörbaren' Karten)</style>.\n<style=cSub>(Dieser Effekt kann nicht durch andere Karten ausgelöst werden)</style>.",
        "JAVANGLE_HOUSE_THEMOON_NAME": "Der Mond",
        "JAVANGLE_HOUSE_THEMOON_DESCRIPTION": "<style=cIsUtility>Zerstört jede andere Karte auf der Hand</style> und entfernt sie aus dem Deck.\n<style=cSub>(Funktioniert nicht bei 'Unzerstörbaren' Karten)</style>.\n<style=cSub>(Dieser Effekt kann nicht durch andere Karten ausgelöst werden)</style>.",
        "JAVANGLE_HOUSE_THESTAR_NAME": "Der Stern",
        "JAVANGLE_HOUSE_THESTAR_DESCRIPTION": "<style=cIsUtility>Erstellt drei zufällige Karten und zieht sie sofort</style>; die Karte, die du benutzt, wird behalten, <style=cArtifact>die anderen beiden werden zerstört.</style>\n<style=cSub>(Kann keine 'Unzerstörbaren' Karten erstellen)</style>.\n<style=cSub>(Dieser Effekt kann nicht durch andere Karten ausgelöst werden)</style>.",
        "JAVANGLE_HOUSE_THEWORLD_NAME": "Die Welt",
        "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION": "<style=cIsUtility>Zerstört alle 'Die Sonne'-, 'Der Mond'-, 'Der Stern'- und 'Die Welt'-Karten</style> aus dem Nachziehstapel, der Hand und dem Ablagestapel und entfernt sie aus dem Deck.\n<style=cSub>(Dieser Effekt kann nicht durch andere Karten ausgelöst werden)</style>.",
        "JAVANGLE_HOUSE_JUDGEMENT_NAME": "Das Gericht",
        "JAVANGLE_HOUSE_JUDGEMENT_DESCRIPTION": "<style=cIsUtility>Ersetzt das Deck vollständig durch die ursprüngliche Version</style> und macht alle daran vorgenommenen Änderungen rückgängig. <style=cSub>(als wärst du neu erschienen oder hättest das Level gewechselt)</style>\n<style=cSub>(Dieser Effekt kann nicht durch andere Karten ausgelöst werden)</style>.\n<style=cIsUtility>[Unzerstörbar]</style>",
        "JAVANGLE_HOUSE_KINGOFWANDS_NAME": "König der Stäbe",
        "JAVANGLE_HOUSE_KINGOFWANDS_DESCRIPTION": "<style=cIsUtility>Verbraucht bis zu 4 Stapel 'Ante'</style> und <style=cIsHealing>gewährt bis zu 70% Heilung</style>, abhängig davon, wie viel 'Ante' ausgegeben wurde.\n<style=cIsHealing>Alle kontrollierten Verbündeten werden um die Hälfte geheilt</style>.",
        "JAVANGLE_HOUSE_QUEENOFCUPS_NAME": "Königin der Kelche",
        "JAVANGLE_HOUSE_QUEENOFCUPS_DESCRIPTION": "<style=cIsUtility>Verbraucht bis zu 4 Stapel 'Ante'</style> und gewährt eine Stärkung, die es House erlaubt, <style=cIsUtility>geladene Schüsse abzufeuern, ohne sie zu verbrauchen</style>.\nDiese Stärkung hält bis zu 15 Sekunden an, abhängig davon, wie viel 'Ante' ausgegeben wird.",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_NAME": "Ritter der Schwerter",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_DESCRIPTION": "<style=cIsUtility>Verbraucht bis zu 4 Stapel 'Ante'</style> und <style=cIsUtility>lädt eine Anzahl positiver Patronen</style> gleich der ausgegebenen Menge an 'Ante'.\nZusätzlich <style=cIsUtility>Garantiert</style> es, dass deine nächste Kugel ein Explosivschuss ist.",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_NAME": "Bube der Münzen",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_DESCRIPTION": "<style=cIsUtility>Verbraucht bis zu 15 Stapel 'Ante'</style> und beschwört Mondchimären, die für dich kämpfen; je mehr 'Ante' du ausgibst, desto stärker ist die beschworene Truppe.\nBei 15 ausgegebenen Stapeln beschwört diese Karte stattdessen einen zufälligen Überlebenden",
        "JAVANGLE_HOUSE_ANTEUP_NAME": "Einsatz erhöhen!",
        "JAVANGLE_HOUSE_ANTEUP_DESCRIPTION": "<style=cIsUtility>Gewährt 6 Stapel 'Ante'</style>.\nJeder Stapel Ante verringert die Rüstung und erhöht das Bewegungs- und Angriffstempo",
        "JAVANGLE_HOUSE_ANCIENTACE_NAME": "Uraltes Ass",
        "JAVANGLE_HOUSE_ANCIENTACE_DESCRIPTION": "Lädt <style=cIsUtility>6 Mysteriumsschüsse</style> ins Roulette.\nZusätzlich <style=cIsUtility>Gewährt es einen der folgenden Effekte</style>.\n<style=cIsUtility>Paare</style>: Jede Karte, die du spielst, wird zweimal gespielt\n<style=cIsUtility>Flush</style>: Jedes Mal, wenn du eine Karte spielst, spiele den Rest deiner Hand (überspringt negative und zufällige Karten)\n<style=cIsUtility>Kelche</style>: Das Abfeuern des Roulettes verbraucht keine Munition mehr\n<style=cIsUtility>[Unzerstörbar]</style>",
        "ARTIFACT_OF_WILDROOM_NAME": "Artefakt von Wildroom",
        "ARTIFACT_OF_WILDROOM_DESCRIPTION": "Beschwört zu Beginn jedes Levels einen Wildroom.\nDer Wildroom kann sich nicht mehr selbst entfernen und wirkt sich nun auch auf Nicht-House-Spieler aus.",
        "JAVANGLE_HOUSE_NULL_NAME": "Null",
        "JAVANGLE_HOUSE_NULL_DESCRIPTION": "Tut nichts, lädt nicht einmal nach.\nDu hast es getan, du hast alles zerstört, du hast alles auf nichts reduziert, und jetzt ist nichts alles, was übrig ist... bist du glücklich..?"
    }
}
