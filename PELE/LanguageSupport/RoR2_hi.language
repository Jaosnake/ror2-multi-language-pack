    "OBJECTIVE_MOON_CHARGE_DROPSHIP": "<style=cHumanObjective>बचाव यान</style> की रक्षा करें ({0}%)",
    "OBJECTIVE_MOON_CHARGE_DROPSHIP_OOB": "<style=cHumanObjective>बचाव यान</style> की रक्षा करें! ({0}%)",
