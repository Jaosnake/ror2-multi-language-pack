    "PLAYER_DEATH_QUOTE_SWANSONG_11": "{0} suggests we should take a break.",
    "PLAYER_DEATH_QUOTE_SWANSONG_11_2P": "Remember to take breaks.",
    "PLAYER_DEATH_QUOTE_SWANSONG_12": "{0} wants a water break.",
