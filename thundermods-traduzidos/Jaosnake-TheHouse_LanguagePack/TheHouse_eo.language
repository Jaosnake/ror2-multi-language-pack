{
    "eo": {
        "JAVANGLE_HOUSE_BODY_NAME": "House",
        "JAVANGLE_HOUSE_BODY_DESCRIPTION": "",
        "JAVANGLE_HOUSE_BODY_SUBTITLE": "La Freneza Vetludanto",
        "JAVANGLE_HOUSE_BODY_LORE": "Parolante pri ludawtoj, nova jxus estis instalita en la distrajxa vestiblo de la sxipo, homoj diras ke la damna afero estas viva aux io simila, freneza a-... Ili instalis kion nun?!",
        "JAVANGLE_HOUSE_BODY_OUTRO_FLAVOR": "Nu, se ne estus pro tio, ke mia unua premio estis cxi tiuj artefaktoj, mi eble ne estus eltirinta tiom multe el tiu ludawto, transformis la damnan aferon en monpresilon, la gastiganto ne estis tre kontenta, mi estis eljxetita, kaj de tiam min cxasas tiu sama ludawto.",
        "JAVANGLE_HOUSE_BODY_OUTRO_FAILURE": "Ho ho Ho! Trankviligxu, malrapidigxu nun, kazino en la malpleno? ludawto preskaux mortigis vin?... supozeble de tie vi ricevis tiujn artefaktojn, cxu?",
        "JAVANGLE_HOUSE_BODY_DEFAULT_SKIN_NAME": "House",
        "JAVANGLE_HOUSE_BODY_MASTERY_SKIN_NAME": "Mansion",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "House: Majstreco",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Kiel House, venku la ludon aux ekstermigxu je Monsoon.",
        "JAVANGLE_HOUSE_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "House: Majstreco",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "House: Granda Majstreco",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "Kiel House, venku la ludon aux ekstermigxu je Typhoon.",
        "JAVANGLE_HOUSE_BODY_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "House: Granda Majstreco",
        "JAVANGLE_HOUSE_PASSIVE_NAME": "La Ludo",
        "JAVANGLE_HOUSE_PASSIVE_DESCRIPTION": "Anstataux <style=cIsUtility>Kapabloj</style>, The House uzas <style=cIsUtility>Kartojn</style>, cxiu karto havas unikan efikon. Post kiam karto estas uzata, gxia fendo resxargigxas, vi forjxetas vian manon kaj tiras 3 novajn kartojn.",
        "JAVANGLE_HOUSE_STANDARDSPREAD_NAME": "Kartaro: Normala Disvolvo",
        "JAVANGLE_HOUSE_STANDARDSPREAD_DESCRIPTION": "Sxi estras kazinon en la malpleno, nur Dio scias kiel sxi allogas klientojn tien, cxio kion mi povas diri al vi estas ke ili tute NE sxatas ke diritaj klientoj foriru kun pli ol tio kun kio ili eniris, ludawto preskaux mortigis min. Simpligita kartaro, desegnita por esti facile uzebla.<style=cSub>[Kontrolu la langeton Kartoj por vidi la kartojn en cxi tiu kartaro]</style>",
        "JAVANGLE_HOUSE_FULLHOUSE_NAME": "Kartaro: Plena Domo",
        "JAVANGLE_HOUSE_FULLHOUSE_DESCRIPTION": "Kion vi diris? La klasika House-sperto.<style=cSub>[Kontrolu la langeton Kartoj por vidi la kartojn en cxi tiu kartaro]</style>",
        "JAVANGLE_HOUSE_DIVINATION_NAME": "Kartaro: Diveno",
        "JAVANGLE_HOUSE_DIVINATION_DESCRIPTION": "Nu, mi renkontigxis kun sxi. Kompleksa kartaro, kiu permesas al vi kontroli la kartan konsiston.<style=cSub>[Kontrolu la langeton Kartoj por vidi la kartojn en cxi tiu kartaro]</style>",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_NAME": "BulletArts: Malplena",
        "JAVANGLE_HOUSE_BULLETARTSEMPTY_DESCRIPTION": "Heh, vi parolas kvazaux vi renkontis sxin. Pafu sxargitan Pafon hazarde. Kiam restas neniuj pafoj: faru nenion.",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_NAME": "BulletArts: Rapida Tiro",
        "JAVANGLE_HOUSE_BULLETARTSQUICKDRAW_DESCRIPTION": "<style=cIsUtility>Pafu pli rapide</style>, sed <style=cArtifact>cxiuj pafoj kauxzas malpli da damagxo</style>. Kiam restas neniuj pafoj: faras nenion.",
        "JAVANGLE_HOUSE_RELOADSTANDARD_NAME": "ReloadArts: Normala",
        "JAVANGLE_HOUSE_RELOADSTANDARD_DESCRIPTION": "Ludi ajnan karton resxargas la ruleton.\n50%/25% da sxanco akiri 1/2 hazardajn specialajn municiojn laux la kartotipo (rugxa = Trapika/Harpuno/Eksploda, purpura = Senkugla/Serpenta, griza/verda = ajna el la antauxaj).\n<style=cSub>[Vidu la langeton Kartoj por vidi la Pafojn kaj iliajn efikojn]</style>",
        "JAVANGLE_HOUSE_RELOADALLIN_NAME": "ReloadArts: Cxio-en",
        "JAVANGLE_HOUSE_RELOADALLIN_DESCRIPTION": "... nu jen mirindajxo! La kartoj sxajnas havi grandegan potencon kaj estigi strangajn efikojn, kaj kiom ajn mi provas, mi neniam povas tiri pli gxis mi uzos unu. Ludi iun ajn karton resxargas la ruleton. Sxargu 0-6 Penetremajn/Pafajn/Eksplodajn pafojn, <style=cArtifact>cxiuj restantaj pafoj estas Serpentaj</style>.<style=cSub>[Kontrolu la langeton Kartoj por vidi la Pafojn kaj iliajn efikojn]</style>",
        "JAVANGLE_HOUSE_CARDARTSHOP_NAME": "CardArts: Salto",
        "JAVANGLE_HOUSE_CARDARTSHOP_DESCRIPTION": "Ludi iun ajn karton: dum en la aero: pusxos vin antauxen.",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_NAME": "CardArts: Balao",
        "JAVANGLE_HOUSE_CARDARTSSWEEP_DESCRIPTION": "Ludi iun ajn karton: svingas la karton antauxen, farante <style=cIsDamage>{0}% da damagxo</style> al malamikoj en proksimbatalo kaj <style=cIsUtility>gajnas baron egalan al {1}% de via maksimuma sano</style> por cxiu trafita malamiko.",
        "JAVANGLE_HOUSE_SHUFFLEART_NAME": "ShuffleArts: Ouroboros",
        "JAVANGLE_HOUSE_SHUFFLEART_DESCRIPTION": "Kiam ajn vi elcxerpas kartojn: remiksi la kartaron reen en la tirstakon.",
        "JAVANGLE_HOUSE_STANDARDSHOT_NAME": "Normala Pafo",
        "JAVANGLE_HOUSE_STANDARDSHOT_DESCRIPTION": "Pafu normalan kuglon por <style=cIsDamage>{0}% da damagxo</style>.",
        "JAVANGLE_HOUSE_PIERCINGSHOT_NAME": "Penetrema Pafo",
        "JAVANGLE_HOUSE_PIERCINGSHOT_DESCRIPTION": "Pafu specialan pafon, kiu penetras tra celoj por po <style=cIsDamage>{0}% da damagxo</style>.",
        "JAVANGLE_HOUSE_BUCKSHOT_NAME": "Pafa Pafo",
        "JAVANGLE_HOUSE_BUCKSHOT_DESCRIPTION": "Pafu cxaspafilan eksplodon por <style=cIsDamage>{0}% x {1} da damagxo</style>.",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_NAME": "Eksploda Pafo",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_DESCRIPTION": "Pafu eksplodan pafajxon, kiu faras <style=cIsDamage>{0}% da damagxo</style> en areo.",
        "JAVANGLE_HOUSE_SNAKESHOT_NAME": "Serpenta Pafo",
        "JAVANGLE_HOUSE_SNAKESHOT_DESCRIPTION": "Provu pafi pafon, <style=cSub>malsukcesu</style>, kaj ricevu <style=cDeath>{0}% de via maksimuma sano kiel damagxon</style>.",
        "JAVANGLE_HOUSE_BLANKSHOT_NAME": "Malplena Pafo",
        "JAVANGLE_HOUSE_BLANKSHOT_DESCRIPTION": "Provu pafi pafon, <style=cSub>malsukcesu</style>, kaj aspektu stulte, lol.",
        "JAVANGLE_HOUSE_MYSTERYSHOT_NAME": "Mistera Pafo",
        "JAVANGLE_HOUSE_MYSTERYSHOT_DESCRIPTION": "Pafu tute hazardan pafajxon, gxi vere povus esti io ajn.",
        "JAVANGLE_HOUSE_ACESHOT_NAME": "Asa Pafo",
        "JAVANGLE_HOUSE_ACESHOT_DESCRIPTION": "Sxargu grandegan pafon, kiu faras <style=cIsDamage>{0}% da damagxo</style> al cxiuj malamikoj antaux vi, frapante el cxiuj distancoj kaj ecx tra muroj.",
        "JAVANGLE_HOUSE_7CLUBS_NAME": "7 de Trefoj",
        "JAVANGLE_HOUSE_7CLUBS_DESCRIPTION": "Sxargu <style=cIsUtility>3 Misterajn Pafojn</style> en la ruleton.\nKrome, <style=cIsUtility>garantias</style>, ke via sekva kuglo estos Eksploda Pafo.",
        "JAVANGLE_HOUSE_7SPADES_NAME": "7 de Pikoj",
        "JAVANGLE_HOUSE_7SPADES_DESCRIPTION": "Gajnu <style=cIsUtility>Pliigitan Movrapidecon</style> kaj ankaux <style=cIsUtility>2 tute hazardajn bonigojn</style> dum {0} sekundoj.\nKrome, <style=cIsUtility>garantias</style>, ke via sekva kuglo estos Penetrema Pafo.",
        "JAVANGLE_HOUSE_7DIAMONDS_NAME": "7 de Karoj",
        "JAVANGLE_HOUSE_7DIAMONDS_DESCRIPTION": "<style=cShrine>Gajnu Oron</style> <style=cSub>(skalas kun kofrokostoj)</style>.",
        "JAVANGLE_HOUSE_7HEARTS_NAME": "7 de Keroj",
        "JAVANGLE_HOUSE_7HEARTS_DESCRIPTION": "<style=cIsHealing>Sanigxu je 50% de via maksimuma sano</style> kaj <style=cIsUtility>gajnu gxis 50% da baro</style> depende de nuna sano.",
        "JAVANGLE_HOUSE_JACKPOT_NAME": "Cxiu-trafo",
        "JAVANGLE_HOUSE_JACKPOT_DESCRIPTION": "Hazarde aktivigas la efikojn de ''7 de Trefoj'', ''7 de Karoj'', ''7 de Keroj'', aux ''7 de Pikoj'' kun duobla efiko, 20% sxanco <style=cIsUtility>aktivigi cxiujn samtempe</style>.",
        "JAVANGLE_HOUSE_52_NAME": "Kolektu 52",
        "JAVANGLE_HOUSE_52_DESCRIPTION": "Jxetas cxiujn restantajn kartojn en la aeron kaj remiksas cxion reen en la tirstakon, cxiu karto celas malamikojn kaj <style=cIsDamage>faras diversajn kvantojn da Damagxo</style>.",
        "JAVANGLE_HOUSE_SNAKE_NAME": "Serpentaj Okuloj",
        "JAVANGLE_HOUSE_SNAKE_DESCRIPTION": "JAVANGLE_HOUSE_TOWER_DESCRIPTION<style=cArtifact>Krizo</style>, <style=cDeath>Detruo</style>, <style=cArtifact>Katastrofo</style>, <style=cDeath>Perdoj</style>, <style=cArtifact>Malhelpoj</style>, <style=cDeath>Vaporigema</style>.<style=cIsUtility>[Nedetruebla]</style> ",
        "JAVANGLE_HOUSE_BUST_NAME": "Bankroto",
        "JAVANGLE_HOUSE_BUST_DESCRIPTION": "Tuj ricevu <style=cDeath>{0}% de via maksimuma sano kiel damagxon</style>, kaj <style=cIsDamage>faru {1}% de via maksimuma sano</style> kiel damagxon al proksimaj malamikoj.",
        "JAVANGLE_HOUSE_SWORDS_NAME": "10 de Glavoj",
        "JAVANGLE_HOUSE_SWORDS_DESCRIPTION": "Alvoku potencajn malamikojn cxirkaux vi mem.",
        "JAVANGLE_HOUSE_COINS_NAME": "5 de Moneroj",
        "JAVANGLE_HOUSE_COINS_DESCRIPTION": "<style=cArtifact>Perdu {0}% de via nuna oro</style> kaj <style=cIsDamage>faru {1}% de la perdita oro kiel damagxon</style> al proksimaj malamikoj.",
        "JAVANGLE_HOUSE_TOWER_NAME": "La Turo",
        "JAVANGLE_HOUSE_TOWER_DESCRIPTION": "<style=cArtifact>Krizo</style>, <style=cDeath>Detruo</style>, <style=cArtifact>Katastrofo</style>, <style=cDeath>Perdoj</style>, <style=cArtifact>Malhelpoj</style>, <style=cDeath>Vaporigema</style>.\n<style=cIsUtility>[Nedetruebla]</style>",
        "JAVANGLE_HOUSE_JOKER_NAME": "Jokero",
        "JAVANGLE_HOUSE_JOKER_DESCRIPTION": "Aktivigas hazardan alian <style=cArtifact>Purpuran Kartefikon</style>, 20% sxanco aktivigi <style=cArtifact>cxiujn samtempe</style>.\n<style=cSub>(Ne povas Aktivigi Turon.)</style>",
        "JAVANGLE_HOUSE_7JACK_NAME": "Fanto de Karoj",
        "JAVANGLE_HOUSE_7JACK_DESCRIPTION": "Sxargu 6 normalajn pafojn.\nSe surgrunde: glitas antauxen.",
        "JAVANGLE_HOUSE_7QUEEN_NAME": "Damo de Keroj",
        "JAVANGLE_HOUSE_7QUEEN_DESCRIPTION": "Provizore <style=cIsUtility>plibonigas 2 hazardajn statistikojn</style>, sed <style=cArtifact>malplibonigas 2 aliajn hazardajn statistikojn</style>.",
        "JAVANGLE_HOUSE_7KING_NAME": "Regxo de Trefoj",
        "JAVANGLE_HOUSE_7KING_DESCRIPTION": "Sxargas Eksplodan, Penetarman, Pafan, Serpentan, Malplenan kaj Misteran Pafojn.",
        "JAVANGLE_HOUSE_7ACE_NAME": "Aso de Pikoj",
        "JAVANGLE_HOUSE_7ACE_DESCRIPTION": "Sxargas nenion krom 1 unikan pafon, kiu faras <style=cIsDamage>{0}% da damagxo</style> post longa prokrasto.",
        "JAVANGLE_HOUSE_WILDCARD_NAME": "Jxokerkarto",
        "JAVANGLE_HOUSE_WILDCARD_DESCRIPTION": "Faras ion neantauxvideblan. Povus esti bona, povus esti malbona, povus esti nek... eble ambaux?\n<style=cIsUtility>[Nedetruebla]</style>",
        "JAVANGLE_HOUSE_RROULETTE_NAME": "Rusa Ruleto",
        "JAVANGLE_HOUSE_RROULETTE_DESCRIPTION": "JAVANGLE_HOUSE_GSPADES_DESCRIPTIONGajnu <style=cIsUtility> Pliigitan Movrapidecon</style> dum {0} sekundoj.Krome, <style=cIsUtility>garantias</style>, ke via sekva kuglo estos Penetrema Pafo.",
        "JAVANGLE_HOUSE_FORTUNE_NAME": "Rado de Fortuno",
        "JAVANGLE_HOUSE_FORTUNE_DESCRIPTION": "50% sxanco <style=cShrine>duobligi nunan oron</style>, 50% sxanco <style=cArtifact>perdi cxiun oron</style> kaj <style=cIsUtility>ruli por hazarda objekto</style> surbaze de perdita oro.",
        "JAVANGLE_HOUSE_THREEOFAKIND_NAME": "Triopo",
        "JAVANGLE_HOUSE_THREEOFAKIND_DESCRIPTION": "Tiru kaj <style=cIsUtility>ludu la tutan sekvan manon</style> samtempe.",
        "JAVANGLE_HOUSE_GCLUBS_NAME": "Trefoj",
        "JAVANGLE_HOUSE_GCLUBS_DESCRIPTION": "Sxargu <style=cIsUtility>3 hazardajn Pozitivajn Pafojn</style> en la ruleton.\nKrome, <style=cIsUtility>garantias</style>, ke via sekva kuglo estos Eksploda Pafo.",
        "JAVANGLE_HOUSE_GSPADES_NAME": "Pikoj",
        "JAVANGLE_HOUSE_GSPADES_DESCRIPTION": "Gajnu <style=cIsUtility> Pliigitan Movrapidecon</style> dum {0} sekundoj.\nKrome, <style=cIsUtility>garantias</style>, ke via sekva kuglo estos Penetrema Pafo.",
        "JAVANGLE_HOUSE_GHEARTS_NAME": "Keroj",
        "JAVANGLE_HOUSE_GHEARTS_DESCRIPTION": "<style=cIsHealing>Sanigxu je 50% de via maksimuma sano</style>",
        "JAVANGLE_HOUSE_GJACK_NAME": "Fanto",
        "JAVANGLE_HOUSE_GJACK_DESCRIPTION": "Faras nenion.",
        "JAVANGLE_HOUSE_CRAZYCARD_NAME": "Freneza Karto",
        "JAVANGLE_HOUSE_CRAZYCARD_DESCRIPTION": "Hazarde aktivigas alian karton de Normala Disvolvo.",
        "JAVANGLE_HOUSE_CASHOUT_NAME": "Elpago",
        "JAVANGLE_HOUSE_CASHOUT_DESCRIPTION": "1/3 sxanco <style=cArtifact>perdi cxiun monon</style>, 1/3 sxanco fari nenion, 1/3 sxanco <style=cIsDamage>damagxi cxiun malamikon sur la mapo</style> kaj <style=cIsUtility>doni provizoran objekton</style>.\n<style=cSub>(Damagxo kaj objekta malofteco skalas kun riskita mono)</style>",
        "JAVANGLE_HOUSE_THESUN_NAME": "La Suno",
        "JAVANGLE_HOUSE_THESUN_DESCRIPTION": "<style=cIsUtility>Kreas duplikaton de cxiu alia karto en la mano</style> kaj tiras ilin en la sekvan manon.\n<style=cSub>(Ne funkcias sur 'Nedetrueblaj' kartoj)</style>.\n<style=cSub>(Cxi tiu efiko ne povas esti ekigita de aliaj kartoj)</style>.",
        "JAVANGLE_HOUSE_THEMOON_NAME": "La Luno",
        "JAVANGLE_HOUSE_THEMOON_DESCRIPTION": "<style=cIsUtility>Detruas cxiun alian karton en la mano</style>, forigante ilin de la kartaro.\n<style=cSub>(Ne funkcias sur 'Nedetrueblaj' kartoj)</style>.\n<style=cSub>(Cxi tiu efiko ne povas esti ekigita de aliaj kartoj)</style>.",
        "JAVANGLE_HOUSE_THESTAR_NAME": "La Stelo",
        "JAVANGLE_HOUSE_THESTAR_DESCRIPTION": "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION<style=cIsUtility>Detruas cxiujn kartojn 'La Suno', 'La Luno', 'La Stelo' kaj 'La Mondo'</style> el la tirstako, mano kaj forjxetstako, forigante ilin de la kartaro.<style=cSub>(Cxi tiu efiko ne povas esti ekigita de aliaj kartoj)</style>.",
        "JAVANGLE_HOUSE_THEWORLD_NAME": "La Mondo",
        "JAVANGLE_HOUSE_THEWORLD_DESCRIPTION": "<style=cIsUtility>Detruas cxiujn kartojn 'La Suno', 'La Luno', 'La Stelo' kaj 'La Mondo'</style> el la tirstako, mano kaj forjxetstako, forigante ilin de la kartaro.\n<style=cSub>(Cxi tiu efiko ne povas esti ekigita de aliaj kartoj)</style>.",
        "JAVANGLE_HOUSE_JUDGEMENT_NAME": "Jugxo",
        "JAVANGLE_HOUSE_JUDGEMENT_DESCRIPTION": "<style=cIsUtility>Tute anstatauxigas la kartaron per la originala versio</style>, malfarante iujn ajn sxangxojn faritajn al gxi. <style=cSub>(kvazaux vi revivigxis, aux sxangxis etapon)</style>\n<style=cSub>(Cxi tiu efiko ne povas esti ekigita de aliaj kartoj)</style>.\n<style=cIsUtility>[Nedetruebla]</style>",
        "JAVANGLE_HOUSE_KINGOFWANDS_NAME": "Regxo de Bastonoj",
        "JAVANGLE_HOUSE_KINGOFWANDS_DESCRIPTION": "<style=cIsUtility>Konsumas gxis  stakojn de 'Ante'</style>, kaj <style=cIsHealing>provizas gxis % da sanigo</style> depende de kiom da 'Ante' estis elspezita.\n<style=cIsHealing>Cxiuj kontrolataj aliancanoj estas sanigitaj je duono de la kvanto</style>.",
        "JAVANGLE_HOUSE_QUEENOFCUPS_NAME": "Damo de Tasoj",
        "JAVANGLE_HOUSE_QUEENOFCUPS_DESCRIPTION": "<style=cIsUtility>Konsumas gxis  stakojn de 'Ante'</style>, kaj donas bonigon, kiu permesas al House <style=cIsUtility>pafi sxargitajn pafojn sen elspezi ilin</style>.\nCxi tiu bonigo dauxras gxis  sekundojn, depende de kiom da 'Ante' estas elspezita.",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_NAME": "Kavaliro de Glavoj",
        "JAVANGLE_HOUSE_KNIGHTOFSWORDS_DESCRIPTION": "<style=cIsUtility>Konsumas gxis  stakojn de 'Ante'</style>, kaj <style=cIsUtility>sxargas nombron da pozitivaj kartocxoj</style> egalan al la kvanto de 'Ante' elspezita.\nKrome, <style=cIsUtility>garantias</style>, ke via sekva kuglo estos Eksploda Pafo.",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_NAME": "Pagxio de Pentakloj",
        "JAVANGLE_HOUSE_PAGEOFPENTACLES_DESCRIPTION": "<style=cIsUtility>Konsumas gxis  stakojn de 'Ante'</style>, kaj alvokas Lunajn Kimerojn por batali por vi, ju pli da 'Ante' vi elspezas, des pli granda estos la alvokita forto.\nJe  stakoj elspezitaj, cxi tiu karto alvokos hazardan postvivanton anstatauxe.",
        "JAVANGLE_HOUSE_ANTEUP_NAME": "Pliigu la Veton!",
        "JAVANGLE_HOUSE_ANTEUP_DESCRIPTION": "<style=cIsUtility>Donas  stakojn de 'Ante'</style>.\nCxiu stako de Ante reduktas kirason, kaj pliigas movigx- kaj atakrapidecon.",
        "JAVANGLE_HOUSE_ANCIENTACE_NAME": "Antikva Aso",
        "JAVANGLE_HOUSE_ANCIENTACE_DESCRIPTION": "Sxargu <style=cIsUtility>6 Misterajn Pafojn</style> en la ruleton.\nKrome, <style=cIsUtility>donas unu el la sekvaj efikoj</style>:\n<style=cIsUtility>Duopoj</style>: Cxiu karto kiun vi ludas, ludigxas dufoje\n<style=cIsUtility>Samkoloro</style>: Cxiun fojon kiam vi ludas karton, ludu la reston de via mano (preterlasante negativajn kaj hazardajn kartojn)\n<style=cIsUtility>Tasoj</style>: Pafado de Ruleto ne plu kostas Municion\n<style=cIsUtility>[Nedetruebla]</style>",
        "ARTIFACT_OF_WILDROOM_NAME": "Artefakto de Wildroom",
        "ARTIFACT_OF_WILDROOM_DESCRIPTION": "Alvoku Wildroom je la komenco de cxiu etapo.\nWildroom ne plu povas forigi sin mem, kaj nun efikas al ne-House ludantoj.",
        "JAVANGLE_HOUSE_NULL_NAME": "Nulo",
        "JAVANGLE_HOUSE_NULL_DESCRIPTION": "Faras nenion, ecx ne resxargas.\nVi faris gxin, vi detruis cxion, vi reduktis gxin al nenio, kaj nun nenio estas cxio kio restas... cxu vi estas felicxa..?"
    }
}