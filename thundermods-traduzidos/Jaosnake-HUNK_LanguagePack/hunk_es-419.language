    "ROB_HUNK_WEAPON_ADDON_MUP_NAME": "Culata (MUP)",
    "ROB_HUNK_WEAPON_ADDON_MUP_DESC": "Una pieza personalizada para la MUP que le permite disparar 3 balas cada vez que aprietas el gatillo.",
    "ROB_HUNK_WEAPON_ADDON2_MUP_NAME": "Mira de Punto Rojo (MUP)",
    "ROB_HUNK_WEAPON_ADDON2_MUP_DESC": "Una pieza personalizada para la MUP. Añade una mira que mejora su eficacia a larga distancia y al impactar puntos débiles.",
    "ROB_HUNK_WEAPON_ADDON3_MUP_NAME": "Cargador de Alta Capacidad (MUP)",
    "ROB_HUNK_WEAPON_ADDON3_MUP_DESC": "Una pieza personalizada para la MUP que amplía la capacidad del cargador a 33 balas y acorta el tiempo de recarga.",
    "ROB_HUNK_WEAPON_ADDON4_MUP_NAME": "Freno de Boca (MUP)",
    "ROB_HUNK_WEAPON_ADDON4_MUP_DESC": "Una pieza personalizada para la MUP que aumenta su daño al 600%.",
    "ROB_HUNK_WEAPON_SG09_NAME": "SG-09 R",
    "ROB_HUNK_WEAPON_SG09_DESC": "Una pistola fácil de usar con gran capacidad de munición.",
    "ROB_HUNK_WEAPON_ADDON_SG09_NAME": "Cargador de Alta Capacidad (SG-09 R)",
