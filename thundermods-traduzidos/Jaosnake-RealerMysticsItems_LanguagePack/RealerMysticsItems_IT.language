    "BUFF_MYSTICSITEMS_CRYSTALLIZED_NAME": "Cristallizzato",
    "BUFF_MYSTICSITEMS_CRYSTALLIZED_DESC": "<color=#FF7F7F>Impossibile usare abilità.</color>",
    "BUFF_MYSTICSITEMS_DASHERDISCACTIVE_NAME": "Incorporeo",
    "BUFF_MYSTICSITEMS_DASHERDISCACTIVE_DESC": "Non subisci danni",
    "BUFF_MYSTICSITEMS_DASHERDISCCOOLDOWN_NAME": "Recupero di Esecuzione Tempestiva",
    "BUFF_MYSTICSITEMS_DASHERDISCCOOLDOWN_DESC": "Esecuzione Tempestiva non può essere attivata",
    "BUFF_MYSTICSITEMS_DEAFENED_NAME": "Assordato",
    "BUFF_MYSTICSITEMS_DEAFENED_DESC": "Velocità d'attacco, velocità di movimento, armatura e danni ridotti",
    "BUFF_MYSTICSITEMS_MARWANASHBURN_NAME": "Luce di Marwan",
    "BUFF_MYSTICSITEMS_MARWANASHBURN_DESC": "Perdi una frazione della tua salute ogni secondo",
    "BUFF_MYSTICSITEMS_MARWANASHBURNSTRONG_NAME": "Luce di Marwan",
    "BUFF_MYSTICSITEMS_MARWANASHBURNSTRONG_DESC": "Perdi una frazione della tua salute ogni secondo",
    "BUFF_MYSTICSITEMS_MECHANICALARMCHARGE_NAME": "Carica del braccio meccanico",
