        "ROB_SAMPLECOST": "Зразок вірусу",
        "ROB_HUNK_CHEST_NAME": "Збройовий кейс: ",
        "ROB_HUNK_CHEST_CONTEXT": "Відкрити збройовий кейс",
        "ROB_HUNK_CASE_INSPECT_NAME": "Збройовий кейс",
        "ROB_HUNK_CASE_INSPECT_DESC": "Кейс із новою зброєю для HUNK. Для відкриття потрібна відповідна ключ-картка.",
        "ROB_HUNK_SPECIALCASE_INSPECT_NAME": "Особливий збройовий кейс",
        "ROB_HUNK_SPECIALCASE_INSPECT_DESC": "Особливий кейс із потужною новою зброєю для HUNK. Для відкриття потрібен певний рівень допуску.",
        "ROB_HUNK_STARSBOX_INSPECT_NAME": "Ящик S.T.A.R.S.",
        "ROB_HUNK_STARSBOX_INSPECT_DESC": "Особливий ящик із потужним спорядженням для бійців S.T.A.R.S. Для відкриття потрібен значок.",
        "ROB_HUNK_WEAPONBOX_INSPECT_NAME": "Кейс із припасами",
        "ROB_HUNK_WEAPONBOX_INSPECT_DESC": "Збройовий кейс із корисним вмістом усередині.",
        "ROB_HUNK_LOOTBOX_INSPECT_NAME": "Кейс із припасами",
        "ROB_HUNK_LOOTBOX_INSPECT_DESC": "Фірмовий кейс Umbrella з корисним вмістом усередині.",
        "ROB_HUNK_TERMINAL_INSPECT_NAME": "Термінал Umbrella",
        "ROB_HUNK_TERMINAL_INSPECT_DESC": "Використовується для відправки зразків вірусів корпорації Umbrella. Здані зразки належно винагороджуються.",
        "ROB_HUNK_AMMO_NAME": "Набої",
        "ROB_HUNK_AMMO_CONTEXT": "Підібрати набої",
        "ROB_HUNK_GRENADE_NAME": "Граната",
        "ROB_HUNK_GRENADE_CONTEXT": "Підібрати гранату",
        "ROB_HUNK_BADGE_NAME": "Труп",
        "ROB_HUNK_BADGE_CONTEXT": "Оглянути труп",
        "ROB_HUNK_BADGE_CONTEXT2": "Взяти значок?",
        "ROB_HUNK_C4_NAME": "C4",
        "ROB_HUNK_C4_CONTEXT": "Активувати детонатор",
        "ROB_HUNK_KEYWORD_LOOTING": "<style=cKeywordName>Здобич</style><style=cSub>Вороги, вбиті цим вмінням, мають невеликий шанс скинути набої.</style>",
        "ROB_HUNK_KEYWORD_MANGLED": "<style=cKeywordName>Понівечення</style><style=cSub>При досягненні 6 зарядів цього дебафу вороги миттєво отримують <style=cIsDamage>2200% шкоди</style>.</style>",
        "ROB_HUNK_KEYWORD_PERFECTDODGE": "<style=cKeywordName>Ідеальне ухиляння</style><style=cSub><style=cIsUtility>Повертає перезаряджання</style> та надає короткочасну невразливість. Дозволяє виконати <style=cIsDamage>Контратаку</style>.</style>",
        "ROB_HUNK_KEYWORD_PERFECTPARRY": "<style=cKeywordName>Ідеальне парирування</style><style=cSub>Завдає <style=cIsDamage>800% шкоди</style> та надає короткочасну невразливість. Дозволяє виконати <style=cIsDamage>Контратаку</style>.</style>",
        "ROB_HUNK_KEYWORD_PERFECTBASH": "<style=cKeywordName>Ідеальний удар плечем</style><style=cSub><style=cIsUtility>Повертає перезаряджання</style> та надає короткочасну невразливість. Дозволяє виконати <style=cIsDamage>Контратаку</style>.</style>",
        "ROB_HUNK_KEYWORD_COUNTER": "<style=cKeywordName>Контратака</style><style=cSub>Натискання <style=cIsDamage>основного вміння</style> виконує випад і завдає смертельної <style=cIsDamage>контратаки</style> найближчому ворогу.</style>",
        "ROB_HUNK_KEYWORD_VIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Раз на етап випадковий монстр стає <color=#C678B4>Зараженим</color>. Він мутує, <style=cIsHealth>стаючи сильнішим із часом</style>, а після його вбивства випадає <color=#FFFF00>Зразок G-Virus</color>.</style>\n\n<style=cKeywordName>T-Virus</style><style=cSub>Раз на етап кілька монстрів стають <color=#0066FF>Зараженими</color>. Це <style=cIsHealth>воскрешає</style> їх двічі, а вбивство всіх приносить <color=#FFFF00>Зразок T-Virus</color>.</style>\n\n<style=cKeywordName>C-Virus</style><style=cSub>Раз на етап кілька монстрів стають <color=#FF0033>Зараженими</color>. Після смерті ці монстри впадають у <style=cIsDamage>шаленство</style> на <style=cIsUtility>5</style> секунд, а потім <style=cIsHealth>вибухають</style>, і вбивство всіх приносить <color=#FFFF00>Зразок C-Virus</color>.</style>",
        "ROB_HUNK_KEYWORD_GVIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Раз на етап випадковий монстр стає <color=#C678B4>Зараженим</color>. Він мутує, <style=cIsHealth>стаючи сильнішим із часом</style>, а після його вбивства випадає <color=#FFFF00>Зразок G-Virus</color>.</style>",
        "ROB_HUNK_KEYWORD_TVIRUS": "<style=cKeywordName>T-Virus</style><style=cSub>Раз на етап кілька монстрів стають <color=#0066FF>Зараженими</color>. Це <style=cIsHealth>воскрешає</style> їх двічі, а вбивство всіх приносить <color=#FFFF00>Зразок T-Virus</color>.</style>",
        "ROB_HUNK_KEYWORD_CVIRUS": "<style=cKeywordName>C-Virus</style><style=cSub>Раз на етап кілька монстрів стають <color=#FF0033>Зараженими</color>. Після смерті ці монстри впадають у <style=cIsDamage>шаленство</style> на <style=cIsUtility>5</style> секунд, а потім <style=cIsHealth>вибухають</style>, і вбивство всіх приносить <color=#FFFF00>Зразок C-Virus</color>.</style>",
        "ROB_HUNK_WEAPON_SMG_NAME": "LE 5",
        "ROB_HUNK_WEAPON_SMG_DESC": "Високоефективний пістолет-кулемет.",
        "ROB_HUNK_WEAPON_ADDON_SMG_NAME": "Лазерний приціл (LE 5)",
        "ROB_HUNK_WEAPON_ADDON_SMG_DESC": "Спеціальний модуль для LE 5, що підвищує ефективність на дальній дистанції та при влучанні у слабкі точки.",
        "ROB_HUNK_WEAPON_ADDON2_SMG_NAME": "Збільшений магазин (LE 5)",
        "ROB_HUNK_WEAPON_ADDON2_SMG_DESC": "Спеціальний модуль для LE 5, що значно збільшує місткість магазина.",
        "ROB_HUNK_WEAPON_ADDON3_SMG_NAME": "Модератор (LE 5)",
        "ROB_HUNK_WEAPON_ADDON3_SMG_DESC": "Спеціальний модуль для LE 5, що обмежує скорострільність, натомість перетворюючи цей бонус на шкоду.",
        "ROB_HUNK_WEAPON_SMG2_NAME": "LE 5",
        "ROB_HUNK_WEAPON_SMG2_DESC": "Високоефективний пістолет-кулемет.",
        "ROB_HUNK_WEAPON_M19_NAME": "M19",
        "ROB_HUNK_WEAPON_M19_DESC": "Потужний пістолет із вбудованим лазерним прицілом.",
        "ROB_HUNK_WEAPON_ADDON_M19_NAME": "Глушник (M19)",
        "ROB_HUNK_WEAPON_ADDON_M19_DESC": "Спеціальний модуль для M19, що приглушує звук пострілів і діє як противага, значно зменшуючи підкидання ствола та підвищуючи швидкість куль.",
        "ROB_HUNK_WEAPON_ADDON2_M19_NAME": "Магазин підвищеної місткості (M19)",
        "ROB_HUNK_WEAPON_ADDON2_M19_DESC": "Спеціальний модуль для M19, що збільшує місткість обойми до 15 набоїв.",
        "ROB_HUNK_WEAPON_MUP_NAME": "MUP",
        "ROB_HUNK_WEAPON_MUP_DESC": "Добре збалансований пістолет.",
        "ROB_HUNK_WEAPON_ADDON_MUP_NAME": "Приклад (MUP)",
        "ROB_HUNK_WEAPON_ADDON_MUP_DESC": "Спеціальний модуль для MUP, що дозволяє стріляти чергами по 3 набої за одне натискання спускового гачка.",
        "ROB_HUNK_WEAPON_ADDON2_MUP_NAME": "Коліматорний приціл (MUP)",
        "ROB_HUNK_WEAPON_ADDON2_MUP_DESC": "Спеціальний модуль для MUP. Додає приціл, що підвищує ефективність на дальній дистанції та при влучанні у слабкі точки.",
        "ROB_HUNK_WEAPON_ADDON3_MUP_NAME": "Магазин підвищеної місткості (MUP)",
        "ROB_HUNK_WEAPON_ADDON3_MUP_DESC": "Спеціальний модуль для MUP, що збільшує місткість обойми до 33 набоїв і скорочує час перезаряджання.",
        "ROB_HUNK_WEAPON_ADDON4_MUP_NAME": "Дульне гальмо (MUP)",
