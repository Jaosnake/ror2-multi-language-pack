    "SKILL_LUNAR_PRIMARY_REPLACEMENT_NAME": "क्षुधित दृष्टि",
    "SKILL_LUNAR_PRIMARY_REPLACEMENT_DESCRIPTION": "<style=cIsUtility>लक्ष्य का पीछा करने वाले टुकड़ों</style> की बौछार दागें जो थोड़ी देर बाद विस्फोट होकर <style=cIsDamage>120% क्षति</style> पहुँचाते हैं।",
    "SKILL_LUNAR_SECONDARY_REPLACEMENT_NAME": "चीरता भँवर",
    "SKILL_LUNAR_SECONDARY_REPLACEMENT_DESCRIPTION": "ब्लेडों का एक गोला चार्ज करें जो बार-बार <style=cIsDamage>175%</style> क्षति पहुँचाता है। थोड़ी देर बाद विस्फोट होकर सभी दुश्मनों को <style=cIsDamage>जकड़ देता है</style> और <style=cIsDamage>700%</style> क्षति पहुँचाता है।",
    "SKILL_LUNAR_UTILITY_REPLACEMENT_NAME": "छाया विलीनता",
    "SKILL_LUNAR_UTILITY_REPLACEMENT_DESCRIPTION": "ओझल होकर <style=cIsUtility>अभौतिक</style> बन जाएँ और <style=cIsUtility>चलने की गति बढ़ाएँ</style>। अपने <style=cIsHealing>अधिकतम स्वास्थ्य का 25%</style> <style=cIsHealing>उपचार करें</style>।",
    "SKILL_LUNAR_SPECIAL_REPLACEMENT_NAME": "विनाश",
    "SKILL_LUNAR_SPECIAL_REPLACEMENT_DESCRIPTION": "क्षति पहुँचाने पर विनाश की एक परत जुड़ती है। कौशल सक्रिय करने पर असीमित दूरी से विनाश की सभी परतों में विस्फोट होता है, जिससे 300% क्षति तथा विनाश की प्रत्येक परत पर 120% अतिरिक्त क्षति पहुँचती है।",
