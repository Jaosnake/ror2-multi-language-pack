        "ROB_HUNK_BODY_SHOOT_ROCKETLAUNCHER_NAME": "Fogo",
        "ROB_HUNK_BODY_SHOOT_ROCKETLAUNCHER_DESCRIPTION": "Dispara com <style=cIsDamage>12.000% de dano</style>. <style=cIsDamage>Incendiário.</style>",
        "ROB_HUNK_BODY_SHOOT_GRENADELAUNCHER_NAME": "Fogo",
        "ROB_HUNK_BODY_SHOOT_GRENADELAUNCHER_DESCRIPTION": "Dispara com <style=cIsDamage>3.200% de dano</style>. <style=cIsDamage>Incendiário.</style>",
        "ROB_HUNK_BODY_SHOOT_MGL_NAME": "Fogo",
        "ROB_HUNK_BODY_SHOOT_MGL_DESCRIPTION": "Dispara com <style=cIsDamage>2.400% de dano</style>.",
        "ROB_HUNK_BODY_SHOOT_RAILGUN_NAME": "Fogo",
        "ROB_HUNK_BODY_SHOOT_RAILGUN_DESCRIPTION": "Dispara com <style=cIsDamage>20.000% de dano</style>.",
        "ROB_HUNK_BODY_SHOOT_FLAMETHROWER_NAME": "Fogo",
        "ROB_HUNK_BODY_SHOOT_FLAMETHROWER_DESCRIPTION": "Dispara um jato de chamas que causa <style=cIsDamage>toneladas de dano</style>. <style=cIsUtility>Acende.</style>",
        "ROB_HUNK_BODY_SHOOT_SCANNER_NAME": "Digitalizar",
        "ROB_HUNK_BODY_SHOOT_SCANNER_DESCRIPTION": "Verifica se há <style=cIsUtility>caixas de armas não abertas</style>.",
        "ROB_HUNK_BODY_SHOOT_HOOKSHOT_NAME": "Tiro de gancho",
        "ROB_HUNK_BODY_SHOOT_HOOKSHOT_DESCRIPTION": "Dispare um gancho para um <style=cIsUtility>ponto distante</style>, então <style=cIsUtility>puxe-se para ele</style>. <style=cIsDamage>Você pode contra-atacar após pousar.</style>",
        "ROB_HUNK_KEYWORD_COUNTER": "<style=cKeywordName>Contra-ataque</style><style=cSub>Pressionar a <style=cIsDamage>habilidade primária</style> avança e executa um <style=cIsDamage>contra-ataque</style> letal em um inimigo próximo.</style>",
        "ROB_HUNK_KEYWORD_PERFECTPARRY": "<style=cKeywordName>Aparada Perfeita</style><style=cSub>Causa <style=cIsDamage>800% de dano</style> e concede invulnerabilidade por um breve período. Permite realizar um <style=cIsDamage>contra-ataque</style>.</style>",
        "ROB_HUNK_KEYWORD_GVIRUS": "<style=cKeywordName>G-vírus</style><style=cSub>Uma vez por fase, um monstro aleatório fica <color=#C678B4>infectado</color>. Ele sofre mutação, <style=cIsHealth>ficando mais forte com o tempo</style>; ao morrer, deixa uma <color=#FFFF00>amostra do G-vírus</color>.</style>",
        "ROB_HUNK_KEYWORD_TVIRUS": "<style=cKeywordName>T-vírus</style><style=cSub>Uma vez por fase, vários monstros ficam <color=#0066FF>infectados</color>. Isso os <style=cIsHealth>ressuscita</style> duas vezes; eliminar todos concede uma <color=#FFFF00>amostra do T-vírus</color>.</style>",
        "ROB_HUNK_KEYWORD_VIRUS": "Vírus",
        "ROB_HUNK_SURVIVALKIT_NAME": "Kit de sobrevivência de emergência",
        "ROB_HUNK_SURVIVALKIT_DESC": "Um kit de sobrevivência que aumenta sua capacidade de procurar munição e a eficácia de sua faca.",
        "ROB_HUNK_CRYSTALSKULL_NAME": "Caveira de Cristal",
        "ROB_HUNK_CRYSTALSKULL_DESC": "Um tesouro raro. Pode ser negociado em qualquer <style=cIsUtility>Cauldron</style> para receber um item.",
        "ROB_HUNK_WRISTBAND_NAME": "Pulseira de identificação",
        "ROB_HUNK_WRISTBAND_DESC": "Uma chave eletrônica para uso nas instalações da <color=#C80202>Umbrella Corporation</color>. Usado para abrir uma <style=cIsUtility>caixa de arma especial</style>.",
        "ROB_HUNK_SPADE_KEYCARD_NAME": "U.C. Cartão-chave (Espadas)",
        "ROB_HUNK_CLUB_KEYCARD_NAME": "U.C. Cartão-chave (clubes)",
        "ROB_HUNK_HEART_KEYCARD_NAME": "U.C. Cartão-chave (corações)",
        "ROB_HUNK_DIAMOND_KEYCARD_NAME": "U.C. Cartão-chave (diamantes)",
        "ROB_HUNK_GOLD_KEYCARD_NAME": "U.C. Cartão-chave (estrela)",
        "ROB_HUNK_MASTER_KEYCARD_NAME": "U.C. Cartão-chave (mestre)",
        "ROB_HUNK_KEYCARD_DESC": "Usado para abrir <color=#C80202>caixas de armas</color> da <style=cIsUtility>Umbrella Corporation</style>.",
        "ROB_HUNK_KEYCARD_MASTER_DESC": "Usado para abrir <color=#C80202>caixas de armas</color> da <style=cIsUtility>Umbrella Corporation</style>. Abre <style=cIsHealing>todos os casos</style> e transforma outros cartões-chave em <style=cIsUtility>scrap</style>.",
        "ROB_HUNK_STARSBADGE_DESCFULL": "Cada estágio, uma caixa especial <color=#F20443>S.T.A.R.S.</color> surge que só pode ser aberta usando este emblema. No entanto, o <style=cIsHealth>Nemesis T-Type</style> irá caçar você incansavelmente.",
        "ROB_HUNK_STARSBADGE2_DESC": "Usado para acessar um <style=cIsUtility>baú especial</style> em cada estágio.",
        "ROB_HUNK_STARSBADGE2_DESCFULL": "Cada estágio, uma caixa especial <color=#F20443>S.T.A.R.S.</color> surge que só pode ser aberta usando este emblema. No entanto, o <style=cIsHealth>Nemesis T-Type</style> irá caçar você incansavelmente.",
        "ROB_HUNK_G_VIRUS_SAMPLE_NAME": "Amostra de G-Vírus",
        "ROB_HUNK_G_VIRUS_SAMPLE_DESC": "Uma amostra do G-Vírus.",
        "ROB_HUNK_T_VIRUS_SAMPLE_NAME": "Amostra de T-Vírus",
        "ROB_HUNK_T_VIRUS_SAMPLE_DESC": "Uma amostra do T-Vírus.",
