    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Health: </color>35\n<color=#FF0000>Armor: </color>15\n\nRotation Speed: 35\n\nWeight: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% Primary cooldown</color>\n <color=#fc8080>+8% Secondary cooldown</color>\n <color=#fc8080>+8% Utility cooldown</color>\n <color=#fc8080>+8% Special cooldown</color>\n <color=#fc8080>-15% Attack speed</color>\n\n<color=#00FF00>Health: </color>35\n<color=#FF0000>Armor: </color>3\n\nRotation Speed: 30\n\nWeight: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% Damage</color>\n\n<color=#00FF00>Health: </color>5\n<color=#FF0000>Armor: </color>1\n\nRotation Speed: 40\nAngle Limit: 30\n\nWeight: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ORIGINAL",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "RED",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "LIGHT RED",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "GREEN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "DARK GREEN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "BLUE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "CYAN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "PINK",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "HOT PINK",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "MEGENTA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "YELLOW",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "NEON YELLOW",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "NEON PURPLE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "ORANGE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "WHITE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "BLACK",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "This changes the 'glowy' part of the vehicle to a different color.  Does not affect gameplay.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Dirty",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Clean",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Jagged_Camo",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Pixel_Camo",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Paper_Camo",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Diamond_Plate",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Bolted_Plate",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Procedural_Set",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Colorful_Blend",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Gradient_Rainbow",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Monochrome",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Fluid_Galaxy",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Space",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Engine Systems",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Utilities and thrust consume fuel. Fuel replenishment is affected by <style=cIsUtility>attack speed</style>; fuel capacity is affected by <style=cIsUtility>afterburners</style> and <style=cIsUtility>jump-induced items</style>. Tank can <style=cIsUtility>sprint in any direction</style>. Thrust allows for versatile control in the air. However, <color=#fc8080>tank cannot normally jump</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Super Armory",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "Hull and turret selections affect health, armor, speed, thrust, and mass. <style=cIsUtility>Heavier mass can help push heavier enemies</style>; else be more prone to <color=#ffff80>knockback</color>.\n\nArmor or speed can help assuage the tank’s <color=#fc8080>abysmal health regeneration</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Celestial Instability",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "Tank cannot re-balance itself in the air, <color=#ffff80>being prone to losing control</color>. Landing on your head leaves you <color=#fc8080>immobilized and vulnerable for a short time</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Flight Thrusters",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Hold <style=cIsUtility>Jump</style> to begin flight. Direction of flight depends on the angle of your tank. <style=cIsUtility>Most versatile flight</style>, but may be hard to use.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Pulse Thrusters",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Allows the tank to <style=cIsUtility>jump</style> normally like other survivors. Tank tilt can be activated on 2nd jump. Each jump consumes <color=#ffc080>25</color> fuel.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Hover Thrusters",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Allows the tank to hover off the ground. Hold <style=cIsUtility>Jump</style> to ascend; hold <style=cIsUtility>LeftAlt</style> to descend. Ascending consumes more fuel.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Machine Guns",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Constantly fire for <style=cIsDamage>2x40% damage</style>.\n<style=cSub>[Weight: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Shotgun",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Fire for <style=cIsDamage>12x75% damage</style>.  <color=#ffc080>Burn fuel</color> to <style=cIsUtility>gain extra stock</style>; <color=#80fc80>land a stunt</color> to temporarily gain a power shot for <style=cIsDamage>18x150% damage</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 1s</style> | Weight: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Grenade Launcher",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Fire inaccurate shells for <style=cIsDamage>4x250% damage</style>.  Shells are explosive and heavy.\n<style=cSub>[<style=cIsUtility>Cooldown: 4s</style> | <style=cIsDamage>Radius: 5m</style> | Weight: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Missile Launcher",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Fire accurate missiles for <style=cIsDamage>1000% damage</style>. <style=cIsDamage>Damage increases as it travels</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 3s</style> | <style=cIsDamage>Radius: 8m</style> | Weight: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Flamethrower",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Spew fire for <color=#E85E31>25% burning damage</color> every <color=#ffc080>15 fuel per second</color>.  Damage increases with stacks; <style=cIsUtility>Attack speed increases range</style>.\n<style=cSub>[<color=#ffc080>Fuel Powered</color> | Weight: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ultrantenna",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Electrocute yourself</color> and <style=cIsUtility>activate on-kill items</style>.  <style=cIsUtility>Touching enemies also electrocutes them</style>, and they recieve <style=cIsDamage>250% damage</style> per <style=cIsUtility>on-kill</style> item.\n<style=cSub>[<style=cIsUtility>Cooldown: 7s</style> | <style=cIsDamage>Radius: 5m</style> | Weight: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Critical Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Fire for <color=#ff4d76>1200% crit damage</color>. Critical chance increases damage of the cannon.\n<style=cSub>[<style=cIsUtility>Cooldown: 7s</style> | <style=cIsDamage>Radius: 10m</style> | Weight: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Howitzer Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Charge to fire for a splashy <style=cIsDamage>7000% damage</style>. <style=cIsUtility>Can launch tank if in the air.</style>\n<style=cSub>[<style=cIsUtility>Cooldown: 16s</style> | <style=cIsDamage>Radius: 15m</style> | Weight: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Knocker Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Fire inaccurately for <style=cIsDamage>1700% damage</style>. <style=cIsDamage>Damage decreases as it travels</style>; <style=cIsDamage>Proc items instead increase damage</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 3s</style> | <style=cIsDamage>Radius: 5m</style> | Weight: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Piercing Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Fire for <style=cIsDamage>2500% damage</style>.  Hold to calibrate and deal <style=cIsDamage>3500% damage</style>, capable of <style=cIsUtility>hitting weak points</style>.  When calibrated, <color=#fc8080>moving worsens accuracy</color>.\n<style=cSub>[<style=cIsUtility>Cooldown: 5s</style> | <style=cIsDamage>Radius: 2m</style> | Weight: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "French Gun",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Fire for a measly <style=cIsDamage>550% damage</style>. For some reason, <style=cIsUtility>has too much proc</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 1s</style> | Weight: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Minigun",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Spew for <style=cIsDamage>50% damage</style>. At 75% overheat deals <color=#E85E31>fire</color>; <color=#fc8080>overheating locks up the gun</color>. <style=cIsUtility>Cooldown items increases cooldown rate</style>; <style=cIsUtility>Backup magazines prevents overheat</style>.\n<style=cSub>[Weight: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Basic Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Fire a speedy shell for <style=cIsDamage>5400% damage</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 12s</style> | <style=cIsDamage>Radius: 7m</style> | Weight: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "AA Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Fire for <style=cIsDamage>300% damage</style>.  Projectile detonates near air targets, dealing <style=cIsDamage>2.5x damage</style>.  <color=#fc8080>Tank slows down to fire</color>.\n<style=cSub>[<style=cIsDamage>Radius: 5.5m</style> | Weight: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Splash Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Fire for <style=cIsDamage>2200% damage</style> in a <style=cIsUtility>great arc</style>, splashing for <style=cIsDamage>10x5% total damage</style>.  Damage increases the further it travels, up to <style=cIsDamage>5500% damage</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 10s</style> | <style=cIsDamage>Radius: 16m</style> | Weight: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Celestial Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Consume <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> fuel for <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>damage</color>.  Charged lasers pierce; <color=#fc8080>Insufficient fuel kills the weapon.</color>\n<style=cSub>[<color=#ffc080>Fuel Powered</color> | Weight: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Obliterator Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Charge to auto-fire a <color=#E85E31>kill-triggering shell</color> for <style=cIsDamage>12000% damage</style>.  Afterward, <color=#fc8080>abilites are disabled for 4 seconds.  Shell may hurt allies</color>.\n<style=cSub>[<style=cIsUtility>Cooldown: 21s</style> | <style=cIsDamage>Radius: 5m</style> | Weight: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Auto Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Fire up to 4 shells that deal <style=cIsDamage>2000% damage</style> each. Last shell deals <style=cIsDamage>2x damage</style> in a fixed point.\n<style=cSub>[<style=cIsUtility>Cooldown: 14s</style> | <style=cIsDamage>Radius: 7m</style> | Weight: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Plow",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Dash a small distance</style> for <color=#ffc080>50</color> fuel. Can knockback <style=cIsUtility>any enemy</style> for <style=cIsDamage>1000% damage</style> and replenish <color=#ffc080>40</color> fuel.\n<style=cSub>[<style=cIsUtility>Cooldown: 2s</style> | Weight: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Spikes",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Dash a great distance</style> for <color=#ffc080>50</color> fuel. Ram enemies for <color=#AA2B2A>550% bleed damage</color>.  <style=cIsUtility>Has no cooldown</style>.\n<style=cSub>[Weight: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Turbo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Zoom</style> and consume <color=#ffc080>30</color> fuel per second.  Can ram for <style=cIsDamage>250% damage</style>. Ramming adds <color=#ffc080>20</color> fuel.\n<style=cSub>[<style=cIsUtility>Cooldown: 1s</style> | Weight: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Super Jump",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Launch up for <color=#ffc080>50</color> fuel.  While sprinting, instead launch forward for <color=#ffc080>75</color> fuel and flail your tank for <style=cIsDamage>2500% damage</style>.  Tank weight increases damage.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Bulldozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Boost</style> and consume <color=#ffc080>20</color> fuel per second.  Can plow <style=cIsUtility>any enemy</style> for constant <style=cIsDamage>200% damage</style>.  Deal <style=cIsDamage>350% damage</style> on impact.\n<style=cSub>[<style=cIsUtility>Cooldown: 1s</style> | Weight: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Charge to <style=cIsUtility>dash the greatest distance</style> for <color=#ffc080>100</color> fuel.  <style=cIsUtility>Pierce crowds</style> for <color=#AA2B2A>4000% bleed damage</color> and <style=cIsUtility>prolong dash</style>; Turn to end dash; <color=#80fc80>land a stunt</color> to <style=cIsUtility>skip the charge</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 7s</style> | Weight: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Trencher",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Hold to burrow</style>, consuming <color=#ffc080>20</color> fuel per second, <style=cIsUtility>protecting your tank while under</style>.  Release to pop out and deal <style=cIsDamage>900% damage</style> to nearby enemies.  Cannot engage while under.\n<style=cSub>[<style=cIsDamage>Radius: 10m</style> | Weight: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "King Mine",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Drop a landmine that deals <style=cIsDamage>3000% damage</style>.  <style=cIsDamage>Proc items instead increase damage</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 10s</style> | <style=cIsDamage>Radius: 10m</style> | Weight: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Mini Mines",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Aim and expend all miniature landmines that deal <style=cIsDamage>750% damage</style> each.  Stock and interactable-induced items increase max mines.  <color=#ffc080>Burn fuel</color> to <style=cIsUtility>gain extra stock</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 3s</style> | <style=cIsDamage>Radius: 10m</style> | Weight: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Barrelling",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Launch a barrel for <color=#ffc080>25</color> fuel that ignites on collision for <style=cIsDamage>6500% damage</style>, and leaves a <color=#E85E31>burning puddle</color>.  <color=#80fc80>Landing a stunt</color> causes this ability to be temporarily <color=#fc8080>unstable</color>, which <style=cIsUtility>sends your tank flailing</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 14s</style> | <style=cIsDamage>Radius: 18m</style> | <style=cIsDamage>Zone Radius: 8</style> | Weight: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Self Destruct",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Annihilate <color=#d40000>ALL</color> in a 35m for <style=cIsDamage>100000% damage</style>.  Start with a <color=#80fc80>Dio's Best Friend</color> on new run.\n<style=cSub>[<style=cIsDamage>Radius: 35m</style> | Weight: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "REIGN",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Slow down and charge to fire a barrage of missiles.  Damage increases the further it travels, up to <style=cIsDamage>12x3000% damage.</style>\n<style=cSub>[<style=cIsUtility>Cooldown: 30s</style> | <style=cIsDamage>Radius: 10m</style> | Weight: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Evade",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Emit smoke, stunning nearby enemies for <style=cIsDamage>150% damage</style> and conceal.  <style=cIsUtility>Become immune</style> to damage for 1 second.\n<style=cSub>[<style=cIsUtility>Cooldown: 12s</style> | <style=cIsDamage>Radius: 10m</style> | Weight: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Passive: Berserk",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Removes this skill. Increases <style=cIsDamage>base attack speed by 0.5</style> and decreases <style=cIsUtility>cooldown by 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Passive: Engines",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Removes this skill. Increases <style=cIsUtility>base speed by 1m/s</style> and <style=cIsUtility>thrust power by 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Passive: Armor",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Removes this skill. Increases <style=cIsUtility>base armor by 30</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Mastery",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "As Celestial War Tank, beat the game or obliterate on Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Mastery",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Celestial Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "As Celestial War Tank, go home",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Celestial Cannon",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Obliterator",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "As Celestial War Tank, deal over 1,000,000 damage in one shot.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Obliterator",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "As Celestial War Tank, beat the game or obliterate on Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Tanky",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "As Celestial War Tank, Obtain 10000 HP.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Tanky",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "The ultimate tank of destruction. Resist all types of foes, running and crushing them with its mighty weight and weapons!\n\n<style=cSub>< ! > Tank is huge, and heavily slow, making you susceptible to any form of damage. Playing either extremely defensive or aggressive will help mitigate the amount of damage you will take. Know that the tank has no healing.\n\n< ! > The tank’s body can be used for damage- run your enemies over or use your weight to squish them all!\n\n< ! > When tank crashes, it’s heavier and it takes a while to get back up, susceptible to more fall damage. Tank cannot do stunts.\n\n< ! > Healing factors are mitigated- tank has too much health!\n\n< ! > Press 'T' to honk.  Configurable in mod settings.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Foreign Entity",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Upon further research, we have found some origin to these tanks- the hands of the scavengers. Crafted by quality scrap parts and items from the UES, they had successfully created these war tanks.\n\nHowever, this leads to dangerous conclusions. After obtaining one of the enemy antennas, we have alerted this behemoth sized of a tank. It’s the size of beetle guards!\n\nOf course after a long-fought battle, we have finally taken it down. We hope to take further research and re-alter its mind, in hopes to get better answers. It’ll be a difficult task at that, for it IS alien technology.\n\nOne humongous note to take in, is that upon its defeat, it had summoned an emergency portal. The largest, most violent portal we have ever seen. As much as it might lead us straight into answers, I don’t think it’s going to be a cakewalk in the park. An average tank is far too deadly, and I’m not sure what other inventions made by the scavengers are out there.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ORIGINAL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "WHITE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "BLACK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "RED",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "DARK RED",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "GREEN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "BLUE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "CYAN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_YELLOW_SKIN_NAME": "YELLOW",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NEON_YELLOW_SKIN_NAME": "NEON YELLOW",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MAGENTA_SKIN_NAME": "MAGENTA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PURPLE_SKIN_NAME": "PURPLE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORANGE_SKIN_NAME": "ORANGE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "BROWN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "UNITED STATES",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "GERMANY",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_KINGDOM_SKIN_NAME": "UNITED KINGDOM",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RUSSIA_SKIN_NAME": "RUSSIA",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_FRANCE_SKIN_NAME": "FRANCE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SKINCOLOR_DESCRIPTION": "This changes the body color.  Does not affect gameplay.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_SKIN_NAME": "MAIN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DEFAULT_DIRTY_SKIN_NAME": "DIRTY YELLOW",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_SKIN_NAME": "GREEN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_2_DIRTY_SKIN_NAME": "DIRTY GREEN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_SKIN_NAME": "BLUE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_3_DIRTY_SKIN_NAME": "DIRTY BLUE",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_SKIN_NAME": "RED",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_4_DIRTY_SKIN_NAME": "DIRTY RED",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_MASTERY_SKIN_NAME": "MASTERY",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_NAME": "Rogue Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ROGUE_DESCRIPTION": "\n<color=#FFFF00>Engine Power: </color>3000\n<color=#00FFFF>Speed: </color>10\nTraverse Speed: 0.8\n\n<color=#00FF00>Health: </color>1000\n<color=#FF0000>Armor: </color>75\n\n<color=#AA00FF>Thrust Power: </color>35\n<color=#ffc080>Fuel Amount: </color>500\nWeight: 1000\n\nHull Type: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_NAME": "Griffon Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GRIFFON_DESCRIPTION": "<color=#80fc80>Turret compatible</color>.\n\n<color=#FFFF00>Engine Power: </color>2300\n<color=#00FFFF>Speed: </color>11\nTraverse Speed: 1\n\n<color=#00FF00>Health: </color>800\n<color=#FF0000>Armor: </color>25\n\n<color=#AA00FF>Thrust Power: </color>40\n<color=#ffc080>Fuel Amount: </color>500\nWeight: 800\n\nHull Type: Car",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_NAME": "TONK Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TONK_DESCRIPTION": "\n<color=#FFFF00>Engine Power: </color>1200\n<color=#00FFFF>Speed: </color>12\nTraverse Speed: 2\n\n<color=#00FF00>Health: </color>500\n<color=#FF0000>Armor: </color>25\n\n<color=#AA00FF>Thrust Power: </color>40\n<color=#ffc080>Fuel Amount: </color>300\nWeight: 450\n\nHull Type: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_NAME": "Type 5 Heavy Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#FFFF00>Engine Power: </color>3500\n<color=#00FFFF>Speed: </color>8\nTraverse Speed: 0.6\n\n<color=#00FF00>Health: </color>1400\n<color=#FF0000>Armor: </color>100\n\n<color=#AA00FF>Thrust Power: </color>34\n<color=#ffc080>Fuel Amount: </color>750\nWeight: 1250\n\nHull Type: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_NAME": "Bigfoot Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BIGFOOT_DESCRIPTION": "Provides more <style=cIsUtility>air control</style>.\n\n\n<color=#FFFF00>Engine Power: </color>2000\n<color=#00FFFF>Speed: </color>13\nTraverse Speed: 1.4\n\n<color=#00FF00>Health: </color>600\n<color=#FF0000>Armor: </color>20\n\n<color=#AA00FF>Thrust Power: </color>40\n<color=#ffc080>Fuel Amount: </color>450\nWeight: 750\n\nHull Type: Car",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_NAME": "AMX50B Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_AMX50B_DESCRIPTION": "<style=cIsUtility>Speed is not affected by weight</style>.\n\n<color=#FFFF00>Engine Power: </color>700\n<color=#00FFFF>Speed: </color>9\nTraverse Speed: 0.7\n\n<color=#00FF00>Health: </color>900\n<color=#FF0000>Armor: </color>50\n\n<color=#AA00FF>Thrust Power: </color>35\n<color=#ffc080>Fuel Amount: </color>370\nWeight: 1100\n\nHull Type: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_NAME": "TOG II Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TOG_II_DESCRIPTION": "\n<color=#FFFF00>Engine Power: </color>3700\n<color=#00FFFF>Speed: </color>8\nTraverse Speed: 0.5\n\n<color=#00FF00>Health: </color>1150\n<color=#FF0000>Armor: </color>60\n\n<color=#AA00FF>Thrust Power: </color>34\n<color=#ffc080>Fuel Amount: </color>1000\nWeight: 1200\n\nHull Type: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_NAME": "Pigeon Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PIGEON_DESCRIPTION": "<color=#80fc80>Turret compatible</color>.\n\n<color=#FFFF00>Engine Power: </color>1500\n<color=#00FFFF>Speed: </color>7\nTraverse Speed: 1.4\n\n<color=#00FF00>Health: </color>150\n<color=#FF0000>Armor: </color>5\n\n<color=#AA00FF>Thrust Power: </color>40\n<color=#ffc080>Fuel Amount: </color>300\nWeight: 100\n\nHull Type: Car",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_NAME": "Pontera AC Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PONTERA_AC_DESCRIPTION": "<style=cIsUtility>Can climb walls</style>. Jump is delayed by a second, and <color=#fc8080>ram damage is reduced by 50%</color>.\n\n\n<color=#FFFF00>Engine Power: </color>2750\n<color=#00FFFF>Speed: </color>9\nTraverse Speed: 0.8\n\n<color=#00FF00>Health: </color>1300\n<color=#FF0000>Armor: </color>90\n\n<color=#AA00FF>Thrust Power: </color>31\n<color=#ffc080>Fuel Amount: </color>550\nWeight: 1300\n\nHull Type: Mech",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_NAME": "TANKDOZER Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TANKDOZER_DESCRIPTION": "Plow <style=cIsUtility>blocks</style> all <style=cIsDamage>incoming damage</style>.\n\nTank Destroyer Mode: <color=#fc8080>Cannot mount turret</color>.\n\n<color=#FFFF00>Engine Power: </color>2500\n<color=#00FFFF>Speed: </color>8.5\nTraverse Speed: 0.9\n\n<color=#00FF00>Health: </color>1250\n<color=#FF0000>Armor: </color>80\n\n<color=#AA00FF>Thrust Power: </color>34\n<color=#ffc080>Fuel Amount: </color>500\nWeight: 1200\n\nHull Type: Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_NAME": "Truck Kan Hull",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_TRUCK_KAN_DESCRIPTION": "Ram damage is increased by <color=#80fc80>100.0%</color>\n\n<color=#80fc80>Turret compatible</color>.\n<style=cIsUtility>Speed is not affected by weight</style>.\n\n<color=#FFFF00>Engine Power: </color>1000\n<color=#00FFFF>Speed: </color>12\nTraverse Speed: 0.9\n\n<color=#00FF00>Health: </color>450\n<color=#FF0000>Armor: </color>15\n\n<color=#AA00FF>Thrust Power: </color>40\n<color=#ffc080>Fuel Amount: </color>600\nWeight: 600\n\nHull Type: Car",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_NAME": "Rogue",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_ROGUE_DESCRIPTION": "\n<color=#00FF00>Health: </color>250\n<color=#FF0000>Armor: </color>25\n\nRotation Speed: 7.5\n\nWeight: 250\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_NAME": "Turret",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TURRET_DESCRIPTION": "\n<color=#00FF00>Health: </color>100\n<color=#FF0000>Armor: </color>10\n\nRotation Speed: 20\n\nWeight: 50\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_NAME": "TONK",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TONK_DESCRIPTION": "\n<color=#00FF00>Health: </color>100\n<color=#FF0000>Armor: </color>15\n\nRotation Speed: 15\n\nWeight: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_NAME": "Type 5 Heavy",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TYPE_5_HEAVY_DESCRIPTION": "\n<color=#00FF00>Health: </color>400\n<color=#FF0000>Armor: </color>50\n\nRotation Speed: 5\n\nWeight: 500\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_NAME": "Bigfoot",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_BIGFOOT_DESCRIPTION": "<style=cIsDamage>200% damage</style>?  I couldn't find the code where it increases damage for this specific turret.\n- Developer\n\n\n<color=#00FF00>Health: </color>150\n<color=#FF0000>Armor: </color>25\n\nRotation Speed: 13\nAngle Limit: 60\n\nWeight: 100\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_NAME": "AMX50B",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_AMX50B_DESCRIPTION": "Adds <style=cIsDamage>5 charges</style> to the <style=cIsUtility>secondary</style> skill.\n<style=cIsUtility>Replenishes all charges</style> after cooldown.\nCannon damage decreases by 80%\n\n<color=#00FF00>Health: </color>300\n<color=#FF0000>Armor: </color>20\n\nRotation Speed: 7\n\nWeight: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_NAME": "TOG II",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_TOG_II_DESCRIPTION": "\n<color=#00FF00>Health: </color>200\n<color=#FF0000>Armor: </color>30\n\nRotation Speed: 9\n\nWeight: 200\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_NAME": "Pontera AC",
    "CHEESEWITHHOLES_BASICTANK_XTRA_TURRET_PONTERA_AC_DESCRIPTION": "\n<color=#00FF00>Health: </color>300\n<color=#FF0000>Armor: </color>35\n\nRotation Speed: 7\n\nWeight: 350\n",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_NAME": "Heavy Weight",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PASSIVE_DESCRIPTION": "The tank can <style=cIsUtility>run enemies over</style>, with <style=cIsDamage>damage dependent on speed</style>.  Falling with a heavy configuration causes your weight to create a <style=cIsUtility>shockwave</style>, harming foes nearby.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_NAME": "None",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_PRIMARY_DESCRIPTION": "Removes this skill.  Increases the following stats:\n\nAttack Speed: <color=#80fc80>+0.5</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_NAME": "None",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SECONDARY_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_NAME": "None",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_UTILITY_DESCRIPTION": "Removes this skill.  Increases the following stats:\n\nSpeed: <color=#80fc80>+1</color> m/s\nThruster Power: <color=#80fc80>+10%</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_NAME": "None",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_EMPTY_SPECIAL_DESCRIPTION": "Removes this skill.  Increases armor by <color=#80fc80>30</color> and increases fuel capacity by <color=#80fc80>200</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_NAME": "Mini Cannon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_BOBSEMPLETURRET_DESCRIPTION": "Inaccurately fire for <style=cIsDamage>200% damage.</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_NAME": "EMP",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_EMP_DESCRIPTION": "Ignite your shield, and create an emp for <style=cIsDamage>2000% damage</style>, that electrocutes enemies!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_NAME": "Calliope",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_CALLIOPE_DESCRIPTION": "Hold a massive stock of up to 22 missiles! Each one dealing from <style=cIsDamage>1100% damage</style> up to <style=cIsDamage>1800% damage</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_NAME": "Rapid Auto Cannon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PRIMARY_AUTOCANNONTURRET_DESCRIPTION": "Shoot explosive shells at enemies for <style=cIsDamage>500% damage</style>. Must reload every 4 seconds.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_NAME": "Mighty Cannon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ROGUECANNON_DESCRIPTION": "Fire for <style=cIsDamage>7500% damage</style>, knocking foes.\n<style=cSub>[<style=cIsUtility>Cooldown: 16s</style> | <style=cIsDamage>Radius: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_NAME": "Artillery Cannon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_ARTCANNON_DESCRIPTION": "<style=cIsUtility>Hold to aim</style>, and release to fire a powerful shell for <style=cIsDamage>7000% damage</style>.  Damage increases the further it travels up to <style=cIsDamage>14000% damage</style>.\n<style=cSub>[<style=cIsUtility>Cooldown: 16s</style> | <style=cIsDamage>Radius: 12.5m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_NAME": "Cryo Cannon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_CRYOCANNON_DESCRIPTION": "Shoot a giant snowball for <color=#75EAFF>1500% damage</color> and freeze enemies.\n<style=cSub>[<style=cIsUtility>Cooldown: 5s</style> | <style=cIsDamage>Radius: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_NAME": "Duo Cannon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_DOUBLEBARREL_DESCRIPTION": "Fire for <style=cIsDamage>5400% damage</style>. Hold to fire 2 shells, which <color=#fc8080>increases skill cooldown</color> afterward. Firing a double <color=#80fc80>greatly decreases</color> the next charge time for 2 seconds.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_NAME": "British Cannon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_BRITCANNON_DESCRIPTION": "Fire for <style=cIsDamage>2400% damage</style>.  <color=#fc8080>Cannot proc items</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_NAME": "Big Bad Cannon",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_GIGACANNON_DESCRIPTION": "Fire for <style=cIsDamage>2000% damage</style>.  <style=cIsUtility>Hold to charge</style> and deal up to <style=cIsDamage>11000% damage</style>.  Max charge auto-fires the cannon for an additional <style=cIsDamage>5500% laser damage</style> with <style=cIsUtility>additional knockback</style>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_NAME": "Oppenheimer's Experimental",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SECONDARY_OPPENSNUKE_DESCRIPTION": "Let your shell destroy your shield, and annihilate for <color=#ff4d76>9000% crit damage</color>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_NAME": "Jets",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_JETS_DESCRIPTION": "Ignite and conume <color=#ffc080>70 fuel</color> per second, allowing the tank to gain more and more speed over time.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_NAME": "Power Cycle",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_POWERCYCLE_DESCRIPTION": "Activate to swap between 3 modes- Evade, Offense, or Defense: \n\n<style=cIsUtility>Evade</style>: Reduce attack speed by 50% and increase cooldown by 50% for a extra 50% speed, 10% thrust power, and 50% engine power!\n\n<color=#80fc80>Defense</color>: Sacrifice 70% speed and 100% thrust power for 500 armor.\n\n<style=cIsDamage>Offense</style>: All weapons deal double damage. Decrease cooldowns by 33% and increase attack speed by 33%, but lose ALL armor and healing. Activating this mode shocks your tank for 2 seconds.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_NAME": "Overclock",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UTILITY_OVERCLOCK_DESCRIPTION": "Let your velocity destroy your shield, and violently erupt your thrusters for <style=cIsDamage>6000% damage</style> sending yourself in the air, <style=cIsUtility>preventing fall damage</style>!",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_NAME": "Shields",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_SHEILDS_DESCRIPTION": "Activate to become <style=cIsUtility>immune to outside damage</style> for 4 seconds.  Can be sacrificed for a one-time <color=#03fcc2>Power Ability</color>.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_NAME": "Blasticular",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SPECIAL_BLAST_DESCRIPTION": "Fire 4 cannons, each dealing <style=cIsDamage>1400% damage</style> in a huge radius. Weapons <color=#fc8080>overheat</color> instead of reloading.\n<style=cSub>[<style=cIsDamage>Radius: 10m</style>]</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_NAME": "Standard",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_STANDARD_DESCRIPTION": "Vanilla experience.\n\nThe tank moves and turns based on your chosen direction of travel.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_NAME": "Alternative",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ENGINE_ALT_DESCRIPTION": "Changes the way this tank is played.\n\nThe tank moves base on hull direction, but <color=#fc8080>will not turn in the direction of travel</color>.  This is handled by <style=cIsUtility>turning manually</style>.\n\nWhile flying, controls revert to Standard.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_NAME": "Power Mode: <style=cIsUtility>Evade</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_MOBILITY_DESCRIPTION": "Reduce attack speed by 50% and increase cooldown by 50% for a extra 50% speed, 10% thrust power, and 50% engine power.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_NAME": "Power Mode: <color=#80fc80>Defense</color>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_DEFENSE_DESCRIPTION": "Sacrifice 70% speed and 100% thrust power for 500 armor.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_NAME": "Power Mode: <style=cIsDamage>Offense</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_PC_OFFENSE_DESCRIPTION": "All weapons deal double damage. Decrease cooldowns by 33% and increase attack speed by 33%, but lose ALL armor and healing. Activating this mode shocks your tank for 2 seconds.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_OUTRO_FLAVOR": "And to think Dedee was finally freed, \r\nit was yet again captured by the UES.",
