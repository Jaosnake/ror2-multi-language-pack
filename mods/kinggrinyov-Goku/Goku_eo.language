        "KINGMOD_UNTIL_NEXT_UNLOCK": " Majstraj niveloj gxis la sekva malxsxloso",
        "KINGMOD_COSTS_KI_FORMAT": "Kostas <color=#03bcff>{0} Ki</color>",
        "KINGMOD_DAMAGE_FORMAT": "<color=#E5C962>{0}% da damagxo</color>",
        "KINGMOD_STAT_NAME_DAMAGE": "Damagxo",
