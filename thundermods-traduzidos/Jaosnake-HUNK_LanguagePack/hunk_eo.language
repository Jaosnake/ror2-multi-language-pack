    "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "Bataltrancxilo",
    "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>Rabo.</style> <style=cIsDamage>Trancxu</style> proksimajn batalantojn por <style=cIsDamage>200% da damagxo</style>, kauxzante <style=cIsHealth>Mutilita</style>.",
    "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC (Proksima Batalo)",
    "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>Rabo.</style> <style=cIsDamage>Piedbatu dufoje</style> por <style=cIsDamage>200% kaj 250% da damagxo</style>. Se la <style=cIsUtility>dua piedbato</style> trafas, sekvu per <style=cIsDamage>Kontrauxatako</style>.",
