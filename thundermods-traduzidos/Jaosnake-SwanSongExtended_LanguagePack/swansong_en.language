    "PLAYER_DEATH_QUOTE_SWANSONG_7": "{0} blames it on the weather.",
    "PLAYER_DEATH_QUOTE_SWANSONG_7_2P": "Must've been the wind.",
    "PLAYER_DEATH_QUOTE_SWANSONG_8": "{0} had embarrassing last words.",
    "PLAYER_DEATH_QUOTE_SWANSONG_8_2P": "Counting, or not counting Elite violence?",
    "PLAYER_DEATH_QUOTE_SWANSONG_9": "{0} was a flop.",
