    "ROB_HUNK_WEAPON_ADDON_MUP_NAME": "Anschlagschaft (MUP)",
    "ROB_HUNK_WEAPON_ADDON_MUP_DESC": "Ein Spezialteil für die MUP, mit dem die Waffe pro Abzugsbetätigung 3 Schuss abfeuert.",
    "ROB_HUNK_WEAPON_ADDON2_MUP_NAME": "Leuchtpunktvisier (MUP)",
    "ROB_HUNK_WEAPON_ADDON2_MUP_DESC": "Ein Spezialteil für die MUP. Fügt ein Visier hinzu, das ihre Wirksamkeit auf große Entfernung und bei Schwachstellentreffern erhöht.",
    "ROB_HUNK_WEAPON_ADDON3_MUP_NAME": "Großmagazin (MUP)",
    "ROB_HUNK_WEAPON_ADDON3_MUP_DESC": "Ein Spezialteil für die MUP, das die Magazinkapazität auf 33 Schuss erweitert und die Nachladezeit verkürzt.",
    "ROB_HUNK_WEAPON_ADDON4_MUP_NAME": "Mündungsbremse (MUP)",
    "ROB_HUNK_WEAPON_ADDON4_MUP_DESC": "Ein Spezialteil für die MUP, das ihren Schaden auf 600% erhöht.",
    "ROB_HUNK_WEAPON_SG09_NAME": "SG-09 R",
    "ROB_HUNK_WEAPON_SG09_DESC": "Eine leicht handhabbare Pistole mit hoher Munitionskapazität.",
    "ROB_HUNK_WEAPON_ADDON_SG09_NAME": "Großmagazin (SG-09 R)",
    "ROB_HUNK_WEAPON_ADDON_SG09_DESC": "Ein Spezialteil für die SG-09 R, das die Magazinkapazität auf 32 Schuss erweitert.",
    "ROB_HUNK_WEAPON_ADDON2_SG09_NAME": "Mündungsbremse (SG-09 R)",
    "ROB_HUNK_WEAPON_ADDON2_SG09_DESC": "Ein Spezialteil für die SG-09 R, das ihren Schaden auf 900% erhöht.",
