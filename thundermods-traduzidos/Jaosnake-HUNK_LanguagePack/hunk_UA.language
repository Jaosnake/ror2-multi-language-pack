        "ROB_HUNK_WEAPON_ADDON2_SG09_NAME": "Дульне гальмо (SG-09 R)",
        "ROB_HUNK_WEAPON_ADDON2_SG09_DESC": "Спеціальний модуль для SG-09 R, що підвищує його шкоду до 900%.",
        "ROB_HUNK_WEAPON_ADDON3_SG09_NAME": "Лазерний приціл (SG-09 R)",
