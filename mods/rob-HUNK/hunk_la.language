    "ROB_SAMPLECOST": "Specimen Viri",
    "ROB_HUNK_CHEST_NAME": "Capsa Armorum: ",
    "ROB_HUNK_CHEST_CONTEXT": "Aperi capsam armorum",
    "ROB_HUNK_CASE_INSPECT_NAME": "Capsa Armorum",
    "ROB_HUNK_CASE_INSPECT_DESC": "Capsa novum armum pro HUNK continens. Tesseram specificam ad aperiendum requirit.",
    "ROB_HUNK_SPECIALCASE_INSPECT_NAME": "Capsa Armorum Specialis",
    "ROB_HUNK_SPECIALCASE_INSPECT_DESC": "Capsa specialis potens novum armum pro HUNK continens. Certum gradum permissionis securitatis ad aperiendum requirit.",
    "ROB_HUNK_STARSBOX_INSPECT_NAME": "Arca S.T.A.R.S.",
    "ROB_HUNK_STARSBOX_INSPECT_DESC": "Arca specialis apparatum potentem pro sociis S.T.A.R.S. continens. Insigne ad aperiendum requirit.",
    "ROB_HUNK_WEAPONBOX_INSPECT_NAME": "Capsa Commeatus",
    "ROB_HUNK_WEAPONBOX_INSPECT_DESC": "Capsa armorum cum rebus utilibus intus.",
    "ROB_HUNK_LOOTBOX_INSPECT_NAME": "Capsa Commeatus",
    "ROB_HUNK_LOOTBOX_INSPECT_DESC": "Capsa signo Umbrella notata cum rebus utilibus intus.",
    "ROB_HUNK_TERMINAL_INSPECT_NAME": "Terminale Umbrella",
    "ROB_HUNK_TERMINAL_INSPECT_DESC": "Adhibetur ad specimina viri ad Umbrella Corporation mittenda. Specimina tradita convenienter remunerantur.",
    "ROB_HUNK_AMMO_NAME": "Munitio",
    "ROB_HUNK_AMMO_CONTEXT": "Munitionem tolle",
    "ROB_HUNK_GRENADE_NAME": "Granata",
    "ROB_HUNK_GRENADE_CONTEXT": "Granatam tolle",
    "ROB_HUNK_BADGE_NAME": "Cadaver",
    "ROB_HUNK_BADGE_CONTEXT": "Cadaver inspice",
    "ROB_HUNK_BADGE_CONTEXT2": "Insigne tollere?",
    "ROB_HUNK_C4_NAME": "C4",
    "ROB_HUNK_C4_CONTEXT": "Detonatorem activa",
    "ROB_HUNK_KEYWORD_LOOTING": "<style=cKeywordName>Praedatio</style><style=cSub>Hostes hac arte necati parvam fortunam habent munitionem demittendi.</style>",
    "ROB_HUNK_KEYWORD_MANGLED": "<style=cKeywordName>Laceratus</style><style=cSub>Cum 6 cumulos huius debilitatis attingunt, hostes statim <style=cIsDamage>2200% damni</style> patiuntur.</style>",
    "ROB_HUNK_KEYWORD_PERFECTDODGE": "<style=cKeywordName>Evitatio Perfecta</style><style=cSub><style=cIsUtility>Moram reddit</style> et te breviter invulnerabilem facit. Tibi permittit <style=cIsDamage>Contraimpetum</style> facere.</style>",
    "ROB_HUNK_KEYWORD_PERFECTPARRY": "<style=cKeywordName>Defensio Perfecta</style><style=cSub><style=cIsDamage>800% damni</style> infert et te breviter invulnerabilem facit. Tibi permittit <style=cIsDamage>Contraimpetum</style> facere.</style>",
    "ROB_HUNK_KEYWORD_PERFECTBASH": "<style=cKeywordName>Ictus Perfectus</style><style=cSub><style=cIsUtility>Moram reddit</style> et te breviter invulnerabilem facit. Tibi permittit <style=cIsDamage>Contraimpetum</style> facere.</style>",
    "ROB_HUNK_KEYWORD_COUNTER": "<style=cKeywordName>Contraimpetus</style><style=cSub><style=cIsDamage>Primariam</style> premendo prorumpis et letalem <style=cIsDamage>contraimpetum</style> in hostem propinquum facis.</style>",
    "ROB_HUNK_KEYWORD_VIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Semel in quoque gradu, monstrum fortuitum <color=#C678B4>Infectum</color> fit. Mutatur, <style=cIsHealth>tempore fortius crescens</style>, et id necando <color=#FFFF00>Specimen G-Virus</color> demittit.</style>\n\n<style=cKeywordName>T-Virus</style><style=cSub>Semel in quoque gradu, plura monstra <color=#0066FF>Infecta</color> fiunt. Hoc ea bis <style=cIsHealth>revivificat</style>, et omnia necando <color=#FFFF00>Specimen T-Virus</color> consequeris.</style>\n\n<style=cKeywordName>C-Virus</style><style=cSub>Semel in quoque gradu, plura monstra <color=#FF0033>Infecta</color> fiunt. In morte haec monstra in <style=cIsDamage>furorem</style> per <style=cIsUtility>5</style> secunda aguntur et deinde <style=cIsHealth>explodunt</style>, et omnia necando <color=#FFFF00>Specimen C-Virus</color> consequeris.</style>",
    "ROB_HUNK_KEYWORD_GVIRUS": "<style=cKeywordName>G-Virus</style><style=cSub>Semel in quoque gradu, monstrum fortuitum <color=#C678B4>Infectum</color> fit. Mutatur, <style=cIsHealth>tempore fortius crescens</style>, et id necando <color=#FFFF00>Specimen G-Virus</color> demittit.</style>",
    "ROB_HUNK_KEYWORD_TVIRUS": "<style=cKeywordName>T-Virus</style><style=cSub>Semel in quoque gradu, plura monstra <color=#0066FF>Infecta</color> fiunt. Hoc ea bis <style=cIsHealth>revivificat</style>, et omnia necando <color=#FFFF00>Specimen T-Virus</color> consequeris.</style>",
    "ROB_HUNK_KEYWORD_CVIRUS": "<style=cKeywordName>C-Virus</style><style=cSub>Semel in quoque gradu, plura monstra <color=#FF0033>Infecta</color> fiunt. In morte haec monstra in <style=cIsDamage>furorem</style> per <style=cIsUtility>5</style> secunda aguntur et deinde <style=cIsHealth>explodunt</style>, et omnia necando <color=#FFFF00>Specimen C-Virus</color> consequeris.</style>",
