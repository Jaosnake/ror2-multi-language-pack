    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_NAME": "Churchill",
    "CHEESEWITHHOLES_BASICTANK_TURRET_CHURCHILL_DESCRIPTION": "<color=#fcdf03>+3 Münzen</color> alle <style=cIsUtility>5</style> Sekunden <color=#7a7a7a>(+2 pro Stufe)</color>\n\n<color=#00FF00>Gesundheit: </color>85\n<color=#FF0000>Rüstung: </color>12\n\nRotationsgeschwindigkeit: 34\n\nGewicht: 97\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_NAME": "Maus",
    "CHEESEWITHHOLES_BASICTANK_TURRET_MAUS_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>150\n<color=#FF0000>Rüstung: </color>30\n\nRotationsgeschwindigkeit: 30\n\nGewicht: 180\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_NAME": "Tetrarch",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TETRARCH_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>20\n<color=#FF0000>Rüstung: </color>7\n\nRotationsgeschwindigkeit: 50\n\nGewicht: 27\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_NAME": "APC",
    "CHEESEWITHHOLES_BASICTANK_TURRET_APC_DESCRIPTION": " <color=#80fc80>+10% Angriffsgeschwindigkeit</color>\n <color=#fc8080>-15% Gesundheitsregeneration</color>\n <color=#fc8080>+5% Gesamtabklingzeit</color>\n\n<color=#00FF00>Gesundheit: </color>20\n<color=#FF0000>Rüstung: </color>2\n\nRotationsgeschwindigkeit: 40\n\nGewicht: 20\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>10\n<color=#FF0000>Rüstung: </color>0\n\nRotationsgeschwindigkeit: 55\n\nGewicht: 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>100\n<color=#FF0000>Rüstung: </color>20\n\nRotationsgeschwindigkeit: 33\n\nGewicht: 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% Spezial-Abklingzeit</color>\n <color=#fc8080>+15% Sekundär-Abklingzeit</color>\n <color=#fc8080>-10% Angriffsgeschwindigkeit</color>\n\n<color=#00FF00>Gesundheit: </color>120\n<color=#FF0000>Rüstung: </color>23\n\nRotationsgeschwindigkeit: 29\n\nGewicht: 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% Schaden</color>\n <color=#fc8080>+10% Gesamtabklingzeit</color>\n\n<color=#00FF00>Gesundheit: </color>160\n<color=#FF0000>Rüstung: </color>0\n\nRotationsgeschwindigkeit: 25\nWinkellimit: 90\n\nGewicht: 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>45\n<color=#FF0000>Rüstung: </color>4\n\nRotationsgeschwindigkeit: 25\n\nGewicht: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Gesundheit: </color>35\n<color=#FF0000>Rüstung: </color>15\n\nRotationsgeschwindigkeit: 35\n\nGewicht: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% Primär-Abklingzeit</color>\n <color=#fc8080>+8% Sekundär-Abklingzeit</color>\n <color=#fc8080>+8% Hilfsfertigkeit-Abklingzeit</color>\n <color=#fc8080>+8% Spezial-Abklingzeit</color>\n <color=#fc8080>-15% Angriffsgeschwindigkeit</color>\n\n<color=#00FF00>Gesundheit: </color>35\n<color=#FF0000>Rüstung: </color>3\n\nRotationsgeschwindigkeit: 30\n\nGewicht: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% Schaden</color>\n\n<color=#00FF00>Gesundheit: </color>5\n<color=#FF0000>Rüstung: </color>1\n\nRotationsgeschwindigkeit: 40\nWinkellimit: 30\n\nGewicht: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "ORIGINAL",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "ROT",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "HELLROT",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "GRÜN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "DUNKELGRÜN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "BLAU",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "CYAN",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "ROSA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "KNALLROSA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "MAGENTA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "GELB",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "NEONGELB",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "NEONLILA",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "ORANGE",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "WEISS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "SCHWARZ",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Ändert den leuchtenden Teil des Fahrzeugs in eine andere Farbe.  Hat keinen Einfluss auf das Gameplay.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Schmutzig",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Sauber",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Zacken_Tarnung",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Pixel_Tarnung",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Papier_Tarnung",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Riffelblech",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Verschraubte_Platte",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Prozedurales_Muster",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Bunte_Mischung",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Regenbogenverlauf",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Monochrom",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Flüssige_Galaxie",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Weltraum",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Motorsysteme",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Hilfsfertigkeiten und Schub verbrauchen Treibstoff. Die Treibstoffauffüllung wird durch <style=cIsUtility>Angriffsgeschwindigkeit</style> beeinflusst; die Treibstoffkapazität wird durch <style=cIsUtility>Nachbrenner</style> und <style=cIsUtility>sprungbasierte Gegenstände</style> beeinflusst. Der Panzer kann <style=cIsUtility>in jede Richtung sprinten</style>. Schub ermöglicht vielseitige Kontrolle in der Luft. Allerdings <color=#fc8080>kann der Panzer normalerweise nicht springen</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Super-Waffenkammer",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "Die Wahl von Wanne und Turm beeinflusst Gesundheit, Rüstung, Geschwindigkeit, Schub und Masse. <style=cIsUtility>Höhere Masse hilft beim Wegschieben schwerer Gegner</style>; andernfalls bist du anfälliger für <color=#ffff80>Rückstoß</color>.\n\nRüstung oder Geschwindigkeit helfen, die <color=#fc8080>miserable Gesundheitsregeneration</color> des Panzers auszugleichen.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Himmlische Instabilität",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "Der Panzer kann sich in der Luft nicht selbst ausbalancieren und <color=#ffff80>verliert leicht die Kontrolle</color>. Landest du auf dem Kopf, bist du <color=#fc8080>kurze Zeit bewegungsunfähig und verwundbar</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Flugtriebwerke",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Halte <style=cIsUtility>Springen</style> gedrückt, um zu fliegen. Die Flugrichtung hängt vom Winkel deines Panzers ab. <style=cIsUtility>Vielseitigster Flugmodus</style>, aber möglicherweise schwer zu beherrschen.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Impulstriebwerke",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Ermöglicht dem Panzer, wie andere Überlebende normal zu <style=cIsUtility>springen</style>. Panzerneigung kann beim 2. Sprung aktiviert werden. Jeder Sprung verbraucht <color=#ffc080>25</color> Treibstoff.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Schwebetriebwerke",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Ermöglicht dem Panzer, über dem Boden zu schweben. Halte <style=cIsUtility>Springen</style> zum Aufsteigen; halte <style=cIsUtility>Links-Alt</style> zum Absteigen. Aufsteigen verbraucht mehr Treibstoff.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Maschinengewehre",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Feuere kontinuierlich für <style=cIsDamage>2x40% Schaden</style>.\n<style=cSub>[Gewicht: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Schrotflinte",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Feuere für <style=cIsDamage>12x75% Schaden</style>.  <color=#ffc080>Verbrenne Treibstoff</color>, um <style=cIsUtility>zusätzliche Ladungen zu erhalten</style>; <color=#80fc80>lande ein Kunststück</color>, um vorübergehend einen Kraftschuss für <style=cIsDamage>18x150% Schaden</style> zu erhalten.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 1s</style> | Gewicht: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Granatwerfer",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Feuere ungenaue Granaten für <style=cIsDamage>4x250% Schaden</style> ab.  Die Granaten sind explosiv und schwer.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 4s</style> | <style=cIsDamage>Explosionsradius: 5m</style> | Gewicht: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Raketenwerfer",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Feuere präzise Raketen für <style=cIsDamage>1000% Schaden</style> ab. <style=cIsDamage>Der Schaden steigt mit der Flugdistanz</style>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 3s</style> | <style=cIsDamage>Explosionsradius: 8m</style> | Gewicht: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Flammenwerfer",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Speie Feuer für <color=#E85E31>25% Verbrennungsschaden</color> für je <color=#ffc080>15 Treibstoff pro Sekunde</color>.  Schaden steigt mit Stapeln; <style=cIsUtility>Angriffsgeschwindigkeit erhöht die Reichweite</style>.\n<style=cSub>[<color=#ffc080>Treibstoffbetrieben</color> | Gewicht: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ultraantenne",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Setze dich selbst unter Strom</color> und <style=cIsUtility>aktiviere Tod-Effekt-Gegenstände</style>.  <style=cIsUtility>Das Berühren von Gegnern setzt diese ebenfalls unter Strom</style> und fügt ihnen <style=cIsDamage>250% Schaden</style> pro <style=cIsUtility>Tod-Effekt</style>-Gegenstand zu.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 7s</style> | <style=cIsDamage>Explosionsradius: 5m</style> | Gewicht: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Kritische Kanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Feuere für <color=#ff4d76>1200% kritischen Schaden</color>. Kritische Trefferchance erhöht den Schaden der Kanone.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 7s</style> | <style=cIsDamage>Explosionsradius: 10m</style> | Gewicht: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Haubitzenkanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Aufladen, um für gewaltige <style=cIsDamage>7000% Flächenschaden</style> zu feuern. <style=cIsUtility>Kann den Panzer in der Luft wegschleudern.</style>\n<style=cSub>[<style=cIsUtility>Abklingzeit: 16s</style> | <style=cIsDamage>Explosionsradius: 15m</style> | Gewicht: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Klopfer-Kanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Feuere ungenau für <style=cIsDamage>1700% Schaden</style>. <style=cIsDamage>Der Schaden nimmt mit der Flugdistanz ab</style>; <style=cIsDamage>Proc-Gegenstände erhöhen stattdessen den Schaden</style>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 3s</style> | <style=cIsDamage>Explosionsradius: 5m</style> | Gewicht: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Durchschlagskanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Feuere für <style=cIsDamage>2500% Schaden</style>.  Halten zum Kalibrieren für <style=cIsDamage>3500% Schaden</style> und die Fähigkeit, <style=cIsUtility>Schwachstellen zu treffen</style>.  Wenn kalibriert, <color=#fc8080>verschlechtert Bewegung die Präzision</color>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 5s</style> | <style=cIsDamage>Explosionsradius: 2m</style> | Gewicht: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Französisches Geschütz",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Feuere für mickrige <style=cIsDamage>550% Schaden</style>. Hat aus irgendeinem Grund <style=cIsUtility>viel zu viel Proc-Chance</style>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 1s</style> | Gewicht: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Minigun",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Feuere Salven für <style=cIsDamage>50% Schaden</style>. Ab 75% Überhitzung wird <color=#E85E31>Verbrennung</color> zugefügt; <color=#fc8080>Überhitzung blockiert das Geschütz</color>. <style=cIsUtility>Abklingzeit-Gegenstände beschleunigen das Abkühlen</style>; <style=cIsUtility>Ersatzmagazine verhindern Überhitzung</style>.\n<style=cSub>[Gewicht: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Standardkanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Feuere ein schnelles Geschoss für <style=cIsDamage>5400% Schaden</style> ab.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 12s</style> | <style=cIsDamage>Explosionsradius: 7m</style> | Gewicht: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Flakkanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Feuere für <style=cIsDamage>300% Schaden</style>.  Das Projektil detoniert nahe Luftzielen und verursacht <style=cIsDamage>2.5x Schaden</style>.  <color=#fc8080>Der Panzer wird beim Feuern langsamer</color>.\n<style=cSub>[<style=cIsDamage>Explosionsradius: 5.5m</style> | Gewicht: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Splitterkanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Feuere für <style=cIsDamage>2200% Schaden</style> in einem <style=cIsUtility>großen Bogen</style>, der beim Aufprall <style=cIsDamage>10x5% Gesamtschaden</style> verteilt.  Der Schaden steigt mit der Flugdistanz auf bis zu <style=cIsDamage>5500% Schaden</style>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 10s</style> | <style=cIsDamage>Explosionsradius: 16m</style> | Gewicht: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Himmlische Kanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Verbrauche <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> Treibstoff für <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>Schaden</color>.  Aufgeladene Laser durchschlagen Ziele; <color=#fc8080>Unzureichender Treibstoff legt die Waffe lahm.</color>\n<style=cSub>[<color=#ffc080>Treibstoffbetrieben</color> | Gewicht: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Auslöscher-Kanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Lade auf, um automatisch ein <color=#E85E31>Tod-Effekt-auslösendes Geschoss</color> für <style=cIsDamage>12000% Schaden</style> abzufeuern.  Danach <color=#fc8080>sind Fähigkeiten für 4 Sekunden deaktiviert.  Das Geschoss kann Verbündete verletzen</color>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 21s</style> | <style=cIsDamage>Explosionsradius: 5m</style> | Gewicht: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Maschinenkanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Feuere bis zu 4 Geschosse ab, die jeweils <style=cIsDamage>2000% Schaden</style> verursachen. Das letzte Geschoss verursacht <style=cIsDamage>2x Schaden</style> an einem festen Punkt.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 14s</style> | <style=cIsDamage>Explosionsradius: 7m</style> | Gewicht: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Pflug",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Stürme eine kurze Strecke vor</style> für <color=#ffc080>50</color> Treibstoff. Kann <style=cIsUtility>jeden Gegner</style> für <style=cIsDamage>1000% Schaden</style> zurückstoßen und <color=#ffc080>40</color> Treibstoff wiederherstellen.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 2s</style> | Gewicht: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Stacheln",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Stürme eine große Strecke vor</style> für <color=#ffc080>50</color> Treibstoff. Ramme Gegner für <color=#AA2B2A>550% Blutungsschaden</color>.  <style=cIsUtility>Hat keine Abklingzeit</style>.\n<style=cSub>[Gewicht: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Turbo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Rase davon</style> und verbrauche <color=#ffc080>30</color> Treibstoff pro Sekunde.  Kann für <style=cIsDamage>250% Schaden</style> rammen. Rammen stellt <color=#ffc080>20</color> Treibstoff wieder her.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 1s</style> | Gewicht: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Supersprung",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Katapultiere dich für <color=#ffc080>50</color> Treibstoff nach oben.  Beim Sprinten katapultierst du dich stattdessen für <color=#ffc080>75</color> Treibstoff nach vorne und schleuderst deinen Panzer für <style=cIsDamage>2500% Schaden</style> herum.  Das Gewicht des Panzers erhöht den Schaden.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Planierraupe",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Beschleunige</style> und verbrauche <color=#ffc080>20</color> Treibstoff pro Sekunde.  Kann <style=cIsUtility>jeden Gegner</style> für konstante <style=cIsDamage>200% Schaden</style> umpflügen.  Verursacht <style=cIsDamage>350% Schaden</style> beim Aufprall.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 1s</style> | Gewicht: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Reißdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Lade auf, um für <color=#ffc080>100</color> Treibstoff <style=cIsUtility>die weiteste Strecke vorzustürmen</style>.  <style=cIsUtility>Durchbohre Gegnergruppen</style> für <color=#AA2B2A>4000% Blutungsschaden</color> und <style=cIsUtility>verlängere den Ansturm</style>; Wende, um den Ansturm zu beenden; <color=#80fc80>lande ein Kunststück</color>, um <style=cIsUtility>das Aufladen zu überspringen</style>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 7s</style> | Gewicht: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Grabenfräse",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Halten zum Eingraben</style>, verbraucht <color=#ffc080>20</color> Treibstoff pro Sekunde und <style=cIsUtility>schützt deinen Panzer unter der Erde</style>.  Loslassen, um hervorzubrechen und nahen Gegnern <style=cIsDamage>900% Schaden</style> zuzufügen.  Kann unter der Erde nicht angreifen.\n<style=cSub>[<style=cIsDamage>Explosionsradius: 10m</style> | Gewicht: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Königsmine",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Lege eine Landmine ab, die <style=cIsDamage>3000% Schaden</style> verursacht.  <style=cIsDamage>Proc-Gegenstände erhöhen stattdessen den Schaden</style>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 10s</style> | <style=cIsDamage>Explosionsradius: 10m</style> | Gewicht: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Mini-Minen",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Ziele und wirf alle Miniatur-Landminen ab, die jeweils <style=cIsDamage>750% Schaden</style> verursachen.  Ladungs- und Interaktionsgegenstände erhöhen das Minenmaximum.  <color=#ffc080>Verbrenne Treibstoff</color>, um <style=cIsUtility>zusätzliche Ladungen zu erhalten</style>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 3s</style> | <style=cIsDamage>Explosionsradius: 10m</style> | Gewicht: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Fasswurf",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Schleudere für <color=#ffc080>25</color> Treibstoff ein Fass, das beim Aufprall für <style=cIsDamage>6500% Schaden</style> explodiert und eine <color=#E85E31>brennende Pfütze</color> hinterlässt.  <color=#80fc80>Ein gelandetes Kunststück</color> macht diese Fähigkeit vorübergehend <color=#fc8080>instabil</color>, wodurch <style=cIsUtility>dein Panzer wild herumgeschleudert wird</style>.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 14s</style> | <style=cIsDamage>Explosionsradius: 18m</style> | <style=cIsDamage>Zonenradius: 8</style> | Gewicht: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Selbstzerstörung",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Vernichte <color=#d40000>ALLES</color> im Umkreis von 35m für <style=cIsDamage>100000% Schaden</style>.  Beginne jeden neuen Durchlauf mit <color=#80fc80>Dio's Best Friend</color>.\n<style=cSub>[<style=cIsDamage>Explosionsradius: 35m</style> | Gewicht: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "HERRSCHAFT",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Werde langsamer und lade auf, um ein Sperrfeuer aus Raketen abzufeuern.  Der Schaden steigt mit der Flugdistanz auf bis zu <style=cIsDamage>12x3000% Schaden.</style>\n<style=cSub>[<style=cIsUtility>Abklingzeit: 30s</style> | <style=cIsDamage>Explosionsradius: 10m</style> | Gewicht: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Ausweichen",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Stoße Rauch aus, betäube nahe Gegner für <style=cIsDamage>150% Schaden</style> und tarne dich.  <style=cIsUtility>Werde für 1 Sekunde immun</style> gegen Schaden.\n<style=cSub>[<style=cIsUtility>Abklingzeit: 12s</style> | <style=cIsDamage>Explosionsradius: 10m</style> | Gewicht: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Passiv: Berserker",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Entfernt diese Fertigkeit. Erhöht die <style=cIsDamage>Grund-Angriffsgeschwindigkeit um 0.5</style> und verringert die <style=cIsUtility>Abklingzeit um 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Passiv: Motoren",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Entfernt diese Fertigkeit. Erhöht die <style=cIsUtility>Grundgeschwindigkeit um 1m/s</style> und die <style=cIsUtility>Schubkraft um 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Passiv: Rüstung",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Entfernt diese Fertigkeit. Erhöht die <style=cIsUtility>Grundrüstung um 30</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Meisterschaft",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Schließe als Celestial War Tank das Spiel ab oder lösche dich auf Monsoon aus.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Meisterschaft",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Himmlische Kanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Kehre als Celestial War Tank nach Hause zurück",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Himmlische Kanone",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Auslöscher",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Verursache als Celestial War Tank über 1.000.000 Schaden mit einem einzigen Schuss.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Auslöscher",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Reißdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Schließe als Celestial War Tank das Spiel ab oder lösche dich auf Monsoon aus.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Reißdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Gepanzert",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Erreiche als Celestial War Tank 10000 LP.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Gepanzert",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "Der ultimative Panzer der Zerstörung. Widerstehe Gegnern aller Art, überrolle und zermalme sie mit deinem gewaltigen Gewicht und deinen Waffen!\n\n<style=cSub>< ! > Der Panzer ist riesig und extrem langsam, wodurch du anfällig für jede Art von Schaden bist. Eine extrem defensive oder aggressive Spielweise hilft, den erlittenen Schaden zu verringern. Bedenke, dass der Panzer keine Heilung besitzt.\n\n< ! > Das Gehäuse des Panzers kann als Waffe genutzt werden – überfahre deine Gegner oder nutze dein Gewicht, um sie alle plattzudrücken!\n\n< ! > Wenn der Panzer umkippt, braucht er durch sein hohes Gewicht eine Weile, um wieder aufzukommen, und erleidet mehr Fallschaden. Der Panzer kann keine Kunststücke ausführen.\n\n< ! > Heilungseffekte sind abgeschwächt – der Panzer hat zu viel Gesundheit!\n\n< ! > Drücke 'T' zum Hupen.  In den Mod-Einstellungen konfigurierbar.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Fremdartiges Wesen",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Nach weiteren Untersuchungen haben wir den Ursprung dieser Panzer herausgefunden – die Hände der Plünderer. Gefertigt aus hochwertigen Schrottteilen und Gegenständen der UES, ist es ihnen gelungen, diese Kriegspanzer zu erschaffen.\n\nDies führt jedoch zu gefährlichen Schlussfolgerungen. Nachdem wir eine der feindlichen Antennen erbeutet hatten, haben wir diesen Koloss von einem Panzer aufgeschreckt. Er hat die Größe von Käferwachen!\n\nNach einem langen, harten Kampf haben wir ihn natürlich endlich niedergerungen. Wir hoffen, ihn weiter erforschen und sein Bewusstsein umprogrammieren zu können, um bessere Antworten zu erhalten. Das wird allerdings eine schwierige Aufgabe, denn es IST außerirdische Technologie.\n\nEin gewaltiges Detail ist jedoch, dass er bei seiner Niederlage ein Notfallportal beschworen hat. Das größte und heftigste Portal, das wir je gesehen haben. So sehr es uns auch direkt zu Antworten führen mag, glaube ich nicht, dass das ein Spaziergang im Park wird. Ein gewöhnlicher Panzer ist schon tödlich genug, und ich will gar nicht wissen, welche anderen Erfindungen der Plünderer da draußen noch lauern.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "ORIGINAL",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "WEISS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "SCHWARZ",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "ROT",
