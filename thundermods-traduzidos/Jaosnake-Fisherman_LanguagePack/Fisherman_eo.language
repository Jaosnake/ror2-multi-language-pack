{
  "eo": {
    "WUNT_FISHERMAN_NAME": "Fisherman",
    "WUNT_FISHERMAN_SUBTITLE": "Malsaneta Brakisto",
    "WUNT_FISHERMAN_DESCRIPTION": "Fisherman estas util-fokusita postvivanto, kiu devigas malamikojn batali laux liaj reguloj.<color=#CCD3E0>\n\n< ! > Senostigo povas esti uzata por kapti malamikojn el la aero kaj forjxeti atakantojn el ilia pozicio\n\n< ! > Eljxeto povas esti uzata por kapti forajn malamikojn, kestojn, dronojn kaj cxiajn ajxojn por rapide liberigi stadiojn\n\n< ! > La platformo F153 Mobila Kabana Platformo eble ne helpas vin eviti atakojn, sed povas helpi vin trapasi grandajn abismojn kaj krutajn klifojn\n\n< ! > Man o' War povas esti uzata por kunigi tedajn flugantojn aux forjxeti malamikojn de la scenejo.\n\n< ! > Trankviligi la Nervojn estas bona por kombini malamikojn kaj resti vivanta.</color>",
    "WUNT_FISHERMAN_LORE": "Taglibroj de la Karceraro de UES Safe Travels\r\n \r\nOkazinta Raporto\r\n \r\nAkuzito farigxis batalema post matenmangxo; konfirmitaj raportoj indikas ke li jxetis sian tutan pleton da mangxajxo al gardisto kriante: \"Vi ne povas pusxi cxi tiun fekacxon tra la gorgxo de kapitano! Kiam ni alterigxos, mi faros grandan kapton kaj montros al vi kiel aspektas VERA mangxajxo!\"\r\n \r\nAkuzito estis metita en solulan cxelon por la resto de la vojagxo.",
    "WUNT_FISHERMAN_OUTRO_FLAVOR": "..kaj tiel li foriris, kun la malmulta tempo, kiun li havis.",
    "WUNT_FISHERMAN_OUTRO_FAILURE": "..kaj tiel li malaperis, perdita en la maro.",
    "WUNT_FISHERMAN_MASTERY_SKIN_NAME": "Alternativa",
    "WUNT_FISHERMAN_PASSIVE_HOOK_EFFECT_NAME": "La Hokoj!",
    "WUNT_FISHERMAN_PASSIVE_HOOK_EFFECT_DESCRIPTION": "Certaj atakoj Hokas fisxojn, tirante ilin proksimen. Se fisxo estas tro peza por esti Hokita, sangigu gxin por 120% da damagxo.",
    "WUNT_FISHERMAN_PRIMARY_SLASH_NAME": "Senostigo",
    "WUNT_FISHERMAN_PRIMARY_SLASH_DESCRIPTION": "Frapegu antauxen por <style=cIsDamage>{0}% da damagxo.</style> La 1-a atako estas longdistanca pikbato, kiu {1} fisxojn.",
    "WUNT_FISHERMAN_SECONDARY_GUN_NAME": "Eljxeto",
    "WUNT_FISHERMAN_SECONDARY_GUN_DESCRIPTION": "<style=cIsUtility>Ne-Mortiga.</style> Sxargu kaj eljxetu arkan hokon. Reakiru gxin por {0} fisxojn por <style=cIsDamage>{1}% da damagxo.</style>",
    "WUNT_FISHERMAN_UTILITY_PLATFORM_NAME": "F153 Mobila Kabana Platformo",
    "WUNT_FISHERMAN_UTILITY_PLATFORM_DESCRIPTION": "<style=cIsUtility>Animligita.</style> Deploju <style=cIsUtility>Direkteblan</style> dronon, sur kiu <style=cIsUtility>vi povas rajdi.</style> Auxtomate pafas al fisxoj per kanono por <style=cIsDamage>{0}% da damagxo.</style>",
    "WUNT_FISHERMAN_UTILITY_MINION_NAME": "Junior",
    "WUNT_FISHERMAN_UTILITY_DIRECT_NAME": "Direkti Platformon",
    "WUNT_FISHERMAN_UTILITY_DIRECT_DESCRIPTION": "Frapetu por direkti la platformon al celita loko aux celi fisxon per gxia kanono. Tenu por detrui gxin.",
    "WUNT_FISHERMAN_UTILITY_WHALE_NAME": "Stranga Amiko",
    "WUNT_FISHERMAN_UTILITY_WHALE_DESCRIPTION": "Liberigu <style=cIsUtility>Bateblan</style> balenon, kiu <style=cIsUtility>heredas cxiujn viajn objektojn.</style> Eligas fumon, kiu blindigas proksimajn fisxojn. Reaktivigu por eksplodigi por <style=cIsDamage>700% da damagxo.</style>",
    "WUNT_FISHERMAN_UTILITY_WHALE_MINION_NAME": "Amiko de Fisherman",
    "WUNT_FISHERMAN_SPECIAL_BOMB_NAME": "Man o' War",
    "WUNT_FISHERMAN_SPECIAL_BOMB_DESCRIPTION": "Lanĉu gluan bombon, kiu <style=cIsUtility>Ligas</style> fisxojn. Reaktivigu por {0} <style=cIsUtility>Ligitajn</style> fisxojn en grapolon.",
    "WUNT_FISHERMAN_SPECIAL_DRINK_NAME": "Trankviligi la Nervojn",
