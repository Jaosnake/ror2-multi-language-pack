{
  "eo": {
    "ETHA10_GANONDORF_BODY_NAME": "Ganondorf",
    "ETHA10_GANONDORF_BODY_DESCRIPTION": "Ganondorf, la Granda Regxo de Malbono alvenis! <color=#CCD3E0>\n\n< ! > Faru simplan pugnobaton kaj flugigu malamikojn, aux impetu tra malamikoj.\n\n< ! > Uzu piedbatojn por rapide trakti aerajn malamikojn.\n\n< ! > Uzu Flaman Sufokon por kapti plurajn malamikojn sinsekve, senkapabligante ilin.\n\n< ! > Sorcxista Piedo estas bonega movigxema ilo, kaj maniero flugigi malamikojn.\n\n< ! > Sorcxista Pugnobato por eligi detruan eksplodan pugnobaton.\n\n< ! > Konstruu vian Triforton de Potenco atakante aux mortigante malamikojn, siavice pliigante vian kirason, atakon kaj la potencon de viaj Utilajxo kaj Specialajxo.\n\n</color>",
    "ETHA10_GANONDORF_BODY_SUBTITLE": "La Granda Regxo de Malbono",
    "ETHA10_GANONDORF_BODY_LORE": "??",
    "ETHA10_GANONDORF_BODY_OUTRO_FLAVOR": "..kaj tiel li foriris, disvastigante malicon sur sia vojo.",
    "ETHA10_GANONDORF_BODY_OUTRO_FAILURE": "..kaj tiel li malaperis, sigelita por eterneco...",
    "ETHA10_GANONDORF_BODY_DEFAULT_SKIN_NAME": "Klasika",
    "ETHA10_GANONDORF_BODY_MASTERY_SKIN_NAME": "Regxa",
    "ETHA10_GANONDORF_BODY_OLD_SKIN_NAME": "Sagxa",
    "ETHA10_GANONDORF_BODY_BRAWL_SKIN_NAME": "Majesta",
    "ETHA10_GANONDORF_BODY_BLAST_SKIN_NAME": "Eksplodo el la pasinteco",
    "ETHA10_GANONDORF_BODY_SKIN1_NAME": "Saturita Klasika",
    "ETHA10_GANONDORF_BODY_SKIN2_NAME": "Purpura",
    "ETHA10_GANONDORF_BODY_SKIN3_NAME": "Verda",
    "ETHA10_GANONDORF_BODY_SKIN5_NAME": "Kolosa Malico",
    "ETHA10_GANONDORF_BODY_SKIN7_NAME": "Bruna",
    "ETHA10_GANONDORF_BODY_PASSIVE_NAME": "Triforto de Potenco",
    "ETHA10_GANONDORF_BODY_PASSIVE_DESCRIPTION": "Cxiu sukcesa trafo kaj mortigo konstruos stakojn kiuj pliigas la kirason kaj bazan damagxon de Ganondorf. Stakoj malpligrandigxas post 2 sekundoj sen konstruado. Cxiuj stakoj estos konsumitaj por plifortigi sukcesan trafon de via Specialajxo, pliigante la damagxon gxis <style=cIsDamage>1000%</style> cxe la maksimuma kvanto de stakoj.",
    "ETHA10_GANONDORF_BODY_PRIMARY_PUNCH_NAME": "Korpobatalo",
    "ETHA10_GANONDORF_BODY_PRIMARY_PUNCH_DESCRIPTION": "Sur la tero, pugnobatu antauxen por <style=cIsDamage>200% damagxo</style>.\n<style=cIsUtility>Sveniga.</style> Dum kurado, impetu antauxen, plugante tra malamikoj por <style=cIsDamage>400% damagxo</style>.\nEn la aero, piedbatu dufoje por <style=cIsDamage>90% damagxo</style> kaj <style=cIsDamage>250% damagxo</style>.\nEn la aero kaj rigardante malsupren, pusxu viajn piedojn malsupren resaltante mallongan distancon supren por <style=cIsDamage>250% damagxo</style>.",
    "ETHA10_GANONDORF_BODY_PRIMARY_SWORD_NAME": "Fendi",
    "ETHA10_GANONDORF_BODY_PRIMARY_SWORD_DESCRIPTION": "Fendu tra hordoj por <style=cIsDamage>220%</style> damagxo.\nCxe <style=cIsDamage>40 stakoj de triforto</style>, manifestu kaj pafu lumradion kiu pasas tra malamikoj por <style=cIsDamage>200%</style> damagxo.",
    "ETHA10_GANONDORF_BODY_SECONDARY_KICK_NAME": "Sorcxista Piedo",
    "ETHA10_GANONDORF_BODY_SECONDARY_KICK_DESCRIPTION": "<style=cIsUtility>Peza.</style> Lancxu vin antauxen forpusxante malpezajn malamikojn por <style=cIsDamage>300% damagxo</style>.",
    "ETHA10_GANONDORF_BODY_SECONDARY_GRAB_NAME": "Flama Sufoko",
    "ETHA10_GANONDORF_BODY_SECONDARY_GRAB_DESCRIPTION": "Impetu antauxen kaptante malamikojn en vico kaj sufokbatante ilin sur la teron por <style=cIsDamage>550% damagxo</style>.",
    "ETHA10_GANONDORF_BODY_SECONDARY_SWORD_CHARGE_NAME": "Dentita Kirlovento",
    "ETHA10_GANONDORF_BODY_SECONDARY_SWORD_CHARGE_DESCRIPTION": "Tenu premata por sxargi vian glavon gxis 4s, kaj lasu por jxeti vian glavon antauxen, farante <style=cIsDamage>500%</style> sen sxargo por bato. Cxe plena sxargo, damagxo pligrandigxas je <style=cIsDamage>5x</style>. Ganondorf povas uzi siajn korpobatalajn atakojn dum lia glavo estas jxetita.",
    "ETHA10_GANONDORF_BODY_UTILITY_GRAB_NAME": "Flama Sufoko",
    "ETHA10_GANONDORF_BODY_UTILITY_GRAB_DESCRIPTION": "Impetu antauxen kaptante malamikojn en vico kaj sufokbatante ilin sur la teron por <style=cIsDamage>700% damagxo</style>. Konsumas 30 stakojn je sukcesa trafo intersxangxe por <style=cIsDamage>300% pli da damagxo</style>.",
    "ETHA10_GANONDORF_BODY_UTILITY_KICK_NAME": "Sorcxista Piedo",
    "ETHA10_GANONDORF_BODY_UTILITY_KICK_DESCRIPTION": "<style=cIsUtility>Peza.</style> Lancxu vin antauxen forpusxante malpezajn malamikojn por <style=cIsDamage>700% damagxo</style>. Konsumas 30 stakojn je sukcesa trafo intersxangxe por <style=cIsDamage>300% pli da damagxo</style>.",
    "ETHA10_GANONDORF_BODY_UTILITY_AERIAL_GRAB_NAME": "Malhela Plongxo",
    "ETHA10_GANONDORF_BODY_UTILITY_AERIAL_GRAB_DESCRIPTION": "Saltu supren kaptante malamikojn sur via vojo, eksplodigante ilin en pecetojn, unue trafante 5 etajn eksplodojn baze por <style=cIsDamage>65% damagxo</style> kaj poste fine eligante eksplodon por <style=cIsDamage>650% damagxo</style>. La nombro da etaj eksplodoj kreskas kun atakrapideco. Teni la butonon premata antaux ol la movo finigxas igos Ganondorf rapide fali. Konsumas 30 stakojn je sukcesa trafo intersxangxe por <style=cIsDamage>300% pli da damagxo</style>.",
    "ETHA10_GANONDORF_BODY_SECONDARY_AERIAL_GRAB_NAME": "Malhela Plongxo",
    "ETHA10_GANONDORF_BODY_SECONDARY_AERIAL_GRAB_DESCRIPTION": "Saltu supren kaptante malamikojn sur via vojo, eksplodigante ilin en pecetojn, unue trafante 5 etajn eksplodojn baze por <style=cIsDamage>45% damagxo</style> kaj poste fine eligante eksplodon por <style=cIsDamage>450% damagxo</style>. La nombro da etaj eksplodoj kreskas kun atakrapideco. Teni la butonon premata antaux ol la movo finigxas igos Ganondorf rapide fali.",
    "ETHA10_GANONDORF_BODY_SPECIAL_PUNCH_NAME": "Sorcxista Pugnobato",
    "ETHA10_GANONDORF_BODY_SPECIAL_PUNCH_DESCRIPTION": "Sxargu potencan pugnobaton, dum akirado de mallonga eksplodo de Superkiraso, eligante <style=cIsDamage>1000% damagxon</style> sur proksimajn malamikojn.\nKonsumu 50 stakojn por plifortigi la movon je <style=cIsDamage>333%</style> damagxo. Konsumu 100 stakojn por plifortigi la movon je <style=cIsDamage>1000%</style> damagxo.",
    "ETHA10_GANONDORF_BODY_INFERNO_KICK_NAME": "Infera Giljotino",
    "ETHA10_GANONDORF_BODY_INFERNO_KICK_DESCRIPTION": "Tiru malamikojn en ilian pereon, frapante vian piedon malsupren, farante <style=cIsDamage>1100% damagxon</style> en radiuso cxirkaux vi.<color=#D2042D> Neniu Superkiraso.</color>\nKonsumu 50 stakojn por plifortigi la movon je <style=cIsDamage>333%</style> damagxo. Konsumu 100 stakojn por plifortigi la movon je <style=cIsDamage>1000%</style> damagxo.",
    "ETHA10_GANONDORF_BODY_OBLITERATE_SWORD_NAME": "Forvisxi",
    "ETHA10_GANONDORF_BODY_OBLITERATE_SWORD_DESCRIPTION": "Tenu vian glavon alte, sxargante gxis <style=cIsDamage>5s</style> por pliigi damagxon kaj atingopovon. Lasu por jxeti vian glavon malsupren, sendante eksplodojn malsupren en la direkto kiun vi frontas. Baze, eksplodoj faras <style=cIsDamage>600%</style> damagxon, kaj povas kreski gxis maksimumo de <style=cIsDamage>5x</style> por eksplodo.",
    "ETHA10_GANONDORF_BODY_SCEPTERSPECIAL_NAME": "Vera Sorcxista Pugnobato",
    "ETHA10_GANONDORF_BODY_SCEPTERSPECIAL_DESCRIPTION": "Sxargu potencan pugnobaton eligante <style=cIsDamage>1000% damagxon</style> sur proksimajn malamikojn. La kresko de Sorcxista Pugnobato nun estas pli forta, atingante maksimumon de <style=cIsDamage>2000% damagxo</style>.",
    "ETHA10_GANONDORF_BODY_SCEPTER_SPECIAL_KICK_NAME": "Vera Infera Giljotino",
    "ETHA10_GANONDORF_BODY_SCEPTER_SPECIAL_KICK_DESCRIPTION": "Tiru malamikojn en ilian pereon, frapante vian piedon malsupren, farante <style=cIsDamage>1100% damagxon</style> en radiuso cxirkaux vi.<color=#D2042D> Neniu Superkiraso.</color> La kresko de Infera Giljotino nun estas pli forta, atingante maksimumon de <style=cIsDamage>2000% damagxo</style>.",
    "ETHA10_GANONDORF_BODY_SCEPTER_OBLITERATE_SWORD_NAME": "Vera Forvisxo",
    "ETHA10_GANONDORF_BODY_SCEPTER_OBLITERATE_SWORD_DESCRIPTION": "Tenu vian glavon alte, sxargante gxis <style=cIsDamage>5s</style> por pliigi damagxon kaj atingopovon. Lasu por jxeti vian glavon malsupren, sendante eksplodojn malsupren en la direkto kiun vi frontas. Baze, eksplodoj faras <style=cIsDamage>600%</style> damagxon, kaj povas kreski gxis maksimumo de <style=cIsDamage>5x</style> por eksplodo. La kresko de Forvisxi nun estas pli forta, atingante maksimumon de <style=cIsDamage>2000% damagxo</style>.",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Ganondorf: Majstreco",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESCRIPTION": "Kiel Ganondorf, venku la ludon en Monsoon.",
    "ETHA10_GANONDORF_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Ganondorf: Majstreco",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_EIGHTLUNAR_ACHIEVEMENT_NAME": "Ganondorf: Malpermesitaj Metodoj",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_EIGHTLUNAR_ACHIEVEMENT_DESCRIPTION": "Kiel Ganondorf, kolektu 8 Lunajn Objektojn en unuopa ludado.",
    "ETHA10_GANONDORF_BODY_EIGHTLUNAR_UNLOCKABLE_NAME": "Ganondorf: Malpermesitaj Metodoj",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_TENGRAB_ACHIEVEMENT_NAME": "Ganondorf: Plenmana",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_TENGRAB_ACHIEVEMENT_DESCRIPTION": "Kiel Ganondorf, kaptu 15 aux pli da malamikoj per unuopa kapto.",
    "ETHA10_GANONDORF_BODY_TENGRAB_UNLOCKABLE_NAME": "Ganondorf: Plenmana",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_HEAVYDAMAGE_ACHIEVEMENT_NAME": "Ganondorf: Pezmana \"Pugno\"-Puno",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_HEAVYDAMAGE_ACHIEVEMENT_DESCRIPTION": "Kiel Ganondorf, faru movon kiu kauxzas pli ol 7,500 damagxon per unuopa trafo.",
    "ETHA10_GANONDORF_BODY_HEAVYDAMAGE_UNLOCKABLE_NAME": "Ganondorf: Pezmana \"Pugno\"-Puno",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_ITEMGATHERER_ACHIEVEMENT_NAME": "Ganondorf: Malfermita por Eksperimentado",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_ITEMGATHERER_ACHIEVEMENT_DESCRIPTION": "Kiel Ganondorf, tenu po unu rubajxon de cxiu objekta rango.",
    "ETHA10_GANONDORF_BODY_ITEMGATHERER_UNLOCKABLE_NAME": "Ganondorf: Malfermita por Eksperimentado",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASSACRE_ACHIEVEMENT_NAME": "Ganondorf: Alportanto de Malico",
    "ACHIEVEMENT_ETHA10_GANONDORF_BODY_MASSACRE_ACHIEVEMENT_DESCRIPTION": "Kiel Ganondorf: Mortigu 50 Lemurianojn, Fajrerojn, Meduzojn, Skarabojn, Eta-Fungojn kaj Koboldojn en unuopa ludado.",
    "ETHA10_GANONDORF_BODY_MASSACRE_UNLOCKABLE_NAME": "Ganondorf: Alportanto de Malico",
