        "NDP_DANCER_BODY_UTILITY_PULL_DESCRIPTION": "Etendu vian lancon, kauxzante <style=cIsDamage>550% da damagxo</style>. Tenu por <style=cIsUtility>tiri</style> vin kaj malamikojn al la pinto. <style=cIsUtility>Saltu</style> por fini frue.",
        "NDP_DANCER_BODY_SPECIAL_RIBBON_LOCK_NAME": "Ligita per rubando",
        "NDP_DANCER_BODY_SPECIAL_RIBBON_LOCK_DESCRIPTION": "Vi ne povas uzi cxi tiun kapablon.",
        "KEYWORD_DANCER_JAB": "<style=cKeywordName>Bato</style><style=cSub>Tera enigo, celu antauxen. Impetu antauxen kaj kauxzu <style=cIsDamage>180% da damagxo</style>.</style>",
        "KEYWORD_DANCER_DOWNTILT": "<style=cKeywordName>Suba Bato</style><style=cSub>Tera enigo, celu malsupren. Jxetu malamikojn supren kaj kauxzu <style=cIsDamage>200% da damagxo</style>.</style>",
        "KEYWORD_DANCER_FORWARDAIR": "<style=cKeywordName>Antauxa Aera Bato</style><style=cSub>Aera enigo, celu antauxen. Peza frapo kauxzanta <style=cIsDamage>180% da damagxo</style> kaj jxetas malamikojn al la tero, stuporigante kaj kauxzante gxis <style=cIsDamage>300% da damagxo</style>.</style>",
        "NDP_DANCER_BODY_SECONDARY_SLASH_NAME": "Duaranga",
        "NDP_DANCER_BODY_SECONDARY_SLASH_DESCRIPTION": "Rapide movigxu en elektita direkto kaj frapu <style=cIsDamage>3</style> fojojn, cxiun por <style=cIsDamage>250% da damagxo</style>.",
        "NDP_DANCER_BODY_UTILITY_DRILL_NAME": "Utila (Borilo)",
        "NDP_DANCER_BODY_UTILITY_DRILL_DESCRIPTION": "Ataku horizontale por <style=cIsDamage>3x180% da damagxo</style>, poste komencu <style=cIsDamage>Suba Bato</style>. Stokas gxis <style=cIsUtility>2</style> sxargxojn.",
        "NDP_DANCER_BODY_SPECIAL_RIBBON_NAME": "Speciala",
        "NDP_DANCER_BODY_SPECIAL_RIBBON_DESCRIPTION": "<style=cIsDamage>Stupefiga.</style> Pafu kuglon, kiu ligas malamikojn per <color=#b50727>rubando</color> dum <style=cIsDamage>8</style> sekundoj. Ataki ligitajn malamikojn donas <style=cIsHealing>portempan barilon</style> kaj <style=cIsDamage>plilongigas</style> la rubandon.",
        "KEYWORD_DANCER_CANCELS": "Kurante vi <style=cIsUtility>nuligas</style> rapidajn batojn en kuratakon. Saltante vi <style=cIsUtility>nuligas</style> terajn atakojn en aerajn atakojn.",
        "KEYWORD_DANCER_DASH": "<style=cKeywordName>Kuratako</style><style=cSub>Enigo: surtere, kurante. Impetu antauxen, interrompu malamikojn kaj kauxzu <style=cIsDamage>250%</style> da damagxo.</style>",
        "KEYWORD_DANCER_UPAIR": "<style=cKeywordName>Aera atako supren</style><style=cSub>Enigo: celu supren. Du atakoj kauxzas <style=cIsDamage>150%</style> kaj <style=cIsDamage>200%</style> da damagxo. La mallargxa dua atako kauxzas gxis <style=cIsDamage>3x</style> da damagxo al malmulte sanaj malamikoj.</style>",
        "KEYWORD_DANCER_DOWNAIR": "<style=cKeywordName>Aera atako malsupren</style><style=cSub>Enigo: aere, celu malsupren. Plongxu kaj ripete kauxzu <style=cIsDamage>125%</style> da damagxo. Surterigxante komencu <style=cIsDamage>Suba Bato</style>.</style>",
        "KEYWORD_DANCER_INPUTS": "<style=cKeywordName>Enigoj</style><style=cSub>Movdirekto, kurado kaj salto faras atakojn. Iuj ripetitaj enigoj faras malsamajn atakojn. Pli bona klarigo venos; pardonu.</style>",
