				this.plating = plating;
				this.maxPlating = maxPlating;
				this.remove = remove;
				Process();
			}

			public void Serialize(NetworkWriter writer)
			{
				writer.Write(target);
				writer.Write(plating);
				writer.Write(maxPlating);
				writer.Write(remove);
			}

			public void Process()
			{
