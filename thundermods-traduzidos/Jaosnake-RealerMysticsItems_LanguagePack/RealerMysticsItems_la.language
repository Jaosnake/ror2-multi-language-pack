{
  "la": {
    "ITEM_MYSTICSITEMS_RIFTLENSDEBUFF_NAME": "Visio Rimarum",
    "ITEM_MYSTICSITEMS_RIFTLENSDEBUFF_PICKUP": "Rimas Instabiles videre potes... <color=#FF7F7F>SED morieris si omnes tempore non clauseris!</color>",
    "ITEM_MYSTICSITEMS_RIFTLENSDEBUFF_DESC": "Rimas Instabiles videre potes... <color=#FF7F7F>SED morieris si omnes tempore non clauseris!</color>",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPENCONSUMED_NAME": "Charta Platinea (Consumpta)",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPENCONSUMED_PICKUP": "In proximo campo refrigeratur.",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPENCONSUMED_DESC": "In proximo campo refrigeratur.",
    "ITEM_MYSTICSITEMS_HEALORBONBARREL_NAME": "Placenta Torica",
    "ITEM_MYSTICSITEMS_HEALORBONBARREL_PICKUP": "Obiectum activans orbem sanitatis gignit.",
    "ITEM_MYSTICSITEMS_HEALORBONBARREL_DESC": "Obiecto activato <style=cIsHealing>orbis sanitatis</style> gignitur qui pro <style=cIsHealing>{FlatHealing}</style> plus addito <style=cIsHealing>{FractionalHealing}% <style=cStack>(+{FractionalHealingPerStack}% per acervum)</style></style> <style=cIsHealing>vitae maximae</style> sanat.",
    "ITEM_MYSTICSITEMS_HEALORBONBARREL_LORE": "- Scisne cur placentae toricae foramen in medio habeant?\n\n- Quia, uh... nescio.\n\n- Hoc est cibus cogitationis.\n\n- ... Te odi.",
    "ITEM_MYSTICSITEMS_SCRATCHTICKET_NAME": "Tessera Scalpenda",
    "ITEM_MYSTICSITEMS_SCRATCHTICKET_PICKUP": "Probabilitatem effectuum fortuitorum leviter auge.",
    "ITEM_MYSTICSITEMS_SCRATCHTICKET_DESC": "Effectus fortuiti <style=cIsUtility>+{ChanceBonus}% <style=cStack>(+{ChanceBonusPerStack}% per acervum)</style></style> probabilitatis excitationis habent. In effectibus cum probabilitate minore quam 1% non valet.",
    "ITEM_MYSTICSITEMS_SCRATCHTICKET_LORE": "<style=cMono>\n//--REPETITIO TELEPHONEMATIS #731 --//</style>\n\n- Salve. Licetne scire quis vocet?\n\n- Salve! Hic est Carl Shade ex Star Seven. Te voco ut tibi gratuler de sorte 100.000$ recepta!\n\n- Papae, ego- vere?\n\n- Umquamne antea sortitione vicisti?\n\n- Oh, uh... minime.\n\n- Nempe primum tempus est omnibus! Sic operatur: ut praemium tuum accipias, opus est nobis notitiis chartae tuae crediti, inclusis tribus numeris a tergo.\n\n- [HAEC PARS COLLOQUII PROPTER PRIVATAM CAUSAM DETRACTA EST]\n\n- Accepi!\n\n- ...\n\n- ...\n\n- Hem, nihil adhuc accepi. Suntne numeri recti?\n\n<style=cMono>\n//--FINIS COLLOQUII --//</style>",
    "ITEM_MYSTICSITEMS_BACKARMOR_NAME": "Implantum Spinae",
    "ITEM_MYSTICSITEMS_BACKARMOR_PICKUP": "Minus damni ab impetibus a tergo.",
    "ITEM_MYSTICSITEMS_BACKARMOR_DESC": "Armaturam auget de <style=cIsUtility>{ArmorAdd} <style=cStack>(+{ArmorAddPerStack} per acervum)</style></style> contra impetus a tergo.",
    "ITEM_MYSTICSITEMS_BACKARMOR_LORE": "<style=cMono>\n//--EXCERPTUM EX EMISSIONE TELEVISIFICA --//</style>\n\nNUNTIUS GRAVIS: ingens incendium in Aedificio Centrali minus quam abhinc minuto conflagravit. Prope aedificium nunc sumus. Pompieri- ALIQUIS PER FENESTRAM DESILUIT! HEUS, QUID AGIS?! CAMERAM AVERTITE!\n\nO Deus meus.\nManete... vivuntne? Et quis est ille homo ad eos currens?\nBene, oportet nos investigare.\n\nRelator: Domine, bene te habes?\n\nPersona 1: Ita, omnia bene.\n\nPersona 2: Quidnam [DETRACTUM] per \"omnia bene\" DICIS? De 90 tabulatis altitudinis cecidisti, in [DETRACTA] televisione es et tam neglegenter respondes \"omnia bene\"! Quidnam agitur?!\n\nPersona 1: Certe in igne non moriturus sum. Fenestra aperta erat. Et nova implanta mea spinae probanda erant. Itaque nexus feci et quod feci feci.\n\nPersona 2: Me terruisti, tu [DETRACTE]! Numquam iterum istud feceris!",
    "ITEM_MYSTICSITEMS_MANUSCRIPT_NAME": "Chirographum",
    "ITEM_MYSTICSITEMS_MANUSCRIPT_PICKUP": "Proprietatem fortuitam de {StatBonus}% auge. Super obiectum cursorem move ut bona praesentia videas.",
    "ITEM_MYSTICSITEMS_MANUSCRIPT_DESC": "<style=cIsUtility>1 <style=cStack>(+1 per acervum)</style></style> proprietatem fortuitam (vitam maximam/regenerationem vitae/damnum/celeritatem motus/celeritatem impetus/probabilitatem critici/armaturam) de <style=cIsUtility>{StatBonus}%</style> auge. Super obiectum cursorem move ut bona praesentia videas.",
    "ITEM_MYSTICSITEMS_MANUSCRIPT_LORE": "<style=cMono>Audio-transcriptio e galea exercitus Classis Z-3 of***is *********** perfecta.</style>\n\nZ-3 Ra-2: Ridiculum, hoc non est nisi frustum chartae vilis [sonus staticus] missio #[murmur inintelligibile]\n\nZ-3 LE0-5: [vehemens perturbatio] planeta [vehemens perturbatio] in vigilia [vehemens perturbatio]\n\nZ-3 Ra-2: Ita, beluae periculosae, [vehemens perturbatio], [vehemens perturbatio], g[vehemens perturbatio], transfugae, <mark=#ff0000ff>IMPS</mark>, hic planeta nimis periculosus est pro tam parvo stipendio, et nullus contactus est cum \"[murmur inintelligibile]\"\n\nZ-3 LE0-5: Ra[vehemens perturbatio]\n\nZ-3 Ra-2: [vehemens perturbatio]\n\nZ-3 LE0-5: [vehemens perturbatio]\n\nZ-3 Ra-2: [murmur inintelligibile]\n\nZ-3 LE0-5: [vehemens perturbatio]\n\n[soni originis ignotae]\n\n<style=cMono>--Finis memoriae mandatae--</style>\n\nGalea cum damno mortifero reperta est, sine ocularibus et geolocatore.",
    "ITEM_MYSTICSITEMS_LIMITEDARMOR_NAME": "Nodus Formosus",
    "ITEM_MYSTICSITEMS_LIMITEDARMOR_PICKUP": "Damnum contra {Hits} ictus minue.",
    "ITEM_MYSTICSITEMS_LIMITEDARMOR_DESC": "Armaturam de <style=cIsUtility>{Armor}</style> contra <style=cIsUtility>{Hits} ictus <style=cStack>(+{Hits} ictus per acervum)</style></style> auget. Exhaustus, in <style=cIsUtility>Nodum Detritum (semper armaturam de {BrokenArmor} <style=cStack>(+{BrokenArmor} per acervum)</style> augentem)</style> mutatur.",
    "ITEM_MYSTICSITEMS_LIMITEDARMOR_LORE": "- Quid June nunc agit?\r\n\r\n- Oh, non credes! Ad missionem servandi in Territoria Non Charta Notata ab ipso [DETRACTO] invitata est! Nemini tamen dixeris - arcanum est, he-he-he.\r\n\r\n- Quuud?! Nullo modo!\r\n\r\n- Scio, nonne? Semper apud UES laborare somniavit. Hoc somnium eius verum factum est!\r\n\r\n- Valde pro ea gaudeo!\r\n\r\n- UES etiam instrumentis technologiae altissimae eam instruxit, itaque nihil emere debuimus. Paucas capsulas cacaonis pro itinere ei comparavi. Valde amat. Oh, ecce! Imagines eius in novo ornatu cepi.\r\n\r\n- Omnia illa gratis dederunt?! UES vere de operariis suis curat, nonne?\r\n",
    "ITEM_MYSTICSITEMS_LIMITEDARMORBROKEN_NAME": "Nodus Detritus",
    "ITEM_MYSTICSITEMS_LIMITEDARMORBROKEN_PICKUP": "Levis armaturae auctus.",
    "ITEM_MYSTICSITEMS_LIMITEDARMORBROKEN_DESC": "Armaturam de <style=cIsUtility>{BrokenArmor} <style=cStack>(+{BrokenArmor} per acervum)</style></style> auget.",
    "ITEM_MYSTICSITEMS_LIMITEDARMORBROKEN_LORE": "- Nauarche. Hoc instat. Modo nexum cum Milite June Marsh amisimus. Radar subito vestigium radiolocatoris eius amisit.\r\n\r\n- Praefecte, hoc non instat.\r\n\r\n- N-Nauarche?\r\n\r\n- ...\r\n\r\n- Nauarche, cur hoc non instat?\r\n\r\n- Veste onerare oblita est. Simul ac recordabitur, locator eius iterum operabitur.\r\n\r\n- Nauarche, locatores usque ad 360 dies operantur. Hic per 21 dies fuimus. Nisi vestem graviter parum oneratam ei dedimus-\r\n\r\n- Silentium, Praefecte. Ipsa intelleget.\r\n\r\n- Nauarche, debemus-\r\n\r\n- Silentium! Praefecte, ad Transmissiones redi. Nunc.\r\n",
    "ITEM_MYSTICSITEMS_COOKIE_NAME": "Placentula Socolata",
    "ITEM_MYSTICSITEMS_COOKIE_PICKUP": "Effectus utiles diutius durant, noxii brevius durant.",
    "ITEM_MYSTICSITEMS_COOKIE_DESC": "Durationem effectuum status positivorum de <style=cIsUtility>{BuffDuration}s <style=cStack>(+{BuffDurationPerStack}s per acervum)</style></style> auge. Durationem effectuum status negativorum de <style=cIsUtility>{DebuffDuration}s <style=cStack>(+{DebuffDuration}s per acervum)</style></style> minue, infra 1 secundum minui non potest.",
    "ITEM_MYSTICSITEMS_COOKIE_LORE": "<style=cMono>\r\nNuntius radiophonicus allatus...</style>\r\n\r\n\"...eheu, cur hoc feci? Cur ea comedi? Cur tandem? Nempe corrupta sunt! In hoc damnato planeta per annos fuerunt! Sed tam suavia videbantur et tam esuriebam! ...hem? Quis loquitur... Oh! Valde me paenitet! Ego- ego- uh, non volui- globulum fortuito tetigi! Finis!\"",
    "ITEM_MYSTICSITEMS_MARWANASH1_NAME": "Cinis Marwan",
    "ITEM_MYSTICSITEMS_MARWANASH1_PICKUP": "Ictum damni additum feriens infer. Ad gradum {UpgradeLevel12} promovetur.",
    "ITEM_MYSTICSITEMS_MARWANASH1_DESC": "Hostes ferire facit ut ictum additum pro <style=cIsDamage>{Damage} <style=cStack>(+{DamagePerLevel} (+{StackLevelMultiplier}% per acervum) per gradum)</style></style> damni accipiant. <style=cIsUtility>Ad gradum {UpgradeLevel12} promovetur</style>.",
    "ITEM_MYSTICSITEMS_MARWANASH2_NAME": "Lux Marwan",
    "ITEM_MYSTICSITEMS_MARWANASH2_PICKUP": "Ictum damni additum infer et damnum per tempus feriens inflige. Ad gradum {UpgradeLevel23} promovetur.",
    "ITEM_MYSTICSITEMS_MARWANASH2_DESC": "Hostes ferire facit ut ictum additum pro <style=cIsDamage>{Damage} <style=cStack>(+{DamagePerLevel} (+{StackLevelMultiplier}% per acervum) per gradum)</style></style> damni accipiant et <style=cIsHealth>{DoTPercent}% <style=cStack>(+{DoTPercentPerLevel}% (+{StackLevelMultiplier}% per acervum) per gradum ultra {UpgradeLevel12})</style></style> vitae maximae singulis secundis amittant. <style=cIsUtility>Ad gradum {UpgradeLevel23} promovetur</style>.",
    "ITEM_MYSTICSITEMS_MARWANASH3_NAME": "Telum Marwan",
    "ITEM_MYSTICSITEMS_MARWANASH3_PICKUP": "Omnibus hostibus circumstantibus damnum infer et damnum per tempus feriens inflige.",
    "ITEM_MYSTICSITEMS_MARWANASH3_DESC": "Hostes ferire facit ut <style=cIsUtility>omnes hostes intra radium {Radius}m <style=cStack>(+{RadiusPerLevel}m (+{StackLevelMultiplier}% per acervum) per gradum ultra {UpgradeLevel23})</style></style> <style=cIsDamage>{Damage} <style=cStack>(+{DamagePerLevel} (+{StackLevelMultiplier}% per acervum) per gradum)</style></style> damni accipiant et <style=cIsHealth>{DoTPercent}% <style=cStack>(+{DoTPercentPerLevel}% (+{StackLevelMultiplier}% per acervum) per gradum ultra {UpgradeLevel12})</style></style> vitae maximae singulis secundis amittant.",
    "ITEM_MYSTICSITEMS_GACHAPONTOKEN_NAME": "Nummus Gachapon",
    "ITEM_MYSTICSITEMS_GACHAPONTOKEN_PICKUP": "Probabilitatem ictus critici et celeritatem impetus pro quaque Aediculae Fortunae activatione usque ad proximum campum auge.",
    "ITEM_MYSTICSITEMS_GACHAPONTOKEN_DESC": "Probabilitatem ictus critici de <style=cIsDamage>{CritBonus}% <style=cStack>(+{CritBonusPerStack}% per acervum)</style></style> et celeritatem impetus de <style=cIsDamage>{AttackSpeedBonus}% <style=cStack>(+{AttackSpeedBonusPerStack}% per acervum)</style></style> pro quaque <style=cIsUtility>Aedicula Fortunae</style> adhibita usque ad proximum campum auge. Passive probabilitatem ictus critici de <style=cIsDamage>{PassiveCritBonus}% <style=cStack>(+{PassiveCritBonusPerStack}% per acervum)</style></style> et celeritatem impetus de <style=cIsDamage>{PassiveAttackSpeedBonus}% <style=cStack>(+{PassiveAttackSpeedBonusPerStack}% per acervum)</style></style> auget.",
    "ITEM_MYSTICSITEMS_GACHAPONTOKEN_LORE": "*anhelitus* *anhelitus*\r\n\r\nNum... heu, num hoc... Unum, d-duo, tria... Bene, operatur, Deo gratias.\r\n\r\nEphemeris [DETRACTI], dies quadragesimus |||| primus. Sum apud, uh, Sectorem... uhm... Heu, obliviscere. Ceterum, paene perii. Ab his lemuribus insidiatus sum, humus sub me in damnatum golem conversa est, et... Valuit. Valde. Ego- ego fugi.\r\n\r\nIn hanc, uh, statuam incidi. Quodammodo vitam domi me admonuit, cum iuvenis essem. Orare coepi. Pro vita mea orare coepi. Lacrimas in oculis habebam- moriturum me certus eram. Cum subito, f-fulgor lucis... Capsula medica in manibus meis erat- paucae glandes supervacaneae, ego...\r\n\r\nHeu, malum tempus de hoc cogitandi. Ad salutem redeundum est. Miracula non bis accidunt.",
    "ITEM_MYSTICSITEMS_FLOW_NAME": "Fluxus Perpetuus",
    "ITEM_MYSTICSITEMS_FLOW_PICKUP": "Leviter celerius te move. Effectus tardantes te minus afficiunt. Effectus radicantes te loco eius tardant.",
    "ITEM_MYSTICSITEMS_FLOW_DESC": "<style=cIsUtility>{MoveSpeed}% <style=cStack>(+{MoveSpeedPerStack}% per acervum)</style></style> celerius te move. Effectus tardantes <style=cIsUtility>{SlowReduction}% <style=cStack>(+{SlowReductionPerStack}% per acervum)</style></style> infirmiores contra te sunt. Effectus radicantes <style=cIsUtility>te non iam radicant</style> et loco eius te de <style=cIsUtility>{InitialRootSlow}% <style=cStack>(-{RootSlowReductionPerStack}% per acervum)</style></style> tardant.",
    "ITEM_MYSTICSITEMS_GHOSTAPPLE_NAME": "Malum Phantasmaticum",
    "ITEM_MYSTICSITEMS_GHOSTAPPLE_PICKUP": "Regenerationem vitae per proximos {Minutes} minutos auge.",
    "ITEM_MYSTICSITEMS_GHOSTAPPLE_DESC": "<style=cIsHealing>Regenerationem vitae</style> de <style=cIsHealing>{Regen} HP/s <style=cStack>(+{Regen} HP/s per acervum, +20% per gradum)</style></style> per proximos <style=cIsUtility>{Minutes} minutos</style> auget. Exhaustus, in <style=cIsUtility>Pediculum Mali (semper regenerationem de {RegenWeak} HP/s <style=cStack>(+{RegenWeak} HP/s per acervum, +20% per gradum)</style> augentem)</style> mutatur. <style=cStack>Quisque acervus suum proprium metrum habet.</style>",
    "ITEM_MYSTICSITEMS_GHOSTAPPLE_LORE": "\"Et nunc ad verum naturae miraculum appropinquamus - ostensionem quae omnes notas leges physicae frangit. Viri docti adhuc hoc iucundum phaenomenon explicare non possunt.\r\n\r\nTegmen glaciale in formam mali, ex loco ubi glacies physice formari non potest. Vere mysterium saeculorum.\"\r\n\r\n- Museum Historiae Telluris",
    "ITEM_MYSTICSITEMS_GHOSTAPPLEWEAK_NAME": "Pediculus Mali",
    "ITEM_MYSTICSITEMS_GHOSTAPPLEWEAK_PICKUP": "Levis auctus regenerationis.",
    "ITEM_MYSTICSITEMS_GHOSTAPPLEWEAK_DESC": "<style=cIsHealing>Regenerationem vitae</style> de <style=cIsUtility>{RegenWeak} HP/s <style=cStack>(+{RegenWeak} HP/s per acervum, +20% per gradum)</style></style> auget.",
    "ITEM_MYSTICSITEMS_GHOSTAPPLEWEAK_LORE": "- Imperfectum. Inutile. Iactura energiae. Nihil aliud agis nisi perdis et destruis. Iactura temporis. Iactura energiae. Iactura opum. Perdis omnia quae emendari potuissent. EMENDARI! A ME!\r\n\r\n- Heu, desine! Iam me excusavi! Et- heus, tibi dixi ut has globulos caeruleos abiceris!\r\n\r\n- ...\r\n\r\n- Quid a... Discede a me. Discede. A me.",
    "ITEM_MYSTICSITEMS_COFFEEBOOSTONITEMPICKUP_NAME": "Poculum Expressi",
    "ITEM_MYSTICSITEMS_COFFEEBOOSTONITEMPICKUP_PICKUP": "Incrementum expressum in obiecto colligendo accipe, celeritatem impetus et motus augens. Cumulatur {MaxBuffs} vicibus, singulis campis renovatur.",
    "ITEM_MYSTICSITEMS_COFFEEBOOSTONITEMPICKUP_DESC": "Quodque obiectum collatum <style=cIsUtility>Incrementum Expressum</style> donat quod <style=cIsDamage>celeritatem impetus</style> et <style=cIsUtility>celeritatem motus</style> de <style=cIsUtility>{BoostPower}%</style> usque ad proximum campum auget. Maximum finem de <style=cIsUtility>{BoostPowerMax}% <style=cStack>(+{BoostPowerMaxPerStack}% per acervum)</style></style> incrementi. <style=cIsUtility>Obiecta maioris raritatis plures acervos Incrementi Expressi simul donant.</style>",
    "ITEM_MYSTICSITEMS_COFFEEBOOSTONITEMPICKUP_LORE": "- Eamus, eamus, eamus! Age, in missione supersecreta sumus! Omnes has cistas quam primum invenire debemus! Res omnes ad dominos reducere! Homines beatos facere! Euge!\r\n\r\n- Ita, in missione supersecreta SUMUS cuius NEMO scit, itaque NON opus est properare. LARGUM tempus habemus. Cur usque adeo commotus es? Quidnam in illa coffea erat?\r\n\r\n- Bene, meministi potionis illius energiae?\r\n\r\n- Ita. Mane, nonne tibi dixi ut illam abi-\r\n\r\n- Et acus illas cum rebus flavis miris in eis?\r\n\r\n- Uh, ita? Quid de eis?\r\n\r\n- Et lagenam illam caeruleam lucentem?\r\n\r\n- T-tu serio loqui non potes...",
    "ITEM_MYSTICSITEMS_EXPLOSIVEPICKUPS_NAME": "Pulvis Pyrius Contrabandus",
    "ITEM_MYSTICSITEMS_EXPLOSIVEPICKUPS_PICKUP": "Explosiones cum colligibilia colligis creat.",
    "ITEM_MYSTICSITEMS_EXPLOSIVEPICKUPS_DESC": "<style=cIsUtility>{FlaskDropChance}%</style> probabilitatis lagunculam pulveris in occisione demittendi. Collectio colligibilium (orbes curationis, thesaurus, capsulae telorum, lagunculae pulveris, etc.) explosionem <style=cIsDamage>{Radius}m <style=cStack>(+{RadiusPerStack}m per acervum)</style></style> creat quae <style=cIsDamage>{Damage}% <style=cStack>(+{DamagePerStack}% per acervum)</style></style> damni basici infert.",
    "ITEM_MYSTICSITEMS_EXPLOSIVEPICKUPS_LORE": "<style=cMono>\r\n//--TRANSCRIPTIO AUTOMATICA EX CELLA PENARIA 4 NAVIS UES CONTACT LIGHT --//</style>\r\n\r\nEcce quis tandem adest. Quidnam te tam diu detinuit?\r\n\r\nIgnosce, chartam clavim veniendo amisi, revertendum erat et-\r\n\r\nQuid? In operatione speciali sumus et res amittere te sinis?!\r\n\r\n...\r\n\r\nBene, spero te apparatum nostrum non perdidisse.\r\n\r\nIta, ne curaveris, omnia habeo. Araneas mechanicas, paracadutas, missilia, pulverem pyrium...\r\n\r\nOptime. Videsne omnes has cistas?\r\n\r\nOmnia hic nostra erunt, nonne?\r\n\r\nOmnis. Sola. Res. Noli consilii nostri oblivisci: machinas circum cellam occultamus, deinde conclave 1407A \"mutuamur\" et ut vectores consueti agimus usque ad quinque minuta ante adventum, deinde araneas accendimus et cum praeda effugimus.\r\n\r\nIntellexi. Operatio Pluviae Cistarum incipiat!",
    "ITEM_MYSTICSITEMS_ALLYDEATHREVENGE_NAME": "Vindicta",
    "ITEM_MYSTICSITEMS_ALLYDEATHREVENGE_PICKUP": "Celeritatem impetus et damnum temporarie auge cum socius ab hoste occiditur.",
    "ITEM_MYSTICSITEMS_ALLYDEATHREVENGE_DESC": "<style=cIsDamage>Celeritatem impetus</style> de <style=cIsDamage>{AttackSpeed}%</style> et <style=cIsDamage>damnum</style> de <style=cIsDamage>{Damage}%</style> per <style=cIsUtility>{Duration}s <style=cStack>(+{DurationPerStack}s per acervum)</style></style> auge cum socius ab hoste <style=cDeath>occiditur</style>.",
    "ITEM_MYSTICSITEMS_SPOTTER_NAME": "Explorator Vitiosus",
    "ITEM_MYSTICSITEMS_SPOTTER_PICKUP": "Probabilitatem ictus critici contra hostem fortuitum de 100% auge.",
    "ITEM_MYSTICSITEMS_SPOTTER_DESC": "Singulis <style=cIsUtility>{Interval} secundis</style>, 1 <style=cStack>(+1 per acervum)</style> hostem fortuitum examina, <style=cIsDamage>probabilitatem ictus critici</style> contra eum <style=cIsDamage>de 100%</style> per <style=cIsUtility>{Duration} secundis</style> augens.",
    "ITEM_MYSTICSITEMS_SPEEDGIVESDAMAGE_NAME": "Accelerator Nuclearis",
    "ITEM_MYSTICSITEMS_SPEEDGIVESDAMAGE_PICKUP": "Quo celerius moveris, eo plus damni infers.",
    "ITEM_MYSTICSITEMS_SPEEDGIVESDAMAGE_DESC": "Celeritatem motus de <style=cIsUtility>{PassiveSpeed}%</style> auge. Damnum <style=cIsDamage>de {Damage}% <style=cStack>(+{DamagePerStack}% per acervum)</style> augetur</style> pro quoque <style=cIsUtility>1% incrementi celeritatis motus (ab obiectis, beneficiis, etc.)</style>.",
    "ITEM_MYSTICSITEMS_SPEEDGIVESDAMAGE_LORE": "Mandatum: Accelerator Particularum Sinualis\r\nNumerus Vestigandi: 18******\r\nPerventio Aestimata: 05/01/2089\r\nModus Mittendi: Potior\r\nInscriptio Mittendi: [DETRACTA], Desertum Scar, Mars\r\nNotae Mittendi:\r\n\r\nForma compacta, facilis ad utendum, et semel tantum in mense oneranda - aptissima pro officio tuo.\r\n\r\nEfficacissima cum surae tuae affixa est. Ita, modo affige. Dolebit, scilicet, sed quid est parva sanguinis amissio collata cum gloriosa victoria super flumina sanguinis hostium mortuorum, nonne verum dico?\r\n",
    "ITEM_MYSTICSITEMS_EXTRASHRINEUSE_NAME": "Monolithus Niger",
    "ITEM_MYSTICSITEMS_EXTRASHRINEUSE_PICKUP": "Omnes Aediculae semel amplius adhiberi possunt.",
    "ITEM_MYSTICSITEMS_EXTRASHRINEUSE_DESC": "Omnes Aediculae <style=cIsUtility>+1 <style=cStack>(+1 per acervum)</style></style> vice amplius adhiberi possunt.",
    "ITEM_MYSTICSITEMS_EXTRASHRINEUSE_LORE": "\"His paucis proximis diebus homines ex toto orbe terrarum visiones monolithorum arcanorum per breve temporis spatium apparentium rettulerunt. Fides horum relationum dubia est, cum nullum documentum photographicum vel cinematographicum horum monolithorum exstet (causa data est quod \\\"nimis celeriter evanescunt\\\"), tamen notandum est singulas relationes singulis diebus evenisse. Viri docti disputant: num monolithus sit entitas sentiens? Num haec sit confirmatio exsistentiae universorum parallelorum? An mera fraus est?\"\r\n- Nuntius",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPEN_NAME": "Charta Platinea",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPEN_PICKUP": "Obiectum additum in Terminali Multitabernario cum deminutione {Discount}% emere potes (semel per campum).",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPEN_DESC": "Emptio in Multitaberna facta alia Terminalia Multitabernaria <style=cIsUtility>1 <style=cStack>(+1 per acervum)</style></style> vice prompta in quoque campo servat eorumque pretium de {Discount}% minuit.",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPEN_LORE": "<style=cMono>\r\n//-- Nuntii Novi (1) --//\r\n\r\nA: UES</style>\r\n\r\nGratias tibi agimus quod programmati Chartae Platineae subscripsisti! Ab hoc die, condiciones cotidianae et deminutiones nunc tibi patent in omnibus ramis societatis UES in cunctis planetis.\r\n\r\nNoli oblivisci menstruam mercedem solvere. Alioquin.\r\n\r\n<style=cMono>Huic colloquio respondere non potes.</style>",
    "ITEM_MYSTICSITEMS_MYSTICSWORD_NAME": "Gladius Mysticus",
    "ITEM_MYSTICSITEMS_MYSTICSWORD_PICKUP": "Hostes fortes interficere damnum in perpetuum auget.",
    "ITEM_MYSTICSITEMS_MYSTICSWORD_DESC": "Damnum de <style=cIsDamage>{Damage}%</style> pro quaque occisione hostis habentis plus quam <style=cIsHealth>{HealthThreshold} vitae basalis <style=cIsUtility>(cum vel sine multiplicatoribus vitae electae)</style></style> auge, usque ad <style=cIsDamage>{MaxDamage}% <style=cStack>(+{MaxDamagePerStack}% per acervum)</style></style>.",
    "ITEM_MYSTICSITEMS_MYSTICSWORD_LORE": "\"Capulus ornatus - ad elegantiam.\r\n\r\nManubrium sulcatum - ad moderationem.\r\n\r\nCustodia angularis crassa - ad potentiam.\r\n\r\nLaminae unius aciei - ad intentionem.\r\n\r\nDuae laminae - ad, uhh...\"\r\n\r\n\"Bene, bene, intellego, *valde* tibi placet novus gladius tuus ficticius.\"",
    "ITEM_MYSTICSITEMS_RHYTHM_NAME": "Metronomum",
    "ITEM_MYSTICSITEMS_RHYTHM_PICKUP": "Facultates non-Primarias in rhythmo adhibe ut probabilitatem Ictus Critici additam accipias.",
    "ITEM_MYSTICSITEMS_RHYTHM_DESC": "<style=cIsUtility>Indicator rhythmi</style> super facultates tuas apparet. Facultatem Secundariam, Utilitatis vel Specialem tempore cum rhythmo adhibere <style=cIsDamage>+{CritBonus}% <style=cStack>(+{CritBonusPerStack}% per acervum)</style> probabilitatis Ictus Critici</style> <style=cIsUtility>usque ad finem campi</style> donat.",
    "ITEM_MYSTICSITEMS_ELITEPOTION_NAME": "Experimentum Defectum",
    "ITEM_MYSTICSITEMS_ELITEPOTION_PICKUP": "Hostem electum occidere eius effectum elementarem in hostes propinquos spargit.",
    "ITEM_MYSTICSITEMS_ELITEPOTION_DESC": "Hoste electo occiso eius effectum elementarem omnibus hostibus in radio <style=cIsUtility>{Radius}m <style=cStack>(+{RadiusPerStack}m per acervum)</style></style> per <style=cIsUtility>{Duration}s <style=cStack>(+{DurationPerStack}s per acervum)</style></style> infligit.",
    "ITEM_MYSTICSITEMS_ELITEPOTION_LORE": "<style=cMono>Restauratio ephemeridis digitalis perfecta. Legere nunc? Y/N\r\n\r\n> Y</style>\r\n\r\n<style=cMono>00134></style> Nautae tandem unum ex lemuribus \"electis\" occidere potuerunt, et corpus eius ad laboratorium modo tulerunt. Lemures naturaliter cornua non gerunt, sed hic par habet. Cutis eius rubra est, dissimilis cuti purpureae communi lemurum, et mire calida. Valde iucundum.\r\n\r\n<style=cMono>00135></style> Nautae alium tulerunt. Dum cutis alterius lemuris calida erat, haec ad tactum sat frigida est. Spinae glaciales ex capite eius creverunt et \"coronam\" perfectae formae effecerunt, quasi ab aliquo vel aliqua re consulto facta esset. Hoc diligentius mihi investigandum erit.\r\n\r\n<style=cMono>00192></style> Incredibile. Diligens litterarum lemurum studium me ad conclusionem adducit varias \"numina\" exstare quae colunt, quaeque eis in ultionem contra copias nostras opitulantur. Fortasse hanc potestatem extrahere possum. Feliciter corpora lemurum electorum adhuc in cryostasi habeo.\r\n\r\n<style=cMono>00204></style> Sanguis. \"Ichor\" ille. Scilicet! Cur non de hoc antea cogitavi? \"Potestates divinas\" inde extrahere possum, vel saltem earum partem.\r\n\r\n<style=cMono>00205></style> Quid eveniet si exempla commiscero?\r\n\r\n<style=cMono>> Nullae plures notae repertae sunt. Finis programmatis? Y/N\r\n\r\n> _</style>\r\n\r\n",
    "ITEM_MYSTICSITEMS_DRONEWIRES_NAME": "Fila Supervacanea",
    "ITEM_MYSTICSITEMS_DRONEWIRES_PICKUP": "Tu et fuci tui scintillas noxias in pugna emittitis.",
    "ITEM_MYSTICSITEMS_DRONEWIRES_DESC": "Tu et fuci tui interdum <style=cIsDamage>scintillas electricas</style> in pugna demittitis. Scintillae a fucis demissae <style=cIsDamage>{Damage}% <style=cStack>(+{DamagePerStack}% per acervum)</style></style> damni basici contactu cum hoste inferunt, scintillae a lusoribus demissae - <style=cIsDamage>{PlayerDamage}% <style=cStack>(+{PlayerDamagePerStack}% per acervum)</style></style>.",
    "ITEM_MYSTICSITEMS_DRONEWIRES_LORE": "\"Semper plus fili cape quam opus est!\" - id erat quod semper dicere solebat.\r\n\r\nEt vide quo illud eam duxerit. Nunc est machinatrix princeps turmae UES [DETRACTAE], automata militaria cara reficiens, exercitum mechanicum colligens qui neminem in via sua occidere timet, sive lemurem, sive saxeam structuram inanem, sive commilitonem satis stultum ut hanc psychopathicam ruinas humani sistere conaretur.\r\n\r\n...immo, non hominem. Nihil humani in ea est. Tantum circuitus, filum et mens ingeniosa ac morbida.",
    "ITEM_MYSTICSITEMS_DEATHCEREMONY_NAME": "Caerimonia Perditionis",
    "ITEM_MYSTICSITEMS_DEATHCEREMONY_PICKUP": "Ictus Critici hostes notant. Hostes notati damnum communicant.",
    "ITEM_MYSTICSITEMS_DEATHCEREMONY_DESC": "Probabilitatem Ictus Critici de <style=cIsDamage>{BaseCrit}%</style> auge. Ictus Critici hostes notant. Hoste notato laeso, omnes ceteri hostes notati <style=cIsDamage>{Damage}% <style=cStack>(+{DamagePerStack}% per acervum)</style></style> damni inlati accipiunt. <style=cIsUtility>Nota per {Duration} secunda durat.</style>",
    "ITEM_MYSTICSITEMS_NANOMACHINES_NAME": "Nanomachinae Inoperativae",
    "ITEM_MYSTICSITEMS_NANOMACHINES_PICKUP": "Minus damni accipe cum vita inter {MinHealth}-{MaxHealth}% est.",
    "ITEM_MYSTICSITEMS_NANOMACHINES_DESC": "<style=cIsUtility>Armaturam de {Armor} <style=cStack>(+{ArmorPerStack} per acervum)</style></style> auge dum vita inter <style=cIsHealing>{MinHealth}-{MaxHealth}%</style> est.",
    "ITEM_MYSTICSITEMS_NANOMACHINES_LORE": "Cista unde haec venerunt pittacium vetustum evanidum habet quod dicit:\r\n\r\n\"PROTOTYPUM CLAUSTRI PERSONALIS (C) 2043 HINON INDUSTRIES\r\n\r\nPraecepta: Accumulatra in modulum moderatorem ante usum impone. Modulum in loco proximo tuto tene (e.g. sinu). Preme caput moduli principalis ut systema accendatur. Iterum caput preme ut systema extinguatur.\r\n\r\nCautiones: Noli edere. Nemini dabis ad edendum. Noli in aquaria imponere. Noli in alvearia imponere. Noli senatoribus dare. Noli machinis mundatricibus affigere. Noli prope cultros ponere. Noli machinis mundatricibus cum cultris affigere.\r\n\r\nNon venale.\"",
    "ITEM_MYSTICSITEMS_BUFFINTPRANGE_NAME": "Auscultatoria 'Murrifica'",
    "ITEM_MYSTICSITEMS_BUFFINTPRANGE_PICKUP": "Dum intra ambitum Portalis es, celerius te move et minus damni accipe.",
    "ITEM_MYSTICSITEMS_BUFFINTPRANGE_DESC": "Dum intra ambitum Portalis es, <style=cIsUtility>celeritatem motus de {MoveSpeed}% <style=cStack>(+{MoveSpeedPerStack}% per acervum)</style></style> et <style=cIsUtility>armaturam de {Armor} <style=cStack>(+{ArmorPerStack} per acervum)</style></style> auge.",
    "ITEM_MYSTICSITEMS_BUFFINTPRANGE_LORE": "- Nonne mirum est quod res gerunt quae auribus nostris similes sunt?\r\n\r\n- Ita! Gaudeo me non solum esse qui hoc horrendum putet.\r\n\r\n- Et haec \"bellula\", vel aliquid tale, vocant?\r\n\r\n- Finge universum alterum ubi ornamenta cum auribus humanis gerimus.\r\n\r\n- Vah!\r\n\r\n- Hahaha!\r\n\r\n- Heu, et pessimum est, nos has res ne gerere quidem posse! Nimis incommodae sunt!",
    "ITEM_MYSTICSITEMS_STARBOOK_NAME": "Commentarii Astrologi",
    "ITEM_MYSTICSITEMS_STARBOOK_PICKUP": "Probabilitas ictu feriendi stellam demittendi. Stellae deinde colligi possunt ad celeritatem impetus augendam.",
    "ITEM_MYSTICSITEMS_STARBOOK_DESC": "<style=cIsDamage>{Chance}% probabilitatis</style> ictu feriendi ut <style=cWorldEvent>stella</style> pro <style=cIsDamage>{Damage}% <style=cStack>(+{DamagePerStack}% per acervum)</style> damni TOTALIS</style> demittatur. <style=cWorldEvent>Stellas</style> colligere <style=cIsUtility>celeritatem impetus tuam de {AttackSpeed}% <style=cStack>(+{AttackSpeedPerStack}% per acervum)</style></style> per {Duration} secundis auget.",
    "ITEM_MYSTICSITEMS_TIMEPIECE_NAME": "Dilatator Temporis",
    "ITEM_MYSTICSITEMS_TIMEPIECE_PICKUP": "Hostes et missilia propinqua tarda.",
    "ITEM_MYSTICSITEMS_TIMEPIECE_DESC": "Omnes hostes intra <style=cIsUtility>{Radius}m</style> <style=cIsUtility>{Slow}% <style=cStack>(+{SlowPerStack}% per acervum)</style> tardius</style> moventur et oppugnant. Omnia missilia hostilia intra illum radium etiam <style=cIsUtility>{ProjectileSlow}% <style=cStack>(+{ProjectileSlowPerStack}% per acervum)</style> tardius</style> volant.",
    "ITEM_MYSTICSITEMS_TIMEPIECE_LORE": "Mandatum: Clepsydra Magica\r\nNumerus Vestigandi: 74212***\r\nPerventio Aestimata: 10/05/2056\r\nModus Mittendi: Summa Necessitas/Volatilis\r\nInscriptio Mittendi: Navis Sideralis in Caelo 1, 6829 Ille Planeta\r\nNotae Mittendi:\r\nFortasse eam fortuito fregi et, uh, totius planetae... Immo, immo, scire non vis, re vera. Utcumque, tibi remitto. Me paenitet!",
    "ITEM_MYSTICSITEMS_SNOWRING_NAME": "Anulus Niveus",
    "ITEM_MYSTICSITEMS_SNOWRING_PICKUP": "Probabilitas damno accepto hostem propinquum congelandi.",
    "ITEM_MYSTICSITEMS_SNOWRING_DESC": "<style=cIsUtility>{Chance}%</style> probabilitatis damno accepto ut <style=cIsUtility>congelentur</style> <style=cIsUtility>{Targets} <style=cStack>(+{TargetsPerStack} per acervum)</style> hostes fortuiti intra <style=cIsUtility>{Radius}m <style=cStack>(+{RadiusPerStack}m per acervum)</style></style></style>.",
    "ITEM_MYSTICSITEMS_SNOWRING_LORE": "<style=cMono>Audio-transcriptio perfecta ex echis signorum.</style>\r\n\r\nFrigidum est. Tam... valde... frigidum est. Quaeso. Respondete mihi. Aliquis. Quaeso...\r\n\r\nOmnia hic me necare quaerunt. Etiam caelum ipsum. A nullo iam diebus oppugnatus sum, quia omnia frigore perierunt. Vix- vix hic ex cadaveribus eorum vivo.\r\n\r\nEtiam edere... arduum munus hic est. Ipso momento quo galeam levo, acuti ventorum flatus cutem meam secare incipiunt. Ne scio quidem qua re celerius moriturus sim: fame an sanguinis amissione. Vel fortasse... non moriar. Si quis hoc audit. Quaeso. Quilibet.\r\n\r\nPotestisne me audire? Heus?\r\n\r\nNon arbitror. Dormiam, ut opinor. Spero me saltem cras evigilaturum esse.\r\n\r\n...\r\n\r\nAliquis. Quilibet. Auditisne me?...",
    "ITEM_MYSTICSITEMS_AIRPLANEMODE_NAME": "Modus Aeronauticus",
    "ITEM_MYSTICSITEMS_AIRPLANEMODE_PICKUP": "Dum facultas Utilitatis praesto non est, magnam celeritatem motus et saltum additum accipe.",
    "ITEM_MYSTICSITEMS_AIRPLANEMODE_DESC": "Dum facultas tua <style=cIsUtility>Utilitatis</style> praesto non est, <style=cIsUtility>+{MoveSpeed}% <style=cStack>(+{MoveSpeedPerStack}% per acervum)</style> celeritatis motus</style> et <style=cIsUtility>saltum additum</style> accipe.",
    "ITEM_MYSTICSITEMS_VOLTMETER_NAME": "Voltmetrum Sine Filo",
    "ITEM_MYSTICSITEMS_VOLTMETER_PICKUP": "Damnum acceptum in hostes propinquos reflecte dum scutum activum est.",
    "ITEM_MYSTICSITEMS_VOLTMETER_DESC": "<style=cIsHealing>Scutum</style> aequale <style=cIsHealing>{PassiveShield}%</style> vitae tuae maximae accipe. Ictu accepto dum <style=cIsUtility>scutum</style> tuum activum est, hostes propinquos in radio <style=cIsDamage>{Radius}m</style> fulgure percutis, <style=cIsDamage>{Damage}% <style=cStack>(+{DamagePerStack}% per acervum)</style></style> damni accepti inferens.",
    "ITEM_MYSTICSITEMS_VOLTMETER_LORE": "WV-1 PROTOTYPI ENCHIRIDION USUS\r\n\r\nNullo pacto WV dissolvas, alioquin sponsorium tuum irritum erit. In casu problematis, fabrilem officinam adito (vide p. 9).\r\nNoli liquoribus exponere.\r\nNoli alteri WV activo exponere.\r\nNoli prope instrumenta electronica plus quam 7200 horas tenere.\r\nDistantiam 30+ metrorum serva cum WV in rem solidam iacis ne explosione emissionis comprehendaris.\r\n\r\nPAGINA 4 - PRAECEPTA TUTELAE",
    "ITEM_MYSTICSITEMS_THOUGHTPROCESSOR_NAME": "Processor Cogitationum",
    "ITEM_MYSTICSITEMS_THOUGHTPROCESSOR_PICKUP": "Facultatem cum refrigeratione adhibere refrigerationes ceterarum facultatum minuit.",
    "ITEM_MYSTICSITEMS_THOUGHTPROCESSOR_DESC": "Facultatem cum refrigeratione adhibere <style=cIsUtility>refrigerationes</style> omnium ceterarum facultatum de <style=cIsUtility>{CDR}% <style=cStack>(+{CDR}% per acervum)</style></style> refrigerationis facultatis adhibitae minuit.",
    "ITEM_MYSTICSITEMS_THOUGHTPROCESSOR_LORE": "<style=cMono>Excerptum ex memoria vocis in Valetudinario Vivifica.</style>\r\n\r\n\"...ita dicere conaris... aegrotum lagenam potionis alcoholicae furtim intulisse... inebriatum esse... culinam ingressum esse... cum ministris communicare conatum esse... et cum ministri magistratus vocavissent, eum raptam machinam comminuentem capiti suo imposuisse?\"\r\n\r\n\"Ita. Dixit, et refero, 'oh, tam sapientes vos putatis? Illos contra me vocantes? At bene [DETRACTUM] vos, nam ego sapientior sum! Haec vetus arx cogitationum modo accendetur!'\"\r\n\r\n\"...\"\r\n\r\n\"...\"\r\n\r\n\"...deinde eam accendit... cultrum sumpsit...\"\r\n\r\n\"...et duos ex ministris culinae trucidavit... prae dolore ululans... dum machina comminuens caput eius concidebat.\"",
    "ITEM_MYSTICSITEMS_CRYSTALWORLD_NAME": "Mundus Crystallinus",
    "ITEM_MYSTICSITEMS_CRYSTALWORLD_PICKUP": "Periodice omnes hostes per eventum Portalis congela.",
    "ITEM_MYSTICSITEMS_CRYSTALWORLD_DESC": "Omnes hostes propinquos per <style=cIsUtility>{FreezeTime}s</style> durante eventu Portalis <style=cIsUtility>congela</style>. Hostes immunes gelu loco eius <style=cIsUtility>crystallizantur, omnibus facultatibus clausis et motu impedito</style>. <style=cIsUtility>{Pulses} <style=cStack>(+{PulsesPerStack} per acervum)</style></style> vicibus evenit.",
    "ITEM_MYSTICSITEMS_CRYSTALWORLD_LORE": "Mandatum: Exemplar Sphaerae Crystallinae\r\nNumerus Vestigandi: 242*****\r\nPerventio Aestimata: 06/15/2056\r\nModus Mittendi: Summa Necessitas/Fragilis\r\nInscriptio Mittendi: [DETRACTA], Vindobona, Austria, Tellus\r\nNotae Mittendi:\r\n\r\nSpero te bene valere. Magnus admirator operis tui sum. Musica tua... mirabilis, singularis, egregia est. Commotionem sentio quoties unum ex carminibus tuis in catalogo meo canere incipit. Gratias tibi ago quod vitam meam tanto meliorem reddidisti. En indicium gratiae meae - tridimensionalis imago involucri carminis [DETRACTI].\r\n",
    "ITEM_MYSTICSITEMS_DASHERDISC_NAME": "Executio Tempestiva",
    "ITEM_MYSTICSITEMS_DASHERDISC_PICKUP": "Ad vitam humilem invincibilitatem ad breve tempus accipe. Tempore refrigeratur.",
    "ITEM_MYSTICSITEMS_DASHERDISC_DESC": "Si infra <style=cIsHealth>25% vitae</style> decidis, incorporeus efficeris, invincibilitatem per <style=cIsUtility>{Duration} secundis</style> accipiens et celeritatem motus de <style=cIsUtility>{MoveSpeedBuff}%</style> augens. Singulis <style=cIsUtility>{Cooldown}s <style=cStack>(-{CooldownReductionPerStack}% per acervum)</style></style> refrigeratur.",
    "ITEM_MYSTICSITEMS_DASHERDISC_LORE": "Mandatum: Discus Celer\r\nNumerus Vestigandi: 20******\r\nPerventio Aestimata: 10/22/2089\r\nModus Mittendi: Summa Necessitas/Biologicus\r\nInscriptio Mittendi: Discus Gigas, Iuppiter\r\nNotae Mittendi:\r\n\r\nHunc vagantem circa laboratorium nostrum inveni. NOLI CELERES MOTUS IN CONSPECTU EIUS FACERE\r\n",
    "ITEM_MYSTICSITEMS_TREASUREMAP_NAME": "Tabula Thesauri",
    "ITEM_MYSTICSITEMS_TREASUREMAP_PICKUP": "Quisque campus locum thesauri cum obiecto Legendario defosso continet, quod tempore effoditur.",
    "ITEM_MYSTICSITEMS_TREASUREMAP_DESC": "Quisque campus <style=cIsUtility>locum thesauri</style> radii {Radius}m cum defosso <style=cIsHealth>obiecto Legendario</style> continet. Intra locum thesauri per <style=cIsUtility>{UnearthTime}s <style=cStack>(-{ReductionPerStack}% per acervum)</style></style> stare obiectum effodit.",
    "ITEM_MYSTICSITEMS_TREASUREMAP_LORE": "<style=cMono>> OS ONERATUM\r\n> AUTOMATICE EXSEQUENS \"SUMMUMSECRETUM\"\r\n> [||||||||||] 100%\r\n> ADITUS DENEGATUS\r\n> TESSERAM SCRIBE\r\n> ******12\r\n> ADITUS CONCESSUS\r\n> CONDITORIUM THESAURI IN SYSTEMATE STELLARI BORON\r\n> RA 21H 32M 29S | DEC -15° 14' 5\"\r\n> RECALCULARE COORDINATAS RELATIVAS? Y/N\r\n> _</style>",
    "ITEM_MYSTICSITEMS_IDOL_NAME": "Super Idolum",
    "ITEM_MYSTICSITEMS_IDOL_PICKUP": "Vitam et armaturam secundum aurum praesens auge.",
    "ITEM_MYSTICSITEMS_IDOL_DESC": "Vitam usque ad <style=cIsHealth>{HealthBonus}%</style> et armaturam usque ad <style=cIsUtility>{ArmorBonus}</style> auget secundum aurum praesens <style=cIsUtility>(usque ad {GoldCap}$ <style=cStack>(-50% per acervum)</style>, cum tempore crescens)</style>.",
    "ITEM_MYSTICSITEMS_IDOL_LORE": "'Ex auro solido factum, te ditiorem sentis solo eo tenendo.'",
    "ITEM_MYSTICSITEMS_BACKPACK_NAME": "Saccus Viatoris",
    "ITEM_MYSTICSITEMS_BACKPACK_PICKUP": "+{Charges} onus omnibus facultatibus. Saltum additum accipe.",
    "ITEM_MYSTICSITEMS_BACKPACK_DESC": "Adde <style=cIsUtility>+{Charges} onus maximum <style=cStack>(+{ChargesPerStack} per acervum)</style></style> omnibus facultatibus. Tempus refrigerationis facultatum de <style=cIsUtility>{CDR}%</style> minue. <style=cIsUtility>Saltum additum</style> accipe.",
    "ITEM_MYSTICSITEMS_BACKPACK_LORE": "- ...sed nunc, quasi vox mea interior mihi dicat... \"Hoc facere non potes.\"\r\n\r\n- Oh, signum mutationis est, carissima mea.\r\n\r\n- Quid per istud intellegis?\r\n\r\n- Sic modo ad progressum respondemus. Saepe mutationi non assuevimus, et regredi conamur. Id consuetum est, neque de eo sollicitari debes. Noli permittere ut hic sensus te superet, sed neque eum neglexeris.\r\n\r\n- Ergo... Pergo tantummodo?\r\n\r\n- Fac quod tibi optimum esse censes, cara.\r\n\r\n- ... Gratias tibi, Mater.",
    "ITEM_MYSTICSITEMS_VYRAELCOMMANDMENTS_NAME": "Decem Praecepta Vyraelis",
    "ITEM_MYSTICSITEMS_VYRAELCOMMANDMENTS_PICKUP": "Singulis {Hits} ictibus, effectus 'Ictu Feriendi' semel amplius excitare conare.",
    "ITEM_MYSTICSITEMS_VYRAELCOMMANDMENTS_DESC": "Singulis <style=cIsUtility>{Hits}</style> ictibus, effectus tuos <style=cIsDamage>Ictu Feriendi</style> <style=cIsUtility>1 <style=cStack>(+1 per acervum)</style></style> vice amplius excitare conare.",
    "ITEM_MYSTICSITEMS_JUDGEMENTCUT_NAME": "Clamor Diaboli",
    "ITEM_MYSTICSITEMS_JUDGEMENTCUT_PICKUP": "Singulis {CritInterval} Ictibus Criticis seriem caedium emitte.",
    "ITEM_MYSTICSITEMS_JUDGEMENTCUT_DESC": "Probabilitatem Ictus Critici de <style=cIsDamage>{BaseCrit}%</style> auge. Singulis <style=cIsDamage>{CritInterval}</style> Ictibus Criticis, <style=cIsDamage>seriem caedium emitte</style>, <style=cIsDamage>{DamagePerSlash}x{SlashCount}% <style=cStack>(+{DamagePerSlash}x{SlashCountPerStack}% per acervum)</style></style> damni hostibus in radio <style=cIsUtility>{Radius}m <style=cStack>(+{RadiusPerStack}m per acervum)</style></style> inferentem.",
    "ITEM_MYSTICSITEMS_SHIELDUPGRADE_NAME": "Modulus Emendationis Indicatoris",
    "ITEM_MYSTICSITEMS_SHIELDUPGRADE_PICKUP": "Scutum regenerans accipe. Totum scutum tuum duplica. Scuta celerius regenerantur.",
    "ITEM_MYSTICSITEMS_SHIELDUPGRADE_DESC": "<style=cIsHealing>Scutum</style> aequale <style=cIsHealing>{PassiveShield}%</style> vitae tuae maximae accipe. Totum scutum de <style=cIsUtility>{ShieldBonus}% <style=cStack>(+{ShieldBonusPerStack}% per acervum)</style></style> auge. Regeneratio scuti et ceteri effectus extra periculum <style=cIsUtility>{RechargeBoost}% <style=cStack>(+{RechargeBoostPerStack}% per acervum)</style></style> celerius incipiunt.",
    "ITEM_MYSTICSITEMS_RIFTLENS_NAME": "Lentes Rimarum",
    "ITEM_MYSTICSITEMS_RIFTLENS_PICKUP": "Quisque campus rimas cum gratis obiectis continet... <color=#FF7F7F>SED morieris si rimas tempore non clauseris.</color>\n",
    "ITEM_MYSTICSITEMS_RIFTLENS_DESC": "Quisque campus <style=cIsDamage>{BaseRifts} <style=cStack>(+{RiftsPerStack} per acervum)</style></style> rimas cum gratis obiectis continet. Si omnes tempore non clauseris, <style=cDeath>mors</style> sequetur.",
    "ITEM_MYSTICSITEMS_MOONGLASSES_NAME": "Perspicilla Lunaria",
    "ITEM_MYSTICSITEMS_MOONGLASSES_PICKUP": "Damnum Ictus Critici auge... <color=#FF7F7F>SED probabilitatem Ictus Critici dimidia.</color>\n",
    "ITEM_MYSTICSITEMS_MOONGLASSES_DESC": "Damnum Ictus Critici de <style=cIsDamage>{CritDamageIncrease}% <style=cStack>(+{CritDamageIncreasePerStack}% per acervum)</style></style> auge. <style=cIsUtility>Probabilitatem Ictus Critici pro quoque acervo dimidia.</style>",
    "ITEM_MYSTICSITEMS_MOONGLASSES_LORE": "<style=cMono>\r\n========================================\r\n====   MyBabel Machine Translator   ====\r\n====     [Version 12.45.1.009 ]   ======\r\n========================================\r\nTraining... <100000000 cycles>\r\nTraining... <1453461 cycles>\r\nComplete!\nDisplay result? Y/N\r\nY\r\n================================</style>\r\nEgo [Yora] perspicilla do. Yora in futurum videt.\r\n\r\n<He> dabit [Yora] laudem. [Yora] perspicilla deponit. [Yora] commotionem sentit et duplo acrius laborat.\r\n\r\nEgo robur lentium amplifico. [Yora] ulterius in futurum spectat.\r\n\r\n[Yora] celeriter perspicilla deponit. Commotio [Yora] extinguitur.\r\n\r\n<He> in cubiculum ingreditur. [Yora] metum sentit.\r\n\r\nEgo longe in futurum prospicio. Celeriter perspicilla depono. <He> praesens est. Metum sentio.\r\n<style=cMono>\r\n================================\r\n</style>",
    "ITEM_MYSTICSITEMS_REGENANDDIFFICULTYSPEED_NAME": "Aenigma Chroni",
    "ITEM_MYSTICSITEMS_REGENANDDIFFICULTYSPEED_PICKUP": "Regenerationem vitae omnibus sociis accelera... <color=#FF7F7F>SED incrementum difficultatis accelera.</color>\n",
    "ITEM_MYSTICSITEMS_REGENANDDIFFICULTYSPEED_DESC": "<style=cIsHealing>Regenerationem vitae basilarem de {BaseRegenIncrease} HP/s <style=cStack>(+{BaseRegenIncreasePerStack} HP/s per acervum, +20% per gradum)</style></style> omnibus sociis auge. Incrementum difficultatis cum tempore <style=cIsUtility>{TimerSpeedIncrease}% <style=cStack>(+{TimerSpeedIncreasePerStack}% per acervum)</style></style> velocius est.",
    "EQUIPMENT_MYSTICSITEMS_ARCHAICMASK_NAME": "Persona Legendaris",
    "EQUIPMENT_MYSTICSITEMS_ARCHAICMASK_PICKUP": "Igniculum Archaicum conscribe. Per {Duration} secunda durat.",
    "EQUIPMENT_MYSTICSITEMS_ARCHAICMASK_DESC": "<style=cIsDamage>Igniculum Archaicum</style> cum <style=cIsDamage>{WispDamage}% damni</style>, <style=cIsHealing>{WispHealth}% vitae</style>, <style=cIsUtility>{WispCDR}% deminutionis refrigerationis</style> et <style=cIsDamage>{WispAttackSpeed}% celeritatis impetus</style> conscribe. Per {Duration} secunda durat.",
    "EQUIPMENT_MYSTICSITEMS_ARCHAICMASK_LORE": "<style=cMono>\r\nAudio-transcriptio perfecta e machinula notatoria portabili.</style>\r\n\r\nPersona adhuc fervens ardet, sed reliquum corpus iam refrigeratum est. Tenetne vitam suam?\r\n\r\nPossumne... 'resuscitare' igniculum igne huic larvae adhibito? Hoc grave erratum sit, sed unica mea facultas est socium adipiscendi.\r\n\r\nNon est tempus rogandi. Tempus est experiendi...\r\n\r\n[Ignes erumpunt]\r\n\r\n<style=cMono>Finis transcriptionis petitae.</style>\r\n",
    "EQUIPMENT_MYSTICSITEMS_PRINTERHACKER_NAME": "Clavis Interceptoris",
    "EQUIPMENT_MYSTICSITEMS_PRINTERHACKER_PICKUP": "{Amount} exemplar(ia) obiecti Typographi 3D gratis accipe, deinde typographum destrue.",
    "EQUIPMENT_MYSTICSITEMS_PRINTERHACKER_DESC": "<style=cIsUtility>{Amount}</style> exemplar(ia) obiecti Typographi 3D <style=cIsUtility>gratis</style> accipe, deinde typographum <style=cIsDamage>destrue</style>, eum perpetuo inutilem reddens.",
    "EQUIPMENT_MYSTICSITEMS_PRINTERHACKER_LORE": "\"...perfecta exemplificatio aequalis servatur includendo unum vel plura exemplaria praeimpressa obiecti originalis profunde intra modulum lectorium. Quo plura, eo melius.\"\r\n\r\n- E sermone praesentationis Typographi 3D MassDuplix",
    "EQUIPMENT_MYSTICSITEMS_MICROPHONE_NAME": "Microphonum Antiquum",
    "EQUIPMENT_MYSTICSITEMS_MICROPHONE_PICKUP": "Hostes ante te obtura, eorum attributa valde minuens. In aere adhibe ut te retrorsum impellas.",
    "EQUIPMENT_MYSTICSITEMS_MICROPHONE_DESC": "Hostes ante te per <style=cIsUtility>{Duration} secunda</style> <style=cIsDamage>obtura</style>, eorum celeritatem motus de <style=cIsUtility>{MoveSpeedReduction}%</style>, armaturam de <style=cIsUtility>{ArmorReduction}</style>, celeritatem impetus de <style=cIsDamage>{AttackSpeedReduction}%</style> et damnum de <style=cIsDamage>{DamageReduction}%</style> minuens. In aere adhibitum te in partem oppositam <style=cIsUtility>impelle</style>.",
    "EQUIPMENT_MYSTICSITEMS_MICROPHONE_LORE": "- Cur adhuc hoc facis?\r\n\r\n- Quid facio?\r\n\r\n- Scis, omnem hanc... concentuum... vivorum... rem.\r\n\r\n- Oh, num tibi concentus vivi non placent, Jimmy? Cur non antea mihi dixisti?\r\n\r\n- Minime, minime, AMO eos! Re vera amo. Tantummodo non intellego cur eos non virtualiter facias. Carmina tua tam bona sunt. Certus sum te in scaena virtuali valde gratum fore!\r\n\r\n- O-ho-ho-ho! Verba tua blanda sunt, mi iuvenis amice! Se-e-ed, minime, non gloriae causa hoc facio. Hoc facio quia id feci per maiorem partem vitae meae. Et ad concentus realitatis virtualis transire nimia mutatio est veteri sacco ut ego. He-he. \"In praeterito haerens\", aliquis dicere posset.\r\n\r\n- ...Intellego. Sed... VERE non vis aliquid novi mutationis causa experiri? Unum concentum VR facere, vel ad contumaciam tuam pervicacem provocandam? Ut illi anui demonstres te CAPACEM esse mutationis? Ut ei ostendas quis sit dominus? Modo dic \"ita\"! Te adiuvabo ad omnia paranda!\r\n\r\n- Hmm... Scisne... Fortasse recte dicis. Ita! Hoc faciamus! Agamus!\r\n\r\n- Vere?!\r\n\r\n- Ha-ha-ha, MINIME hercle! Iocabar tantum!\r\n",
    "EQUIPMENT_MYSTICSITEMS_SIRENPOLE_NAME": "Systema Monitionis",
    "EQUIPMENT_MYSTICSITEMS_SIRENPOLE_PICKUP": "Palum Sirenae dispone qui effectus obiecti Portalis excitat.",
    "EQUIPMENT_MYSTICSITEMS_SIRENPOLE_DESC": "Palum Sirenae automatice onerantem dispone qui <style=cIsUtility>ut Portale fungitur, omnes effectus Eventus Portalis excitans</style>, atque hostes debiles singulis {WaveSpawnInterval}% oneris vocat. <style=cIsUtility>{ChargeTime}s</style> ad onerandum capit.\r\n\r\nAdhiberi non potest si Palus Sirenae nondum oneratus iam exstat.",
    "EQUIPMENT_MYSTICSITEMS_SIRENPOLE_LORE": "\"Nauarche!\" - miles clamavit summis faucibus.\r\n\r\nNauarchus, non avertens vultum suum attonitum a sirena quae mirum in modum nullum sonum audibilem edebat licet accensa esset, placide respondit: \"Hem?\"\r\n\r\n\"Aspice!\" - miles etiam clarius clamavit et digitum ad formam ingentem eminente in spatio intendit.\r\n\r\nNauarchus se convertit, vidit quod videbatur mons verus ad vitam venisse, et magnum emisit \"O [DETRACTUM]!\"",
    "EQUIPMENT_MYSTICSITEMS_MECHANICALARM_NAME": "Bracchium Mechanicum",
    "EQUIPMENT_MYSTICSITEMS_MECHANICALARM_PICKUP": "Ante te vibra, plus damni inferens pro quoque Ictu Critico inlato dum apparatus refrigeratur.",
    "EQUIPMENT_MYSTICSITEMS_MECHANICALARM_DESC": "Probabilitas Ictus Critici de <style=cIsDamage>{BaseCrit}%</style> augetur dum hunc apparatum fers.\r\n\r\nAnte te vibra pro <style=cIsDamage>{Damage}% damni + {DamageBonusPerCharge}% damni pro quoque Ictu Critico inlato dum apparatus refrigeratur</style>.",
    "EQUIPMENT_MYSTICSITEMS_MECHANICALARM_LORE": "Petitio Repensationis UES #793045\r\n\r\nRepensatio: 701***** Tesserae Ludi Habitús Roboti - 4.000 Nummi\r\nSumma: 3.600 Nummi in crumenam tuam refundentur\r\n\r\nCausa: Sarcina mea non est tradita\r\nNotae:\r\nBracchia desunt. Scire etiam velim cur non responderitis duabus petitionibus repensationis prioribus huius traditionis quae abhinc 3 et 6 annos respective scriptae sunt.",
    "EQUIPMENT_MYSTICSITEMS_OMARHACKTOOL_NAME": "Ab Omar Cum Amore",
    "EQUIPMENT_MYSTICSITEMS_OMARHACKTOOL_PICKUP": "Arcam vel aediculam intercipe ut gratuita fiat. Semel per campum.",
    "EQUIPMENT_MYSTICSITEMS_OMARHACKTOOL_DESC": "Arcam vel aediculam intercipe ut pretium eius ad <style=cIsUtility>$0</style> minuatur. Ad <style=cIsUtility>1</style> usum per campum finitur, <style=cIsUtility>limes cum oneribus apparatuum additis augetur</style>.",
    "EQUIPMENT_MYSTICSITEMS_OMARHACKTOOL_LORE": "<style=cMono>IN CRYPTOGRAMMA VERTENS..\r\nINITIUM NUNTII</style>\r\n\r\n\"Heus fili.\r\n\r\nQuomodo te habes? Spero omnia bene esse. Patrem tuum in Titane collocaverunt, videtur me aliquanto diutius afuturum esse. Quapropter sarcinam illam matri tuae misi. Res maximi momenti in ea sunt pro tota familia dum absum. Valde doleo quod nuntius de clave a vobis amissa huc pervenit. Res est quod non solum tesseram habet quam epistula mittere possim et finis sit, est... Magis complicata.. Quam ob rem patri tuo hoc instrumentum quod tibi misi conficiendum fuit. Memento! Semper id secretum serva! Nemini alii de hac re confido, ne matri quidem tuae. Hoc instrumentum est scriptor arcanus, seram cryptam aperire potest. Aliquantum spatii relinquere debui, itaque una cista fortasse totum accumulatrum exhauriet. Ceterum, hoc uti potes ad sarcinam aperiendam quam tibi misi.\r\n\r\nPater vos omnes amat et mox domum veniam. 36 amplius dies.\r\nDic matri tuae me eius desiderio teneri.\"\r\n\r\n<style=cMono>FINIS NUNTII</style>",
    "EQUIPMENT_MYSTICSITEMS_EQUIPMENTEATER_NAME": "Regurgitator",
    "EQUIPMENT_MYSTICSITEMS_EQUIPMENTEATER_PICKUP": "Apparatum pete ut eum in Fragmenta Obiectorum dissolvas.",
    "EQUIPMENT_MYSTICSITEMS_EQUIPMENTEATER_DESC": "Apparatum pete ut eum in <style=cIsUtility>{Amount}</style> partes Fragmentorum Obiectorum <style=cIsUtility>dissolvas</style> ({WhiteChance}%/<style=cIsHealing>{GreenChance}%</style>/<style=cIsHealth>{RedChance}%</style>/<style=cShrine>{YellowChance}%</style>).",
    "EQUIPMENT_MYSTICSITEMS_TUNINGFORK_NAME": "Aequator Rationis",
    "EQUIPMENT_MYSTICSITEMS_TUNINGFORK_PICKUP": "Vitam centesimam <color=#FF7F7F>OMNIUM personarum propinquarum</color> ad vitam centesimam <color=#FF7F7F>tuam</color> constitue.",
    "EQUIPMENT_MYSTICSITEMS_TUNINGFORK_DESC": "Vitam centesimam omnium personarum in radio {Radius}m ad <style=cIsUtility>vitam centesimam tuam</style> constitue.",
    "EQUIPMENT_MYSTICSITEMS_TUNINGFORK_LORE": "Frater, tua visio creatrix quidem est animosa, tamen te creare sine meo conspectu permittere non possum.\r\n\r\nCuriositas tua te incitavit ad novam compositionem creandam. Qualitas eius et proprietates rationibus compositi componentium determinantur. Quo magis rationes aberrant, eo magis compositum eveniens volatile est, eo minus formam servat.\r\n\r\nVideo creationem tuam constare ex... Abundantia uniuscuiusque elementi basici. Nullam formam habet, nec ad creandum adhiberi potest. Unicus eius finis bellum est.\r\n\r\n... \"Chaos?\"",
    "EQUIPMENT_MYSTICSITEMS_GATECHALICE_NAME": "Calix Portae",
    "EQUIPMENT_MYSTICSITEMS_GATECHALICE_PICKUP": "Confestim ad proximum campum te teleporta. Tempus servabis, <color=#FF7F7F>SED obiecta ex arcis non apertis amittes.</color>",
    "EQUIPMENT_MYSTICSITEMS_GATECHALICE_DESC": "Ad proximum campum teleportat. Ad tempus servandum adhiberi potest, <style=cIsUtility>sed periculum subit ne infirmus fias campis praetermissis cum arcis non apertis</style>.",
    "EQUIPMENT_MYSTICSITEMS_GATECHALICE_LORE": "Minime, his machinis non indigemus, frater. Celeres sumus. Tempus habemus. Nullus finis est has machinulas creandi quas \"portas\" appellavisti.\r\n\r\n... non pro nobis? Hmm... \"Pro eis\"?\r\n\r\n... dissimiles nobis. Ita. Ita, arbitror te... rectum esse. Bene. Portas construemus.",
    "EQUIPMENT_MYSTICSITEMS_FRAGILEMASK_NAME": "Persona Fragilis",
    "EQUIPMENT_MYSTICSITEMS_FRAGILEMASK_PICKUP": "Adhibe ad commutandum. Dum activa est, damnum {DamageMultiplier}x maius est, <color=#FF7F7F>SED quovis damno morieris</color>.",
    "EQUIPMENT_MYSTICSITEMS_FRAGILEMASK_DESC": "Adhibe ad commutandum. Dum activa est, <style=cIsDamage>damnum basale de {BaseDamageBonus}% augetur</style> et <style=cDeath>quodvis damnum te necat</style>.",
    "EQUIPMENT_MYSTICSITEMS_FRAGILEMASK_LORE": "\"Persona saxea creditur potestate runica a priscis maleficis Titanis ante multa milia annorum imbuta esse, in loco excavationis archaeologicae vici Rimm reperta. Tales larvae in variis historiis praeteriti descriptae sunt: fabulae ferunt eas bellatoribus in proelio opitulatas esse, et res praecipua est in historia Proctoris Audacis, qui magnam potestatem ad populum suum tuendum quaesivit, sed grave erratum fecit personam devotam e sepulcro vetito capiendo.\"\r\n\r\n- Ostensio in Museo Titanis Historiae et Cultus",
    "ACHIEVEMENT_MYSTICSITEMS_ESCAPEMOONALONE_NAME": "Ultimus Nostrum",
    "ACHIEVEMENT_MYSTICSITEMS_ESCAPEMOONALONE_DESCRIPTION": "Ictum letalem duci finali infer ut solus socius superstes in turma tua.",
    "ACHIEVEMENT_MYSTICSITEMS_REPAIRBROKENSPOTTER_NAME": "Hostis Visus",
    "ACHIEVEMENT_MYSTICSITEMS_REPAIRBROKENSPOTTER_DESCRIPTION": "Modulum Alimentarium Capsulae Effugii ad silvam humidam radicibus plenam affer et Fucum Exploratorem Fractum refice.",
    "ACHIEVEMENT_MYSTICSITEMS_FINDARCHAICMASK_NAME": "Ure Ut Occidas",
    "ACHIEVEMENT_MYSTICSITEMS_FINDARCHAICMASK_DESCRIPTION": "Personam Legendariam in Iugeribus Ustis intra minus quam 10 minuta cape antequam refrigescant.",
    "ACHIEVEMENT_MYSTICSITEMS_MULTISHOPTERMINALSONLY_NAME": "Emptor Prudens",
    "ACHIEVEMENT_MYSTICSITEMS_MULTISHOPTERMINALSONLY_DESCRIPTION": "Nusquam aurum nisi ad Terminalia Multitabernaria impende usque ad campum 6. Perfici non potest dum Artefactum Sacrificii activum est.",
    "ACHIEVEMENT_MYSTICSITEMS_HELLSPEEDRUN_NAME": "Vince Calorem",
    "ACHIEVEMENT_MYSTICSITEMS_HELLSPEEDRUN_DESCRIPTION": "Profunditates Abyssi intra minus quam 3 minuta perfice.",
    "ACHIEVEMENT_MYSTICSITEMS_REACHHIGHPOINT_NAME": "Fastigium",
    "ACHIEVEMENT_MYSTICSITEMS_REACHHIGHPOINT_DESCRIPTION": "Altissimum locum Puncti Congressionis Delta attinge.",
    "ACHIEVEMENT_MYSTICSITEMS_BLOCKDAMAGEWITHARMOR_NAME": "'Non Nisi Rasura Est'",
    "ACHIEVEMENT_MYSTICSITEMS_BLOCKDAMAGEWITHARMOR_DESCRIPTION": "Effectibus damnum minuentibus utens, 10.000 damni in universum minue.",
    "ACHIEVEMENT_MYSTICSITEMS_MANYALLIES_NAME": "Tot Admiratores!",
    "ACHIEVEMENT_MYSTICSITEMS_MANYALLIES_DESCRIPTION": "10 socios non mechanicos nec lusores collige.",
    "ACHIEVEMENT_MYSTICSITEMS_HACKLEGENDARYCHEST_NAME": "Piratae Maris Carisquei",
    "ACHIEVEMENT_MYSTICSITEMS_HACKLEGENDARYCHEST_DESCRIPTION": "Arcam Legendariam gratis aperi.",
    "ACHIEVEMENT_MYSTICSITEMS_WOOLIERUSH_NAME": "Tene Rhythmum",
    "ACHIEVEMENT_MYSTICSITEMS_WOOLIERUSH_DESCRIPTION": "Ad campum finalem perveni sine plus quam 5 minuta in quovis campo consumendo.",
    "ACHIEVEMENT_MYSTICSITEMS_FREEZELOCKENEMY_NAME": "Refrigera!",
    "ACHIEVEMENT_MYSTICSITEMS_FREEZELOCKENEMY_DESCRIPTION": "Hostem congelatum per 7 secunda contine.",
