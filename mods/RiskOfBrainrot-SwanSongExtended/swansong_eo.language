    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_NAME": "Tordita Rigardo",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_PICKUP": "Fariĝu aspekto de ventego.",
    "BORBO_ELITE_AFFIX_SQUALL_MODIFIER": "Hurlanta {0}",
    "ARTIFACT_AWESOMEPOT_NAME": "Artefakto de Volatileco",
    "ARTIFACT_AWESOMEPOT_DESCRIPTION": "Eksplodemaj bareloj kaj potoj estas Elitaj.",
    "ARTIFACT_FREELUNAR_NAME": "Artefakto de la Zeloto",
    "ARTIFACT_FREELUNAR_DESCRIPTION": "Komencu ĉiun kuron kun hazarda luna objekto. Fine de ĉiu etapo, blua portalo ĉiam aperas.",
    "ARTIFACT_QUICKSTART_NAME": "Artefakto de la Mortnaskito",
    "ARTIFACT_QUICKSTART_DESCRIPTION": "Komencu vian kuron kun Nekutima objekto laŭ via elekto.",
    "ARTIFACT_RISKIERRAINSPIRIT_NAME": "Artefakto de Spirito",
    "ARTIFACT_RISKIERRAINSPIRIT_DESCRIPTION": "Roluloj kuras kaj atakas pli rapide ĉe pli malalta sano.",
    "ITEM_BARRIERONOVERHEAL_NAME": "Egido",
    "ITEM_BARRIERONOVERHEAL_PICKUP": "Akiru barilon ĉe iu ajn interago. Ekster danĝero, barilo ĉesas kadukiĝi.",
    "ITEM_BARRIERONOVERHEAL_DESC": "Uzi iun ajn interageblan objekton donas <style=cIsHealing>portempan barilon</style> por <style=cIsHealing>40.0 sano</style> <style=cStack>(+40.0 por stako)</style> plus aldonajn <style=cIsHealing>10.0%</style> de <style=cIsHealing>maksimuma sano</style>. Ekster danĝero, <style=cIsUtility>barilo ne kadukiĝos</style>.",
    "ITEM_GOLDONHIT_NAME": "Subakvigita Krono",
    "ITEM_GOLDONHIT_PICKUP": "Ŝtelu el kestoj... <style=cIsHealth>je la kosto de sano.</style>",
    "ITEM_GOLDONHIT_DESC": "Permesas interagi kun kestoj sen la kapablo pagi ilin, malfermante la keston <style=cIsUtility>sen elspezi IAN AJN monon</style>. Ŝteli el kestoj kostas <style=cIsHealth>[ 25% / 50% / 80% ]</style> de via <style=cIsHealth>maksimuma sano</style>, depende de la grandeco de la kesto. Povas ŝteli ĝis 1 <style=cStack>(+1 por stako)</style> fojojn por etapo.",
    "ITEM_REGENERATINGSCRAP_NAME": "Ĥimera Rubo",
    "ITEM_REGENERATINGSCRAP_PICKUP": "Prioritata kiam uzata kun <style=cIsHealth>IU AJN</style> 3D-Printilo. Produktas ekstrajn objektojn de pli malaltaj niveloj.",
    "ITEM_REGENERATINGSCRAP_DESC": "Faras nenion. Prioritata kiam uzata kun <style=cIsHealth>IU AJN</style> 3D-Printilo. Kreas <style=cStack>(</style> 10 <style=cStack>/</style> <style=cIsHealing>5</style> <style=cStack>/</style> <style=cIsHealth>2</style> <style=cStack>)</style> objektojn, <style=cIsUtility>depende de la kvalito de la printilo</style>.",
    "ITEM_GOLDONHURT_NAME": "Ĉokoladaj Moneroj",
    "ITEM_GOLDONHURT_PICKUP": "Malamikoj faligas frandaĵon por oro kaj resanigo. Reŝargiĝas kun la tempo.",
    "ITEM_GOLDONHURT_DESC": "Ĉe trafo, faligu ĉokoladan moneron kiu resanigas je <style=cIsHealing>5.0 sano</style> <style=cStack>(+5.0 por stako)</style> plus <style=cIsUtility>1 oro</style> <style=cStack>(+1 por stako)</style>. <style=cIsUtility>Skalas kun la tempo</style>. <style=cIsUtility>Reŝargiĝas post 5.0 sekundoj.</style>",
    "ITEM_CRITDAMAGE_NAME": "Batala Teleskopo",
    "ITEM_CRITDAMAGE_PICKUP": "Pliigas 'Kritikan Trafon' ŝancon kaj damaĝon dum senmova.",
    "ITEM_CRITDAMAGE_DESC": "<style=cIsDamage>Kritikaj Trafoj</style> kaŭzas aldonan <style=cIsDamage>100% damaĝon</style> <style=cStack>(+100% por stako)</style>. Akiru <style=cIsDamage>30% Kritikan Trafŝancon</style> post stari senmove dum <style=cIsUtility>0.2</style> sekundoj.",
    "ITEM_REPEATHEAL_NAME": "Kadavrofloro",
    "ITEM_REPEATHEAL_PICKUP": "Via sano degeneras kun la tempo. Akiru barilon kaj bonŝancon ĉe malalta sano.",
    "ITEM_REPEATHEAL_DESC": "Por ĉiuj mankantaj 12.5% de sano, akiru Putron. Post kiam 3 Putro akumuliĝis, pliigu bazan damaĝon je 4 <style=cStack>(+2 por stako)</style>. Post 6 Putro, akiru 50% barilon kaj pliigu Bonŝancon je 2 <style=cStack>(+2 por stako)</style>. <style=cIsHealth>Reduktas bazan sanregeneradon je -2 sano/s</style> <style=cStack>(-2 por stako)</style>.",
    "ITEM_HEALINGPOTION_NAME": "Bierserka Bieraĵo",
    "ITEM_HEALINGPOTION_PICKUP": "Ĉe malalta sano, akiru barilon, purigu malfortigojn kaj rekomencigu ĉiujn malvarmigajn tempojn. Uzebla unufoje por etapo.",
    "ITEM_HEALINGPOTION_DESC": "Ricevi damaĝon sub <style=cIsHealth>25% sano</style> <style=cIsUtility>konsumas</style> ĉi tiun objekton, tuj donante <style=cIsHealing>35%</style> de maksimuma sano en <style=cIsHealing>barilo</style> kaj <style=cIsUtility>rekomencigante</style> ĉiujn malvarmigajn tempojn. Ĉiu malplena botelo pliigas atakrapidon je <style=cIsDamage>15%</style>, movrapidon je <style=cIsDamage>14%</style>, kaj reduktas malvarmigajn tempojn je <style=cIsDamage>6%</style>. Regeneriĝas komence de ĉiu etapo.",
    "EQUIPMENT_MULTISHOPCARD_NAME": "Estrara Karto",
    "EQUIPMENT_MULTISHOPCARD_PICKUP": "Kodrompu celitan interageblan objekton. Kodrompitaj Multbutikoj restas malfermitaj.",
    "EQUIPMENT_MULTISHOPCARD_DESC": "Celu interageblan objekton por <style=cIsUtility>kodrompi</style> ĝin, malŝlosante ĝian enhavon <style=cIsUtility>senpage</style>. Se la celo estas <style=cIsUtility>multbutika</style> terminalo, la aliaj terminaloj <style=cIsUtility>restos malfermitaj</style>.",
    "ITEM_AUTOCASTEQUIPMENT_NAME": "Gesto de la Droninto",
    "ITEM_AUTOCASTEQUIPMENT_PICKUP": "Grandige pliigas ekipaĵan stokon... <style=cIsHealth>SED grandige pliigas ekipaĵan malvarmigan tempon.</style> Ekipaĵoj povas esti aktivigitaj dum sia malvarmiga tempo, <style=cIsHealth>kun ŝanco rompiĝi.</style>",
    "ITEM_AUTOCASTEQUIPMENT_DESC": "Tenu <style=cIsUtility>4 aldonajn ekipaĵajn ŝargojn</style> <style=cStack>(+2 por stako)</style>... <style=cIsHealth>SED pliigas ekipaĵan malvarmigan tempon je +100%</style> <style=cStack>(+50% por stako)</style>. Uzi vian ekipaĵon sen ŝargoj <style=cIsUtility>sub-ĵetas</style> ĝin, permesante uzi ĝin <style=cIsHealth>kun 40.0% ŝanco rompiĝi</style>. <style=cIsUtility>Netuŝita de bonŝanco.</style>",
    "ITEM_BONUSGOLDPACKONKILL_NAME": "Tomo de Ghor",
    "ITEM_BONUSGOLDPACKONKILL_PICKUP": "Transmutacias elitojn en oron ĉe kontakto.",
    "ITEM_BONUSGOLDPACKONKILL_DESC": "Kaŭzas +100% damaĝon al Orumitaj elitoj. Kontakti iun ajn Elitan malamikon tuj transmutacias ĝin en Orumitan eliton, aktivigante ĉiujn ĉe-mortigajn efikojn. Ne influas Estrajn malamikojn.",
    "ITEM_SEED_NAME": "Hiruda Semo",
    "ITEM_FLATHEALTH_NAME": "Freŝa Viando",
    "ITEM_FLATHEALTH_PICKUP": "Akiru platan sanon. Regeneru sanon post mortigo de malamiko.",
    "ITEM_FLATHEALTH_DESC": "Akiru 25<style=cStack>(+25 por stako)</style> sanon. Pliigas <style=cIsHealing>bazan sanregeneradon</style> je <style=cIsHealing>+2 sano/s</style> dum <style=cIsUtility>3s</style> <style=cStack>(+3s por stako)</style> post mortigo de malamiko.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_NAME": "Matena Moka",
    "ITEM_ATTACKSPEEDANDMOVESPEED_PICKUP": "Akiru portempan rapidpliiĝon post komenco de etapo.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_DESC": "Dum <style=cIsUtility>80</style> sekundoj post eniro en iun ajn etapon, pliigu <style=cIsDamage>atak-</style> kaj <style=cIsDamage>movrapidon</style> je <style=cIsDamage>20%</style> <style=cStack>(+20% por stako)</style>, kaj reduktu <style=cIsUtility>kapablajn malvarmigajn tempojn</style> je <style=cIsUtility>-12%</style> <style=cStack>(-12% por stako)</style>. Aktivigi interageblan objekton plilongigas la plifortigon je <style=cIsUtility>20 sekundoj</style>.",
    "ITEM_EXTRASTATSONLEVELUP_NAME": "Preĝperloj",
    "ITEM_EXTRASTATSONLEVELUP_PICKUP": "Prioritata kiam uzata kun <style=cIsHealing>Nekutimaj</style> 3D-Printiloj. Konstante pliigas ĈIUJN statistikojn post forigo.",
    "ITEM_EXTRASTATSONLEVELUP_DESC": "Prioritata kiam uzata kun <style=cIsHealing>Nekutimaj</style> 3D-Printiloj. Post forigo, konstante donas 7% pliiĝon al <style=cIsUtility>spertogajno</style>, <style=cIsHealing>sano</style>, <style=cIsHealing>ŝildo</style>, <style=cIsHealing>regenerado</style>, kaj <style=cIsDamage>damaĝo</style>.",
    "ITEM_THORNS_NAME": "Razildrato",
    "ITEM_THORNS_PICKUP": "Repagas per eksplodo de sangantaj raziloj ĉe damaĝricevo. Reŝargiĝas kun la tempo.",
    "ITEM_THORNS_DESC": "Esti trafita kaŭzas ke vi eksplodas en pluvo de raziloj, <style=cIsDamage>sangigante</style> ĝis <style=cIsDamage>5.0</style> <style=cStack>(+2.0 por stako)</style> proksimajn malamikojn por <style=cIsDamage>400%</style> baza damaĝo por <style=cIsDamage>razilŝargo</style> elpelita. Vi povas teni ĝis 2 <style=cStack>(+1 por stako)</style> razilŝargojn, ĉiuj reŝargiĝantaj dum <style=cIsUtility>5.0</style> sekundoj.",
    "ITEM_INCREASEHEALING_NAME": "Rejuniga Rako",
    "ITEM_INCREASEHEALING_PICKUP": "Stokas troresanigon por poste.",
    "ITEM_INCREASEHEALING_DESC": "Resanigo preter plena <style=cIsHealing>stokos la troon</style> en <style=cIsHealing>resaniga rezervo</style> je <style=cIsHealing>50%</style> <style=cStack>(+50% por stako)</style> efikeco, ĝis <style=cIsHealing>30%</style> <style=cStack>(+0% por stako)</style> de via maksimuma sano. Kiam vundita, resaniĝu je <style=cIsHealing>10%</style> de via <style=cIsHealing>sano sekunde</style>, ĉerpante el la <style=cIsHealing>resaniga rezervo</style> ĝis ĝi estas malplena.",
    "ITEM_LASERTURBINE_NAME": "Resonanca Disko",
    "ITEM_LASERTURBINE_PICKUP": "Akiru Resonancan Diskon ŝargitan per mortigo de malamikoj. Pafas aŭtomate kiam plene ŝargita.",
    "ITEM_LASERTURBINE_DESC": "Mortigi malamikojn ŝargas la Resonancan Diskon. La disko lanĉas sin al celo por <style=cIsDamage>300%</style> baza damaĝo <style=cStack>(+300% por stako)</style>, traborante ĉiujn malamikojn kiujn ĝi ne mortigas, kaj poste eksplodas por <style=cIsDamage>1000%</style> baza damaĝo <style=cStack>(+1000% por stako)</style>. Poste revenas al la uzanto, trafante ĉiujn malamikojn survoje por <style=cIsDamage>300%</style> baza damaĝo <style=cStack>(+300% por stako)</style>.",
    "ITEM_SQUIDTURRET_NAME": "Kalmar-Polipo",
    "ITEM_PARENTEGG_NAME": "Planulo",
    "ITEM_PARENTEGG_PICKUP": "LA NESUPERITA POTENCO DE LA SUNO!",
    "ITEM_PARENTEGG_DESC": "Post komenco de la teleportila evento, <style=cIsDamage>alvoku sunon superkape</style> kiu daŭras <style=cIsDamage>10.0</style> sekundojn <style=cStack>(+5.0 por stako)</style>. <style=cIsHealth>Ĉiuj malamikoj kaj aliancanoj brulas proksime al la suno</style>.",
    "ITEM_FOCUSEDCONVERGENCE_NAME": "Fokusita Konverĝo",
    "ITEM_FOCUSEDCONVERGENCE_DESC": "Tenadzonoj ŝargas <style=cIsUtility>100% <style=cStack>(+100% por stako)</style> pli rapide</style>, sed estas <style=cIsHealth>50% pli malgrandaj</style> <style=cStack>(-50% por stako)</style>. Maks. de 5.",
    "ITEM_GHOSTONKILL_NAME": "Plej Feliĉa Masko",
    "ITEM_GHOSTONKILL_PICKUP": "Hantu proksimajn malamikojn, markante ilin por ekzekuto. Ekzekuti malamikojn alvokas fantomon.",
    "ITEM_GHOSTONKILL_DESC": "<style=cIsDamage>Hantu</style> hazardan ne-estran malamikon, markante ilin por Ekzekuto sub <style=cIsHealth>25%</style> sano. Ekzekuto <style=cIsDamage>aperigas fantomon</style> de la mortigita malamiko kun <style=cIsDamage>1500%</style> damaĝo, daŭranta <style=cIsDamage>6.66s</style> <style=cStack>(+6.66s por stako)</style> <style=cIsUtility>(duoble por Hantitaj malamikoj)</style>.",
    "ITEM_MOVESPEEDONKILL_NAME": "Harpuno de Ĉasisto",
    "ITEM_MOVESPEEDONKILL_DESC": "Mortigi malamikon pliigas <style=cIsUtility>movrapidon</style> je <style=cIsUtility>125%</style> dum <style=cIsUtility>1</style> <style=cStack>(+1 por stako)</style> sekundoj. Sinsekvaj mortigoj pliigas plifortigan daŭron ĝis 25 sekundoj.",
    "ITEM_STRENGTHENBURN_PICKUP": "Viaj ekbruligaj efikoj kaŭzas trioblan damaĝon.",
    "ITEM_STRENGTHENBURN_DESC": "Akiru <style=cIsDamage>15% ekbruligan ŝancon</style>. Ĉiuj ekbruligaj efikoj kaŭzas <style=cIsDamage>+200%</style> <style=cStack>(+200% por stako)</style> pli da damaĝo kaj daŭras <style=cIsUtility>+200%</style> <style=cStack>(+200% por stako)</style> pli longe.",
    "DIFFICULTYSWANSONG_NAME": "Formorto",
    "DIFFICULTYSWANSONG_DESC": "Nur por la deciditaj kaj vere mazoĥismaj.\nLa planedo vivas kaj tordiĝas pro nedirebla malamo al tio kio estis farita al ĝi. Vi, la objekto de ĝia furiozo, estos disŝirita kaj farita nerekonebla. <style=cStack>\n\n>Ludanta Sanregenerado: <style=cArtifact>-40%</style></style> <style=cStack>\n>Malfacileca Skalado: <style=cArtifact>+100%</style><style=cStack>\n>Komenca Malfacileco: <style=cArtifact>Tre Malfacila</style></style>\n>Maloftaj Elitoj: <style=cArtifact>Etapo 4</style>\n>Teleportilaj Bildoj: <style=cArtifact>MALŜALTITA</style>\n>Malamikoj akiras <style=cArtifact>plifortigitan skaladon</style>\n>Malamikoj akiras <style=cArtifact>triobligitajn pafaĵojn</style></style>",
    "EXPANSION2R4R_NAME": "Swan Song",
