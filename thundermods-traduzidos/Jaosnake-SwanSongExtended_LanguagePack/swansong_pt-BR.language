    "ITEM_BORBOBAKEDBEANS_NAME": "Os Feijões da Tragédia",
    "ITEM_BORBOBAKEDBEANS_PICKUP": "Cura instantaneamente ao abater. Abates rápidos curam mais.",
    "ITEM_BORBOBAKEDBEANS_DESCRIPTION": "Ao abater, <style=cIsHealing>cura 8 de vida</style> <style=cStack>(+4 por acúmulo)</style>. Também concede um <style=cIsUtility>efeito temporário</style> que aumenta essa cura em <style=cIsHealing>12 por efeito</style> <style=cStack>(+6 por acúmulo)</style>, até um máximo de <style=cIsUtility>4 vezes.</style>",
    "ITEM_BORBOBAKEDBEANS_LORE": "Não há nada dentro.",
    "ITEM_CHEFITEM_NAME": "Bigode de Chef",
    "ITEM_CHEFITEM_PICKUP": "Inimigos em chamas derrubam pedaços de carne curativa.",
    "ITEM_CHEFITEM_DESCRIPTION": "Concede <style=cIsDamage>25% de chance de incendiar</style>. Atingir inimigos em chamas tem <style=cIsDamage>1%</style> de chance <style=cStack>(+1% por acúmulo)</style> de criar 2 <style=cIsHealing>nuggets curativos</style> que restauram <style=cIsHealing>25.0 de vida</style>. A chance de nugget aumenta <style=cIsDamage>por acúmulo de queimadura</style>, até <style=cIsDamage>10</style> vezes.",
    "ITEM_BORBOFUSE_NAME": "Fusível Volátil",
    "ITEM_BORBOFUSE_PICKUP": "Cria uma nova atordoante quando seus escudos quebram.",
    "ITEM_BORBOFUSE_DESCRIPTION": "Ganha <style=cIsHealing>25.0 de escudo</style> <style=cStack>(+25.0 por acúmulo)</style>. Quebrar seus escudos <style=cIsUtility>Eletrocuta</style> até 3 <style=cStack>(+1 por acúmulo)</style> inimigos dentro de <style=cIsUtility>40.0m</style> <style=cStack>(+4.0 por acúmulo)</style>. <style=cIsDamage>A duração do choque escala com a vida do escudo</style>.",
    "ITEM_NEARBYDEFENSE_NAME": "Colar de Água-Viva",
    "ITEM_NEARBYDEFENSE_PICKUP": "Aumenta a armadura e a regeneração enquanto houver inimigos por perto.",
    "ITEM_NEARBYDEFENSE_DESCRIPTION": "Aumenta a regeneração de vida base em <style=cIsHealing>+1 de vida/s</style> <style=cStack>(+1 de vida/s por acúmulo)</style> e a armadura em <style=cIsHealing>+10</style> <style=cStack>(+10 por acúmulo)</style>. Para cada inimigo dentro de <style=cIsUtility>20m</style>, também ganha <style=cIsHealing>+0.5 de vida/s</style> <style=cStack>(+0.5 de vida/s por acúmulo)</style> de regeneração de vida base e <style=cIsHealing>+5</style> <style=cStack>(+5 por acúmulo)</style> de armadura, até <style=cIsUtility>5</style> vezes.",
    "ITEM_ICHORRED_NAME": "Icor Metamórfico (Vermelho)",
    "ITEM_ICHORRED_PICKUP": "Aumenta a velocidade de ataque e a chance de acerto crítico.",
    "ITEM_ICHORRED_DESCRIPTION": "Aumenta a <style=cIsDamage>velocidade de ataque</style> em <style=cIsDamage>7.5%</style> <style=cStack>(+7.5% por acúmulo)</style>. Aumenta a <style=cIsDamage>chance de acerto crítico</style> em <style=cIsDamage>5%</style> <style=cStack>(+5% por acúmulo)</style>. <style=cIsVoid>Corrompe todas as Placas de Armadura de Repulsão e Icores Amarelos</style>.",
    "ITEM_ICHORVIOLET_NAME": "Icor Metamórfico (Violeta)",
    "ITEM_ICHORVIOLET_PICKUP": "Ganha barreira ao sofrer dano. <style=cIsVoid>Corrompe todos os Kits Médicos e Icores Vermelhos</style>.",
    "ITEM_ICHORVIOLET_DESCRIPTION": "Ganha <style=cIsHealing>22 de barreira</style> ao sofrer dano <style=cStack>(+22 por acúmulo)</style>. <style=cIsVoid>Corrompe todos os Kits Médicos e Icores Vermelhos</style>.",
    "ITEM_ICHORYELLOW_NAME": "Icor Metamórfico (Amarelo)",
    "ITEM_ICHORYELLOW_PICKUP": "Ganha regeneração de vida. <style=cIsVoid>Corrompe todas as Seringas de Soldado e Icores Violetas</style>.",
    "ITEM_ICHORYELLOW_DESCRIPTION": "Aumenta a <style=cIsHealing>regeneração de vida base</style> em <style=cIsHealing>0.8 de vida/s</style> <style=cStack>(+0.8 de vida/s por acúmulo)</style>. <style=cIsVoid>Corrompe todas as Seringas de Soldado e Icores Violetas</style>.",
    "ITEM_PHRYGIANLILY_NAME": "Lírio Frígio",
    "ITEM_PHRYGIANLILY_PICKUP": "Entre em fúria após ativar o teletransportador. <style=cIsVoid>Corrompe todas as Margaridas de Lépton.</style>",
    "ITEM_PHRYGIANLILY_DESCRIPTION": "<style=cIsDamage>Entre em fúria</style> por 20 segundos ao ativar o teletransportador. Enquanto estiver em fúria, aumenta a velocidade de ataque em +30% <style=cStack>(+15% por acúmulo)</style> e reduz a recarga das habilidades em 30% <style=cStack>(15% por acúmulo)</style>.",
    "ITEM_HEALFROMBLEEDINGENEMIES_NAME": "Coralito Sanguessuga",
    "ITEM_HEALFROMBLEEDINGENEMIES_PICKUP": "Inimigos sangrando curam você ao serem atingidos. Corrompe todas as Sementes Sanguessugas.",
    "ITEM_HEALFROMBLEEDINGENEMIES_DESCRIPTION": "Ganha <style=cIsHealth>10% de chance de sangramento</style>. Inimigos sangrando curam você em <style=cIsDamage>+0.2 de vida</style> ao serem atingidos <style=cIsHealth>por acúmulo de sangramento</style>, até um máximo de 2 <style=cStack>(+1 por acúmulo)</style> de vida. <style=cIsVoid>Corrompe todas as Sementes Sanguessugas.</style>",
    "ITEM_WICKEDBAND_NAME": "Anel Perverso",
    "ITEM_WICKEDBAND_PICKUP": "Golpes de alto dano reduzem as recargas em 1 segundo.",
    "ITEM_WICKEDBAND_DESCRIPTION": "Golpes que causam <style=cIsDamage>mais de 400% de dano</style> também <style=cIsUtility>reduzem TODAS as recargas em 1.0s</style> <style=cStack>(+1.0 por acúmulo)</style>. <style=cIsHealth>1.0 segundo de recarga.</style>",
    "ITEM_GALLERY_ITEM_DROP_NAME": "Item da Galeria",
    "ITEM_GALLERY_ITEM_DROP_PICKUP": "Você não deveria ver isso kkk",
    "ITEM_GALLERY_ITEM_DROP_DESCRIPTION": "Você não deveria ver isso kkk",
    "ITEM_HEALTHUP_NAME": "HealthUp",
    "ITEM_AOEONCRIT_NAME": "Hipo-Enfiador",
    "ITEM_AOEONCRIT_PICKUP": "'Acertos Críticos' disparam uma corrente de laser.",
    "ITEM_AOEONCRIT_DESCRIPTION": "Ganha <style=cIsDamage>5% de chance crítica</style>. <style=cIsDamage>Acertos críticos</style> disparam um <style=cIsDamage>laser ricocheteante</style> para <style=cIsDamage>60%</style> <style=cStack>(+20% por acúmulo)</style> de dano TOTAL em até <style=cIsDamage>1 <style=cStack>(+1 por acúmulo)</style> inimigos</style>.",
    "ITEM_AOEONCRIT_LORE": "Seu idiota! Essas coisas deveriam ser INQUEBRÁVEIS. Como diabos você conseguiu fazer isso?\r\n\r\nCara... Desculpa te dar a notícia, mas hiper-enfiadores são baratos pra caramba. Vai te custar troco de pão pra comprar um novo. Já se perguntou por quê?\r\n\r\nEu não tô nem aí, cara. Essa coisa mal funciona agora. Se alguém vai me comprar um novo, esse alguém é VOCÊ.\r\n\r\nHaha, cara, hã, você acha que eu sou feito de dinheiro? Eu hã-\r\n\r\nEu já disse. Eu. Não. Tô. NEM AÍ.",
    "ITEM_BORBOBIGBATTERY_NAME": "Bateria AAAAAAA",
    "ITEM_BORBOBIGBATTERY_PICKUP": "Aumenta a taxa de recarga de escudo. Enquanto os escudos estiverem ativos, ganha bônus de velocidade de ataque.",
    "ITEM_BORBOBIGBATTERY_DESCRIPTION": "Ganha um <style=cIsHealing>escudo</style> igual a <style=cIsHealing>4%</style> da sua vida máxima. Reduz o <style=cIsUtility>atraso de recarga do escudo</style> em <style=cIsUtility>1.0s</style>. Enquanto os escudos estiverem ativos, aumenta a <style=cIsDamage>velocidade de ataque</style> em <style=cIsDamage>20%</style> <style=cStack>(+20% por acúmulo)</style>.",
    "ITEM_BORBOBIGBATTERY_LORE": "Pedido: Bateria Protótipo\r\nNúmero de Rastreio: 11***********\r\nEntrega Estimada: 06/05/2056\r\nMétodo de Envio: Prioritário\r\nEndereço de Entrega: Estação de Pesquisa Palia, Sol\r\nDetalhes do Envio:\r\n\r\nCerto, que tal esta?\r\n\r\nNós, hã,\r\n\r\n*risadinha*\r\n\r\nHã, nós revisamos suas anotações sobre o último protótipo e, hã\r\n\r\n(conversa ao fundo)\r\n\r\nNós ajustamos as dimensões levemente\r\n\r\n*risadinha*\r\n\r\nAgora, ela é um pouco mais longa que aquele seu gerador, mas, hã\r\n\r\n(risos abafados)\r\n\r\nTambém desenhamos este pequeno, hã, conectorzinho…\r\n\r\n(Calem a boca, pessoal)\r\n\r\nHã, enfim, você pode simplesmente, tipo, encaixar direto aí dentro, igual no vídeo de demonstração\r\n\r\n(passos altos)\r\n\r\nE honestamente acho que estamos,\r\n\r\n*risadinha*\r\n\r\nAcho que realmente acertamos em cheio dessa vez, cara\r\n\r\nTipo, esta pode ser a hã\r\n\r\nA nova fonte de energia padrão\r\n\r\n*risadinha*\r\n\r\nSabe?",
    "ITEM_BINARYSHIELD_NAME": "Pereópode Blindado",
    "ITEM_BINARYSHIELD_PICKUP": "Aumenta a velocidade de movimento enquanto os escudos estiverem desativados.",
    "ITEM_BINARYSHIELD_DESCRIPTION": "Ganha <style=cIsHealing>25.0 de escudo</style> e <style=cIsUtility>5% <style=cStack>(+19% por acúmulo)</style> de velocidade de movimento</style>. Enquanto os escudos estiverem desativados, aumenta a <style=cIsUtility>velocidade de movimento</style> em <style=cIsUtility>19%</style> <style=cStack>(+19% por acúmulo)</style>. <style=cIsVoid>Corrompe todos os Cascos de Cabra de Paul.</style>",
    "ITEM_BIRDBAND_NAME": "Item do Dev",
    "ITEM_BIRDBAND_PICKUP": "Golpes de alto dano também deixam você Regenerativo por uma curta duração. Recarrega com o tempo.",
    "ITEM_BIRDBAND_DESCRIPTION": "Golpes que causam <style=cIsDamage>mais de 400% de dano</style> também deixam você <style=cIsHealing>Regenerativo</style> por <style=cIsDamage>1.5 segundos</style> <style=cStack>(+0.75 segundos por acúmulo)</style>, restaurando <style=cIsHealing>10% da sua vida máxima</style> por segundo. Recarrega a cada 7 segundos.",
    "ITEM_BIRDBAND_LORE": "“Tô te falando, eles são reais.”\r\n\r\n“Sem chance, cara. É ridículo até pra uma história de fantasma.”\r\n\r\n“É sério! ‘Ainda mais altos que os próprios deuses’? Cai na real.”\r\n\r\n“Eu vi provas, tô te falando. Coisas que desafiam qualquer explicação.”\r\n\r\n“Ah, conta aí. Tô na ponta da cadeira.”\r\n\r\n“Sabe aqueles lançadores de mísseis? Os que costumavam atirar um foguetão gigante? Por que começaram a vomitar aqueles ferrõezinhos do nada?”\r\n\r\n“Sei lá.”\r\n\r\n“Foram eles. Eles reescreveram tudo. E— e toda aquela tralha que simplesmente sumiu, como se nunca tivesse existido. E todos os nossos suprimentos médicos que de repente ficaram bem menos eficazes. Percebeu que todos os monstros não batem mais tão forte quanto antes?”\r\n\r\n“Cara…”\r\n\r\n“É real, tô te falando! E todos os nossos trajes ficaram tão… travados. Tudo de uma vez. Mesmo sem nada de errado com eles.”\r\n\r\n“...”\r\n\r\n“E o meu wungus só cura 1 de vida agora.”\r\n\r\n“Cara. Do que diabos você tá falando?”\r\n\r\n“Ele perdeu a cabeça.”",
    "ITEM_CLOUDBOTTLE_NAME": "Nuvem na Garrafa",
    "ITEM_CLOUDBOTTLE_PICKUP": "Dê um salto duplo perto dos inimigos para atordoá-los!",
    "ITEM_CLOUDBOTTLE_DESCRIPTION": "Ganha uma carga de salto aéreo. Recarga de <style=cIsUtility>15</style>s. Enquanto pronta, saltar no ar dentro de <style=cIsUtility>9.0m</style> <style=cStack>(+9.0m por acúmulo)</style> de qualquer inimigo solta uma <style=cIsUtility>bomba de fumaça</style>, <style=cIsDamage>atordoando-os</style> por <style=cIsDamage>1.0s</style> e reduzindo a recarga em <style=cIsUtility>10s.</style>",
    "ITEM_FARTBOTTLE_NAME": "Contaminante em Quarentena",
    "ITEM_FARTBOTTLE_PICKUP": "Dar salto duplo perto dos inimigos os debilita e causa dano. <style=cIsVoid>Corrompe todas as Nuvens na Garrafa.</style>",
    "ITEM_FARTBOTTLE_DESCRIPTION": "Ganha uma carga de salto aéreo. Enquanto pronta, saltar no ar dentro de <style=cIsUtility>11.0m</style> de um inimigo produz um <style=cIsDamage>gás tóxico</style>, causando <style=cIsDamage>200%</style> de dano base <style=cStack>(+100% por acúmulo)</style> por segundo e Debilitando inimigos dentro. Não pode ser reativada por <style=cIsUtility>4</style>s. <style=cIsVoid>Corrompe todas as Nuvens na Garrafa.</style>",
    "ITEM_CHICKEN_NAME": "Frango Cru",
    "ITEM_CHICKEN_PICKUP": "Aumenta a vida máxima. Tente manter no estômago!",
    "ITEM_CHICKEN_DESCRIPTION": "Aumenta sua <style=cIsHealing>vida máxima</style> em <style=cIsHealing>30%</style> <style=cStack>(+30% por acúmulo)</style>. <style=cIsHealing>Sofra intoxicação alimentar</style>, reduzindo sua <style=cIsHealing>regeneração de vida base</style> em <style=cIsHealing>-2.0 de vida/s</style> por 120 segundos.",
    "ITEM_DISCOUNTCARDNEW_NAME": "Cartão Fidelidade",
    "ITEM_DISCOUNTCARDNEW_PICKUP": "Terminais de loja devolvem dinheiro e permanecem abertos. Pode ser usado duas vezes.",
    "ITEM_DISCOUNTCARDNEW_DESCRIPTION": "Ao comprar em terminais de <style=cIsUtility>multiloja</style>, os outros terminais <style=cIsUtility>permanecem abertos</style>, reembolsando <style=cIsUtility>$20</style>. Utilizável até duas vezes.",
    "ITEM_BOSSITEMCONSUMABLE_NAME": "Bisturi de Obsidiana",
    "ITEM_BOSSITEMCONSUMABLE_PICKUP": "Monstros grandes têm uma chance muito maior de soltar um troféu. Consumido ao soltar.",
    "ITEM_BOSSITEMCONSUMABLE_DESCRIPTION": "Abater inimigos capazes de soltar <style=cIsDamage>itens de troféu</style> concede <style=cIsUtility>50%</style> de chance adicional de soltar o <style=cIsDamage>troféu</style>. Consumido após o uso bem-sucedido.",
    "ITEM_BOSSITEMCONSUMABLE_LORE": "Pedido: Bisturi Médico (Obsidiana)\r\nNúmero de Rastreio: 91***********\r\nEntrega Estimada: 30/09/2056\r\nMétodo de Envio: Prioritário/Frágil\r\nEndereço de Entrega: Monte Golias, Marte\r\nDetalhes do Envio:\r\n\r\nFeito sob medida de acordo com suas especificações. Muito afiado. A espessura da lâmina é medida em comprimentos de Planck. Isso definitivamente vai cortar o que quer que você precise.\r\nMas não posso garantir a durabilidade. Tente acertar de primeira.\r\nE mais uma coisa – quando quebrar, não vai esperar até você terminar a operação. Não use em nada que você se importe em não danificar. Ou matar.\r\nMas você já sabia de tudo isso. Só não consigo evitar me perguntar para que você continua pedindo essas coisas.",
    "ITEM_EGG_NAME": "Ovo",
    "ITEM_EGG_PICKUP": "Aumenta levemente a vida. Inicia uma caça aos ovos.<style=cIsVoid>Corrompe a maioria dos comestíveis e matéria animal</style>.",
    "ITEM_EGG_DESCRIPTION": "Ganha <style=cIsHealing>5 de vida máxima</style>. <style=cIsUtility>Inicia uma caça aos ovos</style>. <style=cIsVoid>Corrompe todas as Infusões, Bifes de Bisão e Cabeças Alienígenas</style>.",
    "ITEM_EGG_LORE": "esse ovo tá gostoso pra caralho",
    "ITEM_FROZENSHELL_NAME": "Casco de Tartaruga Congelado",
    "ITEM_FROZENSHELL_PICKUP": "Reduz o dano recebido quando estiver com pouca vida.",
    "ITEM_FROZENSHELL_DESCRIPTION": "<style=cIsHealing>Aumenta a vida máxima</style> em <style=cIsHealing>8%</style> <style=cStack>(+8% por acúmulo)</style>. Para cada <style=cIsHealth>10% de vida máxima</style> perdida, ganha <style=cIsHealing>5</style> <style=cStack>(+5 por acúmulo)</style> de armadura adicional.",
    "ITEM_GAMMAKNIFE_NAME": "Faca Gama",
    "ITEM_GAMMAKNIFE_PICKUP": "Abater campeões reduz permanentemente as recargas e garante Acertos Críticos temporariamente. <style=cIsVoid>Corrompe todos os Bisturis de Obsidiana.</style>",
    "ITEM_GAMMAKNIFE_DESCRIPTION": "Abater um <style=cIsDamage>Campeão</style> aumenta sua <style=cIsDamage>chance de Acerto Crítico</style> em <style=cIsDamage>100%</style> por <style=cIsDamage>9.0</style> segundos E <style=cIsHealth>permanentemente</style> aumenta sua <style=cIsUtility>armadura</style> em <style=cIsUtility>5</style> e reduz todas as <style=cIsDamage>recargas de habilidade</style> em <style=cIsDamage>-5%</style>, até <style=cIsUtility>9</style> <style=cStack>(+9 por acúmulo)</style> vezes. <style=cIsVoid>Corrompe todos os Bisturis de Obsidiana.</style>",
    "ITEM_GOLDEN_EGG_NAME": "Ovo Dourado",
    "ITEM_GOLDEN_EGG_PICKUP": "Às vezes, sonhos se tornam realidade...",
    "ITEM_GOLDEN_EGG_DESCRIPTION": "No início da próxima fase, um ovo dourado chocará em um item do vazio.",
    "ITEM_BORBODISCOUNT_NAME": "Anel Ganancioso",
    "ITEM_BORBODISCOUNT_PICKUP": "Ganha dinheiro extra e regeneração após abrir baús.",
    "ITEM_BORBODISCOUNT_DESCRIPTION": "Após gastar <style=cIsDamage>dinheiro</style>, ganha um <style=cIsDamage>Reembolso</style> por 20.0 segundos. Enquanto seu <style=cIsDamage>Reembolso</style> estiver ativo, aumenta a renda em 15% <style=cStack>(+7.5% por acúmulo)</style> e a <style=cIsHealing>regeneração de vida base</style> em <style=cIsHealing>3.0 de vida/s</style> <style=cStack>(+3.0 de vida/s por acúmulo)</style>.",
    "ITEM_BORBODISCOUNT_LORE": "Pedido: Caçador de Cupons Mapel (Lite)\r\nNúmero de Rastreio: 06***********\r\nEntrega Estimada: 04/11/2056\r\nMétodo de Envio: Prioritário\r\nEndereço de Entrega: 308, Estação Belfast, Terra\r\nDetalhes do Envio:\r\n\r\nCerto, aqui está. Como prometido, ele analisa (legalmente, claro) o código em compras eletrônicas para encontrar códigos promocionais e descontos e aplicá-los à compra, sem precisar de entrada do usuário! É super legal.\r\nPode ser um pouco limitado na prática, já que você precisa ter o valor total em mãos e os códigos podem não ser os melhores oferecidos. Motivos legais para isso, naturalmente. Ah, e há um limite de quantas compras você pode fazer — você precisa esperar um pouco para atualizar se quiser pegar esses cupons.\r\nClaro, você sempre pode comprar a versão premium para descontos ilimitados~\r\n",
    "ITEM_KALEIDOSKULL_NAME": "Caleidocrânio",
    "ITEM_KALEIDOSKULL_PICKUP": "Acertos Críticos infligem um efeito negativo aleatório. <style=cIsVoid>Corrompe todos os Instintos Predatórios.</style>",
    "ITEM_KALEIDOSKULL_DESCRIPTION": "Ganha <style=cIsDamage>5% de chance crítica</style>. <style=cIsDamage>Acertos críticos</style> aplicam aleatoriamente <style=cIsDamage>Incendiar</style> ou <style=cIsUtility>Gelo</style>. Adicionalmente tem 50% de chance de infligir <style=cIsUtility>1</style> <style=cStack>(+1 por acúmulo)</style> efeitos negativos aleatórios. <style=cIsVoid>Corrompe todos os Instintos Predatórios.</style>",
    "ITEM_LIGHTNINGATTRACTOR_NAME": "Garfo de Cobre",
    "ITEM_LIGHTNINGATTRACTOR_PICKUP": "Atrai raios com golpes repetidos.",
    "ITEM_LIGHTNINGATTRACTOR_DESCRIPTION": "O dano de qualquer <style=cIsDamage>habilidade ou equipamento</style> também finca um garfo de cobre no inimigo por <style=cIsUtility>3.0</style> segundos. Atacar repetidamente um inimigo com garfo reinicia a duração do garfo e atrai um raio, <style=cIsDamage>Atordoando</style> um inimigo próximo por <style=cIsDamage>300% de dano base</style> <style=cStack>(+300% por acúmulo)</style>. Máx. 1, recarrega <style=cIsUtility>5.0s</style> após o garfo expirar.",
    "ITEM_LIGHTNINGATTRACTOR_LORE": "Novidade da CuCo!\r\n\r\nO conjunto de Talheres CopperWare oferece inúmeros benefícios em relação aos seus talheres comuns de Aço Inoxidável.\r\n\r\nUma cor marrom-avermelhada estilosa para combinar com sua mesa, e a combinação perfeita para seu conjunto de Panelas e Frigideiras CuCo CopperWare!\r\n\r\nIngestão suplementar de Cobre diretamente dos seus talheres!\r\n\r\nLimpeza fácil! Uma esfregada com qualquer ácido doméstico como Vinagre ou Suco de Limão trará o brilho de fábrica de volta ao seu CopperWare!\r\n\r\nExperimente CopperWare hoje mesmo!\r\n\r\nAVISOS DO PRODUTO\r\n\r\nPara evitar risco de corrosão galvânica, não deixe o CopperWare em contato com outras superfícies metálicas, especialmente na presença de eletrólitos como sal.\r\n\r\nNão use utensílios CopperWare para cozinhar. Isso apresenta um risco significativo de queimaduras e pode liberar cobre no prato.\r\n\r\nNão se recomenda que clientes acima de 65 anos usem CopperWare devido a ligações entre cobre e Doença de Alzheimer.\r\n\r\nDevido à alta condutividade elétrica do cobre, recomenda-se não usar nenhum produto CopperWare próximo a correntes elétricas ou eletrodomésticos.\r\n\r\nPara mitigar o risco de eletrocussão fatal, por favor não use produtos CopperWare ao jantar ao ar livre.\r\n\r\nCom sua concordância em comprar e usar este produto, a CuCo é isenta de responsabilidade por quaisquer reclamações de consumidores relacionadas à natureza de utensílios de cozinha de cobre.",
    "ITEM_LOWHEALTHREGEN_NAME": "Cantarelo Encantador",
    "ITEM_LOWHEALTHREGEN_PICKUP": "Aumenta a regeneração, mas só brota abaixo de 60% de vida!",
    "ITEM_LOWHEALTHREGEN_DESCRIPTION": "Enquanto estiver abaixo de <style=cIsHealing>60% da vida máxima</style>, aumenta a <style=cIsHealing>regeneração de vida base</style> em <style=cIsHealing>+2.0 de vida/s</style> <style=cStack>(+2.0 de vida/s por acúmulo)</style>.",
    "ITEM_LUNARBRAND_NAME": "Marca do Fogo Estelar",
    "ITEM_LUNARBRAND_PICKUP": "Cauteriza inimigos em chamas, infligindo dano pesado <style=cIsHealth>E apagando todos os seus efeitos negativos.</style>",
    "ITEM_LUNARBRAND_DESCRIPTION": "Ganha <style=cIsDamage>20%</style> de chance de <style=cIsDamage>Incendiar</style> ao atingir. Infligir <style=cIsDamage>5</style> acúmulos de queimadura Cauteriza os inimigos por <style=cIsDamage>5</style> segundos <style=cStack>(+5 por acúmulo)</style>, causando <style=cIsDamage>900%</style> <style=cStack>(+450% por acúmulo)</style> de dano. Adicionalmente, Cauterizar desacelera os inimigos em 50% e anula toda cura, <style=cIsHealth>MAS... Inimigos cauterizados são limpos de todos os efeitos negativos e ganham +30 de armadura.</style>",
    "ITEM_LUNARINCREASECD_NAME": "Laço de Compressão",
    "ITEM_LUNARINCREASECD_PICKUP": "Todas as habilidades disparam fragmentos lunares... <style=cIsHealth>MAS todas as habilidades têm recargas aumentadas</style>",
    "ITEM_LUNARINCREASECD_DESCRIPTION": "Ao usar qualquer habilidade, dispara <style=cIsDamage>fragmentos lunares</style> para <style=cIsDamage>160% de dano</style> (aumenta com a recarga da habilidade). <style=cIsHealth>Aumenta a recarga de todas as habilidades em 1.0 segundo</style> <style=cStack>(+1.0 por acúmulo)</style>.",
    "ITEM_MAGICQUIVER_NAME": "Aljava Mágica",
    "ITEM_MAGICQUIVER_PICKUP": "Usar habilidades tem chance de não consumir carga.",
    "ITEM_MAGICQUIVER_DESCRIPTION": "Concede <style=cIsDamage>10.0%</style> <style=cStack>(+10.0% por acúmulo)</style> de chance de não consumir uma carga ao usar uma habilidade. <style=cIsUtility>Não é afetado pela sorte</style>.",
    "ITEM_BORBOMANAFLOWER_NAME": "Dádiva da Natureza",
    "ITEM_BORBOMANAFLOWER_PICKUP": "Aumenta levemente a velocidade de ataque e reduz as recargas Primária e Secundária.",
    "ITEM_BORBOMANAFLOWER_DESCRIPTION": "Aumenta a <style=cIsDamage>velocidade de ataque</style> em <style=cIsUtility>8%</style> <style=cStack>(+8% por acúmulo)</style> e reduz as <style=cIsUtility>recargas das habilidades Primária e Secundária</style> em <style=cIsUtility>8%</style> <style=cStack>(+8% por acúmulo)</style>.",
    "ITEM_BORBOMANAFLOWER_LORE": "Pedido: Rosa de Júpiter\r\nNúmero de Rastreio: 58***********\r\nEntrega Estimada: 30/07/2056\r\nMétodo de Envio: Padrão\r\nEndereço de Entrega: 280 Oak Boulevard, Vênus\r\nDetalhes do Envio:\r\n\r\nNão é linda?\r\nSó de olhar para ela já me encho de energia.\r\nA natureza é tão mágica :)",
    "ITEM_MINIAMETHYST_NAME": "Fragmento de Ametista",
    "ITEM_MINIAMETHYST_PICKUP": "Ativar seu Equipamento reduz as recargas das suas habilidades.",
    "ITEM_MINIAMETHYST_DESCRIPTION": "Ativar seu Equipamento reduz <style=cIsUtility>todas as recargas de habilidade</style> em <style=cIsUtility>10%</style> <style=cStack>(+10% por acúmulo)</style> da recarga base do seu Equipamento.",
    "ITEM_DANGERCRIT_NAME": "O Novo Lopper",
    "ITEM_DANGERCRIT_PICKUP": "Aumenta massivamente o dano de 'Acerto Crítico' com pouca vida.",
    "ITEM_DANGERCRIT_DESCRIPTION": "Ganha <style=cIsDamage>20% de chance crítica.</style> Cair abaixo de <style=cIsHealth>50% de vida</style> coloca você em fúria, aumentando o <style=cIsDamage>dano de acerto crítico em 250%</style> <style=cStack>(+250% por acúmulo)</style> e a <style=cIsDamage>chance de acerto crítico em 30%</style>. Abater inimigos <style=cIsDamage>estende</style> a fúria por <style=cIsDamage>4.0 segundos</style>.",
    "ITEM_DANGERCRIT_LORE": "Nome: [REDIGIDO]\r\nData de nascimento: 21 de junho de 1961\r\nOcupação: Carrasco\r\n\r\nHora da morte: 23 de agosto de 2058\r\nLocal da morte: [REDIGIDO], Mercúrio\r\nCausa da morte: Perda severa de sangue devido a mutilação corporal\r\n\r\nNotas:\r\nUm machado em condição impecável foi encontrado ao lado do corpo. O exame determinou que a arma era altamente resistente tanto ao desgaste quanto a manchas, especialmente de sangue. A construção do machado é consistente com a de um ferreiro em Sues Drive, Júpiter, com quem [REDIGIDO] esteve em contato pouco antes de sua morte.\r\n\r\n[REDIGIDO] cometeu 126 homicídios conhecidos na hora que precedeu sua morte. Todas as vítimas foram mortas por decapitação e não apresentavam outros ferimentos. Testemunhas relatam que [REDIGIDO] acidentalmente atingiu a si mesmo e partiu o próprio corpo ao meio na cintura, sangrando até a morte momentos depois.\r\n\r\nA autópsia revela degradação dos órgãos internos anterior à morte de [REDIGIDO]. Os sintomas parecem ser consistentes com certas cepas de [REDIGIDO] encontradas em Júpiter. Nenhuma degradação foi encontrada no cérebro, porém é possível que a doença tenha influenciado seu estado mental.\r\n",
    "ITEM_GOODEXECUTIONITEM_NAME": "Permafrost",
    "ITEM_GOODEXECUTIONITEM_PICKUP": "Chance de Congelar inimigos em golpes pesados, matando-os instantaneamente com pouca vida.",
    "ITEM_GOODEXECUTIONITEM_DESCRIPTION": "<style=cIsDamage>3.0%</style> <style=cStack>(+2.0% por acúmulo)</style> de chance ao atingir <style=cIsDamage>por % da vida máxima do inimigo causada em dano</style> de <style=cIsUtility>Congelar</style> inimigos no lugar por <style=cIsUtility>1.5 segundos. </style>Inimigos congelados são <style=cIsHealth>mortos instantaneamente</style> com pouca vida.",
    "ITEM_PHOTOGRAPH_NAME": "Fotografia",
    "ITEM_PHOTOGRAPH_PICKUP": "Imprimir itens aumenta a chance e o dano de acerto crítico. Reinicia no início de cada fase.",
    "ITEM_PHOTOGRAPH_DESCRIPTION": "Gastar itens em qualquer impressora aumenta a <style=cIsDamage>chance de acerto crítico</style> e o <style=cIsDamage>dano de acerto crítico</style> em <style=cIsDamage>+10.0%</style> <style=cStack>(+5.0% por acúmulo)</style>, até <style=cIsUtility>3 vezes</style> <style=cStack>(+0 por acúmulo)</style>. Reinicia no início de cada fase.",
    "ITEM_PHOTOGRAPH_LORE": "Você imprimiu suas fotos?\n\n\"Bogos binted?\"\n\nHã?\n\n\"Baixe GreenAlienHead\"",
    "ITEM_CHARGEDMALACHITESPINE_NAME": "Espinha de Malaquita Carregada",
    "ITEM_CHARGEDMALACHITESPINE_PICKUP": "Envenene-se quando os escudos quebrarem, ganhando grande resistência a dano.",
    "ITEM_CHARGEDMALACHITESPINE_DESCRIPTION": "Ganha <style=cIsHealing>50.0 de escudo</style> <style=cStack>(+50.0 por acúmulo)</style>. Enquanto envenenado, ganha <style=cIsHealing>200.0 de armadura</style>. <style=cIsHealth>Veneno é infligido por 5.0 segundos ao quebrar o escudo</style> <style=cStack>(+5.0 segundos por acúmulo)</style>.",
    "ITEM_WISHBONE_NAME": "Osso da Sorte",
    "ITEM_WISHBONE_PICKUP": "Quebra durante tempestades. Se levado ao Teletransportador, um desejo será concedido.",
    "ITEM_WISHBONE_DESCRIPTION": "Quebra durante tempestades. Se levado ao Teletransportador, um desejo será concedido.",
    "ITEM_WISHBONE_LORE": "loooooreeeeeee",
    "ITEM_RANDOMBARRIERTARGET_NAME": "Bola de Cristal",
    "ITEM_RANDOMBARRIERTARGET_PICKUP": "Destaca um inimigo próximo. Ganha barreira e chance de acerto crítico ao atingir.",
    "ITEM_RANDOMBARRIERTARGET_DESCRIPTION": "Reduz o decaimento da barreira em <style=cIsHealing>-20%</style>. <style=cIsDamage>Destaca</style> um inimigo aleatório. Atacar o inimigo marcado concede uma <style=cIsHealing>barreira temporária</style> de <style=cIsHealing>8.0 de vida</style> <style=cStack>(+8.0 por acúmulo)</style> e aumenta a <style=cIsDamage>chance de acerto crítico</style> em <style=cIsDamage>+20.0%</style> <style=cStack>(+10.0% por acúmulo)</style>.",
    "ITEM_RANDOMBARRIERTARGET_LORE": "Pedido: Bola de Cristal\r\nNúmero de Rastreio: 66***********\r\nEntrega Estimada: 06/05/2056\r\nMétodo de Envio: Devolução\r\nEndereço de Entrega: Arcane Suppliers Inc., A Cidadela Flutuante, Netuno\r\nDetalhes do Envio:\r\n\r\nEu pedi este Orbe de Presságio de vocês e, pelos meus deuses, eu NUNCA mais compro nada desse lugar. Isso é um puta GOLPE!!!\r\n\r\nEu tentei por HORAS fazer essa bola me mostrar QUALQUER COISA, e nem uma única vez recebi um momento de clarividência divina.\r\n\r\nE pode acreditar, eu SEI que sou iluminado, sou MUITO MAIs iluminado do que qualquer um de vocês, SUAS DONINHAS MALDITAS da Arcane GOLPISTAS. Não ousem me dizer que não sou iluminado o suficiente.\r\n\r\nSua bola de cristal, ou devo dizer de plástico, me custou mais do que TODAS as economias da minha vida. EU EXIJO MEU DINHEIRO DE VOLTA, OU VOCÊS ENFRENTARÃO CONSEQUÊNCIAS TERRÍVEIS!!!",
    "ITEM_SHIELDAMP_NAME": "Pedra Estalante",
    "ITEM_SHIELDAMP_PICKUP": "Enquanto os escudos estiverem cheios, seu próximo ataque drena uma pequena quantia de escudo para dano amplificado.",
    "ITEM_SHIELDAMP_DESCRIPTION": "Ganha <style=cIsHealing>40 de escudo</style>. Enquanto os escudos estiverem cheios, <style=cIsDamage>amplifica</style> o dano das habilidades. Golpes <style=cIsDamage>Amplificados</style> <style=cIsDamage>drenam 40%</style> do seu escudo máximo <style=cStack>(-8% por acúmulo)</style>, causando <style=cIsDamage>+400% de dano BASE</style> <style=cStack>(+250% por acúmulo)</style>. O dano amplificado se espalha para <style=cIsDamage>2</style> inimigos próximos.",
    "ITEM_STARVEIL_NAME": "Véu Estelar",
    "ITEM_STARVEIL_PICKUP": "Sofrer dano torna você invencível... <style=cIsHealth>MAS meteoros cairão por perto, ferindo tanto inimigos quanto aliados.</style>",
    "ITEM_STARVEIL_DESCRIPTION": "Após ser atingido, torna-se <style=cIsUtility>invencível a todo dano recebido</style> por 0.33 <style=cStack>(+0.33 por acúmulo)</style> segundos. Em seguida, faz 3 <style=cStack>(+2 por acúmulo)</style> <style=cIsDamage>ondas de meteoros</style> caírem do céu, <style=cIsHealth>causando dano a TODOS os personagens</style> em <style=cIsDamage>300% de dano por explosão.</style>",
    "ITEM_STARVEIL_LORE": "SOU EU. EU ESTOU COM ELE.\r\n\r\nESTÁ ANIMADO? ESTÁ COM MEDO? ESTÁ ARREPENDIDO? ESTÁ INCRÉDULO?\r\n\r\nASSASSINO.\r\n\r\nVOCÊ MATOU MEUS ?????. VOCÊ PROFANOU SUAS FORMAS. VOCÊ USOU SUAS ALMAS PARA MASSACRAR MEUS ?????. VOCÊ REALIZOU EXPERIMENTOS HEDIONDOS EM NOME DE FALSOS DEUSES. E O RESULTADO LHE DEU PODER.\r\n\r\nMAS VOCÊ O PERDEU.\r\n\r\nE AGORA EU O TENHO. ESTOU CERCADO PELAS ALMAS DOS MEUS ????? E ESTOU CHEIO DE VINGANÇA.\r\n\r\nDO QUE VOCÊ ESTÁ CHEIO? MEDO E REMORSO?\r\n\r\nONDE ESTÁ A SUA “INVENCIBILIDADE” AGORA? ONDE ESTÁ O SEU “PODER MATADOR DE DEUSES”? ONDE ESTÃO AS SUAS “ESTRELAS”?\r\n\r\nELAS ESTÃO COMIGO. VOCÊ É MUITO MAIS QUE UM ASSASSINO. VOCÊ É UM TOLO. IMBECIL. IGNORANTE. E VOCÊ VAI SE ARREPENDER DE TUDO O QUE FEZ A MIM E AOS MEUS ?????.\r\n\r\nPORQUE EU ESTOU INDO ATRÁS DE VOCÊ. CADA GOLPE PATÉTICO QUE VOCÊ ME DER EU USAREI PARA FAZER CHOVER MORTE SOBRE TUDO O QUE VOCÊ JÁ CONHECEU.\r\n\r\nO QUE VOCÊ VAI FAZER? SEUS FALSOS DEUSES NÃO RESPONDERÃO ÀS PRECES. NÃO HÁ NADA QUE VOCÊ POSSA FAZER. SE VOCÊ FUGIR, EU SÓ FICAREI MAIS FURIOSO.\r\n\r\nESTAREI AÍ EM BREVE. VOCÊ NÃO PRECISARÁ SE DESESPERAR POR MUITO TEMPO.\r\n\r\nAS ALMAS DOS MEUS ????? BEBERÃO SEUS GRITOS COMO NÉCTAR.",
    "ITEM_UTILITYBARRIER_NAME": "Canivete Utilitário",
    "ITEM_UTILITYBARRIER_PICKUP": "Usar sua habilidade Utilitária concede uma barreira temporária.",
    "ITEM_UTILITYBARRIER_DESCRIPTION": "Ativar sua <style=cIsUtility>habilidade Utilitária</style> também concede uma <style=cIsHealing>barreira temporária</style> igual a <style=cIsHealing>3%</style> da sua vida máxima <style=cStack>(+1.5% por acúmulo)</style> por segundo da <style=cIsUtility>recarga base</style> da habilidade.",
    "ITEM_VOIDLASERTURBINE_NAME": "Motor Super Solenoide",
    "ITEM_VOIDLASERTURBINE_PICKUP": "Usar habilidades carrega um ataque primário de laser devastador. <style=cIsVoid>Corrompe todos os Behemoths Brilhantes e Discos de Ressonância.</style>",
    "ITEM_VOIDLASERTURBINE_DESCRIPTION": "Usar suas habilidades acumula carga. Após acumular 90 segundos de carga, prepara 1 uso <style=cStack>(+1 por acúmulo)</style> de <style=cIsVoid>Perfura-Céus</style>, substituindo seu ataque Primário. Disparar <style=cIsVoid>Perfura-Céus</style> causa <style=cIsDamage>3200% de dano</style>, perfurando TODOS os inimigos e terrenos. <style=cIsVoid>Corrompe todos os Behemoths Brilhantes e Discos de Ressonância.</style>",
    "ITEM_VOIDUTILITYBELT_NAME": "Fluxo de Möbius",
    "ITEM_VOIDUTILITYBELT_PICKUP": "Usar sua habilidade Utilitária concede um surto adicional de velocidade de movimento. <style=cIsVoid>Corrompe todos os Canivetes Utilitários.</style>",
    "ITEM_VOIDUTILITYBELT_DESCRIPTION": "Ativar sua <style=cIsUtility>habilidade Utilitária</style> também aumenta sua <style=cIsUtility>velocidade de movimento</style> em <style=cIsUtility>4%</style> <style=cStack>(+4% por acúmulo)</style> por segundo da <style=cIsUtility>recarga base</style> da habilidade. Dura <style=cIsUtility>2.5 segundos</style>. <style=cIsVoid>Corrompe todos os Canivetes Utilitários.</style>",
    "ITEM_CUCKLER_NAME": "Escudo de Cobalto",
    "ITEM_CUCKLER_PICKUP": "Anula toda repulsão. Reduz o dano recebido e ganha barreira enquanto estiver parado.",
    "ITEM_CUCKLER_DESCRIPTION": "Anula <style=cIsUtility>TODA repulsão</style>. Aumenta a <style=cIsHealing>armadura</style> em <style=cIsHealing>20</style> <style=cStack>(+20 por acúmulo)</style> e a <style=cIsHealing>geração de barreira</style> em <style=cIsHealing>6 de vida/s</style> <style=cStack>(+6 de vida/s por acúmulo)</style>. Enquanto estiver parado, esses efeitos são <style=cIsUtility>quintuplicados</style>.",
    "ITEM_CUCKLER_LORE": "<style=cIsHealth>Não posso deixar você entrar até que me liberte da minha maldição.</style>",
    "ITEM_ECONOMYWEAPON_NAME": "Arma de Moedas",
    "ITEM_ECONOMYWEAPON_PICKUP": "Causa dano bônus para cada baú que você puder pagar.",
    "ITEM_ECONOMYWEAPON_DESCRIPTION": "Comece cada fase com <style=cIsUtility>$25</style>. Enquanto tiver <style=cIsUtility>$25 ou mais</style>, cause <style=cIsDamage>20% de dano bônus</style> <style=cStack>(+20% por acúmulo)</style>, mais <style=cIsDamage>4%</style> <style=cStack>(+4% por acúmulo)</style> a cada <style=cIsUtility>$25 adicionais guardados</style>, até um máximo de <style=cIsUtility>10 vezes</style>.",
    "ITEM_ECONOMYWEAPON_LORE": "Cara, essa coisa é tão irada. B-zap! Haha.\r\n\r\nEi. Cara. Dá uma olhada nisso.\r\n\r\nQue diabos é isso aí?\r\n\r\nNão. Olha só.\r\n\r\n…Hã? Que porcaria.\r\n\r\nEscuta, cara. DUAS. ARMAS DE. DINHEIRO.\r\n\r\nVocê é um idiota. Essa carrega usando ouro. Aquela atira ouro. O que acontece se você atirar todo o nosso ouro, Cooper? A gente não vai conseguir carregar nossas armas.\r\n\r\nTá tudo bem, cara. Os monstros desse planeta estão cheios da grana. Olha só tudo isso!\r\n\r\n…Hã? O que é aquela coisa?\r\n\r\nÉ esse, tipo, chapéu que eu achei? Ele atrai dinheiro ou algo assim. Se sobrevivermos a isso vamos ficar ricos.\r\n\r\nVocê tem que parar de pegar essas coisas. Todas elas tentaram matar a gente em algum momento.\r\n\r\nEssa não, cara. Olha— ops. Ai.\r\n\r\nHã.\r\n\r\nO quê?\r\n\r\nO que aconteceu com todo o nosso ouro?",
    "ITEM_CRITRETALIATE_NAME": "Emblema do Destruidor",
    "ITEM_CRITRETALIATE_PICKUP": "Acerte criticamente após sofrer dano.",
    "ITEM_CRITRETALIATE_DESCRIPTION": "Após ser atingido, ganha <style=cIsDamage>100.0%</style> de chance de <style=cIsDamage>Acerto Crítico</style>, diminuindo ao longo de <style=cIsDamage>3.0 segundos</style> <style=cStack>(+1.5 por acúmulo)</style>.",
    "ITEM_FLOWERCROWN_NAME": "Coroa de Flores",
    "ITEM_FLOWERCROWN_PICKUP": "Aumenta sua vida máxima.",
    "ITEM_FLOWERCROWN_DESCRIPTION": "Aumenta a <style=cIsHealing>vida máxima</style> em <style=cIsHealing>12%</style> <style=cStack>(+12% por acúmulo)</style>.",
    "ITEM_FLOWERCROWN_LORE": "Pedido: Coroa de Flores\r\nNúmero de Rastreio: 10***********\r\nEntrega Estimada: 02/11/2056\r\nMétodo de Envio: Prioritário/Frágil\r\nEndereço de Entrega: Andar 16, Jardins Espirais, Terra\r\nDetalhes do Envio:\r\n\r\nObrigado por sempre nos enviar presentes. Transformei alguns deles nesta coroa de flores para você. Usá-la me faz sentir forte, como se nada pudesse me derrubar. Espero que faça o mesmo por você! <3\r\n",
    "ITEM_BORBOMOLOTOV_NAME": "Molotov (1 Unidade)",
    "ITEM_BORBOMOLOTOV_PICKUP": "Chance ao atingir de arremessar um molotov em chamas.",
    "ITEM_BORBOMOLOTOV_DESCRIPTION": "<style=cIsDamage>9.0%</style> de chance ao atingir de arremessar um <style=cIsDamage>coquetel molotov</style> que <style=cIsDamage>incendeia</style> os inimigos causando <style=cIsDamage>60%</style> <style=cStack>(+60% por acúmulo)</style> de dano TOTAL e deixa uma área <style=cIsDamage>em chamas</style> causando <style=cIsDamage>30%</style> <style=cStack>(+30% por acúmulo)</style> de dano TOTAL por segundo.",
    "ITEM_BORBOMOLOTOV_LORE": "Pedido: Garrafa de Etanol (950 ml), Pacote com 6\r\nNúmero de Rastreio: 81******\r\nEntrega Estimada: 08/05/2058\r\nMétodo de Envio: Prioritário\r\nEndereço de Entrega: Mansão Teromere, Rua dos Alfeneiros, Marte\nDetalhes do Envio: Avise nossos amigos lá dentro que vamos passar para beber no dia 16 de junho. Vai ser uma festa daquelas, é melhor eles darem o fora antes que as coisas saiam do controle.",
    "ITEM_SLUNGUS_NAME": "Esporos Sonolentos",
    "ITEM_SLUNGUS_PICKUP": "Ficar parado protege você, desacelerando inimigos e projéteis próximos. Mova-se mais rápido até ser atingido.",
    "ITEM_SLUNGUS_DESCRIPTION": "Enquanto estiver parado, cria um <style=cIsUtility>campo de estase</style> protetor alcançando 24.0m ao seu redor, <style=cIsUtility>desacelerando</style> inimigos e projéteis próximos em <style=cIsUtility>80%</style>. Mova-se 20% mais rápido <style=cStack>(30% por acúmulo)</style> até a próxima vez que for atingido.",
    "ITEM_SLUNGUS_LORE": "Pedido: Companheiro de Viagem Cogumelo Lay-Z\r\nNúmero de Rastreio: 58***********\r\nEntrega Estimada: 23/09/2056\r\nMétodo de Envio: Prioritário/Biológico\r\nEndereço de Entrega: 444 Slate Drive, Marte\r\nDetalhes do Envio:\r\n\r\nObrigado pela sua compra!\r\n\r\nInstruções:\r\nGire o bico para ‘abrir’. Os esporos se dispersarão pelo ar, fazendo o tempo distorcer e passar mais devagar, encurtando assim sua espera enquanto o resto da realidade experimentará o tempo mais rápido. Pode levar algum tempo para os efeitos de distorção ocorrerem; deixe o frasco de esporos em uma área para maximizar a contagem de esporos. Se estiver viajando em um espaço pequeno e fechado, os esporos podem acabar preenchendo toda a área. Ventile regularmente para evitar supersaturação.\r\nPara encerrar o efeito de distorção temporal, feche o bico e saia ou ventile a área afetada. Sempre feche o bico antes de deixar a área afetada; exposição corporal parcial à distorção temporal pode causar efeitos indesejados.\r\nNota: você pode experimentar o tempo normalmente por vários segundos ou minutos após o início da distorção; isso é normal. Simplesmente aguarde o tempo desacelerar para você também (os objetos em movimento lento retomarão sua velocidade normal e objetos não afetados parecerão acelerar) e então boa espera!\r\n\r\nAvisos:\r\nObjetos parecem se mover mais devagar, mas carregam a mesma força que normalmente teriam. Não interaja com objetos normalmente rápidos ou fortes de maneira insegura.\r\nA área afetada sofre redução de temperatura; você pode querer usar roupas quentes ou aumentar o aquecedor. Termômetros não medem com precisão a temperatura na área afetada; assuma temperaturas práticas até 50 graus mais baixas que as medidas.\r\n<style=cIsHealth>Não abra o frasco. Manuseie com extremo cuidado. Ventile regularmente.</style>\r\n\r\nA FUN-GUYS Inc. não se responsabiliza por qualquer doença, ferimento, morte, alteração prolongada ou permanente na percepção do tempo, distorção espacial, mania ou letargia, alucinação, paranoia, ataque de pânico agudo ou outros resultados insatisfatórios. Todas as compras são finais.",
    "ITEM_VOIDHAPPIESTMASK_NAME": "Fachada Esquecida",
    "ITEM_VOIDHAPPIESTMASK_PICKUP": "Chance ao abater um inimigo de invocar infestadores do vazio. <style=cIsVoid>Corrompe todas as Máscaras Mais Felizes.</style>",
    "ITEM_VOIDHAPPIESTMASK_DESCRIPTION": "Abater monstros tem <style=cIsDamage>7.0%</style> de chance de gerar 2 <style=cStack>(+1 por acúmulo)</style> <style=cIsDamage>infestadores do vazio</style> em seu lugar. <style=cIsVoid>Corrompe todas as Máscaras Mais Felizes.</style>",
    "ITEM_ATTACKSPEEDHELPER_NAME": "AttackspeedHelper",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_NAME": "Galeria Lunar",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_CONTEXT": "engole minha transcendência, nerd",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_NAME": "Constructo Decaído",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_CONTEXT": "Chutar o Constructo",
    "2R4R_INTERACTABLE_EGG_PILE_NAME": "Ovo",
    "2R4R_INTERACTABLE_EGG_PILE_CONTEXT": "Encontrou um ovo",
    "2R4R_INTERACTABLE_FLOWERBLOOM_NAME": "Ah...?",
    "2R4R_INTERACTABLE_FLOWERBLOOM_CONTEXT": "É linda, ah, tão linda...",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_NAME": "Santuário da Convergência",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_CONTEXT": "Rezar no Santuário da Convergência",
    "2R4R_INTERACTABLE_VOID_HUSK_NAME": "Casca Fraturada",
    "2R4R_INTERACTABLE_VOID_HUSK_CONTEXT": "Quebrar para abrir",
    "2R4R_INTERACTABLE_WISHBONECARCASS_NAME": "Presságio",
    "2R4R_INTERACTABLE_WISHBONECARCASS_CONTEXT": "Quebrar Presságio",
    "EQUIPMENT_BROKENZAPINATOR_NAME": "Zapinator Laranja",
    "EQUIPMENT_BROKENZAPINATOR_PICKUP": "<style=cIsUtility>Não acredito que deixamos isso no jogo!</style>",
    "EQUIPMENT_BROKENZAPINATOR_DESCRIPTION": "Dispara um projétil.",
    "EQUIPMENT_NINJAGEAR_NAME": "Equipamento de Mestre Ninja",
    "EQUIPMENT_NINJAGEAR_PICKUP": "Tem chance de desviar de ataques recebidos. Ative para avançar e soltar uma bomba de fumaça.",
    "EQUIPMENT_NINJAGEAR_DESCRIPTION": "Ative para <style=cIsUtility>avançar 25m para a frente</style> e ganhar <style=cIsHealing>20% de chance</style> de <style=cIsHealing>desviar</style> de ataques recebidos. Avançar e desviar soltarão uma <style=cIsDamage>bomba de fumaça</style>, <style=cIsUtility>atordoando inimigos</style> dentro de 13m por <style=cIsUtility>1 segundo</style>.",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_NAME": "Prece Natimorta",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_PICKUP": "Concede um único desejo...",
    "EQUIPMENT_QUICKSTARTEQUIPMENT_DESCRIPTION": "Concede um item Incomum à sua escolha.",
    "EQUIPMENT_THEMACHINE_NAME": "A Máquina",
    "EQUIPMENT_THEMACHINE_PICKUP": "Ela não faz nada. Essa é a beleza dela!",
    "EQUIPMENT_THEMACHINE_DESCRIPTION": "Ela não faz nada. Essa é a beleza dela!",
    "EQUIPMENT_TESLAEQUIPMENT_NAME": "Bobina de Tesla Notavelmente Estável",
    "EQUIPMENT_TESLAEQUIPMENT_PICKUP": "Eletrocuta inimigos próximos e restaura Escudos ao abater.",
    "EQUIPMENT_TESLAEQUIPMENT_DESCRIPTION": "<style=cIsUtility>Eletriza</style> você por <style=cIsUtility>10.0 segundos</style>. Abates enquanto <style=cIsUtility>Eletrizado</style> atingirão <style=cIsDamage>4.0</style> inimigos próximos causando <style=cIsDamage>200% de dano</style> e <style=cIsHealing>restaurarão 15% dos seus escudos</style>. Passivamente ganha um <style=cIsHealing>escudo</style> igual a <style=cIsHealing>20% da sua vida máxima</style>.",
    "EQUIPMENT_TESLAEQUIPMENT_LORE": "<style=cMono>Software de Apresentação Tesla v1.14\nLigando...\n10...</style>\nEmitindo mensagem de boas-vindas...\n<style=cMono>9...</style>\nSejam todos bem-vindos!\n<style=cMono>8...</style>\nPor favor, sentem-se.\n<style=cMono>7...</style>\nCertifiquem-se de que quem está atrás possa ver.\n<style=cMono>6...</style>\nA apresentação começará em breve.\n<style=cMono>5...</style>\nPor favor, obedeçam à equipe para sua segurança.\n<style=cMono>4...\nIniciando iluminação ambiente da sala...\n3...</style>\nPreparem-se para contemplar...\n<style=cMono>2...</style>\nAs maravilhas extraordinárias...\n<style=cMono>1...</style>\nDa eletricidade!\n<style=cMono>Anomalia de energia detectada...\nIniciando procedimento de reinicialização em 10.0...</style>",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_NAME": "Ritmo de Chir",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_PICKUP": "Torne-se um aspecto da velocidade.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SPEED_DESCRIPTION": "Aumenta a velocidade de movimento, de ataque e de recarga de habilidades.",
    "BORBO_ELITE_AFFIX_SPEED_MODIFIER": "{0} Consagrado",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_NAME": "Crença Fraturada",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_PICKUP": "Torne-se um aspecto da vaidade.",
    "BORBO_ELITE_EQUIPMENT_MIRRORED_DESCRIPTION": "Torne-se um aspecto da vaidade.",
    "BORBO_ELITE_MIRRORED_MODIFIER": "{0} Espelhado",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_NAME": "Concessão de N’Kuhana",
    "BORBO_ELITE_EQUIPMENT_AFFIX_LEECH_PICKUP": "Torne-se um aspecto da eternidade.",
    "BORBO_ELITE_AFFIX_LEECH_MODIFIER": "{0} Serpentino",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_NAME": "Olhar Abissal",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_PICKUP": "Torne-se um aspecto do simulacro",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SIMULATED_DESCRIPTION": "Uns atributos aumentados sei lá, kkk",
    "BORBO_ELITE_AFFIX_SIMULATED_MODIFIER": "{0} Simulado",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_NAME": "Refrão de Bava",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_PICKUP": "Torne-se um aspecto da força.",
    "BORBO_ELITE_EQUIPMENT_AFFIX_EXPLOSIVE_DESCRIPTION": "Todos os ataques são explosivos. Dispara um morteiro periodicamente.",
    "BORBO_ELITE_AFFIX_EXPLOSIVE_MODIFIER": "{0} Volátil",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_NAME": "Uma Força Adormecida",
    "BORBO_ELITE_EQUIPMENT_AFFIX_FLOOD_PICKUP": "Torne-se um aspecto do dilúvio.",
    "BORBO_ELITE_AFFIX_FLOOD_MODIFIER": "{0} Torrencial",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_NAME": "Olhar Distorcido",
    "BORBO_ELITE_EQUIPMENT_AFFIX_SQUALL_PICKUP": "Torne-se um aspecto da ventania.",
    "BORBO_ELITE_AFFIX_SQUALL_MODIFIER": "{0} Uivante",
    "ARTIFACT_AWESOMEPOT_NAME": "Artefato da Volatilidade",
    "ARTIFACT_AWESOMEPOT_DESCRIPTION": "Barris e potes explosivos são de Elite.",
    "ARTIFACT_FREELUNAR_NAME": "Artefato do Fanático",
    "ARTIFACT_FREELUNAR_DESCRIPTION": "Comece cada partida com um item lunar aleatório. Ao final de cada fase, um portal azul sempre aparece.",
    "ARTIFACT_QUICKSTART_NAME": "Artefato do Natimorto",
    "ARTIFACT_QUICKSTART_DESCRIPTION": "Comece sua partida com um item Incomum à sua escolha.",
    "ARTIFACT_RISKIERRAINSPIRIT_NAME": "Artefato do Espírito",
    "ARTIFACT_RISKIERRAINSPIRIT_DESCRIPTION": "Personagens correm e atacam mais rápido com pouca vida.",
    "ITEM_BARRIERONOVERHEAL_NAME": "Égide",
    "ITEM_BARRIERONOVERHEAL_PICKUP": "Ganha barreira em qualquer interação. Enquanto fora de perigo, a barreira para de decair.",
    "ITEM_BARRIERONOVERHEAL_DESC": "Usar qualquer interagível concede uma <style=cIsHealing>barreira temporária</style> de <style=cIsHealing>40.0 de vida</style> <style=cStack>(+40.0 por acúmulo)</style> mais <style=cIsHealing>10.0%</style> adicionais da <style=cIsHealing>vida máxima</style>. Enquanto fora de perigo, <style=cIsUtility>a barreira não decairá</style>.",
    "ITEM_GOLDONHIT_NAME": "Coroa Submersa",
    "ITEM_GOLDONHIT_PICKUP": "Roube de baús... <style=cIsHealth>ao custo de vida.</style>",
    "ITEM_GOLDONHIT_DESC": "Permite interagir com baús sem ter dinheiro suficiente para pagá-los, abrindo o baú <style=cIsUtility>sem gastar NENHUM dinheiro</style>. Roubar de baús custa <style=cIsHealth>[ 25% / 50% / 80% ]</style> da sua <style=cIsHealth>vida máxima</style>, dependendo do tamanho do baú. Pode roubar até 1 <style=cStack>(+1 por acúmulo)</style> vezes por fase.",
    "ITEM_REGENERATINGSCRAP_NAME": "Sucata Quimera",
    "ITEM_REGENERATINGSCRAP_PICKUP": "Priorizada ao ser usada com <style=cIsHealth>QUALQUER</style> Impressora 3D. Produz itens extras de raridades menores.",
    "ITEM_REGENERATINGSCRAP_DESC": "Não faz nada. Priorizada ao ser usada com <style=cIsHealth>QUALQUER</style> Impressora 3D. Cria <style=cStack>(</style> 10 <style=cStack>/</style> <style=cIsHealing>5</style> <style=cStack>/</style> <style=cIsHealth>2</style> <style=cStack>)</style> itens, <style=cIsUtility>dependendo da qualidade da impressora</style>.",
    "ITEM_GOLDONHURT_NAME": "Moedas de Chocolate",
    "ITEM_GOLDONHURT_PICKUP": "Inimigos derrubam um agrado que dá ouro e cura. Recarrega com o tempo.",
    "ITEM_GOLDONHURT_DESC": "Ao atingir, derruba uma moeda de chocolate que cura <style=cIsHealing>5.0 de vida</style> <style=cStack>(+5.0 por acúmulo)</style> mais <style=cIsUtility>1 de ouro</style> <style=cStack>(+1 por acúmulo)</style>. <style=cIsUtility>Escala com o tempo</style>. <style=cIsUtility>recarrega após 5.0 segundos.</style>",
    "ITEM_CRITDAMAGE_NAME": "Telescópio de Combate",
    "ITEM_CRITDAMAGE_PICKUP": "Aumenta a chance e o dano de 'Acerto Crítico' enquanto estiver parado.",
    "ITEM_CRITDAMAGE_DESC": "<style=cIsDamage>Acertos Críticos</style> causam <style=cIsDamage>100% de dano</style> adicional <style=cStack>(+100% por acúmulo)</style>. Ganha <style=cIsDamage>30% de chance de Acerto Crítico</style> após ficar parado por <style=cIsUtility>0.2</style> segundos.",
    "ITEM_REPEATHEAL_NAME": "Flor-Cadáver",
    "ITEM_REPEATHEAL_PICKUP": "Sua vida degenera com o tempo. Ganha barreira e sorte com pouca vida.",
    "ITEM_REPEATHEAL_DESC": "Para cada 12.5% de vida perdida, ganha Podridão. Após acumular 3 Podridões, aumenta o dano base em 4 <style=cStack>(+2 por acúmulo)</style>. Após 6 Podridões, ganha 50% de barreira e aumenta a Sorte em 2 <style=cStack>(+2 por acúmulo)</style>. <style=cIsHealth>Reduz a regeneração de vida base em -2 de vida/s</style> <style=cStack>(-2 por acúmulo)</style>.",
    "ITEM_HEALINGPOTION_NAME": "Elixir do Berserker",
    "ITEM_HEALINGPOTION_PICKUP": "Com pouca vida, ganha barreira, limpa efeitos negativos e reinicia todas as recargas. Utilizável uma vez por fase.",
    "ITEM_HEALINGPOTION_DESC": "Sofrer dano que reduza a vida para menos de <style=cIsHealth>25%</style> <style=cIsUtility>consome</style> este item, concedendo instantaneamente <style=cIsHealing>35%</style> da vida máxima em <style=cIsHealing>barreira</style> e <style=cIsUtility>reiniciando</style> todas as recargas. Cada garrafa vazia aumenta a velocidade de ataque em <style=cIsDamage>15%</style>, a velocidade de movimento em <style=cIsDamage>14%</style> e reduz as recargas em <style=cIsDamage>6%</style>. Regenera no início de cada fase.",
    "EQUIPMENT_MULTISHOPCARD_NAME": "Cartão Executivo",
    "EQUIPMENT_MULTISHOPCARD_PICKUP": "Hackeia um interagível selecionado. Multilojas hackeadas permanecem abertas.",
    "EQUIPMENT_MULTISHOPCARD_DESC": "Mire em um interagível para <style=cIsUtility>hackeá-lo</style>, desbloqueando seu conteúdo de <style=cIsUtility>graça</style>. Se o alvo for um terminal de <style=cIsUtility>multiloja</style>, os outros terminais <style=cIsUtility>permanecerão abertos</style>.",
    "ITEM_AUTOCASTEQUIPMENT_NAME": "Gesto do Afogado",
    "ITEM_AUTOCASTEQUIPMENT_PICKUP": "Aumenta muito o estoque de equipamento... <style=cIsHealth>MAS aumenta muito a recarga do equipamento.</style> Equipamentos podem ser ativados durante a recarga, <style=cIsHealth>com chance de quebrar.</style>",
    "ITEM_AUTOCASTEQUIPMENT_DESC": "Armazena <style=cIsUtility>4 cargas adicionais de equipamento</style> <style=cStack>(+2 por acúmulo)</style>... <style=cIsHealth>MAS aumenta a recarga do equipamento em +100%</style> <style=cStack>(+50% por acúmulo)</style>. Usar seu equipamento sem cargas faz uma <style=cIsUtility>sub-conjuração</style>, permitindo usá-lo <style=cIsHealth>com 40.0% de chance de quebrar</style>. <style=cIsUtility>Não é afetado pela sorte.</style>",
    "ITEM_BONUSGOLDPACKONKILL_NAME": "Tomo de Ghor",
    "ITEM_BONUSGOLDPACKONKILL_PICKUP": "Transmuta elites em ouro ao contato.",
    "ITEM_BONUSGOLDPACKONKILL_DESC": "Causa +100% de dano a elites Dourados. Tocar em qualquer inimigo de Elite o transmuta instantaneamente em um elite Dourado, ativando todos os efeitos ao abater. Não afeta inimigos Chefes.",
    "ITEM_SEED_NAME": "Semente Sanguessuga",
    "ITEM_FLATHEALTH_NAME": "Carne Fresca",
    "ITEM_FLATHEALTH_PICKUP": "Ganha vida fixa. Regenera vida após abater um inimigo.",
    "ITEM_FLATHEALTH_DESC": "Ganha 25<style=cStack>(+25 por acúmulo)</style> de vida. Aumenta a <style=cIsHealing>regeneração de vida base</style> em <style=cIsHealing>+2 de vida/s</style> por <style=cIsUtility>3s</style> <style=cStack>(+3s por acúmulo)</style> após abater um inimigo.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_NAME": "Mocha Matinal",
    "ITEM_ATTACKSPEEDANDMOVESPEED_PICKUP": "Ganha um impulso temporário de velocidade após iniciar uma fase.",
    "ITEM_ATTACKSPEEDANDMOVESPEED_DESC": "Por <style=cIsUtility>80</style> segundos após entrar em qualquer fase, aumenta a <style=cIsDamage>velocidade de ataque</style> e de <style=cIsDamage>movimento</style> em <style=cIsDamage>20%</style> <style=cStack>(+20% por acúmulo)</style>, e reduz as <style=cIsUtility>recargas de habilidade</style> em <style=cIsUtility>-12%</style> <style=cStack>(-12% por acúmulo)</style>. Ativar um interagível estende o efeito em <style=cIsUtility>20 segundos</style>.",
    "ITEM_EXTRASTATSONLEVELUP_NAME": "Contas de Oração",
    "ITEM_EXTRASTATSONLEVELUP_PICKUP": "Priorizadas ao serem usadas com Impressoras 3D <style=cIsHealing>Incomuns</style>. Aumentam permanentemente TODOS os atributos após a remoção.",
    "ITEM_EXTRASTATSONLEVELUP_DESC": "Priorizadas ao serem usadas com Impressoras 3D <style=cIsHealing>Incomuns</style>. Após a remoção, concedem permanentemente um aumento de 7% no <style=cIsUtility>ganho de experiência</style>, <style=cIsHealing>vida</style>, <style=cIsHealing>escudo</style>, <style=cIsHealing>regeneração</style> e <style=cIsDamage>dano</style>.",
    "ITEM_THORNS_NAME": "Arame Farpado",
    "ITEM_THORNS_PICKUP": "Retalie em uma explosão de lâminas sangrentas ao sofrer dano. Recarrega com o tempo.",
    "ITEM_THORNS_DESC": "Ser atingido faz você explodir em uma rajada de lâminas, aplicando <style=cIsDamage>sangramento</style> em até <style=cIsDamage>5.0</style> <style=cStack>(+2.0 por acúmulo)</style> inimigos próximos causando <style=cIsDamage>400%</style> de dano base por <style=cIsDamage>carga de lâmina</style> expelida. Você pode armazenar até 2 <style=cStack>(+1 por acúmulo)</style> cargas de lâmina, todas recarregando em <style=cIsUtility>5.0</style> segundos.",
    "ITEM_INCREASEHEALING_NAME": "Prateleira do Rejuvenescimento",
    "ITEM_INCREASEHEALING_PICKUP": "Armazena cura excedente para depois.",
    "ITEM_INCREASEHEALING_DESC": "Curar além da vida cheia <style=cIsHealing>armazena o excesso</style> em uma <style=cIsHealing>reserva de cura</style> com <style=cIsHealing>50%</style> <style=cStack>(+50% por acúmulo)</style> de eficiência, até <style=cIsHealing>30%</style> <style=cStack>(+0% por acúmulo)</style> da sua vida máxima. Quando ferido, cura <style=cIsHealing>10%</style> da sua <style=cIsHealing>vida por segundo</style>, consumindo a <style=cIsHealing>reserva de cura</style> até esvaziar.",
    "ITEM_LASERTURBINE_NAME": "Disco de Ressonância",
    "ITEM_LASERTURBINE_PICKUP": "Obtém um Disco de Ressonância carregado ao abater inimigos. Dispara automaticamente quando totalmente carregado.",
    "ITEM_LASERTURBINE_DESC": "Abater inimigos carrega o Disco de Ressonância. O disco se lança em direção a um alvo causando <style=cIsDamage>300%</style> de dano base <style=cStack>(+300% por acúmulo)</style>, perfurando todos os inimigos que não matar, e então explode causando <style=cIsDamage>1000%</style> de dano base <style=cStack>(+1000% por acúmulo)</style>. Em seguida, retorna ao usuário, atingindo todos os inimigos no caminho com <style=cIsDamage>300%</style> de dano base <style=cStack>(+300% por acúmulo)</style>.",
    "ITEM_SQUIDTURRET_NAME": "Pólipo de Lula",
    "ITEM_PARENTEGG_NAME": "Plânula",
    "ITEM_PARENTEGG_PICKUP": "O PODER INIGUALÁVEL DO SOL!",
    "ITEM_PARENTEGG_DESC": "Após iniciar o evento do teletransportador, <style=cIsDamage>invoca um sol acima</style> que dura <style=cIsDamage>10.0</style> segundos <style=cStack>(+5.0 por acúmulo)</style>. <style=cIsHealth>Todos os inimigos e aliados queimam perto do sol</style>.",
    "ITEM_FOCUSEDCONVERGENCE_NAME": "Convergência Focada",
    "ITEM_FOCUSEDCONVERGENCE_DESC": "Zonas de Retenção carregam <style=cIsUtility>100% <style=cStack>(+100% por acúmulo)</style> mais rápido</style>, mas são <style=cIsHealth>50% menores</style> <style=cStack>(-50% por acúmulo)</style>. Máximo de 5.",
    "ITEM_GHOSTONKILL_NAME": "Máscara Mais Feliz",
    "ITEM_GHOSTONKILL_PICKUP": "Assombra inimigos próximos, marcando-os para execução. Executar inimigos invoca um fantasma.",
    "ITEM_GHOSTONKILL_DESC": "<style=cIsDamage>Assombra</style> um inimigo aleatório que não seja chefe, marcando-o para Execução abaixo de <style=cIsHealth>25%</style> de vida. A Execução <style=cIsDamage>invoca um fantasma</style> do inimigo abatido com <style=cIsDamage>1500%</style> de dano, durando <style=cIsDamage>6.66s</style> <style=cStack>(+6.66s por acúmulo)</style> <style=cIsUtility>(o dobro para inimigos Assombrados)</style>.",
    "ITEM_MOVESPEEDONKILL_NAME": "Arpão do Caçador",
    "ITEM_MOVESPEEDONKILL_DESC": "Abater um inimigo aumenta a <style=cIsUtility>velocidade de movimento</style> em <style=cIsUtility>125%</style> por <style=cIsUtility>1</style> <style=cStack>(+1 por acúmulo)</style> segundo(s). Abates consecutivos aumentam a duração do efeito em até 25 segundos.",
    "ITEM_STRENGTHENBURN_PICKUP": "Seus efeitos de incêndio causam o triplo de dano.",
