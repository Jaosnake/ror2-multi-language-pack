        "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "稳定瞄准",
        "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "举枪瞄准，<style=cIsUtility>暴露敌人弱点</style>。<style=cIsDamage>瞄准时使用主要技能将发射当前手持枪械。</style>",
        "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "疾步",
        "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "短距离<style=cIsUtility>冲刺</style>。若在受击前及时用来<style=cIsUtility>躲避攻击</style>，则触发<style=cIsDamage>完美闪避</style>。",
        "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "乌洛波洛斯",
        "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "短距离<style=cIsUtility>冲刺</style>。若在受击前及时用来<style=cIsUtility>躲避攻击</style>，则触发<style=cIsDamage>完美闪避</style>。\n<color=#d299ff>权杖：乌洛波洛斯的力量在你体内涌动。</color>",
        "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "格挡",
        "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>格挡</style>一次攻击，<style=cIsDamage>抵消</style>伤害并<style=cIsUtility>返还冷却时间</style>。若提前精准格挡，则触发<style=cIsDamage>完美格挡</style>。",
        "ROB_HUNK_BODY_UTILITY_BASH_NAME": "肩撞",
        "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>猛撞</style>附近敌人，<style=cIsUtility>使其眩晕</style>并造成<style=cIsDamage>400%伤害</style>。若提前用来<style=cIsUtility>打断攻击</style>，则触发<style=cIsDamage>完美撞击</style>。",
        "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "军团",
        "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>切换</style>至另一把<style=cIsDamage>枪械</style>。轻按即可切回<style=cIsUtility>上一次手持的枪械</style>。",
        "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "战斗刀",
        "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "标准军用战斗刀，在紧要关头必定派得上用场。",
        "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "战斗刀 EX",
