    "ITEM_AGLET_NAME": "Ferret",
    "ITEM_AGLET_PICKUP": "Augmente la vitesse de déplacement au sol.",
    "ITEM_AGLET_DESCRIPTION": "Votre vitesse de déplacement augmente progressivement au sol, jusqu'à 30% (+30% par cumul) après 5 secondes.",
    "ITEM_BORBOBAKEDBEANS_NAME": "Les Haricots de la Tragédie",
    "ITEM_BORBOBAKEDBEANS_PICKUP": "Soigne instantanément à l'élimination. Les éliminations rapides soignent davantage.",
    "ITEM_BORBOBAKEDBEANS_DESCRIPTION": "À l'élimination, <style=cIsHealing>soigne 8 PV</style> <style=cStack>(+4 par cumul)</style>. Octroie également un <style=cIsUtility>bonus temporaire</style> qui augmente ce soin de <style=cIsHealing>12 par bonus</style> <style=cStack>(+6 par cumul)</style>, jusqu'à un maximum de <style=cIsUtility>4 fois.</style>",
    "ITEM_BORBOBAKEDBEANS_LORE": "Il n'y a rien dedans.",
    "ITEM_CHEFITEM_NAME": "Moustache de Chef",
    "ITEM_CHEFITEM_PICKUP": "Les ennemis en feu laissent tomber des morceaux de viande curative.",
    "ITEM_CHEFITEM_DESCRIPTION": "Octroie <style=cIsDamage>25% de chance d'enflammer</style>. Toucher des ennemis en feu a <style=cIsDamage>1%</style> de chance <style=cStack>(+1% par cumul)</style> de créer 2 <style=cIsHealing>nuggets curatifs</style> qui restaurent <style=cIsHealing>25.0 PV</style>. La chance de nugget augmente <style=cIsDamage>par cumul de brûlure</style>, jusqu'à <style=cIsDamage>10</style> fois.",
    "ITEM_BORBOFUSE_NAME": "Fusible Instable",
    "ITEM_BORBOFUSE_PICKUP": "Crée une nova étourdissante lorsque vos boucliers se brisent.",
    "ITEM_BORBOFUSE_DESCRIPTION": "Octroie <style=cIsHealing>25.0 de bouclier</style> <style=cStack>(+25.0 par cumul)</style>. Briser vos boucliers <style=cIsUtility>Électrocute</style> jusqu'à 3 <style=cStack>(+1 par cumul)</style> ennemis dans un rayon de <style=cIsUtility>40.0m</style> <style=cStack>(+4.0 par cumul)</style>. <style=cIsDamage>La durée de l'électrocution dépend de la santé du bouclier</style>.",
    "ITEM_NEARBYDEFENSE_NAME": "Collier Méduse",
    "ITEM_NEARBYDEFENSE_PICKUP": "Augmente l'armure et la régénération tant que des ennemis sont proches.",
    "ITEM_NEARBYDEFENSE_DESCRIPTION": "Augmente la régénération de santé de base de <style=cIsHealing>+1 PV/s</style> <style=cStack>(+1 PV/s par cumul)</style> et l'armure de <style=cIsHealing>+10</style> <style=cStack>(+10 par cumul)</style>. Pour chaque ennemi à moins de <style=cIsUtility>20m</style>, octroie aussi <style=cIsHealing>+0.5 PV/s</style> <style=cStack>(+0.5 PV/s par cumul)</style> de régénération de santé de base et <style=cIsHealing>+5</style> <style=cStack>(+5 par cumul)</style> d'armure, jusqu'à <style=cIsUtility>5</style> fois.",
    "ITEM_ICHORRED_NAME": "Ichor Métamorphique (Rouge)",
    "ITEM_ICHORRED_PICKUP": "Augmente la vitesse d'attaque et les chances de coup critique.",
    "ITEM_ICHORRED_DESCRIPTION": "Augmente la <style=cIsDamage>vitesse d'attaque</style> de <style=cIsDamage>7.5%</style> <style=cStack>(+7.5% par cumul)</style>. Augmente les <style=cIsDamage>chances de coup critique</style> de <style=cIsDamage>5%</style> <style=cStack>(+5% par cumul)</style>. <style=cIsVoid>Corrompt toutes les Plaques d'armure répulsive et les Ichors Jaunes</style>.",
    "ITEM_ICHORVIOLET_NAME": "Ichor Métamorphique (Violet)",
    "ITEM_ICHORVIOLET_PICKUP": "Octroie une barrière en subissant des dégâts. <style=cIsVoid>Corrompt tous les Kits de secours et les Ichors Rouges</style>.",
    "ITEM_ICHORVIOLET_DESCRIPTION": "Octroie <style=cIsHealing>22 de barrière</style> en subissant des dégâts <style=cStack>(+22 par cumul)</style>. <style=cIsVoid>Corrompt tous les Kits de secours et les Ichors Rouges</style>.",
    "ITEM_ICHORYELLOW_NAME": "Ichor Métamorphique (Jaune)",
    "ITEM_ICHORYELLOW_PICKUP": "Octroie de la régénération de santé. <style=cIsVoid>Corrompt toutes les Seringues de soldat et les Ichors Violets</style>.",
    "ITEM_ICHORYELLOW_DESCRIPTION": "Augmente la <style=cIsHealing>régénération de santé de base</style> de <style=cIsHealing>0.8 PV/s</style> <style=cStack>(+0.8 PV/s par cumul)</style>. <style=cIsVoid>Corrompt toutes les Seringues de soldat et les Ichors Violets</style>.",
    "ITEM_PHRYGIANLILY_NAME": "Lys Phrygien",
    "ITEM_PHRYGIANLILY_PICKUP": "Entrez en rage après avoir activé le téléporteur. <style=cIsVoid>Corrompt toutes les Pâquerettes à leptons.</style>",
    "ITEM_PHRYGIANLILY_DESCRIPTION": "<style=cIsDamage>Entrez en rage</style> pendant 20 secondes lors de l'activation du téléporteur. En rage, augmente la vitesse d'attaque de +30% <style=cStack>(+15% par cumul)</style> et réduit les temps de recharge des compétences de 30% <style=cStack>(15% par cumul)</style>.",
    "ITEM_HEALFROMBLEEDINGENEMIES_NAME": "Corallite Sangsue",
    "ITEM_HEALFROMBLEEDINGENEMIES_PICKUP": "Les ennemis qui saignent vous soignent à l'impact. Corrompt toutes les Graines sangsues.",
    "ITEM_HEALFROMBLEEDINGENEMIES_DESCRIPTION": "Octroie <style=cIsHealth>10% de chance de saignement</style>. Les ennemis qui saignent vous soignent de <style=cIsDamage>+0.2 PV</style> à l'impact <style=cIsHealth>par cumul de saignement</style>, jusqu'à un maximum de 2 <style=cStack>(+1 par cumul)</style> PV. <style=cIsVoid>Corrompt toutes les Graines sangsues.</style>",
    "ITEM_WICKEDBAND_NAME": "Anneau Pervers",
    "ITEM_WICKEDBAND_PICKUP": "Les coups à forts dégâts réduisent les temps de recharge d'1 seconde.",
    "ITEM_WICKEDBAND_DESCRIPTION": "Les coups infligeant <style=cIsDamage>plus de 400% de dégâts</style> <style=cIsUtility>réduisent également TOUS les temps de recharge de 1.0s</style> <style=cStack>(+1.0 par cumul)</style>. <style=cIsHealth>1.0 seconde de recharge.</style>",
    "ITEM_GALLERY_ITEM_DROP_NAME": "Objet de la Galerie",
    "ITEM_GALLERY_ITEM_DROP_PICKUP": "Vous ne devriez pas voir ça mdr",
    "ITEM_GALLERY_ITEM_DROP_DESCRIPTION": "Vous ne devriez pas voir ça mdr",
    "ITEM_HEALTHUP_NAME": "HealthUp",
    "ITEM_AOEONCRIT_NAME": "Hypo-Enfileur",
    "ITEM_AOEONCRIT_PICKUP": "Les « Coups Critiques » tirent une chaîne laser.",
    "ITEM_AOEONCRIT_DESCRIPTION": "Octroie <style=cIsDamage>5% de chance critique</style>. Les <style=cIsDamage>coups critiques</style> tirent un <style=cIsDamage>laser rebondissant</style> infligeant <style=cIsDamage>60%</style> <style=cStack>(+20% par cumul)</style> des dégâts TOTAUX sur jusqu'à <style=cIsDamage>1 <style=cStack>(+1 par cumul)</style> ennemis</style>.",
    "ITEM_AOEONCRIT_LORE": "Espèce d'idiot ! Ces trucs sont censés être INCASSABLES. Comment diable as-tu réussi à faire ça ?\r\n\r\nMec... Désolé de te l'apprendre, mais les hyper-enfileurs coûtent trois fois rien. Ça va te coûter des broutilles d'en racheter un. Tu t'es déjà demandé pourquoi ?\r\n\r\nJ'en ai rien à foutre, mec. Ce truc fonctionne à peine maintenant. Si quelqu'un doit m'en acheter un neuf, c'est TOI.\r\n\r\nHaha, mec, euh, tu crois que je suis fait en billets ? Je euh-\r\n\r\nJe te l'ai dit. J'en. Ai. Rien. À. FOUTRE.",
    "ITEM_BORBOBIGBATTERY_NAME": "Batterie AAAAAAA",
    "ITEM_BORBOBIGBATTERY_PICKUP": "Augmente la vitesse de recharge du bouclier. Tant que les boucliers sont actifs, octroie un bonus de vitesse d'attaque.",
    "ITEM_BORBOBIGBATTERY_DESCRIPTION": "Octroie un <style=cIsHealing>bouclier</style> égal à <style=cIsHealing>4%</style> de votre santé maximale. Réduit le <style=cIsUtility>délai de recharge du bouclier</style> de <style=cIsUtility>1.0s</style>. Tant que les boucliers sont actifs, augmente la <style=cIsDamage>vitesse d'attaque</style> de <style=cIsDamage>20%</style> <style=cStack>(+20% par cumul)</style>.",
    "ITEM_BORBOBIGBATTERY_LORE": "Commande : Batterie Prototype\r\nNuméro de suivi : 11***********\r\nLivraison estimée : 06/05/2056\r\nMode d'expédition : Prioritaire\r\nAdresse de livraison : Station de Recherche Palia, Soleil\r\nDétails de l'envoi :\r\n\r\nBon, que penses-tu de celle-ci ?\r\n\r\nOn a euh,\r\n\r\n*ricanement*\r\n\r\nEuh, on a relu tes notes sur le dernier prototype, et, euh\r\n\r\n(bavardages en fond)\r\n\r\nOn a légèrement ajusté les dimensions\r\n\r\n*ricanement*\r\n\r\nMaintenant, elle est un peu plus longue que ton machin générateur, mais, euh\r\n\r\n(rires étouffés)\r\n\r\nOn a aussi dessiné ce petit, euh, connecteur…\r\n\r\n(Fermez-la les gars)\r\n\r\nEuh, bref, tu peux juste, genre, l'enfoncer droit dedans, comme dans la vidéo de démo\r\n\r\n(bruits de pas lourds)\r\n\r\nEt franchement je crois qu'on tient,\r\n\r\n*ricanement*\r\n\r\nJe crois qu'on tient vraiment un truc, mec\r\n\r\nGenre, ça pourrait être la euh\r\n\r\nLa nouvelle alimentation standard\r\n\r\n*ricanement*\r\n\r\nTu vois ?",
    "ITEM_BINARYSHIELD_NAME": "Péréiopode Blindé",
    "ITEM_BINARYSHIELD_PICKUP": "Augmente la vitesse de déplacement lorsque les boucliers sont épuisés.",
    "ITEM_BINARYSHIELD_DESCRIPTION": "Octroie <style=cIsHealing>25.0 de bouclier</style> et <style=cIsUtility>5% <style=cStack>(+19% par cumul)</style> de vitesse de déplacement</style>. Lorsque les boucliers sont épuisés, augmente la <style=cIsUtility>vitesse de déplacement</style> de <style=cIsUtility>19%</style> <style=cStack>(+19% par cumul)</style>. <style=cIsVoid>Corrompt tous les Sabots de chèvre de Paul.</style>",
    "ITEM_BIRDBAND_NAME": "Objet du Dev",
    "ITEM_BIRDBAND_PICKUP": "Les coups à forts dégâts vous rendent également Régénératif pendant une courte durée. Se recharge avec le temps.",
    "ITEM_BIRDBAND_DESCRIPTION": "Les coups infligeant <style=cIsDamage>plus de 400% de dégâts</style> vous rendent également <style=cIsHealing>Régénératif</style> pendant <style=cIsDamage>1.5 secondes</style> <style=cStack>(+0.75 secondes par cumul)</style>, restaurant <style=cIsHealing>10% de votre santé maximale</style> par seconde. Se recharge toutes les 7 secondes.",
    "ITEM_BIRDBAND_LORE": "« Je te jure qu'ils sont réels. »\r\n\r\n« N'importe quoi, mec. C'est ridicule même pour une histoire de fantômes. »\r\n\r\n« Si ! “Encore plus hauts que les dieux eux-mêmes” ? Sois sérieux. »\r\n\r\n« J'ai vu des preuves, je te dis. Des trucs qui défient toute explication. »\r\n\r\n« Oh, raconte. Je suis suspendu à tes lèvres. »\r\n\r\n« Tu connais ces lance-missiles ? Ceux qui tiraient une énorme roquette ? Pourquoi ils se sont mis à vomir ces petits dards tout d'un coup ? »\r\n\r\n« J'sais pas. »\r\n\r\n« C'était eux. Ils l'ont réécrit. Et— et tout ce matos qui a juste disparu, comme s'il n'avait jamais existé. Et toutes nos fournitures médicales qui sont soudainement devenues bien moins efficaces. T'as remarqué que tous les monstres tapent moins fort qu'avant ? »\r\n\r\n« Mec… »\r\n\r\n« C'est réel, je te dis ! Et toutes nos combinaisons sont devenues tellement… pataudes. D'un seul coup. Alors qu'elles n'ont rien. »\r\n\r\n« ... »\r\n\r\n« Et mon wungus ne soigne plus qu'un seul PV maintenant. »\r\n\r\n« Mec. Mais de quoi tu parles bordel ? »\r\n\r\n« Il a perdu la boule. »",
    "ITEM_CLOUDBOTTLE_NAME": "Nuage en Bouteille",
    "ITEM_CLOUDBOTTLE_PICKUP": "Faites un double saut près des ennemis pour les étourdir !",
    "ITEM_CLOUDBOTTLE_DESCRIPTION": "Octroie une charge de saut aérien. <style=cIsUtility>15</style>s de recharge. Lorsqu'elle est prête, sauter en l'air à moins de <style=cIsUtility>9.0m</style> <style=cStack>(+9.0m par cumul)</style> d'un ennemi lâche une <style=cIsUtility>bombe fumigène</style>, les <style=cIsDamage>étourdissant</style> pendant <style=cIsDamage>1.0s</style> et réduisant la recharge de <style=cIsUtility>10s.</style>",
    "ITEM_FARTBOTTLE_NAME": "Contaminant en Quarantaine",
    "ITEM_FARTBOTTLE_PICKUP": "Faire un double saut près des ennemis les affaiblit et les blesse. <style=cIsVoid>Corrompt tous les Nuages en Bouteille.</style>",
    "ITEM_FARTBOTTLE_DESCRIPTION": "Octroie une charge de saut aérien. Lorsqu'elle est prête, sauter en l'air à moins de <style=cIsUtility>11.0m</style> d'un ennemi produit un <style=cIsDamage>gaz toxique</style>, infligeant <style=cIsDamage>200%</style> de dégâts de base <style=cStack>(+100% par cumul)</style> par seconde et Affaiblissant les ennemis à l'intérieur. Ne peut pas être réactivé pendant <style=cIsUtility>4</style>s. <style=cIsVoid>Corrompt tous les Nuages en Bouteille.</style>",
    "ITEM_CHICKEN_NAME": "Poulet Cru",
    "ITEM_CHICKEN_PICKUP": "Augmente la santé maximale. Essayez de le garder dans l'estomac !",
    "ITEM_CHICKEN_DESCRIPTION": "Augmente votre <style=cIsHealing>santé maximale</style> de <style=cIsHealing>30%</style> <style=cStack>(+30% par cumul)</style>. <style=cIsHealing>Subissez une intoxication alimentaire</style>, réduisant votre <style=cIsHealing>régénération de santé de base</style> de <style=cIsHealing>-2.0 PV/s</style> pendant 120 secondes.",
    "ITEM_DISCOUNTCARDNEW_NAME": "Carte de Fidélité",
    "ITEM_DISCOUNTCARDNEW_PICKUP": "Les terminaux de boutique remboursent de l'argent et restent ouverts. Utilisable deux fois.",
    "ITEM_DISCOUNTCARDNEW_DESCRIPTION": "Lors d'un achat sur des terminaux <style=cIsUtility>multiboutique</style>, les autres terminaux <style=cIsUtility>restent ouverts</style>, remboursant <style=cIsUtility>$20</style>. Utilisable jusqu'à deux fois.",
    "ITEM_BOSSITEMCONSUMABLE_NAME": "Scalpel d'Obsidienne",
    "ITEM_BOSSITEMCONSUMABLE_PICKUP": "Les grands monstres ont bien plus de chances de laisser un trophée. Consommé à l'obtention.",
    "ITEM_BOSSITEMCONSUMABLE_DESCRIPTION": "Tuer des ennemis capables de laisser des <style=cIsDamage>objets trophées</style> confère <style=cIsUtility>50%</style> de chance supplémentaire de laisser le <style=cIsDamage>trophée</style>. Consommé après une utilisation réussie.",
    "ITEM_BOSSITEMCONSUMABLE_LORE": "Commande : Scalpel Médical (Obsidienne)\r\nNuméro de suivi : 91***********\r\nLivraison estimée : 30/09/2056\r\nMode d'expédition : Prioritaire/Fragile\r\nAdresse de livraison : Mont Goliath, Mars\r\nDétails de l'envoi :\r\n\r\nFabriqué sur mesure selon vos spécifications. Très tranchant. L'épaisseur de la lame se mesure en longueurs de Planck. Cela coupera assurément tout ce dont vous aurez besoin.\r\nJe ne peux toutefois pas garantir sa durabilité. Essayez de réussir du premier coup.\r\nEt encore une chose : quand il se brisera, il n'attendra pas la fin de votre opération. Ne l'utilisez sur rien que vous tenez à ne pas endommager. Ou tuer.\r\nMais vous saviez déjà tout cela. Je ne peux m'empêcher de me demander pourquoi vous continuez à commander ces choses.",
    "ITEM_EGG_NAME": "Œuf",
    "ITEM_EGG_PICKUP": "Augmente légèrement la santé. Lance une chasse aux œufs.<style=cIsVoid>Corrompt la plupart des denrées et matières animales</style>.",
    "ITEM_EGG_DESCRIPTION": "Octroie <style=cIsHealing>5 PV maximum</style>. <style=cIsUtility>Lance une chasse aux œufs</style>. <style=cIsVoid>Corrompt toutes les Infusions, Steaks de bison et Têtes d'extraterrestre</style>.",
    "ITEM_EGG_LORE": "cet œuf est putain de délicieux",
    "ITEM_FROZENSHELL_NAME": "Carapace de Tortue Gelée",
    "ITEM_FROZENSHELL_PICKUP": "Réduit les dégâts subis lorsque votre santé est basse.",
    "ITEM_FROZENSHELL_DESCRIPTION": "<style=cIsHealing>Augmente la santé maximale</style> de <style=cIsHealing>8%</style> <style=cStack>(+8% par cumul)</style>. Pour chaque <style=cIsHealth>10% de santé maximale</style> manquante, octroie <style=cIsHealing>5</style> <style=cStack>(+5 par cumul)</style> d'armure supplémentaire.",
    "ITEM_GAMMAKNIFE_NAME": "Couteau Gamma",
    "ITEM_GAMMAKNIFE_PICKUP": "Tuer des champions réduit définitivement les temps de recharge et garantit temporairement les Coups Critiques. <style=cIsVoid>Corrompt tous les Scalpels d'Obsidienne.</style>",
    "ITEM_GAMMAKNIFE_DESCRIPTION": "Tuer un <style=cIsDamage>Champion</style> augmente vos <style=cIsDamage>chances de Coup Critique</style> de <style=cIsDamage>100%</style> pendant <style=cIsDamage>9.0</style> secondes ET augmente <style=cIsHealth>définitivement</style> votre <style=cIsUtility>armure</style> de <style=cIsUtility>5</style> et réduit tous les <style=cIsDamage>temps de recharge des compétences</style> de <style=cIsDamage>-5%</style>, jusqu'à <style=cIsUtility>9</style> <style=cStack>(+9 par cumul)</style> fois. <style=cIsVoid>Corrompt tous les Scalpels d'Obsidienne.</style>",
    "ITEM_GOLDEN_EGG_NAME": "Œuf Doré",
    "ITEM_GOLDEN_EGG_PICKUP": "Parfois, les rêves deviennent réalité...",
    "ITEM_GOLDEN_EGG_DESCRIPTION": "Au début de la prochaine étape, un œuf doré éclora en un objet du vide.",
    "ITEM_BORBODISCOUNT_NAME": "Anneau Avide",
    "ITEM_BORBODISCOUNT_PICKUP": "Octroie de l'argent supplémentaire et de la régénération après l'ouverture de coffres.",
    "ITEM_BORBODISCOUNT_DESCRIPTION": "Après avoir dépensé de l'<style=cIsDamage>argent</style>, obtenez un <style=cIsDamage>Remboursement</style> pendant 20.0 secondes. Tant que votre <style=cIsDamage>Remboursement</style> est actif, augmente les revenus de 15% <style=cStack>(+7.5% par cumul)</style> et la <style=cIsHealing>régénération de santé de base</style> de <style=cIsHealing>3.0 PV/s</style> <style=cStack>(+3.0 PV/s par cumul)</style>.",
    "ITEM_BORBODISCOUNT_LORE": "Commande : Chercheur de Coupons Mapel (Lite)\r\nNuméro de suivi : 06***********\r\nLivraison estimée : 04/11/2056\r\nMode d'expédition : Prioritaire\r\nAdresse de livraison : 308, Station Belfast, Terre\r\nDétails de l'envoi :\r\n\r\nVoilà pour vous. Comme promis, il inspecte (légalement bien sûr) le code des achats électroniques pour trouver des codes promo et des réductions et les appliquer à l'achat, sans aucune saisie utilisateur ! C'est très légal.\r\nC'est peut-être un peu bancal en pratique, puisqu'il faut avoir la somme complète sous la main et que les codes ne sont pas forcément les meilleurs proposés. Raisons légales, naturellement. Oh, et il y a une limite au nombre d'achats possibles — il faut attendre un peu qu'il se rafraîchisse si vous voulez ces coupons.\r\nBien sûr, vous pouvez toujours acheter la version premium pour des réductions illimitées~\r\n",
    "ITEM_KALEIDOSKULL_NAME": "Kaléidocrâne",
    "ITEM_KALEIDOSKULL_PICKUP": "Les Coups Critiques infligent un malus aléatoire. <style=cIsVoid>Corrompt tous les Instincts de prédateur.</style>",
    "ITEM_KALEIDOSKULL_DESCRIPTION": "Octroie <style=cIsDamage>5% de chance critique</style>. Les <style=cIsDamage>coups critiques</style> appliquent aléatoirement <style=cIsDamage>Enflammer</style> ou <style=cIsUtility>Givre</style>. A également 50% de chance d'infliger <style=cIsUtility>1</style> <style=cStack>(+1 par cumul)</style> malus aléatoires. <style=cIsVoid>Corrompt tous les Instincts de prédateur.</style>",
    "ITEM_LIGHTNINGATTRACTOR_NAME": "Fourchette en Cuivre",
    "ITEM_LIGHTNINGATTRACTOR_PICKUP": "Attire la foudre lors de coups répétés.",
    "ITEM_LIGHTNINGATTRACTOR_DESCRIPTION": "Les dégâts de toute <style=cIsDamage>compétence ou équipement</style> plantent aussi une fourchette en cuivre dans l'ennemi pendant <style=cIsUtility>3.0</style> secondes. Attaquer à répétition un ennemi embroché réinitialise la durée de la fourchette et attire la foudre, <style=cIsDamage>Étourdisant</style> un ennemi proche pour <style=cIsDamage>300% de dégâts de base</style> <style=cStack>(+300% par cumul)</style>. 1 max, se recharge <style=cIsUtility>5.0s</style> après l'expiration de la fourchette.",
    "ITEM_LIGHTNINGATTRACTOR_LORE": "Nouveau chez CuCo !\r\n\r\nLa ménagère CopperWare offre d'innombrables avantages par rapport à vos banals couverts en acier inoxydable.\r\n\r\nUne élégante couleur brun rougeâtre assortie à votre vaisselle, et le complément parfait pour votre batterie de cuisine CuCo CopperWare !\r\n\r\nUn apport supplémentaire en cuivre directement via vos couverts !\r\n\r\nNettoyage facile ! Un simple frottage avec n'importe quel acide ménager comme du vinaigre ou du jus de citron redonnera à votre CopperWare son éclat d'usine !\r\n\r\nEssayez CopperWare dès aujourd'hui !\r\n\r\nAVERTISSEMENTS PRODUIT\r\n\r\nPour éviter tout risque de corrosion galvanique, ne laissez pas CopperWare entrer en contact avec d'autres surfaces métalliques, en particulier en présence d'électrolytes comme le sel.\r\n\r\nN'utilisez pas d'ustensiles CopperWare pour cuisiner. Cela présente un risque important de brûlure et peut libérer du cuivre dans le plat.\r\n\r\nL'utilisation de CopperWare est déconseillée aux clients de plus de 65 ans en raison de liens entre le cuivre et la maladie d'Alzheimer.\r\n\r\nEn raison de la haute conductivité électrique du cuivre, il est recommandé de ne pas utiliser de produits CopperWare à proximité de courants ou d'appareils électriques.\r\n\r\nPour limiter le risque d'électrocution mortelle, veuillez ne pas utiliser de produits CopperWare lors de repas en extérieur.\r\n\r\nEn acceptant d'acheter et d'utiliser ce produit, CuCo est dégagé de toute responsabilité concernant les réclamations liées à la nature des ustensiles de cuisine en cuivre.",
    "ITEM_LOWHEALTHREGEN_NAME": "Chanterelle Charmante",
    "ITEM_LOWHEALTHREGEN_PICKUP": "Augmente la régénération, mais ne pousse qu'en dessous de 60% de santé !",
    "ITEM_LOWHEALTHREGEN_DESCRIPTION": "Sous <style=cIsHealing>60% de santé maximale</style>, augmente la <style=cIsHealing>régénération de santé de base</style> de <style=cIsHealing>+2.0 PV/s</style> <style=cStack>(+2.0 PV/s par cumul)</style>.",
    "ITEM_LUNARBRAND_NAME": "Marque de Feu Stellaire",
    "ITEM_LUNARBRAND_PICKUP": "Cautérise les ennemis en feu, infligeant de lourds dégâts <style=cIsHealth>ET effaçant tous leurs malus.</style>",
    "ITEM_LUNARBRAND_DESCRIPTION": "Octroie <style=cIsDamage>20%</style> de chance d'<style=cIsDamage>Enflammer</style> à l'impact. Infliger <style=cIsDamage>5</style> cumuls de brûlure Cautérise les ennemis pendant <style=cIsDamage>5</style> secondes <style=cStack>(+5 par cumul)</style>, infligeant <style=cIsDamage>900%</style> <style=cStack>(+450% par cumul)</style> de dégâts. De plus, Cautériser ralentit les ennemis de 50% et annule tout soin, <style=cIsHealth>MAIS... Les ennemis cautérisés sont purgés de tous leurs malus et gagnent +30 d'armure.</style>",
    "ITEM_LUNARINCREASECD_NAME": "Boucle de Compression",
    "ITEM_LUNARINCREASECD_PICKUP": "Toutes les compétences tirent des éclats lunaires... <style=cIsHealth>MAIS toutes les compétences ont des temps de recharge augmentés</style>",
    "ITEM_LUNARINCREASECD_DESCRIPTION": "À chaque utilisation de compétence, tire des <style=cIsDamage>éclats lunaires</style> pour <style=cIsDamage>160% de dégâts</style> (augmente avec le temps de recharge de la compétence). <style=cIsHealth>Augmente le temps de recharge de toutes les compétences de 1.0 seconde</style> <style=cStack>(+1.0 par cumul)</style>.",
    "ITEM_MAGICQUIVER_NAME": "Carquois Magique",
    "ITEM_MAGICQUIVER_PICKUP": "Utiliser des compétences a une chance de ne pas consommer de charge.",
    "ITEM_MAGICQUIVER_DESCRIPTION": "Confère <style=cIsDamage>10.0%</style> <style=cStack>(+10.0% par cumul)</style> de chance de ne pas consommer une charge lors du lancement d'une compétence. <style=cIsUtility>Insensible à la chance</style>.",
    "ITEM_BORBOMANAFLOWER_NAME": "Don de la Nature",
    "ITEM_BORBOMANAFLOWER_PICKUP": "Augmente légèrement la vitesse d'attaque et réduit les temps de recharge Primaire et Secondaire.",
    "ITEM_BORBOMANAFLOWER_DESCRIPTION": "Augmente la <style=cIsDamage>vitesse d'attaque</style> de <style=cIsUtility>8%</style> <style=cStack>(+8% par cumul)</style>, et réduit les <style=cIsUtility>temps de recharge des compétences Primaire et Secondaire</style> de <style=cIsUtility>8%</style> <style=cStack>(+8% par cumul)</style>.",
    "ITEM_BORBOMANAFLOWER_LORE": "Commande : Rose de Jupiter\r\nNuméro de suivi : 58***********\r\nLivraison estimée : 30/07/2056\r\nMode d'expédition : Standard\r\nAdresse de livraison : 280 Oak Boulevard, Vénus\r\nDétails de l'envoi :\r\n\r\nN'est-elle pas jolie ?\r\nRien que la regarder me remplit d'énergie.\r\nLa nature est tellement magique :)",
    "ITEM_MINIAMETHYST_NAME": "Fragment d'Améthyste",
    "ITEM_MINIAMETHYST_PICKUP": "Activer votre Équipement réduit les temps de recharge de vos compétences.",
    "ITEM_MINIAMETHYST_DESCRIPTION": "Activer votre Équipement réduit <style=cIsUtility>tous les temps de recharge des compétences</style> de <style=cIsUtility>10%</style> <style=cStack>(+10% par cumul)</style> du temps de recharge de base de votre Équipement.",
    "ITEM_DANGERCRIT_NAME": "Le Nouveau Lopper",
    "ITEM_DANGERCRIT_PICKUP": "Augmente massivement les dégâts des « Coups Critiques » à faible santé.",
    "ITEM_DANGERCRIT_DESCRIPTION": "Octroie <style=cIsDamage>20% de chance critique.</style> Passer sous <style=cIsHealth>50% de santé</style> vous plonge dans une frénésie, augmentant les <style=cIsDamage>dégâts des coups critiques de 250%</style> <style=cStack>(+250% par cumul)</style> et les <style=cIsDamage>chances de coup critique de 30%</style>. Tuer des ennemis <style=cIsDamage>prolonge</style> la frénésie de <style=cIsDamage>4.0 secondes</style>.",
    "ITEM_DANGERCRIT_LORE": "Nom : [CENSURÉ]\r\nDate de naissance : 21 juin 1961\r\nProfession : Bourreau\r\n\r\nHeure du décès : 23 août 2058\r\nLieu du décès : [CENSURÉ], Mercure\r\nCause du décès : Hémorragie sévère due à une mutilation corporelle\r\n\r\nNotes :\r\nUne hache en état impeccable a été retrouvée près du corps. L'examen a déterminé que l'arme était extrêmement résistante à l'usure comme aux taches, en particulier de sang. La fabrication de la hache correspond à celle d'un forgeron sur Sues Drive, Jupiter, avec qui [CENSURÉ] était en contact peu avant sa mort.\r\n\r\n[CENSURÉ] a commis 126 homicides connus dans l'heure précédant sa mort. Toutes les victimes ont été tuées par décapitation sans aucune autre blessure. Des témoins rapportent que [CENSURÉ] s'est accidentellement frappé lui-même et s'est tranché le corps en deux à la taille, se vidant de son sang quelques instants plus tard.\r\n\r\nL'autopsie révèle une dégradation des organes internes antérieure au décès de [CENSURÉ]. Les symptômes semblent correspondre à certaines souches de [CENSURÉ] trouvées sur Jupiter. Aucune dégradation n'a été trouvée dans le cerveau, mais il est possible que la maladie ait influencé son état mental.\r\n",
    "ITEM_GOODEXECUTIONITEM_NAME": "Pergélisol",
    "ITEM_GOODEXECUTIONITEM_PICKUP": "Chance de Geler les ennemis sur les coups lourds, les tuant instantanément à faible santé.",
    "ITEM_GOODEXECUTIONITEM_DESCRIPTION": "<style=cIsDamage>3.0%</style> <style=cStack>(+2.0% par cumul)</style> de chance à l'impact <style=cIsDamage>par % de santé maximale ennemie infligé en dégâts</style> de <style=cIsUtility>Geler</style> les ennemis sur place pendant <style=cIsUtility>1.5 secondes. </style>Les ennemis gelés sont <style=cIsHealth>tués instantanément</style> à faible santé.",
    "ITEM_PHOTOGRAPH_NAME": "Photographie",
    "ITEM_PHOTOGRAPH_PICKUP": "Imprimer des objets augmente les chances et les dégâts de coup critique. Réinitialisé au début de chaque étape.",
    "ITEM_PHOTOGRAPH_DESCRIPTION": "Dépenser des objets dans n'importe quelle imprimante augmente les <style=cIsDamage>chances de coup critique</style> et les <style=cIsDamage>dégâts des coups critiques</style> de <style=cIsDamage>+10.0%</style> <style=cStack>(+5.0% par cumul)</style>, jusqu'à <style=cIsUtility>3 fois</style> <style=cStack>(+0 par cumul)</style>. Réinitialisé au début de chaque étape.",
    "ITEM_PHOTOGRAPH_LORE": "Tu as fait imprimer tes photos ?\n\n\"Bogos binted ?\"\n\nHein ?\n\n\"Télécharge GreenAlienHead\"",
    "ITEM_CHARGEDMALACHITESPINE_NAME": "Épine de Malachite Chargée",
    "ITEM_CHARGEDMALACHITESPINE_PICKUP": "Empoisonnez-vous lorsque vos boucliers se brisent, gagnant une grande résistance aux dégâts.",
    "ITEM_CHARGEDMALACHITESPINE_DESCRIPTION": "Octroie <style=cIsHealing>50.0 de bouclier</style> <style=cStack>(+50.0 par cumul)</style>. Tant que vous êtes empoisonné, octroie <style=cIsHealing>200.0 d'armure</style>. <style=cIsHealth>Le poison est infligé pendant 5.0 secondes lors de la rupture du bouclier</style> <style=cStack>(+5.0 secondes par cumul)</style>.",
    "ITEM_WISHBONE_NAME": "Bréchet",
    "ITEM_WISHBONE_PICKUP": "Se brise pendant les tempêtes. S'il est apporté au Téléporteur, un vœu sera exaucé.",
    "ITEM_WISHBONE_DESCRIPTION": "Se brise pendant les tempêtes. S'il est apporté au Téléporteur, un vœu sera exaucé.",
    "ITEM_WISHBONE_LORE": "looooorrrreeeeeeee",
    "ITEM_RANDOMBARRIERTARGET_NAME": "Boule de Cristal",
    "ITEM_RANDOMBARRIERTARGET_PICKUP": "Met en évidence un ennemi proche. Octroie une barrière et des chances de coup critique à l'impact.",
    "ITEM_RANDOMBARRIERTARGET_DESCRIPTION": "Réduit la décroissance de la barrière de <style=cIsHealing>-20%</style>. <style=cIsDamage>Met en évidence</style> un ennemi aléatoire. Attaquer l'ennemi ciblé octroie une <style=cIsHealing>barrière temporaire</style> de <style=cIsHealing>8.0 PV</style> <style=cStack>(+8.0 par cumul)</style> et augmente les <style=cIsDamage>chances de coup critique</style> de <style=cIsDamage>+20.0%</style> <style=cStack>(+10.0% par cumul)</style>.",
    "ITEM_RANDOMBARRIERTARGET_LORE": "Commande : Boule de Cristal\r\nNuméro de suivi : 66***********\r\nLivraison estimée : 06/05/2056\r\nMode d'expédition : Retour\r\nAdresse de livraison : Arcane Suppliers Inc., La Citadelle Flottante, Neptune\r\nDétails de l'envoi :\r\n\r\nJe vous ai commandé ce Globe de Présage et, par mes dieux, je n'achèterai JAMAIS plus rien chez vous. C'est une putain d'ARNAQUE !!!\r\n\r\nJ'ai essayé pendant des HEURES de faire en sorte que cette boule me montre QUOI QUE CE SOIT, et pas une seule fois je n'ai reçu un instant de clairvoyance divine.\r\n\r\nEt croyez-moi, je SAIS que je suis éclairé, je suis BIEN PLUS éclairé que n'importe laquelle de vos FOUTUES FOUINES chez Arcane ARNAQUEURS. Ne me dites pas putain que je ne suis pas assez éclairé.\r\n\r\nVotre boule de cristal, ou plutôt de plastique, m'a coûté plus que TOUTES les économies de ma vie. J'EXIGE MON REMBOURSEMENT, OU VOUS SUBIREZ DE TERRIBLES CONSÉQUENCES !!!",
    "ITEM_SHIELDAMP_NAME": "Pierre Claquante",
    "ITEM_SHIELDAMP_PICKUP": "Tant que les boucliers sont pleins, votre prochaine attaque draine un peu de bouclier pour amplifier les dégâts.",
    "ITEM_SHIELDAMP_DESCRIPTION": "Octroie <style=cIsHealing>40 de bouclier</style>. Tant que les boucliers sont pleins, <style=cIsDamage>amplifie</style> les dégâts des compétences. Les coups <style=cIsDamage>Amplifiés</style> <style=cIsDamage>drainent 40%</style> de votre bouclier maximal <style=cStack>(-8% par cumul)</style>, infligeant <style=cIsDamage>+400% de dégâts DE BASE</style> <style=cStack>(+250% par cumul)</style>. Les dégâts amplifiés se propagent à <style=cIsDamage>2</style> ennemis proches.",
    "ITEM_STARVEIL_NAME": "Voile Stellaire",
    "ITEM_STARVEIL_PICKUP": "Subir des dégâts vous rend invincible... <style=cIsHealth>MAIS des météores tomberont à proximité, blessant ennemis et alliés.</style>",
    "ITEM_STARVEIL_DESCRIPTION": "Après avoir été touché, vous devenez <style=cIsUtility>invincible à tous les dégâts subis</style> pendant 0.33 <style=cStack>(+0.33 par cumul)</style> secondes. Ensuite, fait tomber du ciel 3 <style=cStack>(+2 par cumul)</style> <style=cIsDamage>vagues de météores</style>, <style=cIsHealth>infligeant à TOUS les personnages</style> <style=cIsDamage>300% de dégâts par explosion.</style>",
    "ITEM_STARVEIL_LORE": "C'EST MOI. JE L'AI.\r\n\r\nES-TU EXCITÉ ? AS-TU PEUR ? ES-TU CONTRIT ? ES-TU INCRÉDULE ?\r\n\r\nMEURTRIER.\r\n\r\nTU AS TUÉ MES ?????. TU AS PROFANÉ LEURS FORMES. TU AS UTILISÉ LEURS ÂMES POUR MASSACRER MES ?????. TU AS MENÉ D'HORRIBLES EXPÉRIENCES AU NOM DE FAUX DIEUX. ET LE RÉSULTAT T'A DONNÉ LE POUVOIR.\r\n\r\nMAIS TU L'AS PERDU.\r\n\r\nET MAINTENANT JE L'AI. JE SUIS ENTOURÉ DES ÂMES DE MES ????? ET JE SUIS REMPLI DE VENGEANCE.\r\n\r\nDE QUOI ES-TU REMPLI ? DE PEUR ET DE REGRET ?\r\n\r\nOÙ EST TON « INVINCIBILITÉ » MAINTENANT ? OÙ EST TON « POUVOIR TUEUR DE DIEUX » ? OÙ SONT TES « ÉTOILES » ?\r\n\r\nELLES SONT AVEC MOI. TU ES BIEN PLUS QU'UN MEURTRIER. TU ES UN SOT. UN IMBÉCILE. UN IGNARE. ET TU EN VIENDRAS À REGRETTER TOUT CE QUE TU AS FAIT À MOI ET À MES ?????.\r\n\r\nCAR JE VIENS POUR TOI. CHAQUE COUP PATHÉTIQUE QUE TU ME PORTES, JE L'UTILISERAI POUR FAIRE PLEUVOIR LA MORT SUR TOUT CE QUE TU AS JAMAIS CONNU.\r\n\r\nQUE VAS-TU FAIRE ? TES FAUX DIEUX NE RÉPONDRONT PAS À TES PRIÈRES. IL N'Y A RIEN QUE TU PUISSES FAIRE. SI TU FUIS, JE N'EN SERAI QUE PLUS FURIEUX.\r\n\r\nJE SERAI BIENTÔT LÀ. TU N'AURAS PAS À DÉSESPÉRER LONGTEMPS.\r\n\r\nLES ÂMES DE MES ????? BOIRONT TES CRIS COMME DU NECTAR.",
    "ITEM_UTILITYBARRIER_NAME": "Couteau Utilitaire",
    "ITEM_UTILITYBARRIER_PICKUP": "Lancer votre compétence Utilitaire octroie une barrière temporaire.",
    "ITEM_UTILITYBARRIER_DESCRIPTION": "Activer votre <style=cIsUtility>compétence Utilitaire</style> vous octroie également une <style=cIsHealing>barrière temporaire</style> de <style=cIsHealing>3%</style> de votre santé maximale <style=cStack>(+1.5% par cumul)</style> par seconde du <style=cIsUtility>temps de recharge de base</style> de la compétence.",
    "ITEM_VOIDLASERTURBINE_NAME": "Moteur Supersolénoïde",
    "ITEM_VOIDLASERTURBINE_PICKUP": "Utiliser des compétences charge une attaque primaire laser dévastatrice. <style=cIsVoid>Corrompt tous les Béhémoths brillants et Disques de résonance.</style>",
    "ITEM_VOIDLASERTURBINE_DESCRIPTION": "Utiliser vos compétences accumule de la charge. Après 90 secondes de charge accumulées, prépare 1 utilisation <style=cStack>(+1 par cumul)</style> de <style=cIsVoid>Perce-Cieux</style>, remplaçant votre attaque Primaire. Tirer <style=cIsVoid>Perce-Cieux</style> inflige <style=cIsDamage>3200% de dégâts</style>, transperçant TOUS les ennemis et le terrain. <style=cIsVoid>Corrompt tous les Béhémoths brillants et Disques de résonance.</style>",
    "ITEM_VOIDUTILITYBELT_NAME": "Flux de Möbius",
    "ITEM_VOIDUTILITYBELT_PICKUP": "Lancer votre compétence Utilitaire octroie une poussée supplémentaire de vitesse de déplacement. <style=cIsVoid>Corrompt tous les Couteaux Utilitaires.</style>",
    "ITEM_VOIDUTILITYBELT_DESCRIPTION": "Activer votre <style=cIsUtility>compétence Utilitaire</style> augmente également votre <style=cIsUtility>vitesse de déplacement</style> de <style=cIsUtility>4%</style> <style=cStack>(+4% par cumul)</style> par seconde du <style=cIsUtility>temps de recharge de base</style> de la compétence. Dure <style=cIsUtility>2.5 secondes</style>. <style=cIsVoid>Corrompt tous les Couteaux Utilitaires.</style>",
    "ITEM_CUCKLER_NAME": "Bouclier de Cobalt",
    "ITEM_CUCKLER_PICKUP": "Annule tout recul. Réduit les dégâts subis et octroie une barrière à l'arrêt.",
    "ITEM_CUCKLER_DESCRIPTION": "Annule <style=cIsUtility>TOUT recul</style>. Augmente l'<style=cIsHealing>armure</style> de <style=cIsHealing>20</style> <style=cStack>(+20 par cumul)</style> et la <style=cIsHealing>génération de barrière</style> de <style=cIsHealing>6 PV/s</style> <style=cStack>(+6 PV/s par cumul)</style>. À l'arrêt, ces effets sont <style=cIsUtility>quintuplés</style>.",
    "ITEM_CUCKLER_LORE": "<style=cIsHealth>Je ne peux pas vous laisser entrer tant que vous ne m'aurez pas libéré de ma malédiction.</style>",
    "ITEM_ECONOMYWEAPON_NAME": "Pistolet à Pièces",
    "ITEM_ECONOMYWEAPON_PICKUP": "Inflige des dégâts bonus pour chaque coffre que vous pouvez payer.",
    "ITEM_ECONOMYWEAPON_DESCRIPTION": "Commencez chaque étape avec <style=cIsUtility>$25</style>. Tant que vous détenez <style=cIsUtility>$25 ou plus</style>, infligez <style=cIsDamage>20% de dégâts bonus</style> <style=cStack>(+20% par cumul)</style>, plus <style=cIsDamage>4%</style> <style=cStack>(+4% par cumul)</style> par <style=cIsUtility>$25 supplémentaires détenus</style>, jusqu'à un maximum de <style=cIsUtility>10 fois</style>.",
    "ITEM_ECONOMYWEAPON_LORE": "Mec, ce truc est trop cool. B-zap ! Haha.\r\n\r\nHé. Mec. Mate un peu ça.\r\n\r\nC'est quoi ce bordel ?\r\n\r\nNon. Regarde ça.\r\n\r\n…Hein ? C'est nul.\r\n\r\nÉcoute, mec. DEUX. FLINGUES. À FRIC.\r\n\r\nT'es débile. Celui-ci se recharge avec de l'or. Celui-là tire de l'or. Il se passe quoi si tu tires tout notre or, Cooper ? On pourra plus recharger nos flingues.\r\n\r\nT'inquiète, mec. Les monstres de cette planète sont blindés. Regarde tout ça !\r\n\r\n…Hein ? C'est quoi ce truc ?\r\n\r\nC'est ce, genre, chapeau que j'ai trouvé ? Il attire l'argent ou un truc du genre. Si on survit à ça on va être riches.\r\n\r\nFaut que t'arrêtes de ramasser ces trucs. Ils ont tous essayé de nous tuer à un moment donné.\r\n\r\nPas celui-là, mec. Regarde— oups. Aïe.\r\n\r\nEuh.\r\n\r\nQuoi ?\r\n\r\nOù est passé tout notre or ?",
    "ITEM_CRITRETALIATE_NAME": "Emblème du Destructeur",
    "ITEM_CRITRETALIATE_PICKUP": "Infligez un coup critique après avoir subi des dégâts.",
    "ITEM_CRITRETALIATE_DESCRIPTION": "Après avoir été touché, octroie <style=cIsDamage>100.0%</style> de chance de <style=cIsDamage>Coup Critique</style>, s'estompant sur <style=cIsDamage>3.0 secondes</style> <style=cStack>(+1.5 par cumul)</style>.",
    "ITEM_FLOWERCROWN_NAME": "Couronne de Fleurs",
    "ITEM_FLOWERCROWN_PICKUP": "Augmente votre santé maximale.",
    "ITEM_FLOWERCROWN_DESCRIPTION": "Augmente la <style=cIsHealing>santé maximale</style> de <style=cIsHealing>12%</style> <style=cStack>(+12% par cumul)</style>.",
    "ITEM_FLOWERCROWN_LORE": "Commande : Couronne de Fleurs\r\nNuméro de suivi : 10***********\r\nLivraison estimée : 02/11/2056\r\nMode d'expédition : Prioritaire/Fragile\r\nAdresse de livraison : Étage 16, Jardins Spirales, Terre\r\nDétails de l'envoi :\r\n\r\nMerci de toujours nous envoyer des cadeaux. J'en ai utilisé quelques-uns pour te faire cette couronne de fleurs. La porter me fait sentir fort, comme si rien ne pouvait m'abattre. J'espère qu'elle aura le même effet sur toi ! <3\r\n",
    "ITEM_BORBOMOLOTOV_NAME": "Molotov (Pack de 1)",
    "ITEM_BORBOMOLOTOV_PICKUP": "Chance à l'impact de lancer un molotov enflammé.",
    "ITEM_BORBOMOLOTOV_DESCRIPTION": "<style=cIsDamage>9.0%</style> de chance à l'impact de lancer un <style=cIsDamage>cocktail molotov</style> qui <style=cIsDamage>enflamme</style> les ennemis pour <style=cIsDamage>60%</style> <style=cStack>(+60% par cumul)</style> des dégâts TOTAUX et laisse une zone <style=cIsDamage>en feu</style> infligeant <style=cIsDamage>30%</style> <style=cStack>(+30% par cumul)</style> des dégâts TOTAUX par seconde.",
    "ITEM_BORBOMOLOTOV_LORE": "Commande : Bouteille d'Éthanol (950 ml), Pack de 6\r\nNuméro de suivi : 81******\r\nLivraison estimée : 08/05/2058\r\nMode d'expédition : Prioritaire\r\nAdresse de livraison : Manoir Teromere, Privet Road, Mars\nDétails de l'envoi : Prévenez nos amis à l'intérieur qu'on passe boire un verre le 16 juin. Ça va être une sacrée fête, ils devraient probablement prendre la route avant que ça dégénère.",
    "ITEM_SLUNGUS_NAME": "Spores Somnolentes",
    "ITEM_SLUNGUS_PICKUP": "Rester immobile vous protège, ralentissant les ennemis et projectiles proches. Déplacez-vous plus vite jusqu'à être touché.",
    "ITEM_SLUNGUS_DESCRIPTION": "À l'arrêt, crée un <style=cIsUtility>champ de stase</style> protecteur de 24.0m autour de vous, <style=cIsUtility>ralentissant</style> les ennemis et projectiles proches de <style=cIsUtility>80%</style>. Déplacez-vous 20% plus vite <style=cStack>(30% par cumul)</style> jusqu'au prochain coup reçu.",
    "ITEM_SLUNGUS_LORE": "Commande : Compagnon de Voyage Champi Lay-Z\r\nNuméro de suivi : 58***********\r\nLivraison estimée : 23/09/2056\r\nMode d'expédition : Prioritaire/Biologique\r\nAdresse de livraison : 444 Slate Drive, Mars\r\nDétails de l'envoi :\r\n\r\nMerci pour votre achat !\r\n\r\nMode d'emploi :\r\nTournez la buse sur « ouvert ». Les spores se disperseront dans l'air, provoquant une distorsion temporelle qui ralentira le temps, raccourcissant ainsi votre attente tandis que le reste de la réalité s'écoulera plus vite. Les effets de distorsion peuvent mettre un certain temps à apparaître ; laissez le flacon de spores dans une zone pour maximiser le nombre de spores. Si vous voyagez dans un petit espace clos, les spores peuvent finir par remplir toute la zone. Aérez régulièrement pour éviter la sursaturation.\r\nPour mettre fin à l'effet de distorsion temporelle, fermez la buse et quittez ou aérez la zone affectée. Fermez toujours la buse avant de quitter la zone affectée ; une exposition corporelle partielle à la distorsion temporelle peut avoir des effets indésirables.\r\nRemarque : vous pouvez percevoir le temps normalement pendant plusieurs secondes ou minutes après le début de la distorsion ; c'est normal. Attendez simplement que le temps ralentisse aussi pour vous (les objets lents reprendront leur vitesse normale et les objets non affectés sembleront accélérer), puis bonne attente !\r\n\r\nAvertissements :\r\nLes objets semblent se déplacer plus lentement, mais conservent la même force qu'à l'accoutumée. N'interagissez pas de manière dangereuse avec des objets normalement rapides ou puissants.\r\nLa zone affectée subit une baisse de température ; il est conseillé de porter des vêtements chauds ou de monter le chauffage. Les thermomètres ne mesurent pas correctement la température dans la zone affectée ; considérez des températures réelles jusqu'à 50 degrés inférieures aux mesures.\r\n<style=cIsHealth>Ne pas ouvrir le flacon. Manipuler avec une extrême prudence. Aérer régulièrement.</style>\r\n\r\nFUN-GUYS Inc. décline toute responsabilité en cas de maladie, blessure, décès, modification prolongée ou permanente de la perception du temps, distorsion spatiale, manie ou léthargie, hallucination, paranoïa, crise de panique aiguë ou tout autre résultat insatisfaisant. Toutes les ventes sont définitives.",
    "ITEM_VOIDHAPPIESTMASK_NAME": "Façade Oubliée",
    "ITEM_VOIDHAPPIESTMASK_PICKUP": "Chance à l'élimination d'invoquer des infesteurs du vide. <style=cIsVoid>Corrompt tous les Masques les plus heureux.</style>",
    "ITEM_VOIDHAPPIESTMASK_DESCRIPTION": "Tuer des monstres a <style=cIsDamage>7.0%</style> de chance de faire apparaître 2 <style=cStack>(+1 par cumul)</style> <style=cIsDamage>infesteurs du vide</style> à leur place. <style=cIsVoid>Corrompt tous les Masques les plus heureux.</style>",
    "ITEM_ATTACKSPEEDHELPER_NAME": "AttackspeedHelper",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_NAME": "Galerie Lunaire",
    "2R4R_INTERACTABLE_LUNAR_GALLERY_CONTEXT": "mange ma transcendance, nerd",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_NAME": "Construct Déchu",
    "2R4R_INTERACTABLE_CONSTRUCTCONSTRUCT_CONTEXT": "Frapper le Construct",
    "2R4R_INTERACTABLE_EGG_PILE_NAME": "Œuf",
    "2R4R_INTERACTABLE_EGG_PILE_CONTEXT": "Œuf trouvé",
    "2R4R_INTERACTABLE_FLOWERBLOOM_NAME": "Oh... ?",
    "2R4R_INTERACTABLE_FLOWERBLOOM_CONTEXT": "Elle est jolie, oh si jolie...",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_NAME": "Autel de la Convergence",
    "2R4R_INTERACTABLE_SHRINE_CONVERGE_CONTEXT": "Prier à l'Autel de la Convergence",
