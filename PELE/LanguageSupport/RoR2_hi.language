    "ITEM_TOOTH_DESC": "दुश्मन को मारने पर <style=cIsHealing>उपचार गोला</style> बनता है, जो <style=cIsHealing>8</style> अंक और <style=cIsHealing>2% <style=cStack>(हर अतिरिक्त प्रति पर +2%)</style></style> <style=cIsHealing>अधिकतम स्वास्थ्य</style> वापस देता है।",
    "ITEM_CRITGLASSES_NAME": "लेंस बनाने वाले का चश्मा",
    "ITEM_CRITGLASSES_PICKUP": "वार के 'क्रिटिकल' होने की 10% संभावना पाएँ। ऐसा वार दोगुनी क्षति पहुँचाता है।",
    "ITEM_CRITGLASSES_DESC": "आपके हमलों के <style=cIsDamage>10%</style> <style=cStack>(हर अतिरिक्त प्रति पर +10%)</style> मौके पर <style=cIsDamage>क्रिटिकल वार</style> होगा, जिससे <style=cIsDamage>दोगुनी क्षति</style> पहुँचेगी।",
    "ITEM_HOOF_NAME": "Paul की बकरी का खुर",
    "ITEM_HOOF_PICKUP": "चलने की गति बढ़ाएँ।",
    "ITEM_HOOF_DESC": "<style=cIsUtility>चलने की गति</style> <style=cIsUtility>14%</style> <style=cStack>(हर अतिरिक्त प्रति पर +14%)</style> बढ़ जाती है।",
    "ITEM_MUSHROOM_NAME": "चहल-पहल वाला मशरूम",
    "ITEM_MUSHROOM_PICKUP": "1 सेकंड तक स्थिर रहने पर पास के सभी सहयोगियों का स्वास्थ्य लौटाएँ।",
    "ITEM_MUSHROOM_DESC": "<style=cIsHealing>1</style> सेकंड तक स्थिर रहने पर एक क्षेत्र बनता है, जो हर सेकंड <style=cIsHealing>उपचार</style> देता है। यह <style=cIsHealing>4.5%</style> <style=cStack>(हर अतिरिक्त प्रति पर +2.25%)</style> आपके <style=cIsHealing>स्वास्थ्य</style> के बराबर है और <style=cIsHealing>3 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +1.5 मीटर)</style> के भीतर सभी सहयोगियों को मिलता है।",
    "ITEM_CROWBAR_NAME": "सब्बल",
    "ITEM_CROWBAR_PICKUP": "90% से अधिक स्वास्थ्य वाले दुश्मनों को अतिरिक्त क्षति पहुँचाएँ।",
    "ITEM_CROWBAR_DESC": "<style=cIsDamage>+75%</style> <style=cStack>(हर अतिरिक्त प्रति पर +75%)</style> अतिरिक्त क्षति उन दुश्मनों को पहुँचाएँ जिनका <style=cIsDamage>स्वास्थ्य 90% से अधिक</style> है।",
    "ITEM_BLEEDONHIT_NAME": "तीन नोकों वाला खंजर",
    "ITEM_BLEEDONHIT_PICKUP": "दुश्मन को वार लगने पर रक्तस्राव कराने की संभावना में +10%।",
    "ITEM_BLEEDONHIT_DESC": "<style=cIsDamage>10%</style> <style=cStack>(हर अतिरिक्त प्रति पर +10%)</style> संभावना है कि दुश्मन <style=cIsDamage>रक्तस्राव</style> झेले, जिससे <style=cIsDamage>240%</style> मूल क्षति होती है।",
    "ITEM_HEALWHILESAFE_NAME": "सतर्क स्लग",
    "ITEM_HEALWHILESAFE_PICKUP": "खतरे से बाहर होने पर तेज़ी से स्वास्थ्य वापस पाएँ।",
    "ITEM_HEALWHILESAFE_DESC": "लड़ाई से बाहर <style=cIsHealing>स्वास्थ्य की मूल पुनर्जनन दर</style> <style=cIsHealing>+3 अंक/सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +3 अंक/सेकंड)</style> बढ़ती है।",
    "ITEM_PERSONALSHIELD_NAME": "निजी ढाल जनक",
    "ITEM_PERSONALSHIELD_PICKUP": "फिर से चार्ज होने वाली ढाल पाएँ।",
    "ITEM_PERSONALSHIELD_DESC": "एक <style=cIsHealing>ढाल</style> पाएँ, जो आपके अधिकतम स्वास्थ्य के <style=cIsHealing>8%</style> <style=cStack>(हर अतिरिक्त प्रति पर +8%)</style> के बराबर है। खतरे से बाहर फिर चार्ज होती है।",
    "ITEM_MEDKIT_NAME": "प्राथमिक उपचार किट",
    "ITEM_MEDKIT_PICKUP": "क्षति झेलने के थोड़ी देर बाद उपचार मिलता है।",
    "ITEM_MEDKIT_DESC": "चोट लगने के 2 सेकंड बाद <style=cIsHealing>स्वास्थ्य वापस पाएँ</style>। इसकी मात्रा <style=cIsHealing>20</style> अंक और <style=cIsHealing>5% <style=cStack>(हर अतिरिक्त प्रति पर +5%)</style></style> <style=cIsHealing>अधिकतम स्वास्थ्य</style> है।",
    "ITEM_STUNCHANCEONHIT_NAME": "स्तब्धकारी ग्रेनेड",
    "ITEM_STUNCHANCEONHIT_PICKUP": "वार लगने पर दुश्मन को स्तब्ध करने की संभावना।",
    "ITEM_STUNCHANCEONHIT_DESC": "वार लगने पर <style=cIsUtility>5%</style> <style=cStack>(हर अतिरिक्त प्रति पर +5%)</style> संभावना है कि दुश्मन <style=cIsUtility>स्तब्ध</style> हो जाए, <style=cIsUtility>2 सेकंड</style> के लिए।",
    "ITEM_FIREWORK_NAME": "आतिशबाज़ी का बंडल",
    "ITEM_FIREWORK_PICKUP": "किसी वस्तु से क्रिया करने पर पास के दुश्मनों पर आतिशबाज़ी छूटती है।",
    "ITEM_FIREWORK_DESC": "किसी वस्तु से क्रिया करने पर <style=cIsDamage>8 <style=cStack>(हर अतिरिक्त प्रति पर +4)</style> आतिशबाज़ियाँ छूटती हैं</style>, जो <style=cIsDamage>300%</style> मूल क्षति पहुँचाती हैं।",
    "ITEM_STICKYBOMB_NAME": "चिपकू बम",
    "ITEM_STICKYBOMB_PICKUP": "वार लगने पर दुश्मन से बम चिपकने की संभावना।",
    "ITEM_STICKYBOMB_DESC": "वार लगने पर <style=cIsDamage>5%</style> <style=cStack>(हर अतिरिक्त प्रति पर +5%)</style> संभावना है कि दुश्मन से <style=cIsDamage>बम</style> चिपके। उसका विस्फोट कुल क्षति का <style=cIsDamage>180%</style> पहुँचाता है।",
    "ITEM_TREASURECACHE_NAME": "ज़ंग लगी चाबी",
    "ITEM_TREASURECACHE_PICKUP": "ज़ंग लगा संदूक खोल सकेंगे, जिसमें एक शक्तिशाली वस्तु है।",
    "ITEM_TREASURECACHE_DESC": "<style=cIsUtility>एक छिपा संदूक</style> जिसमें एक वस्तु है (<style=cIsHealing>80%</style>/<style=cIsHealth>20%</style>), किसी यादृच्छिक जगह पर <style=cIsUtility>हर चरण में</style> प्रकट होगा। संदूक खोलने से यह वस्तु <style=cIsUtility>ख़र्च</style> हो जाती है।",
    "ITEM_NEARBYDAMAGEBONUS_NAME": "एकाग्रता का क्रिस्टल",
    "ITEM_NEARBYDAMAGEBONUS_PICKUP": "आस-पास के दुश्मनों को अतिरिक्त क्षति पहुँचाएँ।",
    "ITEM_NEARBYDAMAGEBONUS_DESC": "<style=cIsDamage>13 मीटर</style> के भीतर के दुश्मनों को होने वाली क्षति <style=cIsDamage>20%</style> <style=cStack>(हर अतिरिक्त प्रति पर +20%)</style> बढ़ती है।",
    "ITEM_IGNITEONKILL_NAME": "पेट्रोल",
    "ITEM_IGNITEONKILL_PICKUP": "किसी दुश्मन को मारने पर आस-पास के दूसरे दुश्मनों में आग लग जाती है।",
    "ITEM_IGNITEONKILL_DESC": "दुश्मन को मारने पर <style=cIsDamage>आग लगती है</style> और <style=cIsDamage>12 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +4 मीटर)</style> के भीतर सभी दुश्मनों को <style=cIsDamage>150%</style> मूल क्षति होती है। इसके अलावा वे <style=cIsDamage>जलते रहते हैं</style>, जिससे <style=cIsDamage>150%</style> <style=cStack>(हर अतिरिक्त प्रति पर +75%)</style> मूल क्षति होती है।",
    "ITEM_SPRINTBONUS_NAME": "ऊर्जा पेय",
    "ITEM_SPRINTBONUS_PICKUP": "तेज़ दौड़ने की गति +25% बढ़ती है।",
    "ITEM_SPRINTBONUS_DESC": "<style=cIsUtility>तेज़ दौड़ने की गति</style> <style=cIsUtility>25%</style> <style=cStack>(हर अतिरिक्त प्रति पर +25%)</style> बढ़ती है।",
    "ITEM_BARRIERONKILL_NAME": "पुखराज का ब्रोच",
    "ITEM_BARRIERONKILL_PICKUP": "दुश्मन को मारने पर अस्थायी अवरोध पाएँ।",
    "ITEM_BARRIERONKILL_DESC": "दुश्मन को मारने पर <style=cIsHealing>अस्थायी अवरोध</style> मिलता है, जिसकी क्षमता <style=cIsHealing>15 स्वास्थ्य अंक <style=cStack>(हर अतिरिक्त प्रति पर +15)</style></style> है।",
    "ITEM_FLATHEALTH_NAME": "बाइसन स्टेक",
    "ITEM_FLATHEALTH_PICKUP": "अधिकतम स्वास्थ्य में 25 अंक बढ़ते हैं।",
    "ITEM_FLATHEALTH_DESC": "<style=cIsHealing>अधिकतम स्वास्थ्य</style> में <style=cIsHealing>25 अंक</style> <style=cStack>(हर अतिरिक्त प्रति पर +25)</style> बढ़ते हैं।",
    "ITEM_ATTACKSPEEDANDMOVESPEED_NAME": "मोका",
    "ITEM_ATTACKSPEEDANDMOVESPEED_PICKUP": "हमले और चलने की गति थोड़ी बढ़ती है।",
    "ITEM_ATTACKSPEEDANDMOVESPEED_DESC": "<style=cIsDamage>हमले की गति</style> <style=cIsDamage>7.5%</style> <style=cStack>(हर अतिरिक्त प्रति पर +7.5%)</style> और <style=cIsUtility>चलने की गति</style> <style=cIsUtility>7%</style> <style=cStack>(हर अतिरिक्त प्रति पर +7%)</style> बढ़ती है।",
    "ITEM_FRAGILEDAMAGEBONUS_NAME": "नाज़ुक घड़ी",
    "ITEM_FRAGILEDAMAGEBONUS_PICKUP": "अतिरिक्त क्षति पहुँचाएँ। कम स्वास्थ्य पर यह टूट जाती है।",
    "ITEM_FRAGILEDAMAGEBONUS_DESC": "क्षति में <style=cIsDamage>20%</style> <style=cStack>(हर अतिरिक्त प्रति पर +20%)</style> वृद्धि। यदि किसी वार से <style=cIsHealth>स्वास्थ्य 25% से नीचे</style> चला जाए, तो वस्तु <style=cIsUtility>टूट जाती है</style>।",
    "ITEM_OUTOFCOMBATARMOR_NAME": "अजीब आकार वाला ओपल",
    "ITEM_OUTOFCOMBATARMOR_PICKUP": "पहली चोट से होने वाली क्षति कम होती है।",
    "ITEM_OUTOFCOMBATARMOR_DESC": "खतरे से बाहर <style=cIsHealing>कवच</style> में <style=cIsHealing>100 अंक</style> <style=cStack>(हर अतिरिक्त प्रति पर +100)</style> की वृद्धि।",
    "ITEM_GOLDONHURT_NAME": "सिक्कों की गड्डी",
    "ITEM_GOLDONHURT_PICKUP": "क्षति झेलने पर सोना मिलता है।",
    "ITEM_GOLDONHURT_DESC": "<style=cIsUtility>3 <style=cStack>(हर अतिरिक्त प्रति पर +3)</style> सोना</style> मिलता है, जब किसी दुश्मन की <style=cIsDamage>क्षति झेलते हैं</style>। <style=cIsUtility>मात्रा समय के साथ बढ़ती है।</style>",
    "ARTIFACT_GLASS_NAME": "काँच का पुरावशेष",
    "ARTIFACT_GLASS_DESCRIPTION": "सहयोगी 500% क्षति पहुँचाते हैं, लेकिन उनका स्वास्थ्य 10% रहता है।",
    "ARTIFACT_BOMB_NAME": "विद्वेष का पुरावशेष",
    "ARTIFACT_BOMB_DESCRIPTION": "मरने पर दुश्मन कई विस्फोटक बम गिराते हैं।",
    "ARTIFACT_ENIGMA_NAME": "पहेली का पुरावशेष",
    "ARTIFACT_ENIGMA_DESCRIPTION": "शुरू में एक यादृच्छिक उपकरण मिलता है, जो हर बार सक्रिय करने पर बदल जाता है।",
    "ARTIFACT_SACRIFICE_NAME": "बलिदान का पुरावशेष",
    "ARTIFACT_SACRIFICE_DESCRIPTION": "मरने पर राक्षस वस्तुएँ गिराते हैं, लेकिन संदूक अब प्रकट नहीं होते।",
    "ARTIFACT_SPIRIT_NAME": "आत्मबल का पुरावशेष",
    "ARTIFACT_SPIRIT_DESCRIPTION": "स्वास्थ्य जितना कम होगा, सभी पात्र उतनी तेज़ी से चलेंगे।",
    "ARTIFACT_RANDOMSURVIVORONRESPAWN_NAME": "कायापलट का पुरावशेष",
    "ARTIFACT_RANDOMSURVIVORONRESPAWN_DESCRIPTION": "हर बार प्रकट होने पर खिलाड़ी किसी यादृच्छिक उत्तरजीवी के रूप में खेलते हैं।",
    "ARTIFACT_WEAKASSKNEES_NAME": "दुर्बलता का पुरावशेष",
    "ARTIFACT_WEAKASSKNEES_DESCRIPTION": "गिरने से दोगुनी क्षति होती है और इससे जान भी जा सकती है।",
    "ARTIFACT_WISPONDEATH_NAME": "प्राण का पुरावशेष",
    "ARTIFACT_WISPONDEATH_DESCRIPTION": "Wisp पराजित राक्षसों से निकलते हैं।",
    "ARTIFACT_ELITEONLY_NAME": "सम्मान का पुरावशेष",
    "ARTIFACT_ELITEONLY_DESCRIPTION": "दुश्मन केवल अभिजात रूप में प्रकट होते हैं।",
    "ARTIFACT_SINGLEMONSTERTYPE_NAME": "कुल का पुरावशेष",
    "ARTIFACT_SINGLEMONSTERTYPE_DESCRIPTION": "हर चरण में सिर्फ़ एक ही प्रकार का राक्षस होगा।",
    "ARTIFACT_MIXENEMY_NAME": "विसंगति का पुरावशेष",
    "ARTIFACT_MIXENEMY_DESCRIPTION": "राक्षस अपने सामान्य परिवेश के बाहर भी प्रकट हो सकते हैं।",
    "ARTIFACT_SHADOWCLONE_NAME": "प्रतिशोध का पुरावशेष",
    "ARTIFACT_SHADOWCLONE_DESCRIPTION": "आपकी अथक हमशक्ल हर 10 मिनट में धावा बोलेगी।",
    "ARTIFACT_TEAMDEATH_NAME": "मृत्यु का पुरावशेष",
    "ARTIFACT_TEAMDEATH_DESCRIPTION": "एक खिलाड़ी की मौत के साथ सभी मर जाते हैं। इसे तभी चालू करें जब आप टीम के तालमेल और हर खिलाड़ी की कुशलता की सबसे कठिन परीक्षा चाहते हों।",
    "ARTIFACT_TEAMDEATH_DEATHMESSAGE": "<style=cDeath><b>{0} की मृत्यु का असर दूर तक फैलता है।</b></style>",
    "ARTIFACT_TEAMDEATH_DEATHMESSAGE_2P": "<style=cDeath><b>तुम्हारी मौत तबाही ले आई।</b></style>",
    "ARTIFACT_SWARMS_NAME": "झुंडों का पुरावशेष",
    "ARTIFACT_SWARMS_DESCRIPTION": "दोगुने राक्षस प्रकट होते हैं, लेकिन उनका अधिकतम स्वास्थ्य आधा रहता है।",
    "ARTIFACT_COMMAND_NAME": "आदेश का पुरावशेष",
    "ARTIFACT_COMMAND_DESCRIPTION": "अपनी वस्तुएँ खुद चुनें।",
