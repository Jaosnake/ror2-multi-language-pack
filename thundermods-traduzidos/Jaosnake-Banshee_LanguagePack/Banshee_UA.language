        "KENKO_BANSHEE_PRIMARY_ATKUMBRELLA_NAME": "Парасолька ATK",
        "KENKO_BANSHEE_PRIMARY_ATKUMBRELLA_DESCRIPTION": "<color=#ba8fff>Передвістя</color>. Вдарте перед собою, завдаючи <style=cIsDamage>250% шкоди</style>. Кожен 3-й удар штовхає вас уперед і вгору та завдає <style=cIsDamage>300% шкоди</style>.",
        "KENKO_BANSHEE_PRIMARY_THRSTUMBRELLA_NAME": "Парасолька THRST",
