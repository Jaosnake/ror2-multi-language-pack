    "BUFF_MYSTICSITEMS_SPOTTERMARKED_NAME": "Individuato",
    "BUFF_MYSTICSITEMS_SPOTTERMARKED_DESC": "Tutti i danni subiti diventano Colpi Critici",
    "BUFF_MYSTICSITEMS_GACHAPONBONUS_NAME": "Bonus del gachapon",
    "BUFF_MYSTICSITEMS_GACHAPONBONUS_DESC": "Probabilità di colpo critico e velocità d'attacco aumentate",
    "BUFF_MYSTICSITEMS_NANOMACHINEARMOR_NAME": "Nanomacchine attivate",
