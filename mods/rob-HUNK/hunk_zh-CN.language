        "ROB_HUNK_BODY_PPASSIVE_NAME": "OSP（就地取材）",
        "ROB_HUNK_BODY_PPASSIVE_DESCRIPTION": "HUNK 可以收集<color=#FFFF00>U.C.钥匙卡</color>来开启<style=cIsDamage>武器箱</style>，扩充自己的军火库。",
        "ROB_HUNK_BODY_PPASSIVE2_NAME": "被遗忘的士兵",
        "ROB_HUNK_BODY_PPASSIVE2_DESCRIPTION": "每个关卡首个阵亡的<style=cIsHealth>首领</style>会掉落一个<style=cIsDamage>补给包</style>，内含一件武器或配件。",
        "ROB_HUNK_BODY_PASSIVE_NAME": "残酷挣扎",
        "ROB_HUNK_BODY_PASSIVE_DESCRIPTION": "开局携带<style=cIsDamage>LE 5</style>和<style=cIsDamage>副武器</style>。你可以在<style=cIsUtility>宝箱</style>中<style=cIsDamage>搜寻</style>弹药。",
        "ROB_HUNK_BODY_PASSIVE2_NAME": "迫近恐惧",
        "ROB_HUNK_BODY_PASSIVE2_DESCRIPTION": "开局拥有<style=cIsDamage>完整军火库</style>，<style=cIsHealth>但</style>你将<style=cIsHealth>无法再获取任何弹药</style>。",
        "ROB_HUNK_BODY_RANDOMPASSIVE_NAME": "新游戏+",
        "ROB_HUNK_BODY_RANDOMPASSIVE_DESCRIPTION": "开局携带<style=cIsDamage>LE 5</style>和<style=cIsDamage>副武器</style>。你可以在<style=cIsUtility>宝箱</style>中<style=cIsDamage>搜寻</style>弹药。<style=cIsHealth>所有武器箱内的物品均随机生成。</style>",
        "ROB_HUNK_BODY_SHOTGUNPASSIVE_NAME": "至高权威",
        "ROB_HUNK_BODY_SHOTGUNPASSIVE_DESCRIPTION": "开局<style=cIsHealth>仅</style>携带一把<style=cIsDamage>W-870</style>。你可以在<style=cIsUtility>宝箱</style>中<style=cIsDamage>搜寻</style>弹药。",
        "ROB_HUNK_BODY_SMGPASSIVE_NAME": "终极佣兵",
        "ROB_HUNK_BODY_SMGPASSIVE_DESCRIPTION": "开局<style=cIsHealth>仅</style>携带一把<style=cIsDamage>完全升级的 LE 5</style>。你可以在<style=cIsUtility>宝箱</style>中<style=cIsDamage>搜寻</style>弹药。<style=cIsDamage>特殊技能</style>替换为<color=#C80202>狂乱模式</color>。",
        "ROB_HUNK_BODY_WPASSIVE_NAME": "全球彻底饱和",
        "ROB_HUNK_BODY_WPASSIVE_DESCRIPTION": "开局<style=cIsHealth>仅</style>携带一件<style=cIsDamage>副武器</style>。你可以在<style=cIsUtility>宝箱</style>中<style=cIsDamage>搜寻</style>弹药。<style=cIsDamage>辅助技能</style>替换为<color=#C80202>乌洛波洛斯</color>。",
        "ROB_HUNK_BODY_FLAMERPASSIVE_NAME": "纵火狂热",
        "ROB_HUNK_BODY_FLAMERPASSIVE_DESCRIPTION": "开局<style=cIsHealth>仅</style>携带一把<style=cIsDamage>化学火焰喷射器</style>。你可以在<style=cIsUtility>宝箱</style>中<style=cIsDamage>搜寻</style>弹药。<style=cIsHealth>每个关卡只会生成一个武器箱。</style>",
        "ROB_HUNK_BODY_CONFIRM_NAME": "确认",
        "ROB_HUNK_BODY_CONFIRM_DESCRIPTION": "继续执行当前技能。",
        "ROB_HUNK_BODY_CANCEL_NAME": "取消",
        "ROB_HUNK_BODY_CANCEL_DESCRIPTION": "取消当前技能。",
        "ROB_HUNK_BODY_PRIMARY_KNIFE_NAME": "战斗刀",
        "ROB_HUNK_BODY_PRIMARY_KNIFE_DESCRIPTION": "<style=cIsUtility>搜刮。</style><style=cIsDamage>挥砍</style>近距离敌人，造成<style=cIsDamage>200%伤害</style>并施加<style=cIsHealth>重伤</style>。",
        "ROB_HUNK_BODY_PRIMARY_CQC_NAME": "CQC（近身格斗）",
        "ROB_HUNK_BODY_PRIMARY_CQC_DESCRIPTION": "<style=cIsUtility>搜刮。</style><style=cIsDamage>踢击两次</style>，分别造成<style=cIsDamage>200%和250%伤害</style>。若<style=cIsUtility>第二记踢击</style>命中，则可衔接<style=cIsDamage>反击</style>。",
