    "GUNSLINGER_GAUNTLET_ITEM_NAME": "Gantelet de l'Infini",
    "GUNSLINGER_GAUNTLET_ITEM_DESC": "<style=cIsDamage>Tue 50%</style> de <style=cIsHealth>tous</style> les êtres vivants au hasard. Se recharge toutes les <style=cIsUtility>60s</style>.",
    "GUNSLINGER_GAUNTLET_ITEM_PICKUP": "Éliminez la moitié de toute vie au hasard.",
    "GUNSLINGER_GAUNTLET_ITEM_LORE": "« Je sais ce que ça fait de perdre. De ressentir si désespérément qu'on a raison, et pourtant d'échouer. C'est terrifiant, cela vous coupe les jambes. »",
    "GUNSLINGER_NAME": "Gunslinger",
    "GUNSLINGER_SUBTITLE": "Pacificateur",
    "GUNSLINGER_PASSIVE_NAME": "Forme Spectrale",
    "GUNSLINGER_PASSIVE_DESCRIPTION": "Gunslinger devient plus fort lorsqu'il se trouve à proximité d'entités hostiles.               <style=cKeywordName>Forme Spectrale</style><style=cSub></style>",
    "GUNSLINGER_VENDETTA": "Vendetta",
    "GUNSLINGER_VENDETTA_DESCRIPTION": "Gunslinger tire avec Vendetta pour 280% de dégâts par balle, transporte jusqu'à six balles et recharge après la dernière. Chaque sixième balle inflige un coup critique avec 25% de dégâts supplémentaires.",
    "GUNSLINGER_UNLOAD": "Décharger",
    "GUNSLINGER_UNLOAD_DESCRIPTION": "Tirez avec Vendetta pour 200% de dégâts. Pour chaque tir réussi sur un ennemi, les dégâts et les chances de coup critique de Décharger augmentent, jusqu'à +150% de dégâts et 40% de chances critiques. Rater des tirs (la skybox ne compte pas) réinitialise les cumuls de Décharger.",
    "GUNSLINGER_ACCURSEDARM": "Bras Maudit",
    "GUNSLINGER_ACCURSEDARM_DESCRIPTION": "Gunslinger charge une puissante malédiction qui inflige 400% de dégâts, transperçant les ennemis en ligne droite. Les ennemis touchés sont affaiblis.",
    "GUNSLINGER_ORB": "Orbe Maudit",
    "GUNSLINGER_ORB_DESCRIPTION": "Gunslinger projette une puissante sphère maudite qui électrocute les ennemis proches pour 10% de dégâts et explose à l'impact sur une large zone pour 320% de dégâts. Les ennemis touchés par l'explosion sont affaiblis.",
    "GUNSLINGER_WRAITHSTEP": "Pas Spectral",
    "GUNSLINGER_WRAITHSTEP_DESCRIPTION": "Gunslinger fonce sur une courte distance. Peut stocker jusqu'à cinq charges.",
    "GUNSLINGER_WRAITHFRENZY": "Frénésie Spectrale",
    "GUNSLINGER_WRAITHFRENZY_DESCRIPTION": "Gunslinger entre dans un état de frénésie, gagnant 50% de vitesse de déplacement et 20% de vol de vie. Dure 3 secondes.",
    "GUNSLINGER_SOULPIERCER": "Transperce-Âme",
    "GUNSLINGER_SOULPIERCER_DESCRIPTION": "Gunslinger tire une rafale de balles spectrales, infligeant 180% de dégâts par balle. Le nombre de tirs augmente avec la vitesse d'attaque. Transperce les ennemis. Inflige des dégâts supplémentaires en fonction des points de vie perdus par l'ennemi.",
    "GUNSLINGER_DEADEYE": "Œil de Lynx",
    "GUNSLINGER_DEADEYE_DESCRIPTION": "Visez précisément une cible. Tirez jusqu'à 3 balles puissantes qui explosent à l'impact, infligeant 300% de dégâts dans une petite zone. Les ennemis touchés sont ralentis. <style=cKeywordName>Vol Stationnaire</style><style=cSub></style>",
    "GUNSLINGER_DEADEYE_KEYWORD": "<style=cKeywordName>Vol Stationnaire</style><style=cSub> Gunslinger plane dans les airs et est immobilisé pendant la durée. En l'air, tire 3 balles en succession rapide, infligeant chacune 200% de dégâts.</style>",
    "GUNSLINGER_DEADEYE_PRIMARY": "Œil de Lynx",
    "GUNSLINGER_DEADEYE_PRIMARY_DESCRIPTION": "Gunslinger plane dans les airs et vise précisément une cible. Tirez jusqu'à 3 balles puissantes qui explosent à l'impact, infligeant 300% de dégâts dans une petite zone. Les ennemis touchés sont ralentis.",
    "GUNSLINGER_DESCRIPTION": "Le tireur le plus rapide de l'ouest.<color=#CCD3E0></color>",
    "GUNSLINGER_OUTRO": "..et c'est ainsi qu'il partit, en chantant Take Me Home.",
    "GUNSLINGER_FAIL": "..et c'est ainsi qu'il disparut, loin dans l'espace.",
    "GUNSLINGER_RING_ITEM_LORE": "En tant que tout dernier Anneau Malveillant, j'attends une somme rondelette."
  }
