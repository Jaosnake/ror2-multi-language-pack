{
    "de": {
        "BOG_MORRIS_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_NAME": "Morris: Mastery",
        "BOG_MORRIS_BODY_NAME": "Mortician",
        "BOG_MORRIS_BODY_DESCRIPTION": "Mortician ist ein langsamer, aber robuster Nahkampf-Nekromant, der mit seiner Armee aus Untoten das Territorium kontrolliert.<color=#CCD3E0>\n\n< ! > Von deiner Schaufel geschleuderte Ghule klammern sich an größere Gegner und beißen sie wiederholt.\n\n< ! > Ghule folgen dir nicht, sondern konzentrieren sich ganz auf ihre Ziele.\n\n< ! > Schleudere deine Ghule hoch und opfere sie in der Luft, um Gruppen fliegender Gegner schnell auszuschalten.\n\n< ! > Mit deinem Grabstein kannst du ein Gebiet wirksam aus der Ferne kontrollieren.\n\n</color>",
        "BOG_MORRIS_BODY_SUBTITLE": "Ein wandelnder Toter",
        "BOG_MORRIS_BODY_OUTRO_FLAVOR": "..und so ging er, seine grimmige Pflicht immer noch unerfüllt.",
        "BOG_MORRIS_BODY_OUTRO_FAILURE": "..und so verschwand er und fand endlich den Frieden, den er sich so sehr gewünscht hatte.",
        "BOG_MORRIS_BODY_DEFAULT_SKIN_NAME": "Standard",
        "BOG_MORRIS_BODY_MASTERY_SKIN_NAME": "Meisterschaft",
        "BOG_MORRIS_BODY_PASSIVE_NAME": "Seelenopfer",
        "BOG_MORRIS_BODY_PASSIVE_DESCRIPTION": "Wenn Ghule getötet werden, <style=cIsUtility>lösen sie deine Effekte bei Tötungen aus</style>.",
        "BOG_MORRIS_BODY_PRIMARY_SHOVEL_NAME": "Schaufelschlag",
        "BOG_MORRIS_BODY_PRIMARY_SHOVEL_DESCRIPTION": "Schwinge deine Schaufel und verursache <style=cIsDamage>800% Schaden</style>. Treffer auf Ghule und Grabsteine <style=cIsUtility>schleudern sie fort</style> und verursachen <style=cIsDamage>350% Schaden</style>.",
        "BOG_MORRIS_BODY_SECONDARY_GHOUL_NAME": "Tote auferwecken",
        "BOG_MORRIS_BODY_SECONDARY_GHOUL_DESCRIPTION": "<style=cIsUtility>Geisterbindung</style>. Beschwöre einen Ghul auf dem Boden vor dir. Ghule beißen für <style=cIsDamage>150% Schaden</style> und spucken <style=cIsDamage>pestilente</style> Galle für <style=cIsDamage>100% Schaden</style>.",
        "BOG_MORRIS_BODY_UTILITY_LANTERN_NAME": "Opfern",
        "BOG_MORRIS_BODY_UTILITY_LANTERN_DESCRIPTION": "<style=cIsHealth>Detoniere</style> den Ziel-Ghul für <style=cIsDamage>700 % Schaden</style> und <style=cIsHealing>heile 15 % deiner maximalen Gesundheit</style>.",
        "BOG_MORRIS_BODY_SPECIAL_TOMBSTONE_NAME": "Grabstein",
        "BOG_MORRIS_BODY_SPECIAL_TOMBSTONE_DESCRIPTION": "Errichte einen Grabstein, der alle <style=cIsUtility>10 Sekunden</style> einen Ghul hervorbringt. Immer wenn ein Ghul getötet wird, bringt das Grab eine <style=cIsDamage>rachsüchtige Seele</style> <style=cIsUtility>explosiv</style> hervor, die auf einen nahen Feind feuert und <style=cIsDamage>350 % Schaden</style> verursacht.",
        "BOG_MORRIS_BODY_MASTERYUNLOCKABLE_ACHIEVEMENT_DESC": "Gewinne als Mortician das Spiel oder lösche dich auf Monsoon aus.",
        "BOG_MORRIS_BODY_MASTERYUNLOCKABLE_UNLOCKABLE_NAME": "Morris: Mastery",
        "BOG_GHOUL_BODY_NAME": "Ghul",
        "BOG_TOMBSTONE_BODY_NAME": "Grabstein",
        "KEYWORD_LINKED": "<style=cKeywordName>Geisterbindung</style><style=cSub>Ghule erben deine Gegenstände nicht, aber ihr gesamter Schaden zählt als dein eigener.</style>",
        "KEYWORD_EXHAUST": "<style=cKeywordName>Erschöpfung</style><style=cSub>Verringert Bewegungstempo und Schaden um <style=cIsUtility>30%</style>. Erhöht Abklingzeiten um <style=cIsUtility>20%</style>.</style>",
        "BOG_MORRIS_BODY_LORE": "Gott hat uns verlassen.\n\nUm ehrlich zu sein, glaube ich nicht, dass er sich je für uns interessiert hat.\n\nJenseits der äußersten Grenzen menschlichen Begreifens liegt ein Reich, in dem wir alle eines Tages landen müssen. Es ist weder ein Reich aus Perlentoren und Engeln noch aus Feuer und Schwefel, sondern eines der Finsternis und Verzweiflung. Es ist ein abgründiges Gefängnis, dessen Insassen zu bloßen Daten reduziert werden. Neugierige, finstere Wesen beherrschen es, untersuchen und drangsalieren uns und führen für alle Ewigkeit ihre grausamen Experimente an uns durch.\n\nJede Seele, die ich aus diesem elenden Ort hole, erzählt mir eine Geschichte. Manche müssen ihren schlimmsten Schmerz immer wieder erleben. Andere schweben in ewiger, einsamer Finsternis, ohne Gesellschaft oder Anregung. Manche erzählen mir von Krabben und Garnelen. Sie alle flehen mich an, sie nicht dorthin zurückzuschicken. Ich habe neue Körper geschaffen, in denen diese Seelen wohnen können; sterben sie, kehren sie erneut zu mir zurück.\n\nDie Wesen, die dieses Gefängnis beherrschen, suchen mich in meinen Träumen heim. Sie verspotten mich und erzählen mir, was sie mit mir tun werden, wenn ich tot und in ihren Klauen bin. Ich weiß, dass ihre Pläne schlimmer sind als alles, was der Teufel mir antun könnte. Jede gerettete Seele ist ein weiteres Spielzeug, das ich ihnen wegnehme, und sie werden mich für ihr verdorbenes Vergnügen bezahlen lassen.\n\nIch bin alt geworden, und auch meine Zeit wird bald kommen. Deshalb habe ich beschlossen, einen Zugang zu diesem Reich zu finden, seine bösen Herrscher zu töten und alle Gefangenen zu befreien.\n\nIch werde es nicht allein tun: Die befreiten Seelen werden an meiner Seite kämpfen. Sie werden mich führen und ich sie. Gemeinsam werden wir die Würde des Todes und den uns versprochenen Frieden wiederherstellen.",
        "BOG_GHOUL_BODY_DEFAULT_SKIN_NAME": "Standard",
        "BOG_TOMBSTONE_BODY_DEFAULT_SKIN_NAME": "Standard"
    }
}
