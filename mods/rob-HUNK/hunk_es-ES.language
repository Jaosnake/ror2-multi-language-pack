    "ROB_HUNK_BODY_SHOOT_FLAMETHROWER_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_FLAMETHROWER_DESCRIPTION": "Proyecta un chorro de llamas que causa <style=cIsDamage>cantidades ingentes de daño</style>. <style=cIsUtility>Prende fuego.</style>",
    "ROB_HUNK_BODY_SHOOT_M19_NAME": "Disparar",
    "ROB_HUNK_BODY_SHOOT_M19_DESCRIPTION": "Dispara causando un <style=cIsDamage>500% de daño</style>. <style=cIsUtility>Bonificación del 100% por tiro en la cabeza.</style>",
    "ROB_HUNK_BODY_SHOOT_SG09_NAME": "Disparar",
