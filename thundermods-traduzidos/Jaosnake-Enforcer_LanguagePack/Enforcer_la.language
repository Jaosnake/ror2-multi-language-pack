{
    "la": {
        "ENFORCER_NAME": "Enforcer",
        "ENFORCER_DESCRIPTION": "Enforcer est propugnaculum defensivum qui ictus accipere et infligere potest.<color=#CCD3E0>\n\n< ! > Riot Shotgun per multos hostes simul transfigere potest.\n\n< ! > Hostibus Shield Bash depulsis te hostes in tuto spatio retenturum caves.\n\n< ! > Utere Tear Gas ad magnas turbas hostium infirmandas, deinde accede et eos contere.\n\n< ! > Cum potes, utere Protect and Serve contra muros ne hostes te a tergo circumveniant.\n\n</color>",
        "ENFORCER_SUBTITLE": "Bastio Inconcussus",
        "ENFORCER_LORE": "\n<style=cMono>\"Hoc facere non debes.\"</style>\n\nVerba in capite eius resonabant, tamen progrediebatur. Capsula tantum paucos passus aberat — facultatem discedendi habuerat — sed aliquid in corde suo eum progredi cogebat. Nesciebat quidnam esset, sed nihil dubitabat. Vis naturalis erat: eadem vis quae eum ad iussa capienda semper impulerat.\n\nHoc tamen tempore non tam naturale videbatur. Nulla erant mandata. Gravis orbiculus et eius tonitru rhythmicum sua — et sua sola erant.",
        "ENFORCER_OUTRO_FLAVOR": "..et ita discessit, de titulo suo ut protector incertus.",
        "ENFORCER_OUTRO_FAILURE": "..et ita evanuit, incolis planetae tandem in pace manentibus.",
        "ENFORCER_PRIMARY_SHOTGUN_NAME": "Riot Shotgun",
        "ENFORCER_PRIMARY_SHOTGUN_DESCRIPTION": "Displosionem brevis spatii emitte quae <style=cIsUtility>penetrat</style> pro <style=cIsDamage>6x60% damno.</style>",
        "ENFORCER_PRIMARY_SUPERSHOTGUN_NAME": "Super Shotgun",
        "ENFORCER_PRIMARY_SUPERSHOTGUN_DESCRIPTION": "Usque ad 2 displosiones sclopeti emitte pro <style=cIsDamage>8x80% damno</style>.\nDum <style=cIsUtility>Protect and Serve</style> uteris, <style=cIsDamage>ambos tubos simul</style> displode.",
        "ENFORCER_PRIMARY_RIFLE_NAME": "Heavy Machine Gun",
        "ENFORCER_PRIMARY_RIFLE_DESCRIPTION": "Nimbum glandium emitte pro <style=cIsDamage>130% damno</style>.\nDum <style=cIsUtility>Protect and Serve</style> uteris, habet <style=cIsDamage>auctam praecisionem</style>, sed <style=cIsHealth>tardiorem celeritatem motus</style>.",
        "ENFORCER_PRIMARY_HAMMER_NAME": "Breaching Hammer",
        "ENFORCER_PRIMARY_HAMMER_DESCRIPTION": "Malleum vibra pro <style=cIsDamage>500% damno</style>.\nDum Protect and Serve uteris, in <style=cIsUtility>ampliore spatio</style> vibra, pro <style=cIsDamage>1000% damno</style> potius.",
        "KEYWORD_BASH": "<style=cKeywordName>Bash</style><style=cSub>Applicat <style=cIsDamage>stupefactionem</style> et <style=cIsUtility>validam reiectionem</style>.</style>",
        "KEYWORD_SPRINTBASH": "<style=cKeywordName>Shoulder Bash</style><style=cSub><style=cIsDamage>Stupefaciens.</style> Impetum cursualem faciens, scuto percute pro <style=cIsDamage>450% damno</style> et <style=cIsDamage>valida reiectione</style>. Hostes a tergo scuti feriti <style=cIsDamage>stupefiunt</style>.</style>",
        "ENFORCER_SECONDARY_BASH_NAME": "Shield Bash",
        "ENFORCER_SECONDARY_BASH_DESCRIPTION": "<style=cIsDamage>Stupefaciens</style>. Hostes reice pro <style=cIsDamage>350% damno</style>. Hostes <style=cIsUtility>propulsi</style> in alios hostes pro usque ad <style=cIsUtility>concursus damno</style> <style=cIsDamage>duplici</style> concurrunt.",
        "KEYWORD_BLINDED": "<style=cKeywordName>Impaired</style><style=cSub>Minuit celeritatem motus per <style=cIsDamage>50%</style> et celeritatem impetus per <style=cIsDamage>25%</style> et <style=cIsDamage>visum minuit</style>.</style>",
        "ENFORCER_UTILITY_TEARGAS_NAME": "Tear Gas",
        "ENFORCER_UTILITY_TEARGAS_DESCRIPTION": "Pyrobolum iacta qui aream vapore <style=cIsDamage>Impairing</style> tegit.",
        "ENFORCER_UTILITY_STUNGRENADE_NAME": "Stun Grenade",
        "ENFORCER_UTILITY_STUNGRENADE_DESCRIPTION": "<style=cIsDamage>Stupefaciens</style>. Pyrobolum emitte qui hostes concutit pro <style=cIsDamage>4x100% damno</style>.",
        "ENFORCER_UTILITY_TEARGASSCEPTER_NAME": "Mustard Gas",
        "ENFORCER_UTILITY_TEARGASSCEPTER_DESCRIPTION": "Pyrobolum iacta qui aream vapore <style=cIsDamage>Impairing</style> tegit, <style=cIsDamage>75% damnum per secundam</style> inferens.",
        "ENFORCER_UTILITY_SHOCKGRENADE_NAME": "Shock Grenade",
        "ENFORCER_UTILITY_SHOCKGRENADE_DESCRIPTION": "<style=cIsDamage>Electrificans</style>. Pyrobolum emitte qui hostes fulgurat pro <style=cIsDamage>4x100% damno</style>.",
        "ENFORCER_SPECIAL_SHIELDUP_NAME": "Protect and Serve",
        "ENFORCER_SPECIAL_SHIELDUP_DESCRIPTION": "Statum defensivum sume, <style=cIsUtility>omne damnum a fronte obstruens</style>. <style=cIsUtility>Ignem primarium auget</style>, sed <style=cIsHealth>cursum et saltum impedit</style>.",
        "ENFORCER_SPECIAL_SHIELDDOWN_NAME": "Protect and Serve",
        "ENFORCER_SPECIAL_SHIELDDOWN_DESCRIPTION": "Statum defensivum sume, <style=cIsUtility>omne damnum a fronte obstruens</style>. <style=cIsDamage>Celeritatem impetus auget</style>, sed <style=cIsHealth>cursum et saltum impedit</style>.",
        "ENFORCER_SPECIAL_SHIELDON_NAME": "Project and Swerve",
        "ENFORCER_SPECIAL_SHIELDON_DESCRIPTION": "Statum defensivum sume, <style=cIsUtility>Scutum Energiae ante te proiciens</style>. <style=cIsDamage>Celeritatem impetus auget</style>, sed <style=cIsUtility>cursum et saltum impedit</style>.",
        "ENFORCER_SPECIAL_SHIELDOFF_NAME": "Project and Swerve",
