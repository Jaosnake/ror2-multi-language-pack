    "RANGER_SKIN_DEFAULT_DESC": "Habitus defaltae huius superstitis.",
    "RANGER_SKIN_MAJOR_NAME": "Major",
    "RANGER_SKIN_MAJOR_DESC": "Vestis sectatoribus summi ordinis reservata, colore caeruleo insignita. Semper memoria retenta, numquam adhibita.",
    "RANGER_SKIN_RENEGADE_NAME": "Renegatus",
    "RANGER_SKIN_RENEGADE_DESC": "Semita altera apostasiae. Semper cogitata, numquam adhibita.",
