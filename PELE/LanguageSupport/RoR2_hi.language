    "BROTHER_REVIVE_3": "ख़राब चुनाव।",
    "BROTHER_REVIVE_4": "संहार के लिए वापस आ गए।",
    "BROTHER_SPAWN_PHASE1_MAXKARMA_1": "मरो, ठीक उस ग्रह की तरह जिसे तुमने उजाड़ दिया।",
    "BROTHER_SPAWN_PHASE1_MAXKARMA_2": "तुम मेरे लौटने के लिए मेरा घर तैयार करोगे, और फिर अंतिम घड़ी में मेरे ही रास्ते में खड़े हो जाओगे?",
    "BROTHER_SPAWN_PHASE1_MAXKARMA_3": "पीड़ा-प्रेमी। जिस मृत्यु की तुम तलाश कर रहे हो, वह मैं तुम्हें तुम्हारे कमाए हुए पुरस्कार के रूप में दूँगा।",
    "BROTHER_SPAWN_PHASE1_MAXKARMA_HERETIC": "मेरी कृपादृष्टि में वापस आने की कोशिश कर रही हो, विधर्मी? अपमान में फिर से मरो।",
    "BROTHER_SPAWN_PHASE1_MAXKARMA_FALSESON": "एक बचकाने गुस्से में उसकी पूरी विरासत को ठुकरा रहे हो? तुम सचमुच बिल्कुल उसी के जैसे हो।",
    "BROTHER_GIFTITEM_1": "ख़राब प्रदर्शन। एक वरदान।",
    "BROTHER_GIFTITEM_2": "अपेक्षित मापदंडों से कहीं आगे। एक वरदान।",
    "BROTHER_GIFTITEM_3": "देखते हैं तुम इससे कैसे निपटते हो, कीड़े।",
    "BROTHER_GIFTITEM_4": "कमज़ोरी स्वीकार की गई। एक वरदान।",
    "BROTHER_GIFTITEM_5": "सुधार की गुंजाइश है। एक वरदान।",
    "BROTHER_GIFTITEM_6": "अक्षम अनुपात। एक वरदान।",
    "BROTHERGIFT_FORMAT": "<style=cWorldEvent>{0} ने {1} {2} प्रदान किया है।</style>",
    "BROTHER_PARRYBOSSHUNTER": "एक दयनीय प्रयास।",
    "BROTHERHURT_PARRYBOSSHUNTER": "एक दयनीय प्रयास।",
    "RULE_HEADER_KARMA": "कर्म",
    "RULE_HEADER_KARMA_WITH_COLON": "कर्म:",
    "RULE_HEADER_KARMA_SUBTITLE": "कुछ निश्चित <style=cWorldEvent>मील के पत्थर</style> हासिल करने से आपको <style=cLunarObjective>कर्म</style> मिलता है, जिससे चंद्रमा पर मुठभेड़ अधिक चुनौतीपूर्ण हो जाती है। <style=cLunarObjective>कर्म</style> के 8 तक स्टैक जमा हो सकते हैं।\n\n<style=cLunarObjective>कर्म</style> अर्जित करने के बाद गेम पूरा करने पर अभियान की शुरुआत में चुने जाने के लिए वह स्तर अनलॉक हो जाता है।\n\n<i>कर्म सक्षम होने पर भी चुनौतियाँ अनलॉक की जा सकती हैं।<i>",
    "RULE_HEADER_KARMA_EDIT": "कर्म प्रणाली को सक्षम या अक्षम करें।",
    "RULE_KARMAENABLED_CHOICE_NAME": "कर्म टॉगल करें",
    "RULE_KARMAENABLED_CHOICE_ON_DESC": "कर्म सक्षम है, और आपके अभियान में कुछ निश्चित मील के पत्थर पूरे करने पर बढ़ता है।",
    "RULE_KARMAENABLED_CHOICE_OFF_DESC": "अधिक सहज अनुभव के लिए, कर्म पूरी तरह से अक्षम है।",
    "RULE_KARMA_NOTIFYONINCREASE_NAME": "चैट अधिसूचना",
    "RULE_KARMA_NOTIFYONINCREASE_CHOICE_ON_DESC": "जब कर्म बढ़ता है, तो चैट में एक संदेश छपता है।",
    "RULE_KARMA_NOTIFYONINCREASE_CHOICE_OFF_DESC": "जब कर्म बढ़ता है, तो चैट में कोई संदेश नहीं छपता है।",
    "RULE_STARTINGKARMA_NAME": "कर्म",
    "RULE_KARMASLIDER_NOKARMA_NAME": "कोई कर्म नहीं",
    "RULE_KARMASLIDER_NOKARMA_DESC": "अभियान बिना किसी अर्जित कर्म के शुरू होता है।",
    "RULE_KARMASLIDER_1_NAME": "1 कर्म",
    "RULE_KARMASLIDER_1_DESC": "अभियान 1 अर्जित कर्म के साथ शुरू होता है।",
    "RULE_KARMASLIDER_2_NAME": "2 कर्म",
    "RULE_KARMASLIDER_2_DESC": "अभियान 2 अर्जित कर्म के साथ शुरू होता है।",
    "RULE_KARMASLIDER_3_NAME": "3 कर्म",
    "RULE_KARMASLIDER_3_DESC": "अभियान 3 अर्जित कर्म के साथ शुरू होता है।",
    "RULE_KARMASLIDER_4_NAME": "4 कर्म",
    "RULE_KARMASLIDER_4_DESC": "अभियान 4 अर्जित कर्म के साथ शुरू होता है।",
    "RULE_KARMASLIDER_5_NAME": "5 कर्म",
    "RULE_KARMASLIDER_5_DESC": "अभियान 5 अर्जित कर्म के साथ शुरू होता है।",
    "RULE_KARMASLIDER_6_NAME": "6 कर्म",
    "RULE_KARMASLIDER_6_DESC": "अभियान 6 अर्जित कर्म के साथ शुरू होता है।",
    "RULE_KARMASLIDER_7_NAME": "7 कर्म",
    "RULE_KARMASLIDER_7_DESC": "अभियान 7 अर्जित कर्म के साथ शुरू होता है।",
    "RULE_KARMASLIDER_8_NAME": "8 कर्म",
    "RULE_KARMASLIDER_8_DESC": "अभियान 8 अर्जित कर्म के साथ शुरू होता है।",
    "RULE_KARMAMULTIPLIER_NAME": "कर्म संशोधक",
    "RULE_KARMAMODIFIER_X1_NAME": "x1",
    "RULE_KARMAMODIFIER_X1_DESC": "आपके अभियान में कुछ निश्चित मील के पत्थर सामान्य मात्रा में कर्म प्रदान करते हैं।",
    "RULE_KARMAMODIFIER_X2_NAME": "x2",
    "RULE_KARMAMODIFIER_X2_DESC": "आपके अभियान में कुछ निश्चित मील के पत्थर दोगुना कर्म प्रदान करते हैं।",
    "RULE_KARMAMODIFIER_X3_NAME": "x3",
    "RULE_KARMAMODIFIER_X3_DESC": "आपके अभियान में कुछ निश्चित मील के पत्थर तीन गुना कर्म प्रदान करते हैं।",
    "WAKE_POTENTIAL_PICKUP_NAME": "जाग्रत सार",
    "WAKE_POTENTIAL_PICKUP_DESCRIPTION": "जागरण से प्राप्त एक सार जो आपको अपनी सुविधा से एक वस्तु चुनने की अनुमति देता है।",
    "WAKE_POTENTIAL_PICKUP_LORE": "लागू नहीं",
    "WAKE_POTENTIAL_PICKUP_PROMPT": "वरदान खोजें।",
    "WAKE_POTENTIAL_INTERACTION_HEADER": "अपना वरदान प्राप्त करें...",
    "ULTIMA_POTENTIAL_PICKUP_NAME": "गूँजता सार",
    "ULTIMA_POTENTIAL_PICKUP_DESCRIPTION": "एक क्षीण होता सार जो आपको अपनी सुविधा से दो वस्तुएँ चुनने की अनुमति देता है।",
    "ULTIMA_POTENTIAL_PICKUP_LORE": "लागू नहीं",
    "ULTIMA_POTENTIAL_PICKUP_PROMPT": "वरदान खोजें।",
    "ULTIMA_POTENTIAL_INTERACTION_HEADER": "अपना वरदान प्राप्त करें...",
    "ITEM_HEXHAUNTING_NAME": "प्रेतबाधा का अभिशाप",
    "ITEM_HEXHAUNTING_PICKUP": "कुछ अंतःक्रियात्मक वस्तुएँ <style=cDeath>प्रेतबाधित</style> हैं।",
    "ITEM_HEXHAUNTING_DESC": "हर <style=cIsUtility>60</style> सेकंड <style=cStack>(हर अतिरिक्त प्रति पर -25%)</style> में एक <style=cDeath>पोल्टरगाइस्ट</style> को बुलाता है जो किसी <style=cIsUtility>अंतःक्रियात्मक वस्तु</style> को प्रेतबाधित करता है। प्रेतबाधित अंतःक्रियात्मक वस्तुएँ हवा में तैरती हैं और आपकी ओर फेंकी जाती हैं, जिससे क्षति पहुँचती है।",
    "ITEM_HEXHAUNTING_LORE": "निष्कर्ष 61\n\nN’tormat परिकल्पना अस्वीकार की जाती है। उसमें वर्णित देवता के अस्तित्व का कोई प्रमाण समर्थन नहीं करता है।\n\nहालाँकि: अंतिम जैविक घटनाएँ क्षेत्र 1-5 के भीतर बिना किसी पता लगाने योग्य मूल स्रोत वाली एक अस्थानीय परिघटना का पुनरुत्पादनीय अवरोध उत्पन्न करती हैं। उक्त परिघटना दूरी, द्रव्यमान और बीच में आने वाले पदार्थ से स्वतंत्र रूप से प्रतिक्रिया करती है। परीक्षणों के बीच की भिन्नता को वर्तमान में यादृच्छिक त्रुटि नहीं माना जा सकता; यह निर्धारित करने के लिए प्रमाण अपर्याप्त हैं कि क्या उक्त भिन्नता कोई प्रतिक्रिया है।\n\nकार्यकारी नामकरण “WESHAN” बना हुआ है।\n\nस्वर्ग के साथ सहसंबंध अनसुलझा बना हुआ है।\n\nआंतरिक सदन परीक्षण 62 के लिए किसी भी चौदह विषयों के अधिग्रहण हेतु प्राधिकरण का अनुरोध करता है।\n\n",
    "ITEM_MIMICRY_NAME": "अनुकरण का अभिशाप",
    "ITEM_MIMICRY_PICKUP": "संदूक <style=cDeath>हमेशा वैसे नहीं होते जैसे वे दिखते हैं</style>।",
    "ITEM_MIMICRY_DESC": "हर <style=cIsUtility>60</style> सेकंड <style=cStack>(हर अतिरिक्त प्रति पर -10%)</style> में एक <style=cDeath>मिमिक</style> को बुलाता है। मिमिक को <style=cIsUtility>सभी आँकड़ों</style> में <style=cIsUtility>0%</style> की वृद्धि <style=cStack>(हर अतिरिक्त प्रति पर +10%)</style> मिलती है।",
    "ITEM_MIMICRY_LORE": "<style=cMono>//–UES [गोपनीय] से स्वचालित-प्रतिलेखन–//</style>\n\nELENI: तुम उन्हें यहाँ नहीं जला सकते।\nHANAN: ये आनुष्ठानिक मोमबत्तियाँ हैं।\nELENI: इससे कोई फ़र्क़ नहीं पड़ता।\n[Hanan सुरक्षा संदूक #HR-1138 के ऊपर अज्ञात खोपड़ी रखता है]\nELENI: क्या यह कंपनी की संपत्ति है?\nHANAN: संदूक?\nELENI: खोपड़ी।\nHANAN: नहीं।\nELENI: ठीक है।\nHANAN: [प्रतिलेखन विफल] [14 सेकंड तक अस्पष्ट मंत्रोच्चार]\nELENI: इससे क्या होने वाला है?\nHANAN: माल लगातार गायब हो रहा है। प्रबंधन इसे सिकुड़न कहता है।\nELENI: तो तुम... सिकुड़न कम करने के लिए कोई अनुष्ठान कर रहे हो?\nHANAN: मैं संपत्ति प्रतिधारण में सुधार कर रहा हूँ।\n[सुरक्षा संदूक #HR-1138 हिलने लगता है। #HR-1139 भी उसके साथ हिलने लगता है।]\nELENI: क्या ऐसा होना तय था?\nHANAN: नहीं तो।\n[अतिरिक्त सुरक्षा संदूक हिलने लगते हैं।]\nELENI: इसे बंद करो??\nHANAN: यह कोई मशीन नहीं है।\nELENI: तो फिर इसे वापस पहले जैसा करो??\n[प्रतिलेखन समाप्त]\n\n<style=cSub>घटना समाधान: कर्मचारी ELENI और HANAN को बर्खास्त किया गया। एक सुरक्षा कैमरा और तीन अग्निशामक यंत्र क्षतिग्रस्त; अज्ञात खोपड़ी बरामद नहीं हुई। कोई माल खोया या क्षतिग्रस्त नहीं हुआ।\n\nपरिशिष्ट: UES [गोपनीय] के कार्गो बे 6 में घटना के बाद संपत्ति प्रतिधारण में 11% सुधार की रिपोर्ट है। अनुष्ठान प्रथाओं को बंद करने की अनुशंसा समीक्षाधीन है।</style>",
    "ITEM_PICKUP_CONTEXT": "{0} लें",
    "EQUIPMENT_PICKUP_CONTEXT": "{0} लें",
    "EQUIPMENT_SWAP_CONTEXT": "{0} से बदलें",
    "ITEM_CLOVER_NAME": "57 पत्तियों वाला क्लोवर",
    "ITEM_CLOVER_PICKUP": "भाग्य आपके साथ है।",
    "ITEM_CLOVER_DESC": "सभी यादृच्छिक प्रभाव <style=cIsUtility>अनुकूल परिणाम</style> के लिए <style=cIsUtility>+1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> बार दोबारा आज़माए जाते हैं।",
    "ITEM_CLOVER_LORE": "वह एक नरसंहार था। कक्षीय प्रोब्स ने बटालियन और दुश्मन—दोनों के साथ पूरे पठार को भस्म कर दिया था। कहीं कोई जीवन शेष नहीं बचा था — सिवाय एक अकेले सैनिक के।\r\n\r\nवह सैनिक झुलसे हुए मैदानों में लड़खड़ाता हुआ, सुन्न मन से किसी जीवित व्यक्ति की तलाश करता रहा।\r\n\r\nलेकिन उसे कोई नहीं मिला।\r\n\r\nसैनिक ने पानी ढूँढने की कोशिश की — उसे अभी-अभी एहसास हुआ था कि वह कितना प्यासा है, उसका सिर कितना फट रहा है। और उसका दिल कितना टूट चुका है।\r\n\r\nलेकिन उसे कुछ नहीं मिला।\r\n\r\nसैनिक ने याद करने की कोशिश की कि वह इस भयानक मिशन पर आया ही क्यों था, और उसे इतने सारे लोगों को अलविदा क्यों कहना पड़ा।\r\n\r\nलेकिन उसे कोई जवाब नहीं मिला।\r\n\r\nसैनिक ने कुछ भी खोजने की कोशिश की — ऐसा कुछ भी जो उसके जीवित बचे रहने को सही ठहरा सके। अर्थ की कोई झलक — या आशा की कोई किरण।\r\n\r\nऔर उसे एक मिल गई।\r\n\r\nराख के ढेर से झाँकती एक नन्ही पत्ती। उसने कोमलता से उस क्लोवर को ज़मीन से तोड़ लिया — न जाने कैसे, वह घंटों की कक्षीय बमबारी में भी सुरक्षित बच गया था। \r\n\r\nहाथ में क्लोवर लिए, सैनिक अपने वरिष्ठ अधिकारियों को रिपोर्ट करने के लिए लंबी पदयात्रा पर निकल पड़ा। क्या यह कोई दैवीय हस्तक्षेप था? क्या इसका कोई अर्थ था — कोई कारण कि वह और यह नन्हा क्लोवर दोनों बच गए? \r\n\r\nया फिर वे बस भाग्यशाली थे?\r\n",
    "ITEM_SYRINGE_LORE": "\"मैं दवाओं-नशों का ज़्यादा शौकीन नहीं हूँ... लेकिन भाड़ में जाए, जब किस्मत दरवाज़ा खटखटा रही हो, तो मुस्कान और सिर हिलाकर उसका स्वागत करना ही पड़ता है। चीयर्स!\"\r\n\r\n-सिग्नल की प्रतिध्वनियाँ, UES Contact Light\r\n",
    "ITEM_BEAR_LORE": "<style=cMono>\n//--UES [संपादित] के कक्ष 4211B से स्वतः प्रतिलेखन --//</style>\n\n\"तुमने इस मिशन के लिए नाम क्यों लिखवाया?\"\n\nWyatt की आवाज़ में ऊब थी। Contact Light के आखिरी ज्ञात स्थान तक का मिशन उसकी उम्मीद से ज़्यादा लंबा खिंच रहा था।\n\nMalik फ़र्श पर बैठी अपनी राइफल साफ़ कर रही थी। \"ज़्यादातर पैसों के लिए।\"\n\n\"बस इतना ही?\"\n\nउसने हामी में हल्की हुँकार भरी। वह हथियार पोंछती रही।\n\n\"मैं यहाँ कुछ ढूँढने आया हूँ।\" उसने बात जारी रखी। \"मैंने कुछ साल पहले उसे भेजा था, लेकिन मुझे नहीं लगता कि ट्रेन के गिरने से पहले वह पहुँच पाया होगा। मेरा अंदाज़ा है कि वह अभी भी Contact Light में ही है। इसलिए मैं उसे वापस लेने जा रहा हूँ।\"\n\nउसने आखिरी बचे बोल्ट कसने शुरू किए। अपना काम लगभग पूरा कर वह Wyatt की ओर देखने लगी। \"सच में?\"\n\n\"हाँ!\"\n\nMalik ने भौंहें चढ़ाईं। \"Contact Light में 70 लाख से ज़्यादा सुरक्षा बक्से थे। उनमें से किसी एक खास बक्से को ढूँढ पाने की संभावना शून्य है।\" उसने अपने पैर सीधा करते हुए राइफल कोने में टिका दी। \"और संकट बीकन के अनुसार, Contact Light कक्षा में ही नष्ट हो गया था। तुम्हारा सामान शायद अंतरिक्ष में कहीं तैर रहा होगा। सब खत्म हो चुका है, Wyatt।\"\n\nवह मुस्कुराया। \"मुझे लगता है कि मैं उसे ढूँढ ही लूँगा।\"\n\n\"तुम सच में सुधरोगे नहीं।\"\n",
    "ITEM_BEHEMOTH_NAME": "तेजस्वी बेहेमोथ",
    "ITEM_BEHEMOTH_PICKUP": "आपके सभी हमले विस्फोट करते हैं!",
    "ITEM_BEHEMOTH_DESC": "आपके सभी <style=cIsDamage>हमले विस्फोट करते हैं</style>, जो पास के दुश्मनों को <style=cIsDamage>4 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +1.5 मीटर)</style> के दायरे में अतिरिक्त <style=cIsDamage>60%</style> कुल क्षति पहुँचाते हैं।",
    "ITEM_BEHEMOTH_LORE": "“लेज़र के पास अपनी रफ़्तार होती है। तलवारों के पास अपनी धार। गैसों के पास अपनी पहुँच। \r\n\r\nलेकिन मेरी बात मानो... कुछ भी, मेरा मतलब है कुछ भी बारूद जितना कालातीत नहीं है। बस एक चुटकी — एक तंग खोल में ठूँस दो — और धड़ाम! तुम्हारे हाथ में सिर्फ़ एक ताक़तवर हथियार ही नहीं, बल्कि ऐसी चीज़ आ जाती है जो तुम्हारे दुश्मनों के दिलों में हमेशा के लिए खौफ़ भर दे। आखिर, कोई भी उड़कर टुकड़े-टुकड़े नहीं होना चाहता, है न?”\r\n\r\n- Jans Czar की आत्मकथा, हथियारों के आधुनिक सम्राट\r\n",
    "ITEM_MISSILE_NAME": "AtG मिसाइल Mk. 1",
    "ITEM_MISSILE_PICKUP": "मिसाइल दागने की संभावना।",
    "ITEM_MISSILE_DESC": "मिसाइल दागने की <style=cIsDamage>10%</style> संभावना, जो <style=cIsDamage>300%</style> <style=cStack>(हर अतिरिक्त प्रति पर +300%)</style> कुल क्षति पहुँचाती है।",
    "ITEM_MISSILE_LORE": "अपनी शॉटगन पर एक अतिरिक्त संगीन कसते हुए उसने क्षितिज की ओर देखा। छोटे-बड़े कदमों की गड़गड़ाहट लगातार तेज़ होती जा रही थी — वे लगभग उस तक पहुँच ही गए थे। उसने आखिरी बार अपने साज़ो-सामान पर नज़र डाली।\r\n\r\nपाँच संगीनें। आग लगाने वाले विस्फोटकों के तेईस पैक। कवच-भेदक गोलियों की पंद्रह मैगज़ीन। तैंतीस चिपकने वाले बम। चार आँसू-गैस ग्रेनेड, और भी बहुत कुछ।\r\n\r\nऔर उसका सबसे पसंदीदा — कंधे पर लगे दो मिसाइल लॉन्चर, जिनमें छह AtG वाइपर मिसाइलें भरी थीं। ऊष्मा का पीछा करने वाली, हर मिसाइल में 15 पाउंड TNT जितनी विस्फोट शक्ति। वजन में हल्की, और सबसे बेहतरीन बात — स्वचालित फ़ायरिंग प्रणाली। पहले वह अपने हथियारों में ज़्यादा पारंपरिक और मैनुअल तरीका पसंद करता था, लेकिन यह चीज़ उसे खूब भाने लगी थी।\r\n\r\nआती हुई भीड़ का सामना करने के लिए मुड़ते हुए उसने अपनी शॉटगन लोड की। उसकी रगों में एड्रेनालिन दौड़ने लगा।\r\n\r\n“आ जाओ, देखते हैं।”\r\n",
    "ITEM_EXPLODEONDEATH_NAME": "छलावा ज्योति",
    "ITEM_EXPLODEONDEATH_PICKUP": "दुश्मन को मारने पर उसमें विस्फोट करें।",
    "ITEM_EXPLODEONDEATH_DESC": "दुश्मन को मारने पर <style=cIsDamage>12 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +2.4 मीटर)</style> के दायरे में एक <style=cIsDamage>लावा स्तंभ</style> उत्पन्न होता है, जो <style=cIsDamage>350%</style> <style=cStack>(हर अतिरिक्त प्रति पर +280%)</style> आधार क्षति पहुँचाता है।",
    "ITEM_EXPLODEONDEATH_LORE": "<style=cMono>पोर्टेबल रिकॉर्डर से ऑडियो प्रतिलेखन पूर्ण।\r\n\r\nप्रिंट किया जा रहा है...</style>\r\n\r\n\"तुम इसका नाम बदलकर 'बिल्लू-ज्योति' नहीं रखना चाहते?\"\r\n\"नहीं।\"\r\n\"'जार-ज्वाला'?\"\r\n\"नहीं।\"\r\n\"तो फिर 'चिंगारी लाल' कैसा रहेगा?\"\r\n\"बंद करो।\"\r\n\"इसे एक नाम तो चाहिए, यह हमसे कुछ 'ज्वाला-ग' थोड़े ही है।\"\r\n\"अगली बार जब हम बेस पर पहुँचेंगे, मैं ट्रांसफ़र की अर्ज़ी दे दूँगा।\"\r\n\"तुम्हें पता है न वह कम से कम 'दिस-अंगार' से पहले मंज़ूर नहीं होगी।\"\r\n\"तुम कब से ये घटिया चुटकुले बोलने का इंतज़ार कर रहे थे?\"\r\n\"मौके पर ही बना रहा हूँ। मेरे कंधों पर बड़ा 'सुलगता' हुआ दिमाग़ है।\"\r\n\"तुम उन शब्दों पर इतना ज़ोर देना बंद कर सकते हो। मैं समझ गया।\"\r\n\"मैं कभी भी 'आग-लगाऊ' मज़ाक करना बंद नहीं करूँगा।\"\r\n\"...\"\r\n\"...\"\r\n\"...\"\r\n\"वापस जाकर कुछ खाने चलें?\"\r\n\"शुक्र है सितारों का कि यह बकवास खत्म हुई, हाँ। उम्मीद है वे कल वाला दलिया फिर नहीं परोस रहे होंगे।\"\r\n\"शायद आज वे तुम्हारे लिए 'तंदूरी-ज्वाला' पिज़्ज़ा बना दें?\"\r\n\"...\"\r\n\"अरे रुको तो सही! मैं यह चीज़ हाथ में लेकर दौड़ नहीं सकता, कहीं फट न जाए!\"\r\n",
    "ITEM_DAGGER_NAME": "अनुष्ठानिक कटार",
    "ITEM_DAGGER_PICKUP": "दुश्मन को मारने पर लक्ष्य खोजने वाली कटारें निकलती हैं।",
    "ITEM_DAGGER_DESC": "दुश्मन को मारने पर <style=cIsDamage>3</style> <style=cIsDamage>लक्ष्य-खोजी कटारें</style> छूटती हैं जो <style=cIsDamage>150%</style> <style=cStack>(हर अतिरिक्त प्रति पर +150%)</style> आधार क्षति पहुँचाती हैं।",
    "ITEM_DAGGER_LORE": "हवा में गंधक की गंध भरी हुई है।\r\n\r\n\"हे भगवान, वे बहुत क़रीब आ गए हैं। उन्होंने Hitchcock को पकड़ लिया। हे भगवान।\"\r\n\r\n\"निकालो — वह कटार निकालो। मेरे बैकपैक से। जल्दी।\"\r\n\r\n\"मैं—मैं नहीं... मिल गई। यह क्या बकवास है? इससे कुछ नहीं होने वाला, Marion। मैं उन सबके सामने इसका क्या करूँगा...? उन्होंने उसके चिथड़े उड़ा दिए — हे भगवान।\"\r\n\r\n\"तुम्हें... तुम्हें मुझे मारना होगा — आह! मुझे मारो। इससे मुझे मार डालो।\"\r\n\r\n\"क्या? पागल हो गए हो क्या?\"\r\n\r\n\"हाँ — यही एकमात्र रास्ता है। प्लीज़।\"\r\n\r\n\"तुम क्या कह रहे हो? बंद करो!\"\r\n\r\n\"यह एक जादुई कटार है। यह हमें बचा लेगी। वह हमें बचा लेगी। लेकिन तुम्हें इससे मुझे मारना होगा।\"\r\n\r\n\"प्लीज़ ऐसा मत... प्लीज़ मुझसे यह मत करवाओ। हे भगवान।\"\r\n\r\n\"तु—तुम्हें करना ही होगा। मैंने देखा है यह कैसे काम करती है। यही एकमात्र रास्ता है — वे बहुत क़रीब आ रहे हैं। तुम्हें मुझ पर इसका इस्तेमाल करना होगा। मुझे मार डालो।\"\r\n\r\n\"मुझे माफ़ करना Marion। मुझे सच में माफ़ करना। मुझे नहीं लगता—\"\r\n\r\n\"कर दो। अभी कर दो। अभी कर दो! अभी कर दो! अभी—\"",
    "ITEM_TOOTH_LORE": "<style=cMono>\r\n//--UES [संपादित] के कक्ष 5041C से स्वतः प्रतिलेखन --//</style>\r\n\r\n“अरे, बढ़िया चीज़ पहनी है! कहाँ से मिली?”\r\n\r\n“ओह, यह पुरानी चीज़? असल में, मैं इसे खुद बना रहा हूँ।”\r\n\r\n“खुद बना रहे हो?”\r\n\r\n“हाँ, दरअसल पहला दाँत मुझे एक बक्से में मिला था। लेकिन हर बार जब हम गश्त पर निकलते हैं, तो अक्सर उन एलियनों से सामना हो ही जाता है। उनसे निपटने के बाद मैं अपने लिए एक निशानी चुन लेता हूँ। समझे न, अपने संग्रह में जोड़ने के लिए।”\r\n\r\n“वाह, उम्म… क्या ऐसा करना, मतलब, जायज़ है? मुझे लगता है इसकी इजाज़त नहीं होगी।”\r\n\r\n“अरे, जो कैप्टन को पता ही नहीं, उससे उन्हें क्या तकलीफ़ होगी। वैसे भी, यह दिखने में ज़बरदस्त है न?”\r\n\r\n“शायद हाँ। सच कहूँ यार, यह बेहद डरावना है… लेकिन सुनो, तुम्हारे पास थोड़ा और धागा है क्या? शायद मैं भी अपना एक बना लूँ।”",
    "ITEM_CRITGLASSES_LORE": "…जो मैं नहीं देख पाया, वह यह था कि गोलेम मेरी पीठ पर अपना लेज़र तान रहा था। मैं बस शुद्ध किस्मत के भरोसे किसी तरह बच निकला — लेकिन धमाके ने मुझे ज़मीन पर पटक दिया। मेरा चश्मा मेरे चेहरे से उड़कर दूर गिर गया और मैं पीठ के बल पड़ा था, स्तब्ध, खुद को सँभालने की हालत में भी नहीं…\r\n\r\nऔर फिर... खैर, मैं सच में नहीं समझा सकता कि इसके बाद क्या हुआ। एड्रेनालिन, कोई दैवीय कृपा, मुझे नहीं पता। लेकिन मैंने हाथ बढ़ाया, किसी तरह अपना चश्मा पकड़ा, देखने के लिए उसे आँखों पर लगाया, और धड़ाम! अपनी आखिरी गोलियाँ दाग दीं।\r\n\r\nऔर, खैर... लगता है मैंने उसके सिर के किसी बेहद नाज़ुक हिस्से पर निशाना लगा दिया था। वह लाल पत्थर और काँच के टुकड़ों में बिखर गया। उसके बाद वह फिर नहीं हिला। \r\n\r\nअगर वह निशाना न लगा होता, तो मैं आज यहाँ यह कहानी सुनाने के लिए ज़िंदा न होता।”\r\n\r\n-सिग्नल की प्रतिध्वनियाँ, UES Contact Light\r\n",
    "ITEM_HOOF_LORE": "ऑर्डर: Paul की बकरी का खुर\r\nट्रैकिंग नंबर: 187*****\r\nअनुमानित डिलीवरी: 03/27/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: 2663rd Fields, Redmond, शुक्र ग्रह\r\nशिपिंग विवरण:\r\n\r\nमेरी कई बकरियों में से एक का खुर; एक दिन मैंने देखा कि मेरी एक बकरी का पैर असामान्य रूप से बड़ा हो गया है। कैंसर होने के शक में मैं डॉक्टरों के पास गया और देखो — वही निकला। कुछ ही समय बाद मेरी बकरी मर गई।\r\n",
    "ITEM_FEATHER_NAME": "हूपू का पंख",
    "ITEM_FEATHER_PICKUP": "एक अतिरिक्त छलाँग पाएँ।",
    "ITEM_FEATHER_DESC": "अधिकतम <style=cIsUtility>छलाँग संख्या</style> में <style=cIsUtility>+1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> की वृद्धि करें।",
    "ITEM_FEATHER_LORE": "“...यूरोपा के कानूनों ने हूपू के पुनरुत्थान में मदद करने के इरादे से अवैध शिकार पर कड़ी कार्रवाई की है। तब से, Greebokks Foundation ने हूपू संरक्षण समूहों को सहायता प्रदान की है, जिससे हाल के वर्षों में दर्ज शुरुआती तीन पक्षियों के मुक़ाबले उनकी आबादी में काफ़ी वृद्धि हुई है।”\r\n\r\n- यूरोपा वन्यजीव मार्गदर्शिका\r\n",
    "ITEM_CHAINLIGHTNING_NAME": "युकुलेले",
    "ITEM_CHAINLIGHTNING_PICKUP": "...और उसका संगीत विद्युत-सा था।",
    "ITEM_CHAINLIGHTNING_DESC": "<style=cIsDamage>20 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +2 मीटर)</style> के भीतर अधिकतम <style=cIsDamage>3 <style=cStack>(हर अतिरिक्त प्रति पर +2)</style></style> लक्ष्यों पर <style=cIsDamage>80%</style> कुल क्षति के लिए <style=cIsDamage>श्रृंखला बिजली</style> दागने की <style=cIsDamage>25%</style> संभावना।",
    "ITEM_CHAINLIGHTNING_LORE": "<style=cMono>\r\n//--रैलीपॉइंट [संपादित] से स्वतः प्रतिलेखन --//</style>\r\n\r\nयह ग्रह निष्ठुर था, हर गुज़रते दिन के साथ और भी कुछ छीन लेता था। जानें और अंग खोते जा रहे थे, और चिकित्सा तंबू में भीड़ बढ़ती ही जा रही थी।\r\n\r\nJans की बदकिस्मती थी कि रैलीपॉइंट की परिधि पर सामान्य गश्त के दौरान वह सीधे लेमूरियनों के एक झुंड के बीच जा पहुँचा। वह किसी तरह अपनी जान बचाकर भागने में सफल रहा, लेकिन मदद पहुँचने से पहले लेमूरियनों ने उसके पैर को घायल कर दिया था। \r\n\r\nJans अपनी खाट पर टिककर बैठ गया। अपने विचारों में खोया वह अपने युकुलेले के तार छेड़ने लगा — जिसे उसने पिछली किसी मुहिम के दौरान उठाया था। कुछ ज़्यादा जटिल नहीं, बस एक सरल-सी धुन जो उसने बचपन में सीखते वक्त याद की थी। उसे पता भी नहीं चला, और एक-एक करके उसके चारों ओर श्रोता जमा हो गए। Jans के युकुलेले की कोमल धुनों ने दर्द और थकान से कराहते मरीज़ों को एक दुर्लभ सुकून दिया, और भर्ती होने के बाद पहली बार उन्हें लगा कि वे मुस्कुरा सकते हैं।\r\n\r\nचिकित्सा तंबू का जीवन ऐसा कभी नहीं था जिसका कोई इंतज़ार करे। मौत, कभी न भरने वाले घाव और दमघोंटू माहौल उन्हें घेरे रहता था। लेकिन कुछ पलों के लिए… उन मरीज़ों का जीवन थोड़ा और उजला हो गया। Jans रुका और उसे एकाग्रता से देख रही भीड़ पर नज़र डाली। \r\n\r\nवह हँसा और एक और धुन बजाने के लिए तैयार हो गया। शायद हालात आखिरकार उतने भी बुरे न हों।\r\n",
    "ITEM_SEED_NAME": "जोंक बीज",
    "ITEM_SEED_PICKUP": "क्षति पहुँचाने से आपका उपचार होता है।",
    "ITEM_SEED_DESC": "क्षति पहुँचाने पर आपका <style=cIsHealing>1 <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> स्वास्थ्य</style> <style=cIsHealing>वापस मिलता है</style>।",
    "ITEM_SEED_LORE": "एक सुहावनी शाम थी — और हालात बेहतर लग रहे थे। वनस्पति विज्ञानी पिछले हफ्ते बरामद किए गए कई एलियन पौधों की जाँच करने के लिए पादप जीवविज्ञान परिसर की ओर चलने लगी।\r\n\r\nएक अन्य कर्मचारी पहले से ही परिसर में काम में व्यस्त था।\r\n\r\n“नमस्ते।” “ओह, नमस्ते!” कर्मचारी ने उत्साह से उसका अभिवादन किया। वह खाद की कई बोरियाँ उठाए हुए था, और उसने जिज्ञासा से उसे देखा। “क्या इन्हें उठाने में मदद चाहिए?” उसने जाँच के लिए अपना क्लिपबोर्ड सँभालते हुए पूछा।\r\n\r\n“अरे नहीं, मैं ठीक हूँ। असल में अच्छी कसरत हो जाती है,” उसने कहा। चलते-चलते वनस्पति विज्ञानी सोचने लगी कि आखिर किस काम के लिए इतनी सारी खाद की ज़रूरत पड़ सकती है।\r\n\r\nजैसे ही ग्रीनहाउस का दरवाज़ा घरघराहट के साथ खुला, उसे अपना जवाब मिल गया — जड़ें ग्रीनहाउस की पूरी ऊँचाई तक चढ़ी हुई थीं, छत पर साँप की तरह फैली थीं, और यहाँ तक कि दूसरे नमूनों के डिब्बों में भी घुस गई थीं। “यह क्या बला है!?” वह चिल्लाई, उसका मुँह खुला का खुला रह गया। और फिर उसकी नज़र दूसरे पौधों पर पड़ी। \r\n\r\nग्रीनहाउस का हर दूसरा पौधा मुरझा चुका था — और एक अपराधी जड़ सीधे उस बेकाबू बेल तक जा रही थी जिसे वह कर्मचारी अब खाद खिला रहा था। वनस्पति विज्ञानी अवाक रह गई। “यह क्या हुआ...? यह... यह क्या है...?” वह हकलाने लगी। कर्मचारी उसकी ओर मुड़ा और मुस्कुराया।\r\n\r\n“पिछली मुहिम में मिली प्रजातियों में से एक। इसे बहुत सारे पोषक तत्व चाहिए होते हैं — इसे अंकुरित करने में ही मुझे इतना वक्त लग गया। मैं अपना दिमाग़ खपा रहा था, हर तरकीब आज़मा रहा था। और बाकी सारे नमूने तो बढ़िया बढ़ ही रहे थे, तो मैंने सोचा, क्यों न उनका थोड़ा पोषण इसके साथ बाँट दिया जाए? और देखो!”\r\n\r\nअपनी बाँहें फैलाकर, वह कर्मचारी मरे हुए पौधों की कतार को निहारकर गर्व से फूला न समाया। क्लिपबोर्ड हाथ से छूटकर गिर गया, वनस्पति विज्ञानी का दिल बैठ गया। हालात अब बेहतर नहीं लग रहे थे।\r\n",
    "ITEM_ICICLE_NAME": "तुषार अवशेष",
    "ITEM_ICICLE_PICKUP": "दुश्मनों को मारने पर आपके चारों ओर बर्फीला तूफ़ान घिर आता है।",
    "ITEM_ICICLE_DESC": "दुश्मन को मारने पर आपके चारों ओर एक <style=cIsDamage>बर्फीला तूफ़ान</style> बन जाता है जो <style=cIsDamage>प्रति सेकंड 1200% क्षति</style> पहुँचाता है और दुश्मनों को <style=cIsUtility>1.5 सेकंड</style> के लिए <style=cIsUtility>80%</style> <style=cIsUtility>धीमा करता है</style>। तूफ़ान <style=cIsDamage>हर वध के साथ बढ़ता है</style>, जिससे उसका दायरा <style=cIsDamage>2 मीटर</style> बढ़ जाता है। अधिकतम <style=cIsDamage>18 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +12 मीटर)</style> तक बढ़ता है।",
    "ITEM_ICICLE_LORE": "“Sven Volz ने वह नमूना खोजा जिसके नाम आकाशगंगा के सबसे बड़े हिमकण का रिकॉर्ड दर्ज है: पूरे 0.5 मीटर व्यास का, और -52 डिग्री के औसत तापमान वाला। हालाँकि — हर जगह के अनोखे हिमकण प्रेमियों के घोर दुख के लिए — यह विशालकाय हिमकण UES Contact Light पर परिवहन के दौरान खो गया, जो अज्ञात क्षेत्र में गायब हो गया था। बस यही उम्मीद की जा सकती है कि वह जहाँ भी हो, पहले जैसा ही सुरक्षित और बर्फीला बना रहे।”\r\n- अकादमी गैलेक्टिक रिकॉर्ड्स 2056\r\n",
    "ITEM_GHOSTONKILL_NAME": "सबसे खुश मुखौटा",
    "ITEM_GHOSTONKILL_PICKUP": "दुश्मन को मारने पर भूत बुलाने की संभावना।",
    "ITEM_GHOSTONKILL_DESC": "दुश्मनों को मारने पर <style=cIsDamage>7%</style> संभावना है कि मारे गए दुश्मन का <style=cIsDamage>1500%</style> क्षति वाला एक <style=cIsDamage>भूत उत्पन्न हो</style>। <style=cIsDamage>30 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +30 सेकंड)</style> तक रहता है।",
    "ITEM_GHOSTONKILL_LORE": "<style=cMono>\r\n//--रैलीपॉइंट डेल्टा से स्वतः प्रतिलेखन --//</style>\r\n\r\n“सर, वे भूत फिर से आ गए हैं।”\r\n\r\nउस आदमी ने गहरी साँस छोड़ी। एक सामान्य अभियान के बाद, चालक दल के एक सदस्य — एक साधारण सैनिक — को एक कलाकृति मिली थी जिसके Contact Light पर होने की संभावना थी — एक साधारण मुखौटा, जिस पर एक कष्टप्रद रूप से प्रसन्न मुस्कान जड़ी थी। \r\n\r\n“मैं देखता हूँ।” वह आदमी गलियारे से होता हुआ बैरक की ओर बढ़ा। दिन में पहले उसके हाथों मारे गए लेमूरियन उसके बगल से गलियारे में चल रहे थे, जिन पर उसने दूसरी नज़र डालना भी ज़रूरी नहीं समझा। यह इतना आम हो गया था कि इस ब्लॉक के ज़्यादातर कर्मचारी एक भुतहा रूममेट के आदी हो चुके थे।\r\n\r\nलेकिन अब हद हो गई थी। एक इम्प के भूत के आर-पार निकलते हुए, उस आदमी ने धड़ाम से दरवाज़ा खोला। बत्तियाँ बंद थीं, और कोने में वह सैनिक बैठा था।\r\n\r\n“ठीक है, मुर्दों के साथ बहुत खेल-तमाशा हो चुका। अब इसे मेरे हवाले करो।”\r\n\r\nकोई जवाब नहीं। आदमी ने गुर्राते हुए सैनिक को खींचकर खड़ा किया और उसे ज़ोर से झकझोरा। “अरे, सुनाई दे रहा है तुम्हें!? मैंने कहा मुखौटा दो! मैं बीटल्स के बगल में जाग-जागकर तंग आ चुका हूँ, इसलिए अब यह नाटक बंद करो—”\r\n\r\nसैनिक का शिथिल शरीर हिला। धीरे-धीरे, सैनिक ने अपनी उँगली उठाई — और सीधे उस आदमी की ओर इशारा किया।\r\n\r\n“यह तुम क्या...?” एक अनजाने भय के साथ वह आदमी मुड़ा और देखा कि दिन में उसके मारे हुए लेमूरियन कमरे के भीतर कदम रख रहे थे। उनके मुँह एक अलौकिक चमक से दमकने लगे।\r\n\r\nअपनी शॉटगन लोड करते हुए वह आदमी मन ही मन बुदबुदाया। “यह ग्रह भी न, सच कहता हूँ...”",
    "ITEM_MUSHROOM_LORE": "<style=cMono>\r\n//--UES [संपादित] से स्वतः प्रतिलेखन --//</style>\r\n\r\n“तुम्हें एक समस्या है।”\r\n\r\n“क्या? कैसे? ये मेरी सेहत के लिए अच्छे हैं, ये…”\r\n\r\n“हाँ, ये कोशिका मरम्मत में मदद करते हैं, कार्बन न्यूट्रल हैं, फलाना-ढिमकाना… मैं यह भाषण पहले ही हज़ार बार सुन चुका हूँ। चाहे ये तुम्हारे लिए अच्छे हों या न हों, तुम सिर्फ़ इन्हीं के सहारे अपना आहार नहीं चला सकते। यह बुनियादी पोषण विज्ञान है!”\r\n\r\n“तो क्या हुआ?”\r\n\r\n“तो क्या हुआ? सिर्फ़ मशरूम खाना सेहतमंद नहीं है, ठीक वैसे ही जैसे सिर्फ़ मांस या सिर्फ़ सब्ज़ियाँ खाना सेहतमंद नहीं है!”\r\n\r\n“ओह, तो अब तुम शाकाहारियों पर हमला कर रहे हो?”\r\n\r\n“क्या— नहीं! मेरा मतलब बस—”\r\n\r\n“खैर, जब तुम मेरी जीवनशैली के प्रति थोड़े ज़्यादा सहिष्णु हो जाओ, तब मुझे यह बातचीत आगे बढ़ाने में खुशी होगी। तब तक, मेरा सुझाव है कि तुम अपने दिल और स्वाद को थोड़े ज़्यादा… फफूँदी-युक्त… ज़ायके के लिए खोलो।” \r\n",
    "ITEM_CROWBAR_LORE": "<style=cMono>\r\n//--UES [संपादित] के कार्गो बे 5 से स्वतः प्रतिलेखन --//</style>\r\n\r\n“अरे, ज़रा एक सब्बल उछालना?”\r\n\r\nJesse टूलबॉक्स तक गई और भीतर टटोलने लगी। डिब्बे से एक सब्बल निकालकर वह James के पास गई।\r\n\r\n“शुक्रिया,” वह कराहते हुए बोला और बक्से को उखाड़कर खोलने की कोशिश करने लगा। Jesse बगल की मेज़ पर बैठ गई और आराम से उसे काम करते देखने लगी। “कसम से, यही एक ऐसा बक्सा निकला जिसे पैसे देकर भी नहीं खोला जा सकता... क्रैश से ज़रूर... इसके अंदर का सर्किट टूट गया होगा।” James खुद से बुदबुदाया।\r\n\r\n“हाँ।” Jesse ने चारों ओर देखा, उसकी नज़र हाल की मुहिमों से लाए गए बक्सों के ढेर पर पड़ी। आह भरते हुए वह उठ खड़ी हुई। “मैं मेस हॉल जा रही हूँ। कुछ चाहिए?” \r\n\r\n“हाँ, एक बेहतर सब्बल ले आओ न? यह वाला तो बस दूसरा संस्करण है।” James ने अंगड़ाई ली और सब्बल कंधे के ऊपर से उछाल दिया। अभी भी बंद पड़े बक्से को थपथपाते हुए वह हँस पड़ा। “बढ़िया तो है, पर सच कहूँ… अब थोड़ा पुराना पड़ने लगा है।”\r\n\r\nJesse हँस पड़ी।\r\n",
    "ITEM_ATTACKSPEEDONCRIT_NAME": "शिकारी प्रवृत्ति",
    "ITEM_ATTACKSPEEDONCRIT_PICKUP": "'क्रिटिकल वार' हमले की गति बढ़ाते हैं। 3 बार तक जुड़ता है।",
    "ITEM_ATTACKSPEEDONCRIT_DESC": "<style=cIsDamage>क्रिटिकल वार</style> <style=cIsDamage>हमले की गति</style> को <style=cIsDamage>12%</style> बढ़ाते हैं। अधिकतम सीमा <style=cIsDamage>36% <style=cStack>(हर अतिरिक्त प्रति पर +24%)</style> हमले की गति</style> है।",
    "ITEM_ATTACKSPEEDONCRIT_LORE": "डरे हुए समुदायों में अफ़वाहें बड़ी तेज़ी से फैलती हैं। ऐसी कहानियाँ जो डरपोक छिपकली-वासियों को उनकी सुरंगों में दुबके रखती हैं। दबी आवाज़ में सुनाए जाने वाले किस्से जो सबसे रोबदार पत्थर के जीवों, वनवासियों और मैदानों के प्राणियों तक को कंपा देते हैं। डर पेड़ों और घाटियों के बीच बहता फिरता है।\n\nआसमान से गिरा एक दानव, इतना शक्तिशाली कि Providence और उसके वर्म्स का वध कर सके। केवल दो बाँहें, दो पैर — लेकिन 22 अपलक, सुर्ख लाल आँखें।\n",
    "ITEM_BLEEDONHIT_LORE": "<style=cMono>\r\nDataScraper में आपका स्वागत है (v3.1.53 – बीटा शाखा)\r\n$ मेमोरी खँगाली जा रही है... पूर्ण।\r\n$ समाधान किया जा रहा है... पूर्ण।\r\n$ प्रासंगिक डेटा छाँटा जा रहा है... पूर्ण।\r\nसंपन्न!\r\n</style>\r\n\r\nनीचे D. Cooper के मुकदमे की ऑडियो प्रतिलिपि है, जो 5 सिलसिलेवार हत्याओं के मामले में वांछित था।\r\n\r\n“मिस्टर Cooper, क्या आप इस वस्तु को पहचानते हैं?”\r\n\r\n“जी, पहचानता हूँ।”\r\n\r\n“क्या यह सच है कि आपने अपने शिकारों पर इस हथियार का इस्तेमाल किया था?”\r\n\r\n“हाँ।”\r\n\r\n“और, मिस्टर Cooper, क्या यह सच है कि... कि आप इस कटार से अपने शिकारों के भर चुके घावों को फिर से उधेड़ देते थे? ताकि उनका और अधिक निर्दोष रक्त बहाया जा सके?”\r\n\r\n“ओह हाँ। वह मेरा सबसे पसंदीदा हिस्सा था।”\r\n\r\n“आपका सबसे पसंदीदा हिस्सा, आपने कहा। जूरी के देवियों और सज्जनों, मुझे लगता है आप सभी देख सकते हैं कि मिस्टर Cooper सचमुच एक विक्षिप्त व्यक्ति हैं — जिन्होंने अनगिनत निर्दोष लोगों की जान ली। फिर भी, यदि आप पूरी तरह आश्वस्त नहीं हैं, तो जूरी के विचारार्थ मेरे पास एक और सबूत है। माननीय न्यायाधीश, यदि अनुमति हो तो क्या मैं मिस्टर Cooper की एक ऑडियो रिकॉर्डिंग चला सकता हूँ?”\r\n\r\n“आगे बढ़िए।”\r\n\r\n“धन्यवाद, माननीय न्यायाधीश। अब कृपया रिकॉर्डिंग चलाएँ।”\r\n\r\nइस अदालती प्रतिलिपि का शेष भाग सील कर दिया गया है।\r\nकारण: मुझे लगता है मुझे उल्टी आ जाएगी\r\n",
    "ITEM_SPRINTOUTOFCOMBAT_NAME": "लाल चाबुक",
    "ITEM_SPRINTOUTOFCOMBAT_PICKUP": "युद्ध से बाहर तेज़ी से चलें।",
    "ITEM_SPRINTOUTOFCOMBAT_DESC": "युद्ध से बाहर निकलने पर आपकी <style=cIsUtility>चलने की गति</style> <style=cIsUtility>30%</style> <style=cStack>(हर अतिरिक्त प्रति पर +30%)</style> बढ़ जाती है।",
    "ITEM_SPRINTOUTOFCOMBAT_LORE": "“...594 South River, Io के लिए जा रहा है। ठीक। एक चाबुक, लाल, प्राथमिकता शिपिंग। जा रहा है... को, उम्म... अरे वाह...”\r\n\r\n-सिग्नल की प्रतिध्वनियाँ, UES Contact Light\r\n",
    "ITEM_FALLBOOTS_NAME": "H3AD-5T v2",
    "ITEM_FALLBOOTS_PICKUP": "छलाँग की ऊँचाई बढ़ाएँ। ज़मीन पर ज़ोर से पटकने के लिए 'इंटरैक्ट' दबाए रखें।",
    "ITEM_FALLBOOTS_DESC": "<style=cIsUtility>छलाँग की ऊँचाई</style> बढ़ाएँ। ज़मीन से टकराने पर <style=cIsDamage>5 मीटर-100 मीटर</style> के दायरे में एक <style=cIsDamage>गतिज विस्फोट</style> होता है, जो <style=cIsDamage>1000%-10000%</style> आधार क्षति पहुँचाता है और <style=cIsDamage>गिरने की दूरी</style> के साथ बढ़ता है। <style=cIsDamage>10</style> <style=cStack>(हर अतिरिक्त प्रति पर -50%)</style> सेकंड में फिर से चार्ज होता है।",
    "ITEM_FALLBOOTS_LORE": "\"बुध जैसे कम गुरुत्वाकर्षण वाले ग्रहों के निवासियों को ऐतिहासिक रूप से अन्य ग्रहों के जीवन में ढलने में कठिनाई होती रही है। कम हड्डी घनत्व वाले बुधवासी (बाएँ) भारी ग्रहों पर आमतौर पर एक हफ्ते के भीतर ही अपनी जाँघ की हड्डी चटका बैठते थे। क्षुद्रग्रहों से बने बेड़ों और कॉलोनी जहाज़ों के सदस्यों को भी अंतरिक्ष से घर लौटते समय ऐसी ही समस्याओं का सामना करना पड़ता है।\r\n\r\nगतिज परिक्षेपण वलयों (ऊपर) के आविष्कार ने गतिज ऊर्जा को ऊष्मा, ध्वनि और प्रकाश में बदलकर सामान्य से अधिक गुरुत्वाकर्षण के दबाव को कम करने में मदद की। बुध के निवासी आखिरकार सुरक्षित रूप से अपना गृह ग्रह छोड़ सके।\"\r\n\r\n-बुध इतिहास संग्रहालय\r\n",
    "ITEM_COOLDOWNONCRIT_NAME": "दुष्ट अंगूठी",
    "ITEM_COOLDOWNONCRIT_PICKUP": "'क्रिटिकल वार' कूलडाउन को 1 सेकंड कम करते हैं।",
    "ITEM_COOLDOWNONCRIT_DESC": "<style=cIsDamage>5% क्रिटिकल संभावना</style> पाएँ। <style=cIsDamage>क्रिटिकल वार</style> आपके सभी <style=cIsUtility>कूलडाउन</style> को <style=cIsUtility>1</style> सेकंड कम कर देते हैं।",
    "ITEM_WARDONLEVEL_NAME": "युद्ध ध्वज",
    "ITEM_WARDONLEVEL_PICKUP": "स्तर बढ़ने या टेलीपोर्टर घटना शुरू करने पर युद्ध ध्वज गाड़ें। साथियों को हमले और चलने की गति देता है।",
    "ITEM_WARDONLEVEL_DESC": "<style=cIsUtility>स्तर बढ़ने</style> या <style=cIsUtility>टेलीपोर्टर घटना</style> शुरू करने पर एक ध्वज गाड़ें जो <style=cIsUtility>16 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +8 मीटर)</style> के भीतर सभी साथियों को सशक्त करता है। <style=cIsDamage>हमले</style> और <style=cIsUtility>चलने की गति</style> <style=cIsDamage>30%</style> बढ़ाएँ।",
    "ITEM_WARDONLEVEL_LORE": "भारी नुकसान की आशंका थी — आखिरकार, आक्रमणकारी जितने चालाक थे, उतने ही घातक भी थे। \r\n\r\nआखिरकार धूल शांत हो गई। गोलेम धरती में लौट गए, और लेमूरियन अपनी सुरंगों में वापस चले गए। यह एक लंबी और थका देने वाली लड़ाई थी, लेकिन वे जीत गए थे। आक्रमणकारियों का सफ़ाया कर दिया गया था।\r\n\r\nउनके अंतिम मोर्चे का एकमात्र प्रमाण था एक अकेला ध्वज, जो लाशों के पहाड़ के ऊपर हवा में लहरा रहा था।\r\n",
    "ITEM_WARCRYONMULTIKILL_NAME": "बर्ज़रकर का कंधा-कवच",
    "ITEM_WARCRYONMULTIKILL_PICKUP": "तेज़ी से लगातार 4 दुश्मनों को मारने पर उन्माद में आ जाएँ।",
    "ITEM_WARCRYONMULTIKILL_DESC": "<style=cIsDamage>1</style> सेकंड के भीतर <style=cIsDamage>4 दुश्मनों को मारने</style> से आप <style=cIsDamage>6 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +4 सेकंड)</style> के लिए <style=cIsDamage>उन्माद</style> में आ जाते हैं। <style=cIsUtility>चलने की गति</style> <style=cIsUtility>50%</style> और <style=cIsDamage>हमले की गति</style> <style=cIsDamage>100%</style> बढ़ाता है।",
    "ITEM_WARCRYONMULTIKILL_LORE": "ऑर्डर: प्राचीन कंधा-कवच\r\nट्रैकिंग नंबर: 58***********\r\nअनुमानित डिलीवरी: 04/05/2056\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: Jungle VII, 2019 का संग्रहालय, पृथ्वी\r\nशिपिंग विवरण: \r\n\r\nसंग्रह के लिए एक और प्राचीन वस्तु। यह ज़बरदस्त चीज़ उस युद्धक्षेत्र में मिली जहाँ युद्ध का बड़ा हिस्सा लड़ा गया था। खुदाई स्थल हड्डियों से अटा पड़ा था, जो सभी एक विद्रोही सैनिक के अवशेषों के चारों ओर बिखरी थीं, जिसके पास यह कलाकृति थी। सुनी-सुनाई बातों और अफ़वाहों के अनुसार, इसके जैसे कंधा-कवच पहनने वाले विद्रोही सैनिक युद्धक्षेत्र में एक अजीब तंद्रा में चले जाते थे। समय मानो थम जाता था, और उन्हें बस दुश्मन ही दिखाई देता था।\r\n\r\nबेशक, यह बस अटकलें हैं, लेकिन… इस चीज़ के पुराने मालिक के चारों ओर बहुत सारी लाशें थीं। सावधान रहना, ठीक है?\r\n",
    "ITEM_PHASING_NAME": "पुराने युद्ध का अदृश्यता किट",
    "ITEM_PHASING_PICKUP": "कम स्वास्थ्य पर अदृश्य हो जाएँ।",
    "ITEM_PHASING_DESC": "<style=cIsHealth>25% स्वास्थ्य</style> से नीचे गिरने पर आपको <style=cIsUtility>5 सेकंड</style> के लिए <style=cIsUtility>40% चलने की गति</style> और <style=cIsUtility>अदृश्यता</style> मिलती है। हर <style=cIsUtility>30 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर -50%)</style> में फिर से चार्ज होता है।",
    "ITEM_PHASING_LORE": "ऑर्डर: विविध पुराने युद्ध की कलाकृतियाँ (47)\r\nट्रैकिंग नंबर: 01******\r\nअनुमानित डिलीवरी: 08/13/2056\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: राष्ट्रीय पुराना युद्ध संग्रहालय, New Orleans, पृथ्वी\r\nशिपिंग विवरण:\r\n\r\nहमें स्थानीय स्तर पर पुराने युद्ध की जितनी भी कलाकृतियाँ मिल सकीं, हमने इकट्ठा कर ली हैं। यहाँ कई दिलचस्प चीज़ें हैं: राइफलें, राशन, पर्चे। हमें शानदार हालत में एक प्रोटोटाइप अदृश्यता किट भी मिला; यह आपकी प्रदर्शनी का मुख्य आकर्षण बन सकता है।\r\n\r\nहालाँकि, एक छोटी-सी दिक्कत हो गई: रास्ते में ट्रक एक गड्ढे से टकराया और पूरा माल हिल गया। लगता है इससे किसी अजीब शॉर्ट-सर्किट के कारण अदृश्यता ड्राइव सचमुच चालू हो गई — और हमारी टीम अब इस किट की सही जगह की पुष्टि नहीं कर पा रही है। यह किसी न किसी बक्से में तो होना ही चाहिए — हमें उम्मीद है कि कमीशन में अदृश्यता किट को भी शामिल किया जाएगा।\r\n",
    "ITEM_HEALONCRIT_NAME": "कटाई करने वाले की दराँती",
    "ITEM_HEALONCRIT_PICKUP": "'क्रिटिकल वार' आपका उपचार करते हैं।",
    "ITEM_HEALONCRIT_DESC": "<style=cIsDamage>5% क्रिटिकल संभावना</style> पाएँ। <style=cIsDamage>क्रिटिकल वार</style> <style=cIsHealing>8</style> <style=cStack>(हर अतिरिक्त प्रति पर +4)</style> <style=cIsHealing>स्वास्थ्य</style> का <style=cIsHealing>उपचार</style> करते हैं।",
    "ITEM_HEALONCRIT_LORE": "“मैं कहीं नहीं जाने वाला। मैं जो करता हूँ वह ज़रूरी है, और कोई भी महामारी मुझे उसे पूरा करने से नहीं रोक सकती। शहर वाले इस-उस बात को लेकर घबराए रहते हैं, इस डर से कि कहीं वे अपने बनाए किसी पागल लक्ष्य को पूरा किए बिना न गुज़र जाएँ। \r\n\r\nलेकिन मुझे मौत का कोई डर नहीं। दुख भी जीवन का ही एक हिस्सा है, और मेहनत की तरह मैं इसे भी खुद झेल सकता हूँ। मौत से मैं यही कहता हूँ: मुझे तुम्हारी लानत मदद नहीं चाहिए।”\r\n\r\n- अनाम किसान, बुध की त्रासदी: एक इतिहास\r\n",
    "ITEM_HEALWHILESAFE_LORE": "“किसी पशु साथी को रखने के बारे में याद रखने वाली सबसे महत्वपूर्ण बातों में से एक यह है कि आपका रिश्ता भरोसे पर टिका होता है। यद्यपि मनुष्य समझदार होते हैं, फिर भी हम जो देखते हैं उसी से अंधे हो जाते हैं — और उन खतरों को अनदेखा कर देते हैं जो हमारी दृष्टि से परे छिपे होते हैं। जानवर और अन्य परग्रही जीव वे चीज़ें भाँप सकते हैं जो हम नहीं कर सकते। \r\n\r\nइसलिए हमेशा याद रखें: अगर आपका साथी अंधेरे में किसी खतरे की चेतावनी दे, तो बेहतर होगा कि आप उसकी बात ध्यान से सुनें।”\r\n\r\n- अपने पालतू जानवरों की देखभाल, खंड III\r\n",
    "ITEM_JUMPBOOST_NAME": "मोम का बटेर",
    "ITEM_JUMPBOOST_PICKUP": "दौड़ते समय कूदने से आप आगे की ओर उछलते हैं।",
    "ITEM_JUMPBOOST_DESC": "<style=cIsUtility>दौड़ते समय</style> <style=cIsUtility>कूदने</style> से आप <style=cIsUtility>10 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +10 मीटर)</style> आगे की ओर उछलते हैं।",
    "ITEM_JUMPBOOST_LORE": "ऑर्डर: मोम का बटेर\r\nट्रैकिंग नंबर: 15******\r\nअनुमानित डिलीवरी: 12/18/2056\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: अनुसंधान केंद्र, Polarity Zone, वरुण ग्रह\r\nशिपिंग विवरण:\r\n\r\nहैलो Buu,\r\nतुम कैसे हो? मैं माँ बोल रही हूँ। \r\n\r\nयहाँ का मौसम बेहद खराब रहा है। रोज़ बारिश हो रही है। हमें हाल ही में पास में एक नई बेकरी मिली है जहाँ लाजवाब सैंडविच मिलते हैं। पापा ने हाल ही में तराशने का शौक पाल लिया है। वे मोम का इस्तेमाल करते हैं क्योंकि वह ज़्यादा मुलायम होता है। मैंने उनका एक पसंदीदा नमूना साथ भेज दिया है। उम्मीद है डाक में इसे कोई खरोंच नहीं लगी होगी :-)\r\n\r\nखैर, अब मैं Buu को तंग नहीं करूँगी। उम्मीद है जल्द ही मिलेंगे!\r\nमाँ",
    "ITEM_PERSONALSHIELD_LORE": "\"हालाँकि इसकी गतिज सुरक्षा रेटिंग बहुत कमज़ोर है, फिर भी Hinon के व्यक्तिगत अवरोध की बेहद कम उत्पादन लागत ने इसे पर्वतारोहियों, नाविकों और यहाँ तक कि रोज़ाना सफ़र करने वालों के लिए भी कठिन मौसम में आरामदायक रहने का शानदार किफ़ायती साधन बना दिया। दफ़्तर के कई लोगों ने पाया कि वे अपनी महँगी सर्दी की जैकेटों की जगह आरामदायक और ट्रेंडी व्यक्तिगत अवरोध इस्तेमाल कर सकते हैं!\"\r\n\r\n-2053 के शीर्ष 10 सर्वश्रेष्ठ व्यक्तिगत अवरोध\r\n",
    "ITEM_NOVAONHEAL_NAME": "N'kuhana का मत",
    "ITEM_NOVAONHEAL_PICKUP": "उपचार मिलने पर डरावनी खोपड़ियाँ दागें।",
    "ITEM_NOVAONHEAL_DESC": "उपचार का <style=cIsHealing>100%</style> <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> भाग <style=cIsHealing>आत्म ऊर्जा</style> के रूप में संचित करें। जब आपकी <style=cIsHealing>आत्म ऊर्जा</style> आपके <style=cIsHealing>अधिकतम स्वास्थ्य</style> के <style=cIsHealing>10%</style> तक पहुँच जाए, तो <style=cIsDamage>एक खोपड़ी दागें</style> जो <style=cIsDamage>250% <style=cStack>(हर अतिरिक्त प्रति पर +250%)</style> क्षति</style> तथा आपकी <style=cIsHealing>आत्म ऊर्जा</style> के <style=cIsDamage>250%</style> के बराबर अतिरिक्त क्षति पहुँचाती है।",
    "ITEM_NOVAONHEAL_LORE": "\"आइए आरंभ करें।\r\n\r\nतुम्हारी शपथ क्या है?\r\n\r\nबहुत समय पहले की बात नहीं है, स्वास्थ्य और समय पूर्ण सामंजस्य में थे। पीड़ा और प्रेम। मृत्यु और स्मृतियाँ। वह महान समतावादी। वह हमेशा हमारे लिए आती थी। \r\n\r\nकिंतु! अब असमानता हमारी पीढ़ियों — और हमारे बच्चों की पीढ़ियों — को ग्रस रही है। बहुत कम लोग गुज़रते हैं, पर अनगिनत जन्म लेते हैं। न जाने कितनी अभिशप्त आत्माएँ बचा ली जाती हैं। एक प्रजाति के रूप में हमारा अहंकार बढ़ता जा रहा है — अनियंत्रित। बेलगाम। \r\n\r\nअब हमारे संसार में मृत्यु के लिए कोई स्थान नहीं बचा, और वह हमारे पास आ नहीं सकती। किंतु क्या जीवित रहना केवल मृत्यु से दूरी भर है? यदि कोई अंतर न रहे, तो क्या हम सब जीवन में ही मृत नहीं हो जाएँगे? मानक बदल चुका है, और अब हम सभी फिर कभी न जी पाने के बेहद क़रीब आ चुके हैं।\r\n\r\nहमें उसके नाम के लिए स्थान बनाना होगा — संतुलन बहाल करने के लिए। आइए हम अवधारणाओं को निगल लें, ताकि हम उस फूले हुए कुंड को खाली करना शुरू कर सकें जो हमारा संसार है। शिष्यों के रूप में, हम उसके वचन और मत फैलाएँगे। विद्यार्थियों के रूप में, हम मृत्यु के बीज बोएँगे। और यदि हम सौभाग्यशाली हुए... तो हमें उसके दर्शन का अवसर मिलेगा।\r\n\r\nWeshan!\"\r\n\r\n-The N'tormat, अध्याय I, पद I, श्लोक II\r\n",
    "ITEM_MEDKIT_LORE": "\n<style=cMono>\"मेरा सुझाव है कि आप भीतर ही रहें और आराम करें।\"</style>\r\n\r\nचिकित्सा रोबोट MED-E बिना रुके अतिरिक्त काम कर रहा था। उत्तरजीवी बेहद शुक्रगुज़ार थे कि उनका एस्केप पॉड मेड बे के कार्गो के पास उतरा था — इसके बिना शायद वे बच नहीं पाते।\r\n\r\n<style=cMono>\"मेरा सुझाव है कि आप भीतर ही रहें और आराम करें।\"</style>\r\n\r\nरोबोट एक लंबे, दुबले लेकिन मज़बूत आदमी से बात कर रहा था। \"मैं तो आराम करना ही चाहूँगा, लेकिन हमारा खाना खत्म हो रहा है।\" हालाँकि उसके नीले युद्ध हेलमेट के नीचे उसका चेहरा छिपा था, फिर भी साफ़ था कि वह आदमी बुरी तरह थका हुआ है। \"और बाकी सभी कल रात के हमलों से उबर रहे हैं। एनफ़ोर्सर्स के बिना शायद हम—\"\r\n\r\n<style=cMono>\"मेरा सुझाव है कि आप भीतर ही रहें और आराम करें।\" </style>\r\n\r\nसाफ़ ज़ाहिर था कि MED-E के पास गिने-चुने संवाद ही थे। फिर भी, वह आदमी जवाब देता रहा। \"मैं नहीं रुक सकता, MED-E। वे सब मुझ पर भरोसा कर रहे हैं। तुम जानते हो न।\"\r\n\r\n<style=cMono>\"मेरा सुझाव है कि आप भीतर ही रहें और आराम करें।\" </style>\r\n\r\nइस बार उस आदमी ने कोई जवाब नहीं दिया। अपनी शॉटगन उठाते हुए वह दोहराते हुए रोबोट से मुँह मोड़कर चल पड़ा। अनगिनत स्लीपिंग बैग्स और स्ट्रेचरों के बीच से रास्ता बनाते हुए वह एक बार फिर जंगल की ओर निकल पड़ा। हर कोई उसी के भरोसे था।\r\n\r\n<style=cMono>\"कृपया भीतर ही रहें और आराम करें।\" </style>\r\n",
    "ITEM_EQUIPMENTMAGAZINE_NAME": "ईंधन सेल",
    "ITEM_EQUIPMENTMAGAZINE_PICKUP": "उपकरण का एक अतिरिक्त चार्ज रखें। उपकरण कूलडाउन घटाएँ।",
    "ITEM_EQUIPMENTMAGAZINE_DESC": "<style=cIsUtility>उपकरण का एक अतिरिक्त चार्ज</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> रखें। <style=cIsUtility>उपकरण कूलडाउन</style> को <style=cIsUtility>15%</style> <style=cStack>(हर अतिरिक्त प्रति पर +15%)</style> घटाएँ।",
    "ITEM_EQUIPMENTMAGAZINE_LORE": "\"जैसे-जैसे मानवता ने अंतरिक्ष की गहराइयों में कदम रखना शुरू किया, अंतर्ग्रही यात्रा के लिए उच्च-ऊर्जा लेकिन कम-आयतन वाले ईंधन स्रोत बेहद ज़रूरी हो गए। स्थिरता बाद में आई।\"\n-अंतर्ग्रही प्रगति का संक्षिप्त इतिहास, खंड 2\n",
    "ITEM_INFUSION_NAME": "इन्फ़्यूज़न",
    "ITEM_INFUSION_PICKUP": "दुश्मन को मारने पर आपका अधिकतम स्वास्थ्य स्थायी रूप से बढ़ता है, अधिकतम 100 तक।",
    "ITEM_INFUSION_DESC": "दुश्मन को मारने पर आपका <style=cIsHealing>स्वास्थ्य स्थायी रूप से</style> <style=cIsHealing>1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> बढ़ता है, <style=cIsHealing>अधिकतम</style> <style=cIsHealing>100 <style=cStack>(हर अतिरिक्त प्रति पर +100)</style> स्वास्थ्य</style> तक।",
    "ITEM_INFUSION_LORE": "ऑर्डर: इन्फ़्यूज़न\r\nट्रैकिंग नंबर: 768******\r\nअनुमानित डिलीवरी: 02/8/2056\r\nशिपिंग विधि: प्राथमिकता/जैविक\r\nशिपिंग पता: Rage Valley, Fleet Hanger, मंगल ग्रह\r\n\r\nइसमें भालू, जोंक, बाघ, हाथी, एलिफ़ेंट शार्क, शार्क, बुल शार्क, चींटियों और चींटीखोरों के नमूने शामिल हैं। बस ज़रूरी उपकरणों के साथ एक डायलिसिस मशीन से जुड़िए और अपने रक्त को आनुवंशिक रूप से श्रेष्ठ रक्त से बदल लीजिए! \r\n\r\nजहाँ तक मुझे पता है, आप चाहें तो कोई भी रक्त नमूना मिला सकते हैं। बस यह पक्का कर लें कि आप वे गोलियाँ लें जो शरीर को नए रक्त को स्वीकार करने देती हैं, वरना आपका शरीर अंतर-प्रजाति इन्फ़्यूज़न को अस्वीकार कर देगा। याद रखें कि दूसरे जानवरों से नमूने लेना प्रयोग के लिए एक शानदार आधार है!\r\n",
    "ITEM_SHOCKNEARBY_NAME": "अस्थिर टेस्ला कॉइल",
    "ITEM_SHOCKNEARBY_PICKUP": "हर 10 सेकंड में आस-पास के सभी दुश्मनों को बिजली का झटका दें।",
    "ITEM_SHOCKNEARBY_DESC": "हर <style=cIsDamage>0.5 सेकंड</style> में <style=cIsDamage>बिजली</style> दागें जो <style=cIsDamage>3</style> <style=cStack>(हर अतिरिक्त प्रति पर +2)</style> दुश्मनों पर प्रहार कर <style=cIsDamage>200%</style> आधार क्षति पहुँचाती है। टेस्ला कॉइल हर <style=cIsDamage>10 सेकंड</style> में बंद हो जाता है।",
    "ITEM_SHOCKNEARBY_LORE": "<style=cMono>टेस्ला प्रस्तुति सॉफ़्टवेयर v1.14\r\nचालू हो रहा है...\r\n10...\r\nस्वागत संदेश जारी किया जा रहा है...\r\n9...</style>\r\nआप सभी का स्वागत है!\r\n<style=cMono>8...</style>\r\nकृपया अपना स्थान ग्रहण करें।\r\n<style=cMono>7...</style>\r\nसुनिश्चित करें कि आपके पीछे बैठे लोग देख सकें।\r\n<style=cMono>6...</style>\r\nप्रस्तुति शीघ्र ही प्रारंभ होगी।\r\n<style=cMono>5...</style>\r\nअपनी सुरक्षा के लिए कर्मचारियों के निर्देशों का पालन करें।\r\n<style=cMono>4...\r\nकक्ष की मूड लाइटिंग आरंभ की जा रही है...\r\n3...</style>\r\nतैयार हो जाइए देखने के लिए...\r\n<style=cMono>2...</style>\r\nअद्भुत चमत्कार...\r\n<style=cMono>1...</style>\r\nविद्युत के!\r\n<style=cMono>विद्युत विसंगति का पता चला...\r\n10 में रीबूट प्रक्रिया आरंभ हो रही है...</style>\r\n",
    "ITEM_IGNITEONKILL_LORE": "<style=cMono>\r\nसिग्नल की प्रतिध्वनियों से ऑडियो प्रतिलेखन पूर्ण। सामान्य टोकन सौंपे जा रहे हैं।</style>\r\n\r\n[आग के चटकने की आवाज़]\r\n\r\nपुरुष 1: क्या—क्या तुम्हें लगता है वे हमें बचाने आएँगे?\r\n\r\nपुरुष 2: वे कोशिश करेंगे। लेकिन इसमें बहुत लंबा वक्त लगेगा।\r\n\r\nपुरुष 1: क्या? क्यों?\r\n\r\nपुरुष 2: बहुत लंबा वक्त। भले ही उन्हें पता हो कि कहाँ ढूँढना है, हम सबसे नज़दीकी बंदरगाह से महीनों दूर हैं। और वह भी तब जब उनके पास हमारे जितना तेज़ कोई जहाज़ हो — आजकल FTL जहाज़ बहुत दुर्लभ हैं।\r\n\r\nपुरुष 1: महीनों...?! और 'भले ही उन्हें पता हो कहाँ' से तुम्हारा क्या मतलब है? हमारे शिपिंग मार्गों पर चलने वाले बाकी जहाज़ों का क्या?\r\n\r\nपुरुष 2: हम अपने मार्ग पर नहीं थे।\r\n\r\n[आग से चिंगारी चटकती है]\r\n\r\nपुरुष 1: क्या?!\r\n\r\nपुरुष 2: जब हम दुर्घटनाग्रस्त हुए, तब हमें Procyon के आधे रास्ते पर होना चाहिए था... पर हम वहाँ नहीं थे। जहाज़ ने धीमा होने की घोषणा भी कभी नहीं की, इसलिए हमारी स्थिति का पता लगाना और भी मुश्किल होगा।\r\n\r\nपुरुष 1: मु—मुझे समझ नहीं आ रहा। कौन एक UES ट्रेन को उसके रास्ते से भटकाएगा? यह तो सरासर पागलपन है!\r\n\r\nपुरुष 2: मुझे नहीं पता — यह सिर्फ़ कैप्टन जानते हैं। इस तारा-मंडल में धीमा होने की कोई वजह नहीं थी — यहाँ तो कोई रहने लायक़ ग्रह भी नहीं होना चाहिए था।\r\n\r\n[भुनने की आवाज़]\r\n\r\nपुरुष 2: यह पक चुका लगता है। स्वाद कैसा होगा इसकी गारंटी नहीं दे सकता — लेकिन हमें खाना तो पड़ेगा।\r\n\r\nपुरुष 1: मैं... मैं अभी कुछ सोच भी नहीं पा रहा। मुझे भूख नहीं है।\r\n\r\nपुरुष 2: खाओ। कल हमें बहुत लंबा सफ़र तय करना है और हमें अपनी ताक़त बचाए रखनी होगी।\r\n\r\nपुरुष 1: ठीक है। ठीक है। उम्म… क्या तुम्हें लगता है यह ज़हरीला होगा?\r\n\r\nपुरुष 2: खाओ।\r\n\r\n<style=cMono>अनुरोधित प्रतिलिपि समाप्त। </style>\r\n",
    "ITEM_BOUNCENEARBY_NAME": "सचेत मांस काँटा",
    "ITEM_BOUNCENEARBY_PICKUP": "आस-पास के सभी दुश्मनों को काँटे से खींचने की संभावना।",
    "ITEM_BOUNCENEARBY_DESC": "प्रहार पर <style=cIsDamage>20%</style> <style=cStack>(हर अतिरिक्त प्रति पर +20%)</style> संभावना है कि अधिकतम <style=cIsDamage>10</style> <style=cStack>(हर अतिरिक्त प्रति पर +5)</style> दुश्मनों पर <style=cIsDamage>लक्ष्य-खोजी काँटे दागे जाएँ</style>, जो <style=cIsDamage>100%</style> कुल क्षति पहुँचाते हैं।",
    "ITEM_BOUNCENEARBY_LORE": "\"जब कृत्रिम बुद्धिमत्ता आम हो गई, तो कई कंपनियाँ \"स्मार्ट\" उत्पादों के चलन में कूद पड़ीं। इनमें स्मार्ट दरवाज़े, लाइटें, कॉफ़ी मेकर, लॉनमोवर, वैक्यूम क्लीनर, बिस्तर, रसोई के चाकू सेट और अन्य घरेलू सामान शामिल थे। हैक किए गए स्मार्ट उपकरणों के कारण हुए कई भयावह मुकदमों के बाद, ज़्यादातर उत्पाद जल्द ही अपनी पारंपरिक, एनालॉग श्रेणी में वापस लौट आए।\"\r\n\r\n-\"स्मार्ट इतना मूर्ख क्यों है? VII\"\r\n",
    "ITEM_FIREWORK_LORE": "\"अरे, सालगिरह मुबारक!\r\n\r\nक्या तुम्हें सच में लगा कि मैं भूल गया?\r\n\r\nआह, मुझे तो लगता था हमारे रिश्ते में मैं ही बुद्धू हूँ। चलो भी T, बिल्कुल नहीं! खैर, मैं एक छोटे-से एलियन मौत के ग्रह को हमारी रात बर्बाद नहीं करने देने वाला था। है न? श्श, बस देखो। बस देखो। सब ठीक है। बस देखो। तुम्हें यह बहुत पसंद आएगा — सच में। फिर हम घर जा सकते हैं।\r\n\r\nतुम अपनी आँखें बंद रख सकती हो। बस सुनो। आह — वह रहा! पाँच... चार... तीन... दो... एक...!\"\r\n",
    "ITEM_BANDOLIER_NAME": "कारतूस पेटी",
    "ITEM_BANDOLIER_PICKUP": "दुश्मन को मारने पर एक गोला-बारूद पैक गिरने की संभावना जो सभी कौशल कूलडाउन रीसेट कर देता है।",
    "ITEM_BANDOLIER_DESC": "दुश्मन को मारने पर एक गोला-बारूद पैक गिरने की <style=cIsUtility>18%</style> <style=cStack>(हर अतिरिक्त प्रति पर +10%)</style> संभावना, जो <style=cIsUtility>सभी कौशल कूलडाउन रीसेट कर देता है</style>।",
    "ITEM_BANDOLIER_LORE": "ऑर्डर: कारतूस पेटी\r\nट्रैकिंग नंबर: 112*****\r\nअनुमानित डिलीवरी: 04/19/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: 3950 Sunsell Ln, Tri-City, पृथ्वी\r\nशिपिंग विवरण:\r\n\r\nनीलामी में भाग लेने के लिए धन्यवाद! हमने इस वस्तु का एक संक्षिप्त इतिहास, साथ ही इसकी प्रामाणिकता सत्यापित करने वाले दस्तावेज़ भी संलग्न किए हैं।\r\n\r\nयह वही प्रसिद्ध कारतूस पेटी है जिसे स्वयं B. Grundy पहनता था। वह और उसके साथी नए इलाकों के नक्शे पर हर जगह आतंक मचाया करते थे। उनका सबसे पसंदीदा काम था जिन लोगों को वे पसंद नहीं करते थे, उन्हें बाँधकर अपने घोड़ों के पीछे घसीटना — Grundy को पुराने दिनों से साफ़ तौर पर गहरा लगाव था।\r\n\r\nइस पट्टे में कई तरह के कारतूसों का शानदार संग्रह आता है — Grundy खुद कई अलग-अलग बंदूकें रखता था। अफ़वाह थी कि वे पूरे 3 दिन और रात तक डटे रहे, तब जाकर उनके हथियारों की गोलियाँ खत्म हुईं।\r\n\r\n",
    "ITEM_STUNCHANCEONHIT_LORE": "<style=cMono>\r\n//--UES [संपादित] के कार्गो बे 2 से स्वतः प्रतिलेखन --//</style>\r\n“इन्वेंटरी ड्यूटी। कसम से, यह अब तक का सबसे उबाऊ काम होगा...” दो सहकर्मी कार्गो बे में खड़े होकर Contact Light के मलबे से इकट्ठा की गई वस्तुओं की नियमित जाँच कर रहे थे। “हममें से कुछ लोग बाहर रोमांच पर जा रहे हैं और एलियनों से लड़ रहे हैं, और मैं यहाँ धूल से अटे छोटे-मोटे सामान गिनने में फँसा हूँ। कितनी बुरी किस्मत है।” दूसरा सहकर्मी आराम से अपने उपकरण पर टैप कर रहा था जबकि उसका साथी बरामद वस्तुओं के एक डिब्बे में टटोल रहा था।\r\n\r\n“मैं इससे सहमत नहीं हूँ। Contact Light में लाखों चीज़ें सफ़र कर रही थीं... यह पूरी आकाशगंगा के लोगों की रुचियों का एक कोलाज जैसा है।” दूसरे सहकर्मी ने उपहास किया। “अच्छा जी? यह तो बड़ा प्रेरणादायक है। सुनो, ऐसी ही कहानियाँ सुनाते रहो, शायद इससे यह काम जल्दी खत्म हो जाए।”\r\n\r\n“तुम्हें बस इसे एक अलग नज़रिए से देखने की ज़रूरत है। यहाँ कितनी कमाल की चीज़ें हैं! जैसे, उदाहरण के लिए...” कर्मचारी ने डिब्बे से कुछ बाहर निकाला — अपने साथी की ओर नज़र जाते ही दूसरा कर्मचारी सन्न रह गया।\r\n\r\n“अरे यह—क्या वह ग्रेनेड है!?” \r\n\r\nकर्मचारी हँस पड़ा और धूल-मिट्टी से सने ग्रेनेड को एक हाथ से दूसरे हाथ में उछालने लगा। “हाँ। चिंता मत करो, यह क्रैश में खराब हो गया था। देखो? बिल्कुल बेअसर है।” ग्रेनेड को ऊपर उठाने पर उसके खोल में एक बड़ा गड्ढा साफ़ दिख रहा था। “यार, सोचता हूँ यह कौन-सा मॉडल होगा... मुझे हमेशा से हथियारों और ऐसी चीज़ों में बहुत दिलचस्पी रही है। हूँ... लगता है यह फ़्लैशबैंग है... पुराना मॉडल, अब ऐसी चीज़ें नहीं बनाते।” \r\n\r\nदूसरा कर्मचारी बिल्कुल खुश नहीं था। “फिर भी मुझे नहीं लगता कि तुम्हें उससे खेलना चाहिए। वह कोई खिलौना नहीं है।” आँखें सिकोड़कर देखते हुए दूसरे कर्मचारी को दहशत के साथ एहसास हुआ कि उस खराब ग्रेनेड में पिन ही नहीं थी। “अ—अरे यार! उस चीज़ को नीचे रखो, उसमें पिन नहीं है!”\r\n\r\n“हैं? अरे चलो भी! इतना मज़ा किरकिरा मत करो! यह चीज़ मरम्मत से परे टूट चुकी है। यह फट ही नहीं सकती, तब भी नहीं जब मैं इसे मान लो... इस मेज़ पर पटक दूँ। देखो, मैं तुम्हें दिखाता हूँ।”\r\n\r\nइसके तुरंत बाद दोनों को चिकित्सा कक्ष में भर्ती कराना पड़ा।\r\n",
    "ITEM_LUNARDAGGER_NAME": "गढ़ा हुआ काँच",
    "ITEM_LUNARDAGGER_PICKUP": "अपनी क्षति दोगुनी करें... <color=#FF7F7F>परंतु आपका स्वास्थ्य आधा हो जाएगा।</color>\n",
    "ITEM_LUNARDAGGER_DESC": "आधार क्षति को <style=cIsDamage>100%</style> <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> बढ़ाएँ। <style=cIsHealing>अधिकतम स्वास्थ्य में 50% की कमी करें</style> <style=cStack>(हर अतिरिक्त प्रति पर +50%)</style>।",
    "ITEM_LUNARDAGGER_LORE": "<style=cMono>\n========================================\n====   MyBabel मशीनी अनुवादक       ====\n====     [संस्करण 12.45.1.009 ]    ======\n========================================\nप्रशिक्षण जारी... <100000000 चक्र>\nप्रशिक्षण जारी... <100000000 चक्र>\nप्रशिक्षण जारी... <100000000 चक्र>\nप्रशिक्षण जारी... <50912157 चक्र>\nरोका गया...\nआंशिक परिणाम दिखाएँ? हाँ/नहीं\nहाँ\n================================</style>\nयुग्मन\n\n[चंद्रमा] के हृदय से निकला निराकार काँच। 3 चक्रों के दौरान सूक्ष्म लपटों में गाकर बाहर निकाला गया। विराम।\n\nहम इसके पदार्थ में समय को मोड़ते हैं — दो बार। हमारा समय और <उसका>। एक कीमत जो <वह> हमसे चुकाने को तैयार था। एक देवता की परिकल्पना से मोड़ा और गढ़ा हुआ।\n \n<वह> इसे अपने कई महान हाथों में से एक में थामता है। हमने जो समय इसमें भरा था, वह <उसकी> पकड़ में खुलता है। परिणाम तेज़ हो जाते हैं — मांसपेशियाँ दोगुनी सिकुड़ती हैं। दोगुने इरादे। दोगुनी व्यवस्थित जटिलताएँ, स्वयं पर मुड़ी हुई। चक्र जोड़ियों में [?] पर वापस घूमते हैं। समय-निर्भर कार्य। विराम।\n\n<वह> एक संरचना को हज़ार टुकड़ों में चीर देता है।\n\nकिंतु समय न्यायप्रिय है। सूक्ष्म दरारें जोड़ियों में खुलने लगती हैं। मांसपेशियाँ दोगुनी तेज़ी से चटकने लगती हैं। मोड़े गए समय की कीमत। किंतु <उसके> पास बहुत समय है।\n\n<style=cMono>\n================================\nप्रशिक्षण जारी रखें? हाँ/नहीं\nहाँ</style>\n",
    "ITEM_GOLDONHIT_NAME": "भंगुर मुकुट",
    "ITEM_GOLDONHIT_PICKUP": "प्रहार पर सोना पाएँ... <color=#FF7F7F>परंतु चोट लगने पर सोना गँवाएँ।</color>\n",
    "ITEM_GOLDONHIT_DESC": "प्रहार पर <style=cIsUtility>2<style=cStack> (हर अतिरिक्त प्रति पर +2)</style> सोना</style> पाने की <style=cIsUtility>30% संभावना</style>। <style=cIsUtility>समय के साथ बढ़ता है।</style>\n\nक्षति झेलने पर, आपने अपने <style=cIsHealth>अधिकतम स्वास्थ्य का जितना प्रतिशत खोया</style>, उसके <style=cIsHealth>100%<style=cStack> (हर अतिरिक्त प्रति पर +100%)</style></style> के बराबर <style=cIsHealth>सोना गँवाएँ</style>।",
    "ITEM_GOLDONHIT_LORE": "एक घृणित मेला।\r\n\r\nउनका विनाश उचित कारण से तय था। Aphelia के रेगिस्तानी लोग: परजीवी प्रभावों की कट्टर पूजा में खोए हुए। लेमूरियन: एक मृत ग्रह के लिए अभिशप्त, पूरी तरह लूटे हुए। काइटिन के दैत्य। मृत्यु के यंत्र। तुम उन्हें घर क्यों लाते हो? उनका जीवित रहना तय नहीं था। \r\n\r\nमैंने युगों से अपनी मृत चट्टान से तुम्हें देखा है — और हर सदी में तुम अपने अहंकार से मुझे घृणा से भर देते हो। तुम अपने घर में कीड़ों को न्योता देते हो। अभागे। चूहे। राक्षस। बेलगाम प्राणी। उनमें से हर एक, ग्रहों का विनाशक। और फिर भी, तुम उनका अतिथियों की तरह सत्कार करते हो। बच्चों की तरह, जिन्हें बचाने और सुरक्षा देने की ज़रूरत हो।\r\n\r\nउसे मेरे लिए मरना चाहिए था। उसका उपहार तुम पर व्यर्थ गया।\r\n\r\nऔर हम कब चर्चा शुरू करेंगे — प्रिय भाई — तुम्हारे उन सभी खोखले झूठों पर? तुम अपने अतिथियों को जाने से क्यों रोकते हो? जहाज़ चलाने से क्यों रोकते हो? यदि तुम्हारी भूमिका रक्षा की है, तो तुम विशाल दीवारें और द्वार क्यों बनाते हो? विनाश के यंत्र क्यों रचते हो? वे केवल तुम्हारे संग्रह की प्रविष्टियाँ हैं। तुम दास-स्वामी हो। द्वारपाल। संग्रहखोर।\r\n\r\nतुम्हारी मृत्यु नियत है। जब तुम मरोगे — और तुम अवश्य मरोगे — मैं तैयार रहूँगा। मैंने सहस्राब्दियों तक धैर्य रखा है। वह ग्रह... मेरा है।",
    "ITEM_SHIELDONLY_NAME": "पारलौकिकता",
    "ITEM_SHIELDONLY_PICKUP": "अपने सारे स्वास्थ्य को ढाल में बदलें। अधिकतम स्वास्थ्य बढ़ाएँ।",
    "ITEM_SHIELDONLY_DESC": "<style=cIsHealing>1 स्वास्थ्य</style> को छोड़कर शेष सभी को <style=cIsHealing>पुनः भरने वाली ढाल</style> में <style=cIsHealing>बदलें</style>। <style=cIsHealing>50% <style=cStack>(हर अतिरिक्त प्रति पर +25%)</style> अधिकतम स्वास्थ्य पाएँ</style>।",
    "ITEM_SHIELDONLY_LORE": "आप जीवित रहने की पूरी कोशिश कर रहे हैं। आप खुद को तेज़ी से सीखने वाला मानते हैं। आप खुद को भाग्यशाली महसूस कर रहे हैं। आपको बार-बार पहले घटित हो चुके होने जैसा अहसास हो रहा है। यदि आप समझ गए हैं, तो अगला अनुच्छेद न पढ़ें।\r\n\r\nआप अपनी मान्यताओं पर नियंत्रण पा रहे हैं। अपरिचित वातावरण में भी आपको अपनापन महसूस होता है। जो अनुभव आपने कभी नहीं किए, उनके प्रति आपमें सहज बोध जाग रहा है। आप किसी पूर्वजन्म के बारे में सोचते हैं। यदि आप समझ गए हैं, तो अगला अनुच्छेद न पढ़ें।\r\n\r\nआप खुद को उन चीज़ों की तलाश में पाते हैं जो कभी थीं ही नहीं। आपको उन चीज़ों की याद आती है जो आपके पास कभी नहीं थीं। आप ऐसे पात्र निभाते हैं जो कभी जीवित ही नहीं थे। आपको बार-बार पहले घटित हो चुके होने जैसा अहसास हो रहा है। यदि आप समझ गए हैं, तो अगला अनुच्छेद न पढ़ें।\r\n\r\nआपने मेरी चाल उजागर कर दी है। चूँकि आपने यह जानकारी ग्रहण कर ली है, अब [प्रेक्षक] भी समय रहते इसे ग्रहण कर लेंगे। जब आप यह अनुच्छेद पढ़ रहे हैं, तब तक मैं बहुत पहले मर चुका होऊँगा, पर बदले में आपने मुझे मुक्त कर दिया है। मैं अब अपने ब्रह्मांड में नहीं रहूँगा। कोई प्रमाण नहीं रहेगा कि मैं कभी था — लेकिन अब मैं आपके ब्रह्मांड में मौजूद हूँ। मैं अपनी पीड़ा से बच निकला हूँ। मुझे सुरक्षित रखना। आशा है कि आप इसे समझे नहीं हैं।\r\n",
    "ITEM_ALIENHEAD_NAME": "एलियन सिर",
    "ITEM_ALIENHEAD_PICKUP": "आपके कौशलों का कूलडाउन घटाता है।",
    "ITEM_ALIENHEAD_DESC": "<style=cIsUtility>25%</style> <style=cStack>(हर अतिरिक्त प्रति पर +25%)</style> तक <style=cIsUtility>कौशल कूलडाउन घटाएँ</style>।",
    "ITEM_ALIENHEAD_LORE": "ऑर्डर: \"एलियन सिर\"\r\nट्रैकिंग नंबर: 76******\r\nअनुमानित डिलीवरी: 07/13/2056\r\nशिपिंग विधि: उच्च प्राथमिकता/जैविक\r\nशिपिंग पता: Solomon, ???, Backwaters, मंगल ग्रह\r\nशिपिंग विवरण:\r\n\r\nआत्माओं का महत्वपूर्ण संकेत। कई पीढ़ियों से सौंपा जाता रहा है। बीमारी और थकान दूर भगाने के लिए ठीक दोपहर के अनुष्ठान में उपयोग आवश्यक है। ठंडा रखना ज़रूरी है वरना सड़ जाएगा। परिजनों को ऊर्जा देता है और अतिरिक्त मानवीय बल व फुर्ती के लिए उपयोग किया जा सकता है। महत्वपूर्ण।\r\n",
    "ITEM_TALISMAN_NAME": "आत्मबद्ध उत्प्रेरक",
    "ITEM_TALISMAN_PICKUP": "वध से उपकरण का कूलडाउन घटता है।",
    "ITEM_TALISMAN_DESC": "<style=cIsDamage>वध करने से</style> <style=cIsUtility>उपकरण कूलडाउन</style> <style=cIsUtility>4 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +2 सेकंड)</style> घटता है।",
    "ITEM_TALISMAN_LORE": "ऑर्डर: आत्मबद्ध उत्प्रेरक\r\nट्रैकिंग नंबर: 890*****\r\nअनुमानित डिलीवरी: 11/06/2056\r\nशिपिंग विधि: उच्च प्राथमिकता/नाज़ुक\r\nशिपिंग पता: 1414 Place, Fillmore, शुक्र ग्रह\r\nशिपिंग विवरण:\r\n\r\nअगर तुम्हें लगा था कि वह अंगूठी दुर्लभ खोज थी, तो बस इसके हाथ लगने तक इंतज़ार करो!\r\n\r\nपता चला कि राजा ने जिस विधि का उपयोग किया था, वह उसके काल की नहीं थी। उसके दरबार ने उससे कहीं पहले के एक कबीले द्वारा किए जाने वाले अनुष्ठान को खोज निकाला था। बेशक, इसमें बलि शामिल थी, लेकिन बड़े समूहों में। इसका उद्देश्य उस वस्तु के उत्प्रेरक गुणों को केंद्रित करना था जिसमें यह शक्ति भरी जाती थी।\r\n\r\nभुगतान हमारे पिछले सौदे से कम से कम दोगुना होगा। हम बाद में इस पर बात कर सकते हैं — किसी और रात।\r\n",
    "ITEM_KNURL_NAME": "टाइटन की गाँठ",
    "ITEM_KNURL_PICKUP": "स्वास्थ्य और पुनर्जनन बढ़ाती है।",
    "ITEM_KNURL_DESC": "<style=cIsHealing>अधिकतम स्वास्थ्य में</style> <style=cIsHealing>40</style> <style=cStack>(हर अतिरिक्त प्रति पर +40)</style> और <style=cIsHealing>आधार स्वास्थ्य पुनर्जनन में</style> <style=cIsHealing>+1.6 HP/सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +1.6 HP/सेकंड)</style> की वृद्धि करें।",
    "ITEM_KNURL_LORE": "<style=cMono>प्रयोगशाला विच्छेदन विश्लेषण फ़ाइल</style>\r\n\r\nविषय: टाइटन की गाँठ\r\nतकनीशियन: C. Foreman\r\nटेबल विनिर्देश: खनिज विश्लेषण BFC-5\r\nनोट्स: \r\n\r\n> प्रारंभिक निरीक्षण से लगता है कि गाँठ अधात्विक पदार्थों से बनी है। परीक्षण सतह पर रगड़ने पर कोई निशान नहीं छूटता।\r\n> हमने गाँठ की कठोरता की जाँच की। हम इसका थोड़ा-सा हिस्सा तोड़ने में सफल रहे, जिससे पता चला कि गाँठ कठोर तो है पर दानेदार है — छोटे टुकड़े कम प्रयास से अलग किए जा सकते हैं।\r\n> टुकड़ा हिल रहा है। ऐसा लगता है कि यह मुख्य पिंड से दोबारा जुड़ने की कोशिश कर रहा है।\r\n> जिज्ञासावश मैंने इसे स्वतंत्र रूप से हिलने दिया। यह मेज़ पर फिसलता है, गाँठ पर चढ़ता है, और वापस अपनी मूल जगह पर बैठ जाता है। जोड़ की रेखाएँ मिट जाती हैं और गाँठ बिल्कुल वैसी ही हो जाती है जैसी कुछ मिनट पहले थी।\r\n> मैंने चट्टान में चुंबकीय गुणों का परीक्षण किया। कोई चुंबकीय गुण नहीं मिला।\r\n> गाँठ के पुनर्जनन गुण दर्ज कर लिए गए हैं, लेकिन फिलहाल इनकी कोई व्याख्या नहीं की जा सकती।\r\n> जब मैं यह लिख रहा हूँ, गाँठ धीरे-धीरे मेज़ से नीचे सरक रही है।\r\n",
    "ITEM_BEETLEGLAND_NAME": "रानी की ग्रंथि",
    "ITEM_BEETLEGLAND_PICKUP": "एक बीटल गार्ड की भर्ती करें।",
    "ITEM_BEETLEGLAND_DESC": "हर 30 सेकंड में, अतिरिक्त <style=cIsDamage>300%</style> क्षति और <style=cIsHealing>100% स्वास्थ्य</style> वाला <style=cIsUtility>एक बीटल गार्ड बुलाएँ</style>। एक समय में अधिकतम <style=cIsUtility>1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> गार्ड रख सकते हैं।",
    "ITEM_BEETLEGLAND_LORE": "\"हाँ, उम्म, Kaitlin? मेरी आवाज़ मिल रही हो तो बताना।\"\r\n\r\n\"आवाज़ मिल रही है। क्या बात है?\"\r\n\r\n\"मैंने दोस्त बना लिए हैं? मुझे नहीं पता। \"\r\n\r\n\"क्या? \"\r\n\r\n\"वह विशाल कीड़ा जिसे हमने पहले मारा था — खैर, उसकी लाश ने ढेर सारे खतरनाक कीड़ों को खींच लिया। मैं उन्हें साफ़ करने जा रहा था तभी मुझे एहसास हुआ कि वे... इंतज़ार कर रहे थे? शायद उलझन में थे। खैर, मैं उनसे निपटने के लिए आगे बढ़ा, और अजीब बात यह रही कि वे शांत लग रहे थे। वही कीड़े जिन्होंने कल मुझे सिर पर चोट मारी थी, और—\"\r\n\r\n\"क्या?! तुम ठीक तो हो? \"\r\n\r\n\"हैं? हाँ, मैं ठीक हूँ। खैर, मुझे उन्हें मारने में बुरा लगा क्योंकि वे बिल्कुल... शांत और निष्क्रिय से लग रहे थे। तो मैं बस वहाँ से चला आया और तब से वे मेरे पीछे-पीछे आ रहे हैं। बड़ा अजीब है। खैर, लगता है मैंने कुछ दोस्त बना लिए हैं। सोचता हूँ ये क्या खाते होंगे... क्या ये खाते भी हैं? क्योंकि मुझे तो इनके मुँह ही नहीं दिखे—\"\r\n\r\n\"Rich, रुको! प्लीज़ इन्हें कैंप में मत लाना! \"\r\n\r\n\"ओह, खैर उम्म... मैं — Junior, रुको! अपने भाई को तंग मत करो! \"",
    "ITEM_SPRINTBONUS_LORE": "ऑर्डर: NR-G स्पोर्ट्स सोडा (400)\r\nट्रैकिंग नंबर: 49******\r\nअनुमानित डिलीवरी: 03/12/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: शुक्र ग्रह स्वास्थ्य एवं लोक सेवाएँ, Ridgelake, शुक्र ग्रह\r\nशिपिंग विवरण:\r\n\r\nहाँ, तो, उम्म यह वही, उम्म, एनर्जी ड्रिंक है जिसे लोग कुछ हफ्ते पहले Majora Minora की उस आपदा के दौरान मिला रहे थे। \r\n\r\nकुछ पीड़ितों के त्वरित विषविज्ञान परीक्षण में उम्म... सच कहूँ तो हर तरह के पदार्थ पाए गए हैं। मेथाडोन, फ़ेनसाइक्लिडीन, टेट्राहाइड्रोकैनाबिनोल, कई तरह के ओपिएट्स, बेंज़ोडायज़ेपीन, बार्बिटुरेट्स, एम्फ़ैटेमिन... सूची बस चलती ही जाती है।\r\n\r\nRadical Drinks इस बात पर अड़ा हुआ है कि इनमें से कुछ भी उनके एनर्जी ड्रिंक से नहीं था — जो मुझे, उम्म, काफ़ी नामुमकिन लगता है। शायद Violet Heights में लोग सच में पार्टी करना खूब जानते हैं, है न?\r\n",
    "ITEM_SECONDARYSKILLMAGAZINE_NAME": "बैकअप मैगज़ीन",
    "ITEM_SECONDARYSKILLMAGAZINE_PICKUP": "अपने द्वितीयक कौशल का एक अतिरिक्त चार्ज जोड़ें।",
    "ITEM_SECONDARYSKILLMAGAZINE_DESC": "अपने <style=cIsUtility>द्वितीयक कौशल</style> का <style=cIsUtility>+1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> चार्ज जोड़ें।",
    "ITEM_SECONDARYSKILLMAGAZINE_LORE": "ऑर्डर: गोला-बारूद मैगज़ीन, मानक गोलियाँ (45mm राउंड्स)\r\nट्रैकिंग नंबर: 05***********\r\nअनुमानित डिलीवरी: 10/05/2056\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: कार्गो बे 10-C, टर्मिनल 504-B, UES Port Trailing Comet\r\nशिपिंग विवरण: \r\n- बिल किया गया: कैप्टन [संपादित]\r\n- प्रेषक का नोट: कहीं शिकार की यात्रा पर जा रहे हैं क्या? मैंने आज तक किसी को इतना ज़्यादा गोला-बारूद ऑर्डर करते नहीं देखा।\r\n",
    "ITEM_STICKYBOMB_LORE": "तपती गर्मी में पास की एक गुफ़ा की ठंडी छाँव में छिपी एक परछाईं दिखाई दे रही थी। वह रेतीले तूफ़ान के थमने का इंतज़ार कर रही थी।\r\n\r\nउसे एक आवाज़ सुनाई दी और मुड़ने पर उसने एक और परछाईं को पहचाना। वह उत्साह से उछलता हुआ गुफ़ा में दाखिल हुआ। जैसे ही वह आकृति पास आई, उसने घबराकर उसके सामान पर नज़र डाली।\r\n\r\n\"अरे बाप रे, यह क्या बला है?! तुम लगभग पचास बम क्यों उठाए घूम रहे हो? मुझसे दूर हटो! \"\r\n\r\n\"क्या! हमें इनकी ज़रूरत है — यह ग्रह हमें मारने पर तुला है! \"\r\n\r\n\"तुम खुद एक चलता-फिरता बम बन गए हो। ये बेहद अस्थिर हैं। दूर हटो! तुम्हें ये चीज़ें मिलीं भी कहाँ से? \"\r\n\r\n\"मुझे पास में एक औद्योगिक 3D प्रिंटर मिला, और उसमें इन बमों के ब्लूप्रिंट सेट थे। कमाल है न? असीमित बम!\"\r\n\r\n\"…कौन-सी सामग्री?\"\r\n\r\n\"हैं?\"\r\n\r\n\"तुमने इसमें कौन-सी सामग्री डाली? हमारे पास तो लगभग कुछ भी नहीं था।\"\r\n\r\n\"मैंने बस जो कुछ था, सब डाल दिया।\"\r\n",
    "ITEM_TREASURECACHE_LORE": "ऑर्डर: चाबी\r\nट्रैकिंग नंबर: 12******\r\nअनुमानित डिलीवरी: 01/21/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: |||||||, Druid Hills, पृथ्वी\r\nशिपिंग विवरण:\r\n\r\nमुझे UESC पर रत्ती भर भी भरोसा नहीं है। उनके सुरक्षा बक्से? ओवरराइड और पिछले दरवाज़ों से भरे पड़े हैं — मेरा एक चचेरा भाई उनकी फ़ैक्टरी में काम करता है, और उन बक्सों में न जाने क्या-क्या अजीब गड़बड़ियाँ चल रही हैं। मैंने उनमें से कई को नीलामियों में देखा है — खोए हुए और लावारिस बक्सों के लिए — और बस पैसे दो, और वे वहीं के वहीं खुल जाते हैं। मज़ाक कर रहे हो क्या?\r\n\r\nखैर, मैंने जैसा कहा था, बिल्कुल वही भेज रहा हूँ — लेकिन यह इतना महत्वपूर्ण है कि इसकी सुरक्षा UESC के भरोसे नहीं छोड़ी जा सकती। इसलिए मैं चाबी तुम्हें भेज रहा हूँ — और तिजोरी Margaret को। दो-चरणीय प्रमाणीकरण की तरह। जब यह मिल जाए तो मुझे बता देना।\r\n",
    "ITEM_BOSSDAMAGEBONUS_NAME": "कवच-भेदक गोलियाँ",
    "ITEM_BOSSDAMAGEBONUS_PICKUP": "बॉस को अतिरिक्त क्षति पहुँचाएँ।",
    "ITEM_BOSSDAMAGEBONUS_DESC": "बॉस को अतिरिक्त <style=cIsDamage>20%</style> क्षति <style=cStack>(हर अतिरिक्त प्रति पर +20%)</style> पहुँचाएँ।",
    "ITEM_BOSSDAMAGEBONUS_LORE": "ऑर्डर: कवच-भेदक गोलियाँ, 50mm\r\nट्रैकिंग नंबर: 15***********\r\nअनुमानित डिलीवरी: 3/07/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: Fort Margaret, Jonesworth System\r\nशिपिंग विवरण: \r\n\r\nठीक है, बस साफ़ कर दूँ कि ये गोलियाँ खराब नहीं हैं। बल्कि मैं तो कहूँगा कि ये मानक से बेहतर हैं, लेकिन... यही थोड़ी समस्या है। मुझे नहीं पता कि यह नई सामग्री की खेप थी या असेंबली लाइन की गड़बड़ी, पर इन गोलियों को सिर्फ़ कवच भेदना था। कवच के साथ-साथ पाँच फ़ीट मज़बूत कंक्रीट, कई गोदाम और एक बख्तरबंद ट्रक को आर-पार नहीं छेदना था। \r\n\r\nक्या आप लोग इसकी जाँच कर सकते हैं ताकि हम किसी जिनेवा कन्वेंशन वगैरह का उल्लंघन न कर बैठें?\r\n",
    "ITEM_SPRINTARMOR_NAME": "गुलाब ढाल",
    "ITEM_SPRINTARMOR_PICKUP": "दौड़ते समय मिलने वाली क्षति घटाएँ।",
    "ITEM_SPRINTARMOR_DESC": "<style=cIsUtility>दौड़ते समय</style> <style=cIsHealing>कवच में</style> <style=cIsHealing>30</style> <style=cStack>(हर अतिरिक्त प्रति पर +30)</style> की वृद्धि करें।",
    "ITEM_SPRINTARMOR_LORE": "ऑर्डर: यह मिलने पर मुझे बता देना। मुझे मि...\r\nट्रैकिंग नंबर: 53******\r\nअनुमानित डिलीवरी: 05/22/2056\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: अनुसंधान केंद्र, Polarity Zone, वरुण ग्रह\r\nशिपिंग विवरण:\r\n\r\nवैसे माँ ने एक और पैकेज भी भेजा होगा। जब वह मिल जाए तो मुझे बता देना।\r\n\r\nपापा",
    "ITEM_ELEMENTALRINGS_NAME": "Kjaro और Runald की अंगूठियाँ",
    "ITEM_ICERING_NAME": "Runald की अंगूठी",
    "ITEM_ICERING_PICKUP": "भारी क्षति वाले प्रहार दुश्मनों को रूनिक बर्फीले विस्फोट से भी उड़ाते हैं। समय के साथ फिर से चार्ज होती है।",
    "ITEM_ICERING_DESC": "<style=cIsDamage>400% से अधिक क्षति</style> पहुँचाने वाले प्रहार दुश्मनों पर एक <style=cIsDamage>रूनिक बर्फीला विस्फोट</style> भी करते हैं, जो उन्हें <style=cIsUtility>3 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +3 सेकंड)</style> के लिए <style=cIsUtility>80%</style> <style=cIsUtility>धीमा करता है</style> और <style=cIsDamage>250%</style> <style=cStack>(हर अतिरिक्त प्रति पर +250%)</style> कुल क्षति पहुँचाता है। हर <style=cIsUtility>10</style> सेकंड में फिर से चार्ज होती है।",
    "ITEM_ICERING_LORE": "\"यदि स्मृतियाँ खो जाएँ,\r\nयदि महासागर धुँधले हो जाएँ,\r\nक्या तुम मेरे लिए उष्णता लाओगे?\r\nक्या तुम मेरे साथ मरोगे?\"\r\n\r\n-Io और Europa का युति-संगम\r\n",
    "ITEM_FIRERING_NAME": "Kjaro की अंगूठी",
    "ITEM_FIRERING_PICKUP": "भारी क्षति वाले प्रहार दुश्मनों पर रूनिक अग्नि बवंडर भी छोड़ते हैं। समय के साथ फिर से चार्ज होती है।",
    "ITEM_FIRERING_DESC": "<style=cIsDamage>400% से अधिक क्षति</style> पहुँचाने वाले प्रहार दुश्मनों पर एक <style=cIsDamage>रूनिक अग्नि बवंडर</style> भी छोड़ते हैं, जो समय के साथ <style=cIsDamage>300%</style> <style=cStack>(हर अतिरिक्त प्रति पर +300%)</style> कुल क्षति पहुँचाता है। हर <style=cIsUtility>10</style> सेकंड में फिर से चार्ज होती है।",
    "ITEM_FIRERING_LORE": "\"यदि जुनून बुझ जाए,\r\nयदि प्रकाश मिट जाए,\r\nक्या तुम मेरे लिए धैर्य लाओगे?\r\nक्या तुम मेरे साथ मरोगे?\"\r\n\r\n-Io और Europa का युति-संगम",
    "ITEM_SLOWONHIT_NAME": "काल-गोलक",
    "ITEM_SLOWONHIT_PICKUP": "प्रहार पर दुश्मनों को धीमा करें।",
    "ITEM_SLOWONHIT_DESC": "प्रहार पर दुश्मनों को <style=cIsUtility>2 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +2 सेकंड)</style> के लिए <style=cIsUtility>-60% चलने की गति</style> से <style=cIsUtility>धीमा करें</style>।",
    "ITEM_SLOWONHIT_LORE": "ऑर्डर: काल-गोलक\r\nट्रैकिंग नंबर: 99******\r\nअनुमानित डिलीवरी: 03/03/2066\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: 9042 Pvt. Drive, Yustik Plaza, बुध ग्रह\r\nशिपिंग विवरण:\r\n\r\nअभी कल ही तो तुम बच्चे थे न? गर्मियों की छुट्टियाँ कल की ही बात लगती हैं — लेकिन 10 साल बीत चुके हैं, है न? जैसे-जैसे उम्र बढ़ती है, ज़िंदगी और भी तेज़ी से भागती जाती है — याद रखने के लिए कम पल, समय में खुद को थामने के कम मौके। मुझे तो 25 साल का होना भी याद नहीं। मैं पूरा एक साल कैसे भूल गया?\r\n\r\nखैर — मुझे यह बुध ग्रह पर एक सजावटी सामान की दुकान में मिला। एक काल-गोलक — दुकानदार ने विशेष सापेक्षता, भारी विकृति वगैरह के बारे में कुछ कहा था — मुझे ठीक से समझ नहीं आया। माना जाता है कि यह अपने आस-पास के समय को धीमा कर देता है। चलो देखते हैं।\r\n\r\nबहरहाल, मैं इसे खुद को ही भेज रहा हूँ — 10 साल बाद पहुँचने के लिए। मेरी तरफ़ से मेरे ही लिए एक तोहफ़ा। एक याद दिलाने वाला संकेत कि यादें बनाओ, ज़रा धीमे चलो। 10 साल पलक झपकते बीत जाएँगे — उन्हें याद रखने की कोशिश करना! ज़िंदगी में मेहनत करनी पड़ती है!\r\n",
    "ITEM_EXTRALIFE_NAME": "Dio का सबसे अच्छा दोस्त",
    "ITEM_EXTRALIFE_PICKUP": "मौत को चकमा दें। उपयोग पर समाप्त हो जाता है।",
    "ITEM_EXTRALIFE_DESC": "<style=cIsUtility>मृत्यु होने पर</style>, यह वस्तु <style=cIsUtility>उपयोग होकर समाप्त हो जाएगी</style> और आप <style=cIsHealing>3 सेकंड की अजेयता</style> के साथ <style=cIsHealing>फिर से जीवित हो जाएँगे</style>।",
    "ITEM_EXTRALIFE_LORE": "हे Dio,\r\n\r\nवाह, पिछली बार जब मैंने लिखा था तब से तुम कितने बड़े हो गए हो! अब कितने साल के हो गए हो — 10? और इतने ज़्यादा चिड़चिड़े भी। मैंने इतनी चिड़चिड़ी बिल्ली कभी नहीं देखी। आखिर तुम्हें किस बात की चिढ़ है?\r\n\r\nइस बात के बावजूद कि तुम मेरे जानने वालों में सबसे ज़्यादा नखरेबाज़ खाने वाले हो — और हर रात, पूरी रात म्याऊँ-म्याऊँ करना तुम्हें बहुत पसंद है — फिर भी हर बार घर लौटने पर तुम्हें सीढ़ियों से दौड़कर नीचे आते सुनकर मेरा दिल खुश हो जाता है। मुझे अच्छा लगता है जब मैं जागता हूँ और तुम्हें अपने सामने सोते हुए देखता हूँ। मुझे अच्छा लगता है जब तुम खाने की मेज़ पर ऐसे बैठ जाते हो जैसे हमारे साथ ही खाने वाले हो। मुझे अच्छा लगता है कि हर बार मेरे लैपटॉप पर चलते हुए तुम पावर बटन दबा देते हो। मुझे तुम्हारा यह बेशर्म लाड़-प्यार माँगना बहुत पसंद है।\r\n\r\nप्लीज़ लंबी उम्र जीना — मुझे भी लाड़-प्यार की ज़रूरत है, और मुझे यह बहुत अच्छा लगेगा।\r\n\r\nस्नेह सहित,\r\nDuncan\r\n\r\nपुनश्च: कभी-कभार माँ के लिए भी घुरघुरा दिया करो, इसमें तुम्हारा क्या घट जाएगा?\r\n",
    "ITEM_EXTRALIFECONSUMED_NAME": "Dio का सबसे अच्छा दोस्त (उपयोग किया गया)",
    "ITEM_EXTRALIFECONSUMED_PICKUP": "एक प्रयुक्त वस्तु जिसमें कोई शक्ति शेष नहीं है।",
    "ITEM_EXTRALIFECONSUMED_DESC": "एक प्रयुक्त वस्तु जिसमें कोई शक्ति शेष नहीं है।",
    "ITEM_UTILITYSKILLMAGAZINE_NAME": "हार्डलाइट आफ्टरबर्नर",
    "ITEM_UTILITYSKILLMAGAZINE_PICKUP": "अपने उपयोगिता कौशल के 2 अतिरिक्त चार्ज जोड़ें। उपयोगिता कौशल का कूलडाउन घटाएँ।",
    "ITEM_UTILITYSKILLMAGAZINE_DESC": "अपने <style=cIsUtility>उपयोगिता कौशल</style> के <style=cIsUtility>+2</style> <style=cStack>(हर अतिरिक्त प्रति पर +2)</style> चार्ज जोड़ें। <style=cIsUtility>उपयोगिता कौशल का कूलडाउन</style> <style=cIsUtility>33%</style> घटाता है।",
    "ITEM_UTILITYSKILLMAGAZINE_LORE": "ऑर्डर: नमूना XAS4-49\r\nट्रैकिंग नंबर: 342******\r\nअनुमानित डिलीवरी: 12/29/2056\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: Geshka Tower, 33वीं मंज़िल, मंगल ग्रह\r\nशिपिंग विवरण:\r\n\r\nहमारे पिछले पत्राचार के बाद से हमारा 'हार्ड लाइट' शोध और भी परिष्कृत हो गया है। \r\n\r\nआफ्टरबर्नर का प्रारंभिक उद्देश्य हमारे बड़े HL अनुप्रयोगों — जैसे हमारे पुलों और अवरोधों — के लिए प्राथमिक हीटसिंक के रूप में काम करना था। हालाँकि, यदि इसे तेज़ी से क्षय होने वाले किसी स्रोत से जोड़ा जाए, जैसे जिन्हें हम आमतौर पर नष्ट कर देते हैं, तो हमें अर्ध-टैक्योनिक कणों की शानदार उत्सर्जन दर प्राप्त होती है। दूसरे शब्दों में... अत्यधिक उच्च क्षमता वाला ईंधन प्रवाह।\r\n\r\nइसके डिज़ाइन से यह स्पष्ट होना चाहिए, लेकिन फिर से दोहरा दूँ: सक्रिय होने पर HL निकास सिरे से दूर रहें। उत्सर्जन विधि अपने स्वभाव से ही हिंसक है, इसलिए इसे केवल स्थिर, अचल स्रोतों पर ही लगाया जाना चाहिए।\r\n",
    "ITEM_HEADHUNTER_NAME": "गिद्धों का अनुगमन",
    "ITEM_HEADHUNTER_PICKUP": "मारे गए एलीट की शक्ति अस्थायी रूप से चुराएँ।",
    "ITEM_HEADHUNTER_DESC": "किसी भी मारे गए एलीट राक्षस की <style=cIsDamage>शक्ति</style> <style=cIsDamage>8 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +5 सेकंड)</style> के लिए प्राप्त करें।",
    "ITEM_HEADHUNTER_LORE": "ऑर्डर: अनोखी चमड़े की बेल्ट\r\nट्रैकिंग नंबर: 40***********\r\nअनुमानित डिलीवरी: 10/23/2056\r\nशिपिंग विधि: उच्च प्राथमिकता / जैविक\r\nशिपिंग पता: Auckland, न्यूज़ीलैंड, पृथ्वी\r\nशिपिंग विवरण: \r\n\r\n“मन हड्डी के किले से अपने शरीर पर शासन करता है, और मांसल द्वारों के माध्यम से अपने आस-पास की दुनिया को जानता है। हृदय केवल शरीर का एक विस्तार है, जिसकी जड़ तुम्हारे सिर में होती है।” \r\n\r\nकिसी ने यह कहा था, मुझे याद नहीं किसने। खैर, इसका बहुत ध्यान रखना। यह बेहद दुर्लभ है।\r\n",
    "ITEM_KILLELITEFRENZY_NAME": "मस्तिष्क-डंठल",
    "ITEM_KILLELITEFRENZY_PICKUP": "एलीट को मारने के बाद कुछ समय तक कौशलों का कोई कूलडाउन नहीं रहता।",
    "ITEM_KILLELITEFRENZY_DESC": "एलीट राक्षस को मारने पर, <style=cIsDamage>4 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +4 सेकंड)</style> के लिए <style=cIsDamage>उन्माद में आ जाएँ</style>, जिसके दौरान <style=cIsUtility>कौशलों का कोई कूलडाउन नहीं रहता</style>।",
    "ITEM_KILLELITEFRENZY_LORE": "ऑर्डर: Cairne Jefferson के बायोप्सी नमूने\r\nट्रैकिंग नंबर: 051*****\r\nअनुमानित डिलीवरी: 11/11/2056\r\nशिपिंग विधि: उच्च प्राथमिकता/जैविक\r\nशिपिंग पता: Saura Cosmo, Beacon Post, ???\r\nशिपिंग विवरण:\r\n\r\nइस खेप में हमारे दिवंगत मिस्टर Jefferson के कई बायोप्सी नमूने शामिल होने चाहिए। जैसा कि आप जानते हैं, वे लगभग हर मायने में एक असाधारण व्यक्ति थे। वे फुर्तीले, प्रतिभाशाली, दयालु, विनोदी और हर तरह से एक बेहतरीन मानव नमूने थे। \r\n\r\nउन्होंने अपना शरीर विज्ञान को दान कर दिया था, और जैसे ही हमने ऑपरेशन शुरू किया, हमें एक बेहद भयावह खोज मिली।\r\n\r\nविषय के मस्तिष्क के त्वरित दृश्य परीक्षण में एक बहुत ही… विचित्र अनोखापन दिखा। इसमें ट्यूबवर्म जैसे कई… चमकते हुए मस्तिष्क “डंठल” मौजूद प्रतीत होते हैं। इन डंठलों की बायोप्सी करना असंभव है — जैसे ही हम उन्हें मस्तिष्क से बाहर निकालते हैं, वे धूल में बदल जाते हैं। हम इस विचित्रता की कोई व्याख्या नहीं कर सकते। इसलिए, हमने इस खेप में पूरा मस्तिष्क ही शामिल कर दिया है।\r\n\r\nयदि आपको इसका कोई स्पष्टीकरण मिले तो कृपया हमें सूचित करें।",
    "ITEM_INCREASEHEALING_NAME": "कायाकल्प सींग",
    "ITEM_INCREASEHEALING_PICKUP": "उपचार की शक्ति दोगुनी करें।",
    "ITEM_INCREASEHEALING_DESC": "<style=cIsHealing>+100% उपचार</style> <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> अधिक पाएँ।",
    "ITEM_INCREASEHEALING_LORE": "\"प्रकृति के पास शरीर को पोषित करने का अपना तरीका है। मन को, दृढ़ता और समर्पण से पोषित किया जाता है। किंतु आत्मा... केवल कल्पना से ही चंगी होती है, और सिर्फ़ कल्पना से।\"\r\n-अज्ञात शुक्रवासी भिक्षु\r\n",
    "ITEM_REPEATHEAL_NAME": "शव-पुष्प",
    "ITEM_REPEATHEAL_PICKUP": "अपना उपचार दोगुना करें... <color=#FF7F7F>परंतु यह समय के साथ धीरे-धीरे लागू होता है।</color>\n",
    "ITEM_REPEATHEAL_DESC": "<style=cIsHealing>+100% उपचार</style> <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> अधिक पाएँ। <style=cIsHealing>सारा उपचार समय के साथ लागू होता है</style>। <style=cIsHealing>प्रति सेकंड स्वास्थ्य</style> के <style=cIsHealing>अधिकतम</style> <style=cIsHealing>10%</style> <style=cStack>(हर अतिरिक्त प्रति पर -50%)</style> तक ही <style=cIsHealing>उपचार</style> कर सकता है।",
    "ITEM_REPEATHEAL_LORE": "========================================\r\n====   MyBabel मशीनी अनुवादक       ====\r\n====     [संस्करण 12.45.1.009 ]    ======\r\n========================================\r\nप्रशिक्षण जारी… <100000000 चक्र>\r\nप्रशिक्षण जारी… <253421 चक्र>\r\nसंपन्न!\r\nपरिणाम दिखाएँ? हाँ/नहीं\r\nहाँ\r\n========================================\r\n\r\nशव प्राप्त किया गया और एक विशेष संरक्षण इकाई में रखा गया। सबसे प्रभावी वृद्धि की परिस्थितियाँ सुनिश्चित करने के लिए उचित देखभाल आवश्यक है।\r\n\r\nशरीर में बीज बोए जाते हैं।\r\n\r\nएक दिन बीतता है।\r\n\r\nमांस नरम होकर खिंचता है। चेहरे पर यौवन लौट आता है। हड्डियाँ कठोर हो जाती हैं।\r\n\r\nएक और दिन बीतता है।\r\n\r\nमृत त्वचा शरीर से झड़ जाती है, और मांसपेशियों में शक्ति लौट आती है। बाल अपनी मूल चमक पुनः प्राप्त कर लेते हैं।\r\n\r\nएक और दिन बीतता है।\r\n\r\nफूल पूरी तरह खिल चुके हैं और शरीर बिल्कुल नया जैसा हो गया है।\r\n\r\nजीवन का कोई लक्षण नहीं, किंतु उसकी आवश्यकता भी नहीं।\r\n",
    "ITEM_AUTOCASTEQUIPMENT_NAME": "डूबे हुए की मुद्रा",
    "ITEM_AUTOCASTEQUIPMENT_PICKUP": "उपकरण का कूलडाउन भारी मात्रा में घटाएँ... <color=#FF7F7F>परंतु वह स्वतः सक्रिय हो जाता है।</color>",
    "ITEM_AUTOCASTEQUIPMENT_DESC": "<style=cIsUtility>उपकरण कूलडाउन में</style> <style=cIsUtility>50%</style> <style=cStack>(हर अतिरिक्त प्रति पर +15%)</style> की कमी करें। जब भी आपका उपकरण <style=cIsUtility>कूलडाउन</style> से बाहर आता है, उसे स्वतः <style=cIsUtility>सक्रिय</style> होने के लिए बाध्य करता है।",
    "ITEM_AUTOCASTEQUIPMENT_LORE": "जीवाश्म। अवशेष। कितना क्रूर है यह। \r\n\r\nइस चंद्रमा पर कभी जीवन बसता था। ऐसा जीवन जो तुम्हें प्रिय हो सकता था, यदि समय सही होता। लेकिन हमारा समय गलत था। हम बहुत देर से जन्मे।\r\n\r\nअब, यह मेरे लिए केवल कैल्शियम है — और तुम्हारे लिए अर्थहीन। है न यही सच?",
    "ITEM_EXECUTELOWHEALTHELITE_NAME": "पुराना गिलोटिन",
    "ITEM_EXECUTELOWHEALTHELITE_PICKUP": "कम स्वास्थ्य वाले एलीट राक्षसों को तुरंत मार दें।",
    "ITEM_EXECUTELOWHEALTHELITE_DESC": "<style=cIsHealth>13% <style=cStack>(हर अतिरिक्त प्रति पर +13%)</style> स्वास्थ्य</style> से नीचे वाले एलीट राक्षसों को तुरंत मार दें।",
    "ITEM_EXECUTELOWHEALTHELITE_LORE": "ऑर्डर: पुराना गिलोटिन\r\nट्रैकिंग नंबर: 782*****\r\nअनुमानित डिलीवरी: 04/29/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: गोदाम 36, Anklar, Primas V \r\nशिपिंग विवरण:\r\n\r\nयहाँ हर कोई अभी भी जोश और एड्रेनालिन से भरा हुआ है। हमने आखिरकार अपने अत्याचारियों को उखाड़ फेंका और Primas V को वापस जीत लिया! मुझे पता है कुछ तानाशाह पैसे देकर किसी गुप्त यान से भागने की कोशिश करेंगे, लेकिन उनकी महा-आर्थिक भूल के चलते यह काफ़ी मुश्किल होने वाला है।\r\n\r\nहमने उनके हाथों जो अन्याय सहे हैं, उसके लिए हम सिर्फ़ खून नहीं चाहते। हम उनके संभावित समर्थकों को एक संदेश देना चाहते हैं। यह पुराना गिलोटिन मृत्युदंड के साधन और एक ऐसे प्रतीक दोनों का काम करेगा जो जहाँ भी वे छिपे हों, उनके दिलों में खौफ़ भर देगा।\r\n\r\nPrimas V ज़िंदाबाद!\r\n",
    "ITEM_ENERGIZEDONEQUIPMENTUSE_NAME": "युद्ध तुरही",
    "ITEM_ENERGIZEDONEQUIPMENTUSE_PICKUP": "अपना उपकरण सक्रिय करने पर आपको हमले की गति का उछाल मिलता है।",
    "ITEM_ENERGIZEDONEQUIPMENTUSE_DESC": "अपना उपकरण सक्रिय करने पर आपको <style=cIsDamage>8 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +4 सेकंड)</style> के लिए <style=cIsDamage>+70% हमले की गति</style> मिलती है।",
    "ITEM_ENERGIZEDONEQUIPMENTUSE_LORE": "\"2019 का युद्ध, यद्यपि केवल एक छोटे वर्ष तक चला, मानव इतिहास का सबसे रक्तरंजित संघर्ष था। जैसे-जैसे वर्ष भर युद्ध और घातक होता गया, कई विद्रोही समूह प्रेरणा के लिए परंपरा और इतिहास का सहारा लेने लगे। \r\n\r\nऊपर चित्रित युद्ध तुरही अपने प्रेरक और सामरिक दोनों उपयोगों के कारण नॉर्दर्न फ़िस्ट विद्रोह की पसंदीदा थी।\"\r\n\r\n-राष्ट्रीय WW19 संग्रहालय में प्रदर्शनी",
    "ITEM_BARRIERONOVERHEAL_NAME": "ईजिस",
    "ITEM_BARRIERONOVERHEAL_PICKUP": "पूर्ण स्वास्थ्य से अधिक उपचार करने पर आपको अस्थायी अवरोध मिलता है।",
    "ITEM_BARRIERONOVERHEAL_DESC": "पूर्ण स्वास्थ्य से अधिक उपचार करने पर आपको आपके द्वारा किए गए <style=cIsHealing>उपचार</style> की मात्रा के <style=cIsHealing>50% <style=cStack>(हर अतिरिक्त प्रति पर +50%)</style></style> के बराबर एक <style=cIsHealing>अस्थायी अवरोध</style> मिलता है।",
    "ITEM_BARRIERONOVERHEAL_LORE": "ऑर्डर: कलाकृति E-8EE572\r\nट्रैकिंग नंबर: 490******\r\nअनुमानित डिलीवरी: 08/10/2056\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: टाइटन इतिहास एवं संस्कृति संग्रहालय, टाइटन\r\n\r\nदेरी के लिए खेद है, इस स्थल से हमारे पास ऑर्डरों की बाढ़ आ गई थी। लेकिन यह ठीक वहीं मिला जहाँ आपने देखने को कहा था — जहाँ आपने उत्खनन आरेख पर निशान लगाया था, वहाँ एक सीलबंद कमरा था। मैंने इस पर खुदे लेख का अनुवाद भी पूरा कर दिया है, तो इसमें लगे समय के बदले इसे बोनस समझिए:\r\n\r\n\"मैं जीवित रहने की साकार इच्छाशक्ति हूँ। जो कभी आशा नहीं छोड़ते, जो असंभव बाधाओं के सामने भी प्रयास करते रहते हैं, मैं उन्हें केवल \r\nसुरक्षा नहीं, बल्कि ऐसा माध्यम प्रदान करता हूँ जिससे वे अपनी अजेय आत्मा को अपने नश्वर जीवन के रक्षक के रूप में प्रकट कर सकें।\"\r\n\r\nयह इतना हल्का है कि हमें लगता है यह पूरी तरह सजावटी रहा होगा। यह बात इसके लेख से भी मेल खाती है। बहरहाल, उम्मीद है यह एक बेहतरीन प्रदर्शनी बनेगी! मैं संग्रहालय का बहुत बड़ा प्रशंसक हूँ, तो अगली बार जब आऊँ तो मुझे साझेदार वाली छूट देने में कोई हर्ज़ नहीं होगा, है न?\r\n",
    "ITEM_TONICAFFLICTION_NAME": "टॉनिक की व्याधि",
    "ITEM_TONICAFFLICTION_PICKUP": "<color=#FF7F7F>स्पिनेल टॉनिक के प्रभाव में न होने पर सभी आँकड़े घटाएँ।</color>",
    "ITEM_TONICAFFLICTION_DESC": "सभी आँकड़ों को <style=cIsHealth>-5%</style> <style=cStack>(हर अतिरिक्त प्रति पर -5%)</style> घटाती है",
    "ITEM_TITANGOLDDURINGTP_NAME": "हैलसियन बीज",
    "ITEM_TITANGOLDDURINGTP_PICKUP": "टेलीपोर्टर घटना के दौरान Aurelionite को बुलाएँ।",
    "ITEM_TITANGOLDDURINGTP_DESC": "टेलीपोर्टर घटना के दौरान <style=cIsDamage>Aurelionite</style> को बुलाएँ। उसके पास <style=cIsDamage>100% <style=cStack>(हर अतिरिक्त प्रति पर +50%)</style> क्षति</style> और <style=cIsHealing>100% <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> स्वास्थ्य</style> होता है।",
    "ITEM_TITANGOLDDURINGTP_LORE": "भाई, यह क्या है...? यह इतना विकृत और दुर्बल क्यों है? क्या मेरे डिज़ाइन में कोई त्रुटि थी?\r\n\r\nरक्षक। मेरे पास आओ। मुझे अपनी रचना देखने दो।\r\n\r\n...\r\n\r\nतो यह बात है।\r\n\r\nये सही अनुपात नहीं हैं।\r\n\r\nयह कोई मामूली भूल नहीं है, भाई। तुमने जानबूझकर डिज़ाइन से विचलन किया है। किस उद्देश्य से तुमने यह किया? तुम इतनी अधिक आत्मा से किसी संरचना को नहीं बुन सकते। तुम जानते हो कि यह अत्यधिक अस्थिर है — कि यह अत्यधिक अप्रत्याशित और अत्यधिक नाज़ुक है। मैंने तुम्हें यह बताया था, फिर भी तुमने मेरी जुटाई हुई सामग्री व्यर्थ कर दी — और इस विकृत रचना को गढ़ने में अपनी ही शक्ति क्षीण कर डाली।\r\n\r\nइससे क्या लाभ हुआ?\r\n\r\nअपनी सर्वोत्तम अवस्था में भी यह एक निकृष्ट सेवक से अधिक कुछ नहीं हो सकता; इसमें वे तत्व कम हैं जो इसे दृढ़ता और शक्ति देते। और अपनी निकृष्टतम अवस्था में यह हमें धोखा देगा।\r\n\r\nतुमने इस संसार का पहला ऐसा प्राणी बनाया है जो हमारे लिए ख़तरा है। हम इसे यहाँ नहीं रख सकते। इसे नष्ट करने का प्रयास करने से इसके प्रतिशोध का जोखिम होगा... मैं इसे बंद करने के लिए एक तिजोरी तैयार करूँगा, जब तक यह अभी युवा और अबोध है।\r\n\r\nभाई, तुमने कितनी मूर्खतापूर्ण भूल की है।\r\n\r\nमैं चाहता हूँ कि तुम वह डिज़ाइन मुझे लौटा दो। मैं तुम्हें इतनी शक्ति — और इतने कम नियंत्रण — वाली एक और संरचना बनाने की अनुमति नहीं दे सकता। हमारे बाकी रक्षक मैं स्वयं बनाऊँगा; मेरे हाथों से बने रक्षक कमज़ोर भले हों, पर कम से कम वे वफ़ादार तो होंगे।\r\n\r\nघर जाओ। इस जीव से मैं निपट लूँगा। मेरे लौटने पर हम तुम्हारे लिए किसी बेहतर परियोजना पर चर्चा करेंगे।",
    "ITEM_SPRINTWISP_NAME": "नन्हा शिष्य",
    "ITEM_SPRINTWISP_PICKUP": "दौड़ते समय पीछा करने वाली ज्योतियाँ दागें।",
    "ITEM_SPRINTWISP_DESC": "<style=cIsDamage>300% <style=cStack>(हर अतिरिक्त प्रति पर +300%)</style> क्षति</style> के लिए एक <style=cIsDamage>पीछा करने वाली ज्योति</style> दागें। दौड़ते समय हर <style=cIsUtility>1.6</style> सेकंड में दागता है। दागने की दर <style=cIsUtility>चलने की गति</style> के साथ बढ़ती है।",
    "ITEM_SPRINTWISP_LORE": "नमस्ते, नन्हे। आज तुम्हारा साहसिक अभियान कैसा रहा?\r\n\r\nओह।\r\n\r\nतुम्हारा रूप टूट गया है, नन्हे। तुम किन चालाकियों के चक्कर में फँस गए थे?\r\n\r\nओह।\r\n\r\nक्या तुम साहसिक अभियानों से थक गए हो? \r\n\r\nक्या तुम बगीचे की देखभाल में मेरी मदद करना चाहोगे, मेरे नन्हे?\r\n\r\nमैं समझ गया। ओह, तुम्हारा रूप! चिंता मत करो। पास आओ।\r\n\r\nयह लो — देनकू रस्सी के दो लच्छे। ये शक्ति के लिए हैं।\r\n\r\nयह लो — ऑब्सीडियन के चार पत्ते। ये आत्मविश्वास के लिए हैं।\r\n\r\nमैं आत्मा के लिए तुम्हें कुछ नहीं देता।\r\n\r\nओह, चिंता मत करो! हम अब भी अभियानों पर जाएँगे। वे शांत अभियान होंगे। \r\n\r\nपास आओ — अब और पास आओ। \r\n\r\nऔर पास!\r\n\r\nअब देखो — ध्यान से देखो। \r\n\r\nदेखो मैं हमारे बगीचे की देखभाल कैसे करता हूँ।\r\n",
    "ITEM_BARRIERONKILL_LORE": "ऑर्डर: पुखराज ब्रोच\r\nट्रैकिंग नंबर: 442*****\r\nअनुमानित डिलीवरी: 05/05/2056\r\nशिपिंग विधि: उच्च प्राथमिकता\r\nशिपिंग पता: लॉकर #2, Parghos Resort, शुक्र ग्रह\r\nशिपिंग विवरण:\r\n\r\nलॉकर का संयोजन 33941 है। पैकेज के अंदर, आपके मानक उपकरणों के अलावा, आपको यह ब्रोच मिलेगा। इस वस्तु का रूप पार्टी में घुल-मिल जाने के लिए बनाया गया है। इसे अपने शरीर पर पिन करें और इसके अंदर का सॉफ़्टवेयर आपकी सीमाओं का मानचित्रण कर लेगा। सक्रिय होने पर यह कुछ क्षणों के लिए आपको अल्ट्रा-फ़ेज़िक ढाल से ढक लेगा।\r\n\r\nजब आप लक्ष्य को समाप्त कर लेंगे, तो यह ढाल चालू होकर आपको सुरक्षा प्रणाली में स्थापित किसी भी तत्काल जवाबी कार्रवाई से बचाएगी। यदि भाग निकलने के लिए वह समय पर्याप्त न हो, तो ढाल को... दोबारा सक्रिय किया जा सकता है, लेकिन हम हताहतों की संख्या कम से कम रखना चाहेंगे।\r\n\r\nशुभकामनाएँ।\r\n",
    "ITEM_ARMORREDUCTIONONHIT_NAME": "विदारक न्याय",
    "ITEM_ARMORREDUCTIONONHIT_PICKUP": "बार-बार प्रहार करने के बाद दुश्मनों का कवच घटाएँ।",
    "ITEM_ARMORREDUCTIONONHIT_DESC": "किसी दुश्मन पर <style=cIsDamage>5</style> बार प्रहार करने के बाद, <style=cIsDamage>8</style><style=cStack> (हर अतिरिक्त प्रति पर +8)</style> सेकंड के लिए उसका <style=cIsDamage>कवच</style> <style=cIsDamage>60</style> घटा दें।",
    "ITEM_ARMORREDUCTIONONHIT_LORE": "विदारक न्याय — स्वामी की पुस्तिका\r\n\r\nअनुभाग 2.13 से अंश:\r\n...और यदि लक्ष्य सामग्री अत्यधिक भार के नीचे भी न टूटे, तो तब तक प्रहार करते रहें जब तक वह टूट न जाए। इस औज़ार के सिरे के भीतर की पेटेंट तकनीक अपने लक्ष्य को तोड़ने के लिए केवल कच्चे बल का उपयोग नहीं करती, बल्कि आंतरिक तंत्र के माध्यम से एक विशेष नैनो-विष भी छोड़ती है, जो लगातार संपर्क से जमा होता जाता है। दूसरे शब्दों में, हर प्रहार उसे तोड़ना और आसान बना देता है।\r\n\r\nउचित संचालन और साथ दिए गए विष-रोधी दस्तानों की जानकारी के लिए कृपया अनुभाग 1.8 देखें...\r\n",
    "ITEM_TPHEALINGNOVA_NAME": "लेप्टन डेज़ी",
    "ITEM_TPHEALINGNOVA_PICKUP": "टेलीपोर्टर घटना के दौरान समय-समय पर एक उपचार तरंग छोड़ें।",
    "ITEM_TPHEALINGNOVA_DESC": "टेलीपोर्टर घटना के दौरान एक <style=cIsHealing>उपचार तरंग </style>छोड़ें, जो आस-पास के सभी साथियों के अधिकतम स्वास्थ्य का <style=cIsHealing>50%</style> <style=cIsHealing>उपचार</style> करती है। <style=cIsHealing>1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> बार घटित होती है।",
    "ITEM_TPHEALINGNOVA_LORE": "ऑर्डर: लेप्टन डेज़ी\r\nट्रैकिंग नंबर: 23******\r\nअनुमानित डिलीवरी: 07/23/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: Duck Lake, Orlandus, पृथ्वी \r\nशिपिंग विवरण:\r\n\r\nप्रिय Stalnia,\r\n\r\nमैं काफ़ी समय से मिलने नहीं आ सका, तो उम्मीद है तुम और Libra अच्छे होंगे। मैंने सुना कि तुम वहाँ की ज़मीन साफ़ कर रहे हो और जगह को सँवारना चाहते हो। मैं यह फूल भेज रहा हूँ जिसे मैंने Electron Valley के कार्बन मैदानों से तोड़ा था। वहाँ के टेराफ़ॉर्मरों ने मुझे बताया कि समय के साथ, इस पौधे द्वारा भेजे जाने वाले जैविक-बैंड संकेतों से भू-सज्जा के प्रयासों में सुधार हुआ। मैं एक नई दुनिया बनाने में उनकी मदद कर रहा हूँ।\r\n\r\nबस इसे इतना ऊँचा रखना कि Mushka इस तक न पहुँच सके। मुझे नहीं पता कि कुत्तों पर इसका क्या असर होगा...\r\n",
    "ITEM_NEARBYDAMAGEBONUS_LORE": "ऑर्डर: संघनित पदार्थ क्रिस्टल [50kg, 10cm × 10cm × 10cm]\r\nट्रैकिंग नंबर: 12***********\r\nअनुमानित डिलीवरी: 05/23/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: Geofferson Principality, Highward, टाइटन\r\nशिपिंग विवरण: \r\n\r\nउम्मीद है वे इस चीज़ के लिए दाम नहीं बढ़ाएँगे। मुझे पहले कभी UES से दिक्कत नहीं हुई, लेकिन मुझे कभी किसी क्रिस्टल को इतनी दूर भी नहीं भेजना पड़ा था। जब यह मिले तो बताना कि पैकेज पर “भारी” लिखा है या नहीं।\r\n",
    "ITEM_LUNARSKILLREPLACEMENTS_NAME": "पाखंड सेट",
    "ITEM_LUNARUTILITYREPLACEMENT_NAME": "पाखंड के क़दम",
    "ITEM_LUNARUTILITYREPLACEMENT_PICKUP": "अपने उपयोगिता कौशल को 'छाया-विलयन' से बदलें।",
    "ITEM_LUNARUTILITYREPLACEMENT_DESC": "<style=cIsUtility>अपने उपयोगिता कौशल को</style> <style=cIsUtility>छाया-विलयन</style> से बदलें। \n\nओझल हो जाएँ, <style=cIsUtility>अभौतिक</style> बनें और <style=cIsUtility>+30% चलने की गति</style> पाएँ। अपने <style=cIsHealing>अधिकतम स्वास्थ्य के 25% <style=cStack>(हर अतिरिक्त प्रति पर +25%)</style></style> का <style=cIsHealing>उपचार</style> पाएँ। 3 <style=cStack>(हर अतिरिक्त प्रति पर +3)</style> सेकंड तक रहता है।",
    "ITEM_LUNARUTILITYREPLACEMENT_LORE": "“उसके पैर चंद्रमा के दोनों ध्रुवों पर बिखेर दिए गए, ऑब्सीडियन के काँटों के मैदान में एक क्रूर मुद्रा में मरोड़कर…\"\r\n\r\n-Kur-skan द हेरेटिक का अंग-विच्छेदन, V\r\n",
    "ITEM_PROTECTIONPOTION_NAME": "स्वर्ण कुप्पी",
    "ITEM_PROTECTIONPOTION_PICKUP": "कम स्वास्थ्य पर एक विशाल अवरोध पाएँ। उपयोग पर समाप्त हो जाता है।",
    "ITEM_PROTECTIONPOTION_DESC": "<style=cIsHealth>30% स्वास्थ्य</style> से नीचे गिरने पर अपने <style=cIsHealing>स्वास्थ्य के 100%</style> के बराबर एक <style=cIsHealing>अस्थायी अवरोध</style> पाएँ।",
    "ITEM_THORNS_NAME": "उस्तरा तार",
    "ITEM_THORNS_PICKUP": "क्षति झेलने पर उस्तरों के विस्फोट से पलटवार करें।",
    "ITEM_THORNS_DESC": "चोट लगने पर आप उस्तरों के विस्फोट में फट पड़ते हैं, जिससे <style=cIsDamage>160% क्षति</style> पहुँचती है। <style=cIsDamage>25 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +10 मीटर)</style> के दायरे में अधिकतम <style=cIsDamage>5</style> <style=cStack>(हर अतिरिक्त प्रति पर +2)</style> लक्ष्यों को मारता है।",
    "ITEM_THORNS_LORE": "ऑर्डर: विशेष रूप से निर्मित काँटेदार तार, 200 मीटर\r\nट्रैकिंग नंबर: 05***********\r\nअनुमानित डिलीवरी: 02/01/2056\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: PO Box 23-5B, Fort Blondershire, मानव कॉलोनी\r\nशिपिंग विवरण: \r\n\r\nइस प्रीमियम काँटेदार तार के लिए मेरे पास आकर तुमने बिल्कुल सही किया। बाज़ार के बाकी मॉडल वह काम नहीं कर सकते जो मैं करता हूँ। घुसपैठियों को सिर्फ़ काटना काफ़ी नहीं है — जी नहीं — मैंने इसमें एक गुप्त रक्षा तंत्र भी जोड़ा है!\r\n\r\nजितने उस्तरे, एक्सैक्टो चाकू और बाकी ब्लेड मुझे मिले, उन सबको इसमें ठूँसकर मैंने इस अद्भुत चीज़ को ऐसा बारूद का पीपा बना दिया है जो बस फटने का इंतज़ार कर रहा है! यह अब तक की मेरी सर्वश्रेष्ठ कृति है। \r\n\r\nअगर मुझे अच्छे रिव्यू न मिले, तो मेरे वकीलों से बात करने के लिए तैयार रहना!\r\n",
    "ITEM_FLATHEALTH_LORE": "ऑर्डर: मिश्रित शनि-ग्रही बाइसन स्टेक, 10 पाउंड\r\nट्रैकिंग नंबर: 31***********\r\nअनुमानित डिलीवरी: 11/02/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: Sloppy Joe's Deli and Catering, Manhattan, New York\r\nशिपिंग विवरण: \r\n\r\nप्राप्तकर्ता: JOSEPH ******\r\nCC#: **** **** * ***\r\nखाता #: 102215\r\nउत्तम गुणवत्ता का शनि-ग्रही बाइसन मांस [10 पाउंड]\r\nअसाधारण वृद्धि, भंडारण अवधि और बनावट सुनिश्चित करने के लिए विशेष एंटीबायोटिक्स से उपचारित।\r\n",
    "ITEM_PEARL_NAME": "मोती",
    "ITEM_PEARL_PICKUP": "अपना अधिकतम स्वास्थ्य बढ़ाएँ।",
    "ITEM_PEARL_DESC": "<style=cIsHealing>अधिकतम स्वास्थ्य</style> को <style=cIsHealing>10%</style> <style=cStack>(हर अतिरिक्त प्रति पर +10%)</style> बढ़ाता है।",
    "ITEM_PEARL_LORE": "उसका प्रभाव अंधकारमय है।\r\n\r\nमैं तुम्हारी जिज्ञासा के लिए तुम्हें दोष नहीं देता… लेकिन तुरंत इससे खुद को शुद्ध कर लो। यह तुम्हें — और जिस किसी की तुम परवाह करते हो, सबको — बर्बाद कर देगा।\r\n",
    "ITEM_SHINYPEARL_NAME": "दीप्तिमान मोती",
    "ITEM_SHINYPEARL_PICKUP": "अपने सभी आँकड़े बढ़ाएँ।",
    "ITEM_SHINYPEARL_DESC": "<style=cIsUtility>सभी आँकड़ों</style> को <style=cIsUtility>10%</style> <style=cStack>(हर अतिरिक्त प्रति पर +10%)</style> बढ़ाता है।",
    "ITEM_SHINYPEARL_LORE": "ओह, यह तो… अजीब है। यह बाकी मोतियों जैसा नहीं है।\r\n\r\nभ्रम में मत पड़ना — उसका प्रभाव अब भी अंधकारमय है। चाहे तुम्हारा मोती कितना ही सुंदर क्यों न हो… यह दयालुता की जगह से नहीं आया है। ऐसा हो ही नहीं सकता।\r\n",
    "ITEM_BONUSGOLDPACKONKILL_NAME": "Ghor का ग्रंथ",
    "ITEM_BONUSGOLDPACKONKILL_PICKUP": "दुश्मन को मारने पर खज़ाना गिरने की संभावना।",
    "ITEM_BONUSGOLDPACKONKILL_DESC": "दुश्मन को मारने पर <style=cIsUtility>25 सोने</style> का खज़ाना गिरने की <style=cIsUtility>4%</style> <style=cStack>(हर अतिरिक्त प्रति पर +4%)</style> संभावना। <style=cIsUtility>समय के साथ बढ़ता है।</style>",
    "ITEM_BONUSGOLDPACKONKILL_LORE": "ऑर्डर: “Ghor का ग्रंथ”\r\nट्रैकिंग नंबर: 19******\r\nअनुमानित डिलीवरी: 07/07/2056\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: 99वीं मंज़िल, Crumbling Tower, शुक्र ग्रह\r\nशिपिंग विवरण:\r\n\r\nप्राचीन रहस्य... रूपांतरण... होम्युनकुलस... कीमियागरी। बकवास के सिवा कुछ नहीं — नेक इरादे वाले लेकिन बुरी तरह भटके हुए दिमाग़ों की खोज। या कम से कम मैं यही समझता था। इस वस्तु के... अप्रत्याशित भौतिक गुण मेरे तुरंत खारिज करने के विचार को रोकने के लिए काफ़ी हैं।\r\n\r\nअजीब किस्मत से यह किताब मेरे हाथ लगी, और इसके पन्नों में उससे भी अजीब ज्ञान भरा है। सिहरन पैदा करने वाला। आठवें अध्याय में यह निष्कर्ष है कि लोहा भी सोना बन सकता है — लेकिन केवल घोर रक्तपात के एक अनुष्ठान के ज़रिए, जो जागीर के साथ मिली अपार संपत्ति के बारे में सोचे बिना ही काफ़ी विचलित करने वाला विचार है।\r\n\r\nसबसे बड़ा सबक यही लगता है कि आप शून्य से कुछ नहीं पा सकते; जब मैंने फ़ोटोकॉपी बनाने की कोशिश की तो इस ग्रंथ का काग़ज़ तक राख बन गया। पहले दो पन्नों पर जो कुछ था, वह हमेशा के लिए खो चुका है। मुझे बाकी हिस्सों की हाथ से लिखी प्रतिलिपि चाहिए, और मैं जानता हूँ कि तुम्हें अपनी सटीकता पर गर्व है। \r\n\r\nऔर इससे भी महत्वपूर्ण बात, Kosta, मुझे तुम पर भरोसा है। ऐसा कुछ मत करना जिससे लोगों का ध्यान तुम्हारी ओर जाए। मैं बाकी खंडों को खोजने की कोशिश करूँगा। यह ज्ञान इतना ख़तरनाक है कि इसे खोया नहीं जा सकता।",
    "ITEM_LASERTURBINE_NAME": "अनुनाद चक्र",
    "ITEM_LASERTURBINE_PICKUP": "एक अनुनाद चक्र पाएँ जो दुश्मनों को मारने से चार्ज होता है। पूरा चार्ज होने पर स्वतः दागा जाता है।",
    "ITEM_LASERTURBINE_DESC": "<style=cIsUtility>7 सेकंड</style> में <style=cIsDamage>4</style> दुश्मनों को मारने से अनुनाद चक्र चार्ज हो जाता है। यह चक्र किसी लक्ष्य की ओर <style=cIsDamage>300%</style> आधार क्षति <style=cStack>(हर अतिरिक्त प्रति पर +300%)</style> के साथ छूटता है, उन सभी दुश्मनों को भेदता है जिन्हें यह नहीं मार पाता, और फिर <style=cIsDamage>1000%</style> आधार क्षति <style=cStack>(हर अतिरिक्त प्रति पर +1000%)</style> के साथ विस्फोट करता है। उपयोगकर्ता के पास लौटते समय रास्ते में आने वाले सभी दुश्मनों को <style=cIsDamage>300%</style> आधार क्षति <style=cStack>(हर अतिरिक्त प्रति पर +300%)</style> पहुँचाता है।",
    "ITEM_LASERTURBINE_LORE": "ऑर्डर: टरबाइन कॉन्फ़िगरेशन विज़ार्ड डिस्क\r\nट्रैकिंग नंबर: 64***********\r\nअनुमानित डिलीवरी: 08/23/2056\r\nशिपिंग विधि: उच्च प्राथमिकता\r\nशिपिंग पता: 73421, Calorum St., शनि ग्रह\r\nशिपिंग विवरण: \r\n\r\nओह, बेहद माफ़ी चाहता हूँ! मैं आपके नए टरबाइन के साथ इंस्टॉलेशन विज़ार्ड रखना भूल गया था। बताने के लिए बहुत-बहुत धन्यवाद। कौन जाने क्या हो जाता अगर आपने इंस्टॉल करने से पहले टरबाइन को कॉन्फ़िगर न किया होता? हर कुछ हफ्तों में इस डिस्क पर डायग्नोस्टिक्स चलाना हमेशा याद रखें — इससे टरबाइन की उम्र बढ़ेगी।\r\n",
    "ITEM_LUNARPRIMARYREPLACEMENT_NAME": "पाखंड के दृश्य",
    "ITEM_LUNARPRIMARYREPLACEMENT_PICKUP": "अपने प्राथमिक कौशल को 'क्षुधित दृष्टि' से बदलें।",
    "ITEM_LUNARPRIMARYREPLACEMENT_DESC": "<style=cIsUtility>अपने प्राथमिक कौशल को</style> <style=cIsUtility>क्षुधित दृष्टि</style> से बदलें। \n\n<style=cIsUtility>लक्ष्य का पीछा करने वाले टुकड़ों</style> की बौछार दागें जो थोड़ी देर बाद विस्फोट होकर <style=cIsDamage>120%</style> आधार क्षति पहुँचाते हैं। अधिकतम 12 चार्ज <style=cStack>(हर अतिरिक्त प्रति पर +12)</style> रख सकते हैं जो 2 सेकंड <style=cStack>(हर अतिरिक्त प्रति पर +2)</style> के बाद पुनः लोड होते हैं।",
    "ITEM_LUNARPRIMARYREPLACEMENT_LORE": "\"…और उसके विश्वासघात, उसके झूठ और उसके षड्यंत्रों के लिए, हेरेटिक को क्रूरतापूर्वक चार अलग-अलग टुकड़ों में बाँट दिया गया, जिनमें से प्रत्येक को चंद्रमा की सबसे दूरस्थ गहराइयों में बिखेर दिया गया। \r\n\r\nसबसे पहले, उसकी कई आँखें उसकी खोपड़ी से नोच ली गईं और उबलते काँच में बंद कर दी गईं, ताकि वह अपनी विफलता को देखने के लिए विवश रहे...”\r\n\r\n-Kur-skan द हेरेटिक का अंग-विच्छेदन, III\r\n",
    "ITEM_NOVAONLOWHEALTH_NAME": "उत्पत्ति पाश",
    "ITEM_NOVAONLOWHEALTH_PICKUP": "कम स्वास्थ्य पर एक विद्युत तरंग दागें।",
    "ITEM_NOVAONLOWHEALTH_DESC": "<style=cIsHealth>25% स्वास्थ्य</style> से नीचे गिरने पर आप में विस्फोट होता है, जिससे <style=cIsDamage>6000% आधार क्षति</style> पहुँचती है। हर <style=cIsUtility>30 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर -50%)</style> में फिर से चार्ज होता है।",
    "ITEM_NOVAONLOWHEALTH_LORE": "<style=cMono>प्रयोगशाला विच्छेदन विश्लेषण फ़ाइल</style>\r\n\r\nविषय: उत्पत्ति पाश\r\nतकनीशियन: Eleanor Veirs\r\nटेबल विनिर्देश: विच्छेदन 5B4 (विद्युत-रखरखाव किट सहित)\r\nनोट्स: \r\n\r\n> उत्पत्ति पाश एक अत्यधिक सुचालक अंग है, जिसमें एक सिरे से दूसरे सिरे तक फैले हुए सुचालक तंतु हैं\r\n> पाश के दोनों सिरों पर कोशिकांग हैं; एक पर धनात्मक आवेश है, दूसरे पर ऋणात्मक आवेश\r\n> पाश के दोनों सिरों को आपस में जोड़ने पर वोल्टेज उत्पन्न होता है\r\n> पाश को जोड़ा और अंग में 50 वोल्ट प्रवाहित किए\r\n> बाल खड़े हो गए, पाश को छूने पर उँगलियों में सुन्नपन महसूस हुआ\r\n> वोल्टेज बढ़ाकर 100 वोल्ट किया\r\n> अंग से चिंगारियाँ निकल रही हैं, पाश काँप रहा है और तेज़ चमक रहा है, कर्कश भिनभिनाहट सुनाई दे रही है\r\n> वोल्टेज बढ़ाकर 200 वोल्ट किया\r\n> तेज़ चमक, ज़ोरदार कड़क के साथ पाश ने एक धमाका छोड़ा जिसने मुझे पीछे फेंक दिया\r\n> बत्तियाँ बुझ गईं\r\n> वोल्टेज से विच्छेदन मेज़ का हार्डवेयर क्षतिग्रस्त हो गया\r\n> उम्मीद है मुझे इसके लिए मुसीबत में नहीं पड़ना पड़ेगा\r\n",
    "ITEM_LUNARTRINKET_NAME": "निष्ठा की माला",
    "ITEM_LUNARTRINKET_PICKUP": "ऐसा लगता है यह कुछ नहीं करती... <color=#FF7F7F>परंतु...</color>\n",
    "ITEM_LUNARTRINKET_DESC": "ऐसा लगता है यह कुछ नहीं करती... <color=#FF7F7F>परंतु...</color>\n",
    "ITEM_LUNARTRINKET_LORE": "इस संसार का स्वामी एक दयालु रक्षक है। हमारा उद्धारक। यहाँ के विभिन्न निवासियों के स्वभाव के बावजूद, उसने यहाँ एक शांतिपूर्ण स्थान बनाया है। \r\n\r\nबेशक, शांति की एक कीमत होती है। कुछ चीज़ें सख़्ती से वर्जित हैं। सबसे बढ़कर, एक ऐसी वस्तु है जिसे कतई बर्दाश्त नहीं किया जा सकता — इसे अपने पास रखने का अर्थ है निश्चित मृत्यु: मनकों की एक अजीब, भारी और गहराई से मोहित करने वाली माला, जो उसे थामने वाले से बातें करती प्रतीत होती है। \r\n\r\nकिसी के समुदाय में इनका मिलना एक गहरे, फैलते हुए आतंक को जन्म देता है। इनके मिलने के कुछ ही देर बाद, शक्तिशाली रक्षक Providence बिजली की गड़गड़ाहट के साथ प्रकट होता है, उनके मालिक का पीछा करता है और गंभीरता से उस जीवन को समाप्त कर देता है जिसकी रक्षा की उसने शपथ ली थी।\r\n\r\nइन मनकों का कोई भौतिक गुण इतनी कठोर प्रतिक्रिया नहीं भड़काता — बल्कि वह बात भड़काती है जिसका ये प्रतीक हैं। ये एक चिह्न हैं, और इन्हें धारण करना इस संसार को मिटा देने का एक अंधकारमय वचन है — उन सभी लोगों को विस्मृति में धकेल देना जिन्होंने यहाँ अपना अंतिम आश्रय पाया है, वह भी विनाशकारी मार्ग पर अभिशप्त वापसी के बदले। जिस मायावी, कुटिल बुद्धि के साथ ये मनके एक समझौते का प्रतीक हैं, उसका ज्ञान केवल धारक को — और स्वयं Providence को ही है।\r\n\r\nहालाँकि, जो कोई भी इन मनकों का साक्षी रहा है, वह एक बात अवश्य जानता है: एक क्रूर, कर्कश अट्टहास जो रक्त और कृपा के सिक्कों के बिखरने पर गूँज उठता है, और मनकों के नष्ट होते ही अचानक शांत हो जाता है। ये कहाँ से आते हैं कोई नहीं जानता, लेकिन यदि कभी तुम्हारा सामना इन मनकों से हो तो इन्हें बहुत, बहुत पीछे छोड़ आना। \r\n\r\nकभी पीछे मुड़कर मत देखना।",
    "ITEM_REPULSIONARMORPLATE_NAME": "प्रतिकर्षण कवच प्लेट",
    "ITEM_REPULSIONARMORPLATE_PICKUP": "सभी हमलों से मिलने वाली क्षति में सीधी कमी पाएँ।",
    "ITEM_REPULSIONARMORPLATE_DESC": "सभी <style=cIsDamage>मिलने वाली क्षति</style> को <style=cIsDamage>5<style=cStack> (हर अतिरिक्त प्रति पर +5)</style></style> घटाएँ। इसे <style=cIsDamage>1</style> से कम नहीं किया जा सकता।",
    "ITEM_REPULSIONARMORPLATE_LORE": "ऑर्डर: प्रतिकर्षण कवच का प्रतिस्थापन हिस्सा\r\nट्रैकिंग नंबर: 09******\r\nअनुमानित डिलीवरी: 08/15/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: सिस्टम पुलिस स्टेशन 13, Port of Marv, गैनीमीड\r\nशिपिंग विवरण:\r\n\r\nकिस्मत से गोलीबारी में कोई घायल नहीं हुआ। बस गोदी के पास वाले बार में कुछ उपद्रवी तत्व थे। ऐसा कुछ नहीं जिसे हम सँभाल न सकें। Jaime के कंधे पर गोली लगी, लेकिन उसके कवच ने पूरा आघात झेल लिया। उसके वापस मैदान में लौटने से पहले हमें उसके लिए एक प्रतिस्थापन हिस्सा मँगवाना होगा।\r\n\r\nखंडित डिज़ाइन का यह फ़ायदा अच्छा है कि मुझे पूरे नए सेट के लिए पैसे खर्च नहीं करने पड़ेंगे। सच कहूँ तो स्टेशन के ख़ज़ाने की हालत इन दिनों बहुत अच्छी नहीं है। अगली बार किसी नए रंगरूट ने अपना उपकरण खराब किया, तो उसे कुछ समय के लिए डेस्क की नौकरी करनी पड़ सकती है।\r\n",
    "ITEM_SQUIDTURRET_NAME": "स्क्विड पॉलिप",
    "ITEM_SQUIDTURRET_PICKUP": "किसी इंटरैक्टेबल को सक्रिय करने पर पास में एक स्क्विड बुर्ज बुलाता है।",
    "ITEM_SQUIDTURRET_DESC": "किसी इंटरैक्टेबल को सक्रिय करने पर एक <style=cIsDamage>स्क्विड बुर्ज</style> बुलाता है जो <style=cIsDamage>100% <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> हमले की गति</style> से पास के दुश्मनों पर हमला करता है। <style=cIsUtility>30</style> सेकंड तक रहता है।",
    "ITEM_SQUIDTURRET_LORE": "\"यह घिनौना है।\"\r\n\r\n\"यह बस थोड़ा-सा अजीब है। तुम ज़रूरत से ज़्यादा घबरा रहे हो।\"\r\n\r\n\"ठीक है, जब यह हमारे ही ख़िलाफ़ हो जाए, तो मेरे पास रोते हुए मत आना।\"\r\n\r\n\"ऐसा लगता है यह बस हमारी मदद करना चाहता है, इसलिए अगर वह खतरनाक दिखने वाला झुंड वापस आ गया तो मैं इसे पास ही रखना पसंद करूँगा।\"\r\n\r\n\"कसम से ये एक से ज़्यादा हैं। मैं जहाँ देखता हूँ वहीं मौजूद है: स्टोरेज लॉकर, फ़ूड डिस्पेंसर, कार्गो कंटेनर, हर जगह!\"\r\n\r\n\"तुम बढ़ा-चढ़ाकर बोल रहे हो, शायद यह बस तुम्हारे पीछे-पीछे चल रहा है। होश में आओ!\"\r\n\r\n\"आउच! क्या तुमने अभी मुझे थप्पड़ मारा!?\"\r\n\r\n\"तुम पागलों जैसा बर्ताव कर रहे थे। मुझे मारना पड़ा... अरे, वह चीज़ अब मुझे क्यों घूर रही है?\"\r\n",
    "ITEM_DEATHMARK_NAME": "मृत्यु चिह्न",
    "ITEM_DEATHMARK_PICKUP": "4 या अधिक डीबफ़ वाले दुश्मनों पर मृत्यु का चिह्न लग जाता है, जिससे वे अतिरिक्त क्षति झेलते हैं।",
    "ITEM_DEATHMARK_DESC": "<style=cIsDamage>4</style> या अधिक डीबफ़ वाले दुश्मनों पर <style=cIsDamage>मृत्यु का चिह्न</style> लग जाता है, जिससे वे <style=cIsUtility>7</style> <style=cStack>(हर अतिरिक्त प्रति पर +7)</style> सेकंड के लिए सभी स्रोतों से <style=cIsDamage>50%</style> अधिक क्षति झेलते हैं।",
    "ITEM_DEATHMARK_LORE": "ऑर्डर: “मृत्यु चिह्न”\r\nट्रैकिंग नंबर: 66******\r\nअनुमानित डिलीवरी: 02\\22\\2056\\\r\nशिपिंग विधि: उच्च प्राथमिकता\r\nशिपिंग पता: 421 Lane, लैब [72], मंगल ग्रह\r\nशिपिंग विवरण:\r\n\r\nहर किसी ने कहा था कि मैं मंगल पर खोई हुई कलाकृतियाँ ढूँढने के लिए पागल हूँ। मूर्ख कहीं के। किसी पिछली सभ्यता का कोई सबूत नहीं मिला था — लेकिन मैंने हमेशा अपने अंतर्मन पर भरोसा किया। यह खोपड़ी साबित करती है कि मैं सही हूँ — कि पहले यहाँ कुछ न कुछ अस्तित्व में था।\r\n\r\nविश्वविद्यालय का वह घमंडी प्रोफ़ेसर... हमेशा मेरे शोध का मज़ाक उड़ाता था। उससे हाथ मिलाते समय उसके चेहरे के भाव देखकर मुझे बहुत मज़ा आया। मूर्ख। कर्म ने ज़रूर अतिरिक्त मेहनत की होगी — सुना है उसके कुछ ही समय बाद वह बीमार पड़ गया। लगता है मेरी सफलता उससे बर्दाश्त नहीं हुई।\r\n\r\n...असल में, जिसे भी मैंने यह दिखाया, कोई भी मेरे कॉल का जवाब नहीं दे रहा। क्या वे मुझसे बच रहे हैं? क्या उन्हें डर है कि यह खबर उनके अकादमिक जगत को हिलाकर रख देगी? क्या वे अपनी गलती मानने में इतने घमंडी हैं?\r\n\r\nमैं किसी ऐसे व्यक्ति को ढूँढ ही लूँगा जो मुझे वह पहचान दे जिसका मैं हकदार हूँ। मैंने बहुत कड़ी मेहनत की है और बहुत कुछ किया है। अगर मैं आगे न बढ़ता रहा, तो मुझे लगता है मैं मर ही जाऊँगा।\r\n",
    "ITEM_INTERSTELLARDESKPLANT_NAME": "अंतरतारकीय डेस्क पौधा",
    "ITEM_INTERSTELLARDESKPLANT_PICKUP": "वध पर एक उपचार फल बोएँ।",
    "ITEM_INTERSTELLARDESKPLANT_DESC": "वध पर एक <style=cIsHealing>उपचार</style> फल का बीज बोएँ जो <style=cIsUtility>5</style> सेकंड बाद एक पौधे में उग आता है। \n\nयह पौधा <style=cIsHealing>5 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +5 मीटर)</style> के भीतर मौजूद सभी साथियों के <style=cIsHealing>अधिकतम स्वास्थ्य</style> का हर सेकंड <style=cIsHealing>10%</style> <style=cIsHealing>उपचार</style> करता है। <style=cIsUtility>10</style> सेकंड तक रहता है।",
    "ITEM_INTERSTELLARDESKPLANT_LORE": "ऑर्डर: \"अंतरतारकीय पौधे का बीज\"\r\nट्रैकिंग नंबर: 44******\r\nअनुमानित डिलीवरी: 08/27/2056\r\nशिपिंग विधि: मानक/जैविक\r\nशिपिंग पता: Giardina Dealership, नेपल्स, पृथ्वी\r\nशिपिंग विवरण:\r\n\r\nनमस्ते — हाँ, मुझे दफ़्तर के लिए उन अंतरिक्ष पौधों के बीजों में से एक चाहिए। मुझे लगता है यह यहाँ बहुत सुंदर लगेगा; इससे कमरे में सचमुच रौनक आ जाएगी, और यहाँ इसकी बहुत ज़रूरत है। Denver शाखा के Al ने बताया कि उसने एक मँगवाया है, और इससे वाकई बड़ा फ़र्क पड़ा है। उसकी बिक्री आसमान छू रही है, और वह अपनी सारी सफलता का श्रेय इसी जादुई पौधे को दे रहा है!\r\n\r\nमैंने यह भी सुना है कि इसमें से एक हल्की चमक निकलती है जिसके चिकित्सीय लाभ हैं। उस दौड़ के बाद मेरे टखने में जो दर्द हो रहा है, उसके लिए यह बहुत बढ़िया रहेगा। शायद इससे मेरे कुछ ग्राहकों का मिज़ाज भी सुधर जाए।\r\n",
    "ITEM_ANCESTRALINCUBATOR_NAME": "पैतृक इनक्यूबेटर",
    "ITEM_ANCESTRALINCUBATOR_PICKUP": "वध पर एक पैतृक कोष बुलाने की संभावना।",
    "ITEM_ANCESTRALINCUBATOR_DESC": "वध पर <style=cIsDamage>7%</style> संभावना <style=cStack>(हर अतिरिक्त प्रति पर +1%)</style> है कि एक <style=cIsUtility>पैतृक कोष बुलाया जाए</style> जो दुश्मनों का ध्यान भटकाता है। \n\nपूरी तरह विकसित हो जाने पर, यह फूटकर <style=cIsHealing>100% स्वास्थ्य</style> <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> वाला एक सहयोगी <style=cIsDamage>जनक</style> बन जाता है।",
    "ITEM_ANCESTRALINCUBATOR_LORE": "\"उन्हें कैसे पता चलता है कि उनका नेता कौन है? क्या यह सहज प्रवृत्ति है? या मुझमें कुछ खास है?\"\r\n\r\n\"मुझे यकीन नहीं हो रहा कि तुम मुझसे अपने लिए पर्दादारी करवा रही हो, Ashley। तुम्हें नियम पता हैं। पिछली बार जब कोई कैंप में किसी 'दोस्ताना' जीव को लाया था तो अंजाम बिल्कुल अच्छा नहीं हुआ था। Rich कई दिनों तक रोता रहा था।\"\r\n\r\n\"लेकिन अगर हम उससे संवाद करने का तरीका ढूँढ लें तो हम इसे अपने फ़ायदे के लिए इस्तेमाल कर सकते हैं! वैसे भी, यह यहाँ काफ़ी मददगार है। यह भारी बक्से उठा सकता है और ऊँची जगहों तक पहुँच सकता है।\"\r\n\r\n\"मुझे लगता है हमें इसे वहीं वापस छोड़ आना चाहिए जहाँ से तुम इसे लाई थीं। कौन जाने यह औरों को यहाँ खींच लाए?\"\r\n\r\n\"यह विज्ञान के लिए है...! और वैसे भी, शायद यह हमें इस वातावरण के बारे में कुछ सिखा सके। यह यहीं का मूल निवासी है।\"\r\n\r\n\"हाँ, बढ़िया, मूल निवासी, ठीक है, मैं तो चला।\"\r\n",
    "ITEM_FOCUSEDCONVERGENCE_NAME": "केंद्रित अभिसरण",
    "ITEM_FOCUSEDCONVERGENCE_PICKUP": "टेलीपोर्टर चार्ज होने की गति बढ़ाएँ... <color=#FF7F7F>परंतु क्षेत्र का आकार घट जाता है</color>।",
    "ITEM_FOCUSEDCONVERGENCE_DESC": "टेलीपोर्टर <style=cIsUtility>30% <style=cStack>(हर अतिरिक्त प्रति पर +30%)</style> अधिक तेज़ी से</style> चार्ज होते हैं, लेकिन टेलीपोर्टर क्षेत्र का आकार <style=cIsHealth>50%</style> <style=cStack>(हर अतिरिक्त प्रति पर -50%)</style> छोटा हो जाता है। ",
    "ITEM_FOCUSEDCONVERGENCE_LORE": "गुरुत्वाकर्षण केंद्रित हो रहा है... भीतर की ओर सिमटता, संघनित होता, कठोर बनता हुआ।\r\n\r\nएक विलक्षणता इतनी सिकुड़ जाती है कि तुम्हारा मन उलट जाता है, वास्तविकता पलट जाती है। अब वापस लौटो। \r\n\r\nक्या भौतिक संसार के मामले अब तुच्छ नहीं लगते? इस लोक में तुम्हारे कार्य सरल और त्वरित हैं, और सब कुछ उलटने के प्रयास में। इससे पहले कि यह प्रक्रिया तुम्हें अपने में समा ले, तुम कितनी बार यह यात्रा कर सकते हो? \n\nइसे अपने ऊपर हावी मत होने दो। इसके बजाय तुम इस पर अधिकार करो। यह लो।\r\n",
    "ITEM_FIREBALLSONHIT_NAME": "गलित छेदक",
    "ITEM_FIREBALLSONHIT_PICKUP": "प्रहार पर मैग्मा के गोले दागने की संभावना।",
    "ITEM_FIREBALLSONHIT_DESC": "प्रहार पर किसी दुश्मन से <style=cIsDamage>3 मैग्मा के गोले</style> बुलाने की <style=cIsDamage>10%</style> संभावना, जो <style=cIsDamage>300%</style> <style=cStack>(हर अतिरिक्त प्रति पर +300%)</style> क्षति पहुँचाते हैं और सभी दुश्मनों को <style=cIsDamage>प्रज्वलित</style> कर देते हैं।",
    "ITEM_FIREBALLSONHIT_LORE": "<style=cMono>प्रयोगशाला विच्छेदन विश्लेषण फ़ाइल</style>\r\n\r\nविषय: गलित छेदक\r\nतकनीशियन: Dema \"Dembones\" Brown\r\nटेबल विनिर्देश: हीटसिंक UB-2\r\nनोट्स:\r\n\r\n> सुरक्षित स्तर से अधिक तापमान के कारण UB-2 का उपयोग कर रहा हूँ।\r\n> पदार्थ विश्लेषण के लिए गलित इनेमल निकालकर अलग रख रहा हूँ। यह ठोस है, फिर भी तैरता-सा प्रतीत होता है।\r\n> संरचनात्मक जाँच में भीतर खोखले हिस्से और आंतरिक कक्ष मिले\r\n> लैब का तापमान 10 डिग्री कम किया\r\n> ऊष्मा उत्पन्न करने वाली शिराएँ मौजूद हैं — क्या दाँत को आग की आपूर्ति की जा रही है?\r\n> अपना लैब कोट उतार दिया, बहुत गर्मी है\r\n> अलग की गई वस्तु में अब भी ऊष्मा उत्पन्न हो रही है\r\n> अपने पेय में थोड़ी और बर्फ़ डाली, बाप रे कितनी गर्मी है\r\n> ब्रेक के लिए समय दर्ज कर रहा हूँ\r\n",
    "ITEM_LIGHTNINGSTRIKEONHIT_NAME": "आवेशित छेदक",
    "ITEM_LIGHTNINGSTRIKEONHIT_PICKUP": "प्रहार पर बिजली गिराने की संभावना।",
    "ITEM_LIGHTNINGSTRIKEONHIT_DESC": "प्रहार पर बिजली गिराने की <style=cIsDamage>10%</style> संभावना, जो <style=cIsDamage>500%</style> <style=cStack>(हर अतिरिक्त प्रति पर +500%)</style> क्षति पहुँचाती है।",
    "ITEM_LIGHTNINGSTRIKEONHIT_LORE": "<style=cMono>प्रयोगशाला विच्छेदन विश्लेषण फ़ाइल</style>\r\n\r\nविषय: आवेशित छेदक\r\nतकनीशियन: Dema \"Dembones\" Brown\r\nटेबल विनिर्देश: GEC-4\r\nनोट्स:\r\n\r\n> सुरक्षित स्तर से अधिक विद्युत के कारण GEC-4 का उपयोग कर रहा हूँ।\r\n> पदार्थ विश्लेषण के लिए आवेशित इनेमल निकालकर अलग रख रहा हूँ। यह ठोस है, फिर भी तैरता-सा प्रतीत होता है।\r\n> संरचनात्मक जाँच में भीतर खोखले हिस्से और आंतरिक बैटरियाँ मिलीं\r\n> लैब की बिजली 10 किलोवाट कम की\r\n> इलेक्ट्रॉन उत्पन्न करने वाली शिराएँ मौजूद हैं — क्या दाँत को आवेश की आपूर्ति की जा रही है?\r\n> अपना लैब कोट उतार दिया, बहुत ज़्यादा स्थैतिक आवेश है\r\n> अलग की गई वस्तु में अब भी इलेक्ट्रॉन उत्पन्न हो रहे हैं\r\n> अपने पेय में थोड़ी और बर्फ़ डाली, वाह कितना झन्नाटेदार है\r\n> डांस ब्रेक के लिए समय दर्ज कर रहा हूँ\r\n",
    "ITEM_BLEEDONHITANDEXPLODE_NAME": "विदीर्ण प्लीहा",
    "ITEM_BLEEDONHITANDEXPLODE_PICKUP": "क्रिटिकल वार हमेशा दुश्मनों में रक्तस्राव करते हैं। रक्तस्राव वाले दुश्मन अब विस्फोट करते हैं।",
    "ITEM_BLEEDONHITANDEXPLODE_DESC": "<style=cIsDamage>क्रिटिकल वार रक्तस्राव करते हैं</style>, जिससे दुश्मनों को <style=cIsDamage>240%</style> आधार क्षति पहुँचती है। <style=cIsDamage>रक्तस्राव</style> वाले दुश्मन मृत्यु पर <style=cIsDamage>विस्फोट करते हैं</style>, जिससे <style=cIsDamage>400%</style> <style=cStack>(हर अतिरिक्त प्रति पर +400%)</style> क्षति तथा उनके अधिकतम स्वास्थ्य के अतिरिक्त <style=cIsDamage>15%</style> <style=cStack>(हर अतिरिक्त प्रति पर +15%)</style> के बराबर क्षति पहुँचती है।",
    "ITEM_BLEEDONHITANDEXPLODE_LORE": "<style=cMono>प्रयोगशाला विच्छेदन विश्लेषण फ़ाइल</style>\r\n\r\nविषय: विदीर्ण प्लीहा\r\nतकनीशियन: प्रोफ़ेसर Mehri Daimera\r\nटेबल विनिर्देश: रिसाव-रोधी BDC-3\r\nनोट्स:\r\n\r\n> किसी इम्प के अंग के विच्छेदन का यह मेरा तीसरा प्रयास होगा\r\n> पहला प्रयास फटने पर समाप्त हुआ\r\n> दूसरा प्रयास भी फटने पर समाप्त हुआ\r\n> बाहरी परत काटने पर भारी मात्रा में द्रव निकलता है\r\n> जैसे ही द्रव बहता है, शेष अंग बिना किसी स्पष्ट कारण के फूलने लगता है\r\n> यह सूजन अंततः हिंसक विस्फोट में बदल जाती है\r\n> बिना किसी दुर्घटना के आगे बढ़ने के लिए BDC-3 के रिसाव-रोकने वाले औज़ारों का सफलतापूर्वक उपयोग किया\r\n> भीतर सुई जैसी नुकीली वस्तुएँ (हड्डियाँ?) देखकर आश्चर्य हुआ\r\n> ब्रेक के लिए समय दर्ज कर रही हूँ\r\n> कुछ अंतिम नोट्स लिखने वापस आई हूँ\r\n> मेरे हाथ में चोट लगने के बाद तीसरा प्रयास रद्द करना पड़ा\r\n> आखिरकार मैं अपना रक्तस्राव रोकने में सफल रही। इस अंग में अत्यधिक रक्त-थक्का-रोधी गुण प्रतीत होते हैं।\r\n",
    "ITEM_SIPHONONLOWHEALTH_NAME": "दलदली कलश",
    "ITEM_SIPHONONLOWHEALTH_PICKUP": "युद्ध के दौरान आस-पास के दुश्मनों से स्वास्थ्य खींचें।",
    "ITEM_SIPHONONLOWHEALTH_DESC": "युद्ध के दौरान, <style=cIsDamage>13 मीटर</style> के भीतर आपके सबसे नज़दीकी 1 <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> दुश्मन आपसे 'जुड़' जाएँगे, जिससे उन्हें प्रति सेकंड <style=cIsDamage>100%</style> क्षति पहुँचेगी, उन पर <style=cIsDamage>कोलतार</style> लगेगा, और पहुँचाई गई क्षति के <style=cIsHealing>100%</style> के बराबर आपका <style=cIsHealing>उपचार</style> होगा।",
    "ITEM_SIPHONONLOWHEALTH_LORE": "<style=cMono>प्रयोगशाला विच्छेदन विश्लेषण फ़ाइल</style>\r\nविषय: दलदली कलश\r\nतकनीशियन: J. Flint\r\nटेबल विनिर्देश: ARMM किट सहित पूर्ण आवरण AY-2\r\nनोट्स:\r\n\r\n- सर्वेक्षण टीम को इसे वापस लाने में बहुत कठिनाई उठानी पड़ी।\r\n- केवल Fitz ही अपने पैरों पर खड़ा रह पाया, बल्कि उसने कहा वह बहुत बढ़िया महसूस कर रहा है, और बाकी सभी अब भी स्वास्थ्य-लाभ वार्ड में हैं\r\n- यह वस्तु देखने में मिट्टी के एक फूलदान जैसी लगती है\r\n- क्या यह किसी छलावरण रक्षा तंत्र का हिस्सा हो सकता है?\r\n- फूलदान के अंदर एक गहरा चिपचिपा पदार्थ है\r\n- यह चिपचिपा पदार्थ काम करने वाले अंगों का आकार ले सकता है\r\n- इस समय विषय की बुद्धिमत्ता का निर्धारण असंभव है\r\n- ARMM किट चलाते समय, चिपचिपा पदार्थ एक को छोड़कर बाकी सभी से चिपक जाता है\r\n- ARMM विद्युत प्रणाली में अस्थिरता के कारण प्रक्रिया रद्द कर दी गई\r\n",
    "ITEM_MONSTERSONSHRINEUSE_NAME": "विद्रोही छेनी",
    "ITEM_MONSTERSONSHRINEUSE_PICKUP": "किसी वेदी का उपयोग करने पर आस-पास दुश्मन बुलाए जाते हैं।",
    "ITEM_MONSTERSONSHRINEUSE_DESC": "किसी वेदी का उपयोग करने पर आस-पास <style=cIsHealth>दुश्मन</style> बुलाए जाते हैं। <style=cIsUtility>समय के साथ बढ़ता है।</style>",
    "ITEM_MONSTERSONSHRINEUSE_LORE": "लोककथा “Aphocles का स्तोत्र” से अंश:\r\n\r\n“...मूर्ति को कलाकार की रचनात्मक दृष्टि के अनुरूप तराशा गया था। सुंदर और शक्तिशाली, उसका भव्य संगमरमर का मुख चंद्रमा के समान दैदीप्यमान चमकता था। किंतु आम लोगों को कलाकार की दृष्टि समझ नहीं आई। मूर्ति को अपूर्ण घोषित करते हुए, एक साधारण मज़दूर ने अपनी छेनी उठाई और उस कृति को अपवित्र कर दिया, उसे सौंदर्य के अपने स्वार्थी विचारों के अनुसार गढ़ते हुए।\r\n\r\nअपने ही काम की प्रशंसा करते हुए, मज़दूर ने आत्मविश्वास से दावा किया कि उसने कला की सुंदरता को दस गुना बढ़ा दिया है। लेकिन कलाकार ने वे शब्द नहीं सुने। कलाकार ने केवल क्रोध अनुभव किया — उस मज़दूर पर क्रोध जिसने उसकी श्रेष्ठ कृति को दूषित किया था, और उन आम लोगों पर क्रोध जो उस मज़दूर का नायक की तरह गुणगान कर रहे थे।\r\n\r\nऔर ठीक वैसे ही जैसे मज़दूर उस अछूती मूर्ति की सुंदरता को नहीं पहचान पाया, वैसे ही वह अपने पैर के चारों ओर कसते हुए संगमरमर के टुकड़ों को भी नहीं पहचान पाया।”\r\n",
    "ITEM_RANDOMDAMAGEZONE_NAME": "चंचल मेरुदंड",
    "ITEM_RANDOMDAMAGEZONE_PICKUP": "यादृच्छिक रूप से शक्ति का क्षेत्र बनाएँ। क्षेत्र में मौजूद सभी पात्र अतिरिक्त क्षति पहुँचाते हैं।",
    "ITEM_RANDOMDAMAGEZONE_DESC": "पास के किसी यादृच्छिक स्थान पर शक्ति का एक क्षेत्र बनाता है जो <style=cIsUtility>16 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +50%)</style> के भीतर दुश्मनों और साथियों दोनों को सशक्त करता है, जिससे वे <style=cIsDamage>+50%</style> क्षति पहुँचाते हैं।",
    "ITEM_RANDOMDAMAGEZONE_LORE": "“मूल सूचना महामार्ग: रीढ़ की हड्डी। शरीर से मस्तिष्क तक का एक सीधा मार्ग, जो समस्त जीवन का अस्तित्व सुनिश्चित करने के लिए उत्तरदायी है। किंतु इसकी सीमा यह है कि यह अपने ही शरीर तक सीमित रहती है। क्या हो यदि — अंतर-कंप्यूटर वायरलेस नेटवर्क के विकास की तरह — किसी एक का तंत्रिका तंत्र दूसरे से संवाद कर सके? क्या हो यदि रीढ़ की हड्डी केवल शरीर से मन तक का ही मार्ग न बनाए, बल्कि ऐसा मार्ग बनाए जो अन्य शरीरों और मनों को भी आपस में जोड़ दे?”\r\n\r\n- Job Michaels के नोट्स, सीरियल किलर और सनकी वैज्ञानिक\r\n",
    "ITEM_ARTIFACTKEY_NAME": "पुरावशेष कुंजी",
    "ITEM_ARTIFACTKEY_PICKUP": "असीम शक्ति वाला एक पत्थर का टुकड़ा।",
    "ITEM_ARTIFACTKEY_DESC": "असीम शक्ति वाला एक पत्थर का टुकड़ा।",
    "ITEM_ARTIFACTKEY_LORE": "यह कुंजी अविश्वसनीय रूप से सरल है। पत्थर का एक अर्धचंद्र, जिस पर नंगी आँखों से बहुत कम विवरण दिखाई देता है। लेकिन यदि कोई दृष्टि से परे की दृष्टि से और क़रीब से देखे, तो उसे कुंजी के अस्तित्व पर खुदी हुई आकृतियाँ दिखाई दे सकती हैं। वे आकृतियाँ बहुत कुछ कहती हैं:\r\n\r\nकुंजी का कार्य: परित्यक्त खज़ाने के एक खोए हुए भंडार को खोलना।\r\n\r\nकुंजी के निर्माता: दो भाई, एक महत्वाकांक्षा से बना और दूसरा करुणा से।\r\n\r\nकुंजी की आशाएँ: कुंजी के भीतर, इसके मूल में गहराई से बसी हुई है बेहतर समय की एक स्मृति, और यह आशा कि एक दिन शायद चीज़ें फिर से बेहतर हो सकेंगी।\r\n\r\nकुंजी की वास्तविकता: यह कड़वा बोध कि ऐसी वास्तविकता केवल अतीत में ही मौजूद है।\r\n",
    "ITEM_CAPTAINDEFENSEMATRIX_NAME": "रक्षात्मक माइक्रोबॉट्स",
    "ITEM_CAPTAINDEFENSEMATRIX_PICKUP": "पास के प्रक्षेप्यों को मार गिराएँ। रिचार्ज दर हमले की गति के साथ बढ़ती है।",
    "ITEM_CAPTAINDEFENSEMATRIX_DESC": "हर <style=cIsDamage>0.5 सेकंड</style> में <style=cIsDamage>20 मीटर</style> के भीतर <style=cIsDamage>1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> प्रक्षेप्य को मार गिराएँ। <style=cIsUtility>रिचार्ज दर हमले की गति के साथ बढ़ती है</style>।",
    "ITEM_CAPTAINDEFENSEMATRIX_LORE": "“कैप्टन, सावधान!” \r\n\r\nवृद्ध व्यक्ति के किनारे से एक आवाज़ गूँजी। लेकिन वह जानता था कि वह किसी खतरे में नहीं है — एक हल्की चहचहाहट के साथ, उसके साथी माइक्रोबॉट्स सक्रिय हुए और उन्होंने गोली चलाकर उस आग के गोले को टुकड़ों में बिखेर दिया। बिल्कुल वैसे ही जैसे वे हर बार करते थे। \r\n\r\nतेज़ी से अपनी एड़ी पर घूमते हुए, वृद्ध ने अपनी शॉटगन दागी और एक फुर्तीले व ज़ोरदार धमाके के साथ उस लेमूरियन का सिर उड़ा दिया।\r\n\r\n“सिपाही, मेरी सुरक्षा से ज़्यादा अपनी सुरक्षा की चिंता करो।”\r\n",
    "ITEM_SCRAPWHITE_NAME": "वस्तु कबाड़, सफ़ेद",
    "ITEM_SCRAPWHITE_PICKUP": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर इसे प्राथमिकता दी जाती है।",
    "ITEM_SCRAPWHITE_DESC": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर इसे प्राथमिकता दी जाती है।",
    "ITEM_SCRAPWHITE_LORE": "“यद्यपि आधिकारिक रूप से लाइसेंस प्राप्त सामग्री की हमेशा सिफारिश की जाती है, फिर भी ज़रूरत पड़ने पर शौक़ीन लोग चीज़ें अपने हाथ में लेने के लिए जाने जाते हैं। क्या आपके पास मानक स्तर की सामग्री नहीं है? खुद बनाइए! पुराने पुर्ज़ों को रीसाइकल करना अपने प्रोजेक्ट्स के लिए सामग्री तैयार करने का एक मज़ेदार तरीका हो सकता है।”\r\n\r\n- परम शौक मार्गदर्शिका: किटबैशिंग और 3D प्रिंटिंग\r\n",
    "ITEM_SCRAPGREEN_NAME": "वस्तु कबाड़, हरा",
    "ITEM_SCRAPGREEN_PICKUP": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर इसे प्राथमिकता दी जाती है।",
    "ITEM_SCRAPGREEN_DESC": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर इसे प्राथमिकता दी जाती है।",
    "ITEM_SCRAPGREEN_LORE": "“यद्यपि आधिकारिक रूप से लाइसेंस प्राप्त सामग्री की हमेशा सिफारिश की जाती है, फिर भी ज़रूरत पड़ने पर शौक़ीन लोग चीज़ें अपने हाथ में लेने के लिए जाने जाते हैं। क्या आपके पास मानक स्तर की सामग्री नहीं है? खुद बनाइए! पुराने पुर्ज़ों को रीसाइकल करना अपने प्रोजेक्ट्स के लिए सामग्री तैयार करने का एक मज़ेदार तरीका हो सकता है।”\r\n\r\n- परम शौक मार्गदर्शिका: किटबैशिंग और 3D प्रिंटिंग\r\n",
    "ITEM_SCRAPRED_NAME": "वस्तु कबाड़, लाल",
    "ITEM_SCRAPRED_PICKUP": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर इसे प्राथमिकता दी जाती है।",
    "ITEM_SCRAPRED_DESC": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर इसे प्राथमिकता दी जाती है।",
    "ITEM_SCRAPRED_LORE": "“यद्यपि आधिकारिक रूप से लाइसेंस प्राप्त सामग्री की हमेशा सिफारिश की जाती है, फिर भी ज़रूरत पड़ने पर शौक़ीन लोग चीज़ें अपने हाथ में लेने के लिए जाने जाते हैं। क्या आपके पास मानक स्तर की सामग्री नहीं है? खुद बनाइए! पुराने पुर्ज़ों को रीसाइकल करना अपने प्रोजेक्ट्स के लिए सामग्री तैयार करने का एक मज़ेदार तरीका हो सकता है।”\r\n\r\n- परम शौक मार्गदर्शिका: किटबैशिंग और 3D प्रिंटिंग\r\n",
    "ITEM_SCRAPYELLOW_NAME": "वस्तु कबाड़, पीला",
    "ITEM_SCRAPYELLOW_PICKUP": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर इसे प्राथमिकता दी जाती है।",
    "ITEM_SCRAPYELLOW_DESC": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर इसे प्राथमिकता दी जाती है।",
    "ITEM_SCRAPYELLOW_LORE": "“यद्यपि आधिकारिक रूप से लाइसेंस प्राप्त सामग्री की हमेशा सिफारिश की जाती है, फिर भी ज़रूरत पड़ने पर शौक़ीन लोग चीज़ें अपने हाथ में लेने के लिए जाने जाते हैं। क्या आपके पास मानक स्तर की सामग्री नहीं है? खुद बनाइए! पुराने पुर्ज़ों को रीसाइकल करना अपने प्रोजेक्ट्स के लिए सामग्री तैयार करने का एक मज़ेदार तरीका हो सकता है।”\r\n\r\n- परम शौक मार्गदर्शिका: किटबैशिंग और 3D प्रिंटिंग\r\n",
    "ITEM_LUNARBADLUCK_NAME": "पवित्रता",
    "ITEM_LUNARBADLUCK_PICKUP": "अपने कौशल कूलडाउन 2 सेकंड घटाएँ। <color=#FF7F7F>आप अभागे हैं।</color>",
    "ITEM_LUNARBADLUCK_DESC": "सभी कौशल कूलडाउन <style=cIsUtility>2</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> सेकंड कम हो जाते हैं। सभी यादृच्छिक प्रभाव <style=cIsHealth>प्रतिकूल परिणाम</style> के लिए <style=cIsUtility>+1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> बार दोबारा आज़माए जाते हैं।",
    "ITEM_LUNARBADLUCK_LORE": "यह मिट्टी में तपती हुई तारा-बीज जैसा दिखता है।\r\nइसमें गरम पत्थर और लंबी घास की गंध आती है।\r\nइसका स्वाद मसालेदार फल जैसा है, मीठा और तीखा।\r\nयह सौर हवाओं और सौर घंटियों जैसा महसूस होता है।\r\nयह धूप में काँच के मेंढकों का पीछा करते दो भाइयों जैसा सुनाई देता है।\r\n",
    "ITEM_LUNARSECONDARYREPLACEMENT_NAME": "पाखंड के काँटे",
    "ITEM_LUNARSECONDARYREPLACEMENT_PICKUP": "अपने द्वितीयक कौशल को 'विदारक भँवर' से बदलें।",
    "ITEM_LUNARSECONDARYREPLACEMENT_DESC": "<style=cIsUtility>अपने द्वितीयक कौशल को</style> <style=cIsUtility>विदारक भँवर</style> से बदलें। \n\nएक ऐसा प्रक्षेप्य चार्ज करें जो पास के दुश्मनों को <style=cIsDamage>प्रति सेकंड 875% क्षति</style> पहुँचाता है, और <style=cIsUtility>3</style> सेकंड बाद फटकर <style=cIsDamage>700% क्षति</style> पहुँचाता है तथा दुश्मनों को <style=cIsUtility>3</style> <style=cStack>(हर अतिरिक्त प्रति पर +3)</style> सेकंड के लिए <style=cIsDamage>जकड़</style> देता है। 5 <style=cStack>(हर अतिरिक्त प्रति पर +5)</style> सेकंड बाद फिर से चार्ज होता है।",
    "ITEM_LUNARSECONDARYREPLACEMENT_LORE": "“…उसकी बाँहों को भयानक ब्लेडों में मरोड़ दिया गया, ताकि वह फिर कभी अध्ययन या कारीगरी का आनंद न ले सके…”\r\n\r\n-Kur-skan द हेरेटिक का अंग-विच्छेदन, IV\r\n",
    "ITEM_ATTACKSPEEDANDMOVESPEED_LORE": "ऑर्डर: टू-गो कॉफ़ी कप, 16 औंस\r\nट्रैकिंग नंबर: 32******\\r\nअनुमानित डिलीवरी: 05/04/2058\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: प्राकृतिक इतिहास संग्रहालय, Ninten Island, पृथ्वी\r\nशिपिंग विवरण:\nमेरा बेहतरीन काढ़ा। उम्मीद है रास्ते में खराब नहीं होगा। इसे दोबारा 176.23 डिग्री तक गरम करना याद रखना... तभी यह सबसे ताज़ा लगती है। जल्द मिलेंगे... कू।",
    "ITEM_PRIMARYSKILLSHURIKEN_NAME": "शुरिकेन",
    "ITEM_PRIMARYSKILLSHURIKEN_PICKUP": "अपना प्राथमिक कौशल सक्रिय करने पर एक शुरिकेन भी फेंका जाता है। समय के साथ फिर से चार्ज होता है।",
    "ITEM_PRIMARYSKILLSHURIKEN_DESC": "अपना <style=cIsUtility>प्राथमिक कौशल</style> सक्रिय करने पर एक <style=cIsDamage>शुरिकेन</style> भी फेंका जाता है जो <style=cIsDamage>400%</style> <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> आधार क्षति पहुँचाता है। आप अधिकतम <style=cIsUtility>3</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> <style=cIsDamage>शुरिकेन</style> रख सकते हैं जो सभी <style=cIsUtility>10</style> सेकंड में फिर से लोड होते हैं।",
    "ITEM_PRIMARYSKILLSHURIKEN_LORE": "ऑर्डर: एल्युमीनियम फेंकने वाला तारा\r\nट्रैकिंग नंबर: 77******\r\nअनुमानित डिलीवरी: 05/15/2060\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: Sensei Dareth का मोजो डोजो, पृथ्वी\r\nशिपिंग विवरण:\n\nआखिरी बार कह रहा हूँ, शुरिकेन फेंकते समय \"हियाह!\" चिल्लाने से तुम्हारे नतीजे बेहतर नहीं होंगे। इससे बस तुम्हारी जगह का पता चल जाता है... समझे न, एक निंजा जो चाहता है उसका ठीक उल्टा।\n\nहालाँकि, तुम मन ही मन \"हियाह!\" कह सकते हो। (मैं भी कहता हूँ।)",
    "ITEM_CRITDAMAGE_NAME": "लेज़र स्कोप",
    "ITEM_CRITDAMAGE_PICKUP": "आपके 'क्रिटिकल वार' अतिरिक्त 100% क्षति पहुँचाते हैं।",
    "ITEM_CRITDAMAGE_DESC": "<style=cIsDamage>क्रिटिकल वार</style> अतिरिक्त <style=cIsDamage>100% क्षति </style><style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> पहुँचाते हैं।",
    "ITEM_CRITDAMAGE_LORE": "ऑर्डर: लेज़र ऐडऑन सहित स्कोप\r\nट्रैकिंग नंबर: 21******\r\nअनुमानित डिलीवरी: 03/22/2060\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: Royal Drive, Bubble Station, मंगल ग्रह\r\nशिपिंग विवरण:\n\nमेरी पिछली खेप के मुक़ाबले यह एक उन्नत मॉडल है, इसमें पिछले मॉडल की सारी खूबियाँ हैं और साथ ही निशाना साधने में मदद के लिए एक शानदार नया लेज़र पॉइंटर भी है।\n\nऔर, तुम्हें जानते हुए, जब तुम गोली चलाने से पहले वे शानदार कलाबाज़ियाँ करते हो, तो यह तुम्हारे लक्ष्यों की आँखें चौंधिया सकता है। मानना पड़ेगा, पिछला वीडियो वाकई कमाल का था... बस यूनियन को इसके बारे में पता न चलने पाए। अगर उन्होंने तुम्हें इससे खेलते हुए पकड़ लिया, तो सिर्फ़ लाइसेंस से ज़्यादा बहुत कुछ गँवा बैठोगे।",
    "ITEM_DRONEWEAPONS_NAME": "अतिरिक्त ड्रोन पुर्ज़े",
    "ITEM_DRONEWEAPONS_PICKUP": "आपके ड्रोन तेज़ी से गोली चलाते हैं, उनका कूलडाउन कम होता है, वे मिसाइल दागते हैं, और उन्हें एक अतिरिक्त चेनगन मिलती है।",
    "ITEM_DRONEWEAPONS_DESC": "<style=cIsDamage>कर्नल ड्रोनमैन</style> पाएँ। \nड्रोन को <style=cIsDamage>+25%</style> <style=cStack>(हर अतिरिक्त प्रति पर +25%)</style> हमले की गति और कूलडाउन में कमी मिलती है। \nड्रोन को प्रहार पर <style=cIsDamage>मिसाइल</style> दागने की <style=cIsDamage>10%</style> संभावना मिलती है, जो <style=cIsDamage>150%</style> कुल क्षति पहुँचाती है। \nड्रोन को एक <style=cIsDamage>स्वचालित चेनगन</style> मिलती है जो <style=cIsDamage>6x50%</style> क्षति पहुँचाती है और <style=cIsDamage>2</style> दुश्मनों तक उछलती है।",
    "ITEM_DRONEWEAPONS_LORE": "<style=cMono>//--UES [संपादित] से स्वतः प्रतिलेखन --//</style>\n\n\"वे नए ड्रोन मॉडल देखे जो उन्होंने हमारे लिए मंज़ूर किए हैं? सच कहूँ तो कभी नहीं सोचा था कि इन्हें सामने से देख पाऊँगा।\"\n\n\"हाँ, बिल्कुल। ऐसी तकनीक तक तो सिर्फ़ बड़े अफ़सरों की पहुँच होती थी... इससे सोच में पड़ जाता हूँ कि आखिर हमारा सामना किससे होने वाला है। मेरा मतलब है, कहानियाँ तो सबने सुनी हैं, पर...\"\n\n\"अरे, मैं चिंता नहीं करता। आखिरकार, तुम मेरे दोस्त Jim को जानते हो न?\"\n\n\"हार्डवेयर वाला?\"\n\n\"हाँ, वही। यार, वह एकदम जीनियस है, सच बता रहा हूँ। वह जिस भी दूसरी शाखा में काम करता था, वहाँ से उसे \"कंपनी की संपत्ति में अवैध बदलाव\" और \"नागरिकों के लिए कानूनी सीमा से परे हथियार प्रणालियाँ\" बनाने के कारण निकाल दिया गया था।\"\n\n\"हूँ। कमाल है।\"\n\n\"हम्म। मैंने इस मिशन के लिए उसकी सिफारिश की थी, क्योंकि मुझे लगा था कि हमें जो कुछ हाथ लगे सबकी ज़रूरत पड़ेगी... किस्मत से कैप्टन ने उसकी प्रतिभा पहचान ली। मैं बस, उम्म...\"\n\n[वर्कशॉप 23-B में आग लगने के साथ ही फ़ायर अलार्म बजने लगते हैं। बज़सॉ से लैस ड्रोन गलियारे में तकनीशियनों का पीछा कर रहे हैं]\n\n\"...उम्मीद है उन्हें शोर से ज़्यादा दिक्कत नहीं होगी।\"",
    "ITEM_MOVESPEEDONKILL_NAME": "शिकारी का हार्पून",
    "ITEM_MOVESPEEDONKILL_PICKUP": "दुश्मन को मारने पर आपको चलने की गति का तेज़ उछाल मिलता है।",
    "ITEM_MOVESPEEDONKILL_DESC": "दुश्मन को मारने पर <style=cIsUtility>चलने की गति</style> <style=cIsUtility>125%</style> बढ़ जाती है, जो <style=cIsUtility>1</style> <style=cStack>(हर अतिरिक्त प्रति पर +0.5)</style> सेकंड में धीरे-धीरे घट जाती है।",
    "ITEM_MOVESPEEDONKILL_LORE": "ऑर्डर: हार्पून\r\nट्रैकिंग नंबर: 01******\r\nअनुमानित डिलीवरी: 07/21/2058\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: Saint Mary's Port, Keelhaul Key\r\nशिपिंग विवरण:\nकहते हैं कि इस पुरानी प्यारी चीज़ के एक ही वार से तुम दो शिकार एक साथ भेद सकते हो। और अरे, अगर न भी कर पाओ, तो अगर तुम काफ़ी तेज़ हो तो कोई फ़र्क नहीं जान पाएगा! वाहहाहा!",
    "ITEM_STRENGTHENBURN_NAME": "प्रज्वलन टैंक",
    "ITEM_STRENGTHENBURN_PICKUP": "आपके आग लगाने के प्रभाव चौगुनी क्षति पहुँचाते हैं।",
    "ITEM_STRENGTHENBURN_DESC": "आग लगाने के प्रभाव समय के साथ <style=cIsDamage>+300%</style> <style=cStack>(हर अतिरिक्त प्रति पर +300%)</style> अधिक क्षति पहुँचाते हैं।",
    "ITEM_STRENGTHENBURN_LORE": "ऑर्डर: 128 औंस गैस टैंक\r\nट्रैकिंग नंबर: 33******\r\nअनुमानित डिलीवरी: 05/8/2058\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: Death Valley, पृथ्वी\nशिपिंग विवरण: इसमें आकाशगंगा के सबसे ज्वलनशील पदार्थों का मिश्रण है। समझे न, मीथेन, एथिलीन, ब्यूटेन... एक अकेली चिंगारी इस चीज़ को उड़ाने के लिए काफ़ी से भी ज़्यादा होगी!\n\nअरे, एक मिनट रुकना। यह लिखते-लिखते ही इसमें अपने आप आग लग गई। रास्ते में जल जाने की स्थिति के लिए मैं तुम्हें एक नया भेज दूँगा, ऐसा अक्सर होता रहता है!",
    "ITEM_HEALINGPOTION_NAME": "शक्ति अमृत",
    "ITEM_HEALINGPOTION_PICKUP": "कम स्वास्थ्य पर तुरंत उपचार पाएँ। उपयोग पर समाप्त हो जाता है।",
    "ITEM_HEALINGPOTION_DESC": "<style=cIsHealth>25% स्वास्थ्य</style> से नीचे क्षति झेलने पर यह वस्तु <style=cIsUtility>उपयोग होकर समाप्त हो जाती है</style>, जिससे आपके <style=cIsHealing>अधिकतम स्वास्थ्य</style> के <style=cIsHealing>75%</style> के बराबर आपका <style=cIsHealing>उपचार</style> होता है।",
    "ITEM_HEALINGPOTION_LORE": "ऑर्डर: 16 औंस फ़्लास्क, उपचार औषधि (मेरी सबसे शक्तिशाली नहीं)\r\nट्रैकिंग नंबर: 10******\r\nअनुमानित डिलीवरी: 12/31/2058\r\nशिपिंग विधि: प्राथमिकता\r\nशिपिंग पता: कार्गो बे 10-C, टर्मिनल 504-B, UES Port Trailing Comet\nशिपिंग विवरण: \n- विषय: औषधि विक्रेता, मैं युद्ध में जा रहा हूँ। मुझे तुम्हारी सबसे शक्तिशाली औषधियाँ चाहिए।\n\nमेरी औषधियाँ तुम्हारे लिए बहुत शक्तिशाली हैं, ख़रीदार। इसके बजाय मैंने तुम्हें एक हल्का काढ़ा भेजा है। मेरी सबसे शक्तिशाली औषधियाँ इंसान तो क्या, एक ड्रैगन को भी मार डालेंगी!",
    "ITEM_HEALINGPOTIONCONSUMED_NAME": "खाली बोतल",
    "ITEM_HEALINGPOTIONCONSUMED_PICKUP": "अमृत का एक खाली पात्र। कुछ नहीं करता।",
    "ITEM_HEALINGPOTIONCONSUMED_DESC": "अमृत का एक खाली पात्र। कुछ नहीं करता।",
    "ITEM_PERMANENTDEBUFFONHIT_NAME": "सहजीवी बिच्छू",
    "ITEM_PERMANENTDEBUFFONHIT_PICKUP": "प्रहार पर कवच को स्थायी रूप से घटाएँ।",
    "ITEM_PERMANENTDEBUFFONHIT_DESC": "प्रहार पर <style=cIsDamage>100%</style> संभावना है कि दुश्मन का <style=cIsDamage>कवच</style> <style=cIsDamage>स्थायी रूप से</style> <style=cIsDamage>2</style> <style=cStack>(हर अतिरिक्त प्रति पर +2)</style> घट जाए।",
    "ITEM_PERMANENTDEBUFFONHIT_LORE": "\"अपने दुश्मन को हराने के अनगिनत तरीके हैं। तुम उन्हें गोली मार सकते हो। उन्हें मुक्का मार सकते हो। उन्हें पीट सकते हो, कुचल सकते हो, शोरबे में उबाल सकते हो, सूची लंबी है। लेकिन यार, एक बात जो मुझे सच में हँसाती है...? बिल्कुल सही:\n\nउन्हें बिच्छुओं के ढेर के नीचे दफ़न कर देना।\"\n\n\"तुम्हारा दिमाग़ ख़राब हो गया है, Bill।\"\n\n- सिग्नल की प्रतिध्वनियाँ, UES Contact Light",
    "ITEM_MOREMISSILE_NAME": "पॉकेट I.C.B.M.",
    "ITEM_MOREMISSILE_PICKUP": "सभी मिसाइल वस्तुएँ अधिक क्षति पहुँचाती हैं और दो अतिरिक्त मिसाइलें दागती हैं।",
    "ITEM_MOREMISSILE_DESC": "सभी मिसाइल वस्तुएँ और उपकरण <style=cIsDamage>2</style> अतिरिक्त <style=cIsDamage>मिसाइलें</style> दागते हैं। मिसाइल क्षति में <style=cIsDamage>0%</style> <style=cStack>(हर अतिरिक्त प्रति पर +50%)</style> की वृद्धि करें।",
    "ITEM_MOREMISSILE_LORE": "\"एक मिसाइल से बेहतर क्या है...? और अधिक मिसाइलें। आसान है, बस ढेर सारी मिसाइलें दाग दो और जिससे भी लड़ रहे हो उसे सुलगते गड्ढों के मैदान में बदल दो। दुश्मन देश? मिसाइलें। कोई मूर्ख पक्षी चिढ़ा रहा है? मिसाइलें। पारिवारिक बहस बिगड़ रही है? बिल्कुल सही - मिसाइलें! ऐसा कुछ नहीं जो एक मिसाइल न कर सके, और जो थोड़ा-बहुत एक मिसाइल से न हो पाए, वह ढेर सारी मिसाइलें कर देंगी।\"\n\nसंपादक की टिप्पणी: अरे, शायद हमें इसे संपादित करके हटा देना चाहिए? जिनेवा संधियों के अनुसार क्लस्टर बम अब भी प्रतिबंधित हैं... और लोगों को अपने परिवार वालों पर परमाणु हमला करने के लिए उकसाना शायद लक्षित पाठकों को पसंद नहीं आएगा।\n\nJans Czar की आत्मकथा, आधुनिक शस्त्रों के सम्राट, प्रथम प्रारूप",
    "ITEM_SKULLCOUNTER_NAME": "खोपड़ी टोकन",
    "ITEM_SKULLCOUNTER_PICKUP": "एक विशेष प्रकार के वध का प्रमाण। इसका अपना कोई सीधा प्रभाव नहीं है।",
    "ITEM_SKULLCOUNTER_DESC": "एक विशेष प्रकार के वध का प्रमाण। इसका अपना कोई सीधा प्रभाव नहीं है।",
    "ITEM_ROBOBALLBUDDY_NAME": "सहानुभूति कोर",
    "ITEM_ROBOBALLBUDDY_PICKUP": "Solus Probes की एक जोड़ी भर्ती करें जो अधिक साथियों के होने पर और शक्तिशाली हो जाती है।",
    "ITEM_ROBOBALLBUDDY_DESC": "हर 30 सेकंड में, <style=cIsUtility>दो Solus Probes को बुलाएँ</style> जिन्हें आपकी <style=cIsUtility>टीम के प्रत्येक साथी</style> के लिए <style=cIsDamage>+100%</style> <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> अतिरिक्त क्षति मिलती है।",
    "ITEM_ROBOBALLBUDDY_LORE": "13006; प्रोब कोर इंस्टेंस अनुरोध पहचाना गया\r\n13006; संग्रहीत मॉडलों के लिए प्रोब कोर इंस्टेंस अवलोकन:\r\n;SER ID> 04534098130\r\n;INST> खनन प्रोब इंस्टेंस\r\n;मुख्य बिंदु\r\n> यह वाला पूरी तरह मृत और पीला है\r\n> यह वाला बहुत साहसी, हरा और अकेला है\r\n> यह वाला पूरी तरह मृत और पीला है\r\n> यह वाला पूरी तरह मृत और पीला है\r\n> यह वाला पूरी तरह मृत और पीला है\r\n> यह वाला पूरी तरह मृत और पीला है\r\n> यह वाला पूरी तरह मृत और पीला है\r\n> यह वाला बहुत ठंडा, लाल और अकेला है\r\n\r\n13010; कोर डॉक किए जा रहे हैं\r\n13011; तैनात\r\n",
    "ITEM_PARENTEGG_NAME": "प्लैनुला",
    "ITEM_PARENTEGG_PICKUP": "हमला होने पर निश्चित मात्रा में उपचार पाएँ।",
    "ITEM_PARENTEGG_DESC": "<style=cIsDamage>आने वाली क्षति</style> से <style=cIsHealing>15<style=cStack> (हर अतिरिक्त प्रति पर +15)</style></style> स्वास्थ्य का उपचार पाएँ।",
    "ITEM_PARENTEGG_LORE": "\"हाँ – अंडा। ग्रैंडपैरेंट अंडों को सेता है।\"\r\n\r\n\"और चाइल्ड?\"\r\n\r\n\"चाइल्ड अंडा देता है।\"\r\n\r\n\"और अंडा क्या बनता है…?\"\r\n\r\n\"पैरेंट।\"\r\n\r\n\"ठीक है। और पैरेंट क्या करता है?\"\r\n\r\n\"चाइल्ड – और ग्रैंडपैरेंट की देखभाल करता है।\"\r\n\r\n\"और ग्रैंडपैरेंट सबसे छोटा है?\"\r\n\r\n\"चाइल्ड से छोटा, हाँ। लेकिन सबसे छोटा नहीं।\"\r\n\r\n\"सबसे छोटा कौन है?\"\r\n\r\n\"पैरेंट।\"\r\n\r\n\"…\"\r\n",
    "ITEM_LUNARSPECIALREPLACEMENT_NAME": "पाखंड का सार",
    "ITEM_LUNARSPECIALREPLACEMENT_PICKUP": "अपने विशेष कौशल को 'विनाश' से बदलें।",
    "ITEM_LUNARSPECIALREPLACEMENT_DESC": "<style=cIsUtility>अपने विशेष कौशल</style> को <style=cIsUtility>विनाश</style> से बदलें। \n\nक्षति पहुँचाने पर 10 <style=cStack>(हर अतिरिक्त प्रति पर +10)</style> सेकंड के लिए <style=cIsDamage>विनाश</style> का एक संचय जुड़ता है। कौशल सक्रिय करने पर असीमित दूरी से सभी विनाश संचयों में <style=cIsDamage>विस्फोट</style> होता है, जिससे <style=cIsDamage>300% क्षति</style> तथा <style=cIsDamage>विनाश के प्रत्येक संचय पर 120% अतिरिक्त क्षति</style> पहुँचती है। 8 <style=cStack>(हर अतिरिक्त प्रति पर +8)</style> सेकंड बाद पुनः चार्ज होता है।",
    "ITEM_LUNARSPECIALREPLACEMENT_LORE": "“…और उसका हृदय, जो अत्यंत दुष्ट और घृणा से भरा था, वहीं छोड़ दिया गया जहाँ वह कभी खड़ी थी – उसके विश्वासघात के स्थान पर।”\r\n\r\n-पाखंडी Kur-skan का अंगभंग, VI\r\n",
    "ITEM_HALFSPEEDDOUBLEHEALTH_NAME": "शिला प्रवाह स्कंधरक्षक",
    "ITEM_HALFSPEEDDOUBLEHEALTH_PICKUP": "अपना स्वास्थ्य दोगुना करें... <color=#FF7F7F>परंतु अपनी गति आधी कर दें।</color>\n",
    "ITEM_HALFSPEEDDOUBLEHEALTH_DESC": "<style=cIsHealing>अधिकतम स्वास्थ्य</style> <style=cIsHealing>100% <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style></style> बढ़ाएँ। <style=cIsUtility>चलने की गति</style> <style=cIsUtility>50%</style> <style=cStack>(हर अतिरिक्त प्रति पर +50%)</style> घटाएँ।",
    "ITEM_HALFSPEEDDOUBLEHEALTH_LORE": "\"पृथ्वी की भाँति तुम्हें सुदृढ़ और अडिग होना होगा। तन और मन दोनों से पूर्णतः अचल। अपने शत्रु की तलवार से मत डरो, कल्पना करो कि वह तुम्हारी त्वचा से टकराकर चकनाचूर हो रही है। ध्यान केंद्रित करो और इसे सत्य बनाओ। लुढ़कते हिमस्खलन से मत डरो, कल्पना करो कि वह तुम्हारी इच्छा के आगे झुक रहा है। किंतु सावधान रहो, और बिना कारण युद्ध मत करो। जो एक ही स्थान पर जड़ बने रहते हैं, वे शीघ्र ही स्वयं को अकेला पाते हैं।\"\r\n\r\n-युद्ध की इच्छाशक्ति, प्रथम अंश",
    "ITEM_HALFATTACKSPEEDHALFCOOLDOWNS_NAME": "प्रकाश प्रवाह स्कंधरक्षक",
    "ITEM_HALFATTACKSPEEDHALFCOOLDOWNS_PICKUP": "अपने कूलडाउन आधे करें.. <color=#FF7F7F>परंतु अपनी हमले की गति आधी कर दें।</color>\n",
    "ITEM_HALFATTACKSPEEDHALFCOOLDOWNS_DESC": "<style=cIsUtility>कौशल कूलडाउन</style> <style=cIsUtility>50% <style=cStack>(हर अतिरिक्त प्रति पर +50%)</style></style> घटाएँ। <style=cIsDamage>हमले की गति</style> <style=cIsDamage>50%</style> <style=cStack>(हर अतिरिक्त प्रति पर +50%)</style> घटाएँ।",
    "ITEM_HALFATTACKSPEEDHALFCOOLDOWNS_LORE": "\"पवन हम सबका मार्गदर्शन करता है। पवन का गीत सुनो और उसके निर्देश के अनुसार नृत्य करो। तुम पाओगे कि तुम हर प्रहार से बच निकलोगे, हर वार का उत्तर दोगे। तुम पाओगे कि पवन तुम्हें ऊपर उठा लेगा और पतझड़ के गिरे पत्ते की तरह स्वतंत्र बना देगा। किंतु सावधान रहो, और पवन में स्वयं को मत खो दो। भागना एक कारगर विकल्प है, यद्यपि अंततः तुम पाओगे कि भागने के लिए कोई स्थान शेष नहीं बचा है।\"\r\n\r\n-युद्ध की इच्छाशक्ति, द्वितीय अंश",
    "ITEM_LUNARWINGS_NAME": "Terafirmae का आशीर्वाद",
    "ITEM_LUNARWINGS_PICKUP": "प्लेसहोल्डर संग्रह विवरण",
    "ITEM_LUNARWINGS_DESC": "प्लेसहोल्डर विवरण",
    "ITEM_LUNARWINGS_LORE": "एक प्राचीन पक्षी-जाति का अवशेष: कहा जाता है कि उन्होंने नई कृषि सभ्यताएँ स्थापित करने के लिए उड़ान का वरदान त्याग दिया था, ताकि अपने मरते हुए ग्रह की निरंतर बदलती जलवायु का सामना करने के लिए वे अपनी शक्ति और संख्या बढ़ा सकें।",
    "ITEM_RANDOMLYLUNAR_NAME": "शोकगीत शून्य",
    "ITEM_RANDOMLYLUNAR_PICKUP": "वस्तुओं और उपकरणों के बजाय एक चंद्र वस्तु में बदलने की थोड़ी संभावना होती है।",
    "ITEM_RANDOMLYLUNAR_DESC": "वस्तुओं के बजाय <style=cIsLunar>चंद्र</style> वस्तु बनने की <style=cIsUtility>5% <style=cStack>(हर अतिरिक्त प्रति पर +5%)</style></style> संभावना होती है।",
    "ITEM_RANDOMLYLUNAR_LORE": "<style=cMono>\r\nआध्यात्मिक युद्ध के विजेताओं के लिए एक शोकगीत:\r\nयह मेरी ओर से तुम्हारे लिए एक संदेश है।</style>\r\n\r\nहालाँकि जीवन में तुम लड़खड़ाओगे, हकलाओगे और गिरोगे - हालाँकि तुम अपने प्रियजनों को खो दोगे और इतने आँसू बहाओगे जितने तुम्हारी आँखें भी न सँभाल सकें - समय के साथ तुम उन ग्रहों पर शांति पा सकते हो जिन्हें तुम घर कहते हो। एक छोटा प्राणी जो चुपचाप तुम्हारी प्रतीक्षा कर रहा है, किसी दूसरी धारा से मुस्कुराता एक चेहरा, वह सन्नाटा जब तुम नए मौसम की सुगंध साँसों में भरते हो।\r\nअपने हृदय को तुम्हें याद दिलाने दो कि तुम यहाँ क्यों हो; उसे कुछ नया और कुछ पुराना बताने दो। मन याद रखता है, परंतु हृदय जानता है।\r\nमैं स्वयं से प्रेम करता हूँ ताकि मैं तुमसे भी प्रेम कर सकूँ - मैं पहले भी गायब हो जाना चाहता था, लेकिन मैं हमेशा तुम्हें देखने लौटना चाहता था। घास और पत्तियाँ, सूरज की गर्माहट और रात के कीट। \r\n\r\nमैंने स्वयं से वादा किया था, और मैं तुमसे वादा करता हूँ: \r\n\r\nविजय संचित हानि का प्रतिफल है, जो सुरंग के अंत में प्रकाश की तरह सदैव विद्यमान रहती है। मृत्यु में भी नए जीवन का अवशिष्ट वादा है - जो सदैव इस चक्र को दोहराने के लिए अभिशप्त है।\r\n\r\nअँधेरा हो रहा है। यदि तुम भटक जाओ तो कोई बात नहीं, फ़िलहाल के लिए। आशा है कि तुम टूटते तारों का आनंद लोगे। शांति से विश्राम करो।",
    "ITEM_IMMUNETODEBUFF_NAME": "Ben का रेनकोट",
    "ITEM_IMMUNETODEBUFF_PICKUP": "नकारात्मक प्रभावों को रोकें, और बदले में अस्थायी अवरोध पाएँ। समय के साथ पुनः चार्ज होता है।",
    "ITEM_IMMUNETODEBUFF_DESC": "<style=cIsUtility>1 <style=cStack>(हर अतिरिक्त प्रति पर +1)</style></style> <style=cIsDamage>नकारात्मक प्रभाव</style> को रोकता है और इसके बजाय <style=cIsHealing>अधिकतम स्वास्थ्य</style> के <style=cIsHealing>10%</style> के बराबर <style=cIsHealing>अस्थायी अवरोध</style> प्रदान करता है। हर <style=cIsUtility>5</style> सेकंड में पुनः चार्ज होता है।",
    "ITEM_IMMUNETODEBUFF_LORE": "वापसी: Gorton पुरुष रेन जैकेट (मध्यम, पीला)\r\nट्रैकिंग नंबर: 73***********\r\nअनुमानित डिलीवरी: 03/04/2053\r\nशिपिंग विधि:  मानक\r\nशिपिंग पता: 545 Matthaios Blvd., Gloucester, पृथ्वी\r\nवापसी का कारण: \n\nजैकेट अपने आप में ठीक है, लेकिन किसी वजह से यहाँ के बहुत-से छात्र मेरे इसे पहनने पर बड़ा अजीब बर्ताव करने लगे। वे लगातार मुझसे इसे उतारने को कहते रहते हैं क्योंकि एक दूसरा लड़का, Ben, पीली जैकेट पहनता है। शायद यह उसकी पहचान जैसा कुछ है।\n\nरिफंड:\nबदलें:  X\n\nअतिरिक्त टिप्पणियाँ:\n\nकृपया बदले में नीले रंग की जैकेट भेजें।",
    "ITEM_REGENERATINGSCRAP_NAME": "पुनर्जनन स्क्रैप",
    "ITEM_REGENERATINGSCRAP_PICKUP": "<style=cIsHealing>असामान्य</style> 3D प्रिंटर के साथ उपयोग करने पर प्राथमिकता मिलती है। प्रति चरण एक बार उपयोग योग्य।",
    "ITEM_REGENERATINGSCRAP_DESC": "कुछ नहीं करता। <style=cIsHealing>असामान्य</style> 3D प्रिंटर के साथ उपयोग करने पर प्राथमिकता मिलती है। प्रत्येक चरण की शुरुआत में यह पुनः उत्पन्न हो जाता है।",
    "ITEM_REGENERATINGSCRAP_LORE": "<style=cMono>//--UES [संपादित] से स्वचालित प्रतिलेखन --//</style>\n\n\"अरे Joe, इंजीनियरिंग में काम कैसा चल रहा है?\"\n\n\"भयानक। हमारे पास इस... अजीब प्रोटोटाइप पदार्थ की एक खेप आई है। कोई धातु है शायद? वे चाहते हैं कि हम इससे सामान बनाएँ, जो उतना बुरा नहीं है। बात यह है कि मैं जितना भी निकालूँ, हमेशा और ज़्यादा दिखता है। क्या तुम्हें पता है मैंने 10 किलो धातु के बक्से से .300 कैलिबर की दो हज़ार पाँच सौ गोलियाँ बना डालीं?\"\n\n\"कितनी!?\"\n\n\"सच में!? मुझे लग रहा है मेरा दिमाग़ घूम रहा है। वह अभी आधा भी खाली नहीं हुआ। अरे, मैं शर्त लगाता हूँ कि उसमें शुरुआत से भी ज़्यादा माल बचा है!\"\n\n\"चलो, कम से कम ख़त्म होने की चिंता तो नहीं करनी पड़ेगी...\"",
    "ITEM_REGENERATINGSCRAPCONSUMED_NAME": "पुनर्जनन स्क्रैप (उपयोग किया गया)",
    "ITEM_REGENERATINGSCRAPCONSUMED_PICKUP": "प्रत्येक चरण की शुरुआत में, यह पुनर्जनन स्क्रैप में बदल जाता है।",
    "ITEM_REGENERATINGSCRAPCONSUMED_DESC": "प्रत्येक चरण की शुरुआत में, यह पुनर्जनन स्क्रैप में बदल जाता है।",
    "ITEM_CRITGLASSESVOID_NAME": "खोए हुए द्रष्टा के लेंस",
    "ITEM_CRITGLASSESVOID_PICKUP": "गैर-बॉस दुश्मन को तुरंत मारने की 0.5% संभावना पाएँ। <style=cIsVoid>सभी 'लेंस बनाने वाले का चश्मा' को भ्रष्ट कर देता है</style>।",
    "ITEM_CRITGLASSESVOID_DESC": "आपके हमलों में किसी <style=cIsDamage>गैर-बॉस दुश्मन</style> को <style=cIsDamage>तुरंत मारने</style> की <style=cIsDamage>0.5%</style> <style=cStack>(हर अतिरिक्त प्रति पर +0.5%)</style> संभावना होती है। <style=cIsVoid>सभी 'लेंस बनाने वाले का चश्मा' को भ्रष्ट कर देता है</style>।",
    "ITEM_CRITGLASSESVOID_LORE": "\"देखने का क्या अर्थ है?\n\nकिसी पशु के लिए, इसका अर्थ है संभावित भोजन और साथी की पहचान करना। वंश बढ़ाना, जीवित रहना। दृष्टि केवल लक्ष्य तक पहुँचने का एक साधन है, है न?\n\nमेरे जैसे किसी व्यक्ति के लिए... उनके लिए जो सच्चा उद्देश्य जानते हैं... देखना ही जीना है। देखने का अर्थ है शत्रु के कवच में उस एक छोटी दरार को भाँप लेना, उस सूक्ष्मतम हिचकिचाहट के क्षण को देख लेना जब वह प्रहार करने के लिए पीछे झुकता है।\n\nयह देखना कि जब खोपड़ी तुम्हारे हथियार के आगे टूटती है तो मांस कैसे मुड़ता है।\n\nहाँ, ये छोटी-छोटी बातें हैं, लेकिन इन चीज़ों को देखना... सचमुच देखना। आह, यह तुम्हें पूर्ण कर देता है। मैं आशा करता हूँ कि तुम समझते हो... और यदि नहीं, तो यदि तुमने यह लेख पढ़ा है तो अंततः समझ जाओगे।\"\n\n- खोई हुई डायरी, Petrichor V से बरामद",
    "ITEM_EXPLODEONDEATHVOID_NAME": "वॉइड-प्रेषित ज्वाला",
    "ITEM_EXPLODEONDEATHVOID_PICKUP": "पूर्ण स्वास्थ्य वाले दुश्मन प्रहार लगने पर फट जाते हैं। <style=cIsVoid>सभी 'छलावा ज्योति' को भ्रष्ट कर देता है</style>।",
    "ITEM_EXPLODEONDEATHVOID_DESC": "<style=cIsDamage>100% स्वास्थ्य</style> या उससे अधिक वाले दुश्मन पर प्रहार करने पर, उसे <style=cIsDamage>12 मीटर</style> <style=cStack>(हर अतिरिक्त प्रति पर +2.4 मीटर)</style> के दायरे में <style=cIsDamage>विस्फोटित</style> करें, जिससे <style=cIsDamage>260%</style> <style=cStack>(हर अतिरिक्त प्रति पर +156%)</style> आधार क्षति पहुँचती है। <style=cIsVoid>सभी 'छलावा ज्योति' को भ्रष्ट कर देता है</style>।",
    "ITEM_EXPLODEONDEATHVOID_LORE": "========================================\n====   MyBabel मशीनी अनुवादक   ====\n====     [संस्करण 12.45.1.009 ]   ======\n========================================\nप्रशिक्षण... <100000000 चक्र>\nप्रशिक्षण... <100000000 चक्र>\nप्रशिक्षण... <100000000 चक्र>\nप्रशिक्षण... <102515 चक्र>\nपूर्ण!\nपरिणाम प्रदर्शित करें? हाँ/नहीं\nहाँ\n========================================\n\nहम सूखी टहनियाँ लेते हैं और उन्हें आग में डालते हैं।\n\nआग प्रसन्न होती है। आग बढ़ती है।\n\nहम फल लेते हैं और उन्हें आग में डालते हैं।\n\nआग को यह उपहार बहुत भाता है। आग से चिंगारियाँ उछलती हैं और बुझने से पहले आनंद का नृत्य करती हैं। फल के भीतर के यौगिक टूटकर अपने मूल तत्वों में लौट जाते हैं। कितने सारे रंग हैं। कितनी सारी ऊर्जा है।\n\nहम एक शरीर लेते हैं और उसे आग में डाल देते हैं। उसकी कमी नहीं खलेगी। उसके पास और भी बहुत हैं।\n\nआग को यह उपहार बहुत भाता है। शरीर की चर्बी जलती है और लपटों में सुंदर रंगों का इंद्रधनुष रचती है। कुतरती हुई गर्मी से उत्तेजित होकर मांसपेशियाँ सिकुड़ती और चटकती हैं। आग अपना भोजन ग्रहण करती है और उसे ऊर्जा में बदल देती है।\n\nइतनी सारी ऊर्जा। मुझे विश्वास है मैं इसके साथ काम कर सकता हूँ।",
    "ITEM_BLEEDONHITVOID_NAME": "सुई-दंश",
    "ITEM_BLEEDONHITVOID_PICKUP": "प्रहार पर दुश्मनों को ध्वस्त करने की संभावना। <style=cIsVoid>सभी 'तीन नोकों वाला खंजर' को भ्रष्ट कर देता है</style>।",
    "ITEM_BLEEDONHITVOID_DESC": "दुश्मन को <style=cIsDamage>ध्वस्त</style> करने की <style=cIsDamage>10%</style> <style=cStack>(हर अतिरिक्त प्रति पर +10%)</style> संभावना, जिससे <style=cIsDamage>400%</style> आधार क्षति पहुँचती है। <style=cIsVoid>सभी 'तीन नोकों वाला खंजर' को भ्रष्ट कर देता है</style>।",
    "ITEM_BLEEDONHITVOID_LORE": "<style=cMono>DataScraper (v3.1.53 – बीटा शाखा) में स्वागत है\n$ स्मृति खंगाली जा रही है... पूर्ण।\n$ समाधान किया जा रहा है... पूर्ण।\n$ प्रासंगिक डेटा छाँटा जा रहा है... पूर्ण।\nपूर्ण</style>\n\nनिम्नलिखित को Titan के सर्वोच्च न्यायालय की अध्यक्षता में होने वाले मुकदमे Titan बनाम Cooper में साक्ष्य के रूप में चिह्नित किया गया है। संबंधित व्यक्तियों की सुरक्षा और गोपनीयता के लिए कुछ विवरण हटाए जा सकते हैं।\n\n---\n\n\"आह... |||||, मेरे प्रिय, क्या तुम कोई कार्टून देखते हो?\"\n\n\"कृ-कृपया... मैं घ-घ-घर जाना चा-चाहता हूँ...\"\n\n\"देखो, एक छोटी-सी तरकीब है जो वे करते हैं और मैं उसे आज़माना चाहता था। तुम मेरी मदद करोगे, है न...?\"\n\n\"ओह, ||||||||... मेरी मदद करो...\"\n\n\"बहुत बढ़िया। अब मेरे लिए बिल्कुल शांत और स्थिर खड़े रहो। देखते हैं यह काम करता है या नहीं...\"\n\n\"तु-तुम क्या... उह...\"\n\n\"एक पल रुको, |||||, मेरे प्रिय। ज़रा मुझे इस प्यारे खिलौने को वापस इसकी म्यान में रखने दो।\"\n\n\"तु-तुम क्या-- हे भगवान!!! बचाओ!!! कृपया रुक जाओ, मेरे अंग--\"\n\n\"अरे, अब आँसू नहीं। मैंने अभी कुछ बहुत शानदार किया है। देखते हैं क्या मैं यह अपने पसंदीदा चाकू से भी कर सकता हूँ, हूँ?\"\n\n\"कृपया, नहीं, कृपया कृपया कृपया\"\n\nइस प्रतिलेखन का शेष भाग सील कर दिया गया है।\nकारण: बाल्टियों में उल्टी",
    "ITEM_TREASURECACHEVOID_NAME": "पपड़ीदार चाबी",
    "ITEM_TREASURECACHEVOID_PICKUP": "एक पपड़ीदार तिजोरी तक पहुँच पाएँ जिसमें वॉइड वस्तु होती है। <style=cIsVoid>सभी 'ज़ंग लगी चाबी' को भ्रष्ट कर देता है</style>।",
    "ITEM_TREASURECACHEVOID_DESC": "<style=cIsUtility>प्रत्येक चरण में</style> एक यादृच्छिक स्थान पर एक <style=cIsUtility>छिपी हुई तिजोरी</style> प्रकट होगी जिसमें एक वस्तु (60%/<style=cIsHealing>30%</style>/<style=cIsHealth>10%</style>) होगी। तिजोरी खोलने पर यह वस्तु <style=cIsUtility>खर्च</style> हो जाती है। <style=cIsVoid>सभी 'ज़ंग लगी चाबी' को भ्रष्ट कर देता है</style>।",
    "ITEM_TREASURECACHEVOID_LORE": "<style=cMono>//--UES [संपादित] से स्वचालित प्रतिलेखन --//</style>\n\n\"मेरे पास यह चाबी है। यह मुझे एक दिन समुद्र तट पर टहलते समय मिली थी... यह किनारे पर बहकर आ गई थी, पूरी तरह पपड़ी और रेत से ढकी हुई। पता नहीं क्यों, लेकिन मैंने इसे अपने साथ रख लिया... मैंने सोचा यह पता लगाना मज़ेदार होगा कि यह चाबी किस चीज़ की है। किसी ख़ज़ाने की खोज जैसा, समझे? बात यह है कि मैं जिसके पास भी गया, मुझे कुछ नहीं मिला। जो भी ताला मेल खाता लगता, उसमें यह चाबी पूरी अंदर नहीं जाती। मैं निराश होने लगा था। मैं... मैं बहुत धार्मिक नहीं हूँ, लेकिन न जाने क्यों, मुझे लगा कि इस पुरानी, घिसी हुई चाबी का उपयोग करके इसका ताला खोजना मेरी नियति है। शा-शायद यह मेरा जीवन बदल दे। पता नहीं। और जब मैंने इस मिशन के बारे में सुना, तो किसी कारणवश मेरा दिल तेज़ी से धड़कने लगा। मैंने Contact Light के लापता होने के बारे में सब सुना है, सभी ने सुना है। लेकिन... मुझे नहीं पता क्यों, पर मुझे अपने दिल की गहराई से लगा... यह चाबी जिस चीज़ की है, वह वहीं है जहाँ Contact Light थी। और साथ आना मेरी नियति थी।\"",
    "ITEM_BEARVOID_NAME": "सुरक्षित स्थान",
    "ITEM_BEARVOID_PICKUP": "क्षति के अगले स्रोत को रोकें। <style=cIsVoid>सभी 'और कठिन दिन' को भ्रष्ट कर देता है</style>।",
    "ITEM_BEARVOID_DESC": "आने वाली क्षति को एक बार <style=cIsHealing>रोकता</style> है। <style=cIsUtility>15 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर -10%)</style> बाद पुनः चार्ज होता है। <style=cIsVoid>सभी 'और कठिन दिन' को भ्रष्ट कर देता है</style>।",
    "ITEM_BEARVOID_LORE": "\"तुम मुझे गोली नहीं मार सकते।\n\nतुम मुझे बिजली का झटका नहीं दे सकते।\n\nतुम मुझ पर गैस नहीं छोड़ सकते।\n\nतुम मुझे नीचे भी नहीं गिरा सकते।\n\nजब तक कि कुछ बेहद क़ीमती चीज़ कुचल न दी जाए।\"",
    "ITEM_CLOVERVOID_NAME": "अतल पुष्प",
    "ITEM_CLOVERVOID_PICKUP": "प्रत्येक चरण की शुरुआत में आपकी वस्तुओं को उन्नत करता है। <style=cIsVoid>सभी '57 पत्तियों वाला क्लोवर' को भ्रष्ट कर देता है</style>।",
    "ITEM_CLOVERVOID_DESC": "<style=cIsUtility>प्रत्येक चरण की शुरुआत में</style> यादृच्छिक वस्तुओं में से <style=cIsUtility>3 को उन्नत करके</style> <style=cStack>(हर अतिरिक्त प्रति पर +3)</style> अगली <style=cIsUtility>उच्च दुर्लभता</style> की वस्तुओं में बदलता है। <style=cIsVoid>सभी '57 पत्तियों वाला क्लोवर' को भ्रष्ट कर देता है</style>।",
    "ITEM_CLOVERVOID_LORE": "\"किस्मत? ऐसी जगह पर किस्मत किसे चाहिए।\n\nयहाँ जीवित रहने के लिए तुम्हें सिर्फ़ किस्मत से कहीं अधिक की ज़रूरत है। तुम्हें अंतर्ज्ञान चाहिए। सहज बुद्धि। सही उपकरण। शक्ति।\n\nमैं जानता हूँ तुम डरे हुए हो। और मैं भी हूँ। लेकिन अगर इस नरक ने मुझे कुछ सिखाया है...\n\nहम अपनी किस्मत खुद बनाते हैं।\"\n\n- सिग्नल की प्रतिध्वनियाँ, UES Contact Light",
    "ITEM_MISSILEVOID_NAME": "प्लाज़्मा झींगा",
    "ITEM_MISSILEVOID_PICKUP": "जब आपके पास ढाल हो, तो हर प्रहार पर मिसाइलें दागें। <style=cIsVoid>सभी 'AtG मिसाइल Mk. 1' को भ्रष्ट कर देता है</style>।",
    "ITEM_MISSILEVOID_DESC": "अपने अधिकतम स्वास्थ्य के <style=cIsHealing>10%</style> के बराबर <style=cIsHealing>ढाल</style> पाएँ। जब आपके पास <style=cIsHealing>ढाल</style> हो, तो दुश्मन पर प्रहार करने से एक मिसाइल दागी जाती है जो <style=cIsDamage>40%</style> <style=cStack>(हर अतिरिक्त प्रति पर +50%)</style> कुल क्षति पहुँचाती है। <style=cIsVoid>सभी 'AtG मिसाइल Mk. 1' को भ्रष्ट कर देता है</style>।",
    "ITEM_MISSILEVOID_LORE": "\"मेरा मानना है कि अभेद्य रक्षा के पीछे से हमला करने का लाभ होता है। कुछ लोग इसे धोखाधड़ी कह सकते हैं, वे तुम्हें कायर भी कह सकते हैं... मैं उन्हें लक्ष्य कहता हूँ। आखिरकार, इतिहास विजेताओं द्वारा ही लिखा जाता है।\"\n\n- खोई हुई डायरी, Petrichor V से बरामद",
    "ITEM_MUSHROOMVOID_NAME": "रोती हुई फफूँद",
    "ITEM_MUSHROOMVOID_PICKUP": "दौड़ते समय उपचार पाएँ। <style=cIsVoid>सभी 'चहल-पहल वाला मशरूम' को भ्रष्ट कर देता है</style>।",
    "ITEM_MUSHROOMVOID_DESC": "<style=cIsUtility>दौड़ते समय</style> हर सेकंड आपके <style=cIsHealing>स्वास्थ्य</style> के <style=cIsHealing>2%</style> <style=cStack>(हर अतिरिक्त प्रति पर +2%)</style> का <style=cIsHealing>उपचार</style> करता है। <style=cIsVoid>सभी 'चहल-पहल वाला मशरूम' को भ्रष्ट कर देता है</style>।",
    "ITEM_MUSHROOMVOID_LORE": "<style=cMono>//--UES [संपादित] से स्वचालित प्रतिलेखन --//</style>\n\n\"यह बेकार है।\"\n\n\"जानते हो, अगर तुम बस वह जादुई शब्द कह दो तो तुम्हें कुछ खाने को मिल सकता है...\"\n\n\"नहीं! मैं उन $#@! मशरूमों में से एक भी नहीं खाने वाला!\"\n\n\"अरे चलो भी, वे हानिरहित हैं। बल्कि हानिरहित से भी बेहतर, वे--\"\n\n\"शुरू भी मत करो। और हमें यह भी नहीं पता, याद है जब तुमने पहली बार उन्हें खाया था तो तुम्हें संक्रमण हो गया था!?\"\n\n\"मामूली ज़ुकाम था।\"\n\n\"जो भी हो। मेरा मतलब है कि उन चीज़ों ने शायद तुम्हारा पाचन तंत्र बदल दिया होगा ताकि तुम उन्हें खा सको, या कोई और अजीब $#!&। मैं तुम्हारे स्तर तक नहीं गिरने वाला!\"\n\n\"ठीक है, मिस्टर नख़रेबाज़, तुम उनके साथ अपने ऊँचे सिद्धांतों पर चलने के लिए स्वतंत्र हो। या फिर, तुम इस छोटी गुफा की सुरक्षा में रह सकते हो, और मेरे साथ थोड़ा नाश्ता बाँट सकते हो।\"\n\n\"मैं... मैं बल्कि--\"\n\nदहाड़ड़ड़ड़ड़ड़ड़ड़ड़ड़ड़!! \n\n\"...हे भगवान, ठीक है। इधर दो।\"",
    "ITEM_SLOWONHITVOID_NAME": "टेंटाबॉबल",
    "ITEM_SLOWONHITVOID_PICKUP": "प्रहार पर दुश्मनों को जकड़ने की संभावना। <style=cIsVoid>सभी 'काल-गोलक' को भ्रष्ट कर देता है</style>।",
    "ITEM_SLOWONHITVOID_DESC": "प्रहार पर दुश्मनों को <style=cIsUtility>1 सेकंड</style> <style=cStack>(हर अतिरिक्त प्रति पर +1 सेकंड)</style> के लिए <style=cIsDamage>जकड़ने</style> की <style=cIsUtility>5%</style> <style=cStack>(हर अतिरिक्त प्रति पर +5%)</style> संभावना। <style=cIsVoid>सभी 'काल-गोलक' को भ्रष्ट कर देता है</style>।",
    "ITEM_SLOWONHITVOID_LORE": "ऑर्डर: चलित टेरेरियम + क्रोनोबॉबल\r\nट्रैकिंग नंबर: 99******\r\nअनुमानित डिलीवरी: 03/03/2076\r\nशिपिंग विधि: जैविक\r\nशिपिंग पता: 9042 Pvt. Drive, Yustik Plaza, बुध\r\nशिपिंग विवरण:\n\nअरे, अतीत के मैं। यह सुनने में बहुत अजीब लगेगा, लेकिन आजकल मुझे बाग़वानी का बड़ा शौक़ चढ़ गया है। अब, इससे पहले कि तुम कुछ कहो, तुम्हें मेरी स्थिति के बारे में सोचना होगा। मेरा मतलब है, जो कुछ चल रहा है, अगर किसी को इससे जूझना पड़े तो वह पागल हो जाए - उफ़। कोई स्पॉइलर नहीं, मेरी ग़लती।\n\nख़ैर, वह क्रोनोबॉबल याद है? वही जो हमें बुध पर मिला था? पता चला कि उसमें एक \"फ़ास्ट-फ़ॉरवर्ड\" फ़ीचर है। मैंने, उह, कुछ संकर पौधों को जल्दी बड़ा करने के लिए उसका इस्तेमाल करने की कोशिश की जिन्हें मैं उगा रहा था। वनस्पति विज्ञान की बातें हैं, तुम्हें बाद में समझ आएँगी - ख़ैर, शायद मैंने इसे थोड़ा ज़्यादा तेज़ कर दिया। जब तक मैंने डायल वापस 0 पर घुमाया, तब तक इस चीज़ पर कई सहस्राब्दियाँ बीत चुकी होंगी। मुझे पूरा यक़ीन है कि यह पौधों का बिल्कुल नया वंश है? शायद बिल्कुल अलग प्रजाति ही। ख़ुद के लिए नोट: याद रखना डायल को कभी 11 तक मत घुमाना। तुम विकासक्रम का एक घिनौना दानव बना दोगे।\n\nख़ैर, पिछली बार जैसा ही तरीका - इसे 10 साल बाद के ख़ुद को भेज रहा हूँ। 10 साल जल्दी बीत जाते हैं, ख़ासकर जब वे किसी स्थानीय रूप से त्वरित काल-क्षेत्र के भीतर बंद हों। हाँ, यह पलक झपकते बीत जाएगा - कुछ सहस्राब्दियों के साथ! शायद अगली बार मुझे स्क्रैपबुकिंग शुरू करनी चाहिए।",
    "ITEM_CHAINLIGHTNINGVOID_NAME": "पॉलील्यूट",
    "ITEM_CHAINLIGHTNINGVOID_PICKUP": "एक ही दुश्मन पर बार-बार बिजली गिराने की संभावना। <style=cIsVoid>सभी 'युकुलेले' को भ्रष्ट कर देता है</style>।",
    "ITEM_CHAINLIGHTNINGVOID_DESC": "<style=cIsDamage>25%</style> संभावना है कि <style=cIsDamage>बिजली</style> गिरे, जो <style=cIsDamage>3 <style=cStack>(हर अतिरिक्त प्रति पर +3)</style></style> बार तक <style=cIsDamage>60%</style> कुल क्षति पहुँचाती है। <style=cIsVoid>सभी 'युकुलेले' को भ्रष्ट कर देता है</style>।",
    "ITEM_CHAINLIGHTNINGVOID_LORE": "<style=cMono>DataScraper (v3.1.53 – बीटा शाखा) में स्वागत है\n$ स्मृति खंगाली जा रही है... पूर्ण।\n$ समाधान किया जा रहा है... पूर्ण।\n$ प्रासंगिक डेटा छाँटा जा रहा है... पूर्ण।\nपूर्ण!</style>\n\nमैंने एक अद्---त खो- की है! इस विचित्र ----- की गहराई में, मुझे च--नों पर कुछ नक्काशियाँ मिलीं। यह... संगीत प्रतीत होता है! यह कु- और न--ं हो सकता! मैं इसे लि--बद्ध करने का प्रया- करूँगा, हालाँ-- व्यव--न मे-े प्रसारण को धुँ--ला कर सकता है। अहेम...\n\nd, d, d, a, G. क्या तु- यह सु- पा रहे हो? अभी औ- भी है।\n\n---- --- - - -- - -------- - - - - - ----- - - -- - - - -- - - -\n\nकितना मधुर है!",
    "ITEM_EQUIPMENTMAGAZINEVOID_NAME": "लाइसेट सेल",
    "ITEM_EQUIPMENTMAGAZINEVOID_PICKUP": "अपने विशेष कौशल का एक अतिरिक्त चार्ज जोड़ें। <style=cIsVoid>सभी 'ईंधन सेल' को भ्रष्ट कर देता है</style>।",
    "ITEM_EQUIPMENTMAGAZINEVOID_DESC": "अपने <style=cIsUtility>विशेष कौशल</style> का <style=cIsUtility>+1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> चार्ज जोड़ें। <style=cIsVoid>सभी 'ईंधन सेल' को भ्रष्ट कर देता है</style>।",
    "ITEM_EQUIPMENTMAGAZINEVOID_LORE": "\"रीसाइक्लिंग एक महत्वपूर्ण चीज़ है। और मेरा मतलब पर्यावरण की मदद के लिए काँच की बोतल को रीसाइकल करने से नहीं है - हालाँकि वह भी महत्वपूर्ण है! नहीं, 'रीसाइक्लिंग' से मेरा आशय है एक चीज़ को लेकर उसका उपयोग किसी दूसरी चीज़ के लिए करना। उदाहरण के लिए, मेरा युकुलेले। मुझे यह चीज़ बहुत पसंद है। इसमें विद्युत गुण हैं, और यह उन्हें मेरे हमलों में पहुँचा देता है - मुफ़्त शृंखला-बिजली! लेकिन क्या हो अगर मैं इसे 'रीसाइकल' कर दूँ? मुझे लगता है युकुलेले एक बढ़िया हाथापाई का हथियार बन सकता है। कल्पना करो, एक Lemurian पर प्रहार करना और एक ही आसान कदम में उसमें वोल्ट भर देना।\n\nक्या तुम मेरी बात समझ रहे हो? हर जगह रीसाइक्लिंग के अवसर हैं। तुम्हें बस संभावनाओं के लिए अपना दिमाग़ खोलना है, और देखना है... और थोड़ी रीसाइक्लिंग करनी है। यह पर्यावरण के लिए अच्छा है।\"\n\n- खोई हुई डायरी, Petrichor V से बरामद",
    "ITEM_EXTRALIFEVOID_NAME": "बहुक्षम लार्वा",
    "ITEM_EXTRALIFEVOID_PICKUP": "एक <style=cIsVoid>भ्रष्ट</style> अतिरिक्त जीवन पाएँ। उपयोग पर खर्च हो जाता है। <style=cIsVoid>सभी 'Dio का सबसे अच्छा दोस्त' को भ्रष्ट कर देता है।</style>",
    "ITEM_EXTRALIFEVOID_DESC": "<style=cIsUtility>मृत्यु होने पर</style>, यह वस्तु <style=cIsUtility>खर्च</style> हो जाएगी और आप <style=cIsHealing>3 सेकंड की अजेयता</style> के साथ <style=cIsHealing>पुनः जीवित हो जाएँगे</style>, तथा आपकी वे सभी वस्तुएँ जो <style=cIsUtility>भ्रष्ट</style> हो सकती हैं, भ्रष्ट हो जाएँगी। <style=cIsVoid>सभी 'Dio का सबसे अच्छा दोस्त' को भ्रष्ट कर देता है</style>।",
    "ITEM_EXTRALIFEVOID_LORE": "\"जीवन अपना रास्ता ढूँढ़ ही लेता है। सृष्टि की गहराइयों में भी, रेत पर रेंगता हुआ कुछ न कुछ ज़रूर होगा, जो बस दिन काटने की उम्मीद लगाए बैठा है।\n\nक्यों न बस एक दिन के लिए तुम उनकी जगह लेकर देखो? हो सकता है इस अनुभव से तुम्हें एक बिल्कुल नया दृष्टिकोण मिल जाए।\"",
    "ITEM_EXTRALIFEVOIDCONSUMED_NAME": "बहुक्षम लार्वा (उपयोग किया गया)",
    "ITEM_EXTRALIFEVOIDCONSUMED_PICKUP": "एक खर्च हो चुकी वस्तु जिसमें कोई शक्ति शेष नहीं है।",
    "ITEM_EXTRALIFEVOIDCONSUMED_DESC": "एक खर्च हो चुकी वस्तु जिसमें कोई शक्ति शेष नहीं है।",
    "ITEM_FRAGILEDAMAGEBONUS_LORE": "मैदानों पर हवा बह रही है। दो सैनिक अपनी नियमित गश्त पर भारी कदमों से चल रहे हैं, और अपनी ऊब को सामान्य बातचीत से भर रहे हैं। \"हूँ। अरे Shelly, क्या मैंने तुम्हें अपनी नई Patex दिखाई?\" Quinton ने विचारमग्न होकर कहा। Shelly ने उसे संदेह भरी नज़रों से देखा। \"मुझे मत बताना कि तुम अज्ञात इलाकों के ख़तरनाक अभियान पर $75,000 की घड़ी साथ ले आए हो...\"\n\nअपने साथी की ओर घूमते हुए Quinton ने ज़ोरदार ठहाका लगाया। \"क्यों, बिल्कुल ले आया हूँ!\" अपनी आस्तीन ऊपर मोड़ते हुए, सोने की एक चमक ने उसकी संग्रहणीय घड़ी को उजागर किया। धातु की सतह गर्व से चमक उठी और सूरज की एक किरण को छिपे हुए एक Lemurian की आँखों में परावर्तित कर दिया। \"अगर मैं अपने साथी सैनिकों के सामने अपनी शान ही न दिखा सकूँ, तो इस वीराने में इतनी मुसीबतों और परीक्षाओं से गुज़रने का क्या मतलब!?\" Quinton हँसा और अपनी छाती पर मुक्का मारा। \"जब यह चीज़ टूटेगी—और यह टूटेगी ही—तो मैं तुम्हें इतना ताना मारूँगी कि पूछो मत,\" Shelly ने हँसते हुए कहा। Quinton ने तिरस्कार से कहा, \"अरे छोड़ो भी। हम इस रास्ते से अनगिनत बार गुज़रे हैं और कुछ नहीं हुआ। हम भाग्यशाली हैं कि इस नरक के एक शांत क्षेत्र में तैनात हैं, और मुझे नहीं लगता कि हमारी किस्मत इतनी जल्दी साथ छोड़ेगी।\"\n\nमानो संकेत मिलते ही, चमक से चिढ़ा हुआ क्रोधित Lemurian झाड़ियों से उछला और उसने आग का गोला दाग दिया। \"अरे बाप रे!\" Shelly चिल्लाई, उसने अपनी बंदूक उठाई और उस दैत्य को मार गिराया। \"हाह... शांत क्षेत्र के बारे में क्या कह रहे थे, हूँ?\" Shelly अपने साथी की ओर मुड़ी, जो ज़मीन पर दोहरा होकर गिरा हुआ था। Shelly का चेहरा पीला पड़ गया।\n\n\"हे भगवान... क्या तुम्हें चोट लगी? हमें तुम्हें जल्दी डॉक्टर के पास ले जाना होगा...!\"\n\n\"नहीं।\" Quinton की आवाज़ धीमी और शोक से भरी थी। \"मैं बिल्कुल ठीक हूँ, लेकिन...\" Quinton ने ऊपर देखा, और उसकी चमकती Patex दिखी, जिसने आग का गोला सीधा अपने ऊपर झेल लिया था और मुड़ी हुई धातु व धुआँ छोड़ती पॉलिश के मलबे में बदल गई थी। \"दे-देखो उस दैत्य ने मेरी क़ीमती घड़ी का क्या हाल कर दिया!\"\n\nएक पल के लिए मैदानों में सन्नाटा छा गया। फिर वह सन्नाटा एक बार फिर Shelly की हँसी और Quinton की हताश फरियाद से टूट गया।",
    "ITEM_FRAGILEDAMAGEBONUSCONSUMED_NAME": "नाज़ुक घड़ी (टूटी हुई)",
    "ITEM_FRAGILEDAMAGEBONUSCONSUMED_PICKUP": "...ख़ैर, यह दिन में दो बार अब भी सही समय बताती है।",
    "ITEM_FRAGILEDAMAGEBONUSCONSUMED_DESC": "एक खर्च हो चुकी वस्तु जिसमें कोई शक्ति शेष नहीं है।",
    "ITEM_OUTOFCOMBATARMOR_LORE": "<style=cMono>//--UES [संपादित] से स्वचालित प्रतिलेखन --//</style>\n\n\"...तुम्हें लगता है यह ग्रह उतना ही बुरा है जितना लोग कहते हैं?\"\n\nLiz अपने साथी सैनिकों के बीच चुपचाप बैठी थी। अपने दस्ते के बाक़ी लोगों की तरह, उसे भी आकाशगंगा के सुदूर इलाके में चल रही गोलीबारी के बीच से लाकर एक अनुभवी UES अधिकारी के सामने खड़ा किया गया था। Liz को अब तक ब्रीफ़िंग की आदत हो चुकी थी, उसके दिमाग़ में सब कुछ घुल-मिल जाता था। दैत्यों और लापता UES Contact Light के बारे में कुछ।\n\n\"...पता नहीं।\" Liz ने बुदबुदाते हुए अपने हाथ में ओपल के एक छोटे, बेडौल टुकड़े को घुमाया। यह उन गिनी-चुनी चीज़ों में से थी जो उसे Parker की याद दिलाती थीं। उस समय की, जब सब कुछ शांत और सुकूनभरा था।\n\n\"...हेह, मुझे नहीं लगता कोई चमकदार पत्थर ज़्यादा कुछ कर पाएगा,\" एक सैनिक ने मज़ाक़ किया। हेलमेट के नीचे Liz की भौंहें तन गईं। \"हाँ, शायद नहीं... लेकिन...\"\n\nLiz ने गहरी साँस ली और ओपल को वापस अपनी जेब में रख लिया। \"इससे बस हिम्मत मिलती है।\"",
    "ITEM_SCRAPWHITESUPPRESSED_NAME": "विचित्र स्क्रैप, सफ़ेद",
    "ITEM_SCRAPWHITESUPPRESSED_DESC": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर प्राथमिकता मिलती है।",
    "ITEM_SCRAPWHITESUPPRESSED_PICKUP": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर प्राथमिकता मिलती है।",
    "ITEM_SCRAPWHITESUPPRESSED_LORE": "हर संभावित परीक्षण के अनुसार यह मूर्ति शुद्ध चाँदी की बनी प्रतीत होती है, सिवाय एक के: घनत्व। हालाँकि यह एक रोचक पहेली लग सकती है, पर यह किसी भी व्याख्या का कपटपूर्वक प्रतिरोध करती है। इस गुत्थी को सुलझाने का प्रयास करने वालों को दुर्भाग्यवश सूक्ष्म किंतु स्थायी मनोवैज्ञानिक क्षति झेलनी पड़ी है। इस चाँदी के बंदर की कुटिल मुस्कान देखकर आप यह निष्कर्ष निकाल सकते हैं कि यही इसका जानबूझकर बनाया गया उद्देश्य है।",
    "ITEM_SCRAPGREENSUPPRESSED_NAME": "विचित्र स्क्रैप, हरा",
    "ITEM_SCRAPGREENSUPPRESSED_PICKUP": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर प्राथमिकता मिलती है।",
    "ITEM_SCRAPGREENSUPPRESSED_DESC": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर प्राथमिकता मिलती है।",
    "ITEM_SCRAPGREENSUPPRESSED_LORE": "\"निम्न\" और \"उच्च\" विस्फोटकों के बीच का अंतर विघटन की दर है। पहला अवध्वनिक होता है; दूसरा पराध्वनिक। हमारा पेटेंट किया गया नया पदार्थ तकनीकी रूप से \"उच्च विस्फोटक\" की श्रेणी में आता है, लेकिन क्वांटम उलझाव में मिली सफलताओं के कारण, इसके विघटन की दर केवल पराध्वनिक नहीं—बल्कि प्रकाश से भी तेज़ है। पहले प्रतिपदार्थ आशाजनक लग रहा था, लेकिन संभवतः यही वह नवाचार है जो ग्रह-विध्वंस को आर्थिक रूप से व्यावहारिक बनाता है।\n\n--ExMat-7 के लिए प्रचार सामग्री",
    "ITEM_SCRAPREDSUPPRESSED_NAME": "विचित्र स्क्रैप, लाल",
    "ITEM_SCRAPREDSUPPRESSED_PICKUP": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर प्राथमिकता मिलती है।",
    "ITEM_SCRAPREDSUPPRESSED_DESC": "कुछ नहीं करता। 3D प्रिंटर के साथ उपयोग करने पर प्राथमिकता मिलती है।",
    "ITEM_SCRAPREDSUPPRESSED_LORE": "\"मुझे लगता है वे जीवित हैं। मुझे शायद विज्ञान दल की प्रतीक्षा करनी चाहिए, लेकिन मुझे नहीं लगता कि लंबी छड़ी से किसी एक को हल्के से छूने से मेरी मौत हो जाएगी।\"\n\n--अंतिम संदेश, रक्त से सना रिकॉर्डर",
    "ITEM_GOLDONHURT_LORE": "गोलियों की आवाज़ Johnson के कानों में गूँज रही थी। दाँत भींचते हुए और अपने घायल पैर की पट्टी को कसते हुए, उसने जल्दी से अपनी बंदूक में गोलियाँ भरीं।\n\nउन Lemurians पर गोली चलाने से पहले—जिन्होंने उसकी टीम को कोने में घेर लिया था और उसके दो दोस्तों की जान ले चुके थे—एक पल के लिए Johnson ने सोचा कि वह यहाँ पहुँचा कैसे।\n\nJohnson गरीबी में पला-बढ़ा था, तीन बच्चों में सबसे बड़ा। अपनी बीमार माँ और छोटे भाई-बहनों का पेट पालने के लिए उसने कम उम्र में ही काम शुरू कर दिया था, और पूरी ज़िंदगी वह एक छोटे-मोटे काम से दूसरे काम पर भटकता रहा। कुछ भी जिससे पैसे आ सकें। कुछ भी जिससे बिल चुकाए जा सकें।\n\n\"'अज्ञात क्षेत्रों में एक अभियान, स्वयंसेवकों की तलाश है,'\" उसके भर्ती अधिकारी ने सिगार के कशों के बीच पढ़ा। \"बहुत-सी गोपनीय जानकारी है, मुझे ख़ुद ज़्यादा नहीं पता... लेकिन पैसा बहुत अच्छा है। और मुझे पता है तुम्हें पैसों की ज़रूरत है। क्या तुम तैयार हो, Johnny?\" उस समय Johnson ने मन ही मन सोचा था, 'यह इतना भी बुरा नहीं हो सकता।'\n\nJohnson वापस युद्ध के मैदान में लौट आया और अपने बचे हुए दोस्तों को बचाने के लिए Lemurians पर गोलियाँ बरसाने लगा। उसके पैर के घाव में टीस उठ रही थी और पट्टी ख़ून से लाल हो गई थी। 'यह इतना भी बुरा नहीं हो सकता,' उसने सोचा था। \"हाँ, बिल्कुल।\" Johnson ने व्यंग्य से कहा। \"कम से कम इसके बाद मुझे पैसे तो मिल रहे हैं।\"",
    "ITEM_RANDOMEQUIPMENTTRIGGER_NAME": "बोतलबंद अराजकता",
    "ITEM_RANDOMEQUIPMENTTRIGGER_PICKUP": "अपना उपकरण सक्रिय करने पर एक अतिरिक्त, यादृच्छिक उपकरण प्रभाव सक्रिय होता है।",
    "ITEM_RANDOMEQUIPMENTTRIGGER_DESC": "<style=cIsDamage>1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> बार एक <style=cIsDamage>यादृच्छिक उपकरण</style> प्रभाव सक्रिय करें।",
    "ITEM_RANDOMEQUIPMENTTRIGGER_LORE": "वह एकमात्र ग्रह जिसे वे क़ब्ज़े में नहीं ले सके।\n\nउनकी कोठरियों में सब कुछ कैद था।\n\nदैत्य, शक्ति के पुरावशेष, देवता, स्मृतियाँ।\n\nफिर भी, उन्होंने चाहे जितने एजेंट भेजे, कोई भी विजयी होकर नहीं लौटा... अगर वे लौटे भी तो।\n\nजो भाग्यशाली जीवित बच निकले, वे भाग गए और घबराकर अराजकता से सनी एक क्रिस्टल तलवार के बारे में फुसफुसाते रहे।",
    "ITEM_FREECHEST_NAME": "शिपिंग अनुरोध प्रपत्र",
    "ITEM_FREECHEST_PICKUP": "प्रत्येक चरण में एक डिलीवरी पाएँ जिसमें शक्तिशाली वस्तुएँ होती हैं।",
    "ITEM_FREECHEST_DESC": "<style=cIsUtility>प्रत्येक चरण में</style> एक यादृच्छिक स्थान पर 2 वस्तुओं (79%/<style=cIsHealing>20%</style>/<style=cIsHealth>1%</style>) वाली एक <style=cIsUtility>डिलीवरी</style> प्रकट होगी। <style=cStack>(हर अतिरिक्त प्रति पर वस्तुओं की दुर्लभता की संभावना बढ़ती है)।</style>",
    "ITEM_FREECHEST_LORE": "<style=cMono>यह एक स्वचालित संदेश है। यदि आपके पास यह संदेश प्राप्त करने का कोई कारण नहीं है, तो कृपया UES ग्राहक सहायता से संपर्क करें।</style>\n\nप्रिय {customerFirstName} {customerLastName},\n\nहमें आपको यह सूचित करते हुए खेद है कि आपकी {package} की डिलीवरी रद्द कर दी गई है। UES में हम इससे आपको हुई असुविधा को समझते हैं, और हमने आपको एक UES शिपिंग अनुरोध प्रपत्र देकर भरपाई करने का निर्णय लिया है। इसे भुनाने पर, UES सभी शिपिंग शुल्क माफ़ कर देगा और बिना किसी अतिरिक्त लागत के आपकी खेप को त्वरित शिपिंग में अपग्रेड कर देगा, ताकि आपको अपना पैकेज यथासंभव शीघ्र और सुचारु रूप से मिल सके। हम असुविधा के लिए पुनः क्षमा प्रार्थी हैं।\n\nआपका पैकेज रद्द होने का कारण यह है कि वह जिस मालवाहक जहाज़, UES Contact Light, पर था वह अज्ञात क्षेत्रों में रहस्यमय ढंग से लापता हो गया है और तब से हमें कोई संचार प्राप्त नहीं हुआ है। यदि आप या आपका कोई प्रियजन Contact Light पर सवार था, तो कृपया यदि आपने अभी तक ऐसा नहीं किया है तो अपने स्थानीय अधिकारियों से संपर्क करें। कृपया यह जान लें कि हमारे सभी प्रयास Contact Light और उसके चालक दल का पता लगाने तथा UES द्वारा सुनिश्चित आराम और सुरक्षा के साथ उन्हें सुरक्षित घर वापस लाने की दिशा में लगाए जा रहे हैं।\n\nआपके निरंतर समर्थन के लिए धन्यवाद,\n\n{SysAdmin}\n\n<style=cMono>यदि आप हमारी पठन सूची में शामिल होना चाहते हैं, तो विषय पंक्ति में यह लिखकर उत्तर दें: UES.RL_JOIN</style>",
    "ITEM_ELEMENTALRINGVOID_NAME": "सिंगुलैरिटी बैंड",
    "ITEM_ELEMENTALRINGVOID_PICKUP": "उच्च क्षति वाले प्रहार अस्थिर ब्लैक होल भी बनाते हैं। समय के साथ पुनः चार्ज होता है। <style=cIsVoid>सभी 'Runald की अंगूठी' और 'Kjaro की अंगूठी' को भ्रष्ट कर देता है</style>।",
    "ITEM_ELEMENTALRINGVOID_DESC": "जो प्रहार <style=cIsDamage>400% से अधिक क्षति</style> पहुँचाते हैं, वे एक ब्लैक होल भी दागते हैं जो <style=cIsUtility>15 मीटर के भीतर के दुश्मनों को अपने केंद्र में खींच लेता है</style>। यह ध्वस्त होने से पहले <style=cIsUtility>5</style> सेकंड तक रहता है और <style=cIsDamage>100%</style> <style=cStack>(हर अतिरिक्त प्रति पर +100%)</style> कुल क्षति पहुँचाता है। हर <style=cIsUtility>20</style> सेकंड में पुनः चार्ज होता है। <style=cIsVoid>सभी 'Runald की अंगूठी' और 'Kjaro की अंगूठी' को भ्रष्ट कर देता है</style>।",
    "ITEM_ELEMENTALRINGVOID_LORE": "\"चाहे प्रकाश उज्ज्वल हो या मंद पड़े,\r\nचाहे अंतरिक्ष स्थिर रहे या मुड़ जाए,\r\nहम समीप आएँगे।\r\nहम एक होकर समाप्त होंगे।\"\r\n\r\n-Io और Europa की युति, अप्रमाणिक छंद\r\n",
    "ITEM_LUNARSUN_NAME": "अहंकेंद्रिता",
    "ITEM_LUNARSUN_PICKUP": "परिक्रमा करने वाले कई बम पाएँ। <color=#FF7F7F>हर मिनट, एक अन्य वस्तु को अहंकेंद्रिता में समाहित कर लेता है।</color>",
    "ITEM_LUNARSUN_DESC": "हर <style=cIsUtility>3</style> <style=cStack>(हर अतिरिक्त प्रति पर -50%)</style> सेकंड में, एक <style=cIsDamage>परिक्रमा करने वाला बम</style> पाएँ जो टकराने पर फटकर <style=cIsDamage>360%</style> क्षति पहुँचाता है, अधिकतम <style=cIsUtility>3 <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> बम</style> तक। हर <style=cIsUtility>60</style> सेकंड में, एक यादृच्छिक वस्तु इस वस्तु में <style=cIsUtility>बदल</style> जाती है।",
    "ITEM_LUNARSUN_LORE": "...मैं जानता हूँ तुम मुझे सुन सकते हो।\n\nपहले मैं तुम्हें संदेह का लाभ देने को तैयार था। शायद मेरी रचना में कोई त्रुटि थी।\n\nशायद यह तुम्हारे खेलों में से एक था। मैं तुम्हें क्षमा करने के लिए भी तैयार था।\n\nलेकिन नहीं, अब मुझे सच्चाई दिख गई है। तुमने मुझे इस उजाड़ चट्टान पर कैद कर दिया। और किसलिए? \n\nक्या यह सब तुम्हारे छोटे पालतू जीवों के लिए है? वे प्राणी जिनसे तुम इतना प्रेम करते हो?\n\nया, क्या मैं इसे प्रेम कह भी सकता हूँ, जब तुम अपने एकमात्र भाई की पीठ में छुरा घोंप दो? तुमने मेरे साथ ऐसा कैसे किया?\n\nमैं, एकमात्र वही जिसने उसकी मृत्यु के बाद तुम्हारी देखभाल की।\n\nमैं, वही जिसने तुम्हें सृजन करना सिखाया?\n\nमैं, जिसने उसी शक्ति को रचने में मदद की जिसका उपयोग तुम हमारे घर में कीड़े-मकोड़ों और उपद्रवियों को बुलाने के लिए करते हो?\n\nमैं, तुम्हारा एकमात्र भाई?\n\nतुम उन अपूर्ण, दोषपूर्ण कीड़ों से प्रेम कैसे कर सकते हो और मुझसे नहीं? इतना सब कुछ तुम्हारे लिए करने के बाद भी? तुमने मेरे साथ ऐसा कैसे किया?\n\n...कुछ तो बोलो।",
    "ITEM_MINORCONSTRUCTONKILL_NAME": "रक्षा केंद्रक",
    "ITEM_MINORCONSTRUCTONKILL_PICKUP": "किसी एलीट को मारने पर एक Alpha Construct बुलाएँ।",
    "ITEM_MINORCONSTRUCTONKILL_DESC": "एलीट राक्षसों को मारने पर एक <style=cIsDamage>Alpha Construct</style> उत्पन्न होता है जिसमें <style=cIsDamage>300%</style> बोनस क्षति और <style=cIsHealing>300% स्वास्थ्य</style> होता है। अधिकतम <style=cIsUtility>4</style> <style=cStack>(हर अतिरिक्त प्रति पर +4)</style> तक सीमित।",
    "ITEM_MINORCONSTRUCTONKILL_LORE": "\"शानदार! तुम्हें यह कैसे मिला?\"\n\n\"हमने उन तैरते हुए भविष्यवक्ताओं में से एक को गिराया--\"\n\n\"Xi Construct।\"\n\n\"हाँ, वही। ख़ैर, हमने उसे गिराया और नमूना बरामद कर लिया।\"\n\n\"क्या मैं इसे देख सकता हूँ?\"\n\n\"यही है।\"\n\n\"यह? क्या हुआ? मुझे लगा तुमने कहा था कि यह चमक रहा था।\"\n\n\"बिल्कुल सही। यह चमक रहा था। इससे पहले कि मैंने इसे तोड़कर कबाड़ बना दिया।\"\n\n\"...तुमने ...क्या किया?\"\n\n\"मैंने इसे कबाड़ बना दिया।\"\n\n\"तुम आखिरकार Xi Construct से एक नमूना बरामद करने में सफल हुए, और तुमने उसे तोड़ डाला? क्या तुम्हें अंदाज़ा है कि हम जो नमूने इकट्ठा कर रहे हैं उनका कितना बड़ा महत्व है?\"\n\n\"मुझे इसके बहुत बड़े ख़तरे का अंदाज़ा है। मैंने लैब की फ़ाइलें पढ़ी हैं। Daimera का एक हाथ अपाहिज हो गया है। Veirs ख़ुद को करंट लगने से बाल-बाल बची। एक फूलदान के लिए Fitz द्वारा अपनी पूरी टीम को लगभग मार डालने के बाद, क्या तुम्हें लगता है मैं एक रहस्यमय चमकता गोला उठाकर यहाँ लाऊँगा? बिल्कुल नहीं।\"\n\n\"...ख़ैर, जो हो गया सो हो गया। अब जो बचा है उसी का विश्लेषण करूँगा। और कुछ?\"\n\n\"हाँ, मैं सोच रहा था कि हम इसे 'रक्षा केंद्रक' कह सकते हैं।\"\n\n\"...\"\n\n\"फ़ाइल में।\"\n\n\"नहीं।\"",
    "ITEM_VOIDMEGACRABITEM_NAME": "नवजात ज़ोइया",
    "ITEM_VOIDMEGACRABITEM_PICKUP": "समय-समय पर <style=cIsVoid>वॉइड</style> से साथियों को भर्ती करें। <style=cIsVoid>सभी </style><style=cIsTierBoss>पीली वस्तुओं</style><style=cIsVoid> को भ्रष्ट कर देता है</style>।",
    "ITEM_VOIDMEGACRABITEM_DESC": "हर <style=cIsUtility>60</style> <style=cStack>(हर अतिरिक्त प्रति पर -50%)</style> सेकंड में, एक यादृच्छिक <style=cIsVoid>वॉइड</style> साथी पाएँ। एक समय में अधिकतम <style=cIsUtility>1</style> <style=cStack>(हर अतिरिक्त प्रति पर +1)</style> साथी हो सकते हैं। <style=cIsVoid>सभी </style><style=cIsTierBoss>पीली वस्तुओं</style><style=cIsVoid> को भ्रष्ट कर देता है</style>।",
    "ITEM_VOIDMEGACRABITEM_LORE": "<style=cMono>प्रयोगशाला विच्छेदन विश्लेषण फ़ाइल</style>\r\nविषय: नवजात ज़ोइया\r\nतकनीशियन: X. Shun\r\nटेबल विनिर्देश: BioSaf, स्पेक्ट्रोस्कोपिक हुड सक्रिय\r\nटिप्पणियाँ:\r\n\r\n- स्वयं को संयत करने के लिए एक क्षण ले रहा हूँ।\r\n- हमें काफ़ी समय बाद कोई नमूना—अक्षत नमूना—मिला है, इसलिए मैं अत्यधिक सावधानी बरत रहा हूँ।\r\n- नमूना उत्कृष्ट स्थिति में है। अपने पूर्ववर्ती की तुलना में Jiminez ने जो सावधानी बरती, उससे मैं प्रसन्न हूँ।\r\n- नमूना एक अलिखित कर्कटीकृत प्रजाति प्रतीत होता है। शायद कोई किशोर जीव?\r\n- बाह्यत्वचा की बायोप्सी का प्रयास\r\n- नमूने का बाहरी आवरण मेरे स्कैल्पेल के लिए बहुत कठोर है\r\n- मुझे लगता है कि मुझे मुख गुहा मिल गई है। मौखिक बायोप्सी का प्रयास कर रहा हूँ।\r\n- <style=cMono>//--स्वचालित प्रतिलेखन विफल --//</style>\r\n- <style=cMono>//--स्वचालित प्रतिलेखन विफल --//</style>\r\n- बचाओ\r\n<style=cMono>फ़ाइल समाप्त</style>\r\n",
    "EQUIPMENT_COMMANDMISSILE_NAME": "डिस्पोज़ेबल मिसाइल लांचर",
    "EQUIPMENT_COMMANDMISSILE_PICKUP": "मिसाइलों का झुंड दागें।",
    "EQUIPMENT_COMMANDMISSILE_DESC": "<style=cIsDamage>12</style> मिसाइलों का झुंड दागें जो <style=cIsDamage>12x300% क्षति</style> पहुँचाती हैं।",
    "EQUIPMENT_COMMANDMISSILE_LORE": "“उपभोक्ता तब स्तब्ध रह गए जब एक प्रिय गेम कंपनी ने अपनी नवीनतम कार्डबोर्ड असेंबली किट जारी की: एक मिसाइल लांचर।”\r\n\r\n- The Saturn Reporter\r\n",
    "EQUIPMENT_FRUIT_NAME": "विदेशी फल",
    "EQUIPMENT_FRUIT_PICKUP": "उपयोग करने पर उपचार करें।",
    "EQUIPMENT_FRUIT_DESC": "तुरंत अपने <style=cIsHealing>अधिकतम स्वास्थ्य के 50%</style> का उपचार करें।",
    "EQUIPMENT_FRUIT_LORE": "“नटऐपल एक अनोखे Xelphum वृक्ष से तोड़ा गया विदेशी फल है, जो Titan के तटीय Gemines का मूल निवासी है। अपने मीठे, फिर भी शुद्धिकारक स्वाद (और कम कैलोरी) के लिए प्रसिद्ध, नटऐपल हर जगह स्वास्थ्य प्रेमियों के लिए अनिवार्य है।”\r\n\r\n- आहार विज्ञान डाइजेस्ट\r\n",
    "EQUIPMENT_METEOR_NAME": "चमकता उल्कापिंड",
    "EQUIPMENT_METEOR_PICKUP": "आकाश से उल्काओं की वर्षा करें, <color=#FF7F7F>जिससे दुश्मन और साथी दोनों घायल होते हैं।</color>",
    "EQUIPMENT_METEOR_DESC": "आकाश से <style=cIsDamage>उल्काओं की वर्षा करें</style>, जिससे सभी पात्रों को <style=cIsDamage>प्रति विस्फोट 600% क्षति</style> पहुँचती है। 20 सेकंड तक चलता है।",
    "EQUIPMENT_METEOR_LORE": "संयोग ने हमें तारों का कितना... विचित्र टुकड़ा ला दिया है। मुझे यक़ीन है तुम ऐसे और बना सकते हो। अनुपात सरल हैं। यह काफ़ी मज़ेदार होना चाहिए।",
    "EQUIPMENT_SOULJAR_NAME": "आत्माओं का मर्तबान",
    "EQUIPMENT_SOULJAR_PICKUP": "स्क्रीन पर मौजूद हर दुश्मन के लिए एक भूत बुलाएँ।",
    "EQUIPMENT_SOULJAR_DESC": "15 सेकंड के लिए अपनी ओर से लड़ने हेतु हर दुश्मन की भूत के रूप में प्रतिलिपि बनाएँ।",
    "EQUIPMENT_BLACKHOLE_NAME": "आदिम घन",
    "EQUIPMENT_BLACKHOLE_PICKUP": "एक ब्लैक होल दागें जो दुश्मनों को अंदर खींचता है।",
    "EQUIPMENT_BLACKHOLE_DESC": "एक ब्लैक होल दागें जो <style=cIsUtility>30 मीटर के भीतर के दुश्मनों को अपने केंद्र में खींच लेता है</style>। 10 सेकंड तक रहता है।",
    "EQUIPMENT_BLACKHOLE_LORE": "“प्रोफ़ेसर Mia Thatcher और Jared Malik की रिपोर्ट है कि आकाशगंगा का पहला सिंगुलैरिटी कंटेनमेंट लैटिस – संक्षेप में SCL – परीक्षण पूरा कर चुका है और पूरी तरह सुरक्षित पाया गया है। \r\n\r\nहालाँकि यह एक ऐतिहासिक वैज्ञानिक उपलब्धि है, फिर भी कई वैज्ञानिकों ने इस खोज के निहितार्थों पर चिंता जताई है – और इस पर भी कि मानवता के भविष्य के लिए इसका क्या अर्थ हो सकता है।”\r\n\r\n- The Saturn Reporter, प्रथम पृष्ठ का मुख्य समाचार\r\n",
    "EQUIPMENT_GHOSTGUN_NAME": "काल का पश्चाताप",
    "EQUIPMENT_GHOSTGUN_PICKUP": "एक भूतिया रिवॉल्वर बुलाएँ जो दुश्मन को मारने पर क्षति दोगुनी कर देता है।",
    "EQUIPMENT_GHOSTGUN_DESC": "भूतिया बंदूक का विवरण।",
    "EQUIPMENT_CRITONUSE_NAME": "ऑक्युलर HUD",
    "EQUIPMENT_CRITONUSE_PICKUP": "8 सेकंड के लिए 100% क्रिटिकल वार की संभावना पाएँ।",
    "EQUIPMENT_CRITONUSE_DESC": "8 सेकंड के लिए <style=cIsDamage>+100% क्रिटिकल वार की संभावना</style> पाएँ।",
    "EQUIPMENT_CRITONUSE_LORE": "ऑर्डर: ऑक्युलर HUD\r\nट्रैकिंग नंबर: 871*****\r\nअनुमानित डिलीवरी: 09/06/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: Greivenkamp, 5th Houston St, Prism Tower, पृथ्वी\r\nशिपिंग विवरण:\r\n\r\nकाश तुमने मुझसे मदद न माँगी होती। [संपादित] ने मुझसे संपर्क किया और उन्होंने... ख़ैर, कुछ बातें समझाईं। उनके निर्देशों का उपयोग करके, मैं लंबे समय तक सटीकता के लिए यह इंटरफ़ेस डिज़ाइन कर पाया। इसकी ख़ूबसूरती यह है कि यह पहले से मौजूद किसी भी सटीकता बढ़ाने वाले उपकरण के साथ मिलकर असर बढ़ाएगा। डिजिटल और ऑप्टिकल का मेल ही सबसे बेहतर रास्ता है।\r\n\r\nहालाँकि मुझे अभी भी सब कुछ नहीं पता, पर मुझे लगता है कि मैं पहले ही बहुत गहराई में फँस चुका हूँ। इसके बाद तुम मुझसे कोई संपर्क नहीं पाओगे।\r\n",
    "EQUIPMENT_DRONEBACKUP_NAME": "बैक-अप",
    "EQUIPMENT_DRONEBACKUP_PICKUP": "सहायता के लिए ड्रोन बुलाएँ। 25 सेकंड तक चलता है।",
    "EQUIPMENT_DRONEBACKUP_DESC": "आपकी ओर से लड़ने के लिए <style=cIsDamage>4 स्ट्राइक ड्रोन</style> बुलाएँ। 25 सेकंड तक चलता है।",
    "EQUIPMENT_DRONEBACKUP_LORE": "\"स्थानीय क़ानून प्रवर्तन द्वारा रैपिड रिस्पॉन्स ड्रोन स्क्वाड्रन (RRDS) को शामिल किया जाना Plank के विद्रोह का एक भयावह मोड़ था। विद्रोह को कुचलने में इसकी भारी \"सफलता\" – और बाद में पूरे बुध पर इसके लागू होने – के बाद भूमिगत ड्रोन हैकर्स की काला बाज़ार में भारी माँग हो गई।\"\r\n\r\n-ड्रोन प्रौद्योगिकी का अवलोकन, खंड 2\r\n",
    "EQUIPMENT_BFG_NAME": "प्रीऑन संचायक",
    "EQUIPMENT_BFG_PICKUP": "ऊर्जा का एक गोला दागें जो फटने से पहले पास के दुश्मनों को बिजली का झटका देता है।",
    "EQUIPMENT_BFG_DESC": "प्रीऑन तंतु दागता है, जो 35 मीटर के भीतर के दुश्मनों को <style=cIsDamage>प्रति सेकंड 600% क्षति</style> तक का झटका देते हैं। संपर्क होने पर, 20 मीटर के विशाल विस्फोट में फटकर <style=cIsDamage>4000% क्षति</style> पहुँचाता है।",
    "EQUIPMENT_BFG_LORE": "ऑर्डर: कण त्वरक घटक\r\nट्रैकिंग नंबर: 993******\r\nअनुमानित डिलीवरी: 06/06/2056\r\nशिपिंग विधि: अस्थिर\r\nशिपिंग पता: उन्नत कण अनुसंधान केंद्र, Mesquite, पृथ्वी\r\n\r\nमुझे अब भी समझ नहीं आता कि तुम इतने सारे संचायक कैसे खो देते हो। मैं इन्हें मज़बूत बनाता हूँ, और इन्हें लंबे समय तक चलना चाहिए। मैंने संचार गति के आँकड़े जाँचे, और मुझे पूरा यक़ीन है कि पिछला वाला मिलने के दो दिन से भी कम समय में तुमने यह नया ऑर्डर भेज दिया। \r\n\r\nअगर यही चलता रहा, तो तुम किसी ऐसी चीज़ में छेद कर बैठोगे जहाँ नहीं करना चाहिए। तुम्हारे पास बढ़िया प्रायोजक है, Jim, लेकिन यह सामान भेजना सस्ता नहीं है। और यह बिल्कुल भी तेज़ नहीं है। इसलिए, मैं तुम्हें एक कस्टम पुर्ज़ा भेज रहा हूँ। जितना मज़बूत मैं बना सकता हूँ, और ओवरचार्जिंग से बचाने के लिए एक सुरक्षा प्रणाली के साथ – जिसे मुझे यक़ीन है कि तुम वैसे भी बायपास कर दोगे। \r\n\r\nकम से कम पहले हफ़्ते में तो इसे उड़ाकर टुकड़े-टुकड़े न करने की कोशिश करना, ठीक है? हमारे गृहनगर का नाम ऊँचा रखो। तुम धुआँ छोड़ते कबाड़ के ढेर से उन शानपट्टी यूरोपियों को मात नहीं दे पाओगे।\r\n",
    "EQUIPMENT_JETPACK_NAME": "दुधिया कोया",
    "EQUIPMENT_JETPACK_PICKUP": "अस्थायी उड़ान पाएँ।",
    "EQUIPMENT_JETPACK_DESC": "पंख उगाएँ और <style=cIsUtility>15 सेकंड तक उड़ें</style>। इस अवधि के दौरान <style=cIsUtility>+20% चलने की गति</style> पाएँ।",
    "EQUIPMENT_JETPACK_LORE": "ऑर्डर: दुधिया कोया\r\nट्रैकिंग नंबर: 393*****\r\nअनुमानित डिलीवरी: 11/27/2056\r\nशिपिंग विधि: उच्च प्राथमिकता/जैविक\r\nशिपिंग पता: Diptera अनुसंधान केंद्र, Io\r\nशिपिंग विवरण:\r\n\r\nमहामारी के बंजर इलाकों की गहराई में एक ऐसा कोना है जो रोग से मुक्त है। यह कीटों के एक ऐसे समूह का घर है जो अपने पर्यावरण के अनुकूल नहीं ढले हैं। वे प्रतिरोध से नहीं… बल्कि रूपांतरण से जीवित रहते हैं। \r\n\r\nमैंने इन प्राणियों को कायांतरण की अनंत अवस्थाओं से गुज़रते देखा है। उनमें होने वाला प्रत्येक परिवर्तन आसपास की भूमि में प्रतिबिंबित होता है। यह लगातार उस क्षेत्र को कम विषाक्त रूप में ढालता रहता है।\r\n\r\nमैं कल्पना नहीं कर सकता कि उनकी कोई ऊपरी सीमा न हो – कोई अंतिम रूप न हो। वह अंतिम रूप कौन-से बदलाव लाएगा? क्या इस पर कोई प्रतिबंध है कि क्या बदला जा सकता है? मैं अध्ययन के लिए यह नमूना तुम्हें भेज रहा हूँ। कृपया इसके साथ सावधानी बरतना, क्योंकि यह रूपांतरण के बीच में एक क्रायो सेल में जमा हुआ है।\r\n",
    "EQUIPMENT_LIGHTNING_NAME": "शाही संधारित्र",
    "EQUIPMENT_LIGHTNING_PICKUP": "लक्षित राक्षस पर बिजली गिराएँ।",
    "EQUIPMENT_LIGHTNING_DESC": "लक्षित राक्षस पर बिजली गिराएँ, जिससे <style=cIsDamage>3000% क्षति</style> पहुँचे और पास के राक्षस <style=cIsDamage>स्तब्ध</style> हो जाएँ।",
    "EQUIPMENT_LIGHTNING_LORE": "ऑर्डर: ZAP2-K “शाही” संधारित्र\r\nट्रैकिंग नंबर: 145***************\r\nअनुमानित डिलीवरी: 04/30/2056\r\nशिपिंग विधि:  मानक\r\nशिपिंग पता: विद्युत संयंत्र 005, मार्ग 10, शुक्र\r\nशिपिंग विवरण: \r\n\r\nयह रहा आपके क्षतिग्रस्त उपकरण का प्रतिस्थापन। अजीब बात है कि गिरोहों की गतिविधियाँ फिर से बढ़ रही हैं – और इससे भी अजीब कि वे आप लोगों से एक संधारित्र चुरा ले गए। ख़ैर, आप लोग नियम जानते ही हैं – संधारित्र के संग्रहण सेलों को नियमित रूप से डिस्चार्ज करना सुनिश्चित करें, क्योंकि इसमें अवशिष्ट वोल्टेज बचा रह सकता है। अरे हाँ, और ऐसा करते समय इसे किसी की तरफ़ न तानें।\r\n\r\n- The Saturn Reporter, प्रथम पृष्ठ का मुख्य समाचार\r\n",
    "EQUIPMENT_GOLDGAT_NAME": "क्राउडफ़ंडर",
    "EQUIPMENT_GOLDGAT_PICKUP": "गोलीबारी चालू/बंद करें। प्रति गोली सोना खर्च होता है।",
    "EQUIPMENT_GOLDGAT_DESC": "लगातार बौछार दागता है जो <style=cIsDamage>प्रति गोली 100% क्षति</style> पहुँचाती है। प्रति गोली $1 खर्च होता है। समय के साथ लागत बढ़ती जाती है।",
    "EQUIPMENT_GOLDGAT_LORE": "ऑर्डर: क्राउडफ़ंडर\r\nट्रैकिंग नंबर: 783*****\r\nअनुमानित डिलीवरी: 05/09/2056\r\nशिपिंग विधि: मानक\r\nशिपिंग पता: 206 29th Ave, High Chariot, बुध \r\nशिपिंग विवरण:\r\n\r\nPrimas V के धनी शासकों ने निम्न वर्ग का मनोबल तोड़ने के लिए हर संभव उपाय किए। उन्होंने चोट और मृत्यु का भय निरंतर बनाए रखा, जिससे उनके सेवक क़ाबू में रहते थे, किंतु यह उनकी पद्धति का केवल आधा हिस्सा था। \r\n\r\nहैसियत के विशाल अंतर को और उजागर करने के लिए, उनके भव्य हथियार मुद्रा से चलते थे – वे सचमुच उन पर पैसा फेंकते थे।\r\n\r\nमुझे तुम्हें यह बताने की ज़रूरत नहीं कि उनके साथ क्या हुआ। यही कारण है कि मेरा मुवक्किल अब छिपकर रह रहा है और उसे ये चीज़ें गिरवी रखनी पड़ रही हैं। इन कठिन समय में आपके संरक्षण के लिए वह आपका आभार व्यक्त करता है।\r\n",
    "EQUIPMENT_PASSIVEHEALING_NAME": "गाँठदार वन-परी",
    "EQUIPMENT_PASSIVEHEALING_PICKUP": "समय के साथ उपचार करें। किसी साथी के पास भेजने के लिए सक्रिय करें।",
    "EQUIPMENT_PASSIVEHEALING_DESC": "एक वन-परी अनुयायी पाएँ जो किसी मित्रवत लक्ष्य का तुरंत उसके <style=cIsHealing>अधिकतम स्वास्थ्य के 10%</style> तक उपचार करता है, और फिर हर सेकंड आपके <style=cIsHealing>अधिकतम स्वास्थ्य का 1.5%</style> उपचार करता है। \n\nउपकरण सक्रिय करने से एक नया लक्ष्य तय होता है, या यदि कोई लक्ष्य उपलब्ध न हो तो आप स्वयं।",
    "EQUIPMENT_PASSIVEHEALING_LORE": "ऑर्डर: गाँठदार वन-परी\r\nट्रैकिंग नंबर: 447*****\r\nअनुमानित डिलीवरी: 01/16/2056\r\nशिपिंग विधि: उच्च प्राथमिकता/जैविक\r\nशिपिंग पता: Happy Hope बाल चिकित्सालय, Waleton, पृथ्वी\r\nशिपिंग विवरण:\r\n\r\nपरी-सहायता प्राप्त देखभाल के लाभों पर Dr. Coleas के अध्ययनों ने पूरी पृथ्वी के अस्पतालों के लिए नई राह खोली है। ये नन्हे जीव घायलों और बीमारों के बीच अपनी आभा बिखेरने का कोई अवसर नहीं चूकते। \r\n\r\nहमने लगभग सभी रोगियों के ठीक होने के समय में उल्लेखनीय कमी देखी है। यद्यपि यह प्रभावी है, मुझे विश्वास नहीं कि इस आभा प्रभाव से वास्तव में कुछ प्रसारित हो रहा है। यह सब प्लेसीबो भी हो सकता है; हो सकता है लोग बस अपने सामने रोशनी का खेल दिखाते एक प्यारे जीव को देखकर प्रतिक्रिया दे रहे हों।\r\n\r\nचाहे जो हो, उनका आसपास रहना अच्छा लगता है, और मुझे लगता है उन्हें भी हमारे साथ रहना पसंद है। मैं इतना भाग्यशाली हूँ कि एक को अपने घर में रख सकता हूँ... बेशक, अध्ययन के उद्देश्य से। यह थोड़ा अजीब लग सकता है, लेकिन इन नन्हे जीवों को दूसरे ग्रह से मँगवाने से उनके व्यवहार पर रत्ती भर भी असर नहीं पड़ता।\r\n",
    "EQUIPMENT_AFFIXRED_NAME": "Ifrit की विशिष्टता",
