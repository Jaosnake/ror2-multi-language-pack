	public class AnimEventTracker
	{
		public Animator animator;

		public List<string> alreadyFired = new List<string>();

		public AnimEventTracker(Animator anim)
		{
			animator = anim;
		}

		public bool CheckEvent(string param)
		{
			if (animator.GetFloat(param) > 0.5f && !alreadyFired.Contains(param))
			{
				alreadyFired.Add(param);
				return true;
			}
			return false;
		}
	}
