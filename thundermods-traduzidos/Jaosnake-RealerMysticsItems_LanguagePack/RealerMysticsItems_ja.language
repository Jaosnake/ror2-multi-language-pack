{
  "ja": {
    "ITEM_MYSTICSITEMS_RIFTLENSDEBUFF_NAME": "リフト ビジョン",
    "ITEM_MYSTICSITEMS_RIFTLENSDEBUFF_PICKUP": "不安定なリフトが見えるようになる… <color=#FF7F7F>ただし、時間内にすべて閉じなければ死亡する！</color>",
    "ITEM_MYSTICSITEMS_RIFTLENSDEBUFF_DESC": "不安定なリフトが見えるようになる… <color=#FF7F7F>ただし、時間内にすべて閉じなければ死亡する！</color>",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPENCONSUMED_NAME": "プラチナ カード（消費済み）",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPENCONSUMED_PICKUP": "次のステージで再充電される。",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPENCONSUMED_DESC": "次のステージで再充電される。",
    "ITEM_MYSTICSITEMS_HEALORBONBARREL_NAME": "ドーナツ",
    "ITEM_MYSTICSITEMS_HEALORBONBARREL_PICKUP": "触れられるものを起動すると、回復のオーブが生成される。",
    "ITEM_MYSTICSITEMS_HEALORBONBARREL_DESC": "触れられるものを起動すると<style=cIsHealing>回復のオーブ</style>が生成され、<style=cIsHealing>{FlatHealing}</style>に加えて<style=cIsHealing>{FractionalHealing}% <style=cStack>(スタックごとに +{FractionalHealingPerStack}%)</style></style>の<style=cIsHealing>最大ヘルス</style>を追加で回復する。",
    "ITEM_MYSTICSITEMS_SCRATCHTICKET_NAME": "スクラッチ チケット",
    "ITEM_MYSTICSITEMS_SCRATCHTICKET_PICKUP": "確率に基づく効果の発動確率がわずかに上昇する。",
    "ITEM_MYSTICSITEMS_SCRATCHTICKET_DESC": "確率に基づく効果の発動確率が <style=cIsUtility>+{ChanceBonus}% <style=cStack>(スタックごとに +{ChanceBonusPerStack}%)</style></style> 上昇する。発動確率が1%未満の効果には適用されない。",
    "ITEM_MYSTICSITEMS_BACKARMOR_NAME": "脊椎インプラント",
    "ITEM_MYSTICSITEMS_BACKARMOR_PICKUP": "背後からの攻撃で受けるダメージが減少する。",
    "ITEM_MYSTICSITEMS_BACKARMOR_DESC": "背後からの攻撃に対するアーマーが <style=cIsUtility>{ArmorAdd} <style=cStack>(スタックごとに +{ArmorAddPerStack})</style></style> 増加する。",
    "ITEM_MYSTICSITEMS_MANUSCRIPT_NAME": "原稿",
    "ITEM_MYSTICSITEMS_MANUSCRIPT_PICKUP": "ランダムなステータスが{StatBonus}%上昇する。ゲーム中にアイテムにカーソルを合わせると現在のステータスボーナスを確認できる。",
    "ITEM_MYSTICSITEMS_MANUSCRIPT_DESC": "ランダムなステータス（最大ヘルス/体力自動回復/ダメージ/移動速度/攻撃速度/クリティカル率/アーマー）<style=cIsUtility>1つ <style=cStack>(スタックごとに +1)</style></style>が <style=cIsUtility>{StatBonus}%</style> 上昇する。アイテムにカーソルを合わせると現在のステータスボーナスを確認できる。",
    "ITEM_MYSTICSITEMS_LIMITEDARMOR_NAME": "キュートなリボン",
    "ITEM_MYSTICSITEMS_LIMITEDARMOR_PICKUP": "{Hits}回の被弾に対して受けるダメージを軽減する。",
    "ITEM_MYSTICSITEMS_LIMITEDARMOR_DESC": "<style=cIsUtility>{Hits}回 <style=cStack>(スタックごとに +{Hits}回)</style></style>の被弾に対してアーマーが <style=cIsUtility>{Armor}</style> 増加する。使い果たすと、<style=cIsUtility>ほつれたリボン（常時アーマーが {BrokenArmor} <style=cStack>(スタックごとに +{BrokenArmor})</style> 増加）</style>に変化する。",
    "ITEM_MYSTICSITEMS_LIMITEDARMORBROKEN_NAME": "ほつれたリボン",
    "ITEM_MYSTICSITEMS_LIMITEDARMORBROKEN_PICKUP": "アーマーがわずかに増加する。",
    "ITEM_MYSTICSITEMS_LIMITEDARMORBROKEN_DESC": "アーマーが <style=cIsUtility>{BrokenArmor} <style=cStack>(スタックごとに +{BrokenArmor})</style></style> 増加する。",
    "ITEM_MYSTICSITEMS_COOKIE_NAME": "チョコチップ",
    "ITEM_MYSTICSITEMS_COOKIE_PICKUP": "バフの効果時間が延び、デバフの効果時間が短縮される。",
    "ITEM_MYSTICSITEMS_COOKIE_DESC": "有益なステータス効果の持続時間を <style=cIsUtility>{BuffDuration}秒 <style=cStack>(スタックごとに +{BuffDurationPerStack}秒)</style></style> 延長する。有害なステータス効果の持続時間を <style=cIsUtility>{DebuffDuration}秒 <style=cStack>(スタックごとに +{DebuffDuration}秒)</style></style> 短縮する（1秒未満には短縮されない）。",
    "ITEM_MYSTICSITEMS_MARWANASH1_NAME": "マルワンの灰",
    "ITEM_MYSTICSITEMS_MARWANASH1_PICKUP": "命中時に追加のダメージを与える。レベル{UpgradeLevel12}でアップグレードされる。",
    "ITEM_MYSTICSITEMS_MARWANASH1_DESC": "敵に攻撃が命中すると、追加で <style=cIsDamage>{Damage} <style=cStack>(レベルごとに +{DamagePerLevel} (スタックごとに +{StackLevelMultiplier}%))</style></style> のダメージを与える。<style=cIsUtility>レベル{UpgradeLevel12}でアップグレードされる</style>。",
    "ITEM_MYSTICSITEMS_MARWANASH2_NAME": "マルワンの光",
    "ITEM_MYSTICSITEMS_MARWANASH2_PICKUP": "命中時に追加のダメージを与え、継続ダメージを付与する。レベル{UpgradeLevel23}でアップグレードされる。",
    "ITEM_MYSTICSITEMS_MARWANASH2_DESC": "敵に攻撃が命中すると、追加で <style=cIsDamage>{Damage} <style=cStack>(レベルごとに +{DamagePerLevel} (スタックごとに +{StackLevelMultiplier}%))</style></style> のダメージを与え、毎秒最大ヘルスの <style=cIsHealth>{DoTPercent}% <style=cStack>(レベル{UpgradeLevel12}以降、レベルごとに +{DoTPercentPerLevel}% (スタックごとに +{StackLevelMultiplier}%))</style></style> を失わせる。<style=cIsUtility>レベル{UpgradeLevel23}でアップグレードされる</style>。",
    "ITEM_MYSTICSITEMS_MARWANASH3_NAME": "マルワンの武器",
    "ITEM_MYSTICSITEMS_MARWANASH3_PICKUP": "命中時、周囲のすべての敵にダメージを与え、継続ダメージを付与する。",
    "ITEM_MYSTICSITEMS_MARWANASH3_DESC": "敵に攻撃が命中すると、<style=cIsUtility>半径{Radius}m <style=cStack>(レベル{UpgradeLevel23}以降、レベルごとに +{RadiusPerLevel}m (スタックごとに +{StackLevelMultiplier}%))</style> 以内のすべての敵</style>に <style=cIsDamage>{Damage} <style=cStack>(レベルごとに +{DamagePerLevel} (スタックごとに +{StackLevelMultiplier}%))</style></style> のダメージを与え、毎秒最大ヘルスの <style=cIsHealth>{DoTPercent}% <style=cStack>(レベル{UpgradeLevel12}以降、レベルごとに +{DoTPercentPerLevel}% (スタックごとに +{StackLevelMultiplier}%))</style></style> を失わせる。",
    "ITEM_MYSTICSITEMS_GACHAPONTOKEN_NAME": "ガチャポン コイン",
    "ITEM_MYSTICSITEMS_GACHAPONTOKEN_PICKUP": "運の祭壇を起動するたび、次のステージまでクリティカル率と攻撃速度が上昇する。",
    "ITEM_MYSTICSITEMS_GACHAPONTOKEN_DESC": "次のステージまで、<style=cIsUtility>運の祭壇</style>を起動するたびにクリティカル率が <style=cIsDamage>{CritBonus}% <style=cStack>(スタックごとに +{CritBonusPerStack}%)</style></style>、攻撃速度が <style=cIsDamage>{AttackSpeedBonus}% <style=cStack>(スタックごとに +{AttackSpeedBonusPerStack}%)</style></style> 上昇する。常時パッシブとしてクリティカル率が <style=cIsDamage>{PassiveCritBonus}% <style=cStack>(スタックごとに +{PassiveCritBonusPerStack}%)</style></style>、攻撃速度が <style=cIsDamage>{PassiveAttackSpeedBonus}% <style=cStack>(スタックごとに +{PassiveAttackSpeedBonusPerStack}%)</style></style> 上昇する。",
    "ITEM_MYSTICSITEMS_FLOW_NAME": "不変の流れ",
    "ITEM_MYSTICSITEMS_FLOW_PICKUP": "移動速度がわずかに上昇する。減速効果の影響が軽減される。移動不能効果は代わりに減速になる。",
    "ITEM_MYSTICSITEMS_FLOW_DESC": "移動速度が <style=cIsUtility>{MoveSpeed}% <style=cStack>(スタックごとに +{MoveSpeedPerStack}%)</style></style> 上昇する。減速効果が自分に対して <style=cIsUtility>{SlowReduction}% <style=cStack>(スタックごとに +{SlowReductionPerStack}%)</style></style> 弱まる。移動不能効果を受けても<style=cIsUtility>移動不能にならず</style>、代わりに移動速度が <style=cIsUtility>{InitialRootSlow}% <style=cStack>(スタックごとに -{RootSlowReductionPerStack}%)</style></style> 低下する。",
    "ITEM_MYSTICSITEMS_GHOSTAPPLE_NAME": "亡霊のリンゴ",
    "ITEM_MYSTICSITEMS_GHOSTAPPLE_PICKUP": "次の{Minutes}分間、体力自動回復が増加する。",
    "ITEM_MYSTICSITEMS_GHOSTAPPLE_DESC": "次の<style=cIsUtility>{Minutes}分間</style>、<style=cIsHealing>体力自動回復</style>が <style=cIsHealing>{Regen} HP/秒 <style=cStack>(スタックごとに +{Regen} HP/秒、レベルごとに +20%)</style></style> 増加する。効果が切れると、<style=cIsUtility>リンゴの軸（常時自動回復が {RegenWeak} HP/秒 <style=cStack>(スタックごとに +{RegenWeak} HP/秒、レベルごとに +20%)</style> 増加）</style>に変化する。<style=cStack>各スタックは個別のタイマーを持つ。</style>",
    "ITEM_MYSTICSITEMS_GHOSTAPPLEWEAK_NAME": "リンゴの軸",
    "ITEM_MYSTICSITEMS_GHOSTAPPLEWEAK_PICKUP": "体力自動回復がわずかに増加する。",
    "ITEM_MYSTICSITEMS_GHOSTAPPLEWEAK_DESC": "<style=cIsHealing>体力自動回復</style>が <style=cIsUtility>{RegenWeak} HP/秒 <style=cStack>(スタックごとに +{RegenWeak} HP/秒、レベルごとに +20%)</style></style> 増加する。",
    "ITEM_MYSTICSITEMS_COFFEEBOOSTONITEMPICKUP_NAME": "エスプレッソのカップ",
    "ITEM_MYSTICSITEMS_COFFEEBOOSTONITEMPICKUP_PICKUP": "アイテムを拾うとエクスプレス ブーストを獲得し、攻撃速度と移動速度が上昇する。{MaxBuffs}回までスタックし、ステージごとにリセットされる。",
    "ITEM_MYSTICSITEMS_COFFEEBOOSTONITEMPICKUP_DESC": "アイテムを拾うたびに、次のステージまで<style=cIsDamage>攻撃速度</style>と<style=cIsUtility>移動速度</style>を <style=cIsUtility>{BoostPower}%</style> 上昇させる<style=cIsUtility>エクスプレス ブースト</style>を獲得する。ブーストの上限は最大 <style=cIsUtility>{BoostPowerMax}% <style=cStack>(スタックごとに +{BoostPowerMaxPerStack}%)</style></style>。<style=cIsUtility>レア度の高いアイテムほど、一度に多くのエクスプレス ブーストのスタックを獲得できる。</style>",
    "ITEM_MYSTICSITEMS_EXPLOSIVEPICKUPS_NAME": "密輸火薬",
    "ITEM_MYSTICSITEMS_EXPLOSIVEPICKUPS_PICKUP": "ドロップアイテムを拾うと爆発を起こす。",
    "ITEM_MYSTICSITEMS_EXPLOSIVEPICKUPS_DESC": "敵撃破時、<style=cIsUtility>{FlaskDropChance}%</style> の確率で火薬瓶のドロップアイテムを落とす。ドロップアイテム（回復のオーブ、宝物、弾薬箱、火薬瓶など）を拾うと、<style=cIsDamage>{Radius}m <style=cStack>(スタックごとに +{RadiusPerStack}m)</style></style> の爆発を引き起こし、<style=cIsDamage>{Damage}% <style=cStack>(スタックごとに +{DamagePerStack}%)</style></style> の基礎ダメージを与える。",
    "ITEM_MYSTICSITEMS_ALLYDEATHREVENGE_NAME": "ヴェンデッタ",
    "ITEM_MYSTICSITEMS_ALLYDEATHREVENGE_PICKUP": "味方が敵に倒されると、一時的に攻撃速度とダメージが上昇する。",
    "ITEM_MYSTICSITEMS_ALLYDEATHREVENGE_DESC": "味方が敵に<style=cDeath>倒される</style>と、<style=cIsUtility>{Duration}秒間 <style=cStack>(スタックごとに +{DurationPerStack}秒)</style></style>、<style=cIsDamage>攻撃速度</style>が <style=cIsDamage>{AttackSpeed}%</style>、<style=cIsDamage>ダメージ</style>が <style=cIsDamage>{Damage}%</style> 上昇する。",
    "ITEM_MYSTICSITEMS_SPOTTER_NAME": "故障したスポッター",
    "ITEM_MYSTICSITEMS_SPOTTER_PICKUP": "ランダムな敵1体に対するクリティカル率が100%上昇する。",
    "ITEM_MYSTICSITEMS_SPOTTER_DESC": "<style=cIsUtility>{Interval}秒</style>ごとに、ランダムな敵1体 <style=cStack>(スタックごとに +1体)</style>を分析し、<style=cIsUtility>{Duration}秒間</style>、その敵に対する<style=cIsDamage>クリティカル率</style>を <style=cIsDamage>100%</style> 上昇させる。",
    "ITEM_MYSTICSITEMS_SPEEDGIVESDAMAGE_NAME": "核加速器",
    "ITEM_MYSTICSITEMS_SPEEDGIVESDAMAGE_PICKUP": "移動速度が速いほど、与えるダメージが増加する。",
    "ITEM_MYSTICSITEMS_SPEEDGIVESDAMAGE_DESC": "移動速度が <style=cIsUtility>{PassiveSpeed}%</style> 上昇する。<style=cIsUtility>移動速度の上昇1%ごと（アイテムやバフなど）</style>に、ダメージが <style=cIsDamage>{Damage}% <style=cStack>(スタックごとに +{DamagePerStack}%)</style> 増加する</style>。",
    "ITEM_MYSTICSITEMS_EXTRASHRINEUSE_NAME": "ブラック モノリス",
    "ITEM_MYSTICSITEMS_EXTRASHRINEUSE_PICKUP": "すべての祭壇がもう1回追加で使用可能になる。",
    "ITEM_MYSTICSITEMS_EXTRASHRINEUSE_DESC": "すべての祭壇がさらに <style=cIsUtility>+1回 <style=cStack>(スタックごとに +1回)</style></style> 使用可能になる。",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPEN_NAME": "プラチナ カード",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPEN_PICKUP": "マルチショップ ターミナルで追加のアイテムを{Discount}%引きで購入できる（ステージごとに1回）。",
    "ITEM_MYSTICSITEMS_KEEPSHOPTERMINALOPEN_DESC": "マルチショップで購入を行った際、各ステージで他のマルチショップ ターミナルが <style=cIsUtility>1回 <style=cStack>(スタックごとに +1回)</style></style> 閉じることなく利用可能なまま維持され、価格が {Discount}% 割引される。",
    "ITEM_MYSTICSITEMS_MYSTICSWORD_NAME": "秘術の剣",
    "ITEM_MYSTICSITEMS_MYSTICSWORD_PICKUP": "強力な敵を倒すと、ダメージが永久に上昇する。",
    "ITEM_MYSTICSITEMS_MYSTICSWORD_DESC": "<style=cIsHealth>基礎ヘルスが{HealthThreshold}を超える敵 <style=cIsUtility>(エリートのヘルス倍率の有無に関わらず)</style></style>を倒すごとにダメージが <style=cIsDamage>{Damage}%</style> 増加し、最大で <style=cIsDamage>{MaxDamage}% <style=cStack>(スタックごとに +{MaxDamagePerStack}%)</style></style> まで上昇する。",
    "ITEM_MYSTICSITEMS_RHYTHM_NAME": "メトロノーム",
    "ITEM_MYSTICSITEMS_RHYTHM_PICKUP": "プライマリー以外のスキルをリズムに合わせて使用すると、追加のクリティカル率を獲得できる。",
    "ITEM_MYSTICSITEMS_RHYTHM_DESC": "スキルの上に<style=cIsUtility>リズム インジケーター</style>が表示される。セカンダリー、ユーティリティ、またはスペシャル スキルをリズムのタイミングに合わせて使用すると、<style=cIsUtility>ステージ終了まで</style><style=cIsDamage>クリティカル率が +{CritBonus}% <style=cStack>(スタックごとに +{CritBonusPerStack}%)</style></style> 増加する。",
    "ITEM_MYSTICSITEMS_ELITEPOTION_NAME": "失敗した実験",
    "ITEM_MYSTICSITEMS_ELITEPOTION_PICKUP": "エリートの敵を倒すと、その属性効果が周囲の敵に広がる。",
    "ITEM_MYSTICSITEMS_ELITEPOTION_DESC": "エリートの敵を倒すと、半径 <style=cIsUtility>{Radius}m <style=cStack>(スタックごとに +{RadiusPerStack}m)</style></style> 以内のすべての敵にその属性効果を <style=cIsUtility>{Duration}秒間 <style=cStack>(スタックごとに +{DurationPerStack}秒)</style></style> 付与する。",
    "ITEM_MYSTICSITEMS_DRONEWIRES_NAME": "予備配線",
    "ITEM_MYSTICSITEMS_DRONEWIRES_PICKUP": "戦闘中、自分とドローンがダメージを与える火花を放つ。",
    "ITEM_MYSTICSITEMS_DRONEWIRES_DESC": "戦闘中、自分とドローンが時折<style=cIsDamage>電気の火花</style>を落とす。ドローンが落とした火花は敵と接触すると <style=cIsDamage>{Damage}% <style=cStack>(スタックごとに +{DamagePerStack}%)</style></style> の基礎ダメージを与え、プレイヤーが落とした火花は <style=cIsDamage>{PlayerDamage}% <style=cStack>(スタックごとに +{PlayerDamagePerStack}%)</style></style> の基礎ダメージを与える。",
    "ITEM_MYSTICSITEMS_DEATHCEREMONY_NAME": "破滅の儀式",
    "ITEM_MYSTICSITEMS_DEATHCEREMONY_PICKUP": "クリティカル ストライクが敵に印をつける。印がついた敵同士はダメージを共有する。",
    "ITEM_MYSTICSITEMS_DEATHCEREMONY_DESC": "クリティカル率が <style=cIsDamage>{BaseCrit}%</style> 上昇する。クリティカル ストライクが敵に印をつける。印がついた敵がダメージを受けると、他に印がついているすべての敵が与えられたダメージの <style=cIsDamage>{Damage}% <style=cStack>(スタックごとに +{DamagePerStack}%)</style></style> を受ける。<style=cIsUtility>印の持続時間は{Duration}秒。</style>",
    "ITEM_MYSTICSITEMS_NANOMACHINES_NAME": "機能停止したナノマシン",
    "ITEM_MYSTICSITEMS_NANOMACHINES_PICKUP": "ヘルスが{MinHealth}～{MaxHealth}%の間にあるとき、受けるダメージが減少する。",
    "ITEM_MYSTICSITEMS_NANOMACHINES_DESC": "ヘルスが <style=cIsHealing>{MinHealth}～{MaxHealth}%</style> の間、<style=cIsUtility>アーマーが {Armor} <style=cStack>(スタックごとに +{ArmorPerStack})</style></style> 増加する。",
    "ITEM_MYSTICSITEMS_BUFFINTPRANGE_NAME": "パーフェクト ヘッドフォン",
    "ITEM_MYSTICSITEMS_BUFFINTPRANGE_PICKUP": "テレポーターの範囲内にいる間、移動速度が上昇し、受けるダメージが減少する。",
    "ITEM_MYSTICSITEMS_BUFFINTPRANGE_DESC": "テレポーターの範囲内にいる間、<style=cIsUtility>移動速度が {MoveSpeed}% <style=cStack>(スタックごとに +{MoveSpeedPerStack}%)</style></style>、<style=cIsUtility>アーマーが {Armor} <style=cStack>(スタックごとに +{ArmorPerStack})</style></style> 増加する。",
    "ITEM_MYSTICSITEMS_STARBOOK_NAME": "星見の記録",
    "ITEM_MYSTICSITEMS_STARBOOK_PICKUP": "攻撃命中時に確率で星を落とす。落ちた星を拾うと攻撃速度が上昇する。",
    "ITEM_MYSTICSITEMS_STARBOOK_DESC": "攻撃命中時、<style=cIsDamage>{Chance}% の確率</style>で<style=cWorldEvent>星</style>を落とし、<style=cIsDamage>{Damage}% <style=cStack>(スタックごとに +{DamagePerStack}%)</style> の総ダメージ</style>を与える。<style=cWorldEvent>星</style>を拾うと、{Duration}秒間<style=cIsUtility>攻撃速度が {AttackSpeed}% <style=cStack>(スタックごとに +{AttackSpeedPerStack}%)</style></style> 上昇する。",
    "ITEM_MYSTICSITEMS_TIMEPIECE_NAME": "時間拡張器",
    "ITEM_MYSTICSITEMS_TIMEPIECE_PICKUP": "近くの敵と投射物の速度を低下させる。",
    "ITEM_MYSTICSITEMS_TIMEPIECE_DESC": "<style=cIsUtility>{Radius}m</style> 以内のすべての敵の移動速度と攻撃速度が <style=cIsUtility>{Slow}% <style=cStack>(スタックごとに +{SlowPerStack}%)</style> 低下する</style>。その範囲内の敵の投射物の飛翔速度も <style=cIsUtility>{ProjectileSlow}% <style=cStack>(スタックごとに +{ProjectileSlowPerStack}%)</style> 低下する</style>。",
    "ITEM_MYSTICSITEMS_SNOWRING_NAME": "雪の指輪",
    "ITEM_MYSTICSITEMS_SNOWRING_PICKUP": "ダメージを受けた際、確率で近くの敵を凍結させる。",
    "ITEM_MYSTICSITEMS_SNOWRING_DESC": "ダメージを受けた際、<style=cIsUtility>{Chance}%</style> の確率で <style=cIsUtility>{Radius}m <style=cStack>(スタックごとに +{RadiusPerStack}m)</style> 以内のランダムな敵 <style=cIsUtility>{Targets}体 <style=cStack>(スタックごとに +{TargetsPerStack}体)</style> を<style=cIsUtility>凍結</style>させる。</style></style>",
    "ITEM_MYSTICSITEMS_AIRPLANEMODE_NAME": "機内モード",
    "ITEM_MYSTICSITEMS_AIRPLANEMODE_PICKUP": "ユーティリティ スキルが使用不可の間、高い移動速度と追加ジャンプを獲得する。",
    "ITEM_MYSTICSITEMS_AIRPLANEMODE_DESC": "<style=cIsUtility>ユーティリティ</style> スキルが使用不可の間、<style=cIsUtility>移動速度が +{MoveSpeed}% <style=cStack>(スタックごとに +{MoveSpeedPerStack}%)</style></style> 上昇し、<style=cIsUtility>追加ジャンプを1回</style>獲得する。",
    "ITEM_MYSTICSITEMS_VOLTMETER_NAME": "ワイヤレス 電圧計",
    "ITEM_MYSTICSITEMS_VOLTMETER_PICKUP": "シールドが有効な間、受けたダメージを近くの敵に反射する。",
    "ITEM_MYSTICSITEMS_VOLTMETER_DESC": "最大ヘルスの <style=cIsHealing>{PassiveShield}%</style> に相当する<style=cIsHealing>シールド</style>を獲得する。<style=cIsUtility>シールド</style>が有効な間に攻撃を受けると、半径 <style=cIsDamage>{Radius}m</style> 以内の近くの敵に電撃を放ち、受けたダメージの <style=cIsDamage>{Damage}% <style=cStack>(スタックごとに +{DamagePerStack}%)</style></style> を与える。",
    "ITEM_MYSTICSITEMS_THOUGHTPROCESSOR_NAME": "思考プロセッサー",
    "ITEM_MYSTICSITEMS_THOUGHTPROCESSOR_PICKUP": "クールダウンのあるスキルを使用すると、他のすべてのスキルのクールダウンが短縮される。",
    "ITEM_MYSTICSITEMS_THOUGHTPROCESSOR_DESC": "クールダウンのあるスキルを使用すると、使用したスキルのクールダウンの <style=cIsUtility>{CDR}% <style=cStack>(+{CDR}% per stack)</style></style> 分、他のすべてのスキルの<style=cIsUtility>クールダウン</style>が短縮される。",
    "ITEM_MYSTICSITEMS_CRYSTALWORLD_NAME": "結晶化された世界",
    "ITEM_MYSTICSITEMS_CRYSTALWORLD_PICKUP": "テレポーター イベント中、定期的にすべての敵を凍結させる。",
    "ITEM_MYSTICSITEMS_CRYSTALWORLD_DESC": "テレポーター イベント中、近くのすべての敵を <style=cIsUtility>{FreezeTime}秒間</style> <style=cIsUtility>凍結</style>させる。凍結耐性を持つ敵は代わりに<style=cIsUtility>結晶化し、すべてのスキルが封じられ移動不能になる</style>。<style=cIsUtility>{Pulses}回 <style=cStack>(スタックごとに +{PulsesPerStack}回)</style></style> 発生する。",
    "ITEM_MYSTICSITEMS_DASHERDISC_NAME": "タイムリーな処刑",
    "ITEM_MYSTICSITEMS_DASHERDISC_PICKUP": "ヘルス低下時に短時間無敵状態を獲得する。時間経過で再充電される。",
    "ITEM_MYSTICSITEMS_DASHERDISC_DESC": "<style=cIsHealth>ヘルスが25%未満</style>になると実体を失って無敵となり、<style=cIsUtility>{Duration}秒間</style>無敵を獲得して移動速度が <style=cIsUtility>{MoveSpeedBuff}%</style> 上昇する。<style=cIsUtility>{Cooldown}秒 <style=cStack>(スタックごとに -{CooldownReductionPerStack}%)</style></style> ごとに再充電される。",
    "ITEM_MYSTICSITEMS_TREASUREMAP_NAME": "宝の地図",
    "ITEM_MYSTICSITEMS_TREASUREMAP_PICKUP": "各ステージに、埋められたレジェンダリー アイテムの宝の場所が出現する（掘り出すには時間がかかる）。",
    "ITEM_MYSTICSITEMS_TREASUREMAP_DESC": "各ステージに<style=cIsHealth>レジェンダリー アイテム</style>が埋められた{Radius}mの<style=cIsUtility>宝の場所</style>が出現する。宝の場所の中に <style=cIsUtility>{UnearthTime}秒 <style=cStack>(スタックごとに -{ReductionPerStack}%)</style></style> 間留まることで、アイテムを掘り出すことができる。",
    "ITEM_MYSTICSITEMS_IDOL_NAME": "スーパー アイドル",
    "ITEM_MYSTICSITEMS_IDOL_PICKUP": "現在の所持ゴールドに応じて、ヘルスとアーマーが増加する。",
    "ITEM_MYSTICSITEMS_IDOL_DESC": "現在の所持ゴールドに応じて、ヘルスが最大 <style=cIsHealth>{HealthBonus}%</style>、アーマーが最大 <style=cIsUtility>{ArmorBonus}</style> 増加する<style=cIsUtility>（上限 {GoldCap}$ <style=cStack>(スタックごとに -50%)</style>、時間経過で増加）</style>。",
    "ITEM_MYSTICSITEMS_BACKPACK_NAME": "ハイカーのバックパック",
    "ITEM_MYSTICSITEMS_BACKPACK_PICKUP": "すべてのスキルにチャージ +{Charges}。追加ジャンプを獲得する。",
    "ITEM_MYSTICSITEMS_BACKPACK_DESC": "すべてのスキルに最大チャージを <style=cIsUtility>+{Charges} <style=cStack>(スタックごとに +{ChargesPerStack})</style></style> 追加する。スキルのクールダウンを <style=cIsUtility>{CDR}%</style> 短縮する。<style=cIsUtility>追加ジャンプを1回</style>獲得する。",
    "ITEM_MYSTICSITEMS_VYRAELCOMMANDMENTS_NAME": "ヴィラエルの十戒",
    "ITEM_MYSTICSITEMS_VYRAELCOMMANDMENTS_PICKUP": "{Hits}回命中するごとに、命中時効果の追加発動を試みる。",
    "ITEM_MYSTICSITEMS_VYRAELCOMMANDMENTS_DESC": "<style=cIsUtility>{Hits}回</style>命中するごとに、自身の<style=cIsDamage>命中時</style>効果をさらに <style=cIsUtility>1回 <style=cStack>(スタックごとに +1回)</style></style> 追加で発動させようと試みる。",
    "ITEM_MYSTICSITEMS_JUDGEMENTCUT_NAME": "デビルズ クライ",
    "ITEM_MYSTICSITEMS_JUDGEMENTCUT_PICKUP": "クリティカル ストライクが{CritInterval}回発生するごとに、斬撃の乱舞を放つ。",
    "ITEM_MYSTICSITEMS_JUDGEMENTCUT_DESC": "クリティカル率が <style=cIsDamage>{BaseCrit}%</style> 上昇する。クリティカル ストライクが <style=cIsDamage>{CritInterval}回</style>発生するごとに<style=cIsDamage>斬撃の乱舞を放ち</style>、半径 <style=cIsUtility>{Radius}m <style=cStack>(スタックごとに +{RadiusPerStack}m)</style></style> 以内の敵に <style=cIsDamage>{DamagePerSlash}x{SlashCount}% <style=cStack>(スタックごとに +{DamagePerSlash}x{SlashCountPerStack}%)</style></style> のダメージを与える。",
    "ITEM_MYSTICSITEMS_SHIELDUPGRADE_NAME": "充電器アップグレード モジュール",
    "ITEM_MYSTICSITEMS_SHIELDUPGRADE_PICKUP": "再充電するシールドを獲得する。合計シールド量が2倍になる。シールドの再充電が早まる。",
    "ITEM_MYSTICSITEMS_SHIELDUPGRADE_DESC": "最大ヘルスの <style=cIsHealing>{PassiveShield}%</style> に相当する<style=cIsHealing>シールド</style>を獲得する。合計シールド量を <style=cIsUtility>{ShieldBonus}% <style=cStack>(スタックごとに +{ShieldBonusPerStack}%)</style></style> 増加させる。シールドの再充電およびその他の危険離脱時効果が <style=cIsUtility>{RechargeBoost}% <style=cStack>(スタックごとに +{RechargeBoostPerStack}%)</style></style> 早く開始される。",
    "ITEM_MYSTICSITEMS_RIFTLENS_NAME": "リフト レンズ",
    "ITEM_MYSTICSITEMS_RIFTLENS_PICKUP": "各ステージに無料アイテムのあるリフトが出現する… <color=#FF7F7F>ただし、時間内にリフトを閉じなければ死亡する。</color>\n",
    "ITEM_MYSTICSITEMS_RIFTLENS_DESC": "各ステージに無料アイテムのあるリフトが <style=cIsDamage>{BaseRifts}個 <style=cStack>(スタックごとに +{RiftsPerStack}個)</style></style> 出現する。時間内にすべてを閉じられなかった場合、<style=cDeath>死</style>に至る。",
    "ITEM_MYSTICSITEMS_MOONGLASSES_NAME": "ムーングラス",
    "ITEM_MYSTICSITEMS_MOONGLASSES_PICKUP": "クリティカル ストライクのダメージが増加する… <color=#FF7F7F>ただし、クリティカル率が半減する。</color>\n",
    "ITEM_MYSTICSITEMS_MOONGLASSES_DESC": "クリティカル ストライクのダメージが <style=cIsDamage>{CritDamageIncrease}% <style=cStack>(スタックごとに +{CritDamageIncreasePerStack}%)</style></style> 増加する。<style=cIsUtility>1スタックごとにクリティカル率が半減する。</style>",
    "ITEM_MYSTICSITEMS_REGENANDDIFFICULTYSPEED_NAME": "クロノスのパズル",
    "ITEM_MYSTICSITEMS_REGENANDDIFFICULTYSPEED_PICKUP": "味方全体の体力自動回復を加速させる… <color=#FF7F7F>ただし、難易度の上昇速度も加速する。</color>\n",
    "ITEM_MYSTICSITEMS_REGENANDDIFFICULTYSPEED_DESC": "すべての味方の<style=cIsHealing>基礎体力自動回復が {BaseRegenIncrease} HP/秒 <style=cStack>(スタックごとに +{BaseRegenIncreasePerStack} HP/秒、レベルごとに +20%)</style></style> 増加する。時間経過による難易度の上昇速度が <style=cIsUtility>{TimerSpeedIncrease}% <style=cStack>(スタックごとに +{TimerSpeedIncreasePerStack}%)</style></style> 早くなる。",
    "EQUIPMENT_MYSTICSITEMS_ARCHAICMASK_NAME": "伝説の仮面",
    "EQUIPMENT_MYSTICSITEMS_ARCHAICMASK_PICKUP": "アーカイック ウィスプを味方として召喚する。{Duration}秒間持続。",
    "EQUIPMENT_MYSTICSITEMS_ARCHAICMASK_DESC": "<style=cIsDamage>{WispDamage}% のダメージ</style>、<style=cIsHealing>{WispHealth}% のヘルス</style>、<style=cIsUtility>{WispCDR}% のクールダウン短縮</style>、および<style=cIsDamage>{WispAttackSpeed}% の攻撃速度</style>を持つ<style=cIsDamage>アーカイック ウィスプ</style>を味方として召喚する。{Duration}秒間持続する。",
    "EQUIPMENT_MYSTICSITEMS_PRINTERHACKER_NAME": "ワイヤーハック レンチ",
    "EQUIPMENT_MYSTICSITEMS_PRINTERHACKER_PICKUP": "3Dプリンターのアイテムを無料で{Amount}個入手し、その後プリンターを破壊する。",
    "EQUIPMENT_MYSTICSITEMS_PRINTERHACKER_DESC": "3Dプリンターのアイテムを<style=cIsUtility>無料</style>で<style=cIsUtility>{Amount}</style>個入手し、その後プリンターを<style=cIsDamage>破壊</style>して永久に使用不能にする。",
    "EQUIPMENT_MYSTICSITEMS_MICROPHONE_NAME": "ヴィンテージ マイク",
    "EQUIPMENT_MYSTICSITEMS_MICROPHONE_PICKUP": "前方の敵を難聴状態にし、ステータスを大幅に低下させる。空中で使用すると後方に自身を加速させる。",
    "EQUIPMENT_MYSTICSITEMS_MICROPHONE_DESC": "前方の敵を<style=cIsUtility>{Duration}秒間</style><style=cIsDamage>難聴</style>状態にし、移動速度を <style=cIsUtility>{MoveSpeedReduction}%</style>、アーマーを <style=cIsUtility>{ArmorReduction}</style>、攻撃速度を <style=cIsDamage>{AttackSpeedReduction}%</style>、ダメージを <style=cIsDamage>{DamageReduction}%</style> 低下させる。空中で使用した場合、反対方向に自身を<style=cIsUtility>加速</style>させる。",
    "EQUIPMENT_MYSTICSITEMS_SIRENPOLE_NAME": "警報システム",
    "EQUIPMENT_MYSTICSITEMS_SIRENPOLE_PICKUP": "テレポーターのアイテム効果を発動させるサイレン ポールを設置する。",
    "EQUIPMENT_MYSTICSITEMS_SIRENPOLE_DESC": "<style=cIsUtility>テレポーターとして機能し、テレポーター イベント発生時のあらゆる効果を発動させる</style>自動充電式サイレン ポールを設置し、充電が{WaveSpawnInterval}%進むごとに弱い敵を召喚する。充電完了までに<style=cIsUtility>{ChargeTime}s</style>かかる。\r\n\r\n未充電のサイレン ポールがすでに存在する場合は使用できない。",
    "EQUIPMENT_MYSTICSITEMS_MECHANICALARM_NAME": "メカニカル アーム",
    "EQUIPMENT_MYSTICSITEMS_MECHANICALARM_PICKUP": "前方を殴打し、装備のクールダウン中に発生させたクリティカル ストライクごとにダメージが増加する。",
    "EQUIPMENT_MYSTICSITEMS_MECHANICALARM_DESC": "この装備を所持している間、クリティカル率が <style=cIsDamage>{BaseCrit}%</style> 上昇する。\r\n\r\n前方に向けて殴打し、<style=cIsDamage>{Damage}% のダメージ + {DamageBonusPerCharge}% のダメージ（装備のクールダウン中に発生させたクリティカル ストライクごと）</style>を与える。",
    "EQUIPMENT_MYSTICSITEMS_OMARHACKTOOL_NAME": "オマールより愛をこめて",
    "EQUIPMENT_MYSTICSITEMS_OMARHACKTOOL_PICKUP": "チェストまたは祭壇をハッキングして無料にする。各ステージ1回のみ。",
    "EQUIPMENT_MYSTICSITEMS_OMARHACKTOOL_DESC": "チェストまたは祭壇をハッキングし、そのコストを <style=cIsUtility>$0</style> にする。各ステージで <style=cIsUtility>1</style> 回のみ使用可能、<style=cIsUtility>装備チャージを追加することで使用回数制限が増加する</style>。",
    "EQUIPMENT_MYSTICSITEMS_EQUIPMENTEATER_NAME": "リガルジテーター",
    "EQUIPMENT_MYSTICSITEMS_EQUIPMENTEATER_PICKUP": "装備品に狙いを定めてアイテムのスクラップに分解する。",
    "EQUIPMENT_MYSTICSITEMS_EQUIPMENTEATER_DESC": "装備品に狙いを定めて<style=cIsUtility>分解</style>し、<style=cIsUtility>{Amount}</style>個のアイテムのスクラップにする（{WhiteChance}%/<style=cIsHealing>{GreenChance}%</style>/<style=cIsHealth>{RedChance}%</style>/<style=cShrine>{YellowChance}%</style>）。",
    "EQUIPMENT_MYSTICSITEMS_TUNINGFORK_NAME": "レシオ イコライザー",
    "EQUIPMENT_MYSTICSITEMS_TUNINGFORK_PICKUP": "<color=#FF7F7F>近くのすべてのキャラクター</color>の現在のヘルス割合を、<color=#FF7F7F>自分</color>の現在のヘルス割合と同じにする。",
    "EQUIPMENT_MYSTICSITEMS_TUNINGFORK_DESC": "半径{Radius}m以内のすべてのキャラクターの現在のヘルス割合を、<style=cIsUtility>自分のヘルス割合</style>と同じにする。",
    "EQUIPMENT_MYSTICSITEMS_GATECHALICE_NAME": "ゲートの杯",
    "EQUIPMENT_MYSTICSITEMS_GATECHALICE_PICKUP": "次のステージへ即座にテレポートする。時間を短縮できるが、<color=#FF7F7F>未開封のチェストのアイテムを取り逃すことになる。</color>",
    "EQUIPMENT_MYSTICSITEMS_GATECHALICE_DESC": "次のステージへテレポートする。時間短縮に利用できるが、<style=cIsUtility>チェストを開けずにステージをスキップすることで戦力不足に陥るリスクがある</style>。",
    "EQUIPMENT_MYSTICSITEMS_FRAGILEMASK_NAME": "脆い仮面",
    "EQUIPMENT_MYSTICSITEMS_FRAGILEMASK_PICKUP": "使用して切り替える。有効な間はダメージが{DamageMultiplier}倍になるが、<color=#FF7F7F>どんなダメージを受けても即死する</color>。",
    "EQUIPMENT_MYSTICSITEMS_FRAGILEMASK_DESC": "使用して切り替える。有効な間、<style=cIsDamage>基礎ダメージが {BaseDamageBonus}% 増加</style>し、<style=cDeath>あらゆるダメージで即死する</style>。",
    "ACHIEVEMENT_MYSTICSITEMS_ESCAPEMOONALONE_NAME": "ラスト オブ アス",
    "ACHIEVEMENT_MYSTICSITEMS_ESCAPEMOONALONE_DESCRIPTION": "チームで唯一生き残った味方として、ラスボスにとどめの一撃を与える。",
    "ACHIEVEMENT_MYSTICSITEMS_REPAIRBROKENSPOTTER_NAME": "敵発見",
    "ACHIEVEMENT_MYSTICSITEMS_REPAIRBROKENSPOTTER_DESCRIPTION": "脱出ポッドの燃料アレイを湿った根のジャングルに持ち込み、壊れたスポッター ドローンを修理する。",
    "ACHIEVEMENT_MYSTICSITEMS_FINDARCHAICMASK_NAME": "命を燃やせ",
    "ACHIEVEMENT_MYSTICSITEMS_FINDARCHAICMASK_DESCRIPTION": "焦土で伝説の仮面が冷めきる前（10分未満）に拾い上げる。",
    "ACHIEVEMENT_MYSTICSITEMS_MULTISHOPTERMINALSONLY_NAME": "スマート ショッパー",
    "ACHIEVEMENT_MYSTICSITEMS_MULTISHOPTERMINALSONLY_DESCRIPTION": "ステージ6まで、マルチショップ ターミナル以外でゴールドを消費しない。犠牲のアーティファクトが有効な間は達成不可。",
    "ACHIEVEMENT_MYSTICSITEMS_HELLSPEEDRUN_NAME": "灼熱突破",
    "ACHIEVEMENT_MYSTICSITEMS_HELLSPEEDRUN_DESCRIPTION": "底知れぬ海底を3分未満でクリアする。",
    "ACHIEVEMENT_MYSTICSITEMS_REACHHIGHPOINT_NAME": "頂上",
    "ACHIEVEMENT_MYSTICSITEMS_REACHHIGHPOINT_DESCRIPTION": "再集結地デルタの最高地点に到達する。",
    "ACHIEVEMENT_MYSTICSITEMS_BLOCKDAMAGEWITHARMOR_NAME": "かすり傷さ",
    "ACHIEVEMENT_MYSTICSITEMS_BLOCKDAMAGEWITHARMOR_DESCRIPTION": "ダメージ軽減効果を使用して、合計10,000ダメージを軽減する。",
    "ACHIEVEMENT_MYSTICSITEMS_MANYALLIES_NAME": "たくさんのファン！",
    "ACHIEVEMENT_MYSTICSITEMS_MANYALLIES_DESCRIPTION": "機械系およびプレイヤー以外の味方を10体獲得する。",
    "ACHIEVEMENT_MYSTICSITEMS_HACKLEGENDARYCHEST_NAME": "パイレーツ オブ カリスケアン",
    "ACHIEVEMENT_MYSTICSITEMS_HACKLEGENDARYCHEST_DESCRIPTION": "レジェンダリー チェストを無料で開ける。",
    "ACHIEVEMENT_MYSTICSITEMS_WOOLIERUSH_NAME": "リズムをキープ",
    "ACHIEVEMENT_MYSTICSITEMS_WOOLIERUSH_DESCRIPTION": "どのステージでも5分以上費やすことなく、最終ステージに到達する。",
    "ACHIEVEMENT_MYSTICSITEMS_FREEZELOCKENEMY_NAME": "頭を冷やせ！",
    "ACHIEVEMENT_MYSTICSITEMS_FREEZELOCKENEMY_DESCRIPTION": "敵を7秒間連続で凍結状態にし続ける。",
    "ARCHWISP_BODY_NAME": "アーカイック ウィスプ",
    "MYSTICSITEMS_RIFTCHEST_NAME": "不安定なリフト",
    "MYSTICSITEMS_RIFTCHEST_CONTEXT": "不安定なリフトを閉じる",
    "MYSTICSITEMS_BROKENSPOTTER_NAME": "壊れたスポッター ドローン",
    "MYSTICSITEMS_BROKENSPOTTER_CONTEXT": "修理する",
    "MYSTICSITEMS_ARCHAICMASK_CONTEXT": "伝説の仮面を取る",
    "MYSTICSITEMS_SIRENPOLE_NAME": "サイレン ポール",
    "MYSTICSITEMS_SHRINE_LEGENDARY_NAME": "伝説の祭壇 [Mystic's Items]",
    "MYSTICSITEMS_SHRINE_LEGENDARY_CONTEXT": "伝説の祭壇に捧げ物をする",
    "MYSTICSITEMS_SHRINE_LEGENDARY_USE_MESSAGE_2P": "<style=cShrine>あなたは伝説の具現となった。</style>",
    "MYSTICSITEMS_SHRINE_LEGENDARY_USE_MESSAGE": "<style=cShrine>{0}は伝説の具現となった。</style>",
    "COST_MYSTICSITEMS_RIFTLENSDEBUFF_FORMAT": "{0} リフト ビジョン",
    "OBJECTIVE_MYSTICSITEMS_CHARGE_TREASUREMAPZONE": "<color=#F8EB27>埋もれたレジェンダリー アイテム</color>を掘り出す ({0}%)",
    "OBJECTIVE_MYSTICSITEMS_CHARGE_TREASUREMAPZONE_OOB": "<color=#F8EB27>埋もれたレジェンダリー アイテム</color>を見つけて掘り出す ({0}%)",
    "OBJECTIVE_MYSTICSITEMS_CHARGE_SIRENPOLE": "<color=#EA5821>サイレン ポール</color>が充電中 ({0}%, 自動)",
    "OBJECTIVE_MYSTICSITEMS_CHARGE_SIRENPOLE_OOB": "<color=#EA5821>サイレン ポール</color>が充電中 ({0}%, 自動)",
    "OBJECTIVE_MYSTICSITEMS_RIFTLENS_FLAVOUR": "不安定なリフトを検知！",
    "OBJECTIVE_MYSTICSITEMS_RIFTLENS_CLOSE_RIFTS": "すべての<color=#66ADFF>不安定なリフト</color>を閉じろ！ ({0}/{1})",
    "SKILL_MYSTICSITEMS_CRYSTALLIZED_NAME": "結晶化",
    "SKILL_MYSTICSITEMS_CRYSTALLIZED_DESCRIPTION": "<color=#FF7F7F>スキルを使用できない。</color>",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_0_2P": "時間切れだ！",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_0": "{0}は時間切れになった！",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_1_2P": "重圧に耐えきれなかった。",
    "PLAYER_DEATH_QUOTE_MYSTICSITEMS_RIFTLENS_1": "{0}は重圧に耐えきれなかった。",
