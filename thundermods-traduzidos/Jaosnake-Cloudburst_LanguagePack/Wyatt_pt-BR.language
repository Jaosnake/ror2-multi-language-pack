{
  "pt-BR": {
    "CLOUDBURST_WYATT_NAME": "Custodian",
    "CLOUDBURST_WYATT_SUBTITLE": "Máquinas de Limpeza Implacáveis",
    "CLOUDBURST_WYATT_OUTRO_FLAVOR": "...e assim eles partiram, um trabalho bem-feito",
    "CLOUDBURST_WYATT_OUTRO_FAILURE": "...e assim eles desapareceram, deixando uma bagunça maior do que quando começaram",
    "CLOUDBURST_WYATT_DESCRIPTION": "O Custodian é um mestre da guerra de zeladoria que manipula a gravidade de seus inimigos a seu favor.<color=#CCD3E0>\n\n< ! > Encadeie combos com a Grav-Vassoura para erguer os inimigos cada vez mais alto.\n\n< ! > Crave inimigos com Lixo pra Fora após terem sido lançados ao ar com a Grav-Vassoura e a MAID para causar muito dano!\n\n< ! > Use o pulo duplo de Fluxo para emendar combos aéreos nos inimigos, ou use a armadura para escapar de uma situação difícil.\n\n< ! > Use a MAID para lançar inimigos ao ar e se reposicionar para continuar seus combos.\n\n</color>",
    "CLOUDBURST_WYATT_LORE": "Não posso parar agora. Não posso parar agora. Cada passo que dou é um passo sem volta. Custe o que custar, eu vou encontrá-lo.\n\nÉ tudo um ritmo, apenas um ritmo. Cada vez que saio da linha é uma punição. Vou obedecer ao embalo. Nada pode me parar agora.\n\nCada cicatriz vale a pena. Posso sentir, estou chegando mais perto. Eu vou tê-lo, e ele será meu.\n\nNão importa o sangue, vale a pena. Vou encontrar o que quero e voltarei para casa.\n\nNão importa quantos eu massacre, ele será meu... Não pode se esconder de mim para sempre.\n\nEstá aqui, posso sentir. Este baú de segurança o guarda. Eu o arrombo e o encontro.\n\nEle... finalmente é meu. Eu o seguro em minhas mãos machucadas. Será que realmente se passaram anos?\n\nEla vai adorar isso, eu sei.\n\n",
    "KEYWORD_WEIGHTLESS": "<style=cKeywordName>Sem Peso</style><style=cSub><style=cIsUtility>Remove a gravidade</style> do alvo e <style=cIsUtility>reduz a velocidade de movimento e de ataque</style>.</style>",
    "KEYWORD_SPIKED": "<style=cKeywordName>Cravar</style><style=cSub>Força um inimigo a cair para baixo, gerando uma <style=cIsDamage>onda de choque</style> ao atingir o chão, causando <style=cIsDamage>200% de dano</style> + <style=cIsDamage>30% de dano</style> por metro de queda.</style>",
    "KEYWORD_FLOW": "<style=cKeywordName>Fluxo</style><style=cSub>Ganhe <style=cIsDamage>30 de armadura</style> + <style=cIsDamage>5 de armadura</style> para cada acúmulo de <style=cIsUtility>Embalo</style>.\nGanhe um <style=cIsUtility>Pulo Duplo</style>.\nGanhe <style=cIsUtility>+30% de Redução de Recarga.</style></style>",
    "CLOUDBURST_WYATT_PASSIVE_NAME": "Walkman",
    "CLOUDBURST_WYATT_PASSIVE_DESCRIPTION": "Ao golpear, ganhe um acúmulo de <style=cIsUtility>Embalo</style>, concedendo <style=cIsUtility>20% de velocidade de movimento</style> por acúmulo. Diminui fora de combate.",
    "CLOUDBURST_WYATT_PRIMARY_COMBO_NAME": "Grav-Vassoura G22",
    "CLOUDBURST_WYATT_PRIMARY_COMBO_DESCRIPTION": "<style=cIsUtility>Ágil</style>. Balance sua vassoura causando <style=cIsDamage>100% de dano</style>. Cada terceiro acerto causa <style=cIsDamage>200% de dano</style> e aplica <style=cIsUtility>Sem Peso</style>.",
    "CLOUDBURST_WYATT_SECONDARY_TRASHOUT_NAME": "Lixo pra Fora",
    "CLOUDBURST_WYATT_SECONDARY_TRASHOUT_DESCRIPTION": "<s>Dispare um guincho</s> Voe magicamente em direção a um inimigo, atinja-o causando <style=cIsDamage>300%</style> de dano e <style=cIsDamage>crave-o</style>.",
    "CLOUDBURST_WYATT_UTILITY_FLOW_NAME": "Fluxo",
    "CLOUDBURST_WYATT_UTILITY_FLOW_DESCRIPTION": "Ative <style=cIsDamage>Fluxo</style> por <style=cIsUtility>4 segundos</style> + <style=cIsUtility>0,4 segundos</style> para cada acúmulo de <style=cIsUtility>Embalo</style>, ganhando <style=cIsDamage>armadura, um pulo duplo e redução de recarga</style>. Durante o <style=cIsDamage>Fluxo</style>, você não pode perder nem ganhar <style=cIsUtility>Embalo</style>. Após o término de <style=cIsDamage>Fluxo</style>, perca todos os acúmulos de <style=cIsUtility>Embalo</style>.",
    "CLOUDBURST_WYATT_SPECIAL_MAID_NAME": "M88 MAID",
    "CLOUDBURST_WYATT_SPECIAL_MAID_DESCRIPTION": "Envie sua unidade <style=cIsUtility>MAID</style> avançando através dos inimigos causando <style=cIsDamage>300% de dano</style> antes de parar brevemente e retornar a você. Ative novamente para se puxar em direção à <style=cIsUtility>MAID</style> e explodir causando <style=cIsDamage>500% de dano</style>, aplicando <style=cIsUtility>Sem Peso</style>.",
    "CLOUDBURST_WYATT_CLASSIC_SKIN": "Clássico",
    "ACHIEVEMENT_CLOUDBURSTWYATTCLEARGAMEMONSOON_NAME": "Custodian: Maestria",
    "ACHIEVEMENT_CLOUDBURSTWYATTCLEARGAMEMONSOON_DESCRIPTION": "Como Custodian, vença o jogo ou oblitere-se no Monsoon."
  }
