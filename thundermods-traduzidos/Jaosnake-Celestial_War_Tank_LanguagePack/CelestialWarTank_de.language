    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BROWN_SKIN_NAME": "BRAUN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_UNITED_STATES_SKIN_NAME": "VEREINIGTE STAATEN",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GERMANY_SKIN_NAME": "DEUTSCHLAND",
