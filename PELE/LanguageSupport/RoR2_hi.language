    "ACHIEVEMENT_HARDHITTER_NAME": "महाबली",
    "ACHIEVEMENT_HARDHITTER_DESCRIPTION": "एक ही वार में 5000 क्षति पहुँचाएँ।",
    "ACHIEVEMENT_CARRYLUNARITEMS_NAME": "चंद्र उपासक",
    "ACHIEVEMENT_CARRYLUNARITEMS_DESCRIPTION": "एक ही अभियान में 5 चंद्र वस्तुएँ अपने पास रखें।",
    "ACHIEVEMENT_CHARGETELEPORTERWHILENEARDEATH_NAME": "गौरवशाली युद्ध",
    "ACHIEVEMENT_CHARGETELEPORTERWHILENEARDEATH_DESCRIPTION": "10% से कम स्वास्थ्य के साथ टेलीपोर्टर चार्ज करें।",
    "ACHIEVEMENT_COMPLETEMULTIBOSSSHRINE_NAME": "उत्कृष्ट",
    "ACHIEVEMENT_COMPLETEMULTIBOSSSHRINE_DESCRIPTION": "2 पर्वत के देवालय सक्रिय करने के बाद टेलीपोर्टर बॉस को हराएँ।",
    "ACHIEVEMENT_COMPLETETELEPORTER_NAME": "प्रगति",
    "ACHIEVEMENT_COMPLETETELEPORTER_DESCRIPTION": "एक टेलीपोर्टर घटना पूरी करें।",
    "ACHIEVEMENT_COMPLETETHREESTAGES_NAME": "योद्धा",
