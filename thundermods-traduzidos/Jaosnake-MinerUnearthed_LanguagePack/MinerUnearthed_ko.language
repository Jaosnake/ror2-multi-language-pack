        "MINER_UNLOCKABLE_UNLOCKABLE_NAME": "아드레날린 러시",
        "MINER_UNLOCKABLE_ACHIEVEMENT_DESC": "전설 상자를 엽니다.",
        "MINER_ALTUNLOCKABLE_ACHIEVEMENT_NAME": "Forged in Flames",
        "MINER_ALTUNLOCKABLE_UNLOCKABLE_NAME": "불길 속에서 단련됨",
        "MINER_ALTUNLOCKABLE_ACHIEVEMENT_DESC": "Abyssal Depths의 독특한 수호자를 처치하세요.",
        "MINER_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Grand Mastery",
        "MINER_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "광부: 그랜드 마스터리",
        "MINER_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "광부가 되어 Typhoon 또는 Eclipse에서 게임을이기거나 없애십시오.\n<color=#8888>(Typhoon 난이도에는 Starstorm 2가 필요함)</color>",
        "MINER_MONSOONUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Mastery",
        "MINER_MONSOONUNLOCKABLE_UNLOCKABLE_NAME": "광부: 특화",
        "MINER_MONSOONUNLOCKABLE_ACHIEVEMENT_DESC": "광부로 게임을 승리하거나 몬순에서 말살하세요.",
        "MINER_CRUSHUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Pillaged Gold",
        "MINER_CRUSHUNLOCKABLE_UNLOCKABLE_NAME": "광부: 약탈된 금",
        "MINER_CRUSHUNLOCKABLE_ACHIEVEMENT_DESC": "광부로서 Gilded Coast의 고유한 수호자에게 12중첩의 분열을 적용하십시오.",
        "MINER_CRACKUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Junkie",
        "MINER_CRACKUNLOCKABLE_UNLOCKABLE_NAME": "광부: 마약 중독자",
        "MINER_CRACKUNLOCKABLE_ACHIEVEMENT_DESC": "광부로서 아드레날린 50중첩을 얻으세요.",
        "MINER_CAVEINUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Compacted",
        "MINER_CAVEINUNLOCKABLE_UNLOCKABLE_NAME": "광부: 압축됨",
        "MINER_CAVEINUNLOCKABLE_ACHIEVEMENT_DESC": "광부로 백블라스트 한 번으로 적 20명을 공격하십시오.",
        "MINER_PUPLEUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: The Five Keys",
        "MINER_PUPLEUNLOCKABLE_UNLOCKABLE_NAME": "광부: 다섯 개의 열쇠",
        "MINER_PUPLEUNLOCKABLE_ACHIEVEMENT_DESC": "광부가 되어 G-N-O-M-E의 디버깅 비밀을 알아내세요.",
        "MINER_TUNDRAUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Frozen",
        "MINER_TUNDRAUNLOCKABLE_UNLOCKABLE_NAME": "광부: 냉동",
        "MINER_TUNDRAUNLOCKABLE_ACHIEVEMENT_DESC": "광부로 8분 안에 Rallypoint Delta에 도달하세요.",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Tempered",
        "MINER_BLACKSMITHUNLOCKABLE_UNLOCKABLE_NAME": "광부: 단련됨",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_DESC": "광부가 되어 행성에서 대장간 도구를 찾으세요.",
        "FATACRID_BODY_NAME": "페로 그란데",
        "FATACRID_BODY_SUBTITLE": "(포르마 기간테)",
        "DIGGERPLUGIN_DIRESEEKER_BODY_NAME": "절박한 구도자",
        "DIGGERPLUGIN_DIRESEEKER_BODY_SUBTITLE": "추적 사살",
        "DIGGERPLUGIN_DIRESEEKER_BODY_LORE": "전설에 따르면 한때 페트리코프 V의 지하 막사를 배회했던 괴물 짐승이 있다고 합니다.\n\n가장 용감한 생존자와 가장 사악한 괴물들도 두려워한 이 거대한 짐승은 독보적이었습니다. 지옥불로 단련된 핏빛 붉은 비늘을 입고 불타는 노란색 눈과 강렬한 눈빛으로 아주 큰 생물들을 흔적도 없이 죽이고 있었습니다.연기가 자욱한 숨결은 순식간에 금속이 녹을 정도로 뜨거웠습니다.\n\n프로비던스를 죽일 수 있을 정도로 강력한 생존자가 왔을떄, 마침내 그 짐승은 상대를 만났다고 믿었습니다.\n\n<style=cIsHealth>다시 한 번 무서운 얼굴을 보여줄 때까지.</style>",
        "DIGGERPLUGIN_DIRESEEKER_BODY_OUTRO_FLAVOR": "..그리하여 그것은 떠났다. 새로운 먹이를 찾으러.",
        "DIGGERPLUGIN_DIRESEEKER_BODY_DEFAULT_SKIN_NAME": "기본"
    }
}