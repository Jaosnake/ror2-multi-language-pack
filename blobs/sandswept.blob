				if (Object.op_Implicit((Object)(object)val) && Object.op_Implicit((Object)(object)component))
				{
					int count = GetCount(val);
					if (count > 0)
					{
						float num = damageInfo.damage / val.damage;
						if (val.HasBuff(readyBuff) && num >= percentDamageThreshold)
						{
							flag = true;
							float num2 = 1f / damageScalar;
							float num3 = num * num2;
							float num4 = baseBleedCount + stackBleedCount * (float)(count - 1);
							float num5 = (float)Mathf.RoundToInt(num3) * num4;
							for (int i = 0; (float)i < num5; i++)
							{
								DotController.InflictDot(victim, attacker, (DotIndex)0, 4f * damageInfo.procCoefficient, 1f, (uint?)uint.MaxValue);
							}
							for (int j = 0; j < 2; j++)
							{
								Util.PlaySound("Play_vulture_attack1_impact", victim);
								Util.PlaySound("Play_imp_impact", victim);
								Util.PlaySound("Play_gravekeeper_attack2_impact", victim);
								Util.PlaySound("Play_lunar_wisp_impact", victim);
							}
							Util.PlaySound("Play_item_proc_dagger_impact", attacker);
							Util.PlaySound("Play_vulture_attack1_impact", attacker);
							Util.PlaySound("Play_vulture_attack1_impact", attacker);
							Util.PlaySound("Play_vulture_death_land_thud", attacker);
							EffectManager.SpawnEffect(vfx, new EffectData
							{
								origin = component.corePosition,
								rotation = Quaternion.identity
							}, true);
							EffectManager.SpawnEffect(vfx2, new EffectData
							{
								origin = component.corePosition,
								rotation = Quaternion.identity,
								scale = component.radius * 1.5f
							}, true);
							ModelLocator modelLocator = component.modelLocator;
							if (Object.op_Implicit((Object)(object)modelLocator))
							{
								Transform modelTransform = modelLocator.modelTransform;
								if (Object.op_Implicit((Object)(object)modelTransform))
								{
									TemporaryOverlayInstance val2 = TemporaryOverlayManager.AddOverlay(((Component)modelTransform).gameObject);
									val2.duration = 3f;
									val2.animateShaderAlpha = true;
									val2.alphaCurve = AnimationCurve.EaseInOut(0f, 1f, 1f, 0f);
									val2.destroyComponentOnEnd = true;
									val2.originalMaterial = bleedingMat;
									val2.inspectorCharacterModel = ((Component)modelTransform).GetComponent<CharacterModel>();
								}
							}
						}
					}
				}
			}
			orig.Invoke(self, damageInfo, victim);
			if (flag && val.HasBuff(readyBuff))
			{
				val.RemoveBuff(readyBuff);
				for (int k = 1; (float)k <= cooldown; k++)
				{
					val.AddTimedBuff(cooldownBuff, (float)k);
				}
			}
		}

