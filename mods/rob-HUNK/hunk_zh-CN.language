        "ROB_HUNK_WRISTBANDCHEST_NAME": "特殊武器箱",
        "ROB_HUNK_WRISTBANDCHEST_CONTEXT": "开启特殊武器箱",
        "ROB_WRISTBANDCOST": "ID 腕带",
        "ROB_HUNK_STARSBADGECHEST_NAME": "S.T.A.R.S. 箱子",
        "ROB_HUNK_STARSBADGECHEST_CONTEXT": "开启 S.T.A.R.S. 箱子",
