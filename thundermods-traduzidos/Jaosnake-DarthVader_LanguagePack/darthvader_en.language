{
    "en": {
        "POPCORN_DARTHVADER_BODY_NAME": "Darth Vader",
        "POPCORN_DARTHVADER_BODY_DESCRIPTION": "Darth Vader is a relentless powerhouse whose connection to the dark side of the Force converts vitality and momentum into raw destruction.<color=#CCD3E0>\n\n< ! > Instead, Attackspeed bonuses are converted to Damage and Movespeed bonuses are converted to Armor.\n\n< ! > Rage Unleashed uncaps Attackspeed and Movespeed as well as granting the bonuses as well.\n\n< ! > Force affects everything in front of you in a cone shape.\n\n</color>",
        "POPCORN_DARTHVADER_BODY_SUBTITLE": "The Chosen One",
        "POPCORN_DARTHVADER_BODY_LORE": "Fear is the path to the dark side. Fear leads to anger. Anger leads to hate. Hate leads to suffering.\n\nOnce a promising Jedi prophesied to bring balance to the Force, Anakin Skywalker fell to darkness, consumed by grief and the seduction of power. Reborn in cybernetic armor as the Sith Lord Darth Vader, he became the ultimate enforcer of the Galactic Empire.\n\nNow stranded on this alien world, the dark lord seeks only absolute subjugation.",
        "POPCORN_DARTHVADER_BODY_OUTRO_FLAVOR": "..For one more second, he felt the light.",
        "POPCORN_DARTHVADER_BODY_OUTRO_FAILURE": "..He left full of rage and hate, ready for more training.",
        "POPCORN_DARTHVADER_BODY_DEFAULT_SKIN_NAME": "Red Lightsaber",
        "POPCORN_DARTHVADER_BODY_BLUESABER_SKIN_NAME": "Blue Lightsaber",
        "POPCORN_DARTHVADER_BODY_YELLOWSABER_SKIN_NAME": "Yellow Lightsaber",
        "POPCORN_DARTHVADER_BODY_DARKSABER_SKIN_NAME": "Darksaber",
        "POPCORN_DARTHVADER_BODY_PASSIVE_NAME": "The Chosen One",
        "POPCORN_DARTHVADER_BODY_PASSIVE_DESCRIPTION": "Attackspeed bonuses are converted to Damage. Movespeed bonuses are converted to Armor.",
        "POPCORN_DARTHVADER_BODY_PASSIVE_COOLDOWN_NAME": "Cooldown based",
        "POPCORN_DARTHVADER_BODY_PASSIVE_COOLDOWN_DESCRIPTION": "Skills have cooldowns, melee attacks reduce all cooldowns by 1 second.\nReduced fallspeed, holding jump fastfalls.",
        "POPCORN_DARTHVADER_BODY_PASSIVE_ENERGY_NAME": "Energy based",
        "POPCORN_DARTHVADER_BODY_PASSIVE_ENERGY_DESCRIPTION": "Skills have energy costs, regenerate 2.5% energy per second, melee attacks regen 10 energy, scaling with attackspeed.\nStock-based items increases total energy. Cooldown-based items decreases energy costs.\nHolding jump allows Darth Vader to super jump at a cost, holding it also slows down his fall at a cost.",
        "POPCORN_DARTHVADER_BODY_PRIMARY_SLASH_NAME": "Lightsaber",
        "POPCORN_DARTHVADER_BODY_PRIMARY_SLASH_DESCRIPTION": "<style=cIsUtility>Agile.</style> Swing forward for <style=cIsDamage>200% damage</style>.",
        "POPCORN_DARTHVADER_BODY_SECONDARY_FORCE_NAME": "Force Push/Pull",
        "POPCORN_DARTHVADER_BODY_SECONDARY_FORCE_DESCRIPTION": "<style=cIsUtility>Agile.</style> Tap to push enemies for <style=cIsDamage>350% damage</style>. Hold to pull enemies for <style=cIsDamage>400% damage</style>. Strength depends on the distance between the enemy and yourself. Weaker when in Rage Unleashed.",
        "POPCORN_DARTHVADER_BODY_UTILITY_DEFLECT_NAME": "Deflect",
        "POPCORN_DARTHVADER_BODY_UTILITY_DEFLECT_DESCRIPTION": "<style=cIsUtility>Deflect all attacks for 6 seconds</style> for <style=cIsDamage>2x the damage, multiplied by luck</style>. Movespeed is halved and you're unable to attack with your lightsaber while deflecting.",
        "POPCORN_DARTHVADER_BODY_SPECIAL_RAGE_NAME": "Rage Unleashed",
        "POPCORN_DARTHVADER_BODY_SPECIAL_RAGE_DESCRIPTION": "Unleashes your rage, <style=cIsHealing>fully healing yourself</style> and <style=cIsUtility>removing your attackspeed and movespeed limiters</style>. <style=cIsDamage>Double your attackspeed, movespeed and armor as well as remove all cooldowns for 15 seconds</style>.",
        "ACHIEVEMENT_POPCORN_DARTHVADER_BODY_DAMAGE_ACHIEVEMENT_ID_NAME": "Now I am the master!",
        "ACHIEVEMENT_POPCORN_DARTHVADER_BODY_DAMAGE_ACHIEVEMENT_ID_DESCRIPTION": "As Darth Vader, deal 100,000 damage in one hit.",
        "POPCORN_DARTHVADER_BODY_DAMAGE_UNLOCKABLE_ID": "Now I am the master!",
        "ACHIEVEMENT_POPCORN_DARTHVADER_BODY_ANYDIFFICULTY_ACHIEVEMENT_ID_NAME": "All too easy",
        "ACHIEVEMENT_POPCORN_DARTHVADER_BODY_ANYDIFFICULTY_ACHIEVEMENT_ID_DESCRIPTION": "As Darth Vader, beat the game or obliterate on any difficulty.",
        "POPCORN_DARTHVADER_BODY_ANYDIFFICULTY_UNLOCKABLE_ID": "All too easy",
        "ACHIEVEMENT_POPCORN_DARTHVADER_BODY_STAGE_ACHIEVEMENT_ID_NAME": "This will be a day long remembered",
        "ACHIEVEMENT_POPCORN_DARTHVADER_BODY_STAGE_ACHIEVEMENT_ID_DESCRIPTION": "As Darth Vader, complete 20 stages in a single run.",
        "POPCORN_DARTHVADER_BODY_STAGE_UNLOCKABLE_ID": "This will be a day long remembered",
        "POPCORN_DARTHVADER_BODY_KEYWORD_COOLDOWN_SLASH": "[ Cooldown Passive ]\nHitting enemies <style=cIsUtility>reduces all cooldowns</style> by 1 second.",
        "POPCORN_DARTHVADER_BODY_KEYWORD_ENERGY_SLASH": "[ Energy Passive ]\nHitting enemies <style=cIsUtility>regens 10 energy</style>, scaling with attackspeed.",
        "POPCORN_DARTHVADER_BODY_KEYWORD_COOLDOWN_FORCE": "[ Cooldown Passive ]\nHas a 5 second cooldown.",
        "POPCORN_DARTHVADER_BODY_KEYWORD_ENERGY_FORCE": "[ Energy Passive ]\nCosts 30 Energy",
        "POPCORN_DARTHVADER_BODY_KEYWORD_COOLDOWN_DEFLECT": "[ Cooldown Passive ]\nHas a 10 second cooldown.",
        "POPCORN_DARTHVADER_BODY_KEYWORD_ENERGY_DEFLECT": "[ Energy Passive ]\nHolding the button toggles the skill on rather than a set duration. Costs 20 Energy per hit blocked.",
        "POPCORN_DARTHVADER_BODY_KEYWORD_COOLDOWN_RAGE": "[ Cooldown Passive ]\nHas a 125 second cooldown.",
        "POPCORN_DARTHVADER_BODY_KEYWORD_ENERGY_RAGE": "[ Energy Passive ]\nRequires a full energy bar. When activated, lasts until you run out of energy. Removes all energy costs."
