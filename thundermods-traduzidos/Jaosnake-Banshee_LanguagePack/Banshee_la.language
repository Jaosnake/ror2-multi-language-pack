{
  "la": {
    "KENKO_BANSHEE_NAME": "Banshee",
    "KENKO_BANSHEE_DESCRIPTION": "Banshee est superstes aeria quae excellit in pugna comminus ingredienda atque egredienda.<color=#CCD3E0>\n\n< ! > Umbrella ATK tarda est ad vibrandum, sed egregia ratio est ad in aerem ascendendum. Eam etiam dum in aere libraris vibrare potes cum nullus hostis observatur.\n\n< ! > Cumulare copias Bombae Praecipitis antequam eam dimittas damnum vastans in puncto optimo inferre potest.\n\n< ! > Propulsores HDN mobilitatem Banshee in aere multum augere possunt — iis parce utere ad tela hostilia letalia vitanda.\n\n< ! > Granata CAL optima est ad hostes congregandos — conare Bombam Praecipitem ad eius centrum dirigere pro maxima efficacia!\n\n</color>",
    "KENKO_BANSHEE_SUBTITLE": "Praenuntia Domus Ulterioris",
    "KENKO_BANSHEE_LORE": "Dum instrumenta arma fiunt, novae vires intra severam hierarchiam Domus Ulterioris surrexerunt ut suis novis technologiis \"experirentur\". Inter has vires, Banshee armis aeriis dominantur suis Umbrellis FLT. Potestate ignes fatuos evocandi et gravitatem collabefaciendi, earum vis destructiva infinita est. In futurum, Domus Ulterior sperat se sua consilia ultra solem et lunam perfecturam esse.",
    "KENKO_BANSHEE_OUTRO_FLAVOR": "..atque ita discessit, susurris eius per aeternitatem resonantibus.",
    "KENKO_BANSHEE_OUTRO_FAILURE": "..atque ita evanuit, silentium exsurdans resonans.",
    "KENKO_BANSHEE_PASSIVE_NAME": "Umbrella FLT",
    "KENKO_BANSHEE_PASSIVE_DESCRIPTION": "Clavem saltus tenere facit ut Banshee in aere libretur. Dum libraris, tua <style=cIsUtility>Ars Primaria</style> in impetum directum convertitur qui <color=#ba8fff>Omen</color> imponit.",
    "KENKO_BANSHEE_PRIMARY_ATKUMBRELLA_NAME": "Umbrella ATK",
    "KENKO_BANSHEE_PRIMARY_ATKUMBRELLA_DESCRIPTION": "<color=#ba8fff>Omen</color>. Caede ante te pro <style=cIsDamage>250% damni</style>. Quisque 3. ictus te prorsum et in aerem impellit, inferens <style=cIsDamage>300% damni</style>.",
    "KENKO_BANSHEE_PRIMARY_THRSTUMBRELLA_NAME": "Umbrella THRST",
    "KENKO_BANSHEE_PRIMARY_THRSTUMBRELLA_DESCRIPTION": "<color=#ba8fff>Omen</color>. Caede ante te pro <style=cIsDamage>250% damni</style>. Quisque 3. ictus te in aerem impellit, inferens <style=cIsDamage>300% damni</style>.",
    "KENKO_BANSHEE_PRIMARY_WISP_NAME": "Ignis Aethereus",
    "KENKO_BANSHEE_PRIMARY_WISP_DESCRIPTION": "Emittit ignem pro <style=cIsDamage>200% damni</style>.",
    "KENKO_BANSHEE_SECONDARY_DIVE_NAME": "Bomba Praeceps",
    "KENKO_BANSHEE_SECONDARY_DIVE_DESCRIPTION": "<style=cIsUtility>Aerodynamica</style>. Praecipita deorsum inferens <style=cIsDamage>250% damni</style> in ictu. <style=cIsHealth>Consumit</style> omnes copias <style=cIsUtility>artis</style>, augens <style=cIsDamage>damnum illatum</style> pro unaquaque consumpta.",
    "KENKO_BANSHEE_UTILITY_THRUST_NAME": "Propulsores HDN",
    "KENKO_BANSHEE_UTILITY_THRUST_DESCRIPTION": "<color=#ba8fff>Omen</color>. In directionem irrumpe.",
    "KENKO_BANSHEE_UTILITY_SUPERTHRUST_NAME": "Propulsor EXP",
    "KENKO_BANSHEE_UTILITY_SUPERTHRUST_DESCRIPTION": "<color=#ba8fff>Omen</color>. In directionem irrumpe. <color=#ba8fff>Omen</color> praeterea <style=cIsUtility>4</style> vicibus excitatur.",
    "KENKO_BANSHEE_SPECIAL_CALAMITAS_NAME": "Granata CAL",
    "KENKO_BANSHEE_SPECIAL_CALAMITAS_DESCRIPTION": "Iace granatam quae foramen nigrum instabile creat. Post <style=cIsUtility>2</style> secundas, foramen nigrum collabitur inferens <style=cIsDamage>700% damni</style>.",
    "KENKO_BANSHEE_SPECIAL_SCEP_CALAMITAS_NAME": "Calamitas",
    "KENKO_BANSHEE_SPECIAL_SCEP_CALAMITAS_DESCRIPTION": "Iace 3 granatas quae foramina nigra instabilia creant. Post <style=cIsUtility>5</style> secundas, foramina nigra collabuntur inferentia <style=cIsDamage>700% damni</style>.",
    "ACHIEVEMENT_KENKO_BANSHEE_UNLOCK_ACHIEVEMENT_NAME": "Ego sum Mary Poppins, sceleste!",
    "ACHIEVEMENT_KENKO_BANSHEE_UNLOCK_ACHIEVEMENT_DESCRIPTION": "Gradum perfice terram non plus quam semel tangens.",
    "ACHIEVEMENT_KENKO_BANSHEE_MASTERYACHIEVEMENT_NAME": "Banshee: Magisterium",
    "ACHIEVEMENT_KENKO_BANSHEE_MASTERYACHIEVEMENT_DESCRIPTION": "Ut Banshee, ludum vince vel in Monsoon te oblitera.",
    "<style=cKeywordName>Agile</style><style=cSub>The skill can be used while sprinting.</style>": "<style=cKeywordName>Agilis</style><style=cSub>Haec ars dum curris adhiberi potest.</style>",
    "<style=cKeywordName>Omen</style><style=cSub>This skill fires an <color=#ba8fff>Ethereal Wisp</color> when completed which deals <style=cIsDamage>200% damage</style> on hit and restores <style=cIsUtility>1</style> stock to your secondary skill.</style>": "<style=cKeywordName>Omen</style><style=cSub>Haec ars perfecta emittit <color=#ba8fff>Ignem Aethereum</color> qui <style=cIsDamage>200% damni</style> in ictu infert et <style=cIsUtility>1</style> copiam arti tuae secundariae restituit.</style>",
    "<style=cKeywordName>Aerodynamic</style><style=cSub>The skill deals more damage the longer the distance traveled before impact.</style>": "<style=cKeywordName>Aerodynamica</style><style=cSub>Ars maius damnum infert quo longius spatium ante ictum emensum est.</style>"
  }
}
