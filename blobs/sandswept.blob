			{
				return;
			}
			CharacterMaster master = attackerBody.master;
			if (Object.op_Implicit((Object)(object)master))
			{
				int count = GetCount(attackerBody);
				if (count > 0 && Util.CheckRoll(chance, master))
				{
					TemporalTransistorOrb temporalTransistorOrb = new TemporalTransistorOrb
					{
						origin = victimBody.corePosition,
						target = Util.FindBodyMainHurtBox(attackerBody)
					};
