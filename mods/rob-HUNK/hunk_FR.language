    "ROB_HUNK_BODY_SHOOT_SLUGGER_NAME": "Tirer",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_DESCRIPTION": "Tirez pour <style=cIsDamage>3000% de dégâts</style>. <style=cIsUtility>50% de bonus de tir à la tête.</style>",
