		public static bool DefaultEnabledCallback(EnemyBase self)
		{
			ConfigSectionAttribute customAttribute = self.GetType().GetCustomAttribute<ConfigSectionAttribute>();
			if (customAttribute != null)
			{
				if (Main.config.Bind<bool>(customAttribute.name, "Enabled", true, "Allow this enemy to appear in runs?").Value)
				{
					return true;
				}
				return false;
			}
			return true;
		}

