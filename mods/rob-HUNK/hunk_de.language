    "ROB_HUNK_BODY_SHOOT_M3_DESCRIPTION": "Feuere für <style=cIsDamage>10x130% Schaden</style>. <style=cIsUtility>50% Kopfschussbonus.</style>",
    "ROB_HUNK_BODY_SHOOT_SSG_NAME": "Feuern",
    "ROB_HUNK_BODY_SHOOT_SSG_DESCRIPTION": "Feuere für <style=cIsDamage>16x200% Schaden</style>. <style=cIsUtility>50% Kopfschussbonus.</style>",
    "ROB_HUNK_BODY_SHOOT_STREETSWEEPER_NAME": "Feuern",
    "ROB_HUNK_BODY_SHOOT_STREETSWEEPER_DESCRIPTION": "Feuere für <style=cIsDamage>14x24% Schaden</style>. <style=cIsUtility>25% Kopfschussbonus.</style>",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_NAME": "Feuern",
    "ROB_HUNK_BODY_SHOOT_SLUGGER_DESCRIPTION": "Feuere für <style=cIsDamage>3000% Schaden</style>. <style=cIsUtility>50% Kopfschussbonus.</style>",
    "ROB_HUNK_BODY_SHOOT_SMG_NAME": "Feuern",
    "ROB_HUNK_BODY_SHOOT_SMG_DESCRIPTION": "Feuere für <style=cIsDamage>110% Schaden</style>. <style=cIsUtility>25% Kopfschussbonus.</style>",
    "ROB_HUNK_BODY_SHOOT_AR_NAME": "Feuern",
    "ROB_HUNK_BODY_SHOOT_AR_DESCRIPTION": "Feuere für <style=cIsDamage>385% Schaden</style>. <style=cIsUtility>50% Kopfschussbonus.</style>",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_NAME": "Feuern",
    "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Feuere für <style=cIsDamage>2x250% Schaden</style>. <style=cIsUtility>Schaden skaliert mit der Angriffsgeschwindigkeit.</style>",
    "ROB_HUNK_BODY_SECONDARY_AIM_NAME": "Ruhiges Zielen",
    "ROB_HUNK_BODY_SECONDARY_AIM_DESCRIPTION": "Ziele und <style=cIsUtility>lege gegnerische Schwachstellen frei</style>. <style=cIsDamage>Durch Betätigen von Primär beim Zielen feuerst du deine gehaltene Waffe ab.</style>",
    "ROB_HUNK_BODY_UTILITY_DODGE_NAME": "Schnellschritt",
    "ROB_HUNK_BODY_UTILITY_DODGE_DESCRIPTION": "<style=cIsUtility>Schnelle</style> eine kurze Strecke vorwärts. Wird dies rechtzeitig eingesetzt, um <style=cIsUtility>einem Angriff auszuweichen</style>, führst du ein <style=cIsDamage>Perfektes Ausweichen</style> aus.",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_NAME": "Uroboros",
    "ROB_HUNK_BODY_UTILITY_DODGE_SCEPTER_DESCRIPTION": "<style=cIsUtility>Schnelle</style> eine kurze Strecke vorwärts. Wird dies rechtzeitig eingesetzt, um <style=cIsUtility>einem Angriff auszuweichen</style>, führst du ein <style=cIsDamage>Perfektes Ausweichen</style> aus.\n<color=#d299ff>ZEPTER: Die Macht von Uroboros durchströmt dich.</color>",
    "ROB_HUNK_BODY_UTILITY_PARRY_NAME": "Parieren",
    "ROB_HUNK_BODY_UTILITY_PARRY_DESCRIPTION": "<style=cIsUtility>Blocke</style> einen Angriff, <style=cIsDamage>verhindere</style> den Schaden und <style=cIsUtility>erstatte die Abklingzeit zurück</style>. Bei rechtzeitigem Einsatz führst du ein <style=cIsDamage>Perfektes Parieren</style> aus.",
    "ROB_HUNK_BODY_UTILITY_BASH_NAME": "Schulterstoß",
    "ROB_HUNK_BODY_UTILITY_BASH_DESCRIPTION": "<style=cIsUtility>Ramme</style> nahe Gegner und <style=cIsUtility>betäube sie</style> für <style=cIsDamage>400% Schaden</style>. Wird dies rechtzeitig eingesetzt, um <style=cIsUtility>einen Angriff zu unterbrechen</style>, führst du einen <style=cIsDamage>Perfekten Schulterstoß</style> aus.",
    "ROB_HUNK_BODY_SPECIAL_SWAP_NAME": "Legion",
    "ROB_HUNK_BODY_SPECIAL_SWAP_DESCRIPTION": "<style=cIsUtility>Wechsle</style> zu einer anderen <style=cIsDamage>Schusswaffe</style>. Antippen wechselt zu deiner <style=cIsUtility>zuletzt gehaltenen Waffe</style>.",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_NAME": "Kampfmesser",
    "ROB_HUNK_BODY_KNIFE_DEFAULT_DESCRIPTION": "Ein standardmäßiges Militärmesser. In der Klemme garantiert nützlich.",
    "ROB_HUNK_BODY_KNIFE_INFINITE_NAME": "Kampfmesser EX",
