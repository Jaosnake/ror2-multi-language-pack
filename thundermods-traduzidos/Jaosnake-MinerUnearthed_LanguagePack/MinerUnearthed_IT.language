        "MINER_ALTUNLOCKABLE_ACHIEVEMENT_DESC": "Sconfiggi il guardiano unico delle Profondità Abissali.",
        "MINER_TYPHOONUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Grand Mastery",
        "MINER_TYPHOONUNLOCKABLE_UNLOCKABLE_NAME": "Minatore: Gran Maestria",
        "MINER_TYPHOONUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni del Minatore, finisci il gioco o distruggi su Typhoon o Eclipse.\n<color=#8888>(la difficoltà Typhoon richiede Starstorm 2)</color>",
        "MINER_MONSOONUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Mastery",
        "MINER_MONSOONUNLOCKABLE_UNLOCKABLE_NAME": "Minatore: maestria",
        "MINER_MONSOONUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni del Minatore, finisci il gioco o distruggi durante Monsoon.",
        "MINER_CRUSHUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Pillaged Gold",
        "MINER_CRUSHUNLOCKABLE_UNLOCKABLE_NAME": "Minatore: oro saccheggiato",
        "MINER_CRUSHUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni del Minatore, applica 12 accumuli di fendente al guardiano unico della Costa d'Oro.",
        "MINER_CRACKUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Junkie",
        "MINER_CRACKUNLOCKABLE_UNLOCKABLE_NAME": "Minatore: drogato",
        "MINER_CRACKUNLOCKABLE_ACHIEVEMENT_DESC": "Come Minatore, ottieni 50 accumuli di adrenalina.",
        "MINER_CAVEINUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Compacted",
        "MINER_CAVEINUNLOCKABLE_UNLOCKABLE_NAME": "Minatore: compattato",
        "MINER_CAVEINUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni del Minatore, colpisci 20 nemici con un Backblast.",
        "MINER_PUPLEUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: The Five Keys",
        "MINER_PUPLEUNLOCKABLE_UNLOCKABLE_NAME": "Minatore: le cinque chiavi",
        "MINER_PUPLEUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni del Minatore, scopri il segreto di debug di G-N-O-M-E.",
        "MINER_TUNDRAUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Frozen",
        "MINER_TUNDRAUNLOCKABLE_UNLOCKABLE_NAME": "Minatore: congelato",
        "MINER_TUNDRAUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni del Minatore, raggiungi Rallypoint Delta in meno di 8 minuti.",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_NAME": "Miner: Tempered",
        "MINER_BLACKSMITHUNLOCKABLE_UNLOCKABLE_NAME": "Minatore: temperato",
        "MINER_BLACKSMITHUNLOCKABLE_ACHIEVEMENT_DESC": "Nei panni del Minatore, trova uno strumento da fabbro sul pianeta.",
        "FATACRID_BODY_NAME": "Perro Grande",
        "FATACRID_BODY_SUBTITLE": "(Forma Gigante)",
        "DIGGERPLUGIN_DIRESEEKER_BODY_NAME": "Cercatore di odio",
        "DIGGERPLUGIN_DIRESEEKER_BODY_SUBTITLE": "Traccia e uccidi",
        "DIGGERPLUGIN_DIRESEEKER_BODY_LORE": "Le leggende raccontano di una bestia mostruosa che un tempo vagava per le baracche sotterranee di Petrichor V.\n\nTemuta dai sopravvissuti più coraggiosi e dai mostri più cattivi, l'enorme bestia non aveva rivali. Indossava scaglie rosso sangue, temperate dal fuoco infernale. Aveva occhi gialli ardenti, con uno sguardo così intenso da far fermare di botto anche la più grande delle creature. Aveva un alito fumante, abbastanza caldo da sciogliere il metallo in un istante.\n\nSolo una volta fermata da un sopravvissuto abbastanza forte da uccidere Providence in persona, si credeva che la bestia avesse finalmente incontrato il suo degno.\n\n<style=cIsHealth>Fino a quando non mostrò di nuovo il suo volto terrificante.</style>",
        "DIGGERPLUGIN_DIRESEEKER_BODY_OUTRO_FLAVOR": "..e così partì, alla ricerca di nuove prede.",
        "DIGGERPLUGIN_DIRESEEKER_BODY_DEFAULT_SKIN_NAME": "Predefinito"
    }
}