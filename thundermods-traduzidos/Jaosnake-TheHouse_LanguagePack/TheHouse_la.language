        "JAVANGLE_HOUSE_BUCKSHOT_NAME": "Ictus Grandinis",
        "JAVANGLE_HOUSE_BUCKSHOT_DESCRIPTION": "Ictum sclopeti grandinis pro <style=cIsDamage>130% x 16 damni</style> emitte.",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_NAME": "Ictus Explosivus",
        "JAVANGLE_HOUSE_EXPLOSIVESHOT_DESCRIPTION": "Telum explosivum emitte quod <style=cIsDamage>500% damni</style> in area infert.",
        "JAVANGLE_HOUSE_SNAKESHOT_NAME": "Ictus Colubrinus",
        "JAVANGLE_HOUSE_SNAKESHOT_DESCRIPTION": "Conare emittere ictum, <style=cSub>defice</style>, atque <style=cDeath>20% maximae salutis tuae ut damnum</style> accipe",
        "JAVANGLE_HOUSE_BLANKSHOT_NAME": "Ictus Vacuus",
        "JAVANGLE_HOUSE_BLANKSHOT_DESCRIPTION": "Conare emittere ictum, <style=cSub>defice</style>, et stultus appare lel.",
        "JAVANGLE_HOUSE_MYSTERYSHOT_NAME": "Ictus Arcanus",
        "JAVANGLE_HOUSE_MYSTERYSHOT_DESCRIPTION": "Telum omnino fortuitum emitte, re vera quidlibet esse potest.",
        "JAVANGLE_HOUSE_ACESHOT_NAME": "Ictus Assis",
        "JAVANGLE_HOUSE_ACESHOT_DESCRIPTION": "Ingentem ictum onera qui <style=cIsDamage>2500% damni</style> omnibus hostibus ante te infert, ex omni distantia et etiam per muros feriens",
