    "KENKO_SCOUT_SECONDARY_CLEAVER_NAME": "Toxic Cleaver",
    "KENKO_SCOUT_SECONDARY_CLEAVER_DESCRIPTION": "<style=cIsUtility>アジリティ</style>。肉切り包丁を投げて<style=cIsDamage>荒廃</style>を与え、<style=cIsDamage>{0}%のダメージ</style>を与える。<style=cIsDamage>スタン</style>状態の敵には<style=cIsDamage>クリティカルストライク</style>となり、<style=cIsHealing>毒</style>を与える。",
    "KENKO_SCOUT_SECONDARY_SPIKEDBALL_NAME": "Spike Ball",
