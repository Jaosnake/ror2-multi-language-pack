    "ACHIEVEMENT_UNLOCKED_MESSAGE_2P": "<color=#ccd3e0>आपने <color=#BDE151>{1}</color> हासिल किया</color>",
    "ACHIEVEMENT_LOGCOLLECTOR_NAME": "किताबी कीड़ा",
    "ACHIEVEMENT_LOGCOLLECTOR_DESCRIPTION": "10 राक्षस या परिवेश लॉग इकट्ठा करें।",
    "ACHIEVEMENT_ATTACKSPEED_NAME": "तेज़ गोलीबारी",
