        "ROB_HUNK_BODY_SHOOT_MINIGUN_NAME": "Огонь",
        "ROB_HUNK_BODY_SHOOT_MINIGUN_DESCRIPTION": "Стреляет на <style=cIsDamage>2x250% урона</style>. <style=cIsUtility>Урон масштабируется со скоростью атаки.</style>",
        "ROB_HUNK_BODY_SHOOT_ATM_NAME": "Огонь",
        "ROB_HUNK_BODY_SHOOT_ATM_DESCRIPTION": "Стреляет на <style=cIsDamage>8.000% урона</style>. <style=cIsUtility>Наносит больше урона при прямом попадании.</style>",
        "ROB_HUNK_BODY_SHOOT_ATM2_NAME": "Огонь",
