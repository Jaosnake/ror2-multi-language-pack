{
    "la": {
        "ROB_RAVAGER_BODY_NAME": "Ravager",
        "ROB_RAVAGER_BODY_DESCRIPTION": "Ravager est agilis propugnator qui se sanat ex caesis hostibus ut in proelio maneat.<color=#CCD3E0>\n\n< ! > Muri saltus onerandi est optimus modus ad volantes hostes tractandos.\n\n< ! > Findere utile est ad alti damni impetus cancellandos et damni effusionem sustinendam.\n\n< ! > Coagulare in angustiis utile esse potest si non certus es quod Puteus Sanguinis complere possis, sed etiam passive uti potest ut plene sanus manere continues.\n\n< ! > Saevire iussu sanat itaque certum fac ut prehendas et consumas aliquid si infirmus fias.</color>",
        "ROB_RAVAGER_BODY_SUBTITLE": "Severus Usurpator",
        "ROB_RAVAGER_BODY_LORE": "Ravager non natus est cum potestate speciali...\n\n...potius natus est cum Cursed Bloodspilled Katana sed quadam die ivit ad Dimensionem Stercoralem et potentiam malam invenit.....\n\nDenique evasit ex Dimensione Stercorali et ipse hanc terribilem potentiam malam gerens venit in Petrichor V ut universum destrueret.",
        "ROB_RAVAGER_BODY_OUTRO_FLAVOR": "..et ita abiit, quaerens novas terras ad violandas.",
        "ROB_RAVAGER_BODY_OUTRO_FAILURE": "..et ita evanuit, violentia eius ridicula tandem finita.",
        "ROB_RAVAGER_BODY_DEFAULT_SKIN_NAME": "Defalta",
        "ROB_RAVAGER_BODY_MONSOON_SKIN_NAME": "A Vacuo Tactus",
        "ROB_RAVAGER_BODY_MONSOON_ALTERNATE_SKIN_NAME": "A Vacuo Tactus EX",
        "ROB_RAVAGER_BODY_TYPHOON_SKIN_NAME": "[DATA DELETA]",
        "ROB_RAVAGER_BODY_VOID_SKIN_NAME": "Ex Vacuo Natus",
        "ROB_RAVAGER_BODY_MANGUY_SKIN_NAME": "Praedator",
        "ROB_RAVAGER_BODY_COMMANDO_SKIN_NAME": "Commando",
        "ROB_RAVAGER_BODY_SELLSWORD_SKIN_NAME": "Gladiator Conductus",
        "ROB_RAVAGER_BODY_GUERRILLA_SKIN_NAME": "Bellator Popularis",
        "ROB_RAVAGER_BODY_MAHORAGA_SKIN_NAME": "Divinus",
        "ROB_RAVAGER_BODY_MINECRAFT_SKIN_NAME": "Minecraft",
        "ROB_RAVAGER_BODY_BLOODWELL_NAME": "Puteus Sanguinis",
        "ROB_RAVAGER_BODY_BLOODWELL_DESCRIPTION": "Ravager <style=cIsHealth>sanguinem</style> ictibus colligit. Pleno receptaculo, sanguis consumitur ut <style=cIsHealing>75% salutis amissae</style> restituat et <style=cIsDamage>artes</style> ad tempus augeat.",
        "ROB_RAVAGER_BODY_BLOODWELL2_NAME": "Vas Ichoris",
        "ROB_RAVAGER_BODY_BLOODWELL2_DESCRIPTION": "Ravager <style=cIsHealth>sanguinem</style> ictibus colligit. Pleno receptaculo, sanguis consumitur ut <style=cIsHealing>100% salutis maximae</style> restituat et <style=cIsDamage>artes</style> ad tempus augeat. <style=cIsHealth>Oppugnando celerius consumitur.</style>",
        "ROB_RAVAGER_BODY_PARASITE_NAME": "Parasitus",
        "ROB_RAVAGER_BODY_PARASITE_DESCRIPTION": "<style=cIsHealth>Esurit....</style>",
        "ROB_RAVAGER_BODY_PASSIVE_NAME": "Vis Corporis",
        "ROB_RAVAGER_BODY_PASSIVE_DESCRIPTION": "Ravager se e <style=cIsUtility>parietibus</style> et <style=cIsHealth>hostibus</style> propellere potest. Utere arte <style=cIsUtility>primaria</style> dum oneratur ut <style=cIsDamage>statum tenendi</style> ingrediaris.",
        "ROB_RAVAGER_BODY_PASSIVE2_NAME": "Mutatio Distorta",
        "ROB_RAVAGER_BODY_PASSIVE2_DESCRIPTION": "<style=cIsHealth>Pleno onere consumit 10% maximae valetudinis et scuti; impensa secundum onus variat</style>. In aere salta ut <style=cIsUtility>transitum antrorsum</style> oneres, semel per saltum. <style=cIsDamage>Ictus comminus</style> qui feriunt hanc facultatem restituunt.",
        "ROB_RAVAGER_BODY_PASSIVE3_NAME": "Mutatio Distorta (antiqua)",
        "ROB_RAVAGER_BODY_PASSIVE3_DESCRIPTION": "<style=cIsHealth>5% salutis praesentis consumit.</style> In aere salta ut <style=cIsUtility>antrorsum transferaris</style>, semel per saltum. <style=cIsDamage>Ictus comminus</style> qui feriunt hanc facultatem restituunt.",
        "ROB_RAVAGER_BODY_CONFIRM_NAME": "Confirma",
        "ROB_RAVAGER_BODY_CONFIRM_DESCRIPTION": "Perge cum arte praesenti.",
        "ROB_RAVAGER_BODY_CANCEL_NAME": "Revoca",
        "ROB_RAVAGER_BODY_CANCEL_DESCRIPTION": "Cancella artem praesentem.",
        "ROB_RAVAGER_BODY_PRIMARY_SLASH_NAME": "Caedere",
        "ROB_RAVAGER_BODY_PRIMARY_SLASH_DESCRIPTION": "Vibra ante pro <style=cIsDamage>230% damnum</style>. <style=cIsHealth>Celerius vibrat quo sanitas tua inferior est.</style>",
        "ROB_RAVAGER_BODY_PRIMARY_SLASHCOMBO_NAME": "Dissolvere",
        "ROB_RAVAGER_BODY_PRIMARY_SLASHCOMBO_DESCRIPTION": "Ante te feri pro <style=cIsDamage>180% damno</style>. Omnis tertius ictus <style=cIsUtility>stupefacit</style> et <style=cIsDamage>390% damnum</style> infert.",
        "ROB_RAVAGER_BODY_SECONDARY_SPINSLASH_NAME": "Findere",
        "ROB_RAVAGER_BODY_SECONDARY_SPINSLASH_DESCRIPTION": "Impetum antrorsum fac et lato ictu <style=cIsUtility>stupefaciente</style> <style=cIsDamage>500% damni</style> infer.",
        "ROB_RAVAGER_BODY_UTILITY_HEAL_NAME": "Coagulare",
        "ROB_RAVAGER_BODY_UTILITY_HEAL_DESCRIPTION": "Statim exhauri <style=cIsHealth>Puteus Sanguinis</style>, <style=cIsHealing>te sanans</style> sanguine consumpto.",
        "ROB_RAVAGER_BODY_UTILITY_BEAM_NAME": "Annihilare",
        "ROB_RAVAGER_BODY_UTILITY_BEAM_DESCRIPTION": "<style=cIsHealth>Absorbe</style> incurrentes <style=cIsUtility>projectiles</style> ut terribilem explosionem oneres quae infert usque ad <style=cIsDamage>5000% damnum</style> cum plene onerata.",
        "ROB_RAVAGER_BODY_UTILITY_SWAP_NAME": "Boogie Woogie",
        "ROB_RAVAGER_BODY_UTILITY_SWAP_DESCRIPTION": "Muta locum cum <style=cIsUtility>quocumque ente</style>.",
        "ROB_RAVAGER_BODY_UTILITY_SNATCH_NAME": "Arripere",
        "ROB_RAVAGER_BODY_UTILITY_SNATCH_DESCRIPTION": "Mitte antea <style=cIsDamage>bracchium daemonis minoris</style> tuum et prehende hostem longinquum unguibus suis, <style=cIsUtility>te trahens versus quicquid ferit</style>.",
        "ROB_RAVAGER_BODY_SPECIAL_GRAB_NAME": "Saevire",
        "ROB_RAVAGER_BODY_SPECIAL_GRAB_DESCRIPTION": "Impetum facias et <style=cIsUtility>prehende</style> vicinos hostes, deinde prosterne pro <style=cIsDamage>1000% damnum</style>. Si hoc necat, <style=cIsHealth>consume</style> eos ut <style=cIsHealing>10% sanitatis maximae</style> restituas.",
        "ROB_RAVAGER_BODY_SPECIAL_GRAB_SCEPTER_NAME": "Vastare",
        "ROB_RAVAGER_BODY_SPECIAL_GRAB_SCEPTER_DESCRIPTION": "Impetum facias et <style=cIsUtility>prehende</style> vicinos hostes, deinde prosterne pro <style=cIsDamage>1000% damnum</style>. Si hoc necat, <style=cIsHealth>consume</style> eos ut <style=cIsHealing>10% sanitatis maximae</style> restituas.\n<color=#d299ff>SCEPTER: Maior radius prostrationis, et preme Salire dum trahis ut sursum teleporteris.</color>",
        "ROB_RAVAGER_BODY_SPECIAL_PUNCH_NAME": "Pugnare",
        "ROB_RAVAGER_BODY_SPECIAL_PUNCH_DESCRIPTION": "Impetum fac et <style=cIsUtility>pugno feri</style>, inferens <style=cIsDamage>1000% damni</style>, cum <style=cIsUtility>unda concussa</style> quae per hostes transit et idem damnum infert. Si hoc necat, <style=cIsHealth>consume</style> eos ut <style=cIsHealing>10% salutis maximae</style> restituas.",
        "ROB_RAVAGER_BODY_SPECIAL_THROW_NAME": "Iacere",
        "ROB_RAVAGER_BODY_SPECIAL_THROW_DESCRIPTION": "Impetum facias et <style=cIsUtility>prehende</style> vicinos hostes, deinde iace eos pro <style=cIsDamage>1000% damnum</style> in ictu. Si hoc necat, <style=cIsHealth>consume</style> eos ut <style=cIsHealing>10% sanitatis maximae</style> restituas.",
        "KEYWORD_REDGUY_M12": "<style=cKeywordName>Status tenendi</style><style=cSub>Dum saltum a muro oneras, ingredere <style=cIsUtility>statum tenendi</style>. Dimitte ut vibres et pro velocitate usque ad <style=cIsDamage>5x damnum</style> inferas.</style>",
        "KEYWORD_REDGUY_M1": "<style=cKeywordName>Effectus auctus</style><style=cSub>Celerius vibrat.</style>",
        "KEYWORD_REDGUY_M2": "<style=cKeywordName>Effectus auctus (in terra)</style><style=cSub>Ictus successi <style=cIsUtility>longius impetunt</style> et <style=cIsDamage>damnum augent per 50%</style>, cumulantur.</style>",
        "KEYWORD_REDGUY_M2B": "<style=cKeywordName>Effectus auctus (in aere)</style><style=cSub>Plus damni infert <style=cIsUtility>hostibus infirmis</style> et longius impetit.</style>",
        "KEYWORD_REDGUY_HEAL": "<style=cKeywordName>Effectus auctus</style><style=cSub>Explodat pro <style=cIsDamage>2400% damnum</style>.</style>",
        "KEYWORD_REDGUY_BEAM": "<style=cKeywordName>Effectus auctus</style><style=cSub>Multo celerius onerat.</style>",
        "KEYWORD_REDGUY_GRAB": "<style=cKeywordName>Effectus auctus</style><style=cSub>Potest duces prehendere. Hostes per terram trahit, damnum per tempus inferens.</style>",
        "KEYWORD_REDGUY_GRAB2": "<style=cKeywordName>Duces</style><style=cSub>Contra duces, <style=cIsDamage>adhaere</style> eis potius et modo goblin agito.</style>",
        "KEYWORD_REDGUY_PUNCH": "<style=cKeywordName>Effectus auctus</style><style=cSub>Immittit impetum pugnorum, magnum damnum inferens.</style>",
