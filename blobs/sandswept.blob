			combatSquad = ((Component)this).GetComponent<CombatSquad>();
			combatSquad.onMemberAddedServer += CombatSquad_onMemberAddedServer;
			combatSquad.onDefeatedServer += CombatSquad_onDefeatedServer;
			int num = ShrineOfTheFuture.baseEnemyCount + ShrineOfTheFuture.enemyCountPerPlayer * Run.instance.participatingPlayerCount;
			List<SpawnInfo> list = new List<SpawnInfo>();
			for (int i = 0; i < num; i++)
			{
				list.Add(scriptedCombatEncounter.spawns[Run.instance.spawnRng.RangeInt(0, scriptedCombatEncounter.spawns.Length)]);
			}
			scriptedCombatEncounter.spawns = list.ToArray();
		}

		public Dictionary<EliteDef, EquipmentIndex> GetRandomT2EliteDefToEquipmentIndexPair()
		{
			//IL_0031: Unknown result type (might be due to invalid IL or missing references)
			EliteDef[] eliteTypes = EliteAPI.VanillaEliteTiers[5].eliteTypes;
			EliteDef val = eliteTypes[Run.instance.runRNG.RangeInt(0, eliteTypes.Length)];
			return new Dictionary<EliteDef, EquipmentIndex> { 
			{
				val,
				val.eliteEquipmentDef.equipmentIndex
			} };
		}

		private void CombatSquad_onMemberAddedServer(CharacterMaster master)
		{
			//IL_002a: Unknown result type (might be due to invalid IL or missing references)
			//IL_002f: Unknown result type (might be due to invalid IL or missing references)
			//IL_003d: Unknown result type (might be due to invalid IL or missing references)
			Inventory inventory = master.inventory;
			if (Object.op_Implicit((Object)(object)inventory))
			{
				Dictionary<EliteDef, EquipmentIndex> randomT2EliteDefToEquipmentIndexPair = GetRandomT2EliteDefToEquipmentIndexPair();
				EquipmentIndex equipmentIndex = randomT2EliteDefToEquipmentIndexPair.Values.First();
				EliteDef val = randomT2EliteDefToEquipmentIndexPair.Keys.First();
				inventory.SetEquipmentIndex(equipmentIndex);
				if (inventory.GetItemCount(Items.UseAmbientLevel) <= 0)
				{
					inventory.GiveItem(Items.UseAmbientLevel, 1);
				}
				inventory.GiveItem(Items.BoostHp, Mathf.Max(0, Mathf.RoundToInt((val.healthBoostCoefficient * ShrineOfTheFuture.enemyStatsMultiplier - 1f) * 10f)));
				inventory.GiveItem(Items.BoostDamage, Mathf.Max(0, Mathf.RoundToInt((val.damageBoostCoefficient * ShrineOfTheFuture.enemyStatsMultiplier - 1f) * 10f)));
			}
		}

		private void CombatSquad_onDefeatedServer()
		{
			SpawnRewards();
			if (purchaseCount >= maxPurchaseCount)
