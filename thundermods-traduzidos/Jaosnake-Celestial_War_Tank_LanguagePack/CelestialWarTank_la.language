    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_NAME": "Staghound",
    "CHEESEWITHHOLES_BASICTANK_TURRET_STAGHOUND_DESCRIPTION": "\n<color=#00FF00>Salus: </color>10\n<color=#FF0000>Lorica: </color>0\n\nRotation Celeritas: 55\n\nPondus: 5\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_NAME": "T-34-85",
    "CHEESEWITHHOLES_BASICTANK_TURRET_T_34_85_DESCRIPTION": "\n<color=#00FF00>Salus: </color>100\n<color=#FF0000>Lorica: </color>20\n\nRotation Celeritas: 33\n\nPondus: 120\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_NAME": "Tank MK.II",
    "CHEESEWITHHOLES_BASICTANK_TURRET_TANK_MK_II_DESCRIPTION": " <color=#80fc80>-20% Refectionis specialis</color>\n <color=#fc8080>+15% Refectionis secundariae</color>\n <color=#fc8080>-10% Celeritatis impetus</color>\n\n<color=#00FF00>Salus: </color>120\n<color=#FF0000>Lorica: </color>23\n\nRotation Celeritas: 29\n\nPondus: 143\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_NAME": "FV4005",
    "CHEESEWITHHOLES_BASICTANK_TURRET_FV4005_DESCRIPTION": " <color=#80fc80>+20% Damni</color>\n <color=#fc8080>+10% Refectionis totalis</color>\n\n<color=#00FF00>Salus: </color>160\n<color=#FF0000>Lorica: </color>0\n\nRotation Celeritas: 25\nLimes Anguli: 90\n\nPondus: 160\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_NAME": "Bunker",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BUNKER_DESCRIPTION": "\n<color=#00FF00>Salus: </color>45\n<color=#FF0000>Lorica: </color>4\n\nRotation Celeritas: 25\n\nPondus: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_NAME": "BobSemple",
    "CHEESEWITHHOLES_BASICTANK_TURRET_BOBSEMPLE_DESCRIPTION": "\n<color=#00FF00>Salus: </color>35\n<color=#FF0000>Lorica: </color>15\n\nRotation Celeritas: 35\n\nPondus: 50\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_NAME": "Prototype",
    "CHEESEWITHHOLES_BASICTANK_TURRET_PROTOTYPE_DESCRIPTION": " <color=#80fc80>-25% Refectionis primariae</color>\n <color=#fc8080>+8% Refectionis secundariae</color>\n <color=#fc8080>+8% Refectionis utilitatis</color>\n <color=#fc8080>+8% Refectionis specialis</color>\n <color=#fc8080>-15% Celeritatis impetus</color>\n\n<color=#00FF00>Salus: </color>35\n<color=#FF0000>Lorica: </color>3\n\nRotation Celeritas: 30\n\nPondus: 25\n",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_NAME": "Scorpion",
    "CHEESEWITHHOLES_BASICTANK_TURRET_SCORPION_DESCRIPTION": " <color=#80fc80>+25% Damni</color>\n\n<color=#00FF00>Salus: </color>5\n<color=#FF0000>Lorica: </color>1\n\nRotation Celeritas: 40\nLimes Anguli: 30\n\nPondus: 6\n",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORIGINAL_NAME": "PRISTINUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_RED_NAME": "RUBER",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_LIGHT_RED_NAME": "RUBER CLARUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_GREEN_NAME": "VIRIDIS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DARK_GREEN_NAME": "VIRIDIS OBSCURUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLUE_NAME": "CAERULEUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_CYAN_NAME": "CYANEUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_PINK_NAME": "ROSEUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_HOT_PINK_NAME": "ROSEUS ARDENS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_MEGENTA_NAME": "PURPUREUS CLARUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_YELLOW_NAME": "FLAVUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_YELLOW_NAME": "FLAVUS LUCENS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_NEON_PURPLE_NAME": "PURPUREUS LUCENS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_ORANGE_NAME": "AURANTIUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_WHITE_NAME": "ALBUS",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_BLACK_NAME": "NIGER",
    "CHEESEWITHHOLES_BASICTANK_BODY_GLOW_DESCRIPTION": "Hoc partem 'lucentem' vehiculi in alium colorem mutat.  Ludum non afficit.",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIRTY_NAME": "Sordidus",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_CLEAN_NAME": "Mundus",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_JAGGED_CAMO_NAME": "Tegmen_Serratum",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PIXEL_CAMO_NAME": "Tegmen_Tessellatum",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PAPER_CAMO_NAME": "Tegmen_Chartaceum",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DIAMOND_PLATE_NAME": "Lamina_Adamantina",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_BOLTED_PLATE_NAME": "Lamina_Clavata",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_PROCEDURAL_SET_NAME": "Series_Proceduralis",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_COLORFUL_BLEND_NAME": "Mixtura_multicolor",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_GRADIENT_RAINBOW_NAME": "Arcus_Caelestis",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_MONOCHROME_NAME": "Monochromus",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_FLUID_GALAXY_NAME": "Galaxias_Fluida",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_SPACE_NAME": "Spatium",
    "CHEESEWITHHOLES_BASICTANK_BODY_TEXTURE_DESCRIPTION": "",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_NAME": "Systemata Machinae",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE_DESCRIPTION": "Utilitates et impulsus fomentum consumunt. Repletio fomenti afficitur <style=cIsUtility>celeritate impetus</style>; capacitas fomenti afficitur <style=cIsUtility>postcombustoribus</style> et <style=cIsUtility>rebus saltus</style>. Currus <style=cIsUtility>in quamvis partem currere</style> potest. Impulsus imperium versatile in aere praebet. Tamen, <color=#fc8080>currus normaliter salire non potest</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_NAME": "Super Armamentarium",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE2_DESCRIPTION": "Electiones alvei et turris salutem, loricam, celeritatem, impulsum, et molem afficiunt. <style=cIsUtility>Moles gravior adjuvat ad hostes graviores pellendos</style>; alioquin magis obnoxius eris <color=#ffff80>repulsui</color>.\n\nLorica aut celeritas adjuvare potest ad mitigandam <color=#fc8080>regenerationem salutis pessimam</color> currus.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_NAME": "Instabilitas Caelestis",
    "CHEESEWITHHOLES_BASICTANK_BODY_PASSIVE3_DESCRIPTION": "Currus se in aere aequilibrare non potest, <color=#ffff80>obnoxius amissioni imperii</color>. In caput cadere te relinquit <color=#fc8080>immobilem et vulnerabilem per breve tempus</color>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_NAME": "Propulsores Volatus",
    "CHEESEWITHHOLES_BASICTANK_BODY_FLIGHT_PASSIVE_DESCRIPTION": "Tene <style=cIsUtility>Saltum</style> ad volatum incipiendum. Directio volatus ex angulo currus tui pendet. <style=cIsUtility>Volatus maxime versatilis</style>, sed difficilis usu esse potest.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_NAME": "Propulsores Pulsus",
    "CHEESEWITHHOLES_BASICTANK_BODY_BURST_PASSIVE_DESCRIPTION": "Permittit currui <style=cIsUtility>salire</style> normaliter sicut aliis superstitibus. Inclinatio currus in secundo saltu activari potest. Quisque saltus consumit <color=#ffc080>25</color> fomenti.",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_NAME": "Propulsores Levitationis",
    "CHEESEWITHHOLES_BASICTANK_BODY_HOVER_PASSIVE_DESCRIPTION": "Permittit currui super terram pendere. Tene <style=cIsUtility>Saltum</style> ad ascendendum; tene <style=cIsUtility>LeftAlt</style> ad descendendum. Ascendere plus fomenti consumit.",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_NAME": "Mitralia",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MACHINEGUNS_DESCRIPTION": "Continenter jaculare pro <style=cIsDamage>2x40% damni</style>.\n<style=cSub>[Pondus: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_NAME": "Sclopetum Dispersivum",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_SHOTGUN_DESCRIPTION": "Jaculare pro <style=cIsDamage>12x75% damni</style>.  <color=#ffc080>Ure fomentum</color> ad <style=cIsUtility>onera extraordinaria acquirenda</style>; <color=#80fc80>perfice artem acrobaticam</color> ut ad tempus ictum validum acquiras pro <style=cIsDamage>18x150% damni</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 1s</style> | Pondus: 9]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_NAME": "Ballista Granatarum",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_GRENADELAUNCHER_DESCRIPTION": "Jaculare glandes parum certas pro <style=cIsDamage>4x250% damni</style>.  Glandes displosivae et graves sunt.\n<style=cSub>[<style=cIsUtility>Refectio: 4s</style> | <style=cIsDamage>Radius Displosionis: 5m</style> | Pondus: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_NAME": "Ballista Missilium",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_MICRO_MISSLE_DESCRIPTION": "Jaculare missilia certa pro <style=cIsDamage>1000% damni</style>. <style=cIsDamage>Damnum augetur dum volat</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 3s</style> | <style=cIsDamage>Radius Displosionis: 8m</style> | Pondus: 18]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_NAME": "Evomitor Flammarum",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_FLAMETHROWER_DESCRIPTION": "Evome ignem pro <color=#E85E31>25% damni ustionis</color> singulis <color=#ffc080>15 fomenti per secundam</color>.  Damnum cum cumulis augetur; <style=cIsUtility>celeritas impetus spatium auget</style>.\n<style=cSub>[<color=#ffc080>Fomento Actus</color> | Pondus: 12]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_NAME": "Ultrantenna",
    "CHEESEWITHHOLES_BASICTANK_BODY_PRIMARY_ULTRANTENNA_DESCRIPTION": "<color=#fc8080>Fulmina te ipsum</color> et <style=cIsUtility>activa res ex caede</style>.  <style=cIsUtility>Hostes tangere eos quoque fulminat</style>, et accipiunt <style=cIsDamage>250% damni</style> per rem <style=cIsUtility>ex caede</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 7s</style> | <style=cIsDamage>Radius Displosionis: 5m</style> | Pondus: 1]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_NAME": "Tormentum Criticum",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_DESCRIPTION": "Jaculare pro <color=#ff4d76>1200% damni critici</color>. Sors critica damnum tormenti auget.\n<style=cSub>[<style=cIsUtility>Refectio: 7s</style> | <style=cIsDamage>Radius Displosionis: 10m</style> | Pondus: 50]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_NAME": "Tormentum Ballista",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_HOWITZER_CANNON_DESCRIPTION": "Onera ad jaculandum cum fragore pro <style=cIsDamage>7000% damni</style>. <style=cIsUtility>Currum projicere potest si in aere est.</style>\n<style=cSub>[<style=cIsUtility>Refectio: 16s</style> | <style=cIsDamage>Radius Displosionis: 15m</style> | Pondus: 75]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_NAME": "Tormentum Percussoris",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CROMWELL_CANNON_DESCRIPTION": "Jaculare parum certe pro <style=cIsDamage>1700% damni</style>. <style=cIsDamage>Damnum minuitur dum volat</style>; <style=cIsDamage>Res effectus potius damnum augent</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 3s</style> | <style=cIsDamage>Radius Displosionis: 5m</style> | Pondus: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_NAME": "Tormentum Penetrans",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_T62_CANNON_DESCRIPTION": "Jaculare pro <style=cIsDamage>2500% damni</style>.  Tene ad calibrandum et infligendum <style=cIsDamage>3500% damni</style>, capax <style=cIsUtility>puncta debilia feriendi</style>.  Cum calibratum est, <color=#fc8080>moveri certitudinem pejorem facit</color>.\n<style=cSub>[<style=cIsUtility>Refectio: 5s</style> | <style=cIsDamage>Radius Displosionis: 2m</style> | Pondus: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_NAME": "Tormentum Gallicum",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_FRENCHGUN_DESCRIPTION": "Jaculare pro exiguo <style=cIsDamage>550% damni</style>. Qua de causa nescio, <style=cIsUtility>nimium coefficientem effectus habet</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 1s</style> | Pondus: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_NAME": "Minigun",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MINIGUN_DESCRIPTION": "Evome glandes pro <style=cIsDamage>50% damni</style>. Ad 75% aestus nimii infligit <color=#E85E31>ignem</color>; <color=#fc8080>aestus nimius tormentum claudit</color>. <style=cIsUtility>Res refectionis celeritatem refrigerationis augent</style>; <style=cIsUtility>thecae subsidiariae aestum nimium prohibent</style>.\n<style=cSub>[Pondus: 45]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_NAME": "Tormentum Basicum",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_MAUS_DESCRIPTION": "Jaculare glandem celerem pro <style=cIsDamage>5400% damni</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 12s</style> | <style=cIsDamage>Radius Displosionis: 7m</style> | Pondus: 65]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_NAME": "Tormentum AA",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AA_DESCRIPTION": "Jaculare pro <style=cIsDamage>300% damni</style>.  Telum prope metas aerias displodit, infligens <style=cIsDamage>2.5x damni</style>.  <color=#fc8080>Currus tardatur ad jaculandum</color>.\n<style=cSub>[<style=cIsDamage>Radius Displosionis: 5.5m</style> | Pondus: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_NAME": "Tormentum Sparsionis",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CANNON_MKII_DESCRIPTION": "Jaculare pro <style=cIsDamage>2200% damni</style> in <style=cIsUtility>magno arcu</style>, spargens pro <style=cIsDamage>10x5% damni totalis</style>.  Damnum augetur quo longius volat, usque ad <style=cIsDamage>5500% damni</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 10s</style> | <style=cIsDamage>Radius Displosionis: 16m</style> | Pondus: 55]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_NAME": "Tormentum Caeleste",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_CELESTIAL_CANNON_DESCRIPTION": "Consume <color=#ffc080>40</color>/<color=#ffc080>100</color>/<color=#ffc080>145</color> fomenti pro <color=#E85E31>1800%</color>/<color=#E85E31>4500%</color>/<color=#E85E31>9000%</color> <color=#E85E31>damni</color>.  Radii onerati penetrant; <color=#fc8080>inopia fomenti telum exstinguit.</color>\n<style=cSub>[<color=#ffc080>Fomento Actus</color> | Pondus: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_NAME": "Tormentum Oblitteratoris",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_OBLITERATOR_CANNON_DESCRIPTION": "Onera ad ultro jaculandum <color=#E85E31>glandem caedem excitantem</color> pro <style=cIsDamage>12000% damni</style>.  Postea, <color=#fc8080>facultates per 4 secundas inhibentur.  Glans socios laedere potest</color>.\n<style=cSub>[<style=cIsUtility>Refectio: 21s</style> | <style=cIsDamage>Radius Displosionis: 5m</style> | Pondus: 100]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_NAME": "Tormentum Automaticum",
    "CHEESEWITHHOLES_BASICTANK_BODY_SECONDARY_AUTO_CANNON_DESCRIPTION": "Jaculare usque ad 4 glandes quae infligunt <style=cIsDamage>2000% damni</style> singulae. Ultima glans infligit <style=cIsDamage>2x damni</style> in puncto fixo.\n<style=cSub>[<style=cIsUtility>Refectio: 14s</style> | <style=cIsDamage>Radius Displosionis: 7m</style> | Pondus: 35]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_NAME": "Aratrum",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_DESCRIPTION": "<style=cIsUtility>Procurre breve spatium</style> pro <color=#ffc080>50</color> fomenti. Repellere potest <style=cIsUtility>quemlibet hostem</style> pro <style=cIsDamage>1000% damni</style> et replere <color=#ffc080>40</color> fomenti.\n<style=cSub>[<style=cIsUtility>Refectio: 2s</style> | Pondus: 20]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_NAME": "Spinae",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_BLEED_DESCRIPTION": "<style=cIsUtility>Procurre magnum spatium</style> pro <color=#ffc080>50</color> fomenti. Arieta hostes pro <color=#AA2B2A>550% damni sanguinis</color>.  <style=cIsUtility>Nullam refectionem habet</style>.\n<style=cSub>[Pondus: 15]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_NAME": "Turbo",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_DASHRAM_CONSTANT_DESCRIPTION": "<style=cIsUtility>Provola</style> et consume <color=#ffc080>30</color> fomenti per secundam.  Arietare potest pro <style=cIsDamage>250% damni</style>. Arietatio addit <color=#ffc080>20</color> fomenti.\n<style=cSub>[<style=cIsUtility>Refectio: 1s</style> | Pondus: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_NAME": "Super Saltus",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_SUPERJUMP_DESCRIPTION": "Projice te sursum pro <color=#ffc080>50</color> fomenti.  Dum curris, projice te potius prorsum pro <color=#ffc080>75</color> fomenti et jacta currum tuum pro <style=cIsDamage>2500% damni</style>.  Pondus currus damnum auget.",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_NAME": "Machina Planatrix",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_MA_DESCRIPTION": "<style=cIsUtility>Impelle</style> et consume <color=#ffc080>20</color> fomenti per secundam.  Obterere potest <style=cIsUtility>quemlibet hostem</style> pro constanti <style=cIsDamage>200% damni</style>.  Inflige <style=cIsDamage>350% damni</style> in conflictu.\n<style=cSub>[<style=cIsUtility>Refectio: 1s</style> | Pondus: 30]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_NAME": "Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_RIP_DOZER_DESCRIPTION": "Onera ad <style=cIsUtility>procurrendum maximum spatium</style> pro <color=#ffc080>100</color> fomenti.  <style=cIsUtility>Penetra turbas</style> pro <color=#AA2B2A>4000% damni sanguinis</color> et <style=cIsUtility>prolonga procursum</style>; flecte ad finiendum procursum; <color=#80fc80>perfice artem acrobaticam</color> ad <style=cIsUtility>omittendam onerationem</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 7s</style> | Pondus: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_NAME": "Fossor",
    "CHEESEWITHHOLES_BASICTANK_BODY_UTILITY_TRENCHER_DESCRIPTION": "<style=cIsUtility>Tene ad defodiendum</style>, consumens <color=#ffc080>20</color> fomenti per secundam, <style=cIsUtility>tegens currum tuum sub terra</style>.  Dimitte ad emergendum et infligendum <style=cIsDamage>900% damni</style> hostibus proximis.  Pugnare non potest dum sub terra est.\n<style=cSub>[<style=cIsDamage>Radius Displosionis: 10m</style> | Pondus: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_NAME": "Mina Regia",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_LANDMINE_DESCRIPTION": "Depone minam terrestrem quae infligit <style=cIsDamage>3000% damni</style>.  <style=cIsDamage>Res effectus potius damnum augent</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 10s</style> | <style=cIsDamage>Radius Displosionis: 10m</style> | Pondus: 25]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_NAME": "Minae Minutae",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MINDFIELD_WALL_DESCRIPTION": "Collineate et expende omnes minas terrestres minutas quae infligunt <style=cIsDamage>750% damni</style> singulae.  Res onerum et interactionum maximum minarum augent.  <color=#ffc080>Ure fomentum</color> ad <style=cIsUtility>onera extraordinaria acquirenda</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 3s</style> | <style=cIsDamage>Radius Displosionis: 10m</style> | Pondus: 10]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_NAME": "Jactus Dolii",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_BARREL_DESCRIPTION": "Projice dolium pro <color=#ffc080>25</color> fomenti quod in conflictu exardescit pro <style=cIsDamage>6500% damni</style>, et relinquit <color=#E85E31>lacunam ardentem</color>.  <color=#80fc80>Perficere artem acrobaticam</color> facit ut haec facultas ad tempus sit <color=#fc8080>instabilis</color>, quod <style=cIsUtility>currum tuum jactat</style>.\n<style=cSub>[<style=cIsUtility>Refectio: 14s</style> | <style=cIsDamage>Radius Displosionis: 18m</style> | <style=cIsDamage>Radius Zonae: 8</style> | Pondus: 40]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_NAME": "Suiipsius Excidium",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_SELF_DESTRUCT_DESCRIPTION": "Dele <color=#d40000>OMNIA</color> intra 35m pro <style=cIsDamage>100000% damni</style>.  Incipe cum <color=#80fc80>Dio's Best Friend</color> in novo cursu.\n<style=cSub>[<style=cIsDamage>Radius Displosionis: 35m</style> | Pondus: 90]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_NAME": "REGNUM",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_MISSLE_LAUNCHER_DESCRIPTION": "Tarda et onera ad jaculandam tempestatem missilium.  Damnum augetur quo longius volat, usque ad <style=cIsDamage>12x3000% damni.</style>\n<style=cSub>[<style=cIsUtility>Refectio: 30s</style> | <style=cIsDamage>Radius Displosionis: 10m</style> | Pondus: 70]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_NAME": "Evadere",
    "CHEESEWITHHOLES_BASICTANK_BODY_SPECIAL_EVADE_DESCRIPTION": "Emitte fumum, hostes proximos obstupefaciens pro <style=cIsDamage>150% damni</style> et late.  <style=cIsUtility>Fi immunis</style> a damno per 1 secundam.\n<style=cSub>[<style=cIsUtility>Refectio: 12s</style> | <style=cIsDamage>Radius Displosionis: 10m</style> | Pondus: 5]</style>",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_NAME": "Passiva: Furor",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_PRIMARY_DESCRIPTION": "Hanc facultatem removet. Auget <style=cIsDamage>celeritatem impetus basicam 0.5</style> et minuit <style=cIsUtility>refectionem 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_NAME": "Passiva: Machinae",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_UTILITY_DESCRIPTION": "Hanc facultatem removet. Auget <style=cIsUtility>celeritatem basicam 1m/s</style> et <style=cIsUtility>vim impulsus 10%</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_NAME": "Passiva: Lorica",
    "CHEESEWITHHOLES_BASICTANK_BODY_EMPTY_SPECIAL_DESCRIPTION": "Hanc facultatem removet. Auget <style=cIsUtility>loricam basicam 30</style>.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_NAME": "Celestial War Tank: Magisterium",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_ACHIEVEMENT_DESC": "Ut Celestial War Tank, vince ludum aut oblittera te in Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_MASTERY_UNLOCKABLE_NAME": "Celestial War Tank: Magisterium",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_NAME": "Celestial War Tank: Tormentum Caeleste",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_ACHIEVEMENT_DESC": "Ut Celestial War Tank, redi domum",
    "CHEESEWITHHOLES_BASICTANK_BODY_CELESTIAL_CANNON_UNLOCKABLE_NAME": "Celestial War Tank: Tormentum Caeleste",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_NAME": "Celestial War Tank: Oblitterator",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_ACHIEVEMENT_DESC": "Ut Celestial War Tank, inflige ultra 1,000,000 damni uno ictu.",
    "CHEESEWITHHOLES_BASICTANK_BODY_OBLITERATOR_UNLOCKABLE_NAME": "Celestial War Tank: Oblitterator",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_ACHIEVEMENT_DESC": "Ut Celestial War Tank, vince ludum aut oblittera te in Monsoon.",
    "CHEESEWITHHOLES_BASICTANK_BODY_RIP_DOZER_UNLOCKABLE_NAME": "Celestial War Tank: Ripdozer",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_NAME": "Celestial War Tank: Loricatus",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_ACHIEVEMENT_DESC": "Ut Celestial War Tank, adipiscere 10000 Salutis.",
    "CHEESEWITHHOLES_BASICTANK_BODY_BUNKER_BODY_UNLOCKABLE_NAME": "Celestial War Tank: Loricatus",
    "CHEESEWITHHOLES_BASICTANK_MONSTER_BODY_NAME": "BasicTankMonster",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_NAME": "Mega War Tank",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DESCRIPTION": "Currus ultimus excidii. Resiste omnibus generibus hostium, eos obterens et opprimens pondere potenti et armis suis!\n\n<style=cSub>< ! > Currus ingens est et valde tardus, te obnoxium omni generi damni reddens. Ludere aut valde defensive aut ferociter adjuvabit ad minuendam quantitatem damni quam accipies. Scito currum nullam sanationem habere.\n\n< ! > Corpus currus ad damnum inferendum adhiberi potest — obtere hostes tuos aut utere pondere tuo ad eos omnes elidendos!\n\n< ! > Cum currus alliditur, gravior est et diutius moratur dum resurgat, obnoxius majori damno casus. Currus artes acrobaticas facere non potest.\n\n< ! > Factores sanationis mitigantur — currus nimiam salutem habet!\n\n< ! > Preme 'T' ad clangendum.  In optionibus modi configurari potest.\n\n</style>",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_SUBTITLE": "Entitas Externa",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_LORE": "Post ulteriorem investigationem, originem quandam horum curruum invenimus — manus scrutatorum. Ex partibus ferreis probis et rebus ex UES fabricati, hos currus bellicos feliciter creaverant.\n\nAttamen, hoc ad conclusiones periculosas ducit. Postquam unam ex antennis hostilibus adepti sumus, hunc immanem currum excitavimus. Magnitudine custodum scarabaeorum est!\n\nScilicet post longum proelium, eum tandem dejecimus. Speramus nos ulteriorem investigationem facturos et mentem ejus commutaturos, spe meliorum responsorum. Difficile opus erit, nam EST ars alienigena.\n\nUna res ingens notanda est quod, eo devicto, portam subitam evocavit. Maximam et violentissimam portam quam umquam vidimus. Quantumvis nos recta ad responsa ducere possit, non puto fore ambulationem facilem in horto. Mediocris currus jam nimis letalis est, nec scio quae alia inventa a scrutatoribus facta foris exstent.",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_ORIGINAL_SKIN_NAME": "PRISTINUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_WHITE_SKIN_NAME": "ALBUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLACK_SKIN_NAME": "NIGER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_RED_SKIN_NAME": "RUBER",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_DARK_RED_SKIN_NAME": "RUBER OBSCURUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_GREEN_SKIN_NAME": "VIRIDIS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_BLUE_SKIN_NAME": "CAERULEUS",
    "CHEESEWITHHOLES_BASICTANK_XTRA_BODY_CYAN_SKIN_NAME": "CYANEUS",
