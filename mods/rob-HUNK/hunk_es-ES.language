    "ROB_HUNK_WEAPON_ADDON_MUP_NAME": "Culata (MUP)",
    "ROB_HUNK_WEAPON_ADDON_MUP_DESC": "Una pieza personalizada para la MUP que permite al arma disparar ráfagas de 3 proyectiles por cada pulsación del gatillo.",
    "ROB_HUNK_WEAPON_ADDON2_MUP_NAME": "Mira de Punto Rojo (MUP)",
    "ROB_HUNK_WEAPON_ADDON2_MUP_DESC": "Una pieza personalizada para la MUP. Añade una mira que mejora su eficacia a larga distancia y al acertar en puntos débiles.",
    "ROB_HUNK_WEAPON_ADDON3_MUP_NAME": "Cargador de Gran Capacidad (MUP)",
    "ROB_HUNK_WEAPON_ADDON3_MUP_DESC": "Una pieza personalizada para la MUP que amplía la capacidad del cargador a 33 proyectiles y reduce el tiempo de recarga.",
    "ROB_HUNK_WEAPON_ADDON4_MUP_NAME": "Freno de Boca (MUP)",
    "ROB_HUNK_WEAPON_ADDON4_MUP_DESC": "Una pieza personalizada para la MUP que eleva su daño al 600%.",
    "ROB_HUNK_WEAPON_SG09_NAME": "SG-09 R",
    "ROB_HUNK_WEAPON_SG09_DESC": "Una pistola manejable con gran capacidad de munición.",
    "ROB_HUNK_WEAPON_ADDON_SG09_NAME": "Cargador de Gran Capacidad (SG-09 R)",
    "ROB_HUNK_WEAPON_ADDON_SG09_DESC": "Una pieza personalizada para la SG-09 R que amplía la capacidad del cargador a 32 proyectiles.",
    "ROB_HUNK_WEAPON_ADDON2_SG09_NAME": "Freno de Boca (SG-09 R)",
    "ROB_HUNK_WEAPON_ADDON2_SG09_DESC": "Una pieza personalizada para la SG-09 R que eleva su daño al 900%.",
    "ROB_HUNK_WEAPON_ADDON3_SG09_NAME": "Mira Láser (SG-09 R)",
    "ROB_HUNK_WEAPON_ADDON3_SG09_DESC": "Una pieza personalizada para la SG-09 R. Añade una mira que mejora su eficacia a larga distancia y al acertar en puntos débiles.",
    "ROB_HUNK_WEAPON_BROOMHC_NAME": "Broom HC",
    "ROB_HUNK_WEAPON_BROOMHC_DESC": "Una pistola compacta de alto rendimiento.",
    "ROB_HUNK_WEAPON_MAGNUM_NAME": "Lightning Hawk",
    "ROB_HUNK_WEAPON_MAGNUM_DESC": "Una mágnum fácil de manejar con gran potencia de fuego.",
    "ROB_HUNK_WEAPON_ADDON_MAGNUM_NAME": "Cañón Largo (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON_MAGNUM_DESC": "Una pieza personalizada para la Lightning Hawk que eleva su daño al 3000%.",
    "ROB_HUNK_WEAPON_ADDON2_MAGNUM_NAME": "Mira Láser (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON2_MAGNUM_DESC": "Una pieza personalizada para la Lightning Hawk. Añade una mira que mejora su eficacia al acertar en puntos débiles.",
    "ROB_HUNK_WEAPON_ADDON3_MAGNUM_NAME": "Munición de Reserva (Lightning Hawk)",
    "ROB_HUNK_WEAPON_ADDON3_MAGNUM_DESC": "Una pieza personalizada para la Lightning Hawk que aumenta considerablemente la cantidad de proyectiles MAG recogidos.",
    "ROB_HUNK_WEAPON_SHOTGUN_NAME": "W-870",
    "ROB_HUNK_WEAPON_SHOTGUN_DESC": "Una escopeta de corredera del calibre 12.",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_NAME": "Cartuchos Aliento de Dragón (Escopeta)",
    "ROB_HUNK_WEAPON_ADDON_SHOTGUN_DESC": "Una pieza personalizada para todas las escopetas. Sustituye los cartuchos por munición incendiaria que causa más daño y prende fuego.",
    "ROB_HUNK_WEAPON_SLUGGER_NAME": "Slugger",
    "ROB_HUNK_WEAPON_SLUGGER_DESC": "Escopeta de corredera del calibre 12 con capacidad para 4 cartuchos que dispara balas pesadas.",
    "ROB_HUNK_WEAPON_M3_NAME": "M3",
    "ROB_HUNK_WEAPON_M3_DESC": "Una escopeta semiautomática.",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_NAME": "Street Sweeper",
    "ROB_HUNK_WEAPON_STREET_SWEEPER_DESC": "Una escopeta completamente automática.",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_NAME": "Cohete Antitanque",
    "ROB_HUNK_WEAPON_ROCKETLAUNCHER_DESC": "Un lanzacohetes de potencia devastadora.",
    "ROB_HUNK_WEAPON_ATM_NAME": "ATM-4",
    "ROB_HUNK_WEAPON_ATM_DESC": "Un lanzacohetes sin retroceso con munición ilimitada. Ligero y fácil de manejar, esta arma posee una potencia formidable.",
    "ROB_HUNK_WEAPON_ATM2_NAME": "Prototipo ATM-4",
    "ROB_HUNK_WEAPON_ATM2_DESC": "Un lanzacohetes sin retroceso que dispara proyectiles de 84mm. El poder perforante del cohete provoca más daño que la explosión.",
    "ROB_HUNK_WEAPON_RPG_NAME": "RPG",
    "ROB_HUNK_WEAPON_RPG_DESC": "Un lanzacohetes de potencia devastadora.",
    "ROB_HUNK_WEAPON_REVOLVER_NAME": "Quickdraw Army",
    "ROB_HUNK_WEAPON_REVOLVER_DESC": "Un revólver a la antigua usanza que emplea munición mágnum.",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_NAME": "Cargador Rápido (Quickdraw Army)",
    "ROB_HUNK_WEAPON_ADDON_REVOLVER_DESC": "Una pieza personalizada para el Quickdraw Army que permite recargar el tambor más deprisa cuando está vacío.",
    "ROB_HUNK_WEAPON_FLAMETHROWER_NAME": "Lanzallamas Químico",
    "ROB_HUNK_WEAPON_FLAMETHROWER_DESC": "Un arma fabricada por Umbrella que utiliza gas presurizado para generar llamas al rojo vivo. Portátil y recargable, siempre lista para aguantar el tipo.",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_NAME": "Regulador (Lanzallamas Químico)",
    "ROB_HUNK_WEAPON_ADDON_FLAMETHROWER_DESC": "Una pieza personalizada para el lanzallamas. Regula el gasto de combustible líquido y gas comprimido, permitiendo disparar durante mucho más tiempo.",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_NAME": "Depósito de Combustible de Alta Calidad (Lanzallamas Químico)",
    "ROB_HUNK_WEAPON_ADDON2_FLAMETHROWER_DESC": "Una pieza personalizada para el lanzallamas. Aumenta la potencia de las llamas y deja regueros de fuego en el suelo.",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_NAME": "GM-79",
    "ROB_HUNK_WEAPON_GRENADELAUNCHER_DESC": "Un lanzagranadas monotiro de apertura basculante capaz de disparar granadas incendiarias.",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_NAME": "Culata de Hombro (GM-79)",
    "ROB_HUNK_WEAPON_ADDON_GRENADELAUNCHER_DESC": "Una pieza personalizada para el GM-79 que reduce notablemente el culatazo y dota a cada disparo de una trayectoria más estable.",
    "ROB_HUNK_WEAPON_MGL_NAME": "MGL",
    "ROB_HUNK_WEAPON_MGL_DESC": "Un prototipo de lanzagranadas semiautomático capaz de disparar proyectiles explosivos.",
    "ROB_HUNK_WEAPON_ADDON_MGL_NAME": "Tambor Restaurado (MGL)",
    "ROB_HUNK_WEAPON_ADDON_MGL_DESC": "Una pieza personalizada para el MGL. Sustituye el tambor averiado por uno funcional, habilitando el fuego semiautomático.",
    "ROB_HUNK_WEAPON_GOLDGUN_NAME": "Pistola de Oro",
    "ROB_HUNK_WEAPON_GOLDGUN_DESC": "Pistola con capacidad para 1 bala capaz de liquidar a cualquier objetivo de un único disparo.",
    "ROB_HUNK_WEAPON_BLUEROSE_NAME": "Blue Rose",
    "ROB_HUNK_WEAPON_BLUEROSE_DESC": "¿Un revólver de seis recámaras que efectúa dos disparos a la vez? ¿A qué pirado se le ocurre semejante locura?",
    "ROB_HUNK_WEAPON_AR_NAME": "CQBR",
    "ROB_HUNK_WEAPON_AR_DESC": "Un fusil de asalto capaz de disparar en modo totalmente automático.",
    "ROB_HUNK_WEAPON_ADDON_AR_NAME": "Bayoneta (CQBR)",
    "ROB_HUNK_WEAPON_ADDON_AR_DESC": "Una pieza personalizada para el CQBR que sustituye a tu Cuchillo de Combate e inflige un 600% de daño.",
    "ROB_HUNK_WEAPON_RAILGUN_NAME": "Cañón de Riel Ferromagnético de Nueva Generación para Infantería",
    "ROB_HUNK_WEAPON_RAILGUN_DESC": "Un cañón electromagnético portátil desarrollado por Cornell Garner y el ejército estadounidense para erradicar armas biológicas ante un brote.",
    "ROB_HUNK_WEAPON_MINIGUN_NAME": "Minigun",
    "ROB_HUNK_WEAPON_MINIGUN_DESC": "Una ametralladora rotativa motorizada de seis cañones que dispara munición 7.62mm OTAN. Cadencia de tiro endiablada y un daño descomunal.",
    "ROB_HUNK_WEAPON_COLT_NAME": "Colt Single Action Army",
    "ROB_HUNK_WEAPON_COLT_DESC": "La mejor pistola jamás construida.",
    "ROB_HUNK_WEAPON_ADDON_COLT_NAME": "Cañón Largo (Colt)",
    "ROB_HUNK_WEAPON_ADDON_COLT_DESC": "Una pieza personalizada para el Colt que eleva su daño al 4800%.",
    "ROB_HUNK_WEAPON_SPARKSHOT_NAME": "Spark Shot",
    "ROB_HUNK_WEAPON_SPARKSHOT_DESC": "Un arma de alto voltaje pensada para animales de laboratorio. Tarda en cargarse y los cables de las agujas se rompen con facilidad, pero reparte unas descargas tremendas.",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_NAME": "Condensador de Alto Voltaje (Spark Shot)",
    "ROB_HUNK_WEAPON_ADDON_SPARKSHOT_DESC": "Una pieza personalizada para el Spark Shot. Permite almacenar una gran carga de electricidad de alto voltaje y acorta la espera entre disparos.",
    "ROB_HUNK_WEAPON_SSG_NAME": "SSG",
    "ROB_HUNK_WEAPON_SSG_DESC": "Una escopeta compacta de cañón abatible con amplia dispersión.",
    "ROB_HUNK_WEAPON_SHIELD_NAME": "Escudo Antidisturbios",
    "ROB_HUNK_WEAPON_SHIELD_DESC": "Bloquea el puñetero láser de las narices.",
    "ROB_HUNK_WEAPON_SCANNER_NAME": "Escáner EMF",
    "ROB_HUNK_WEAPON_SCANNER_DESC": "Un dispositivo capaz de detectar determinados aparatos electrónicos.",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_NAME": "Lanzagarfios",
    "ROB_HUNK_WEAPON_GRAPPLEGUN_DESC": "Dispara un garfio unido a una tirolina que te permite impulsarte hacia cualquier lugar que desees.",
    "ROB_HUNK_WEAPON_FRAG_NAME": "Granada de Fragmentación",
    "ROB_HUNK_WEAPON_FRAG_DESC": "",
    "ROB_HUNK_WEAPON_FLASHBANG_NAME": "Granada Cegadora",
    "ROB_HUNK_WEAPON_FLASHBANG_DESC": "",
