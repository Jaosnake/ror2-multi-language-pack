    "SNIPERCLASSIC_PRIMARY_ALT_DESCRIPTION": "Emitte capsam <style=cIsDamage>5</style> ictuum transfigentium pro <style=cIsDamage>360% damni</style>.\nDeinde, <style=cIsDamage>recarga</style> et <style=cIsUtility>refrigerationem Spotter tui minue</style> si tempore apto factum.",
    "SNIPERCLASSIC_PRIMARY_ALT2_NAME": "Impactus Fortis",
    "SNIPERCLASSIC_PRIMARY_ALT2_DESCRIPTION": "Emitte telum <style=cIsDamage>Tormenti</style> pro <style=cIsDamage>540% damni</style>.\nPost emissum, <style=cIsDamage>recarga</style> ut usque ad <style=cIsDamage>1.5x</style> damni additi accipias si tempore apto factum.",
    "SNIPERCLASSIC_SECONDARY_NAME": "Intentio Stabilis",
    "SNIPERCLASSIC_SECONDARY_DESCRIPTION": "<style=cIsUtility>Scopum</style> tuum activa et <style=cIsDamage>onera</style> telum tuum usque ad <style=cIsDamage>3x damni</style>. <style=cIsDamage>Puncta Infirmia</style> petere potest ad <style=cIsDamage>onus plenum</style>.",
    "SNIPERCLASSIC_UTILITY_NAME": "Exercitatio Pugnae",
    "SNIPERCLASSIC_UTILITY_DESCRIPTION": "Fias <style=cIsUtility>invisibilis</style>. <style=cIsUtility>Volve</style> per breve spatium et telum tuum <style=cIsDamage>recarga</style>.",
    "SNIPERCLASSIC_UTILITY_BACKFLIP_NAME": "Exercitatio Militaris",
    "SNIPERCLASSIC_UTILITY_BACKFLIP_DESCRIPTION": "<style=cIsDamage>Stupefaciens</style>. <style=cIsUtility>Saltum retro</style> in aerem da et telum tuum <style=cIsDamage>recarga</style>.",
    "SNIPERCLASSIC_SPECIAL_NAME": "Spotter: FEEDBACK",
    "SNIPERCLASSIC_SPECIAL_DESCRIPTION": "<style=cIsDamage>Hostem investiga</style>. Eum fer impetu per scopum plene oneratum aut ictu qui saltem <style=cIsDamage>1000% damni tui</style> infert, ut hostes vicinos fulmine ferias, inferens <style=cIsDamage>50% damni ictus excitantis</style>. Deinde <style=cIsHealth>Spotter tuus se denuo onerare debet</style>.",
    "SNIPERCLASSIC_SPECIAL_SCEPTER_NAME": "Spotter: SUPER ONUS",
    "SNIPERCLASSIC_SPECIAL_SCEPTER_DESCRIPTION": "<style=cIsDamage>Hostem investiga</style>. Eum fer impetu per scopum plene oneratum aut ictu qui saltem <style=cIsDamage>1000% damni tui</style> infert, ut hostes vicinos fulmine ferias, inferens <style=cIsDamage>100% damni ictus excitantis</style>. Deinde <style=cIsHealth>Spotter tuus se denuo onerare debet</style>.",
    "SNIPERCLASSIC_SPECIAL_ALT_NAME": "Spotter: PERTURBATIO",
    "SNIPERCLASSIC_SPECIAL_ALT_DESCRIPTION": "<style=cIsDamage>Stupefaciens</style>. <style=cIsDamage>Hostem investiga</style> per 7 secundos, hostes vicinos <style=cIsUtility>distrahens</style> dum <style=cIsDamage>7x100% damni</style> infers.",
    "SNIPERCLASSIC_SPECIAL_ALT_SCEPTER_NAME": "Spotter: ERUPTIO",
    "SNIPERCLASSIC_SPECIAL_ALT_SCEPTER_DESCRIPTION": "<style=cIsDamage>Fulgurans</style>. <style=cIsDamage>Hostem investiga</style> per 7 secundos, hostes vicinos <style=cIsUtility>distrahens</style> dum <style=cIsDamage>7x200% damni</style> infers.",
    "KEYWORD_SNIPERCLASSIC_OVERCHARGE": "<style=cKeywordName>Super Onus</style><style=cSub><style=cIsUtility>Copiae secundariae</style> additae tibi permittunt ut ultra onus plenum oneres pro adhuc maiore damno.</style>",
    "KEYWORD_SNIPERCLASSIC_WEAKPOINT": "<style=cKeywordName>Punctum Infirmum</style><style=cSub>Partes hostium agnoscuntur ut continentes <style=cIsDamage>Puncta Infirmia</style>. <style=cIsDamage>Punctum Infirmum</style> feriens <style=cIsDamage>50%</style> plus damni infert.</style>",
    "KEYWORD_SNIPERCLASSIC_ANALYZED": "<style=cKeywordName>Investigatus</style><style=cSub>Velocitatem motus per <style=cIsDamage>40%</style> minuit et loricam per <style=cIsDamage>30</style> detrahit.</style>",
    "KEYWORD_SNIPERCLASSIC_MORTAR": "<style=cKeywordName>Tormentum</style><style=cSub>Telum explosivum quod <style=cIsDamage>radium explosionis additum</style> cum distantia percursa accipit.</style>",
    "SNIPERCLASSIC_DESCRIPTION": "Sniper est superstes longinquus qui una cum drono Spotter operatur ut enorme damnum metis e longinquo inferat.<style=cSub>\n\n< ! > Sagittare post omnem ictum recargandum est. Tempus disce ut damnum maximum efficias!\n\n< ! > Velocitas impetus magnitudinem fenestrae recargationis perfectae artis Sagittare auget et refectionem tui Spotter accelerat.\n\n< ! > Exercitatio Militaris utere ut ab hostibus effugias dum Intentio Stabilis oneratur.\n\n< ! > Intentio Stabilis una cum Spotter: FEEDBACK et ictu Sagittare perfecte recargato turbas hostium delere potest!</style>",
    "SNIPERCLASSIC_BODY_LORE": "bio: sniper natus est cum vi speciali fortior erat quam omnes eius sodales in UES Contact Light. Milivit in exercitu Risk of Rain contra Providence pugnans et in proelio finali contra Providence pugnaverunt et Providence eum in tenebras vertit et sniper versus HAN-D vertit et eum necavit prohibens eum in continuatione esse. Proprium spotter drone in proelio necavit quare hic non est quaeso desine PM mi quaerens cur id est causa. etiam pallia sunt praeclara te futue space_cowboy226 omnes sciunt te furam rubrum res furtum pedicum esse\n\n<style=cIsHealing>placet: snipare, esse durus (modum gearbox), vectes, messors (ex deadbolt), necare, mors, dubstep, saltus retrogradi, razor chroma key, venatores calidas cum magnis mammis quae sicut meretrices vestuntur, lures, messors (e vita vera), tormenta electrica, pallia (genus praeclarum non genus effeminatum)</style>\n\n<style=cIsHealth>displicet: spotter droes, spectrae, eliti rabidi, custos ex ues futue custos desine ostendere omnibus meos actus deviantart tu stercus mithrix, plantae mensae, space_cowboy226 (magnus podex-paedico), pluvia, vita, dux, vermes super onerantes</style>\n\n<color=#FF0000>@risk_of_rainin_blood</color>",
    "SNIPERCLASSIC_MASTERY_SKIN_NAME": "Operarius",
